{
  "name": "emostien-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "prod": "astro build && node -e \"require('node:fs').writeFileSync('dist/__emo_preview_mode.json','{\\\"mode\\\":\\\"prod\\\"}')\" && astro preview --host 127.0.0.1 --port 4321"
  },
  "dependencies": {
