---
export const prerender = false;

type TestModule = {
	default: any;
};

const cTestModules = import.meta.glob<TestModule>("./Tests/**/*.astro");
const cRawTestPath = String(Astro.params.test ?? "").replace(/\\/g, "/").replace(/^\/+|\/+$/g, "");
const cTestParts = cRawTestPath.split("/").filter(Boolean);
const cHasInvalidPart = cTestParts.some((pPart) => pPart === "." || pPart === "..");
const cTestPath = cTestParts.join("/");
const cModuleKey = `./Tests/${cTestPath}.astro`;
const cTestLoader = !cHasInvalidPart && cTestPath ? cTestModules[cModuleKey] : undefined;

if (!cTestLoader) {
	Astro.response.status = 404;
}

const cTestModule = cTestLoader ? await cTestLoader() : undefined;
const TestComponent = cTestModule?.default;
---

{
	TestComponent
		? <TestComponent />
		: (
			<html lang="ar" dir="rtl">
				<head>
					<meta charset="utf-8" />
					<meta name="viewport" content="width=device-width, initial-scale=1" />
					<meta name="robots" content="noindex, nofollow, noarchive" />
					<title>ملف الاختبار غير موجود</title>
				</head>
				<body>
					<main>ملف الاختبار المطلوب غير موجود داخل src/site/Tests.</main>
				</body>
			</html>
		)
}
