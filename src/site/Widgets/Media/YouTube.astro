---
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
interface Props extends DebugOutlineProps, HTMLAttributes<"div">, PlaceProps {
	pVideoId: string;
	pTitle?: string;
	pWidth?: number;
}

const {
	pVideoId,
	pTitle = "YouTube Video Player",
	pWidth = 800,
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = "",
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";

const cParams = new URLSearchParams({
	autoplay: "0",
	mute: "0",
	controls: "1",
	loop: "0",
	playsinline: "1",
	rel: "0",
	modestbranding: "1",
	start: "0"
});

const cSrc = `https://www.youtube-nocookie.com/embed/${pVideoId}?${cParams.toString()}`;
const cStyle = [`--Width:${pWidth}px;`, cGivenStyle].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps, cStyle);
---




















<div
	class = {`Frame ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	{...RemAttr}
>
	<iframe
		src={cSrc}
		title={pTitle}
		loading="lazy"
		referrerpolicy="strict-origin-when-cross-origin"
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
		allowfullscreen
	>
	</iframe>
</div>




















<style>



	.Frame {
		width: var(--Width);
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.Frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}



</style>
