---
import { Place, type PlaceProps } from "@/TypesLib";
import { Media } from "@/Media";

interface Props extends DebugOutlineProps, PlaceProps {
	pImg?: string;
}

const { pImg = "/Media/ErrorImg.webp" } = Astro.props as Props;
const cPlace = new Place(Astro.props as PlaceProps);
const cImg = Media.GetPageFile(Astro.url.href, pImg);
const cId = GetWidgetId("ShadowImg");
---





<div
	class = {`ShadowImg ${cPlace.Class}`.trim()}
	style = {cPlace.Style}
	id={cId}
	Readable={Astro.props.Readable}
	Debug={Astro.props.Debug}
	DebugF={Astro.props.DebugF}
	DebugG={Astro.props.DebugG}
	data-debug={Astro.props["data-debug"]}
	data-debugF={Astro.props["data-debugF"]}
	data-debugG={Astro.props["data-debugG"]}
>







	<img
		class = " ShadowImgImage "
		src={cImg}
		alt=""
		loading="eager"
		decoding="async"
	/>







</div>





<style>



	.ShadowImg {
		position: relative;
		display: inline-block;
		max-width: 100%;
		line-height: 0;
		vertical-align: top;
		box-sizing: border-box;
	}

	.ShadowImg::before {
		left: -20px;
		background-position: left top;
	}

	.ShadowImg::after {
		right: -20px;
		background-position: right top;
	}


	.ShadowImgImage {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		border-radius: 3px;
		background-color: #d8d8d8;
		box-shadow: 0 0 3px rgba(0, 0, 0, 0.5);
	}



	.ShadowImg.PlaceSized {
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}

	.ShadowImg.PlaceSized .ShadowImgImage {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}


	.ShadowImg.PlaceStyled:not(.IsPlaced) {
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--PlaceClickable, auto);
	}


	.ShadowImg.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--PlaceClickable, auto);
		min-width: 0;
		box-sizing: border-box;
	}



	.ShadowImg::before,
	.ShadowImg::after
	{
		content: "";
		position: absolute;
		bottom: -26px;
		width: 50%;
		height: 26px;
		background-image: url("data:image/png;base64,");
		background-repeat: no-repeat;
		background-size: 200% 100%;
		pointer-events: none;
	}



</style>





<style>



	@media (orientation: landscape) {
		.ShadowImg.PlaceHideLand {
			display: none;
		}
	}



	@media (orientation: portrait) {
		.ShadowImg.PlaceSized,
		.ShadowImg.IsPlaced
		{
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}

		.ShadowImg.PlaceStyled:not(.IsPlaced) {
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}

		.ShadowImg.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}

		.ShadowImg.PlaceHidePort {
			display: none;
		}
	}



</style>
