---
const {
	fId = "gallery1",
	fItems = [],
	id: fIdAttr,
	class: fClass = "",
	style: fStyle = "",
	...cAttrs
} = Astro.props as DebugOutlineProps & Record<string, any>;
// fItems: [{ fSrc, fAlt, fThumb? }]
---

<div id={fIdAttr} class={`galleryGrid ${fClass}`.trim()} style={fStyle} {...cAttrs}>
    {
        fItems.map((fIt, fI) => (
            <button
                class="gItem reveal"
                data-reveal="up"
                type="button"
                data-gallery={fId}
                data-gallery-item="1"
                data-index={fI}
                data-src={fIt.fSrc}
                data-alt={fIt.fAlt ?? ""}
            >
                <img
                    src={fIt.fThumb ?? fIt.fSrc}
                    alt={fIt.fAlt ?? ""}
                    loading="lazy"
                />
            </button>
        ))
    }
</div>


<style>

	.galleryGrid {
		display: grid;
		gap: 14px;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	}

	.gItem {
		border: 1px solid rgba(0, 0, 0, 0.08);
		padding: 0;
		background: transparent;
		cursor: pointer;
		border-radius: 18px;
		overflow: hidden;
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.1);
		transition: transform 0.18s ease;
	}

	.gItem:hover {
		transform: translateY(-3px);
	}

	.gItem img {
		width: 100%;
		height: 100%;
		display: block;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

</style>

<style is:global>

	.lb {
		position: fixed;
		inset: 0;
		z-index: 999;
		display: none;
	}

	.lb.isOpen {
		display: block;
	}

	.lbBack {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.75);
	}

	.lbPanel {
		position: absolute;
		inset: 24px;
		display: grid;
		place-items: center;
	}

	.lbImgWrap {
		max-width: min(1100px, 92vw);
		max-height: min(720px, 86vh);
		position: relative;
	}

	.lbImg {
		width: 100%;
		height: 100%;
		max-height: min(720px, 86vh);
		object-fit: contain;
		display: block;
		background: rgba(255, 255, 255, 0.04);
		border-radius: 16px;
	}

	.lbClose {
		position: absolute;
		top: 14px;
		right: 14px;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		background: rgba(0, 0, 0, 0.35);
		color: #fff;
		font-size: 22px;
		cursor: pointer;
	}

	.lbNav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 46px;
		height: 46px;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.25);
		background: rgba(0, 0, 0, 0.35);
		color: #fff;
		font-size: 22px;
		cursor: pointer;
	}

	.lbPrev {
		left: -60px;
	}

	.lbNext {
		right: -60px;
	}

	@media (max-width: 700px) {
		.lbPrev {
			left: 10px;
		}

		.lbNext {
			right: 10px;
		}
	}

</style>

<script>

	function BuildLightbox() {
		const cRoot = document.createElement("div");
		cRoot.className = "lb";
		cRoot.innerHTML = `
			<div class="lbBack" data-lb-close="1"></div>
			<div class="lbPanel">
				<div class="lbImgWrap">
					<img class="lbImg" alt="" />
					<button class="lbClose" type="button" data-lb-close="1">×</button>
					<button class="lbNav lbPrev" type="button" data-lb-prev="1">‹</button>
					<button class="lbNav lbNext" type="button" data-lb-next="1">›</button>
				</div>
			</div>
		`;
		document.body.appendChild(cRoot);
		return cRoot;
	}

	let cLightbox = null;
	let cItems = [];
	let cIndex = 0;

	function OpenLightbox(pItems, pIndex) {
		cItems = pItems;
		cIndex = pIndex;

		if (!cLightbox) cLightbox = BuildLightbox();

		const cImg = cLightbox.querySelector(".lbImg");
		const cItem = cItems[cIndex];
		cImg.src = cItem.src;
		cImg.alt = cItem.alt || "";
		cLightbox.classList.add("isOpen");
		document.documentElement.style.overflow = "hidden";
	}

	function CloseLightbox() {
		if (!cLightbox) return;
		cLightbox.classList.remove("isOpen");
		document.documentElement.style.overflow = "";
	}

	function MoveLightbox(pDirection) {
		if (!cItems.length) return;
		cIndex = (cIndex + pDirection + cItems.length) % cItems.length;
		const cImg = cLightbox.querySelector(".lbImg");
		const cItem = cItems[cIndex];
		cImg.src = cItem.src;
		cImg.alt = cItem.alt || "";
	}

	document.addEventListener("click", (pEvent) => {
		const cTarget = pEvent.target;
		if (!(cTarget instanceof Element)) return;

		const cButton = cTarget.closest("[data-gallery-item]");
		if (cButton) {
			const cGalleryId = cButton.getAttribute("data-gallery") || "default";
			const cAll = Array.from(document.querySelectorAll(`[data-gallery="${cGalleryId}"][data-gallery-item]`));
			const cList = cAll.map((pElement) => ({
				src: pElement.getAttribute("data-src") || "",
				alt: pElement.getAttribute("data-alt") || "",
			}));
			const cNewIndex = Number(cButton.getAttribute("data-index") || 0);
			OpenLightbox(cList, cNewIndex);
			return;
		}

		if (cTarget.closest("[data-lb-close]")) CloseLightbox();
		if (cTarget.closest("[data-lb-prev]")) MoveLightbox(-1);
		if (cTarget.closest("[data-lb-next]")) MoveLightbox(1);
	});

	document.addEventListener("keydown", (pEvent) => {
		if (!cLightbox || !cLightbox.classList.contains("isOpen")) return;
		if (pEvent.key === "Escape") CloseLightbox();
		if (pEvent.key === "ArrowLeft") MoveLightbox(-1);
		if (pEvent.key === "ArrowRight") MoveLightbox(1);
	});

</script>
