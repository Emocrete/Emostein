---
const {
	fId = "gallery1",
	fItems = [],
	id: fIdAttr,
	class: fClass = "",
	style: fStyle = "",
	...cAttrs
} = Astro.props as DebugOutlineProps & Record<string, any>;
// fItems: [{ fSrc, fAlt, fThumb? }]
---

<div id={fIdAttr} class={`galleryGrid ${fClass}`.trim()} style={fStyle} {...cAttrs}>
    {
        fItems.map((fIt, fI) => (
            <button
                class="gItem reveal"
                data-reveal="up"
                type="button"
                data-gallery={fId}
                data-gallery-item="1"
                data-index={fI}
                data-src={fIt.fSrc}
                data-alt={fIt.fAlt ?? ""}
            >
                <img
                    src={fIt.fThumb ?? fIt.fSrc}
                    alt={fIt.fAlt ?? ""}
                    loading="lazy"
                />
            </button>
        ))
    }
</div>
