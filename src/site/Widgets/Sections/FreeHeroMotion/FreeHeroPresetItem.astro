---
import { Loc, NumPer, RespString, Size } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import FreeHeroMoveItem from "../FreeHeroMoveItem.astro";
import {
	BuildFreeHeroMotionPoints,
	GetDefaultEase,
	GetDefaultIntervals,
	GetDefaultLoop,
	type TFreeHeroMotion,
} from "../FreeHeroMotion";

export interface Props extends DebugOutlineProps, HTMLAttributes<"div"> {
	pMotion: TFreeHeroMotion;
	pLoc?: Loc;
	pBox?: Size;
	pDistance?: string | RespString;
	pDuration?: number;
	pIntervals?: number[];
	pDelay?: number;
	pEase?: string;
	pLoop?: boolean;
	pLoopFor?: number;
	pLoopInterval?: number;
	pReverse?: boolean;
	pZ?: number;
	pOrigin?: string;
	pFit?: boolean;
	pPointer?: boolean;
	pHideLand?: boolean;
	pHidePort?: boolean;
	pLandOnly?: boolean;
	pPortOnly?: boolean;
}

const {
	pMotion,
	pLoc = new Loc(new NumPer(0, 0), new NumPer(0, 0)),
	pBox = new Size(),
	pDistance = new RespString("180px", "90px"),
	pDuration = 900,
	pIntervals,
	pDelay = 0,
	pEase,
	pLoop,
	pLoopFor,
	pLoopInterval,
	pReverse = false,
	pZ = 1,
	pOrigin = "center center",
	pFit = false,
	pPointer = true,
	pHideLand = false,
	pHidePort = false,
	pLandOnly = false,
	pPortOnly = false,
	...RemAttr
} = Astro.props as Props;

const cKeyPoints = BuildFreeHeroMotionPoints(pMotion, pLoc, pBox, pDistance);
const cIntervals = pIntervals ?? GetDefaultIntervals(pMotion, pDuration);
const cEase = pEase ?? GetDefaultEase(pMotion);
const cLoop = pLoop ?? GetDefaultLoop(pMotion);
---






















	<slot
	{...RemAttr}
	pMoveKeyPoints={cKeyPoints}
	pMoveIntervals={cIntervals}
	pMoveDelay={pDelay}
	pMoveEase={cEase}
	pMoveLoop={cLoop}
	pMoveLoopFor={pLoopFor}
	pMoveLoopInterval={pLoopInterval}
	pMoveReverse={pReverse}
	pZ={pZ}
	pOrigin={pOrigin}
	pClickable={pPointer}
	pLandOnly={pLandOnly}
	pPortOnly={pPortOnly}
	pPortOnly={pHideLand}
	pLandOnly={pHidePort}
/>


