---
import type { HTMLAttributes } from "astro/types";
import { EmoMediaData, Pixel, Place, type PlaceProps } from "@/TypesLib";
import Stack from "../Comp/Stack.astro";

export interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	pMedia?: EmoMediaData;
	pTitleClr?: string;
	pBlurL?: "auto" | "on" | "off";
	pBlurP?: "auto" | "on" | "off";
}

const {
	pMedia,
	pTitleClr = "black",
	pBlurL = "auto",
	pBlurP = "auto",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("IndexSec"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";

const CssVars = [
	`--TitleClr:${pTitleClr};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps, CssVars);
---




















<section
	class = {`IndexSecBox ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	{...RemAttr}
	data-blur-l={pBlurL}
	data-blur-p={pBlurP}
>

	{ pMedia?.Type === "Vid" ? (

		<video
			class = " IndexSecBgBox IndexSecBgImg "
			crossorigin="anonymous"
			playsinline
			preload="auto"
			loop
			autoplay
			muted
		>

			<source media="(orientation: portrait)" src={pMedia.LinkP} />

			<source media="(orientation: landscape)" src={pMedia.LinkL} />

			<source src={pMedia.LinkL} />

		</video>

		) : pMedia?.Type === "Img" ? (

			<picture class = " IndexSecBgBox ">

				<source media="(orientation: portrait)" srcset={pMedia.LinkP} />

				<img
					class = " IndexSecBgImg "
					src={pMedia.LinkL}
					alt={pMedia.Alt}
					loading="lazy"
					decoding="async"
				/>

			</picture>

			) : (

				<div class = " IndexSecBgBox BgFallback " />

			) }

		<Stack
			class = " IndexSecContentBox "
			pDir="Row"
			pHzAlign="Center"
			pVrAlign="Center"
			pGap={new Pixel(50, 12)}
			pPad="0px"
			pMainSizeMode="Own"
			pCrossSizeMode="Own"
		>

			<Stack
				class = " IndexSecTitleBox "
				pDir="Col"
				pHzAlign="Center"
				pVrAlign="Center"
				pGap={new Pixel(0)}
				pPad="0px"
				pMainSizeMode="Own"
				pCrossSizeMode="Own"
			>

				<img
					class = " IndexSecIcon "
					src="/Media/IndexIcon.webp"
					alt=""
					loading="lazy"
					decoding="async"
					fetchpriority="high"
					width="136"
					height="141"
				/>

				<p class = " IndexSecTitle ">
					محتوى الصفحة
				</p>

			</Stack>

			<Stack
				class = " IndexSecLinksBox "
				pDir="Row"
				pHzAlign="Center"
				pVrAlign="Center"
				pGap={new Pixel(50, 8)}
				pPad="0px"
				pMainSizeMode="Own"
				pCrossSizeMode="Own"
			>

				<slot />

			</Stack>

		</Stack>

	</section>




















<style>



	.IndexSecBox {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 100%;
		padding-block: 30px;
		overflow: hidden;
	}


	.IndexSecBgBox {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
		user-select: none;
	}


	.IndexSecBgImg {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}


	.BgFallback {
		background: #808080;
	}


	.IndexSecIcon {
		display: block;
		width: 136px;
		height: auto;
		flex: 0 0 auto;
	}


	.IndexSecTitle {
		margin: 0;
		font-size: clamp(25px, 3vw, 35px);
		font-weight: 800;
		line-height: 1.15;
		color: var(--TitleClr);
		text-align: center;
	}



	:global(.IndexSecContentBox) {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		width: min(100%, 980px) !important;
		height: auto !important;
	}


	:global(.IndexSecTitleBox) {
		flex: 0 0 auto !important;
	}


	:global(.IndexSecLinksBox) {
		width: fit-content !important;
		max-width: 100% !important;
	}


	:global(.IndexSecLinksBox > .VrStack) {
		width: fit-content !important;
		max-width: 100% !important;
		padding: 0 !important;
		gap: 10px !important;
		align-items: center !important;
	}


	:global(.IndexSecLinksBox .Btn) {
		width: min(360px, calc(100vw - 48px)) !important;
	}


	:global(.IndexSecContentBox.isBlur) {
		background: rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 20px;
		padding: clamp(16px, 2vw, 28px) !important;
	}



</style>




















<style>



	@media (orientation: portrait) {
		.IndexSecBox {
			padding-block: 14px;
		}

		:global(.IndexSecContentBox) {
			width: min(100%, 320px) !important;
		}

		.IndexSecIcon {
			width: 100px;
		}

		.IndexSecTitle {
			font-size: 22px;
		}

		:global(.IndexSecLinksBox > .VrStack) {
			gap: 6px !important;
		}

		:global(.IndexSecLinksBox .Btn) {
			height: 36px !important;
			min-height: 36px !important;
		}
	}



</style>




















<script is:inline>
	(function InitIndexSecResponsiveScript() {
	const cTargetRatioL = 16 / 9;
	const cTargetRatioP = 9 / 20;
	const cTolL = 0.12;
	const cTolP = 0.035;
	let fTimer = 0;

	const cSections = Array.from(document.querySelectorAll(".IndexSecBox"));
	if (cSections.length === 0) return;

	window.addEventListener("resize", RefreshIndexSections);
	window.addEventListener("orientationchange", RefreshIndexSections);

	UpdateIndexSections();

	function RefreshIndexSections() {
	clearTimeout(fTimer);
	fTimer = window.setTimeout(UpdateIndexSections, 80);
	}

	function UpdateIndexSections() {
	const cIsLandscape = window.innerWidth >= window.innerHeight;
	const cRatio = window.innerWidth / Math.max(window.innerHeight, 1);
	const cTargetRatio = cIsLandscape ? cTargetRatioL : cTargetRatioP;
	const cTol = cIsLandscape ? cTolL : cTolP;

	for (const cSection of cSections) {
	const cContentBox = cSection.querySelector(".IndexSecContentBox");
	if (!cContentBox) continue;

	const cBlurMode = cIsLandscape
	? cSection.dataset.blurL || "auto"
	: cSection.dataset.blurP || "auto";

	cContentBox.classList.toggle(
	"isBlur",
	IsNeedBlur(cBlurMode, cRatio, cTargetRatio, cTol)
	);
	}
	}

	function IsNeedBlur(pBlurMode, pRatio, pTargetRatio, pTol) {
	if (pBlurMode === "on") return true;
	if (pBlurMode === "off") return false;

	return Math.abs(pRatio - pTargetRatio) > pTol;
	}
	})();
</script>
