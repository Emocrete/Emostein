---
import { Align, ElemBg, NumPer, Place, type PlaceProps, Size } from "@/TypesLib";
import { Media } from "@/Media";
import { SeoText } from "@/SeoText";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	pBg?: ElemBg;
	pBox?: Size;
	pMinH?: NumPer;
	/**MAY BE NEED TO REMOVE OLD STYLE*/
	pAlign?: Align | "left" | "right" | "center";
	pImgF?: string;
	pImgL?: string;
	pImgP?: string;
	/** وصف صورة خلفية الهيرو لمحركات البحث وقارئات الشاشة. */
	pImgAlt?: string;
}

const {
	pBg,
	pBox,
	pMinH,
	pAlign = Align.Center,
	pImgF = "",
	pImgL = "",
	pImgP = "",
	pImgAlt = "",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = "secHero",
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = GetStyleText(pGivenStyle);
const cSectionAlign = pAlign instanceof Align ? pAlign : Align.Center;
const cLegacyAlign = typeof pAlign === "string" ? pAlign : "center";

const cPagePath = Astro.url.pathname;
const cPageUrl = Astro.url.href;
const cImgFolder = pImgF;

const cBgImgL = pImgL
	? Media.GetPageFile(cPageUrl, pImgL, { pFolder: cImgFolder, pAbsolute: true })
	: Media.GetHeroLandscape(cPageUrl, { pFolder: cImgFolder, pAbsolute: true });

const cBgImgP = pImgP
	? Media.GetPageFile(cPageUrl, pImgP, { pFolder: cImgFolder, pAbsolute: true })
	: pImgL
		? cBgImgL
		: Media.GetHeroPortrait(cPageUrl, { pFolder: cImgFolder, pAbsolute: true });

const cFinalBgImgL = Media.GetPageFile(cPageUrl, cBgImgL || cBgImgP || pBg?.Img?.LinkL || pBg?.Img?.LinkP || "", { pFolder: cImgFolder, pAbsolute: true });
const cFinalBgImgP = Media.GetPageFile(cPageUrl, cBgImgP || cBgImgL || pBg?.Img?.LinkP || pBg?.Img?.LinkL || "", { pFolder: cImgFolder, pAbsolute: true });
const cHasBgImg = cFinalBgImgL !== "" || cFinalBgImgP !== "";
const cAutoImgAlt = SeoText.GetLocalsImageAlt(Astro.locals) ;
const cBgAlt = pImgAlt || pBg?.Img?.Alt || cAutoImgAlt;
const cImgWidthL = 1920;
const cImgHeightL = 911;
const cImgWidthP = cFinalBgImgP === cFinalBgImgL ? cImgWidthL : 360;
const cImgHeightP = cFinalBgImgP === cFinalBgImgL ? cImgHeightL : 680;

const cHeroStyle = [
	`--HeroBg:${pBg?.Color || "transparent"};`,
	`--HeroWidthL:${pBox?.WidthL || "100%"};`,
	`--HeroWidthP:${pBox?.WidthP || pBox?.WidthL || "100%"};`,
	`--HeroHeightL:${pBox?.HeightL || "auto"};`,
	`--HeroHeightP:${pBox?.HeightP || pBox?.HeightL || "auto"};`,
	`--HeroMinHeightL:${pMinH?.Landscape || "100svh"};`,
	`--HeroMinHeightP:${pMinH?.Portrait || "100svh"};`,
	`--HeroAlignL:${GetHorizontalAlign(cSectionAlign.HzL)};`,
	`--HeroAlignP:${GetHorizontalAlign(cSectionAlign.HzP)};`,
	`--HeroJustifyL:${GetVerticalAlign(cSectionAlign.VrL)};`,
	`--HeroJustifyP:${GetVerticalAlign(cSectionAlign.VrP)};`,
	`--HeroLegacyAlign:${cLegacyAlign};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps, cHeroStyle);

function GetStyleText(pStyle: Props["style"]) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}

function GetHorizontalAlign(pValue?: string) {
	if (pValue === "left") return "flex-start";
	if (pValue === "right") return "flex-end";
	return "center";
}

function GetVerticalAlign(pValue?: string) {
	if (pValue === "top") return "flex-start";
	if (pValue === "bottom") return "flex-end";
	return "center";
}

function GetLegacyBlurClass(pValue: "auto" | "on" | "off", pAxis: "L" | "P") {
	if (pValue === "on") return `LegacyBlur${pAxis}`;
	return "";
}
---





<section
	class = {`Hero ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	{...RemAttr}
>

	{ cHasBgImg && (

		<picture class = " HeroBg ">
		
		
		
		
		
		
		
			<source
				media="(orientation: portrait)"
				srcset={cFinalBgImgP}
				type="image/webp"
				width={cImgWidthP}
				height={cImgHeightP}
			/>
		
		
		
		
		
		
		
			<img
				class = " HeroBgImg "
				src={cFinalBgImgL}
				alt={cBgAlt}
				width={cImgWidthL}
				height={cImgHeightL}
				loading="eager"
				decoding="async"
				fetchpriority="high"
			/>
		
		
		
		
		
		
		
		</picture>
	) }

	<slot />







</section>





<style>



	.Hero {
		position: relative;
		isolation: isolate;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: var(--HeroAlignL, center);
		align-content: var(--HeroAlignL, center);
		justify-content: var(--HeroJustifyL, center);
		width: var(--HeroWidthL, 100%);
		height: var(--HeroHeightL, auto);
		min-height: var(--HeroMinHeightL, 100svh);
		max-width: 100%;
		background-color: var(--HeroBg, transparent);
		min-width: 0;
		inline-size: 100%;
		max-inline-size: 100%;
		overflow-x: clip;
		overflow-y: hidden;
	}


	.HeroBg {
		position: absolute;
		inset: 0;
		z-index: -1;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}


	.HeroBgImg {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
		user-select: none;
	}



	.Hero.IsPlaced {
		position: absolute;
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}



</style>





<style>



	@media (orientation: portrait) {
		.Hero {
			align-items: var(--HeroAlignP, var(--HeroAlignL, center));
			align-content: var(--HeroAlignP, var(--HeroAlignL, center));
			justify-content: var(--HeroJustifyP, var(--HeroJustifyL, center));
			width: var(--HeroWidthP, var(--HeroWidthL, 100%));
			height: var(--HeroHeightP, var(--HeroHeightL, auto));
			min-height: var(--HeroMinHeightP, var(--HeroMinHeightL, 100svh));
		}

		.Hero.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}
	}



</style>
