---
import { Align, DirectSize, ElemBg, NumPer, Place, type PlaceProps } from "@/TypesLib";
import { Media } from "@/Media";
import { SeoText } from "@/SeoText";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	pBg?: ElemBg;
	pBox?: DirectSize;
	pMinH?: NumPer;
	pAlign?: Align | "left" | "right" | "center";
	pImgF?: string;
	pImgL?: string;
	pImgP?: string;
	/** وصف صورة خلفية الهيرو لمحركات البحث وقارئات الشاشة. */
	pImgAlt?: string;

	/** Legacy Hero props: kept only so old Hero pages do not break before migration. */
	pTitle?: string;
	pTitleClr?: string;
	pTitleEff?: boolean;
	pDesc?: string;
	pDescClr?: string;
	pPosL?: string;
	pPosP?: string;
	pBlurL?: "auto" | "on" | "off";
	pBlurP?: "auto" | "on" | "off";
}

const {
	pBg,
	pBox,
	pMinH,
	pAlign = Align.Center,
	pImgF = "",
	pImgL = "",
	pImgP = "",
	pImgAlt = "",

	pTitle,
	pTitleClr = "black",
	pTitleEff = false,
	pDesc,
	pDescClr = "black",
	pPosL = "0% 0% 0% 0%",
	pPosP = "0% 0% 0% 0%",
	pBlurL = "auto",
	pBlurP = "auto",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = "",
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = GetStyleText(pGivenStyle);
const cSectionAlign = pAlign instanceof Align ? pAlign : Align.Center;
const cLegacyAlign = typeof pAlign === "string" ? pAlign : "center";
const cUseLegacyBox = pTitle !== undefined || pDesc !== undefined;
const cLegacyBlurL = GetLegacyBlurClass(pBlurL, "L");
const cLegacyBlurP = GetLegacyBlurClass(pBlurP, "P");

const cPagePath = Astro.url.pathname;
const cImgFolder = pImgF || Media.GetPageFolder(cPagePath);

const cBgImgL = pImgL
	? Media.GetPageFile(cPagePath, pImgL, { pFolder: cImgFolder })
	: Media.GetHeroLandscape(cPagePath, { pFolder: cImgFolder });

const cBgImgP = pImgP
	? Media.GetPageFile(cPagePath, pImgP, { pFolder: cImgFolder })
	: pImgL
		? cBgImgL
		: Media.GetHeroPortrait(cPagePath, { pFolder: cImgFolder });

const cFinalBgImgL = cBgImgL || cBgImgP || pBg?.Img?.LinkL || pBg?.Img?.LinkP || "";
const cFinalBgImgP = cBgImgP || cBgImgL || pBg?.Img?.LinkP || pBg?.Img?.LinkL || "";
const cHasBgImg = cFinalBgImgL !== "" || cFinalBgImgP !== "";
const cAutoImgAlt = SeoText.GetLocalsImageAlt(Astro.locals) || SeoText.GetImageAlt(pTitle ?? "", pDesc ?? "");
const cBgAlt = pImgAlt || pBg?.Img?.Alt || cAutoImgAlt;

const cHeroStyle = [
	`--HeroBg:${pBg?.Color || "transparent"};`,
	`--HeroWidthL:${pBox?.WidthL || "100%"};`,
	`--HeroWidthP:${pBox?.WidthP || pBox?.WidthL || "100%"};`,
	`--HeroHeightL:${pBox?.HeightL || "auto"};`,
	`--HeroHeightP:${pBox?.HeightP || pBox?.HeightL || "auto"};`,
	`--HeroMinHeightL:${pMinH?.Landscape || "100svh"};`,
	`--HeroMinHeightP:${pMinH?.Portrait || "100svh"};`,
	`--HeroAlignL:${GetHorizontalAlign(cSectionAlign.HzL)};`,
	`--HeroAlignP:${GetHorizontalAlign(cSectionAlign.HzP)};`,
	`--HeroJustifyL:${GetVerticalAlign(cSectionAlign.VrL)};`,
	`--HeroJustifyP:${GetVerticalAlign(cSectionAlign.VrP)};`,
	`--HeroLegacyTitleClr:${pTitleClr};`,
	`--HeroLegacyDescClr:${pDescClr};`,
	`--HeroLegacyAlign:${cLegacyAlign};`,
	`--HeroLegacyPosL:${pPosL};`,
	`--HeroLegacyPosP:${pPosP};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps, cHeroStyle);

function GetStyleText(pStyle: Props["style"]) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}

function GetHorizontalAlign(pValue?: string) {
	if (pValue === "left") return "flex-start";
	if (pValue === "right") return "flex-end";
	return "center";
}

function GetVerticalAlign(pValue?: string) {
	if (pValue === "top") return "flex-start";
	if (pValue === "bottom") return "flex-end";
	return "center";
}

function GetLegacyBlurClass(pValue: "auto" | "on" | "off", pAxis: "L" | "P") {
	if (pValue === "on") return `LegacyBlur${pAxis}`;
	return "";
}
---




















<section
	class = {`Hero ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	{...RemAttr}
>

	{ cHasBgImg && (

		<picture class = " HeroBg ">
		
		
		
		
		
		
		
			<source media="(orientation: portrait)" srcset={cFinalBgImgP} />
		
		
		
		
		
		
		
			<img
				class = " HeroBgImg "
				src={cFinalBgImgL}
				alt={cBgAlt}
				loading="eager"
				decoding="async"
				fetchpriority="high"
			/>
		
		
		
		
		
		
		
		</picture>
	) }

	{ cUseLegacyBox ? (

		<div class = {`HeroLegacyBox ${cLegacyBlurL} ${cLegacyBlurP}`.trim()}>
		
			{ pTitle && (
		
				<h1 class = {`HeroLegacyTitle ${pTitleEff ? "HasTitleEff" : ""}`.trim()}>
					{pTitle}
				</h1>
			) }
		
			{ pDesc && (
		
				<p class = " HeroLegacyDesc ">
					{pDesc}
				</p>
			) }
		
			<slot />
		
		
		
		
		
		
		
		</div>
	) : (

		<slot />
	) }

</section>




















<style>



	.Hero {
		position: relative;
		isolation: isolate;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: var(--HeroAlignL, center);
		align-content: var(--HeroAlignL, center);
		justify-content: var(--HeroJustifyL, center);
		width: var(--HeroWidthL, 100%);
		height: var(--HeroHeightL, auto);
		min-height: var(--HeroMinHeightL, 100svh);
		max-width: 100%;
		background-color: var(--HeroBg, transparent);
		min-width: 0;
		inline-size: 100%;
		max-inline-size: 100%;
		overflow-x: clip;
		overflow-y: hidden;
	}


	.HeroBg {
		position: absolute;
		inset: 0;
		z-index: -1;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}


	.HeroBgImg {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
		user-select: none;
	}


	.HeroLegacyBox {
		position: absolute;
		inset: var(--HeroLegacyPosL, 0% 0% 0% 0%);
		z-index: 1;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-content: var(--HeroLegacyAlign, center);
		align-items: var(--HeroLegacyAlign, center);
	}


	.HeroLegacyTitle {
		margin: 0 0 10px 0;
		font-size: clamp(30px, 3vw, 50px);
		line-height: 1.4;
		color: var(--HeroLegacyTitleClr, black);
		text-align: var(--HeroLegacyAlign, center);
	}


	.HeroLegacyDesc {
		margin: 0 0 10px 0;
		font-size: clamp(18px, 1.2vw, 22px);
		line-height: 1.9;
		max-width: 80ch;
		color: var(--HeroLegacyDescClr, black);
		text-align: var(--HeroLegacyAlign, center);
	}



	.Hero.IsPlaced {
		position: absolute;
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}


	.HeroLegacyBox.LegacyBlurL {
		background: rgba(0, 0, 0, 0.2);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 20px;
		padding: clamp(16px, 2vw, 28px);
	}



</style>




















<style>



	@media (orientation: portrait) {
		.Hero {
			align-items: var(--HeroAlignP, var(--HeroAlignL, center));
			align-content: var(--HeroAlignP, var(--HeroAlignL, center));
			justify-content: var(--HeroJustifyP, var(--HeroJustifyL, center));
			width: var(--HeroWidthP, var(--HeroWidthL, 100%));
			height: var(--HeroHeightP, var(--HeroHeightL, auto));
			min-height: var(--HeroMinHeightP, var(--HeroMinHeightL, 100svh));
		}

		.Hero.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}

		.HeroLegacyBox {
			inset: var(--HeroLegacyPosP, var(--HeroLegacyPosL, 0% 0% 0% 0%));
		}

		.HeroLegacyBox.LegacyBlurL {
			background: transparent;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			border-radius: 0;
			padding: 0;
		}

		.HeroLegacyBox.LegacyBlurP {
			background: rgba(0, 0, 0, 0.2);
			backdrop-filter: blur(10px);
			-webkit-backdrop-filter: blur(10px);
			border-radius: 20px;
			padding: clamp(16px, 2vw, 28px);
		}
	}



</style>
