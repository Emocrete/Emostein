---
import { ElemBg, GetHzAlignCss, GetVrAlignCss, type HzAlignValue, Percent, Pixel, Place, type PlaceProps, type VrAlignValue } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"div">, PlaceProps {
	Centered?: boolean;
	centered?: boolean;
	pHzAlign?: HzAlignValue;
	pVrAlign?: VrAlignValue;
	pGap?: Pixel;
	pPad?: Pixel;
	pBg?: ElemBg;
	pBgColor?: ElemBg;
	pBgOpacity?: Percent;
	pBlur?: Pixel;
}

const cProps = Astro.props as Props & Record<string, unknown>;

const {
	Centered = false,
	centered = false,
	pHzAlign,
	pVrAlign,
	pGap = new Pixel(18, 12),
	pPad = new Pixel(40, 20),
	pBg,
	pBgColor,
	pBgOpacity = new Percent(100),
	pBlur = new Pixel(0),

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("DuoCol"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

const cIsCentered = Centered || centered || GetBoolAttr(cProps["data-centered"]);
const cBg = pBg ?? pBgColor;
const cHzAlign = cIsCentered ? "Center" : pHzAlign ?? "Center";
const cVrAlign = cIsCentered ? "Center" : pVrAlign ?? "Start";

const cHasWidthL = HasExplicitCssSize(pSize?.WidthL);
const cHasWidthP = HasExplicitCssSize(pSize?.WidthP);
const cHasHeightL = HasExplicitCssSize(pSize?.HeightL);
const cHasHeightP = HasExplicitCssSize(pSize?.HeightP);

const cStyle = [
	cHasWidthL ? `--DuoColWidthL:${pSize?.WidthL};` : "",
	cHasWidthP ? `--DuoColWidthP:${pSize?.WidthP};` : "",
	cHasHeightL ? `--DuoColHeightL:${pSize?.HeightL};` : "",
	cHasHeightP ? `--DuoColHeightP:${pSize?.HeightP};` : "",
	`--DuoColGapL:${pGap.Landscape};`,
	`--DuoColGapP:${pGap.Portrait};`,
	`--DuoColPadL:${pPad.Landscape};`,
	`--DuoColPadP:${pPad.Portrait};`,
	`--DuoColBg:${cBg?.Color || "transparent"};`,
	`--DuoColBgOpacityL:${pBgOpacity.Landscape};`,
	`--DuoColBgOpacityP:${pBgOpacity.Portrait};`,
	`--DuoColBlurL:${pBlur.Landscape};`,
	`--DuoColBlurP:${pBlur.Portrait};`,
	`--DuoColAlignItems:${GetHzAlignCss(cHzAlign)};`,
	`--DuoColJustifyContent:${GetVrAlignCss(cVrAlign)};`,
	GetStyleText(pGivenStyle),
].filter(Boolean).join(" ");

const cPlace = new Place({
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
} as PlaceProps, cStyle);

function GetBoolAttr(pValue: unknown) {
	return pValue === true || pValue === "" || pValue === "true";
}

function HasExplicitCssSize(pValue?: string) {
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	return cValue !== "" && cValue !== "auto" && cValue !== "fit-content" && cValue !== "max-content" && cValue !== "min-content";
}

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---

<div
	class={`DuoCol ${cIsCentered ? "IsCentered" : "IsTop"} ${cPlace.Class} ${pGivenClass}`.trim()}
	style={cPlace.Style}
	id={pGivenID}
	data-duo-width-l={cHasWidthL ? "true" : undefined}
	data-duo-width-p={cHasWidthP ? "true" : undefined}
	data-emo-auto-container="true"
	data-emo-explicit-height={cHasHeightL || cHasHeightP ? "true" : "false"}
	data-emo-empty-height="200"
	{...RemAttr}
>
	<slot />
</div>

<style>
	.DuoCol {
		position: relative;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		width: var(--DuoColWidthL, 100%);
		height: var(--DuoColHeightL, auto);
		max-width: 100%;
		min-width: 0;
		padding: var(--DuoColPadL, 0px);
		gap: var(--DuoColGapL, 0px);
		align-items: var(--DuoColAlignItems, center);
		justify-content: var(--DuoColJustifyContent, flex-start);
		background-color: color-mix(in srgb, var(--DuoColBg, transparent) var(--DuoColBgOpacityL, 100%), transparent);
		backdrop-filter: blur(var(--DuoColBlurL, 0px));
		-webkit-backdrop-filter: blur(var(--DuoColBlurL, 0px));
		overflow: visible;
	}

	.DuoCol > :global(*) {
		box-sizing: border-box;
		max-width: 100%;
		min-width: 0;
	}

	.DuoCol > :global(.Emograph:not(.IsPlaced):not(.PlaceSized)) {
		width: 100%;
	}

	.DuoCol > :global(.EmoGallery:not(.IsPlaced):not(.PlaceSized)) {
		width: 100%;
	}

	.DuoCol.IsPlaced {
		position: absolute;
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}

	@media (orientation: portrait) {
		.DuoCol {
			width: var(--DuoColWidthP, var(--DuoColWidthL, 100%));
			height: var(--DuoColHeightP, var(--DuoColHeightL, auto));
			padding: var(--DuoColPadP, var(--DuoColPadL, 0px));
			gap: var(--DuoColGapP, var(--DuoColGapL, 0px));
			background-color: color-mix(in srgb, var(--DuoColBg, transparent) var(--DuoColBgOpacityP, var(--DuoColBgOpacityL, 100%)), transparent);
			backdrop-filter: blur(var(--DuoColBlurP, var(--DuoColBlurL, 0px)));
			-webkit-backdrop-filter: blur(var(--DuoColBlurP, var(--DuoColBlurL, 0px)));
		}

		.DuoCol.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}
	}
</style>
