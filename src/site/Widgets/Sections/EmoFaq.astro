---
import type { HTMLAttributes } from "astro/types";
import { Pixel, Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"section">, PlaceProps , DebugOutlineProps {
	pGap?: Pixel;
	pPad?: Pixel;
	pMinHeight?: Pixel;
}

const cProps = Astro.props as Props & Record<string, unknown>;

if ("pItems" in cProps || "pTitle" in cProps || "pDesc" in cProps || "pMode" in cProps || "pOpenFirst" in cProps) {
	throw new Error("EmoFaq اتغير: استخدم <FaqItem pQuestion=\"...\" pAnswer=\"...\" /> كأبناء داخل <EmoFaq>، ولا تستخدم pItems أو pTitle أو pDesc أو pMode.");
}

const {
	pGap = new Pixel(16, 12),
	pPad = new Pixel(70, 26),
	pMinHeight = new Pixel(520, 0),

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = GetWidgetId("EmoFaq"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

const cGivenStyle = GetStyleText(pGivenStyle);

const cStyle = [
	`--FaqGapL:${pGap.Landscape};`,
	`--FaqGapP:${pGap.Portrait};`,
	`--FaqPadL:${pPad.Landscape};`,
	`--FaqPadP:${pPad.Portrait};`,
	`--FaqMinHeightL:${pMinHeight.Landscape};`,
	`--FaqMinHeightP:${pMinHeight.Portrait};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(cProps as PlaceProps, cStyle);
const cClass = [`EmoFaq`, cPlace.Class, pGivenClass].filter(Boolean).join(" ");

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---




















<section
	class = {cClass}
	style = {cPlace.Style}
	id={pGivenID}
	{...RemAttr}
>







	<div class = " FaqDecor FaqDecorQuestion " aria-hidden="true">

