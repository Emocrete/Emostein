<style>



	@media (orientation: portrait), (max-width: 920px) {
		.EmoFaq {
			min-height: var(--FaqMinHeightP);
		}

		.FaqDecorQuestion {
			left: 18px;
			top: 86px;
			width: 50px;
			height: 64px;
		}

		.FaqDecorCallTop {
			left: auto;
			right: 12px;
			top: 60px;
			width: 112px;
			height: 88px;
		}

		.FaqDecorStepTop {
			left: 43%;
			top: 138px;
			width: 28px;
			height: 28px;
		}

		.FaqDecorCallRight,
		.FaqDecorCallLeft,
		.FaqDecorStepBottom,
		.FaqDecorPlus,
		.FaqDecorCallSmall,
		.FaqDecorSquare,
		.FaqDecorArc
		{
			display: none;
		}

		.FaqTitlePane {
			position: relative;
			right: auto;
			top: auto;
			width: 100%;
			padding: var(--FaqPadP) 14px 0;
			pointer-events: none;
		}

		.FaqTitle {
			font-size: clamp(34px, 10vw, 48px);
			line-height: 1.25;
		}

		.FaqLayout {
			width: 100%;
			min-height: 0;
			padding: 22px 14px var(--FaqPadP);
			direction: rtl;
		}

		.FaqItems {
			gap: var(--FaqGapP);
		}

		.EmoFaq.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}
	}



</style>




















<script>
	type FontReadyDocument = Document & { fonts?: { ready: Promise<unknown> } };

	function SyncFaqQuestionHeights(pRoot: HTMLElement) {
	const cQuestions = Array.from(pRoot.querySelectorAll<HTMLElement>(".FaqQuestion"));
	if (cQuestions.length === 0) return;

	pRoot.style.removeProperty("--FaqQuestionHeight");

	let cMax = 0;
	for (const cQuestion of cQuestions) cMax = Math.max(cMax, cQuestion.scrollHeight);

	pRoot.style.setProperty("--FaqQuestionHeight", `${Math.ceil(cMax)}px`);
	}

	function CloseFaqItems(pItems: HTMLDetailsElement[]) {
	for (const cItem of pItems) cItem.open = false;
	}

	function SetFaqOpenItem(pItems: HTMLDetailsElement[], pNextItem: HTMLDetailsElement | null, pSync: () => void) {
	const cShouldCloseOnly = pNextItem?.open ?? false;

	CloseFaqItems(pItems);

	if (pNextItem && !cShouldCloseOnly) pNextItem.open = true;

	pSync();
	}

	function InitFaq(pRoot: HTMLElement) {
	const cItems = Array.from(pRoot.querySelectorAll<HTMLDetailsElement>(".FaqItem"));
	if (cItems.length === 0) return;

	const cSync = () => SyncFaqQuestionHeights(pRoot);

	for (const cItem of cItems) {
	const cQuestion = cItem.querySelector<HTMLElement>(".FaqQuestion");
	if (!cQuestion) continue;

	cQuestion.addEventListener("click", (pEvent: MouseEvent) => {
	pEvent.preventDefault();
	pEvent.stopPropagation();
	SetFaqOpenItem(cItems, cItem, cSync);
	});
	}

	pRoot.addEventListener("click", (pEvent: MouseEvent) => {
	const cTarget = pEvent.target instanceof Element ? pEvent.target : null;
	if (!cTarget || cTarget.closest(".FaqItem")) return;
	SetFaqOpenItem(cItems, null, cSync);
	});

	cSync();
	window.addEventListener("load", cSync, { once: true });
	window.addEventListener("resize", cSync);
	(document as FontReadyDocument).fonts?.ready.then(cSync);
	}

	for (const cRoot of document.querySelectorAll<HTMLElement>(".EmoFaq")) InitFaq(cRoot);
</script>
