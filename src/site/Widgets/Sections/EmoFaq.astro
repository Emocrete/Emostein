		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		width: 100%;
		min-height: inherit;
		padding-block: var(--FaqPadL);
		padding-left: max(28px, 4vw);
		padding-right: calc(33.333% + clamp(18px, 2.5vw, 46px));
