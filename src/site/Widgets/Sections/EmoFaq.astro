		height: 34px;
	}


	.FaqDecorCallRight {
		right: -54px;
		top: 118px;
		width: clamp(170px, 18vw, 236px);
		height: clamp(112px, 12.2vw, 158px);
	}


	.FaqDecorCallLeft {
		left: clamp(10px, 7.6vw, 120px);
		top: 335px;
		width: clamp(112px, 12.8vw, 160px);
		height: clamp(106px, 12vw, 150px);
	}


	.FaqDecorStepBottom {
		left: 36.3%;
		top: 466px;
		width: 38px;
		height: 38px;
	}


	.FaqDecorPlus {
		right: 19.8%;
		top: 302px;
		width: 34px;
		height: 34px;
	}


	.FaqDecorCallSmall {
		right: 13.8%;
		top: 410px;
		width: clamp(92px, 9vw, 122px);
		height: clamp(82px, 8.2vw, 110px);
	}


	.FaqDecorSquare {
		right: 5.1%;
		top: 462px;
		width: 28px;
		height: 28px;
	}


	.FaqDecorArc {
		right: -18px;
		top: 454px;
		width: 92px;
		height: 92px;
	}


