---
import { Align, ElemBg, GetHzAlignCss, GetVrAlignCss, type HzAlignValue, NumPer, Pixel, Place, type PlaceProps, Size, type VrAlignValue } from "@/TypesLib";
import { Media } from "@/Media";
import { SeoText } from "@/SeoText";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	pBg?: ElemBg;
	pBox?: Size;
	pMinH?: NumPer;
	pHzAlign?: HzAlignValue;
	pVrAlign?: VrAlignValue;
	pGap?: Pixel;
	pHzPad?: Pixel;
	pVrPad?: Pixel;
	pImgF?: string;
	pImgL?: string;
	pImgP?: string;
	Service?: boolean | string;
/** وصف صورة خلفية السكشن لمحركات البحث وقارئات الشاشة. */
pImgAlt?: string;
}

const {
	pBg,
	pBox,
	pMinH,
	pHzAlign,
	pVrAlign,
	pGap = new Pixel(30,30),
	pHzPad = new Pixel(50,5),
	pVrPad = new Pixel(50,5),
	pImgF = "",
	pImgL = "",
	pImgP = "",
	Service = false,
pImgAlt = "",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = "",
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = GetStyleText(pGivenStyle);
const cIsService = GetBoolAttr(Service);
const cIsHero = GetBoolAttr((Astro.props as Record<string, unknown>)["data-hero"]);
const cLoading: "eager" | "lazy" = cIsHero ? "eager" : "lazy";
const cFetchPriority: "high" | undefined = cIsHero ? "high" : undefined;
const cPagePath = Astro.url.pathname;
const cImgFolder = pImgF || Media.GetPageFolder(cPagePath);
const cUseAutoHeroImg = cIsHero || pImgF !== "";

const cBgImgL = pImgL
? Media.GetPageFile(cPagePath, pImgL, { pFolder: cImgFolder })
: cUseAutoHeroImg
	? Media.GetHeroLandscape(cPagePath, { pFolder: cImgFolder })
	: pBg?.Img?.LinkL || "";

const cBgImgP = pImgP
? Media.GetPageFile(cPagePath, pImgP, { pFolder: cImgFolder })
: pImgL
	? cBgImgL
	: cUseAutoHeroImg
		? Media.GetHeroPortrait(cPagePath, { pFolder: cImgFolder })
		: pBg?.Img?.LinkP || pBg?.Img?.LinkL || "";

const cFinalBgImgL = cBgImgL || cBgImgP;
const cFinalBgImgP = cBgImgP || cBgImgL;
const cHasBgImg = cFinalBgImgL !== "" || cFinalBgImgP !== "";
const cBgAlt = pImgAlt || pBg?.Img?.Alt || SeoText.GetLocalsImageAlt(Astro.locals);

const cHzAlign = pHzAlign ?? Align.Center;
const cVrAlign = pVrAlign ?? Align.Center;
const cHasExplicitHeight = HasExplicitCssSize(pBox?.HeightL) || HasExplicitCssSize(pBox?.HeightP) || HasExplicitCssSize(pSize?.HeightL) || HasExplicitCssSize(pSize?.HeightP);

const cSectionStyle = [
	`--SecBg:${pBg?.Color || "transparent"};`,
	`--SecWidthL:${pBox?.WidthL || "100%"};`,
	`--SecWidthP:${pBox?.WidthP || pBox?.WidthL || "100%"};`,
	`--SecHeightL:${pBox?.HeightL || "auto"};`,
	`--SecHeightP:${pBox?.HeightP || pBox?.HeightL || "auto"};`,
	`--SecMinHeightL:${pMinH?.Landscape || (cIsHero ? "100svh" : "auto")};`,
	`--SecMinHeightP:${pMinH?.Portrait || (cIsHero ? "100svh" : "auto")};`,
	`--SecAlignL:${GetHzAlignCss(cHzAlign, "Landscape")};`,
	`--SecAlignP:${GetHzAlignCss(cHzAlign, "Portrait")};`,
	`--SecJustifyL:${GetVrAlignCss(cVrAlign, "Landscape")};`,
	`--SecJustifyP:${GetVrAlignCss(cVrAlign, "Portrait")};`,
	`--SecGapL:${pGap.Landscape};`,
	`--SecGapP:${pGap.Portrait};`,
	`--SecHzPadL:${pHzPad.Landscape};`,
	`--SecHzPadP:${pHzPad.Portrait};`,
	`--SecVrPadL:${pVrPad.Landscape};`,
	`--SecVrPadP:${pVrPad.Portrait};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps, cSectionStyle);

function GetStyleText(pStyle: Props["style"]) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}

function GetBoolAttr(pValue: unknown) {
	return pValue === true || pValue === "" || pValue === "true";
}

function HasExplicitCssSize(pValue?: string) {
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	return cValue !== "" && cValue !== "auto" && cValue !== "fit-content" && cValue !== "max-content" && cValue !== "min-content";
}
---





<section
	class = {`EmoSection ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	data-ga-service={cIsService ? "true" : undefined}
	data-ga-item-id={pGivenID || undefined}
	data-emo-auto-container="true"
	data-emo-explicit-height={cHasExplicitHeight ? "true" : "false"}
	data-emo-empty-height="200"
	{...RemAttr}
>

	{ cHasBgImg && (

		<picture class = " EmoSectionBg " data-emo-container-bg="true">
		
		
		
		
		
		
		
			<source media="(orientation: portrait)" srcset={cFinalBgImgP} />
		
		
		
		
		
		
		
			<img
				class = " EmoSectionBgImg "
				src={cFinalBgImgL}
				alt={cBgAlt}
				loading={cLoading}
				decoding="async"
				fetchpriority={cFetchPriority}
			/>
		
		
		
		
		
		
		
		</picture>
	) }

	<slot />







</section>





<style>



	.EmoSection {
		position: relative;
		isolation: isolate;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: var(--SecAlignL, center);
		align-content: var(--SecAlignL, center);
		justify-content: var(--SecJustifyL, center);
		width: var(--SecWidthL, 100%);
		height: var(--SecHeightL, auto);
		min-height: var(--SecMinHeightL, auto);
		max-width: 100%;
		padding-inline: var(--SecHzPadL, 0);
		padding-block: var(--SecVrPadL, 0);
		gap: var(--SecGapL, 0);
		background-color: var(--SecBg, transparent);
		min-width: 0;
		inline-size: 100%;
		max-inline-size: 100%;
		overflow-x: clip;
		overflow-y: hidden;
	}


	.EmoSectionBg {
		position: absolute;
		inset: 0;
		z-index: -1;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}


	.EmoSectionBgImg {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
		user-select: none;
	}



	.EmoSection.IsPlaced {
		position: absolute;
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}



	.EmoSection[hidden] {
		display: none;
	}



</style>





<style>



	@media (orientation: portrait) {
		.EmoSection {
			align-items: var(--SecAlignP, var(--SecAlignL, center));
			align-content: var(--SecAlignP, var(--SecAlignL, center));
			justify-content: var(--SecJustifyP, var(--SecJustifyL, center));
			width: var(--SecWidthP, var(--SecWidthL, 100%));
			height: var(--SecHeightP, var(--SecHeightL, auto));
			min-height: var(--SecMinHeightP, var(--SecMinHeightL, auto));
			padding-inline: var(--SecHzPadP, var(--SecHzPadL, 0));
			padding-block: var(--SecVrPadP, var(--SecVrPadL, 0));
			gap: var(--SecGapP, var(--SecGapL, 0));
		}

		.EmoSection.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}
	}



</style>
