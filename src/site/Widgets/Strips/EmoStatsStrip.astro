<style>



	.EmoStatsStrip {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		width: 100%;
		height: min(400px, 46vw);
		min-height: 300px;
		box-sizing: border-box;
		direction: rtl;
		background: radial-gradient(circle at 4% 26%, rgba(255, 209, 92, 0.10), transparent 20%),
			radial-gradient(circle at 96% 42%, rgba(38, 181, 255, 0.13), transparent 24%),
			linear-gradient(135deg, #071426 0%, #081b31 55%, #06101e 100%);
		color: #f8fbff;
		border-block: 1px solid rgba(125, 190, 255, 0.18);
	}

	.EmoStatsStrip::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
			linear-gradient(0deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
		background-size: 36px 36px;
		opacity: 0.26;
	}


	.SvgDefs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}


	.StatsShell {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 9px;
		width: min(1880px, calc(100% - 18px));
		height: 100%;
		margin-inline: auto;
		padding-block: 12px;
		box-sizing: border-box;
	}


	.StatsTop {
		display: grid;
		grid-template-columns: minmax(300px, 1fr) auto;
		align-items: center;
		gap: 12px;
		min-height: 48px;
	}


	.StatsTitleBox {
		display: grid;
		grid-template-columns: auto auto 1fr;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.StatsTitleBox h2 {
		margin: 0;
		color: #ffffff;
		font-size: 21px;
		font-weight: 950;
		line-height: 1.25;
		white-space: nowrap;
	}

	.StatsTitleBox p {
		margin: 0;
		color: rgba(248, 251, 255, 0.64);
		font-size: 12px;
		font-weight: 700;
		line-height: 1.6;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}


	.StatsKicker {
		display: inline-flex;
		width: fit-content;
		padding: 4px 10px;
		border: 1px solid rgba(255, 209, 92, 0.34);
		border-radius: 999px;
		background: rgba(255, 209, 92, 0.10);
		color: #ffd15c;
		font-size: 11px;
		font-weight: 950;
		line-height: 1.2;
		white-space: nowrap;
	}


	.StatsLive {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		width: fit-content;
		padding: 7px 11px;
		border: 1px solid rgba(125, 211, 255, 0.22);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.065);
		color: rgba(248, 251, 255, 0.76);
		font-size: 11px;
		font-weight: 850;
		white-space: nowrap;
	}

	.StatsLive span {
		width: 7px;
		height: 7px;
