---
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	pTitle?: string;
	pDesc?: string;
	pOfferTitle?: string;
	pOfferDesc?: string;
	pOfferButtonText?: string;
	pShowOffer?: boolean;
	pFooterMode?: boolean;
	pCyclEmoSeconds?: number;
}

const {
	pTitle = "مؤشرات نشاط الموقع",
	pDesc = "متابعة مختصرة للصفحة والقسم والموقع، قابلة للربط لاحقًا بسجل إحصائي حقيقي.",
	pOfferTitle = "فرصة متابعة مبكرة",
	pOfferDesc = "أنت ضمن مجموعة زوار مؤهلة للحصول على متابعة خاصة عند تفعيل عروض هذا القسم.",
	pOfferButtonText = "سجّل اهتمامك",
	pShowOffer = true,
	pFooterMode = false,
	pCyclEmoSeconds = 5,
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = GetWidgetId("EmoStatsStrip"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";

const cPathParts = Astro.url.pathname.split("/").filter(Boolean);
const cSectionKey = cPathParts[0] ?? "home";
const cSubSectionKey = cPathParts[1] ?? "";

const cSectionName = GetSectionName(cSectionKey);
const cSubSectionName = GetSubSectionName(cSectionKey, cSubSectionKey);

function GetSectionName(pSectionKey: string): string {
	switch (pSectionKey.toLowerCase()) {
		case "emodsign":
			return "التصميمات";
		case "emocrete":
			return "المقاولات";
		case "emoperm":
			return "التراخيص";
		case "emonsult":
			return "الاستشارات";
		case "emomed":
			return "المنشآت الطبية";
		case "emostone":
			return "الرخام والجرانيت";
		case "emochain":
			return "التوريدات";
		case "emostate":
			return "العقارات";
		default:
			return "الموقع";
	}
}

function GetSubSectionName(pSectionKey: string, pSubSectionKey: string): string {
	const cKey = `${pSectionKey.toLowerCase()}/${pSubSectionKey.toLowerCase()}`;

	switch (cKey) {
		case "emodsign/des":
			return "خدمات التصميم";
		case "emodsign/tech":
			return "الخدمات الفنية";
		case "emoperm/retail":
			return "تراخيص المحلات";
		case "emoperm/building":
			return "تراخيص البناء";
		case "emoperm/factory":
			return "تراخيص المصانع";
		case "emomed/clinic":
			return "العيادات";
		case "emomed/hospital":
			return "المستشفيات";
		case "emocrete/finishing":
			return "التشطيبات";
		case "emocrete/contracting":
			return "المقاولات";
		case "emostone/marble":
			return "الرخام";
		case "emostone/granit":
			return "الجرانيت";
		default:
			return cSectionName;
	}
}

const cPlace = new Place(Astro.props as PlaceProps, cGivenStyle);
const cFooterModeClass = pFooterMode ? "IsFooterMode" : "";
const cCycleMs = Math.max(1000, Number(pCyclEmoSeconds || 5) * 1000);
---





