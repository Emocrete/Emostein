<script>
	if (!window.__EmoCoverageMapStripReady) {
	window.__EmoCoverageMapStripReady = true;
	document.addEventListener("astro:page-load", SetupCoverageMaps);
	window.addEventListener("load", SetupCoverageMaps);
	SetupCoverageMaps();
	}

	function SetupCoverageMaps(): void {
	const cStrips = document.querySelectorAll<HTMLElement>("[data-emo-coverage-map-strip='true']:not([data-coverage-ready='true'])");

	cStrips.forEach(function SetupStrip(pRoot): void {
	pRoot.dataset.coverageReady = "true";

	const cToggle = pRoot.querySelector<HTMLButtonElement>("[data-map-toggle='true']");
	const cToggleText = pRoot.querySelector<HTMLElement>("[data-map-toggle-text='true']");

	cToggle?.addEventListener("click", function HandleToggleClick(): void {
	const cCurrentMap = pRoot.dataset.currentMap === "egypt" ? "local" : "egypt";

	pRoot.dataset.currentMap = cCurrentMap;

	if (cToggleText) {
	cToggleText.textContent = cCurrentMap === "egypt"
	? "عرض خريطة المحافظة"
	: "عرض خريطة مصر";
	}
	});
	});
	}
</script>
