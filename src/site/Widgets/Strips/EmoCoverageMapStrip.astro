---
import type { HTMLAttributes } from "astro/types";
import { Place, type PlaceProps } from "@/TypesLib";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	pTitle?: string;
	pDesc?: string;
	pDetectedGovernorate?: string;
	pDetectedArea?: string;
	pCurrentServiceName?: string;
	pPartnerTargetId?: string;
}

const {
	pTitle = "خريطة تغطية الخدمة",
	pDesc = "عرض سريع لنطاق التغطية الحالي للخدمة داخل مصر، مع قراءة مبدئية للمحافظة والمنطقة التي يزور منها العميل.",
	pDetectedGovernorate = "القاهرة",
	pDetectedArea = "التجمع الخامس",
	pCurrentServiceName = "الخدمة الحالية",
	pPartnerTargetId = "/emochain/partners",
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = GetWidgetId("EmoCoverageMapStrip"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";

const cIsAlex = pDetectedGovernorate === "الإسكندرية";
const cGovTitle = cIsAlex ? "خريطة الإسكندرية" : "خريطة القاهرة";
const cGovDesc = cIsAlex ? "قراءة مبدئية لمناطق الإسكندرية حسب بيانات الزائر" : "قراءة مبدئية لمناطق القاهرة حسب بيانات الزائر";

const cPlace = new Place(Astro.props as PlaceProps, cGivenStyle);
const cPartnerHref = GetPartnerHref(pPartnerTargetId);

function GetPartnerHref(pTarget: string): string {
	if (pTarget.startsWith("#") || pTarget.startsWith("/") || pTarget.startsWith("http")) {
		return pTarget;
	}

	return `#${pTarget}`;
}
