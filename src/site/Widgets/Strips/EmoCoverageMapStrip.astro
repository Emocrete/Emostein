<style>



	.EmoCoverageMapStrip {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		width: 100%;
		min-height: 620px;
		box-sizing: border-box;
		direction: rtl;
		background: radial-gradient(circle at 7% 24%, rgba(255, 209, 92, 0.13), transparent 24%),
			radial-gradient(circle at 94% 48%, rgba(38, 181, 255, 0.15), transparent 25%),
			linear-gradient(135deg, #071426 0%, #081b31 54%, #06101e 100%);
		color: #f8fbff;
		border-block: 1px solid rgba(125, 190, 255, 0.18);
	}

	.EmoCoverageMapStrip::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
			linear-gradient(0deg, rgba(255, 255, 255, 0.032) 1px, transparent 1px);
		background-size: 38px 38px;
		opacity: 0.28;
	}


	.SvgDefs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}


	.CoverageShell {
		display: grid;
		grid-template-rows: auto 1fr;
		gap: 14px;
		width: min(1600px, calc(100% - 30px));
		min-height: 620px;
		margin-inline: auto;
		padding-block: 22px;
		box-sizing: border-box;
	}


	.CoverageHead {
		display: grid;
		grid-template-columns: minmax(320px, 1fr) auto auto;
		align-items: center;
		gap: 14px;
	}


	.TitleBox {
		display: grid;
		grid-template-columns: auto auto 1fr;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.TitleBox strong {
		display: inline-flex;
		width: fit-content;
		padding: 5px 11px;
		border: 1px solid rgba(255, 209, 92, 0.34);
		border-radius: 999px;
		background: rgba(255, 209, 92, 0.10);
		color: #ffd15c;
		font-size: 12px;
		font-weight: 950;
		white-space: nowrap;
	}

	.TitleBox h2 {
		margin: 0;
		color: #ffffff;
		font-size: 24px;
		font-weight: 950;
		line-height: 1.25;
		white-space: nowrap;
	}

	.TitleBox p {
		margin: 0;
		color: rgba(248, 251, 255, 0.65);
		font-size: 13px;
		font-weight: 700;
		line-height: 1.7;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}


	.DetectedBox {
		display: grid;
		gap: 2px;
		padding: 8px 13px;
		border: 1px solid rgba(125, 211, 255, 0.24);
		border-radius: 15px;
		background: rgba(255, 255, 255, 0.07);
		white-space: nowrap;
	}

	.DetectedBox span {
		color: rgba(248, 251, 255, 0.58);
		font-size: 10px;
		font-weight: 800;
	}

	.DetectedBox b {
		color: #7dd3ff;
		font-size: 13px;
		font-weight: 950;
	}


	.MobileToggle {
		display: none;
		height: 36px;
		padding-inline: 13px;
		border: 1px solid rgba(255, 209, 92, 0.28);
		border-radius: 13px;
		background: rgba(255, 209, 92, 0.12);
		color: #ffd15c;
		font-family: inherit;
		font-size: 12px;
		font-weight: 950;
		cursor: pointer;
	}


	.MapsGrid {
		display: grid;
		grid-template-columns: 0.78fr 1.22fr;
		gap: 14px;
		min-height: 0;
	}


	.MapCard {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 10px;
		min-width: 0;
		min-height: 0;
		padding: 13px;
		border: 1px solid rgba(125, 190, 255, 0.20);
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.055);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08),
