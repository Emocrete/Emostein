<script>
	const cEmailJsPublicKey = "OleHS6UOuh_Wj_5p_";
	const cEmailJsServiceId = "EmoMail";
	const cEmailJsTemplateId = "EmoMailTempID20015161";
	const cNotifyEmail = "emocrete@gmail.com";

	const cEmailJsSrc = "https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js";

	type EmailJsBrowser = {
	init: (pOptions: { publicKey: string }) => void;
	send: (pServiceId: string, pTemplateId: string, pTemplateParams: Record<string, string>) => Promise<unknown>;
	};

	type ContactWindow = Window & {
	__EmoContactStripReady?: boolean;
	__EmoContactStripEmailJsLoading?: Promise<EmailJsBrowser>;
	emailjs?: EmailJsBrowser;
	};

	const cWindow = window as ContactWindow;

	if (!cWindow.__EmoContactStripReady) {
	cWindow.__EmoContactStripReady = true;
	document.addEventListener("astro:page-load", SetupContactStrips);
	window.addEventListener("load", SetupContactStrips);
	SetupContactStrips();
	}

	function SetupContactStrips(): void {
	const cStrips = document.querySelectorAll<HTMLElement>("[data-emo-contact-strip='true']:not([data-contact-ready='true'])");

	cStrips.forEach(SetupContactStrip);
	}

	function SetupContactStrip(pRoot: HTMLElement): void {
	pRoot.dataset.contactReady = "true";

	const cSubmitButton = pRoot.querySelector<HTMLButtonElement>("[data-lead-submit='true']");
	const cInstantWhatsapp = pRoot.querySelector<HTMLAnchorElement>("[data-whatsapp-instant='true']");

	cSubmitButton?.addEventListener("click", function HandleSubmitClick(): void {
	void SendLeadEmail(pRoot);
	});

	if (cInstantWhatsapp) {
	cInstantWhatsapp.href = GetWhatsappUrl(pRoot, BuildInstantWhatsappMessage(pRoot));
	}
	}

	async function SendLeadEmail(pRoot: HTMLElement): Promise<void> {
	const cPhoneInput = pRoot.querySelector<HTMLInputElement>("[data-lead-phone='true']");
	const cStatus = pRoot.querySelector<HTMLElement>("[data-lead-status='true']");
	const cSubmitButton = pRoot.querySelector<HTMLButtonElement>("[data-lead-submit='true']");
	const cClientPhone = NormalizePhone(cPhoneInput?.value || "");

	if (!cClientPhone) {
	ShowStatus(cStatus, "اكتب رقم الهاتف فقط، ثم اضغط تسجيل التواصل.", "IsError");
	cPhoneInput?.focus();
	return;
	}

	if (!cEmailJsPublicKey || !cEmailJsServiceId || !cEmailJsTemplateId || !cNotifyEmail) {
	ShowStatus(cStatus, "إعدادات تسجيل الطلب غير مكتملة.", "IsError");
	return;
	}

	const cMethod = GetCheckedValue(pRoot, "[data-lead-method='true']", "اتصال");
	const cTime = GetCheckedValue(pRoot, "[data-lead-time='true']", "صباحًا");
	const cCreatedAt = GetEgyptTimeText();

	SetSubmitBusy(cSubmitButton, true);
	ShowStatus(cStatus, "جاري تسجيل طلب التواصل...", "IsDone");

	try {
	const cEmailJs = await LoadEmailJs();

	cEmailJs.init({
	publicKey: cEmailJsPublicKey
	});

	await cEmailJs.send(cEmailJsServiceId, cEmailJsTemplateId, {
	to_email: cNotifyEmail,
	subject: "طلب تواصل جديد من موقع Emocrete",
	page_title: document.title,
	page_url: location.href,
	client_phone: cClientPhone,
	preferred_method: cMethod,
	preferred_time: cTime,
	source_name: pRoot.dataset.sourceName || "موقع Emocrete",
	created_at: cCreatedAt
	});

	if (cPhoneInput) cPhoneInput.value = "";

	ShowStatus(cStatus, "تم تسجيل طلب التواصل، وسنرد عليك في الموعد المناسب.", "IsDone");

	} catch (pError) {
	console.error("EmailJS Error:", pError);
	ShowStatus(cStatus, "تعذر تسجيل الطلب حاليًا. جرب الاتصال أو واتساب مباشر.", "IsError");

	} finally {
	SetSubmitBusy(cSubmitButton, false);
	}
	}

	function LoadEmailJs(): Promise<EmailJsBrowser> {
	if (cWindow.emailjs) return Promise.resolve(cWindow.emailjs);
	if (cWindow.__EmoContactStripEmailJsLoading) return cWindow.__EmoContactStripEmailJsLoading;

	cWindow.__EmoContactStripEmailJsLoading = new Promise<EmailJsBrowser>(function HandleEmailJsLoad(pResolve, pReject): void {
	const cScript = document.createElement("script");

	cScript.src = cEmailJsSrc;
	cScript.async = true;

	cScript.addEventListener("load", function HandleLoad(): void {
	if (cWindow.emailjs) {
	pResolve(cWindow.emailjs);
	return;
	}

	pReject(new Error("EmailJS library did not load."));
	});

	cScript.addEventListener("error", function HandleError(): void {
	pReject(new Error("EmailJS library loading failed."));
	});

	document.head.appendChild(cScript);
	});

	return cWindow.__EmoContactStripEmailJsLoading;
	}

	function BuildInstantWhatsappMessage(pRoot: HTMLElement): string {
	return [
	"أهلا، أحتاج تواصل سريع.",
	`المصدر: ${pRoot.dataset.sourceName || "موقع Emocrete"}`,
	`الصفحة: ${document.title}`,
	`الرابط: ${location.href}`,
	].join("\n");
	}

	function GetWhatsappUrl(pRoot: HTMLElement, pMessage: string): string {
	const cOwnerWhatsapp = pRoot.dataset.ownerWhatsapp || "201014490054";

	return `https://wa.me/${cOwnerWhatsapp}?text=${encodeURIComponent(pMessage)}`;
	}

	function GetCheckedValue(pRoot: HTMLElement, pSelector: string, pDefaultValue: string): string {
	const cCheckedInput = pRoot.querySelector<HTMLInputElement>(`${pSelector}:checked`);

	return cCheckedInput?.value || pDefaultValue;
	}

	function NormalizePhone(pValue: string): string {
	const cDigits = pValue.replace(/\D/g, "");

	if (cDigits.length < 8) return "";

	return cDigits;
	}

	function GetEgyptTimeText(): string {
	return new Intl.DateTimeFormat("ar-EG", {
	timeZone: "Africa/Cairo",
	dateStyle: "medium",
	timeStyle: "short"
	}).format(new Date());
	}

	function SetSubmitBusy(pButton: HTMLButtonElement | null, pIsBusy: boolean): void {
	if (!pButton) return;

	pButton.disabled = pIsBusy;
	}

	function ShowStatus(pStatus: HTMLElement | null, pText: string, pClassName: "IsError" | "IsDone"): void {
	if (!pStatus) return;

	pStatus.textContent = pText;
	pStatus.classList.remove("IsError", "IsDone");
	pStatus.classList.add(pClassName);
	}
</script>
