</style>




















<script>
	const cEmailJsSrc = "https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js";

	type EmailJsBrowser = {
	init: (pOptions: { publicKey: string }) => void;
	send: (pServiceId: string, pTemplateId: string, pTemplateParams: Record<string, string>) => Promise<unknown>;
	};

	type RatingWindow = Window & {
	__EmoRatingStripReady?: boolean;
	__EmoRatingStripEmailJsLoading?: Promise<EmailJsBrowser>;
	emailjs?: EmailJsBrowser;
	};

	type LocalStarRating = {
	ratingValue: number;
	pagePath: string;
	createdAt: string;
	};

	type LiveRatingData = {
	ok?: boolean;
	hasRating?: boolean;
	ratingValue?: number;
	ratingCount?: number;
	review?: {
	ratingComment?: string;
	} | null;
	};

	const cWindow = window as RatingWindow;

	if (!cWindow.__EmoRatingStripReady) {
	cWindow.__EmoRatingStripReady = true;
	document.addEventListener("astro:page-load", SetupRatingStrips);
	window.addEventListener("load", SetupRatingStrips);
	SetupRatingStrips();
	}

	function SetupRatingStrips(): void {
	const cStrips = document.querySelectorAll<HTMLElement>("[data-emo-rating-strip='true']:not([data-rating-ready='true'])");

	cStrips.forEach(SetupRatingStrip);
	}

	function SetupRatingStrip(pRoot: HTMLElement): void {
	pRoot.dataset.ratingReady = "true";

	const cForm = pRoot.querySelector<HTMLFormElement>("[data-rating-form='true']");
	const cStarsZone = pRoot.querySelector<HTMLElement>("[data-stars-zone='true']");
	const cStarsRow = pRoot.querySelector<HTMLElement>("[data-stars-row='true']");
	const cStars = pRoot.querySelectorAll<HTMLButtonElement>("[data-star-value]");
	const cComment = pRoot.querySelector<HTMLTextAreaElement>("[data-rating-comment='true']");

	if (cComment) cComment.value = "";

	RenderAverageStars(pRoot, GetCurrentAverage(pRoot));

	const cSavedRating = ReadLocalStarRating(pRoot);

	if (cSavedRating) {
	LockStarRating(pRoot, cSavedRating.ratingValue, "تم قراءة تقييمك السابق لهذه الصفحة.");
	} else {
	RestoreAverageStars(pRoot);
	}

	cStars.forEach(function SetupStar(pStar): void {
	pStar.addEventListener("click", function HandleStarClick(): void {
	void SubmitStarRating(pRoot, GetStarValue(pStar));
	});

	pStar.addEventListener("pointerenter", function HandleStarPointerEnter(): void {
	if (IsStarLocked(pRoot)) return;
	PreviewRating(pRoot, GetStarValue(pStar));
	});

	pStar.addEventListener("focus", function HandleStarFocus(): void {
	if (IsStarLocked(pRoot)) return;
	PreviewRating(pRoot, GetStarValue(pStar));
	});
	});

	cStarsRow?.addEventListener("pointerleave", function HandleStarsPointerLeave(): void {
	if (IsStarLocked(pRoot)) return;
	RestoreAverageStars(pRoot);
	});

	cStarsZone?.addEventListener("focusout", function HandleStarsFocusOut(): void {
	window.setTimeout(function RestoreAfterFocusMove(): void {
	if (IsStarLocked(pRoot)) return;

	const cActiveElement = document.activeElement;

	if (cActiveElement instanceof HTMLElement && cStarsZone.contains(cActiveElement)) return;

	RestoreAverageStars(pRoot);
	}, 0);
	});

	cForm?.addEventListener("submit", function HandleSubmit(pEvent): void {
	pEvent.preventDefault();
	void SendComment(pRoot);
	});

	void RefreshRatingFromSheet(pRoot);

	if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
	pRoot.addEventListener("dblclick", async function CopyRatingMessage(): Promise<void> {
	if (!pRoot.id) return;

	const cPageTitle = document.title
	.split("|")
	.map(function CleanTitlePart(pPart): string {
	return pPart.trim();
	})
	.filter(function KeepTitlePart(pPart): boolean {
	return pPart !== "Emostein" && pPart !== "Emodsign" && pPart !== "Emocrete" && pPart !== "Emostone" && pPart !== "Emochain" && pPart !== "Emoperm" && pPart !== "Emomed" && pPart !== "Emonsult" && pPart !== "Emostate" && pPart !== "م. أيمن عاشور" && !/^\d{4}$/.test(pPart);
	})
	.at(-1) ?? "";
	const cUrl = new URL(location.href);

	cUrl.search = "";
	cUrl.hash = pRoot.id;

	await navigator.clipboard.writeText(
	`نسعد بالإطلاع على آرائكم وملاحظاتكم لتحسين محتوى الخدمة\n\nلتقييم صفحة ${cPageTitle} انتقل للرابط بالأسفل :\n\n${cUrl.href}\n\nشكرًا لكم 🌷`
	).catch(function IgnoreCopyError(): void {});
	});
	}
	}

	async function SubmitStarRating(pRoot: HTMLElement, pRating: number): Promise<void> {
	if (IsStarLocked(pRoot)) return;
	if (pRating < 1 || pRating > 5) return;

	const cStatus = pRoot.querySelector<HTMLElement>("[data-rating-status='true']");
	const cPayload = BuildStarPayload(pRoot, pRating);

	LockStarRating(pRoot, pRating, "تم تسجيل تقييمك لهذه الصفحة.");
	SaveLocalStarRating(pRoot, pRating);
	ShowStatus(cStatus, "تم تسجيل التقييم.", "IsDone");

	const cStorageResult = await SavePayloadIfNeeded(pRoot, cPayload)
	.then(function HandleStored(): boolean {
	return true;
	})
	.catch(function HandleStorageError(pError): boolean {
	console.warn("Star rating storage warning:", pError);

	return false;
	});

	const cEmailResult = await SendPayloadEmailIfConfigured(pRoot, cPayload, GetStarEmailSubject(pRoot))
	.then(function HandleSent(): boolean {
	return true;
	})
	.catch(function HandleEmailError(pError): boolean {
	console.warn("Star rating email warning:", pError);

	return false;
	});

	if (!cStorageResult && !cEmailResult) {
	ShowStatus(cStatus, "تم تثبيت اختيارك، لكن تعذر الإرسال الآن.", "IsError");
	return;
	}

	window.setTimeout(function RefreshAfterStarSaved(): void {
	void RefreshRatingFromSheet(pRoot).then(function HandleRatingRefresh(): void {
	ShowStatus(cStatus, "تم تسجيل التقييم.", "IsDone");
	});
	}, 900);
	}

	async function SendComment(pRoot: HTMLElement): Promise<void> {
	const cComment = GetComment(pRoot);
	const cStatus = pRoot.querySelector<HTMLElement>("[data-rating-status='true']");
	const cSubmitButton = pRoot.querySelector<HTMLButtonElement>("[data-rating-submit='true']");

	if (cComment.length < 3) {
	ShowStatus(cStatus, "اكتب تعليقًا مختصرًا قبل إرسال الرأي.", "IsError");
	return;
	}

	const cPayload = BuildCommentPayload(pRoot, cComment);

	SetSubmitBusy(cSubmitButton, true);
	ShowStatus(cStatus, "جاري إرسال تعليقك...", "IsDone");

	try {
	await SendPayloadEmailIfConfigured(pRoot, cPayload, GetCommentEmailSubject(pRoot));
	await SavePayloadIfNeeded(pRoot, cPayload);
	ClearComment(pRoot);
	ShowStatus(cStatus, "تم إرسال تعليقك بنجاح.", "IsDone");
	} catch (pError) {
	console.error("Comment submit error:", pError);
	ShowStatus(cStatus, "تعذر إرسال التعليق حاليًا. حاول مرة أخرى لاحقًا.", "IsError");
	} finally {
	SetSubmitBusy(cSubmitButton, false);
	}
	}

	function BuildStarPayload(pRoot: HTMLElement, pRating: number): Record<string, string> {
	return {
	payload_type: "page_rating",
	page_title: document.title,
	page_url: location.href,
	page_path: NormalizePath(location.pathname),
	rating_value: String(pRating),
	rating_label: GetRatingLabel(pRating),
	rating_comment: "",
	source_name: pRoot.dataset.sourceName || "موقع Emocrete",
	created_at: GetEgyptTimeText(),
	visitor_key: GetVisitorKey(),
	user_agent: navigator.userAgent
	};
	}

	function BuildCommentPayload(pRoot: HTMLElement, pComment: string): Record<string, string> {
	const cSavedRating = ReadLocalStarRating(pRoot);
	const cRating = cSavedRating?.ratingValue || 0;

	return {
	payload_type: "page_comment",
	page_title: document.title,
	page_url: location.href,
	page_path: NormalizePath(location.pathname),
	rating_value: cRating ? String(cRating) : "",
	rating_label: cRating ? GetRatingLabel(cRating) : "تعليق بدون تقييم نجوم من نفس المتصفح",
	rating_comment: pComment,
	source_name: pRoot.dataset.sourceName || "موقع Emocrete",
	created_at: GetEgyptTimeText(),
	visitor_key: GetVisitorKey(),
	user_agent: navigator.userAgent
	};
	}

	async function SendPayloadEmailIfConfigured(pRoot: HTMLElement, pPayload: Record<string, string>, pSubject: string): Promise<void> {
	const cPublicKey = pRoot.dataset.emailJsPublicKey || "";
	const cServiceId = pRoot.dataset.emailJsServiceId || "";
	const cTemplateId = pRoot.dataset.emailJsTemplateId || "";
	const cNotifyEmail = pRoot.dataset.notifyEmail || "";

	if (!cPublicKey || !cServiceId || !cTemplateId || !cNotifyEmail) return;

	const cEmailJs = await LoadEmailJs();

	cEmailJs.init({
	publicKey: cPublicKey
	});

	await cEmailJs.send(cServiceId, cTemplateId, {
	to_email: cNotifyEmail,
	subject: pSubject,
	...pPayload
	});
	}

	function GetStarEmailSubject(pRoot: HTMLElement): string {
	return pRoot.dataset.starEmailSubject || "تقييم نجوم جديد على صفحة من موقع Emocrete";
	}

	function GetCommentEmailSubject(pRoot: HTMLElement): string {
	return pRoot.dataset.emailSubject || "تعليق جديد على صفحة من موقع Emocrete";
	}

	async function SavePayloadIfNeeded(pRoot: HTMLElement, pPayload: Record<string, string>): Promise<void> {
	const cStorageUrl = pRoot.dataset.storageUrl || "";

	if (!cStorageUrl) return;

	await fetch(cStorageUrl, {
	method: "POST",
	mode: "no-cors",
	headers: {
	"Content-Type": "text/plain;charset=utf-8"
	},
	body: JSON.stringify(pPayload)
	});
	}

	function LoadEmailJs(): Promise<EmailJsBrowser> {
	if (cWindow.emailjs) return Promise.resolve(cWindow.emailjs);
	if (cWindow.__EmoRatingStripEmailJsLoading) return cWindow.__EmoRatingStripEmailJsLoading;

	cWindow.__EmoRatingStripEmailJsLoading = new Promise<EmailJsBrowser>(function HandleEmailJsLoad(pResolve, pReject): void {
	const cScript = document.createElement("script");

	cScript.src = cEmailJsSrc;
	cScript.async = true;

	cScript.addEventListener("load", function HandleLoad(): void {
	if (cWindow.emailjs) {
	pResolve(cWindow.emailjs);
	return;
	}

	pReject(new Error("EmailJS library did not load."));
	});

	cScript.addEventListener("error", function HandleError(): void {
	pReject(new Error("EmailJS library loading failed."));
	});

	document.head.appendChild(cScript);
	});

	return cWindow.__EmoRatingStripEmailJsLoading;
	}

	function LockStarRating(pRoot: HTMLElement, pRating: number, pHint: string): void {
	const cInput = pRoot.querySelector<HTMLInputElement>("[data-rating-value-input='true']");
	const cStars = pRoot.querySelectorAll<HTMLButtonElement>("[data-star-value]");

	pRoot.dataset.starLocked = "true";
	pRoot.classList.add("IsStarLocked");

	if (cInput) cInput.value = String(pRating);

	UpdateStars(pRoot, pRating);
	UpdateHint(pRoot, pHint);
	UpdateUserPill(pRoot, pRating);

	cStars.forEach(function LockStar(pStar): void {
	pStar.setAttribute("aria-disabled", "true");
	pStar.tabIndex = -1;
	});
	}

	function PreviewRating(pRoot: HTMLElement, pRating: number): void {
	UpdateStars(pRoot, pRating);
	UpdateHint(pRoot, GetRatingLabel(pRating));
	}

	function RestoreAverageStars(pRoot: HTMLElement): void {
	if (IsStarLocked(pRoot)) return;

	const cInput = pRoot.querySelector<HTMLInputElement>("[data-rating-value-input='true']");
	const cRating = GetCurrentAverage(pRoot);

	if (cInput) cInput.value = "";

	UpdateStars(pRoot, 0);
	RenderAverageStars(pRoot, cRating);
	UpdateHint(pRoot, "لم يتم اختيار التقييم بعد");
	}

	function UpdateStars(pRoot: HTMLElement, pRating: number): void {
	const cStars = pRoot.querySelectorAll<HTMLButtonElement>("[data-star-value]");

	cStars.forEach(function UpdateStar(pStar): void {
	const cValue = GetStarValue(pStar);

	pStar.classList.toggle("IsActive", cValue <= pRating && pRating > 0);
	pStar.setAttribute("aria-pressed", cValue === pRating ? "true" : "false");
	});
	}

	function RenderAverageStars(pRoot: HTMLElement, pRating: number): void {
	const cStars = pRoot.querySelectorAll<HTMLButtonElement>("[data-star-value]");

	cStars.forEach(function RenderAverageStar(pStar): void {
	const cValue = GetStarValue(pStar);
	const cFill = Math.max(0, Math.min(100, (pRating - (cValue - 1)) * 100));

	pStar.style.setProperty("--star-fill", `${cFill}%`);
	});
	}

	function RenderLiveRating(pRoot: HTMLElement, pData: LiveRatingData): void {
	if (!pData?.ok || !pData.hasRating || !pData.ratingCount || !pData.ratingValue) {
	SetAverageUi(pRoot, 0, 0);
	if (!IsStarLocked(pRoot)) RestoreAverageStars(pRoot);
	return;
	}

	SetAverageUi(pRoot, Number(pData.ratingValue), Number(pData.ratingCount));

	if (!IsStarLocked(pRoot)) RestoreAverageStars(pRoot);
	}

	function SetAverageUi(pRoot: HTMLElement, pRatingValue: number, pRatingCount: number): void {
	const cAverageBox = pRoot.querySelector<HTMLElement>("[data-rating-average-box='true']");
	const cEmpty = pRoot.querySelector<HTMLElement>("[data-rating-empty='true']");
	const cAverage = pRoot.querySelector<HTMLElement>("[data-rating-average='true']");
	const cCount = pRoot.querySelector<HTMLElement>("[data-rating-count='true']");
	const cProgress = pRoot.querySelector<HTMLElement>("[data-rating-progress='true']");
	const cBestRating = Number(pRoot.dataset.bestRating || "5");
	const cHasRating = pRatingCount > 0 && pRatingValue > 0;
	const cSafeRating = cHasRating ? pRatingValue : 0;
	const cProgressValue = cBestRating ? Math.max(0, Math.min(100, (cSafeRating / cBestRating) * 100)) : 0;

	pRoot.dataset.currentAverage = String(cSafeRating);
	pRoot.dataset.currentCount = String(cHasRating ? pRatingCount : 0);

	cAverageBox?.classList.toggle("IsHidden", !cHasRating);
	cEmpty?.classList.toggle("IsHidden", cHasRating);

	if (cAverage) cAverage.textContent = cHasRating ? FormatDecimal(cSafeRating) : "";
	if (cCount) cCount.textContent = cHasRating ? `من ${FormatInteger(pRatingCount)} زائر` : "";
	if (cProgress) cProgress.style.setProperty("--rating-progress", `${cProgressValue}%`);

	RenderAverageStars(pRoot, cSafeRating);
	}

	function GetCurrentAverage(pRoot: HTMLElement): number {
	return Number(pRoot.dataset.currentAverage || pRoot.dataset.initialRatingValue || "0");
	}

	function UpdateHint(pRoot: HTMLElement, pText: string): void {
	const cHint = pRoot.querySelector<HTMLElement>("[data-rating-hint='true']");

	if (!cHint) return;

	cHint.textContent = pText;
	}

	function UpdateUserPill(pRoot: HTMLElement, pRating: number): void {
	const cPill = pRoot.querySelector<HTMLElement>("[data-user-rating-pill='true']");

	if (!cPill) return;

	cPill.hidden = false;
	cPill.textContent = `تقييمك لهذه الصفحة: ${FormatInteger(pRating)} من ٥`;
	}

	function IsStarLocked(pRoot: HTMLElement): boolean {
	return pRoot.dataset.starLocked === "true";
	}

	function GetStarValue(pStar: HTMLElement): number {
	return Number(pStar.dataset.starValue || "0");
	}

	function GetComment(pRoot: HTMLElement): string {
	const cComment = pRoot.querySelector<HTMLTextAreaElement>("[data-rating-comment='true']");

	return (cComment?.value || "").trim();
	}

	function GetRatingLabel(pRating: number): string {
	switch (pRating) {
	case 1:
	return "تقييم ضعيف - نجمة واحدة";
	case 2:
	return "تقييم مقبول - نجمتان";
	case 3:
	return "تقييم متوسط - ثلاث نجمات";
	case 4:
	return "تقييم جيد جدًا - أربع نجمات";
	case 5:
	return "تقييم ممتاز - خمس نجمات";
	default:
	return "لم يتم اختيار التقييم بعد";
	}
	}

	function ClearComment(pRoot: HTMLElement): void {
	const cComment = pRoot.querySelector<HTMLTextAreaElement>("[data-rating-comment='true']");

	if (cComment) cComment.value = "";
	}

	function SaveLocalStarRating(pRoot: HTMLElement, pRating: number): void {
	try {
	const cValue: LocalStarRating = {
	ratingValue: pRating,
	pagePath: NormalizePath(location.pathname),
	createdAt: new Date().toISOString()
	};

	localStorage.setItem(GetPageRatingStorageKey(pRoot), JSON.stringify(cValue));
	} catch (pError) {
	console.warn("Local star rating save warning:", pError);
	}
	}

	function ReadLocalStarRating(pRoot: HTMLElement): LocalStarRating | null {
	try {
	const cRawValue = localStorage.getItem(GetPageRatingStorageKey(pRoot));

	if (!cRawValue) return null;

	const cParsedValue = JSON.parse(cRawValue) as LocalStarRating;
	const cRating = Number(cParsedValue.ratingValue || 0);

	if (cRating < 1 || cRating > 5) return null;

	return {
	ratingValue: cRating,
	pagePath: cParsedValue.pagePath || NormalizePath(location.pathname),
	createdAt: cParsedValue.createdAt || ""
	};
	} catch {
	return null;
	}
	}

	function GetPageRatingStorageKey(pRoot: HTMLElement): string {
	return `EmoPageStarRating:${pRoot.dataset.sourceName || "Emostein"}:${NormalizePath(location.pathname)}`;
	}

	function GetVisitorKey(): string {
	const cStorageKey = "EmoRatingVisitorKey";

	try {
	const cExistingValue = localStorage.getItem(cStorageKey);

	if (cExistingValue) return cExistingValue;

	const cNewValue = crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2)}`;

	localStorage.setItem(cStorageKey, cNewValue);

	return cNewValue;
	} catch {
	return `NoStorage-${Date.now()}-${Math.random().toString(36).slice(2)}`;
	}
	}

	function GetEgyptTimeText(): string {
	return new Intl.DateTimeFormat("ar-EG", {
	timeZone: "Africa/Cairo",
	dateStyle: "medium",
	timeStyle: "short"
	}).format(new Date());
	}

	function FormatDecimal(pValue: number): string {
	return new Intl.NumberFormat("ar-EG", {
	minimumFractionDigits: 2,
	maximumFractionDigits: 2
	}).format(pValue || 0);
	}

	function FormatInteger(pValue: number): string {
	return new Intl.NumberFormat("ar-EG", {
	maximumFractionDigits: 0
	}).format(pValue || 0);
	}

	function NormalizePath(pValue: string): string {
	let cValue = pValue.trim();

	if (!cValue.startsWith("/")) {
	cValue = `/${cValue}`;
	}

	if (!cValue.endsWith("/")) {
	cValue = `${cValue}/`;
	}

	return cValue.toLowerCase();
	}

	function RefreshRatingFromSheet(pRoot: HTMLElement): Promise<void> {
	const cStorageUrl = pRoot.dataset.storageUrl || "";

	if (!cStorageUrl) return Promise.resolve();

	return LoadRatingJsonp(cStorageUrl, NormalizePath(location.pathname))
	.then(function HandleRatingData(pData): void {
	RenderLiveRating(pRoot, pData);
	})
	.catch(function HandleRatingError(pError): void {
	console.warn("Rating read warning:", pError);
	});
	}

	function LoadRatingJsonp(pStorageUrl: string, pPagePath: string): Promise<LiveRatingData> {
	return new Promise(function HandleJsonp(pResolve, pReject): void {
	const cCallbackName = `EmoRatingCallback_${Date.now()}_${Math.random().toString(36).slice(2)}`;
	const cUrl = new URL(pStorageUrl);
	const cScript = document.createElement("script");
	let cDone = false;

	cUrl.searchParams.set("mode", "page");
	cUrl.searchParams.set("page_path", pPagePath);
	cUrl.searchParams.set("callback", cCallbackName);

	(window as unknown as Record<string, unknown>)[cCallbackName] = function HandleRatingCallback(pData: LiveRatingData): void {
	cDone = true;
	Cleanup();
	pResolve(pData);
	};

	cScript.src = cUrl.href;
	cScript.async = true;

	cScript.addEventListener("error", function HandleError(): void {
	if (cDone) return;

	Cleanup();
	pReject(new Error("Rating JSONP loading failed."));
	});

	document.head.appendChild(cScript);

	function Cleanup(): void {
	delete (window as unknown as Record<string, unknown>)[cCallbackName];
	cScript.remove();
	}
	});
	}

	function SetSubmitBusy(pButton: HTMLButtonElement | null, pIsBusy: boolean): void {
	if (!pButton) return;

	pButton.disabled = pIsBusy;
	}

	function ShowStatus(pStatus: HTMLElement | null, pText: string, pClassName: "IsError" | "IsDone"): void {
	if (!pStatus) return;

	pStatus.hidden = false;
	pStatus.textContent = pText;
	pStatus.classList.remove("IsError", "IsDone");
	pStatus.classList.add(pClassName);
	}
</script>





<style>



