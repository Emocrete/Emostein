---
import { Align, ElemBg, GetHzAlignCss, GetVrAlignCss, type HzAlignValue, NumPer, Place, type PlaceProps, Size, type VrAlignValue } from "@/TypesLib";
import { Media } from "@/Media";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"div">, PlaceProps {
	pBg?: ElemBg;
	pSize?: Size;
	pMinH?: NumPer;
	pHzAlign?: HzAlignValue;
	pVrAlign?: VrAlignValue;
	pImgF?: string;
	pImgL?: string;
	pImgP?: string;
}

const {
	pBg,
	pMinH,
	pHzAlign,
	pVrAlign,
	pImgF = "",
	pImgL = "",
	pImgP = "",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = GetWidgetId("EmoStrip"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = GetStyleText(pGivenStyle);
const cIsHero = GetBoolAttr((Astro.props as Record<string, unknown>)["data-hero"]);
const cLoading: "eager" | "lazy" = cIsHero ? "eager" : "lazy";
const cFetchPriority: "high" | undefined = cIsHero ? "high" : undefined;
const cPagePath = Astro.url.pathname;
const cImgFolder = pImgF || Media.GetPageFolder(cPagePath);
const cUseAutoHeroImg = cIsHero || pImgF !== "";

const cBgImgL = pImgL
	? Media.GetPageFile(cPagePath, pImgL, { pFolder: cImgFolder })
	: cUseAutoHeroImg
		? Media.GetHeroLandscape(cPagePath, { pFolder: cImgFolder })
		: pBg?.Img?.LinkL || "";

const cBgImgP = pImgP
	? Media.GetPageFile(cPagePath, pImgP, { pFolder: cImgFolder })
	: pImgL
		? cBgImgL
		: cUseAutoHeroImg
			? Media.GetHeroPortrait(cPagePath, { pFolder: cImgFolder })
			: pBg?.Img?.LinkP || pBg?.Img?.LinkL || "";

const cFinalBgImgL = cBgImgL || cBgImgP;
const cFinalBgImgP = cBgImgP || cBgImgL;
const cHasBgImg = cFinalBgImgL !== "" || cFinalBgImgP !== "";
const cBgAlt = pBg?.Img?.Alt || "";

const cHzAlign = pHzAlign ?? Align.Center;
const cVrAlign = pVrAlign ?? Align.Center;
const cHasExplicitHeight = HasExplicitCssSize(pSize?.HeightL) || HasExplicitCssSize(pSize?.HeightP);

const cStripStyle = [
	`--StripBg:${pBg?.Color || "transparent"};`,
	`--StripWidthL:${pSize?.WidthL || "100%"};`,
	`--StripWidthP:${pSize?.WidthP || pSize?.WidthL || "100%"};`,
	`--StripHeightL:${pSize?.HeightL || "auto"};`,
	`--StripHeightP:${pSize?.HeightP || pSize?.HeightL || "auto"};`,
	`--StripMinHeightL:${pMinH?.Landscape || (cIsHero ? "100svh" : "auto")};`,
	`--StripMinHeightP:${pMinH?.Portrait || (cIsHero ? "100svh" : "auto")};`,
	`--StripAlignL:${GetHzAlignCss(cHzAlign, "Landscape")};`,
	`--StripAlignP:${GetHzAlignCss(cHzAlign, "Portrait")};`,
	`--StripJustifyL:${GetVrAlignCss(cVrAlign, "Landscape")};`,
	`--StripJustifyP:${GetVrAlignCss(cVrAlign, "Portrait")};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps);
const cFinalStyle = `${cStripStyle} ${cPlace.Style}`.trim();

function GetStyleText(pStyle: Props["style"]) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}

function GetBoolAttr(pValue: unknown) {
	return pValue === true || pValue === "" || pValue === "true";
}

function HasExplicitCssSize(pValue?: string) {
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	return cValue !== "" && cValue !== "auto" && cValue !== "fit-content" && cValue !== "max-content" && cValue !== "min-content";
}
---




















<div
	class = {`EmoStrip ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cFinalStyle}
	id={pGivenID}
	data-emo-auto-container="true"
	data-emo-explicit-height={cHasExplicitHeight ? "true" : "false"}
	data-emo-empty-height="200"
	{...RemAttr}
>

	{ cHasBgImg && (

		<picture class = " EmoStripBg " data-emo-container-bg="true">
		
			<source media="(orientation: portrait)" srcset={cFinalBgImgP} />
		
			<img
				class = " EmoStripBgImg "
				src={cFinalBgImgL}
				alt={cBgAlt}
				loading={cLoading}
				decoding="async"
				fetchpriority={cFetchPriority}
			/>
		
		</picture>
	) }

	<slot />

</div>




















<style>



	.EmoStrip {
		position: relative;
		isolation: isolate;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: var(--StripAlignL, center);
		align-content: var(--StripAlignL, center);
		justify-content: var(--StripJustifyL, center);
		width: var(--StripWidthL, 100%);
		height: var(--StripHeightL, auto);
		min-height: var(--StripMinHeightL, auto);
		max-width: 100%;
		overflow: hidden;
		background-color: var(--StripBg, transparent);
	}


	.EmoStripBg {
		position: absolute;
		inset: 0;
		z-index: -1;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}


	.EmoStripBgImg {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
		user-select: none;
	}



	.EmoStrip.IsPlaced {
		position: absolute;
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}



	@media (orientation: portrait) {
		.EmoStrip {
			align-items: var(--StripAlignP, var(--StripAlignL, center));
			align-content: var(--StripAlignP, var(--StripAlignL, center));
			justify-content: var(--StripJustifyP, var(--StripJustifyL, center));
			width: var(--StripWidthP, var(--StripWidthL, 100%));
			height: var(--StripHeightP, var(--StripHeightL, auto));
			min-height: var(--StripMinHeightP, var(--StripMinHeightL, auto));
		}

		.EmoStrip.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}
	}



</style>
