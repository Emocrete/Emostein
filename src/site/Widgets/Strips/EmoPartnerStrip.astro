		}

		.PartnerSubmit {
			width: 100%;
		}

		.PartnerStatus {
			text-align: center;
		}
	}



</style>




















<script>
	type PartnerFormData = {
	partner_name: string;
	partner_phone: string;
	partner_governorate: string;
	partner_type: string;
	partner_service: string;
	partner_capacity: string;
	partner_note: string;
	page_title: string;
	page_url: string;
	page_path: string;
	source_name: string;
	};

	if (!window.__EmoPartnerStripReady) {
	window.__EmoPartnerStripReady = true;
	document.addEventListener("astro:page-load", SetupPartnerStrips);
	window.addEventListener("load", SetupPartnerStrips);
	SetupPartnerStrips();
	}

	function SetupPartnerStrips(): void {
	const cStrips = document.querySelectorAll<HTMLElement>("[data-emo-partner-strip='true']:not([data-partner-ready='true'])");

	cStrips.forEach(SetupPartnerStrip);
	}

	function SetupPartnerStrip(pRoot: HTMLElement): void {
	pRoot.dataset.partnerReady = "true";

	const cForm = pRoot.querySelector<HTMLFormElement>("[data-partner-form='true']");

	cForm?.addEventListener("submit", function HandlePartnerSubmit(pEvent): void {
	pEvent.preventDefault();
	HandleSubmit(pRoot);
	});
	}

	function HandleSubmit(pRoot: HTMLElement): void {
	const cStatus = pRoot.querySelector<HTMLElement>("[data-partner-status='true']");
	const cData = GetPartnerFormData(pRoot);

	if (!cData.partner_name || !cData.partner_phone || !cData.partner_type || !cData.partner_service) {
	ShowStatus(cStatus, "اكتب الاسم ورقم الهاتف ونوع التعاون والخدمة المناسبة.", "IsError");
	return;
	}

	console.log("Partner application preview:", cData);

	ShowStatus(cStatus, "تم تجهيز نموذج التعاون مبدئيًا. الربط الفعلي بالإيميل والشيت يتم في الخطوة التالية.", "IsDone");
	}

	function GetPartnerFormData(pRoot: HTMLElement): PartnerFormData {
	return {
	partner_name: GetValue(pRoot, "[data-partner-name='true']"),
	partner_phone: GetValue(pRoot, "[data-partner-phone='true']"),
	partner_governorate: GetValue(pRoot, "[data-partner-governorate='true']"),
	partner_type: GetValue(pRoot, "[data-partner-type='true']"),
	partner_service: GetValue(pRoot, "[data-partner-service='true']"),
	partner_capacity: GetValue(pRoot, "[data-partner-capacity='true']"),
	partner_note: GetValue(pRoot, "[data-partner-note='true']"),
	page_title: document.title,
	page_url: location.href,
	page_path: NormalizePath(location.pathname),
	source_name: pRoot.dataset.sourceName || "موقع Emocrete"
	};
	}

	function GetValue(pRoot: HTMLElement, pSelector: string): string {
	const cField = pRoot.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(pSelector);

	return (cField?.value || "").trim();
	}

	function NormalizePath(pValue: string): string {
	let cValue = pValue.trim();

	if (!cValue.startsWith("/")) {
	cValue = `/${cValue}`;
	}

	if (!cValue.endsWith("/")) {
	cValue = `${cValue}/`;
	}

	return cValue.toLowerCase();
	}

	function ShowStatus(pStatus: HTMLElement | null, pText: string, pClassName: "IsDone" | "IsError"): void {
	if (!pStatus) return;

	pStatus.textContent = pText;
	pStatus.classList.remove("IsDone", "IsError");
	pStatus.classList.add(pClassName);
	}
</script>
