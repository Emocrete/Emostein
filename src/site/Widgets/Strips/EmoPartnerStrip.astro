					<svg>

						<use href="#PartnerIconTrend">

						</use>

					</svg>

				</span>

				<select name="partner_capacity" data-partner-capacity="true">

					<option value="">

						نطاق القدرة الحالية

					</option>

					<option value="أعمال فردية عند الطلب">

						أعمال فردية عند الطلب

