---
import type { HTMLAttributes } from "astro/types";
import { Place, type PlaceProps } from "@/TypesLib";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	pTitle?: string;
	pDesc?: string;
	pKicker?: string;
	pSubmitText?: string;
	pPrivacyText?: string;
	pSourceName?: string;
	pTitleTag?: "h1" | "h2";
}

const {
	pTitle = "انضم إلى شبكة المتعاونين مع Emocrete",
	pDesc = "لو كنت مهندسًا، استشاريًا، مقاولًا، صنايعيًا، موردًا، أو مندوب خدمات في محافظة مختلفة، اترك بياناتك ومجال تعاونك لفرز الطلبات والتواصل مع المناسبين عند الحاجة.",
	pKicker = "توسيع شبكة التنفيذ",
	pSubmitText = "إرسال بيانات التعاون",
	pPrivacyText = "هذه البيانات مخصصة لدراسة فرص التعاون فقط، وليست طلب توظيف ملزم أو تعاقد مباشر.",
	pSourceName = "موقع Emocrete",
	pTitleTag = "h2",
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = GetWidgetId("EmoPartnerStrip"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";

const cPlace = new Place(Astro.props as PlaceProps, cGivenStyle);
---




















<section
	class = {`EmoPartnerStrip ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	data-emo-partner-strip="true"
	data-source-name={pSourceName}
	{...RemAttr}
>







	<svg class = " SvgDefs " aria-hidden="true">

		<symbol id="PartnerIconNetwork" viewBox="0 0 24 24">

