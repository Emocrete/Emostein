			justify-items: center;
			text-align: center;
		}

		.PartnerIntro p {
			text-align: center;
		}
	}


	@media (orientation: portrait) {
		.PartnerShell {
			width: min(430px, calc(100% - 22px));
			padding-block: 24px;
			gap: 18px;
		}

		.PartnerIntro .PartnerTitle {
			font-size: 24px;
			text-align: center;
		}

		.PartnerIntro p {
			font-size: 14px;
			line-height: 1.8;
		}

		.PartnerSignals {
			justify-content: center;
		}

		.PartnerForm {
			grid-template-columns: 1fr;
			gap: 9px;
