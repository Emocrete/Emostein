</section>




















<style>



	.EmoPartnerStrip {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		width: 100%;
		box-sizing: border-box;
		direction: rtl;
		background: radial-gradient(circle at 8% 25%, rgba(255, 209, 92, 0.14), transparent 24%),
			radial-gradient(circle at 94% 45%, rgba(38, 181, 255, 0.16), transparent 25%),
			linear-gradient(135deg, #071426 0%, #081c34 52%, #06101e 100%);
		color: #f8fbff;
		border-block: 1px solid rgba(125, 190, 255, 0.18);
	}

	.EmoPartnerStrip::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
			linear-gradient(0deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
		background-size: 38px 38px;
		opacity: 0.25;
		pointer-events: none;
	}


	.SvgDefs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}


	.PartnerShell {
		display: grid;
		grid-template-columns: minmax(320px, 0.78fr) minmax(620px, 1.22fr);
		align-items: center;
		gap: 24px;
		width: min(1500px, calc(100% - 30px));
		margin-inline: auto;
		padding-block: 28px;
		box-sizing: border-box;
	}


	.PartnerIntro {
		display: grid;
		gap: 12px;
		min-width: 0;
	}

	.PartnerIntro .PartnerTitle {
		margin: 0;
		color: #ffffff;
		font-size: 30px;
		font-weight: 950;
		line-height: 1.35;
		letter-spacing: -0.3px;
	}

	.PartnerIntro p {
		margin: 0;
		max-width: 620px;
		color: rgba(248, 251, 255, 0.74);
		font-size: 15px;
		font-weight: 700;
		line-height: 1.9;
	}


	.PartnerKicker {
		display: inline-flex;
		width: fit-content;
		padding: 6px 13px;
		border: 1px solid rgba(255, 209, 92, 0.36);
		border-radius: 999px;
		background: rgba(255, 209, 92, 0.10);
		color: #ffd15c;
		font-size: 13px;
		font-weight: 950;
		line-height: 1.2;
	}


	.PartnerSignals {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.PartnerSignals span {
		display: inline-flex;
		padding: 6px 10px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: rgba(248, 251, 255, 0.76);
		font-size: 12px;
		font-weight: 850;
	}


	.PartnerForm {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		padding: 14px;
		border: 1px solid rgba(125, 190, 255, 0.22);
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.06);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10),
			0 16px 36px rgba(0, 0, 0, 0.22);
		backdrop-filter: blur(13px);
		-webkit-backdrop-filter: blur(13px);
		box-sizing: border-box;
	}

	.PartnerForm textarea {
		grid-column: span 3;
		min-height: 82px;
		resize: vertical;
		padding: 11px 12px;
		border: 1px solid rgba(255, 255, 255, 0.10);
		border-radius: 16px;
		background: rgba(2, 12, 28, 0.36);
		box-sizing: border-box;
		line-height: 1.75;
	}


	.FieldBox {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 7px;
		min-height: 44px;
		padding: 0 10px;
		border: 1px solid rgba(255, 255, 255, 0.10);
		border-radius: 14px;
		background: rgba(2, 12, 28, 0.36);
		box-sizing: border-box;
	}

	.FieldBox select {
		cursor: pointer;
	}

	.FieldBox option {
		color: #071426;
		background: #ffffff;
	}


	.WideField {
		grid-column: span 1;
	}


	.FieldIcon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 25px;
		height: 25px;
		border-radius: 9px;
		background: rgba(125, 211, 255, 0.11);
		color: #7dd3ff;
	}


	.PartnerSubmit {
		grid-column: span 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 42px;
		padding-inline: 16px;
		border: 0;
		border-radius: 14px;
		background: linear-gradient(135deg, #ffd15c, #ff9f1f);
		color: #101827;
		font-family: inherit;
		font-size: 13px;
		font-weight: 950;
		cursor: pointer;
		box-shadow: 0 12px 26px rgba(255, 169, 31, 0.18),
			inset 0 1px 0 rgba(255, 255, 255, 0.34);
		transition: transform 0.12s ease, filter 0.12s ease;
	}


	.PartnerStatus {
		grid-column: span 2;
		align-self: center;
		color: rgba(248, 251, 255, 0.62);
		font-size: 12px;
		font-weight: 750;
		line-height: 1.6;
	}



	.PartnerStatus.IsDone {
		color: #42ff9f;
	}


	.PartnerStatus.IsError {
		color: #ffd15c;
	}



	.FieldIcon svg,
	.PartnerSubmit svg
	{
		width: 16px;
		height: 16px;
		fill: currentColor;
	}


	.FieldBox input,
	.FieldBox select,
	.PartnerForm textarea
	{
		width: 100%;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: #ffffff;
		font-family: inherit;
		font-size: 13px;
		font-weight: 750;
		line-height: 1.4;
		direction: rtl;
	}


	.FieldBox input::placeholder,
	.PartnerForm textarea::placeholder
	{
		color: rgba(248, 251, 255, 0.52);
	}



</style>




















<style>



