---
import type { HTMLAttributes } from "astro/types";
import { NumPer, Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"div">, PlaceProps {
	pHeight?: NumPer;
	pFill?: string;
	pFill2?: string;
	pStroke?: string;
	pStrokeWidth?: number;
}

const {
	pHeight = new NumPer(150, 110),
	pFill = "#A7C45C",
	pFill2 = "rgba(255,255,255,.38)",
	pStroke = "rgba(255,255,255,.55)",
	pStrokeWidth = 0,

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,

	id: pGivenID = GetWidgetId("DiagonalTop"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cStyle = [
	`--ShapeHeightL:${pHeight.Landscape};`,
	`--ShapeHeightP:${pHeight.Portrait};`,
	`--ShapePointer:${pClickable === true ? "auto" : "none"};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps, cStyle);
---

<div
	class={`DiagonalTop EmoShapeEdge ${cPlace.Class} ${pGivenClass}`.trim()}
	style={cPlace.Style}
	id={pGivenID}
	aria-hidden="true"
	{...RemAttr}
>
	<svg viewBox="0 0 1200 160" preserveAspectRatio="none" focusable="false">
		<path fill={pFill2} d="M0,0 L1200,0 L1200,70 L0,120 Z" />
		<path fill={pFill} stroke={pStroke} stroke-width={pStrokeWidth} d="M0,0 L1200,0 L1200,55 L0,100 Z" />
	</svg>
</div>

<style>
	.EmoShapeEdge {
		position: relative;
		display: block;
		width: 100%;
		height: var(--ShapeHeightL);
		overflow: hidden;
		line-height: 0;
		pointer-events: var(--ShapePointer, none);
		box-sizing: border-box;
	}

	.EmoShapeEdge.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--ShapePointer, none);
		min-width: 0;
		box-sizing: border-box;
	}

	@media (orientation: portrait) {
		.EmoShapeEdge.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}
	}

	.EmoShapeEdge svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (orientation: portrait) {
		.EmoShapeEdge {
			height: var(--ShapeHeightP, var(--ShapeHeightL));
		}
	}
</style>
