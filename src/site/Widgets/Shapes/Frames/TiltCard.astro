---
import { GetHzAlignCss, GetVrAlignCss, type HzAlignValue, Place, type PlaceProps, type VrAlignValue } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
interface Props extends DebugOutlineProps, HTMLAttributes<"article">, PlaceProps { pBg?: string; pColor?: string; pTilt?: number; pHzAlign?: HzAlignValue; pVrAlign?: VrAlignValue; }
const { pBg = "#353535", pColor = "#FAFAFA", pTilt = -3, pHzAlign = "Stretch", pVrAlign = "Center", pLoc, pSize, pRotate, pZ, pOrigin, pOpacity, pClickable, pLandOnly, pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
 id: pGivenID = GetWidgetId("TiltCard"), class: pGivenClass = "", style: pGivenStyle = "", ...RemAttr } = Astro.props as Props;
const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cHasExplicitHeight = HasExplicitCssSize(pSize?.HeightL) || HasExplicitCssSize(pSize?.HeightP);
const cPlace = new Place(Astro.props as PlaceProps, `--TiltBg:${pBg}; --TiltColor:${pColor}; --TiltDeg:${pTilt}deg; --TiltHzAlign:${GetHzAlignCss(pHzAlign)}; --TiltVrAlign:${GetVrAlignCss(pVrAlign)}; ${cGivenStyle}`);

function HasExplicitCssSize(pValue?: string) {
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	return cValue !== "" && cValue !== "auto" && cValue !== "fit-content" && cValue !== "max-content" && cValue !== "min-content";
}
---
<article class={`TiltCard ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} data-emo-auto-container="true" data-emo-explicit-height={cHasExplicitHeight ? "true" : "false"} data-emo-empty-height="200" {...RemAttr}><slot /></article>
<style>
	.TiltCard { position: relative; display: flex; flex-direction: column; align-items: var(--TiltHzAlign, stretch); justify-content: var(--TiltVrAlign, center); width: 100%; height: auto; padding: clamp(18px, 2.6vw, 34px); border-radius: 26px; background: var(--TiltBg); color: var(--TiltColor); box-shadow: 0 28px 50px rgba(0,0,0,.22); transform: rotate(var(--TiltDeg)); box-sizing: border-box; }
	.TiltCard::before { content: ""; position: absolute; inset: 10px; border: 1px solid rgba(255,255,255,.24); border-radius: 20px; pointer-events: none; }
.TiltCard.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, var(--TiltDeg)));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--PlaceClickable, auto);
		min-width: 0;
		box-sizing: border-box;
	}

	@media (orientation: portrait) {
		.TiltCard.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, var(--TiltDeg))));
		}
	}
</style>
