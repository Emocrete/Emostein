---
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
interface Props extends DebugOutlineProps, HTMLAttributes<"figure">, PlaceProps { pSrc?: string; pAlt?: string; pBorder?: string; pCaption?: string; }
const { pSrc = "/Media/TrustedIcon.webp", pAlt = "", pBorder = "#A7C45C", pCaption = "", pLoc, pSize, pRotate, pZ, pOrigin, pOpacity, pClickable, pLandOnly, pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
 id: pGivenID = GetWidgetId("ImageCircle"), class: pGivenClass = "", style: pGivenStyle = "", ...RemAttr } = Astro.props as Props;
const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cPlace = new Place(Astro.props as PlaceProps, `--CircleBorder:${pBorder}; ${cGivenStyle}`);
---
<figure class={`ImageCircle ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} {...RemAttr}>
	<img src={pSrc} alt={pAlt} loading="lazy" decoding="async" />
	{(Astro.slots.has("default") || pCaption) && <figcaption>{Astro.slots.has("default") ? <slot /> : pCaption}</figcaption>}
</figure>
<style>
	.ImageCircle { position: relative; display: grid; place-items: center; width: 100%; height: auto; margin: 0; box-sizing: border-box; }
	.ImageCircle img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; border: 8px solid var(--CircleBorder); border-radius: 999px; box-shadow: 0 24px 48px rgba(0,0,0,.22); box-sizing: border-box; }
	.ImageCircle figcaption { position: absolute; inset-inline: 10%; bottom: -16px; padding: 8px 12px; border-radius: 999px; background: rgba(17,17,17,.82); color: #fafafa; font-size: 14px; line-height: 1.7; text-align: center; }
.ImageCircle.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--PlaceClickable, auto);
		min-width: 0;
		box-sizing: border-box;
	}

	@media (orientation: portrait) {
		.ImageCircle.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}
	}
</style>
