---
import { GetHzAlignCss, GetVrAlignCss, type HzAlignValue, Place, type PlaceProps, type VrAlignValue } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
interface Props extends DebugOutlineProps, HTMLAttributes<"article">, PlaceProps { pBadge?: string; pBg?: string; pBadgeBg?: string; pColor?: string; pHzAlign?: HzAlignValue; pVrAlign?: VrAlignValue; }
const { pBadge = "NEW", pBg = "#FAFAFA", pBadgeBg = "#A7C45C", pColor = "#111111", pHzAlign = "Stretch", pVrAlign = "Center", pLoc, pSize, pRotate, pZ, pOrigin, pOpacity, pClickable, pLandOnly, pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
 id: pGivenID = GetWidgetId("BadgeFrame"), class: pGivenClass = "", style: pGivenStyle = "", ...RemAttr } = Astro.props as Props;
const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cHasExplicitHeight = HasExplicitCssSize(pSize?.HeightL) || HasExplicitCssSize(pSize?.HeightP);
const cPlace = new Place(Astro.props as PlaceProps, `--BadgeFrameBg:${pBg}; --BadgeFrameColor:${pColor}; --BadgeBg:${pBadgeBg}; --BadgeFrameHzAlign:${GetHzAlignCss(pHzAlign)}; --BadgeFrameVrAlign:${GetVrAlignCss(pVrAlign)}; ${cGivenStyle}`);

function HasExplicitCssSize(pValue?: string) {
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	return cValue !== "" && cValue !== "auto" && cValue !== "fit-content" && cValue !== "max-content" && cValue !== "min-content";
}
---




















<article
	class = {`BadgeFrame ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	data-emo-auto-container="true"
	data-emo-explicit-height={cHasExplicitHeight ? "true" : "false"}
	data-emo-empty-height="200"
	{...RemAttr}
>







	<span class = " BadgeText ">
		{pBadge}
	</span>







	<slot />







</article>




















<style>



	.BadgeFrame {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: var(--BadgeFrameHzAlign, stretch);
		justify-content: var(--BadgeFrameVrAlign, center);
		width: 100%;
		height: auto;
		padding: clamp(22px, 3vw, 40px);
		padding-top: clamp(34px, 4vw, 54px);
		border-radius: 26px;
		background: var(--BadgeFrameBg);
		color: var(--BadgeFrameColor);
		box-shadow: 0 22px 50px rgba(0,0,0,.16);
		box-sizing: border-box;
	}


	.BadgeText {
		position: absolute;
		top: 0;
		inset-inline-start: clamp(20px, 3vw, 42px);
		translate: 0 -50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 86px;
		padding: 8px 18px;
		border-radius: 999px;
		background: var(--BadgeBg);
		font-weight: 900;
		box-shadow: 0 12px 24px rgba(0,0,0,.18);
	}



	.BadgeFrame.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--PlaceClickable, auto);
		min-width: 0;
		box-sizing: border-box;
	}



</style>




















<style>



	@media (orientation: portrait) {
		.BadgeFrame.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}
	}



</style>
