---
import type { HTMLAttributes } from "astro/types";
import { Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"aside">, PlaceProps { pBg?: string; pBorder?: string; pAccent?: string; }
const { pBg = "rgba(17,24,32,.88)", pBorder = "rgba(255,255,255,.18)", pAccent = "#fbff00", pLoc, pSize, pRotate, pZ, pOrigin, pOpacity, pClickable, pLandOnly, pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
 id: pGivenID = GetWidgetId("FloatingPanel"), class: pGivenClass = "", style: pGivenStyle = "", ...RemAttr } = Astro.props as Props;
const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cPlace = new Place(Astro.props as PlaceProps, `--PanelBg:${pBg}; --PanelBorder:${pBorder}; --PanelAccent:${pAccent}; ${cGivenStyle}`);
---
<aside class={`FloatingPanel ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} {...RemAttr}><slot /></aside>
<style>
	.FloatingPanel { position: relative; display: flex; flex-direction: column; justify-content: center; width: 100%; height: auto; padding: clamp(22px, 3vw, 42px); border: 1px solid var(--PanelBorder); border-inline-start: 8px solid var(--PanelAccent); border-radius: 28px; background: var(--PanelBg); color: #FAFAFA; box-shadow: 0 30px 70px rgba(0,0,0,.28); backdrop-filter: blur(10px); box-sizing: border-box; }
	.FloatingPanel::after { content: ""; position: absolute; inset-inline-end: 22px; inset-block-start: 22px; width: 48px; height: 48px; border-radius: 50%; background: radial-gradient(circle, var(--PanelAccent), transparent 70%); opacity: .6; pointer-events: none; }
.FloatingPanel.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--PlaceClickable, auto);
		min-width: 0;
		box-sizing: border-box;
	}

	@media (orientation: portrait) {
		.FloatingPanel.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}
	}
</style>
