---
import type { HTMLAttributes } from "astro/types";
import { Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"div">, PlaceProps { pStroke?: string; pDot?: string; pWidth?: number; pAnimate?: boolean; }

const { pStroke = "rgba(255,255,255,.72)", pDot = "#FAFAFA", pWidth = 3, pAnimate = true, pLoc, pSize, pRotate, pZ, pOrigin, pOpacity, pClickable, pLandOnly, pPortOnly, id: pGivenID = GetWidgetId("LinePath"), class: pGivenClass = "", style: pGivenStyle = "", ...RemAttr } = Astro.props as Props;
const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cAnimateClass = pAnimate ? "IsAnimated" : "";
const cPlace = new Place(Astro.props as PlaceProps, `--ShapePointer:${pClickable === true ? "auto" : "none"}; ${cGivenStyle}`);
---

<div class={`LinePath ${cAnimateClass} ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} aria-hidden="true" {...RemAttr}>
	<svg viewBox="0 0 1000 170" preserveAspectRatio="none" focusable="false">
		<path class="MainLine" d="M0,105 C125,35 210,145 330,92 C475,28 595,148 720,90 C835,37 910,62 1000,28" fill="none" stroke={pStroke} stroke-width={pWidth} stroke-linecap="round" />
		<g fill={pDot}>
			<circle cx="178" cy="80" r="8" /><circle cx="330" cy="92" r="8" /><circle cx="565" cy="112" r="8" /><circle cx="720" cy="90" r="8" /><circle cx="906" cy="62" r="8" />
		</g>
	</svg>
</div>

<style>
	.LinePath { position: relative; display: block; width: 100%; height: 100%; pointer-events: var(--ShapePointer, none); box-sizing: border-box; }
	.LinePath svg { display: block; width: 100%; height: 100%; overflow: visible; }
	.LinePath.IsAnimated .MainLine { stroke-dasharray: 18 18; animation: EmoLineDash 16s linear infinite; }
	@keyframes EmoLineDash { to { stroke-dashoffset: -360; } }
.LinePath.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--ShapePointer, none);
		min-width: 0;
		box-sizing: border-box;
	}

	@media (orientation: portrait) {
		.LinePath.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}
	}
</style>
