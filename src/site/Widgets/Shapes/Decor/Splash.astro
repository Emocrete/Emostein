---
import type { HTMLAttributes } from "astro/types";
import { Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"div">, PlaceProps , DebugOutlineProps {
	pFill?: string;
	pFill2?: string;
}

const {
	pFill = "#A7C45C",
	pFill2 = "rgba(251,255,0,.52)",
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("Splash"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cPlace = new Place(Astro.props as PlaceProps, `--ShapePointer:${pClickable === true ? "auto" : "none"}; ${cGivenStyle}`);
---

<div class={`Splash EmoDecorShape ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} aria-hidden="true" {...RemAttr}>
	<svg viewBox="0 0 520 280" preserveAspectRatio="xMidYMid meet" focusable="false">
		<path fill={pFill} d="M50,165 C116,40 205,93 250,70 C330,28 385,42 414,84 C458,146 390,183 423,224 C354,222 314,200 258,235 C178,285 136,218 84,238 C102,203 18,216 50,165 Z" />
		<path fill={pFill2} d="M145,137 C190,82 255,92 290,112 C333,137 342,187 305,212 C245,253 166,213 145,137 Z" />
		<circle cx="434" cy="56" r="17" fill={pFill2} />
		<circle cx="470" cy="104" r="9" fill={pFill} />
		<circle cx="72" cy="78" r="13" fill={pFill2} />
		<circle cx="105" cy="34" r="7" fill={pFill} />
	</svg>
</div>

<style>
	.EmoDecorShape { position: relative; display: block; width: 100%; height: 100%; pointer-events: var(--ShapePointer, none); box-sizing: border-box; }
	.EmoDecorShape svg { display: block; width: 100%; height: 100%; overflow: visible; }
.EmoDecorShape.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--ShapePointer, none);
		min-width: 0;
		box-sizing: border-box;
	}

	@media (orientation: portrait) {
		.EmoDecorShape.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}
	}
</style>
