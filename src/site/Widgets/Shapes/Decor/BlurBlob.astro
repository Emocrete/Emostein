---
import type { HTMLAttributes } from "astro/types";
import { Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"div">, PlaceProps { pColor?: string; pColor2?: string; pBlur?: number; }

const { pColor = "rgba(50,143,232,.45)", pColor2 = "rgba(167,196,92,.4)", pBlur = 18, pLoc, pSize, pRotate, pZ, pOrigin, pOpacity, pClickable, pLandOnly, pPortOnly, id: pGivenID = GetWidgetId("BlurBlob"), class: pGivenClass = "", style: pGivenStyle = "", ...RemAttr } = Astro.props as Props;
const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cPlace = new Place(Astro.props as PlaceProps, `--BlobColor:${pColor}; --BlobColor2:${pColor2}; --BlobBlur:${pBlur}px; --ShapePointer:${pClickable === true ? "auto" : "none"}; ${cGivenStyle}`);
---

<div class={`BlurBlob ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} aria-hidden="true" {...RemAttr}></div>

<style>
	.BlurBlob { position: relative; display: block; width: 100%; height: 100%; border-radius: 48% 52% 63% 37% / 42% 38% 62% 58%; background: linear-gradient(135deg, var(--BlobColor), var(--BlobColor2)); filter: blur(var(--BlobBlur)); pointer-events: var(--ShapePointer, none); box-sizing: border-box; }
.BlurBlob.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--ShapePointer, none);
		min-width: 0;
		box-sizing: border-box;
	}

	@media (orientation: portrait) {
		.BlurBlob.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%));
			transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg)));
		}
	}
</style>
