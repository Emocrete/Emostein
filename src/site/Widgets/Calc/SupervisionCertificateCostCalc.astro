---
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	/** أتعاب الخدمة المباشرة عند اختيار القاهرة. */
	pCairoFee: number;

	/** أتعاب الخدمة المباشرة عند اختيار الجيزة. */
	pGizaFee: number;

	/** أتعاب الخدمة للمبنى التجاري أو الإداري أو الصناعي عند اختيار القاهرة. */
	pCairoNonResidentialFee: number;

	/** أتعاب الخدمة للمبنى التجاري أو الإداري أو الصناعي عند اختيار الجيزة. */
	pGizaNonResidentialFee: number;

	/** أتعاب عقد المقاولة عند الحاجة إليه. */
	pContractFee: number;
}

const cProps = Astro.props as Props & Record<string, unknown>;

const {
	pCairoFee,
	pGizaFee,
	pCairoNonResidentialFee,
	pGizaNonResidentialFee,
	pContractFee,

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("SupervisionCertificateCostCalc"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

const cStyle = [
	"--CertificateAccent:#1687b8;",
	"--CertificateAccentSoft:#e8f6fb;",
	"--CertificateAccentDark:#0d5d7e;",
	GetStyleText(pGivenStyle),
].filter(Boolean).join(" ");

const cPlace = new Place(cProps as PlaceProps, cStyle);
const cBuildingFee = 900;
const cStampRate = 0.0045;

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---





<section
	class = {`CertificateCostCalc SupervisionCertificateCostCalc ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	dir="rtl"
	data-supervision-certificate-cost="true"
	data-cairo-fee={pCairoFee}
	data-giza-fee={pGizaFee}
	data-cairo-non-residential-fee={pCairoNonResidentialFee}
	data-giza-non-residential-fee={pGizaNonResidentialFee}
	data-contract-fee={pContractFee}
	data-building-fee={cBuildingFee}
	data-stamp-rate={cStampRate}
	{...RemAttr}
>







	<header class = " CertificateHead ">

		<div class = " CertificateHeadText ">

			<p class = " CertificateEyebrow ">
				حاسبة تكلفة تقريبية
			</p>

			<h2>
				تكلفة شهادة الإشراف الهندسي
			</h2>

			<p>
				احسب أتعاب الخدمة ورسوم النقابة والدمغة الهندسية المتبقية حسب بيانات رخصة البناء.
			</p>

		</div>

		<div class = " CertificateRateBadge " aria-label="نسبة الدمغة الهندسية 0.45 بالمائة">

			<strong>
				0.45%
			</strong>

			<span>
				دمغة هندسية من تكلفة الرخصة
			</span>

		</div>

	</header>







	<div class = " CertificateBody ">

		<form class = " CertificateInputs " data-area="inputs">

			<fieldset class = " CertificateLocation ">

				<legend>

					موقع المبنى

				</legend>

				<div class = " CertificateLocationButtons ">

					<label class = " CertificateLocationButton ">

						<input
							data-field="location"
							type="radio"
							name={`${pGivenID}-location`}
							value="cairo"
							checked
						/>

						<span>
							القاهرة
						</span>

					</label>

					<label class = " CertificateLocationButton ">

						<input
							data-field="location"
							type="radio"
							name={`${pGivenID}-location`}
							value="giza"
						/>

						<span>
							الجيزة
						</span>

					</label>

				</div>

			</fieldset>

			<fieldset class = " CertificateLocation ">

				<legend>

					نوع المبنى

				</legend>

				<div class = " CertificateLocationButtons ">

					<label class = " CertificateLocationButton ">

						<input
							data-field="buildingType"
							type="radio"
							name={`${pGivenID}-building-type`}
							value="residential"
							checked
						/>

						<span>
							سكني
						</span>

					</label>

					<label class = " CertificateLocationButton ">

						<input
							data-field="buildingType"
							type="radio"
							name={`${pGivenID}-building-type`}
							value="nonResidential"
						/>

						<span>
							تجاري أو إداري أو صناعي
						</span>

					</label>

				</div>

			</fieldset>

			<fieldset class = " CertificateBuildingExtras ">

				<legend>

					المنشآت الإضافية المذكورة في رخصة البناء

				</legend>

				<p class = " CertificateBuildingBase ">
					أصل المبنى محسوب تلقائيًا كمبنى واحد.
				</p>

				<div class = " CertificateBuildingExtraOptions ">

					<label class = " CertificateBuildingExtraOption ">

						<input
							data-field="buildingExtra"
							type="checkbox"
							value="wall"
						/>

						<span>
							سور
						</span>

					</label>

					<label class = " CertificateBuildingExtraOption ">

						<input
							data-field="buildingExtra"
							type="checkbox"
							value="electricRoom"
						/>

						<span>
							غرفة كهرباء
						</span>

					</label>

					<label class = " CertificateBuildingExtraOption ">

						<input
							data-field="buildingExtra"
							type="checkbox"
							value="securityRoom"
						/>

						<span>
							غرفة أمن
						</span>

					</label>

					<label class = " CertificateBuildingExtraOption ">

						<input
							data-field="buildingExtra"
							type="checkbox"
							value="elevator"
						/>

						<span>
							يوجد مصعد
						</span>

					</label>

				</div>

				<small>

					كل بند محدد يضاف كمبنى مستقل عند حساب الرسوم الأساسية للنقابة بقيمة

					{cBuildingFee.toLocaleString("ar-EG")} جنيه.

				</small>

			</fieldset>

			<label class = " CertificateField ">

				<span>
					تكلفة الأعمال المسجلة في رخصة البناء
				</span>

				<div class = " CertificateInputUnit ">

					<input
						data-field="licenseCost"
						type="number"
						min="0"
						step="1000"
						value="0"
						inputmode="decimal"
					/>

					<b>

						جنيه

					</b>

				</div>

				<small>

					تستخدم هذه القيمة في حساب الدمغة فقط، وليست القيمة السوقية للعقار.

				</small>

			</label>

			<div class = " CertificateField ">

				<span>
					دمغة هندسية سبق سدادها
				</span>

				<div class = " CertificatePaidStampRow ">

					<label class = " CertificatePaidStampFull ">

						<input
							data-field="paidStampFull"
							type="checkbox"
						/>

						<span>
							تم سدادها بالكامل
						</span>

					</label>

					<div class = " CertificateInputUnit ">

						<input
							data-field="paidStamp"
							type="number"
							min="0"
							step="100"
							value="0"
							inputmode="decimal"
						/>

						<b>

							جنيه

						</b>

					</div>

				</div>

				<small>

					اكتب صفر إذا لم يسبق سداد دمغة مثبتة بالرخصة أو بإيصال مستقل.

				</small>

			</div>

			<label class = " CertificateContractOption ">

				<input
					data-field="contractRequired"
					type="checkbox"
				/>

				<span>
					يحتاج عقد مقاولة
				</span>

			</label>

		</form>

		<div class = " CertificateResult " aria-live="polite">

			<p class = " CertificateResultLabel ">
				الإجمالي التقريبي المطلوب
			</p>

			<p class = " CertificateTotal ">

				<strong data-out="total">
					0
				</strong>

				<span>
					جنيه
				</span>

			</p>

			<div class = " CertificateBreakdown ">

				<div class = " CertificateRow ">

					<span>

						أتعاب الخدمة —

						<b data-out="locationName">

							القاهرة

						</b>

					</span>

					<strong data-out="serviceFee">
						0
					</strong>

				</div>

				<div
					class = " CertificateRow ContractFee "
					data-row="contractFee"
					hidden
				>

					<span>
						عقد المقاولة
					</span>

					<strong data-out="contractFee">
						0
					</strong>

				</div>

				<div class = " CertificateRow ">

					<span>
						الرسوم الأساسية للنقابة
					</span>

					<strong data-out="basicFee">
						0
					</strong>

				</div>

				<div class = " CertificateRow ">

					<span>
						الدمغة الهندسية المحسوبة
					</span>

					<strong data-out="grossStamp">
						0
					</strong>

				</div>

				<div class = " CertificateRow Muted ">

					<span>
						المسدد سابقًا من الدمغة
					</span>

					<strong data-out="paidStamp">
						0
					</strong>

				</div>

				<div class = " CertificateRow StampDue ">

					<span>
						الدمغة المتبقية
					</span>

					<strong data-out="stampDue">
						0
					</strong>

				</div>

			</div>

			<p class = " CertificateStatus " data-out="status">
				الحسبة تشمل كامل الدمغة المستحقة وفق البيانات المدخلة.
			</p>

		</div>

	</div>







	<div class = " CertificateFormula ">

		<span>
			الإجمالي
		</span>

		<b>

			=

		</b>

		<span>
			أتعاب الخدمة
		</span>

		<span data-formula="contractFee" hidden>
			+ عقد المقاولة
		</span>

		<b>

			+

		</b>

		<span>

			{cBuildingFee} × عدد المباني

		</span>

		<b>

			+

		</b>

		<span>
			الدمغة المتبقية
		</span>

	</div>







	<p class = " CertificateDisclaimer ">
		الناتج تقديري طبقًا لطريقة الحساب الموضحة بالصفحة. القيمة النهائية تعتمد على المستندات المثبتة بالرخصة وما سبق سداده فعليًا.
	</p>







	<script is:inline NoMove>



		(() =>
		{

			// ==================== Definitions: Variables & Methods ====================





			function fInitCertificateCostCalc()
			{
				const fRoot = document.currentScript?.closest("[data-supervision-certificate-cost]");
				if (!fRoot) return;
				const fForm = fRoot.querySelector('[data-area="inputs"]');
				const fBuildingExtras = [...fRoot.querySelectorAll('[data-field="buildingExtra"]')];
				const fLicenseCost = fRoot.querySelector('[data-field="licenseCost"]');
				const fPaidStamp = fRoot.querySelector('[data-field="paidStamp"]');
				const fPaidStampFull = fRoot.querySelector('[data-field="paidStampFull"]');
				const fContractRequired = fRoot.querySelector('[data-field="contractRequired"]');
				const fContractRow = fRoot.querySelector('[data-row="contractFee"]');
				const fContractFormula = fRoot.querySelector('[data-formula="contractFee"]');
				const fLocations = [...fRoot.querySelectorAll('[data-field="location"]')];
				const fBuildingTypes = [...fRoot.querySelectorAll('[data-field="buildingType"]')];
				const fOut = (pName) => fRoot.querySelector(`[data-out="${pName}"]`);
				const fCairoFee = fNumber(fRoot.dataset.cairoFee);
				const fGizaFee = fNumber(fRoot.dataset.gizaFee);
				const fCairoNonResidentialFee = fNumber(fRoot.dataset.cairoNonResidentialFee);
				const fGizaNonResidentialFee = fNumber(fRoot.dataset.gizaNonResidentialFee);
				const fContractFee = fNumber(fRoot.dataset.contractFee);
				const fBuildingFee = fNumber(fRoot.dataset.buildingFee, 900);
				const fStampRate = fNumber(fRoot.dataset.stampRate, 0.0045);
				function fArabicToEnglishDigits(pValue)
				{
					return String(pValue ?? "")
					.replace(/[٠-٩]/g, (pDigit) => String("٠١٢٣٤٥٦٧٨٩".indexOf(pDigit)))
					.replace(/[۰-۹]/g, (pDigit) => String("۰۱۲۳۴۵۶۷۸۹".indexOf(pDigit)))
					.replace(/,/g, ".");
				}
				function fNumber(pValue, pFallback = 0)
				{
					const fParsed = Number(fArabicToEnglishDigits(pValue));
					return Number.isFinite(fParsed) ? fParsed : pFallback;
				}
				function fMoney(pValue)
				{
					return Math.round(Math.max(0, pValue)).toLocaleString("ar-EG");
				}
				function fSet(pName, pValue)
				{
					const fElement = fOut(pName);
					if (fElement) fElement.textContent = pValue;
				}
				function fCalc()
				{
					const fLocation = fRoot.querySelector('[data-field="location"]:checked')?.value || "cairo";
					const fBuildingType = fRoot.querySelector('[data-field="buildingType"]:checked')?.value || "residential";
					const fLocationName = fLocation === "giza" ? "الجيزة" : "القاهرة";
					const fIsNonResidential = fBuildingType === "nonResidential";
					const fServiceFee = fIsNonResidential
						? (fLocation === "giza" ? fGizaNonResidentialFee : fCairoNonResidentialFee)
						: (fLocation === "giza" ? fGizaFee : fCairoFee);
					const fBuildingCount = 1 + fBuildingExtras.filter((pField) => pField.checked).length;
					const fLicense = Math.max(0, fNumber(fLicenseCost?.value));
					const fBasicFee = fBuildingCount * fBuildingFee;
					const fGrossStamp = fLicense * fStampRate;
					if (fPaidStamp)
					{
						fPaidStamp.disabled = Boolean(fPaidStampFull?.checked);
						if (fPaidStampFull?.checked)
						{
							fPaidStamp.value = String(Math.round(fGrossStamp));
						}
					}
					const fPaid = Math.max(0, fNumber(fPaidStamp?.value));
					const fStampDue = Math.max(0, fGrossStamp - fPaid);
					const fHasContract = Boolean(fContractRequired?.checked);
					const fAppliedContractFee = fHasContract ? fContractFee : 0;
					const fTotal = fServiceFee + fAppliedContractFee + fBasicFee + fStampDue;
					if (fContractRow) fContractRow.hidden = !fHasContract;
					if (fContractFormula) fContractFormula.hidden = !fHasContract;
					fSet("locationName", fLocationName);
					fSet("serviceFee", fMoney(fServiceFee));
					fSet("contractFee", fMoney(fAppliedContractFee));
					fSet("basicFee", fMoney(fBasicFee));
					fSet("grossStamp", fMoney(fGrossStamp));
					fSet("paidStamp", fMoney(Math.min(fPaid, fGrossStamp)));
					fSet("stampDue", fMoney(fStampDue));
					fSet("total", fMoney(fTotal));
					if (fGrossStamp > 0 && fPaid >= fGrossStamp)
					{
						fSet("status", "لا توجد دمغة متبقية وفق المبلغ المسدد الذي أدخلته.");
					} else if (fPaid > 0) {
						fSet("status", `تم خصم ${fMoney(Math.min(fPaid, fGrossStamp))} جنيه من الدمغة المحسوبة.`);
					} else {
						fSet("status", "الحسبة تشمل كامل الدمغة المستحقة وفق البيانات المدخلة.");
					}
				}
				if (fForm) fForm.addEventListener("submit", (pEvent) => pEvent.preventDefault());
				[
					fLicenseCost,
					fPaidStamp
				].forEach((pField) =>
					{
						pField?.addEventListener("input", fCalc);
						pField?.addEventListener("change", fCalc);
						pField?.addEventListener("focus", () => pField.select());
				});
				fLocations.forEach((pField) => pField.addEventListener("change", fCalc));
				fBuildingTypes.forEach((pField) => pField.addEventListener("change", fCalc));
				fBuildingExtras.forEach((pField) => pField.addEventListener("change", fCalc));
				fPaidStampFull?.addEventListener("change", fCalc);
				fContractRequired?.addEventListener("change", fCalc);
				fCalc();
			}





			// ==================== Execution Logic ====================

			fInitCertificateCostCalc();
		})();
	</script>







</section>





<style>



	.CertificateCostCalc {
		box-sizing: border-box;
		margin-inline: auto;
		border: 1px solid #dce7ec;
		background: linear-gradient(145deg, #ffffff, #f7fbfc 72%);
		color: #20272c;
		box-shadow: 0 18px 52px rgba(35, 68, 82, .11);
		direction: rtl;
	}

	.CertificateCostCalc * {
		box-sizing: border-box;
	}


	.CertificateHead {
		display: grid;
		align-items: center;
		margin-bottom: 24px;
	}


	.CertificateHeadText h2 {
		margin: 0;
		font-size: clamp(25px, 3vw, 40px);
		line-height: 1.35;
		color: #1b2328;
	}

	.CertificateHeadText p {
		margin: 0;
	}

	.CertificateHeadText > p:last-child {
		max-width: 72ch;
		margin-top: 9px;
		color: #65737b;
		font-size: 15px;
		line-height: 1.9;
	}


	.CertificateEyebrow {
		width: fit-content;
		margin-bottom: 10px;
		padding: 6px 11px;
		border-radius: 999px;
		background: var(--CertificateAccentSoft);
		color: var(--CertificateAccentDark);
		font-size: 13px;
		font-weight: 900;
	}


	.CertificateRateBadge {
		padding: 16px;
		border-radius: 24px;
		background: var(--CertificateAccentSoft);
		color: var(--CertificateAccentDark);
		display: grid;
		place-items: center;
		align-content: center;
		gap: 8px;
	}

	.CertificateRateBadge strong {
		line-height: 1;
		direction: ltr;
	}

	.CertificateRateBadge span {
		font-size: 12px;
		font-weight: 800;
		line-height: 1.5;
	}


	.CertificateBody {
		display: grid;
		gap: 18px;
	}


	.CertificateInputs {
		display: grid;
		gap: 15px;
		align-content: start;
		border: 1px solid #e3eaee;
		background: #fff;
	}


	.CertificateLocation {
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.CertificateLocation legend {
		display: block;
		margin-bottom: 8px;
		color: #3a474e;
		font-size: 13px;
		font-weight: 900;
	}


	.CertificateLocationButtons {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
		padding: 5px;
		border-radius: 17px;
		background: #eef3f5;
	}


	.CertificateLocationButton {
		position: relative;
		min-width: 0;
	}

	.CertificateLocationButton input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.CertificateLocationButton span {
		display: grid;
		place-items: center;
		min-height: 43px;
		padding: 8px 12px;
		border: 1px solid transparent;
		border-radius: 13px;
		color: #5c6970;
		font-size: 14px;
		font-weight: 900;
		cursor: pointer;
		transition: background-color .18s ease, color .18s ease, box-shadow .18s ease;
	}

	.CertificateLocationButton input:checked + span {
		background: #fff;
		color: var(--CertificateAccentDark);
		box-shadow: 0 5px 15px rgba(27, 67, 84, .12);
	}

	.CertificateLocationButton input:focus-visible + span {
		outline: 3px solid color-mix(in srgb, var(--CertificateAccent) 28%, transparent);
		outline-offset: 2px;
	}


	.CertificateBuildingExtras {
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.CertificateBuildingExtras legend {
		display: block;
		margin-bottom: 8px;
		color: #3a474e;
		font-size: 13px;
		font-weight: 900;
	}

	.CertificateBuildingBase {
		margin: 0 0 8px;
		color: #65737b;
		font-size: 12px;
		font-weight: 800;
		line-height: 1.65;
	}

	.CertificateBuildingExtraOptions {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 8px;
	}

	.CertificateBuildingExtraOption {
		position: relative;
		min-width: 0;
	}

	.CertificateBuildingExtraOption input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.CertificateBuildingExtraOption span {
		display: grid;
		place-items: center;
		min-height: 43px;
		padding: 8px 10px;
		border: 1px solid #d8e0e4;
		border-radius: 13px;
		background: #fbfcfd;
