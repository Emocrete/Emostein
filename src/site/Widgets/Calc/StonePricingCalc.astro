---
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	/** عرض الطاولة القياسية بالمتر. DefVal = 1.8 */
	pSlabWidth?: number;

	/** طول الطاولة القياسية بالمتر. DefVal = 2.9 */
	pSlabHeight?: number;

	/** هامش الربح النهائي بعد حساب كل التكاليف. DefVal = 0.3 */
	pProfitRate?: number;

	/** تكلفة نقل ثابتة كبداية قبل التحميل بعدد الطاولات. DefVal = 850 */
	pTransportBase?: number;

	/** تحميل نقل لكل طاولة مطلوبة. DefVal = 180 */
	pTransportPerSlab?: number;

	/** سعر متر الطاولة الافتراضي عند فتح الودجت. DefVal = 1200 */
	pDefaultTablePrice?: number;

	/** عدد البلاطات الافتراضي. DefVal = 20 */
	pDefaultQuantity?: number;

	/** عرض البلاطة الافتراضي بالسنتيمتر. DefVal = 60 */
	pDefaultTileWidth?: number;

	/** طول البلاطة الافتراضي بالسنتيمتر. DefVal = 60 */
	pDefaultTileHeight?: number;

	/** السمك الافتراضي بالسنتيمتر. DefVal = 2 */
	pDefaultThickness?: number;
}

const cProps = Astro.props as Props & Record<string, unknown>;

const {
	pSlabWidth = 1.8,
	pSlabHeight = 2.9,
	pProfitRate = 0.3,
	pTransportBase = 850,
	pTransportPerSlab = 180,
	pDefaultTablePrice = 1200,
	pDefaultQuantity = 20,
	pDefaultTileWidth = 60,
	pDefaultTileHeight = 60,
	pDefaultThickness = 2,

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("StonePricingCalc"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

const cCssVars = [
	`--StonePricingMaxWidth:1180px;`,
	GetStyleText(pGivenStyle),
].filter(Boolean).join(" ");

const cPlace = new Place(cProps as PlaceProps, cCssVars);
const cSlabArea = pSlabWidth * pSlabHeight;
const cProfitPercent = pProfitRate * 100;

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---

<section
	class={`StonePricingCalc ${cPlace.Class} ${pGivenClass}`.trim()}
	style={cPlace.Style}
	id={pGivenID}
	dir="rtl"
	data-emo-stone-pricing="true"
	data-slab-width={pSlabWidth}
	data-slab-height={pSlabHeight}
	data-profit-rate={pProfitRate}
	data-transport-base={pTransportBase}
	data-transport-per-slab={pTransportPerSlab}
	{...RemAttr}
>

	<header class="StonePricingHead">

		<div class="StonePricingTitleBox">

			<p class="StonePricingEyebrow">
				حاسبة تسعير تقريبية
			</p>

			<h2 class="StonePricingTitle">
				اعرف سعر الرخام أو الجرانيت بعد الهالك والنقل والتركيب
			</h2>

			<p class="StonePricingDesc">
				الحسبة مبنية مبدئيًا على طاولة متوسطة {pSlabWidth.toFixed(2)} × {pSlabHeight.toFixed(2)} م = {cSlabArea.toFixed(2)} م²، وتفصل الفرق بين سعر متر الطاولة وسعر البيع النهائي.
			</p>

		</div>

		<div class="StonePricingBadge" aria-label={`هامش ربح ${cProfitPercent}%`}>

			<span class="StonePricingBadgeNum">
				{cProfitPercent.toFixed(0)}%
			</span>

			<span class="StonePricingBadgeText">
				هامش ربح بعد التكاليف
			</span>

		</div>

	</header>

	<div class="StonePricingGrid">

		<form class="StonePricingForm" data-area="inputs">

			<div class="StonePricingField Wide">

				<label class="StonePricingLabel" for={`${pGivenID}-material`}>
					نوع الخامة
				</label>

				<select
					class="StonePricingInput"
					id={`${pGivenID}-material`}
					data-field="material"
				>

					<option value="marble-eg" data-price="1200" data-install="360" data-cut="28" data-transport="1" selected>
						رخام مصري
					</option>

					<option value="marble-imp" data-price="3000" data-install="450" data-cut="38" data-transport="1.08">
						رخام مستورد
					</option>

					<option value="granite-eg" data-price="1500" data-install="420" data-cut="42" data-transport="1.15">
						جرانيت مصري
					</option>

					<option value="granite-imp" data-price="2800" data-install="520" data-cut="48" data-transport="1.2">
						جرانيت مستورد
					</option>

				</select>

			</div>

			<div class="StonePricingField">

				<label class="StonePricingLabel" for={`${pGivenID}-table-price`}>
					سعر متر الطاولة المعلن
				</label>

				<div class="StonePricingInputUnit">

					<input
						class="StonePricingInput"
						id={`${pGivenID}-table-price`}
						data-field="tablePrice"
						type="number"
						min="1"
						step="50"
						value={pDefaultTablePrice}
						inputmode="decimal"
					/>

					<span>
						ج/م²
					</span>

				</div>

			</div>

			<div class="StonePricingField">

				<label class="StonePricingLabel" for={`${pGivenID}-thickness`}>
					السمك
				</label>

				<select
					class="StonePricingInput"
					id={`${pGivenID}-thickness`}
					data-field="thickness"
				>

					<option value="2" selected={pDefaultThickness === 2}>2 سم</option>
					<option value="3" selected={pDefaultThickness === 3}>3 سم</option>
					<option value="4" selected={pDefaultThickness === 4}>4 سم</option>

				</select>

			</div>

			<div class="StonePricingField">

				<label class="StonePricingLabel" for={`${pGivenID}-qty`}>
					عدد البلاطات / القطع
				</label>

				<input
					class="StonePricingInput"
					id={`${pGivenID}-qty`}
					data-field="quantity"
					type="number"
					min="1"
					step="1"
					value={pDefaultQuantity}
					inputmode="numeric"
				/>

			</div>

			<div class="StonePricingField">

				<label class="StonePricingLabel" for={`${pGivenID}-tile-width`}>
					عرض البلاطة
				</label>

				<div class="StonePricingInputUnit">

					<input
						class="StonePricingInput"
						id={`${pGivenID}-tile-width`}
						data-field="tileWidth"
						type="number"
						min="1"
						step="1"
						value={pDefaultTileWidth}
						inputmode="decimal"
					/>

					<span>
						سم
					</span>

				</div>

			</div>

			<div class="StonePricingField">

				<label class="StonePricingLabel" for={`${pGivenID}-tile-height`}>
					طول البلاطة
				</label>

				<div class="StonePricingInputUnit">

					<input
						class="StonePricingInput"
						id={`${pGivenID}-tile-height`}
						data-field="tileHeight"
						type="number"
						min="1"
						step="1"
						value={pDefaultTileHeight}
						inputmode="decimal"
					/>

					<span>
						سم
					</span>

				</div>

			</div>

			<p class="StonePricingHint">
				غيّر سعر متر الطاولة يدويًا لو النوع المختار له سعر فعلي مختلف في المعرض أو المخزن.
			</p>

		</form>

		<div class="StonePricingResult" aria-live="polite">

			<div class="StonePricingResultTop">

				<div>

					<p class="StonePricingSmallTitle">
						السعر النهائي التقريبي
					</p>

					<p class="StonePricingTotal">
						<span data-out="total">0</span>
						<span>جنيه</span>
					</p>

				</div>

				<div class="StonePricingFinalMeter">
					<span data-out="finalMeter">0</span>
					ج/م² بيع نهائي
				</div>

			</div>

			<div class="StonePricingStats">

				<div>
					<span data-out="requestedArea">0</span>
					<small>م² مساحة هندسية</small>
				</div>

				<div>
					<span data-out="slabCount">0</span>
					<small>طاولة مطلوبة</small>
				</div>

				<div>
					<span data-out="piecesPerSlab">0</span>
					<small>قطعة / طاولة</small>
				</div>

				<div>
					<span data-out="wastePercent">0%</span>
					<small>هالك تقريبي</small>
				</div>

			</div>

			<p class="StonePricingWarning" data-out="warning" hidden></p>

		</div>

	</div>

	<div class="StonePricingInvoice" data-area="invoice">

		<div class="StonePricingInvoiceHead">

			<h3>
				فاتورة تحليل السعر
			</h3>

			<p>
				من سعر متر الطاولة إلى سعر البيع النهائي للعميل
			</p>

		</div>

		<div class="StonePricingRows">

			<div class="StonePricingRow Head">
				<span>البند</span>
				<span>الأساس</span>
				<span>القيمة</span>
			</div>

			<div class="StonePricingRow">
				<span>قيمة الخام حسب المساحة الهندسية</span>
				<span data-out="baseMaterialNote">0</span>
				<strong data-out="baseMaterialCost">0</strong>
			</div>

			<div class="StonePricingRow">
				<span>هالك تقطيع من الطاولات</span>
				<span data-out="cutWasteNote">0</span>
				<strong data-out="cutWasteCost">0</strong>
			</div>

			<div class="StonePricingRow">
				<span>تحميل غلايق وفروق مساحة تركيب</span>
				<span data-out="installWasteNote">0</span>
				<strong data-out="installWasteCost">0</strong>
			</div>

			<div class="StonePricingRow">
				<span>تقطيع وتجهيز حواف</span>
				<span data-out="cuttingNote">0</span>
				<strong data-out="cuttingCost">0</strong>
			</div>

			<div class="StonePricingRow">
				<span>مصنعية تركيب</span>
				<span data-out="installationNote">0</span>
				<strong data-out="installationCost">0</strong>
			</div>

			<div class="StonePricingRow">
				<span>نقل ومناولة</span>
				<span data-out="transportNote">0</span>
				<strong data-out="transportCost">0</strong>
			</div>

			<div class="StonePricingRow Subtotal">
				<span>الإجمالي قبل هامش الربح</span>
				<span data-out="subtotalNote">تكلفة مباشرة</span>
				<strong data-out="subtotal">0</strong>
			</div>

			<div class="StonePricingRow Profit">
				<span>هامش الربح</span>
				<span>{cProfitPercent.toFixed(0)}% بعد كل التكاليف</span>
				<strong data-out="profit">0</strong>
			</div>

			<div class="StonePricingRow Total">
				<span>السعر النهائي المقترح</span>
				<span data-out="totalNote">0</span>
				<strong data-out="invoiceTotal">0</strong>
			</div>

		</div>

	</div>

	<p class="StonePricingDisclaimer">
		الناتج تقديري للتوعية والمقارنة، وليس عرض سعر نهائي. التسعير الحقيقي يتغير بعد رفع المقاسات، اتجاه العروق، أماكن الغلايق، الدور، مسافة النقل، حالة الموقع، ودرجة فرز الخام.
	</p>

	<script is:inline>
		(() => {
			const fRoot = document.currentScript.closest("[data-emo-stone-pricing]");
			if (!fRoot) return;

			const fForm = fRoot.querySelector('[data-area="inputs"]');
			if (fForm) {
				fForm.addEventListener("submit", (pEvent) => pEvent.preventDefault());
			}

			const fFields = {
				material: fRoot.querySelector('[data-field="material"]'),
				tablePrice: fRoot.querySelector('[data-field="tablePrice"]'),
				thickness: fRoot.querySelector('[data-field="thickness"]'),
				quantity: fRoot.querySelector('[data-field="quantity"]'),
				tileWidth: fRoot.querySelector('[data-field="tileWidth"]'),
				tileHeight: fRoot.querySelector('[data-field="tileHeight"]'),
			};

			const fOut = (pName) => fRoot.querySelector(`[data-out="${pName}"]`);
			const fSlabWidth = fNumber(fRoot.dataset.slabWidth, 1.8);
			const fSlabHeight = fNumber(fRoot.dataset.slabHeight, 2.9);
			const fSlabArea = fSlabWidth * fSlabHeight;
			const fProfitRate = fNumber(fRoot.dataset.profitRate, 0.3);
			const fTransportBase = fNumber(fRoot.dataset.transportBase, 850);
			const fTransportPerSlab = fNumber(fRoot.dataset.transportPerSlab, 180);

			let fPriceEdited = false;

			function fArabicToEnglishDigits(pValue) {
				return String(pValue ?? "")
					.replace(/[٠-٩]/g, (pDigit) => String("٠١٢٣٤٥٦٧٨٩".indexOf(pDigit)))
					.replace(/[۰-۹]/g, (pDigit) => String("۰۱۲۳۴۵۶۷۸۹".indexOf(pDigit)))
					.replace(/,/g, ".");
			}

			function fNumber(pValue, pFallback = 0) {
				const fParsed = Number(fArabicToEnglishDigits(pValue));
				return Number.isFinite(fParsed) ? fParsed : pFallback;
			}

			function fMoney(pValue) {
				return Math.round(pValue).toLocaleString("ar-EG");
			}

			function fArea(pValue) {
				return pValue.toLocaleString("ar-EG", {
					maximumFractionDigits: 2,
					minimumFractionDigits: 0,
				});
			}

			function fPercent(pValue) {
				return `${pValue.toLocaleString("ar-EG", { maximumFractionDigits: 1 })}%`;
			}

			function fSet(pName, pValue) {
				const fEl = fOut(pName);
				if (fEl) fEl.textContent = pValue;
			}

			function fGetThicknessFactor(pThickness) {
				if (pThickness >= 4) return 1.35;
				if (pThickness >= 3) return 1.18;
				return 1;
			}

			function fGetInstallWasteRate(pArea, pTileWidth, pTileHeight) {
				const fMaxSide = Math.max(pTileWidth, pTileHeight);
				const fSizeRate = fMaxSide >= 120 ? 0.06 : fMaxSide >= 80 ? 0.04 : 0.025;
				const fAreaRate = pArea < 10 ? 0.08 : pArea < 30 ? 0.05 : 0.035;
				return fSizeRate + fAreaRate;
			}

			function fCalc() {
				const fSelected = fFields.material.selectedOptions[0];
				const fTablePrice = Math.max(0, fNumber(fFields.tablePrice.value, 0));
				const fThickness = Math.max(1, fNumber(fFields.thickness.value, 2));
				const fQuantity = Math.max(1, Math.floor(fNumber(fFields.quantity.value, 1)));
				const fTileWidthCm = Math.max(1, fNumber(fFields.tileWidth.value, 1));
				const fTileHeightCm = Math.max(1, fNumber(fFields.tileHeight.value, 1));
				const fInstallRate = fNumber(fSelected.dataset.install, 360);
				const fCutRate = fNumber(fSelected.dataset.cut, 28);
				const fTransportFactor = fNumber(fSelected.dataset.transport, 1);
				const fThicknessFactor = fGetThicknessFactor(fThickness);

				const fTileArea = (fTileWidthCm * fTileHeightCm) / 10000;
				const fRequestedArea = fQuantity * fTileArea;
				const fSlabWidthCm = fSlabWidth * 100;
				const fSlabHeightCm = fSlabHeight * 100;
				const fFitA = Math.floor(fSlabWidthCm / fTileWidthCm) * Math.floor(fSlabHeightCm / fTileHeightCm);
				const fFitB = Math.floor(fSlabWidthCm / fTileHeightCm) * Math.floor(fSlabHeightCm / fTileWidthCm);
				let fPiecesPerSlab = Math.max(fFitA, fFitB);
				const fImpossiblePiece = fPiecesPerSlab < 1;
				if (fImpossiblePiece) fPiecesPerSlab = 1;

				const fSlabCount = Math.max(1, Math.ceil(fQuantity / fPiecesPerSlab));
				const fPurchasedArea = fSlabCount * fSlabArea;
				const fCutWasteArea = Math.max(0, fPurchasedArea - fRequestedArea);
				const fCutWasteRate = fRequestedArea > 0 ? fCutWasteArea / fRequestedArea : 0;
				const fInstallWasteRate = fGetInstallWasteRate(fRequestedArea, fTileWidthCm, fTileHeightCm);
				const fInstallWasteArea = fRequestedArea * fInstallWasteRate;
				const fTotalWastePercent = ((fCutWasteArea + fInstallWasteArea) / Math.max(fRequestedArea, 1)) * 100;

				const fBaseMaterialCost = fRequestedArea * fTablePrice;
				const fCutWasteCost = fCutWasteArea * fTablePrice;
				const fInstallWasteCost = fInstallWasteArea * fTablePrice;
				const fCutLength = fQuantity * 2 * ((fTileWidthCm + fTileHeightCm) / 100);
				const fCuttingCost = fCutLength * fCutRate * fThicknessFactor;
				const fInstallationCost = Math.max(fRequestedArea * fInstallRate * fThicknessFactor, 1500);
				const fTransportCost = fTransportBase + fSlabCount * fTransportPerSlab * fTransportFactor * fThicknessFactor;
				const fSubtotal = fBaseMaterialCost + fCutWasteCost + fInstallWasteCost + fCuttingCost + fInstallationCost + fTransportCost;
				const fProfit = fSubtotal * fProfitRate;
				const fTotal = fSubtotal + fProfit;
				const fFinalMeter = fRequestedArea > 0 ? fTotal / fRequestedArea : 0;
				const fFinalPiece = fQuantity > 0 ? fTotal / fQuantity : 0;

				fSet("total", fMoney(fTotal));
				fSet("invoiceTotal", fMoney(fTotal));
				fSet("finalMeter", fMoney(fFinalMeter));
				fSet("requestedArea", fArea(fRequestedArea));
				fSet("slabCount", fSlabCount.toLocaleString("ar-EG"));
				fSet("piecesPerSlab", fPiecesPerSlab.toLocaleString("ar-EG"));
				fSet("wastePercent", fPercent(fTotalWastePercent));
				fSet("baseMaterialNote", `${fArea(fRequestedArea)} م² × ${fMoney(fTablePrice)} ج`);
				fSet("baseMaterialCost", fMoney(fBaseMaterialCost));
				fSet("cutWasteNote", `${fArea(fCutWasteArea)} م² من ${fSlabCount.toLocaleString("ar-EG")} طاولة`);
				fSet("cutWasteCost", fMoney(fCutWasteCost));
				fSet("installWasteNote", `${fPercent(fInstallWasteRate * 100)} غلايق وفروق تركيب`);
				fSet("installWasteCost", fMoney(fInstallWasteCost));
				fSet("cuttingNote", `${fArea(fCutLength)} متر طولي × معامل سمك ${fThicknessFactor.toLocaleString("ar-EG")}`);
				fSet("cuttingCost", fMoney(fCuttingCost));
				fSet("installationNote", `${fArea(fRequestedArea)} م²، حد أدنى ١٬٥٠٠ ج`);
				fSet("installationCost", fMoney(fInstallationCost));
				fSet("transportNote", `${fTransportBase.toLocaleString("ar-EG")} ج ثابت + تحميل ${fSlabCount.toLocaleString("ar-EG")} طاولة`);
				fSet("transportCost", fMoney(fTransportCost));
				fSet("subtotal", fMoney(fSubtotal));
				fSet("profit", fMoney(fProfit));
				fSet("totalNote", `${fMoney(fFinalPiece)} ج/قطعة تقريبًا`);

				const fWarning = fOut("warning");
				if (fWarning) {
					if (fImpossiblePiece) {
						fWarning.hidden = false;
						fWarning.textContent = "تنبيه: مقاس البلاطة أكبر من الطاولة المتوسطة، لذلك الناتج غير صالح كحسبة تقطيع فعلية ويحتاج رفع مقاسات وتسعير يدوي.";
					} else if (fCutWasteRate > 0.9) {
						fWarning.hidden = false;
						fWarning.textContent = "تنبيه: الهالك عالي جدًا مع هذه المقاسات والكمية. تغيير مقاس البلاطة أو زيادة الكمية قد يحسن استغلال الطاولة.";
					} else {
						fWarning.hidden = true;
						fWarning.textContent = "";
					}
				}
			}

			function fSetDefaultPriceFromMaterial() {
				const fSelected = fFields.material.selectedOptions[0];
				const fDefaultPrice = fNumber(fSelected.dataset.price, 0);
				fFields.tablePrice.value = String(fDefaultPrice);
				fPriceEdited = false;
				fCalc();
			}

			fFields.material.addEventListener("change", fSetDefaultPriceFromMaterial);
			fFields.tablePrice.addEventListener("input", () => {
				fPriceEdited = true;
				fCalc();
			});

			[fFields.thickness, fFields.quantity, fFields.tileWidth, fFields.tileHeight].forEach((pField) => {
				pField.addEventListener("input", fCalc);
				pField.addEventListener("change", fCalc);
			});

			if (!fPriceEdited) fCalc();
		})();
	</script>

</section>

<style>
	.StonePricingCalc {
		box-sizing: border-box;
		width: min(var(--StonePricingMaxWidth), calc(100% - 24px));
		margin-inline: auto;
		padding: clamp(18px, 3vw, 34px);
		border-radius: 30px;
