					{ Value: "paint", Label: "دهان ومحارة", Factor: .75 }, { Value: "mixed", Label: "كسوات جزئية", Factor: 1.08 }, { Value: "stone", Label: "كسوات واسعة", Factor: 1.48 },
				] },
			] },
			{ Title: "السور والبوابات", Accuracy: 75, Desc: "السور والبوابات عناصر مستقلة ويمكن أن تصنع فرقًا كبيرًا.", Questions: [
				{ Key: "fence", Label: "طول السور المطلوب تشطيبه", Kind: "number", Unit: "م طولي", Min: 0, Max: 1000, Baseline: 90, FixedPerUnit: 2600 },
				{ Key: "gates", Label: "عدد البوابات الرئيسية/الجراج", Kind: "number", Unit: "بوابة", Min: 0, Max: 12, Baseline: 2, FixedPerUnit: 85000 },
			] },
			{ Title: "لاندسكيب وتجهيزات", Accuracy: 92, Desc: "نضيف الزراعة والإضاءة الخارجية والعناصر الثابتة للوصول لأقرب نطاق قبل مقايسة.", Questions: [
				{ Key: "landscape", Label: "مستوى اللاندسكيب", Kind: "choice", Options: [
					{ Value: "simple", Label: "بسيط", Factor: .82 }, { Value: "mid", Label: "متوسط", Factor: 1 }, { Value: "rich", Label: "غني", Factor: 1.35 },
				] },
			] },
		],
	},
];

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cPlace = new Place(cProps as PlaceProps, cGivenStyle);
---

<section
	class={`FinishCostGame ${cPlace.Class} ${pGivenClass}`.trim()}
	style={cPlace.Style}
	id={pGivenID}
	dir="rtl"
	data-finish-cost-game="true"
	data-default-area={pDefaultArea}
	{...RemAttr}
>
	<header class="CostGameHead">
		<div class="CostGameTitle">
			<p class="CostGameKicker">حاسبة تدريجية · أنت تختار مستوى الدقة</p>
			<h2>{pTitle}</h2>
			<p>{pDesc}</p>
		</div>

		<div class="CostGameScore" data-score-box="true">
			<span>Score</span>
			<strong data-score="true">0</strong>
			<small>من {cItems.length * 100}</small>
		</div>
	</header>

	<FinishCostGameNav pItems={cItems} pActiveId={cItems[0].Id} />

	{cItems.map((pItem, pIndex) => (
		<FinishCostGamePanel pItem={pItem} pActive={pIndex === 0} />
	))}

	<FinishCostGameSummary />
</section>

<style>
	.FinishCostGame {
		width: min(1280px, 100%);
		margin-inline: auto;
		box-sizing: border-box;
		border: 1px solid #dce3eb;
		border-radius: 28px;
		overflow: clip;
		background: #fff;
		box-shadow: 0 24px 70px rgba(15, 23, 42, .12);
		color: #172033;
		font-family: inherit;
	}

	.CostGameHead {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 22px;
		align-items: center;
		padding: 28px 30px;
		background:
			radial-gradient(circle at 8% 15%, rgba(109, 221, 190, .16), transparent 28%),
			linear-gradient(135deg, #172334, #0f1724);
		color: #fff;
	}

	.CostGameTitle {
		display: grid;
		gap: 7px;
	}

	.CostGameTitle p,
	.CostGameTitle h2 {
		margin: 0;
	}

	.CostGameKicker {
		color: #cfe883;
		font-size: 12px;
		font-weight: 900;
	}

	.CostGameTitle h2 {
		font-size: clamp(26px, 4vw, 44px);
		line-height: 1.25;
	}

	.CostGameTitle > p:last-child {
		max-width: 820px;
		color: #bdc6d4;
		font-size: 14px;
		line-height: 1.8;
	}

	.CostGameScore {
		display: grid;
		place-items: center;
		min-width: 108px;
		min-height: 108px;
		padding: 8px;
		box-sizing: border-box;
		border: 1px solid rgba(255,255,255,.15);
		border-radius: 22px;
		background: rgba(255,255,255,.07);
	}

	.CostGameScore span,
	.CostGameScore small {
		color: #9faabd;
		font-size: 10px;
		font-weight: 800;
	}

	.CostGameScore strong {
		font-size: 30px;
		line-height: 1;
		color: #d9f08a;
	}

	@media (max-width: 620px) {
		.FinishCostGame {
			border-radius: 20px;
		}

		.CostGameHead {
			grid-template-columns: minmax(0, 1fr) 82px;
			padding: 22px 16px;
		}

		.CostGameScore {
			min-width: 74px;
			min-height: 82px;
			border-radius: 16px;
		}

		.CostGameScore strong {
			font-size: 24px;
		}
	}
</style>

<script is:inline>
(function () {
	const cRoots = document.querySelectorAll("[data-finish-cost-game='true']");
	for (const cRoot of cRoots) Register(cRoot);

	function Register(pRoot) {
		if (!pRoot || pRoot.dataset.ready === "true") return;
		pRoot.dataset.ready = "true";

		const cPanels = Array.from(pRoot.querySelectorAll("[data-cost-panel]"));
		const cNavButtons = Array.from(pRoot.querySelectorAll("[data-cost-item-target]"));
		const cSummary = pRoot.querySelector("[data-cost-summary='true']");
		let cActiveId = cPanels[0]?.dataset.costPanel || "";

		pRoot.addEventListener("click", HandleClick);
		pRoot.addEventListener("input", HandleFieldChange);
		pRoot.addEventListener("change", HandleFieldChange);
		RenderAll();

		function HandleClick(pEvent) {
			const cNav = pEvent.target.closest("[data-cost-item-target]");
			if (cNav && pRoot.contains(cNav)) {
				ShowItem(cNav.dataset.costItemTarget || "");
				return;
			}

			const cPanel = pEvent.target.closest("[data-cost-panel]");
			if (!cPanel) return;

			const cStageJump = pEvent.target.closest("[data-stage-jump]");
			if (cStageJump) {
				const cIndex = Number(cStageJump.dataset.stageJump || 0);
				const cReached = GetReachedStage(cPanel);
				if (cIndex <= cReached + 1) ShowStage(cPanel, cIndex);
				return;
			}

			const cAction = pEvent.target.closest("[data-action]");
			if (!cAction) return;
			if (cAction.dataset.action === "next-stage") NextStage(cPanel);
			if (cAction.dataset.action === "accept-item") NextItem(cPanel.dataset.costPanel || "");
		}

		function HandleFieldChange(pEvent) {
			if (!pEvent.target.matches("[data-cost-field='true']")) return;
			const cPanel = pEvent.target.closest("[data-cost-panel]");
			if (!cPanel) return;
			UpdateReached(cPanel);
			RenderAll();
		}

		function ShowItem(pId) {
			if (!pId) return;
			cActiveId = pId;
			for (const cPanel of cPanels) cPanel.hidden = cPanel.dataset.costPanel !== pId;
			for (const cButton of cNavButtons) {
				const cActive = cButton.dataset.costItemTarget === pId;
				cButton.classList.toggle("IsActive", cActive);
				if (cActive) cButton.setAttribute("aria-current", "step");
				else cButton.removeAttribute("aria-current");
			}
			RenderAll();
		}

		function ShowStage(pPanel, pIndex) {
			const cStages = Array.from(pPanel.querySelectorAll("[data-cost-stage]"));
			const cSafeIndex = Math.max(0, Math.min(cStages.length - 1, pIndex));
			pPanel.dataset.activeStage = String(cSafeIndex);
			for (const cStage of cStages) cStage.hidden = Number(cStage.dataset.costStage) !== cSafeIndex;
			for (const cNode of pPanel.querySelectorAll("[data-stage-node]")) {
				cNode.classList.toggle("IsActive", Number(cNode.dataset.stageNode) === cSafeIndex);
			}
			RenderPanelActions(pPanel);
		}

		function NextStage(pPanel) {
			const cActive = Number(pPanel.dataset.activeStage || 0);
			const cStages = pPanel.querySelectorAll("[data-cost-stage]");
			if (!StageComplete(pPanel, cActive)) {
				const cStage = pPanel.querySelector(`[data-cost-stage='${cActive}']`);
				const cFirstEmpty = FindFirstEmpty(cStage);
				cFirstEmpty?.focus();
				return;
			}
			UpdateReached(pPanel);
			if (cActive < cStages.length - 1) ShowStage(pPanel, cActive + 1);
			else NextItem(pPanel.dataset.costPanel || "");
		}

		function NextItem(pId) {
			const cIndex = cPanels.findIndex((pPanel) => pPanel.dataset.costPanel === pId);
			const cNext = cPanels[cIndex + 1] || cPanels[0];
			if (cNext) ShowItem(cNext.dataset.costPanel || "");
		}

		function UpdateReached(pPanel) {
			const cStages = Array.from(pPanel.querySelectorAll("[data-cost-stage]"));
			let cReached = -1;
			for (let i = 0; i < cStages.length; i += 1) {
				if (!StageComplete(pPanel, i)) break;
				cReached = i;
			}
			pPanel.dataset.reachedStage = String(cReached);
			for (const cNode of pPanel.querySelectorAll("[data-stage-node]")) {
				cNode.classList.toggle("IsReached", Number(cNode.dataset.stageNode) <= cReached);
			}
		}

		function GetReachedStage(pPanel) {
			UpdateReached(pPanel);
			return Number(pPanel.dataset.reachedStage || -1);
		}

		function StageComplete(pPanel, pIndex) {
			const cStage = pPanel.querySelector(`[data-cost-stage='${pIndex}']`);
			if (!cStage) return false;
			const cFields = Array.from(cStage.querySelectorAll("[data-cost-field='true']"));
			if (!cFields.length) return true;

			const cGroups = new Map();
			for (const cField of cFields) {
				if (cField.type === "radio") {
					const cName = cField.name || "radio";
					if (!cGroups.has(cName)) cGroups.set(cName, []);
					cGroups.get(cName).push(cField);
				} else if (`${cField.value || ""}`.trim() === "") return false;
			}
			for (const cGroup of cGroups.values()) {
				if (!cGroup.some((pField) => pField.checked)) return false;
			}
			return true;
		}

		function FindFirstEmpty(pStage) {
			if (!pStage) return null;
			for (const cField of pStage.querySelectorAll("[data-cost-field='true']")) {
				if (cField.type === "radio") {
					const cChecked = pStage.querySelector(`input[name='${CssEscape(cField.name)}']:checked`);
					if (!cChecked) return cField;
				} else if (`${cField.value || ""}`.trim() === "") return cField;
			}
			return null;
		}

		function RenderAll() {
			for (const cPanel of cPanels) {
				UpdateReached(cPanel);
				RenderPanel(cPanel);
				RenderPanelActions(cPanel);
			}
			RenderSummary();
		}

		function RenderPanel(pPanel) {
			const cResult = CalculatePanel(pPanel);
			const cAccuracy = cResult.accuracy;
			const cGauge = pPanel.querySelector("[data-cost-item-gauge='true']");
			const cAccuracyText = pPanel.querySelector("[data-cost-item-accuracy='true']");
			const cRange = pPanel.querySelector("[data-cost-item-range='true']");
			const cMid = pPanel.querySelector("[data-cost-item-mid='true']");
			if (cGauge) cGauge.style.setProperty("--CostItemAccuracy", `${cAccuracy * 3.6}deg`);
			if (cAccuracyText) cAccuracyText.textContent = `${cAccuracy}%`;
			if (cRange) cRange.textContent = cResult.started ? `${Money(cResult.low)} – ${Money(cResult.high)} ج` : "—";
			if (cMid) cMid.textContent = cResult.started ? `المتوسط الحالي ${Money(cResult.mid)} ج` : "أجب عن المستوى الأول لبدء الحساب";

			const cNavAccuracy = pRoot.querySelector(`[data-cost-nav-accuracy='${pPanel.dataset.costPanel}']`);
			if (cNavAccuracy) cNavAccuracy.textContent = `${cAccuracy}% دقة`;
			const cNav = pRoot.querySelector(`[data-cost-item-target='${pPanel.dataset.costPanel}']`);
			if (cNav) cNav.dataset.complete = cAccuracy >= 92 ? "true" : "false";
		}

		function RenderPanelActions(pPanel) {
			const cActive = Number(pPanel.dataset.activeStage || 0);
			const cStages = Array.from(pPanel.querySelectorAll("[data-cost-stage]"));
			const cNext = pPanel.querySelector("[data-action='next-stage']");
			if (!cNext) return;
			const cComplete = StageComplete(pPanel, cActive);
			cNext.disabled = !cComplete;
			if (cActive >= cStages.length - 1) cNext.textContent = "اكتملت أعلى دقة · البند التالي";
			else {
				const cNode = pPanel.querySelector(`[data-stage-node='${cActive + 1}'] small`);
				cNext.textContent = `زود الدقة إلى ${cNode?.textContent || "المستوى التالي"}`;
			}
		}

		function CalculatePanel(pPanel) {
			const cBaseRate = Number(pPanel.dataset.baseRate || 0);
			const cArea = GetProjectArea();
			let cFactor = 1;
			let cFixed = 0;
			const cReached = GetReachedStage(pPanel);
			const cStarted = cReached >= 0;
			const cStages = Array.from(pPanel.querySelectorAll("[data-cost-stage]"));
			const cAccuracy = cStarted ? StageAccuracy(cStages[cReached]) : 0;

			for (let i = 0; i <= cReached; i += 1) {
				const cStage = cStages[i];
				if (!cStage) continue;
				for (const cField of cStage.querySelectorAll("[data-cost-field='true']")) {
					if (cField.type === "radio" && !cField.checked) continue;
					if (`${cField.value || ""}`.trim() === "") continue;
					if (cField.dataset.kind === "number") {
						if (cField.name === "area") continue;
						const cValue = Number(cField.value || 0);
						const cBaseline = Number(cField.dataset.baseline || 0);
						const cFactorPerUnit = Number(cField.dataset.factorPerUnit || 0);
						const cFixedPerUnit = Number(cField.dataset.fixedPerUnit || 0);
						if (cFactorPerUnit) cFactor *= Math.max(.35, 1 + (cValue - cBaseline) * cFactorPerUnit);
						if (cFixedPerUnit) cFixed += Math.max(0, cValue - cBaseline) * cFixedPerUnit;
						continue;
					}
					if (cField.tagName === "SELECT") {
						const cOption = cField.selectedOptions?.[0];
						cFactor *= Number(cOption?.dataset.factor || 1);
						cFixed += Number(cOption?.dataset.fixed || 0);
						continue;
					}
					cFactor *= Number(cField.dataset.factor || 1);
					cFixed += Number(cField.dataset.fixed || 0);
				}
			}

			const cMid = Math.max(0, cArea * cBaseRate * cFactor + cFixed);
			const cSpread = cStarted ? SpreadForAccuracy(cAccuracy) : .42;
			return {
				started: cStarted,
				accuracy: cAccuracy,
				mid: cMid,
				low: cMid * (1 - cSpread),
				high: cMid * (1 + cSpread),
			};
		}

		function GetProjectArea() {
			const cAreaField = pRoot.querySelector("[data-cost-panel='civil'] [name='area']");
			const cValue = Number(cAreaField?.value || 0);
			return cValue > 0 ? cValue : Number(pRoot.dataset.defaultArea || 450);
		}

		function StageAccuracy(pStage) {
			const cText = pStage?.querySelector("legend em")?.textContent || "";
			const cMatch = cText.match(/(\d+)\s*%/);
			return cMatch ? Number(cMatch[1]) : 0;
		}

		function SpreadForAccuracy(pAccuracy) {
			if (pAccuracy >= 90) return .07;
			if (pAccuracy >= 75) return .12;
			if (pAccuracy >= 55) return .2;
			if (pAccuracy >= 35) return .3;
			return .42;
		}

		function RenderSummary() {
			if (!cSummary) return;
			const cResults = cPanels.map(CalculatePanel);
			const cStarted = cResults.filter((pResult) => pResult.started);
			const cTotalMid = cResults.reduce((pSum, pResult) => pSum + pResult.mid, 0);
			const cTotalLow = cResults.reduce((pSum, pResult) => pSum + pResult.low, 0);
			const cTotalHigh = cResults.reduce((pSum, pResult) => pSum + pResult.high, 0);
			const cWeight = cResults.reduce((pSum, pResult) => pSum + pResult.mid, 0);
			const cAccuracy = cWeight > 0
				? Math.round(cResults.reduce((pSum, pResult) => pSum + pResult.accuracy * pResult.mid, 0) / cWeight)
				: 0;
			const cScore = cResults.reduce((pSum, pResult) => pSum + pResult.accuracy, 0);

			const cTotalRange = cSummary.querySelector("[data-total-range='true']");
			const cTotalMidText = cSummary.querySelector("[data-total-mid='true']");
			const cTotalAccuracy = cSummary.querySelector("[data-total-accuracy='true']");
			const cScoreLabel = cSummary.querySelector("[data-total-score-label='true']");
			const cBar = cSummary.querySelector("[data-total-accuracy-bar='true']");
			const cItemTitle = cSummary.querySelector("[data-summary-item-title='true']");
			const cItemValue = cSummary.querySelector("[data-summary-item-value='true']");
			const cScoreBox = pRoot.querySelector("[data-score='true']");
			const cActivePanel = cPanels.find((pPanel) => pPanel.dataset.costPanel === cActiveId);
			const cActiveResult = cActivePanel ? CalculatePanel(cActivePanel) : null;

			if (cTotalRange) cTotalRange.textContent = `${Money(cTotalLow)} – ${Money(cTotalHigh)} ج`;
			if (cTotalMidText) cTotalMidText.textContent = cStarted.length ? `المتوسط الحالي ${Money(cTotalMid)} ج · البنود غير المبدوءة ما زالت بافتراض واسع` : `تقدير واسع جدًا قبل إدخال البيانات · المتوسط ${Money(cTotalMid)} ج`;
			if (cTotalAccuracy) cTotalAccuracy.textContent = `${cAccuracy}%`;
			if (cScoreLabel) cScoreLabel.textContent = `${cStarted.length} من ${cPanels.length} بنود بدأت`;
			if (cBar) cBar.style.width = `${cAccuracy}%`;
			if (cScoreBox) cScoreBox.textContent = String(cScore);
			if (cItemTitle) cItemTitle.textContent = ActiveTitle(cActivePanel);
			if (cItemValue) cItemValue.textContent = cActiveResult?.started ? `${Money(cActiveResult.mid)} ج · ${cActiveResult.accuracy}%` : "لم يبدأ بعد";
		}

		function ActiveTitle(pPanel) {
			if (!pPanel) return "—";
			return pPanel.querySelector(".CostPanelTitle h3")?.textContent?.trim() || "—";
		}

		function Money(pValue) {
			return Math.round(Number(pValue || 0)).toLocaleString("ar-EG", { maximumFractionDigits: 0 });
		}

		function CssEscape(pValue) {
			if (window.CSS?.escape) return window.CSS.escape(pValue);
			return `${pValue}`.replace(/['\\]/g, "\\$&");
		}
	}
})();
</script>
