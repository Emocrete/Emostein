---
import type { FinishCostItem } from "./FinishCostGame.types";

interface Props {
	pItems: FinishCostItem[];
	pActiveId?: string;
}

const {
	pItems,
	pActiveId = pItems[0]?.Id ?? "",
} = Astro.props as Props;
---

<nav class="FinishCostGameNav" aria-label="بنود حساب تكلفة التشطيب" data-cost-nav="true">
	{pItems.map((pItem, pIndex) => (
		<button
			type="button"
			class:list={["CostNavItem", pItem.Id === pActiveId ? "IsActive" : ""]}
			data-cost-item-target={pItem.Id}
			aria-current={pItem.Id === pActiveId ? "step" : undefined}
			style={`--CostNavAccent:${pItem.Accent};`}
		>
			<span class="CostNavNo">{pIndex + 1}</span>
			<span class="CostNavText">
				<strong>{pItem.ShortTitle}</strong>
				<small data-cost-nav-accuracy={pItem.Id}>0% دقة</small>
			</span>
			<span class="CostNavDone" aria-hidden="true">✓</span>
		</button>
	))}
</nav>

<style>
	.FinishCostGameNav {
		display: flex;
		gap: 10px;
		width: 100%;
		padding: 12px 14px;
		box-sizing: border-box;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		background: #f7f9fc;
		border-block: 1px solid #e2e8f0;
		scrollbar-width: thin;
	}

	.CostNavItem {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(94px, 1fr) auto;
		align-items: center;
		gap: 8px;
		min-width: 170px;
		padding: 9px 11px;
		border: 1px solid #dbe2ea;
		border-radius: 14px;
		background: #fff;
		color: #152033;
		font: inherit;
		text-align: right;
		cursor: pointer;
		scroll-snap-align: start;
		transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
	}

	.CostNavItem:hover {
		transform: translateY(-1px);
		border-color: color-mix(in srgb, var(--CostNavAccent) 58%, #dbe2ea);
	}

	.CostNavItem.IsActive {
		border-color: var(--CostNavAccent);
		box-shadow: 0 8px 24px color-mix(in srgb, var(--CostNavAccent) 14%, transparent);
	}

	.CostNavNo {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--CostNavAccent) 10%, white);
		color: var(--CostNavAccent);
		font-weight: 950;
		font-size: 12px;
	}

	.CostNavText {
		display: grid;
		gap: 2px;
		min-width: 0;
	}

	.CostNavText strong {
		font-size: 13px;
		line-height: 1.35;
		white-space: nowrap;
	}

	.CostNavText small {
		color: #748094;
		font-size: 10px;
		font-weight: 800;
	}

	.CostNavDone {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 999px;
		background: #e8edf3;
		color: #8490a2;
		font-size: 11px;
		font-weight: 950;
	}

	.CostNavItem[data-complete="true"] .CostNavDone {
		background: #def6e8;
		color: #167a48;
	}

	@media (max-width: 680px) {
		.FinishCostGameNav {
			padding-inline: 10px;
		}

		.CostNavItem {
			min-width: 152px;
			grid-template-columns: auto minmax(78px, 1fr) auto;
		}
	}
</style>
