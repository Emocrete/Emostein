---
import type { HTMLAttributes } from "astro/types";
import { Colors, DirectSize, NumPer, Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"div">, PlaceProps {
	/**
	 * Final deadline used by the client countdown.
	 * Use a full ISO value whenever possible, e.g. 2026-11-05T23:59:59+02:00.
	 */
	pDeadline: string | Date;

	/**
	 * Responsive width/height box for the widget.
	 ** DefVal = new DirectSize(new NumPer("1120px", "94%"))
	 */
	pSize?: DirectSize;

	/**
	 * Accent color used for the first card, separators, and live glow.
	 ** DefVal = Colors.Yellow
	 */
	pAccent?: string;

	/**
	 * Main text color.
	 ** DefVal = Colors.WhiteOff
	 */
	pTextColor?: string;

	/**
	 * Optional text shown only after the countdown reaches zero.
	 ** DefVal = ""
	 */
	pExpiredText?: string;
}

const {
	pDeadline,
	pSize = new DirectSize(new NumPer("1120px", "94%")),
	pAccent = Colors.Yellow,
	pTextColor = Colors.WhiteOff,
	pExpiredText = "",

	pLoc,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,


	id: pGivenID = GetWidgetId("EmoCountdown"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cDeadlineIso = pDeadline instanceof Date ? pDeadline.toISOString() : String(pDeadline || "");
const cPlace = new Place(Astro.props as PlaceProps, GetStyleText(pGivenStyle));

const cRootStyle = [
	`--CountdownWidthL:${pSize.WidthL};`,
	`--CountdownWidthP:${pSize.WidthP};`,
	`--CountdownHeightL:${pSize.HeightL};`,
	`--CountdownHeightP:${pSize.HeightP};`,
	`--CountdownAccent:${pAccent};`,
	`--CountdownText:${pTextColor};`,
	cPlace.Style,
].filter(Boolean).join(" ");

const cUnits = [
	{ Key: "months", Label: "شهر" },
	{ Key: "days", Label: "يوم" },
	{ Key: "hours", Label: "ساعة" },
	{ Key: "minutes", Label: "دقيقة" },
	{ Key: "seconds", Label: "ثانية" },
];

function GetStyleText(pStyle: Props["style"]) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---
















<div
	class = {`EmoCountdown ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cRootStyle}
	id={pGivenID}
	data-emo-countdown="true"
	data-deadline={cDeadlineIso}
	data-expired-text={pExpiredText}
	dir="rtl"
	role="timer"
	aria-live="polite"
	aria-label="المدة المتبقية حتى الموعد النهائي"
	{...RemAttr}
>

	<div class = " CountdownRail " aria-hidden="true">

		<span>

		</span>

	</div>

	<div class = " CountdownGrid ">

		{ cUnits.map((cUnit) => (

			<div class = {`CountdownPart ${cUnit.Key === "months" ? "IsMain" : ""}`.trim()} data-countdown-part={cUnit.Key}>

				<strong class = " CountdownValue " data-countdown-value={cUnit.Key}>
					٠٠
				</strong>

				<span class = " CountdownLabel ">
					{cUnit.Label}
				</span>

			</div>

		)) }

	</div>

	{ pExpiredText && (

		<p class = " CountdownExpired " data-countdown-expired="true" hidden>
			{pExpiredText}
		</p>

	) }

</div>
















<style>



	.EmoCountdown {
		width: var(--CountdownWidthL, auto);
		height: var(--CountdownHeightL, auto);
		max-width: 100%;
		box-sizing: border-box;
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: 22px;
		color: var(--CountdownText, #FAFAFA);
		isolation: isolate;
	}

	.EmoCountdown > :global(*) {
		box-sizing: border-box;
	}

	.CountdownRail {
		position: absolute;
		inset: 10px;
		border: 1px solid color-mix(in srgb, var(--CountdownAccent) 55%, transparent);
		border-radius: 28px;
		pointer-events: none;
		overflow: hidden;
		z-index: -1;
		background:
			radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--CountdownAccent) 20%, transparent), transparent 34%),
			linear-gradient(135deg, rgb(255 255 255 / 9%), rgb(255 255 255 / 2%));
		box-shadow:
			0 24px 60px rgb(0 0 0 / 24%),
			inset 0 1px 0 rgb(255 255 255 / 16%);
	}

	.CountdownRail > span {
		position: absolute;
		inset: -35% auto auto -20%;
		width: 42%;
		aspect-ratio: 1;
		border-radius: 999px;
		background: color-mix(in srgb, var(--CountdownAccent) 32%, transparent);
		filter: blur(36px);
		opacity: .65;
		animation: CountdownGlow 8s ease-in-out infinite alternate;
	}

	.CountdownGrid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(5, minmax(110px, 1fr));
		gap: 14px;
	}

	.CountdownPart {
		min-width: 0;
		padding: 18px 12px 16px;
		border-radius: 22px;
		border: 1px solid rgb(255 255 255 / 14%);
		background: rgb(17 17 17 / 48%);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 11%),
			0 10px 28px rgb(0 0 0 / 18%);
		text-align: center;
		backdrop-filter: blur(14px);
	}

	.CountdownPart.IsMain {
		border-color: color-mix(in srgb, var(--CountdownAccent) 62%, transparent);
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--CountdownAccent) 20%, transparent), rgb(17 17 17 / 55%));
	}

	.CountdownValue {
		display: block;
		font-family: Jannat, Cairo, system-ui, sans-serif;
		font-size: clamp(2.1rem, 4.8vw, 4.8rem);
		line-height: 1;
		font-weight: 800;
		letter-spacing: .02em;
		font-variant-numeric: tabular-nums;
		color: var(--CountdownText, #FAFAFA);
		text-shadow: 0 10px 30px rgb(0 0 0 / 32%);
	}

	.CountdownPart.IsMain .CountdownValue {
		color: var(--CountdownAccent);
	}

	.CountdownLabel {
		display: block;
		margin-top: 10px;
		font-size: clamp(.9rem, 1.2vw, 1.1rem);
		line-height: 1.4;
		font-weight: 700;
		color: color-mix(in srgb, var(--CountdownText) 82%, transparent);
	}

	.CountdownExpired {
		margin: 0;
		font-size: clamp(.95rem, 1.5vw, 1.15rem);
		line-height: 1.8;
		font-weight: 700;
		text-align: center;
		color: var(--CountdownAccent);
	}

	.EmoCountdown.IsExpired .CountdownPart {
		opacity: .72;
	}

	@keyframes CountdownGlow {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}

		to {
			transform: translate3d(185%, 110%, 0) scale(1.35);
		}
	}

	@media (orientation: portrait) {

		.EmoCountdown {
			width: var(--CountdownWidthP, var(--CountdownWidthL, auto));
			height: var(--CountdownHeightP, var(--CountdownHeightL, auto));
			padding: 18px 12px;
		}

		.CountdownRail {
			inset: 6px;
			border-radius: 22px;
		}

		.CountdownGrid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px;
		}

		.CountdownPart.IsMain {
			grid-column: 1 / -1;
		}

		.CountdownPart {
			padding: 14px 8px 13px;
			border-radius: 18px;
		}

		.CountdownValue {
			font-size: clamp(2.1rem, 13vw, 4.1rem);
		}

	}

</style>
















<script>
	type CountdownWindow = Window & {
		__EmoCountdownReady?: boolean;
	};

	type CountdownParts = {
		months: number;
		days: number;
		hours: number;
		minutes: number;
		seconds: number;
		isExpired: boolean;
	};

	const cCountdownWindow = window as CountdownWindow;

	if (!cCountdownWindow.__EmoCountdownReady) {
		cCountdownWindow.__EmoCountdownReady = true;
		document.addEventListener("astro:page-load", SetupEmoCountdowns);
		window.addEventListener("load", SetupEmoCountdowns);
		SetupEmoCountdowns();
	}

	function SetupEmoCountdowns(): void {
		const cRoots = document.querySelectorAll<HTMLElement>("[data-emo-countdown='true']:not([data-countdown-ready='true'])");
		cRoots.forEach(SetupEmoCountdown);
	}

	function SetupEmoCountdown(pRoot: HTMLElement): void {
		pRoot.dataset.countdownReady = "true";

		const cDeadlineText = pRoot.dataset.deadline || "";
		const cDeadline = new Date(cDeadlineText);

		if (Number.isNaN(cDeadline.getTime())) {
			pRoot.classList.add("IsInvalid");
			SetCountdownValues(pRoot, GetEmptyParts(true));
			return;
		}

		const cTick = function TickCountdown(): void {
			if (!pRoot.isConnected) return;

			const cParts = GetCountdownParts(new Date(), cDeadline);
			SetCountdownValues(pRoot, cParts);
		};

		cTick();
		const cTimer = window.setInterval(function CountdownInterval(): void {
			if (!pRoot.isConnected) {
				window.clearInterval(cTimer);
				return;
			}

			cTick();
		}, 1000);
	}

	function GetCountdownParts(pNow: Date, pDeadline: Date): CountdownParts {
		if (pDeadline.getTime() <= pNow.getTime()) {
			return GetEmptyParts(true);
		}

		let cMonths = GetWholeMonthDiff(pNow, pDeadline);
		let cAnchor = AddMonths(pNow, cMonths);

		if (cAnchor.getTime() > pDeadline.getTime()) {
			cMonths -= 1;
			cAnchor = AddMonths(pNow, cMonths);
		}

		let cRestMs = pDeadline.getTime() - cAnchor.getTime();
		const cDayMs = 24 * 60 * 60 * 1000;
		const cHourMs = 60 * 60 * 1000;
		const cMinuteMs = 60 * 1000;

		const cDays = Math.floor(cRestMs / cDayMs);
		cRestMs -= cDays * cDayMs;

		const cHours = Math.floor(cRestMs / cHourMs);
		cRestMs -= cHours * cHourMs;

		const cMinutes = Math.floor(cRestMs / cMinuteMs);
		cRestMs -= cMinutes * cMinuteMs;

		const cSeconds = Math.floor(cRestMs / 1000);

		return {
			months: Math.max(0, cMonths),
			days: Math.max(0, cDays),
			hours: Math.max(0, cHours),
			minutes: Math.max(0, cMinutes),
			seconds: Math.max(0, cSeconds),
			isExpired: false,
		};
	}

	function GetWholeMonthDiff(pStart: Date, pEnd: Date): number {
		return ((pEnd.getFullYear() - pStart.getFullYear()) * 12) + (pEnd.getMonth() - pStart.getMonth());
	}

	function AddMonths(pDate: Date, pMonths: number): Date {
		const cYear = pDate.getFullYear();
		const cMonth = pDate.getMonth() + pMonths;
		const cDay = pDate.getDate();
		const cResult = new Date(pDate.getTime());
		const cTargetYear = cYear + Math.floor(cMonth / 12);
		const cTargetMonth = ((cMonth % 12) + 12) % 12;
		const cDaysInTargetMonth = GetDaysInMonth(cTargetYear, cTargetMonth);

		cResult.setFullYear(cTargetYear, cTargetMonth, 1);
		cResult.setDate(Math.min(cDay, cDaysInTargetMonth));

		return cResult;
	}

	function GetDaysInMonth(pYear: number, pMonth: number): number {
		return new Date(pYear, pMonth + 1, 0).getDate();
	}

	function GetEmptyParts(pIsExpired: boolean): CountdownParts {
		return {
			months: 0,
			days: 0,
			hours: 0,
			minutes: 0,
			seconds: 0,
			isExpired: pIsExpired,
		};
	}

	function SetCountdownValues(pRoot: HTMLElement, pParts: CountdownParts): void {
		SetCountdownValue(pRoot, "months", pParts.months);
		SetCountdownValue(pRoot, "days", pParts.days);
		SetCountdownValue(pRoot, "hours", pParts.hours);
		SetCountdownValue(pRoot, "minutes", pParts.minutes);
		SetCountdownValue(pRoot, "seconds", pParts.seconds);

		pRoot.classList.toggle("IsExpired", pParts.isExpired);
		pRoot.setAttribute("aria-label", GetAriaLabel(pParts));

		const cExpiredText = pRoot.querySelector<HTMLElement>("[data-countdown-expired='true']");
		if (cExpiredText) {
			cExpiredText.hidden = !pParts.isExpired;
		}
	}

	function SetCountdownValue(pRoot: HTMLElement, pKey: keyof Omit<CountdownParts, "isExpired">, pValue: number): void {
		const cValue = pRoot.querySelector<HTMLElement>(`[data-countdown-value='${pKey}']`);
		if (!cValue) return;

		cValue.textContent = FormatNumber(pValue);
	}

	function FormatNumber(pValue: number): string {
		return new Intl.NumberFormat("ar-EG", {
			minimumIntegerDigits: 2,
			maximumFractionDigits: 0,
		}).format(Math.max(0, pValue));
	}

	function GetAriaLabel(pParts: CountdownParts): string {
		if (pParts.isExpired) return "انتهت المدة المحددة";

		return `المدة المتبقية ${pParts.months} شهر و ${pParts.days} يوم و ${pParts.hours} ساعة و ${pParts.minutes} دقيقة و ${pParts.seconds} ثانية`;
	}
</script>
