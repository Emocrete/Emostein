		border-radius: 999px;
		background-color: #25D366;
		color: #ffffff;
		font-size: 15px;
		font-weight: 800;
		text-decoration: none;
	}



	.WhatsBtn.noIcon .BtnText {
		width: 100%;
	}


	.WhatsBtn.IsPlaced {
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		min-height: var(--PlaceHeightL);
	}


	.WhatsBtn.isIconLeft {
		flex-direction: row-reverse;
	}


	.WhatsBtn.isIconTop {
		flex-direction: column;
	}


	.WhatsBtn.isIconBottom {
		flex-direction: column-reverse;
	}



	.WhatsBtn.hasIcon.isIconRight .BtnIcon {
		right: 20px;
	}

	.WhatsBtn.hasIcon.isIconRight .BtnText {
		margin-right: calc(15px + var(--btn-icon-size) + 8px);
		padding-left: 15px;
	}


	.WhatsBtn.hasIcon.isIconLeft .BtnIcon {
		left: 20px;
	}

	.WhatsBtn.hasIcon.isIconLeft .BtnText {
		padding-left: calc(15px + var(--btn-icon-size) + 8px);
		padding-right: 15px;
	}



	.WhatsBtn.hasIcon.isIconRight .BtnIcon,
	.WhatsBtn.hasIcon.isIconLeft .BtnIcon
	{
		position: absolute;
	}


	.WhatsBtn.hasIcon.isIconTop,
	.WhatsBtn.hasIcon.isIconBottom
	{
		gap: 5px;
	}


	.WhatsBtn.hasIcon.isIconTop .BtnText,
	.WhatsBtn.hasIcon.isIconBottom .BtnText
	{
		padding: 0;
	}



</style>





<style>



	@media (hover: hover) and (pointer: fine) {
		.WhatsBtn:hover .BtnTextNormal {
			display: none;
		}

		.WhatsBtn:hover .BtnTextPhone {
			display: block;
		}
	}



	@media (orientation: portrait) {
		.WhatsBtn.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
			min-height: var(--PlaceHeightP);
		}
	}



</style>





<script>
	const cWhatsButtons = document.querySelectorAll<HTMLElement>("[data-whats-btn='true']");

	cWhatsButtons.forEach(SetupWhatsButton);

	window.addEventListener("keydown", HandleWindowKeyDown);

	function SetupWhatsButton(pButton: HTMLElement): void {
	if (pButton.dataset.whatsReady === "true") return;

	const cOverlay = pButton.nextElementSibling;

	if (!(cOverlay instanceof HTMLElement)) return;
	if (cOverlay.dataset.whatsOverlay !== "true") return;

	MoveOverlayToBody(cOverlay);
	pButton.dataset.whatsReady = "true";

	pButton.addEventListener("click", function HandleWhatsButtonClick(pEvent: MouseEvent): void {
	if (IsMobileDevice()) return;

	pEvent.preventDefault();
	ShowWhatsOverlay(cOverlay);
	});

	cOverlay.addEventListener("click", function HandleWhatsOverlayClick(pEvent: MouseEvent): void {
	const cTarget = pEvent.target;

	if (!(cTarget instanceof Element)) return;

	if (cTarget === cOverlay || cTarget.closest("[data-whats-close='true']")) {
	HideWhatsOverlay(cOverlay);
	}
	});
	}

	function MoveOverlayToBody(pOverlay: HTMLElement): void {
	if (pOverlay.parentElement === document.body) return;

	document.body.appendChild(pOverlay);
	}

	function HandleWindowKeyDown(pEvent: KeyboardEvent): void {
	if (pEvent.key !== "Escape") return;

	document
	.querySelectorAll<HTMLElement>("[data-whats-overlay='true']:popover-open")
	.forEach(HideWhatsOverlay);
	}

	type PopoverElement = HTMLElement & {
	showPopover?: () => void;
	hidePopover?: () => void;
	};

	function ShowWhatsOverlay(pOverlay: HTMLElement): void {
	const cOverlay = pOverlay as PopoverElement;

	if (typeof cOverlay.showPopover !== "function") {
	cOverlay.style.display = "flex";
	return;
	}

	if (cOverlay.matches(":popover-open")) return;

	cOverlay.showPopover();
	}

	function HideWhatsOverlay(pOverlay: HTMLElement): void {
	const cOverlay = pOverlay as PopoverElement;

	if (typeof cOverlay.hidePopover !== "function") {
	cOverlay.style.display = "none";
	return;
	}

	if (!cOverlay.matches(":popover-open")) return;

	cOverlay.hidePopover();
	}

	function IsMobileDevice(): boolean {
	const cNavigator = navigator as Navigator & {
	userAgentData?: {
	mobile?: boolean;
	};
	};

	const cUserAgent = navigator.userAgent || "";
	const cByUserAgentData = cNavigator.userAgentData?.mobile === true;
	const cByUserAgent = /Android|iPhone|iPad|iPod|IEMobile|Opera Mini|Mobile/i.test(cUserAgent);

	return cByUserAgentData || cByUserAgent;
	}
</script>
