---
import { Media } from "@/Media";
import { Colors, HoverColors, HoverImg, Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import { type ButtonColorPreset, type ButtonPresetProps, CreateButtonPreset, GetBoolAttr, GetButtonPreset, GetButtonTitleColors } from "./ButtonPresets";

export interface Props extends HTMLAttributes<"a">, PlaceProps, ButtonPresetProps {
	/** النص الظاهر داخل زر الواتساب. */
	pText?: string;

	/** رقم الواتساب بصيغة محلية أو دولية. */
	pPhone?: string;

	/** رسالة جاهزة اختيارية تفتح داخل محادثة واتساب. */
	pMessage?: string;

	/** صورة QR مخصصة عند الحاجة. الافتراضي مدمج للرقم الأساسي. */
	pQrImg?: string;

	/** Preset واتساب أخضر. */
	Green?: boolean;

	/** Preset واتساب أخضر داكن. */
	GreenDark?: boolean;

	/** Preset سماوي قديم للتوافق. */
	Sky?: boolean;

	/** Preset بيستاج قديم للتوافق. */
	Bistage?: boolean;

	/** صور الأيقونة في الحالات الثلاث: Normal / Hover / Click. */
	pIconImgs?: HoverImg;

	/** مكان الأيقونة داخل الزر. */
	pIconPos?: "right" | "left" | "top" | "bottom";

	pWidth?: string;
	pHeight?: string;
	pRadius?: string;

	/** ألوان خلفية الزر في الحالات الثلاث: Normal / Hover / Click. */
	pBgColors?: HoverColors;

	/** صور خلفية الزر في الحالات الثلاث: Normal / Hover / Click. */
	pBgImgs?: HoverImg;

	/** ألوان عنوان الزر في الحالات الثلاث: Normal / Hover / Click. */
	pTitleColors?: HoverColors;

	pFontSize?: string;

	/** Lets button keep its internal width inside Stack / Strip instead of being stretched. */
	"data-own-size"?: boolean | string;
}

const cDefaultPhoneText = "01014490054";
const cDefaultWhatsappQrSvg = `<?xml version='1.0' encoding='UTF-8'?>
