const cDefaultWhatsappQrImg = `data:image/svg+xml;utf8,${encodeURIComponent(cDefaultWhatsappQrSvg)}`;

const {
	pText,
	pPhone = cDefaultPhoneText,
	pMessage = "",
	pQrImg,
	Black = false,
	BlackOrange = false,
	BlackSky = false,
	BlackGreen = false,
	BlackBistage = false,
	BlackRed = false,
	SkyBlack = false,
	SkyBistage = false,
	BistageBlack = false,
	BistageSky = false,
	BistageOrange = false,
	OrangeBlack = false,
	OrangeSky = false,
	GreenBlack = false,
	GreenSky = false,
	GrayBlack = false,
	GrayOrange = false,
	CreamyBlack = false,
	YellowBlack = false,
	RedBlack = false,
	WhiteBlack = false,
	Green = false,
	GreenDark = false,
	Sky = false,
	Bistage = false,
	pIconImgs,
	pIconPos = "right",

	pWidth = "250px",
	pHeight = "50px",
	pRadius = "5px",

	pBgColors,
	pBgImgs,

	pTitleColors,
	pFontSize = "18px",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	"data-own-size": pOwnSizeValue = true,
	id: pId = GetWidgetId("EmoWhats"),
	class: pClass = "",
	style: pStyle = "",
	target: pTarget = "_blank",
	rel: pRel,
	...cAttrs
} = Astro.props as Props;

const cWhatsappPresets: Record<string, ButtonColorPreset> = {
	Green: CreateButtonPreset("#25d467", "#7d7d7d"),
	GreenDark: CreateButtonPreset("#128C7E", "#075E54"),
	Sky: CreateButtonPreset(Colors.Sky, Colors.SkyDark),
	Bistage: CreateButtonPreset(Colors.Bistage, Colors.BistageDark),
};

const cPreset = GetPreset();
const cText = pText ?? "ابدأ محادثة";
const cPhoneText = pPhone;
const cWhatsappNumber = GetWhatsappNumber(pPhone);
const cWhatsappHref = GetWhatsappHref(cWhatsappNumber, pMessage);
const cQrImg = Media.GetPageFile(Astro.url.href, pQrImg ?? cDefaultWhatsappQrImg);
const cTarget = pTarget ?? "_blank";
const cRel = pRel ?? (cTarget === "_blank" ? "noopener noreferrer" : undefined);
const cLayoutClass = GetLayoutClass(pIconPos);
const cIconSize = `calc(${pHeight} - 5px)`;
const cOwnSize = GetBoolAttr(pOwnSizeValue, true);

const cBgColors = pBgColors ?? cPreset?.BgColors ?? cWhatsappPresets.Green.BgColors;
const cTitleColors = pTitleColors ?? cPreset?.TitleColors ?? GetButtonTitleColors(cBgColors);
const cIconImgs = pIconImgs ?? new HoverImg("");
const cBgImgs = pBgImgs ?? new HoverImg("");

const cBgImgNormal = BuildCssUrl(Media.GetPageFile(Astro.url.href, cBgImgs.Normal));
const cBgImgHover = BuildCssUrl(Media.GetPageFile(Astro.url.href, cBgImgs.Hover));
const cBgImgActive = BuildCssUrl(Media.GetPageFile(Astro.url.href, cBgImgs.Click));

const cIconNormal = BuildCssUrl(Media.GetPageFile(Astro.url.href, cIconImgs.Normal));
const cIconHover = BuildCssUrl(Media.GetPageFile(Astro.url.href, cIconImgs.Hover));
const cIconActive = BuildCssUrl(Media.GetPageFile(Astro.url.href, cIconImgs.Click));

const cHasIcon = Boolean(cIconImgs.Normal);

const cStyle = [
	`--Width:${pWidth};`,
	`--Height:${pHeight};`,
	`--Radius:${pRadius};`,

	`--BgClr:${cBgColors.Normal};`,
	`--BgClr-hover:${cBgColors.Hover};`,
	`--BgClr-active:${cBgColors.Click};`,

	`--BgImg:${cBgImgNormal};`,
	`--BgImg-hover:${cBgImgHover};`,
	`--BgImg-active:${cBgImgActive};`,

	`--TitleCrl:${cTitleColors.Normal};`,
	`--TitleCrl-hover:${cTitleColors.Hover};`,
	`--TitleCrl-active:${cTitleColors.Click};`,
	`--TitleSize:${pFontSize};`,

	`--btn-icon-size:${cIconSize};`,
	`--IconNormal:${cIconNormal};`,
	`--btn-icon-hover:${cIconHover};`,
	`--btn-icon-active:${cIconActive};`,

	GetStyleText(pStyle),
].filter(Boolean).join("\n");

const cPlace = new Place(Astro.props as PlaceProps, cStyle);

function GetPreset() {
	if (GreenDark) return cWhatsappPresets.GreenDark;
	if (Green) return cWhatsappPresets.Green;
	if (Sky) return cWhatsappPresets.Sky;
	if (Bistage) return cWhatsappPresets.Bistage;

	return GetButtonPreset({
		Black,
		BlackOrange,
		BlackSky,
		BlackGreen,
		BlackBistage,
		BlackRed,
		SkyBlack,
		SkyBistage,
		BistageBlack,
		BistageSky,
		BistageOrange,
		OrangeBlack,
		OrangeSky,
		GreenBlack,
		GreenSky,
		GrayBlack,
		GrayOrange,
		CreamyBlack,
		YellowBlack,
		RedBlack,
		WhiteBlack,
	});
}

function GetWhatsappNumber(pValue: string): string {
	const cDigits = pValue.replace(/\D/g, "");

	if (cDigits.startsWith("20")) return cDigits;
	if (cDigits.startsWith("0")) return `2${cDigits}`;

	return cDigits;
}

function GetWhatsappHref(pNumber: string, pMessage: string): string {
	const cBaseHref = `https://wa.me/${pNumber}`;
	const cMessage = pMessage.trim();

	if (!cMessage) return cBaseHref;

	return `${cBaseHref}?text=${encodeURIComponent(cMessage)}`;
}

function BuildCssUrl(pValue?: string) {
	return pValue ? `url("${pValue}")` : "none";
}

function GetLayoutClass(pValue: "right" | "left" | "top" | "bottom") {
	if (pValue === "left") return "isIconLeft";
	if (pValue === "top") return "isIconTop";
	if (pValue === "bottom") return "isIconBottom";
	return "isIconRight";
}

function GetStyleText(pStyle: Props["style"]) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---





<a
	class = {`WhatsBtn ${cLayoutClass} ${cHasIcon ? "hasIcon" : "noIcon"} ${cPlace.Class} ${pClass}`.trim()}
	style = {cPlace.Style}
	id={pId}
	href={cWhatsappHref}
	target={cTarget}
	rel={cRel}
	data-whats-btn="true"
	data-ops-event="whatsapp_click"
	data-ops-notify="true"
	data-ops-sound="true"
	data-ops-important="true"
	data-own-size={cOwnSize ? "true" : undefined}
	{...cAttrs}
>

	{ cHasIcon && ( <span class = " BtnIcon " /> ) }

	{ cText && (

		<span class = " BtnText BtnTextNormal ">
			{cText}
		</span>
	) }

	<span class = " BtnText BtnTextPhone ">
		{cPhoneText}
	</span>







</a>

<span class = " WhatsQrOverlay " data-whats-overlay="true" popover="manual">







	<span class = " WhatsQrBox ">

		<button class = " WhatsQrClose " type="button" data-whats-close="true">

			إغلاق

		</button>

		<span class = " WhatsQrTitle ">
			امسح الكود لفتح محادثة واتساب من هاتفك
		</span>

		<img
			class = " WhatsQrImg "
			src={cQrImg}
			alt="QR Code لفتح واتساب المجموعة الهندسية"
			loading="lazy"
			decoding="async"
		/>

		<span class = " WhatsQrPhone ">
			{cPhoneText}
		</span>

		<a
			class = " WhatsQrWebLink "
			href={cWhatsappHref}
			data-ops-event="whatsapp_click"
			data-ops-notify="true"
			data-ops-sound="true"
			data-ops-important="true"
			target="_blank"
			rel="noopener noreferrer"
		>
			فتح واتساب ويب
		</a>

	</span>







</span>





<style>



	.WhatsBtn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--Width);
		height: var(--Height);
		min-height: var(--Height);
		border-radius: var(--Radius);
		background-color: var(--BgClr);
		background-image: var(--BgImg);
		background-repeat: no-repeat;
		font-family: inherit;
		cursor: pointer;
		position: relative;
		appearance: none;
		border: 0;
		text-decoration: none;
		box-sizing: border-box;
		transition: background-color 0.1s ease,
			border-color 0.1s ease,
			box-shadow 0.1s ease,
			color 0.1s ease,
			transform 0.1s ease;
	}

	.WhatsBtn:hover {
		background-color: var(--BgClr-hover);
		background-image: var(--BgImg-hover);
		color: var(--TitleCrl-hover);
	}

	.WhatsBtn:active {
		background-color: var(--BgClr-active);
		background-image: var(--BgImg-active);
		color: var(--TitleCrl-active);
		transform: scale(0.985);
	}

	.WhatsBtn:hover .BtnText {
		color: var(--TitleCrl-hover);
	}

	.WhatsBtn:active .BtnText {
		color: var(--TitleCrl-active);
	}

	.WhatsBtn:hover .BtnIcon {
		background-image: var(--btn-icon-hover);
	}

	.WhatsBtn:active .BtnIcon {
		background-image: var(--btn-icon-active);
	}


	.BtnIcon {
		flex: 0 0 auto;
		width: var(--btn-icon-size);
		height: var(--btn-icon-size);
		background-image: var(--IconNormal);
		background-position: center;
		background-repeat: no-repeat;
		background-size: contain;
	}


	.BtnText {
		display: block;
		line-height: 1.2;
		white-space: nowrap;
		color: var(--TitleCrl);
		font-size: var(--TitleSize);
		font-weight: 700;
		text-align: center;
		text-decoration: none;
	}


	.BtnTextPhone {
		display: none;
		direction: ltr;
	}


	.WhatsQrOverlay {
		position: fixed;
		inset: 0;
		z-index: 2147483647;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 20px;
		border: 0;
		background-color: rgba(0, 0, 0, 0.65);
		box-sizing: border-box;
		align-items: center;
		justify-content: center;
		overflow: auto;
		overscroll-behavior: contain;
	}

	.WhatsQrOverlay:popover-open {
		display: flex;
	}

	.WhatsQrOverlay:not(:popover-open) {
		display: none;
	}

	.WhatsQrOverlay::backdrop {
		background: transparent;
	}


	.WhatsQrBox {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(450px, 100%);
		padding: 22px;
		border-radius: 18px;
		background-color: #ffffff;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
		text-align: center;
		direction: rtl;
		box-sizing: border-box;
	}


	.WhatsQrClose {
		align-self: flex-start;
		border: 0;
		border-radius: 999px;
		padding: 7px 14px;
		background-color: #222222;
		color: #ffffff;
		font-family: inherit;
		font-size: 14px;
		font-weight: 700;
		cursor: pointer;
	}


	.WhatsQrTitle {
		margin-top: 14px;
		color: #222222;
		font-size: 19px;
		font-weight: 800;
		line-height: 1.45;
	}


	.WhatsQrImg {
		display: block;
		width: 260px;
		max-width: 100%;
		height: auto;
		margin-top: 18px;
		border-radius: 12px;
	}


	.WhatsQrPhone {
		margin-top: 14px;
