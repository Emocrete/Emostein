---
import { Colors } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> , DebugOutlineProps {
	pMaxResults?: number;
}

const {
	pMaxResults = 12,
	id: pGivenID = GetWidgetId("SiteSearch404"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cStyle = [
	`--SearchSky:${Colors.SkyLite};`,
	`--SearchSkyDark:${Colors.SkyDark};`,
	`--SearchBistage:${Colors.Bistage};`,
	`--SearchBistageDark:${Colors.BistageDark};`,
	`--SearchBlack:${Colors.BlackOff};`,
	`--SearchWhite:${Colors.WhiteOff};`,
	pGivenStyle,
].filter(Boolean).join(" ");
---




















<section
	class = {`SiteSearch404 ${pGivenClass}`.trim()}
	style = {cStyle}
	id={pGivenID}
	data-site-search-404
	data-max-results={pMaxResults}
	{...RemAttr}
>

	<div
		class = " SearchPanel "
		role="search"
		aria-label="بحث داخل صفحات الموقع"
	>

		<label class = " SearchLabel " for="SiteSearchInput">

			ابحث داخل صفحات الموقع

		</label>

		<div class = " SearchBox ">

			<input
				class = " SearchInput "
				id="SiteSearchInput"
				name="q"
				type="search"
				autocomplete="off"
				placeholder="مثال: ترخيص محل، رسم صيدلية، ختم مهندس، تقرير سلامة"
				data-site-search-input
			/>

			<button
				class = " SearchButton "
				type="button"
				data-site-search-button
			>

				بحث

			</button>

		</div>

	</div>

	<output
		class = " SearchStatus "
		data-site-search-status
		aria-live="polite"
	>

		جاري تجهيز البحث في صفحات الموقع المنشورة...

	</output>

	<ol class = " SearchResults " data-site-search-results>

	</ol>

</section>




















<style is:global>



