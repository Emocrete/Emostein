---
import { Colors, EmoMediaData, NumPer, Pixel, Place, type PlaceProps, Size, Text } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import Emograph from "./Emograph.astro";
import RespImg from "../Media/RespImage.astro";

type TBadgeTextPos = "Right" | "Left" | "Top" | "Bottom";
type TBadgeNumberView = "Split" | "Inline";
type TBadgeImg = EmoMediaData | string;

interface BadgeData {
	Number?: string | number;
	Text: string;
	Img: EmoMediaData;
}

interface Props extends DebugOutlineProps, HTMLAttributes<"div">, PlaceProps {
	pYears?: string | number;
	pYearsText?: string;
	pYearsImg?: TBadgeImg;

	pWorks?: string | number;
	pWorksText?: string;
	pWorksImg?: TBadgeImg;

	pDuration?: string | number;
	pDurationText?: string;
	pDurationImg?: TBadgeImg;

	pQualityText?: string;
	pQualityImg?: TBadgeImg;

	pScopeText?: string;
	pScopeImg?: TBadgeImg;

	pTextPos?: TBadgeTextPos;
	pNumberView?: TBadgeNumberView;
	pNumSize?: Pixel;
	pTextSize?: Pixel;
	pImgTextGap?: Pixel;
	pNumTextGap?: Pixel;
	pItemGap?: Pixel;
	pImgSize?: Size;
	pUseBg?: boolean;
	pBgColor?: string;
	pPad?: Pixel;
	pWidth?: Pixel;
	pColor?: string;
	pMobMaxCols?: number;
}

const cProps = Astro.props as Props & Record<string, unknown>;
const cHasExplicitScopeText = Object.prototype.hasOwnProperty.call(cProps, "pScopeText");

const {
	pYears,
	pYearsText = "سنوات خبرة",
	pYearsImg,

	pWorks,
	pWorksText = "مشروع",
	pWorksImg,

	pDuration,
	pDurationText = "ساعة",
	pDurationImg,

	pQualityText,
	pQualityImg,

	pScopeText: pScopeTextRaw,
	pScopeImg,

	pTextPos = "Left",
	pNumberView = "Split",
	pNumSize = new Pixel(40, 20),
	pTextSize = new Pixel(18, 14),
	pImgTextGap = new Pixel(10, 10),
	pNumTextGap = new Pixel(0, 0),
	pItemGap = new Pixel(30, 10),
	pImgSize = new Size(new NumPer(100, 50), new NumPer(100, 50)),
	pUseBg = false,
	pBgColor = Colors.WhiteOff,
	pPad = new Pixel(0, 0),
	pWidth,
	pColor = Colors.BlackOff,
	pMobMaxCols = 2,

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("Badge"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

const cGivenStyle = GetStyleText(pGivenStyle);
const cHasPrimaryBadge = HasValue(pYears) || HasValue(pWorks) || HasValue(pDuration) || HasValue(pQualityText);
const pScopeText = cHasExplicitScopeText ? String(pScopeTextRaw ?? "") : cHasPrimaryBadge ? "" : "القاهرة والجيزة";

const cBadges = GetBadges();
const cTextFirst = pTextPos === "Right" || pTextPos === "Top";
const cNumFont = Text.Body.WithSize(pNumSize).WithColor(pColor).Centered;
const cTextFont = Text.Body.WithSize(pTextSize).WithColor(pColor).Centered;
const cMobCols = Math.max(1, Math.min(6, Number(pMobMaxCols) || 2, cBadges.length || 1));
const cTextPosClass = `Text${pTextPos}`;
const cNumViewClass = `Number${pNumberView}`;

const cCssVars = `
--BadgeWidthL:${pWidth?.Landscape ?? "fit-content"};
--BadgeWidthP:${pWidth?.Portrait ?? pWidth?.Landscape ?? "100%"};
--BadgePadL:${pPad.Landscape};
--BadgePadP:${pPad.Portrait};
--BadgeItemGapL:${pItemGap.Landscape};
--BadgeItemGapP:${pItemGap.Portrait};
--BadgeImgTextGapL:${pImgTextGap.Landscape};
--BadgeImgTextGapP:${pImgTextGap.Portrait};
--BadgeNumTextGapL:${pNumTextGap.Landscape};
--BadgeNumTextGapP:${pNumTextGap.Portrait};
--BadgeNumSizeL:${pNumSize.Landscape};
--BadgeNumSizeP:${pNumSize.Portrait};
--BadgeTextSizeL:${pTextSize.Landscape};
--BadgeTextSizeP:${pTextSize.Portrait};
--BadgeColor:${pColor};
--BadgeBg:${pUseBg ? pBgColor : "transparent"};
--BadgeMobCols:${cMobCols};
${cGivenStyle}
`;

const cPlace = new Place(Astro.props as PlaceProps, cCssVars);

function GetBadges(): BadgeData[] {
	const cItems: BadgeData[] = [];

	if (HasValue(pYears)) {
		cItems.push({
			Number: pYears,
			Text: pYearsText,
			Img: GetImg(pYearsImg, "ExperienceIconGold.webp", "سنوات خبرة هندسية"),
		});
	}

	if (HasValue(pWorks)) {
		cItems.push({
			Number: pWorks,
			Text: pWorksText,
			Img: GetImg(pWorksImg, "TrustedIcon.webp", "سابقة أعمال هندسية"),
		});
	}

	if (HasValue(pDuration)) {
		cItems.push({
			Number: pDuration,
			Text: pDurationText,
			Img: GetImg(pDurationImg, "Hours24Icon.webp", "مدة تنفيذ الخدمة"),
		});
	}

	if (HasValue(pQualityText)) {
		cItems.push({
			Text: pQualityText as string,
			Img: GetImg(pQualityImg, "QualityIcon.webp", "جودة الخدمة الهندسية"),
		});
	}

	if (HasValue(pScopeText)) {
		cItems.push({
			Text: pScopeText,
			Img: GetImg(pScopeImg, "LocationIcon.webp", "النطاق الجغرافي للخدمة"),
		});
	}

	return cItems;
}

function HasValue(pValue: unknown): boolean {
	return pValue !== undefined && pValue !== null && String(pValue).trim() !== "";
}

function GetImg(pImg: TBadgeImg | undefined, pDefaultFile: string, pAlt: string): EmoMediaData {
	if (pImg instanceof EmoMediaData) {
		return pImg;
	}

	if (typeof pImg === "string" && pImg.trim() !== "") {
		return {
			Type: "Img",
			LinkL: pImg,
			LinkP: pImg,
			Alt: pAlt,
			Size: pImgSize,
		} as EmoMediaData;
	}

	return new EmoMediaData("Img", "/Media/", pDefaultFile, false, pAlt, pImgSize);
}

function GetStyleText(pStyle: unknown): string {
	if (typeof pStyle === "string") return pStyle;
	if (!pStyle || typeof pStyle !== "object") return "";

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join("\n");
}

function GetCssName(pName: string): string {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---

<div
	class={`Badge ${cPlace.Class} ${cTextPosClass} ${cNumViewClass} ${pGivenClass}`.trim()}
	style={cPlace.Style}
	id={pGivenID}
	data-badge-cols={cMobCols}
	{...RemAttr}
>
	<div class="BadgeList">
		{cBadges.map((cBadge) => (
			<div class="BadgeItem" data-badge-item="true">
				{cTextFirst && (
					cBadge.Number !== undefined ? (
						pNumberView === "Split" ? (
							<div class="BadgeTextBlock">
								<Emograph pTitle={cNumFont.OfText(String(cBadge.Number))} />
								<Emograph pTitle={cTextFont.OfText(cBadge.Text)} />
							</div>
						) : (
							<p class="BadgeInlineText">
								<span class="BadgeInlineNum">{cBadge.Number}</span>
								<span class="BadgeInlineDesc">{cBadge.Text}</span>
							</p>
						)
					) : (
						<Emograph pTitle={cTextFont.OfText(cBadge.Text)} />
					)
				)}

				<RespImg class="BadgeImg" pImg={cBadge.Img} />

				{!cTextFirst && (
					cBadge.Number !== undefined ? (
						pNumberView === "Split" ? (
							<div class="BadgeTextBlock">
								<Emograph pTitle={cNumFont.OfText(String(cBadge.Number))} />
								<Emograph pTitle={cTextFont.OfText(cBadge.Text)} />
							</div>
						) : (
							<p class="BadgeInlineText">
								<span class="BadgeInlineNum">{cBadge.Number}</span>
								<span class="BadgeInlineDesc">{cBadge.Text}</span>
							</p>
						)
					) : (
						<Emograph pTitle={cTextFont.OfText(cBadge.Text)} />
					)
				)}
			</div>
		))}
	</div>
</div>

<style>
	.Badge {
		position: relative;
		display: block;
		box-sizing: border-box;
		width: var(--BadgeWidthL, fit-content);
		max-width: 100%;
		padding: var(--BadgePadL, 0px);
		background-color: var(--BadgeBg, transparent);
		color: var(--BadgeColor, currentColor);
	}

	.Badge.PlaceSized {
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}

	.Badge.IsPlaced {
		position: absolute;
	}

	.BadgeList {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--BadgeItemGapL, 0px);
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		direction: rtl;
	}

	.BadgeItem {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: var(--BadgeImgTextGapL, 0px);
		box-sizing: border-box;
		min-width: 0;
		max-width: 100%;
		text-align: center;
		color: var(--BadgeColor, currentColor);
	}

	.Badge.TextTop .BadgeItem,
	.Badge.TextBottom .BadgeItem {
		flex-direction: column;
	}

	.BadgeTextBlock {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--BadgeNumTextGapL, 0px);
		min-width: 0;
		max-width: 100%;
		text-align: center;
	}

	.BadgeInlineText {
		margin: 0;
		display: inline-flex;
		align-items: baseline;
		justify-content: center;
		gap: var(--BadgeNumTextGapL, 0px);
		max-width: 100%;
		color: var(--BadgeColor, currentColor);
		line-height: 1.35;
		text-align: center;
		white-space: normal;
	}

	.BadgeInlineNum {
		font-size: var(--BadgeNumSizeL);
		font-weight: 700;
		line-height: 1;
	}

	.BadgeInlineDesc {
		font-size: var(--BadgeTextSizeL);
		line-height: 1.25;
	}

	.Badge :global(.BadgeImg.RespImg) {
		flex: 0 0 auto;
		max-width: 100%;
	}

	.Badge :global(.Emograph) {
		width: max-content;
		max-width: 100%;
	}

	@media (orientation: portrait) {
		.Badge {
			width: var(--BadgeWidthP, 100%);
			padding: var(--BadgePadP, 0px);
		}

		.Badge.PlaceSized {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}

		.BadgeList {
			display: grid;
			grid-template-columns: repeat(var(--BadgeMobCols, 1), minmax(0, 1fr));
			align-items: stretch;
			justify-items: stretch;
			gap: var(--BadgeItemGapP, 0px);
		}

		.BadgeItem {
			flex-direction: column;
			width: 100%;
			gap: var(--BadgeImgTextGapP, 0px);
			align-items: center;
			justify-content: flex-start;
		}

		.BadgeTextBlock {
			gap: var(--BadgeNumTextGapP, 0px);
		}

		.BadgeInlineText {
			gap: var(--BadgeNumTextGapP, 0px);
		}

		.BadgeInlineNum {
			font-size: var(--BadgeNumSizeP);
		}

		.BadgeInlineDesc {
			font-size: var(--BadgeTextSizeP);
		}
	}
</style>
