---
import { NumPer, Place, type PlaceProps, Size, Text } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"article">, PlaceProps {
	pCaption?: Text;
	pStart?: Text;
	pPrice?: string | number;
	pPriceFnt?: Text;
	pCurrency?: Text;
	"data-own-size"?: boolean | string;
}

const cProps = Astro.props as Props & Record<string, unknown>;
const {
	pCaption = Text.H6.OfSize(17, 12).Bold.OfText("تقرير معتمد من مهندس استشاري ونقابة المهندسين"),
	pStart = Text.H3.OfSize(28, 20).Bold.OfText("يبدأ من"),
	pPrice = 3000,
	pPriceFnt = Text.H3.OfSize(31, 22).Bold,
	pCurrency = Text.H3.OfSize(24, 18).Bold.OfText("جنيه"),
	pSize = new Size(new NumPer(448, 320), new NumPer(170, 121)),
	pLoc,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
	id: pGivenID = GetWidgetId("PriceCard4"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	"data-own-size": pOwnSize = false,
	...RemAttr
} = cProps;

const cOwnSize = pOwnSize === true || pOwnSize === "" || pOwnSize === "true";
const cStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cPlace = new Place({
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
} as PlaceProps, cStyle);
---

<article class={`PriceCard4 ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} data-own-size={cOwnSize ? "true" : undefined} {...RemAttr}>
<svg viewBox="0 0 448 170" role="img" aria-label={`${pCaption.text ?? ""} — ${pStart.text ?? ""} ${pPrice} ${pCurrency.text ?? ""}`}>
<defs><linearGradient id={`${pGivenID}_pur4`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7f428b"/><stop offset="1" stop-color="#673174"/></linearGradient><filter id={`${pGivenID}_sh4`} x="-20%" y="-20%" width="140%" height="160%"><feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#33203a" flood-opacity=".22"/></filter></defs>
<rect x="1" y="1" width="446" height="167" rx="15" fill="#fff" filter={`url(#${pGivenID}_sh4)`}/>
<path d="M16 1h99v167H16Q1 168 1 153V16Q1 1 16 1Z" fill={`url(#${pGivenID}_pur4)`}/>
<path d="M404 1h28v33l-14-9-14 9Z" fill="#6b2c78"/>
<g transform="translate(30 48)" fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round"><path d="M8 2h29l13 13v56H8z"/><path d="M37 2v15h13"/><path d="M16 28h25M16 38h25M16 48h19"/></g>
<foreignObject x="139" y="10" width="252" height="62"><div xmlns="http://www.w3.org/1999/xhtml" class="Caption" style={`${pCaption.GetStyle()} color:#692d75; line-height:1.45;`}>{pCaption.text}</div></foreignObject>
<line x1="138" y1="83" x2="394" y2="83" stroke="#8c4a96" stroke-width="1" stroke-dasharray="2 2"/>
<foreignObject x="133" y="99" width="284" height="54"><div xmlns="http://www.w3.org/1999/xhtml" class="PriceLine"><span class="Start" style={pStart.GetStyle()}>{pStart.text}</span><span class="Price" dir="ltr" style={`${pPriceFnt.GetStyle()} color:#7e3c88;`}>{pPrice}</span><span class="Currency" style={pCurrency.GetStyle()}>{pCurrency.text}</span></div></foreignObject>
</svg></article>

<style>
	.PriceCard4 { position: relative; display: block; width: 448px; height: 170px; max-width: 100%; direction: rtl; box-sizing: border-box; overflow: visible; --TextSize: var(--TextSizeL); }
	.PriceCard4 > svg { display: block; width: 100%; height: 100%; overflow: visible; }
	.PriceCard4 .Caption { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; direction: rtl; font-family: inherit; white-space: normal; overflow: hidden; }
	.PriceCard4 .PriceLine { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; direction: rtl; font-family: inherit; white-space: nowrap; }
	.PriceCard4 .Start { color:#16191d; }
	.PriceCard4 .Price { color:#7e3c88; unicode-bidi: isolate; }
	.PriceCard4 .Currency { color:#16191d; }
	.PriceCard4.PlaceSized { width: var(--PlaceWidthL); height: var(--PlaceHeightL); }
	.PriceCard4.IsPlaced { position: absolute; left: var(--PlaceXL); top: var(--PlaceYL); width: var(--PlaceWidthL); height: var(--PlaceHeightL); z-index: var(--PlaceZ, 1); opacity: var(--PlaceOpacityL, 100%); transform: rotate(var(--PlaceRotateL, 0deg)); transform-origin: var(--PlaceOrigin, center center); pointer-events: var(--PlaceClickable, auto); min-width: 0; box-sizing: border-box; }
	@media (orientation: portrait) {
		.PriceCard4 { --TextSize: var(--TextSizeP); }
		.PriceCard4.PlaceSized, .PriceCard4.IsPlaced { width: var(--PlaceWidthP); height: var(--PlaceHeightP); }
		.PriceCard4.IsPlaced { left: var(--PlaceXP); top: var(--PlaceYP); opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%)); transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg))); }
	}
</style>
