---
import type { HTMLAttributes } from "astro/types";
import { DirectSize, NumPer, Pixel, Place, type PlaceProps } from "@/TypesLib";

interface Props extends HTMLAttributes<"article">, PlaceProps {
	pThemeColor?: string;

	pImage?: string;
	pImageAlt?: string;
	pImageMoveAxis?: "x" | "y" | "xy" | "none";
	pImageDuration?: string;
	pImageScale?: number | string;
	pImagePan?: string;
	pImagePosition?: string;

	pIcon?: string;
	pIconAlt?: string;
	pIconMask?: boolean | string;
	pIconColor?: string;
	pIconMotion?: "launch" | "fly" | "spin" | "pulse" | "float" | "none";

	pActionTitle?: string;
	pActionText?: string;
	pActionLink?: string;
	pActionHref?: string;
	pActionColor?: string;
	pActionTarget?: string;

	ForcedHz?: boolean | string;
	pForcedHz?: boolean | string;

	pMediaWidth?: NumPer;
	pMediaHeight?: Pixel;
	pRadius?: Pixel;
	pPad?: Pixel;
	pGap?: Pixel;
	pIconSize?: Pixel;
	pIntroDelay?: string;
	pIntro?: boolean | string;

	"data-own-size"?: boolean | string;
}

const cProps = Astro.props as Props & Record<string, unknown>;

const {
	pThemeColor = "#3f7ee8",

	pImage = "",
	pImageAlt = "",
	pImageMoveAxis = "x",
	pImageDuration = "22s",
	pImageScale = 1.22,
	pImagePan = "5%",
	pImagePosition = "center center",

	pIcon = "",
	pIconAlt = "",
	pIconMask = false,
	pIconColor = "#ffffff",
	pIconMotion = "float",

	pActionTitle = "",
	pActionText = "",
	pActionLink = "",
	pActionHref = "",
	pActionColor,
	pActionTarget,

	ForcedHz = false,
	pForcedHz = false,

	pMediaWidth = new NumPer("20%", "20%"),
	pMediaHeight = new Pixel(126, 126),
	pRadius = new Pixel(18, 14),
	pPad = new Pixel(30, 18),
	pGap = new Pixel(18, 14),
	pIconSize = new Pixel(66, 60),
	pIntroDelay = "0s",
	pIntro = true,

	pLoc,
	pSize = new DirectSize(new NumPer(820, 320), new NumPer(320, 510)),
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,

	id: pGivenID = GetWidgetId("ThemedPriceCardHz"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	"data-own-size": pOwnSizeValue = true,
	...RemAttr
} = cProps;

const cOwnSize = GetBoolAttr(pOwnSizeValue);
const cIconMask = GetBoolAttr(pIconMask);
const cForcedHz = GetBoolAttr(ForcedHz) || GetBoolAttr(pForcedHz);
const cIntro = GetBoolAttr(pIntro);
const cActionTitle = pActionTitle || pActionText;
const cActionHref = pActionLink || pActionHref;
const cActionColor = pActionColor || pThemeColor;
const cActionRel = pActionTarget === "_blank" ? "noopener noreferrer" : undefined;
const cMoveClass = GetMoveClass(pImageMoveAxis);
const cIconMotionClass = GetIconMotionClass(pIconMotion);
const cImageScale = typeof pImageScale === "number" ? `${pImageScale}` : pImageScale;

const cCssVars = [
	`--TPCHTheme:${pThemeColor};`,
	`--TPCHAction:${cActionColor};`,
	`--TPCHWidthL:${pSize.WidthL};`,
	`--TPCHWidthP:${pSize.WidthP};`,
	`--TPCHHeightL:${pSize.HeightL};`,
	`--TPCHHeightP:${pSize.HeightP};`,
	`--TPCHMediaWidthL:${pMediaWidth.Landscape};`,
	`--TPCHMediaWidthP:${pMediaWidth.Portrait};`,
	`--TPCHMediaHeightL:${pMediaHeight.Landscape};`,
	`--TPCHMediaHeightP:${pMediaHeight.Portrait};`,
	`--TPCHRadiusL:${pRadius.Landscape};`,
	`--TPCHRadiusP:${pRadius.Portrait};`,
	`--TPCHPadL:${pPad.Landscape};`,
	`--TPCHPadP:${pPad.Portrait};`,
	`--TPCHGapL:${pGap.Landscape};`,
	`--TPCHGapP:${pGap.Portrait};`,
	`--TPCHIconSizeL:${pIconSize.Landscape};`,
	`--TPCHIconSizeP:${pIconSize.Portrait};`,
	`--TPCHIconUrl:${BuildCssUrl(pIcon)};`,
	`--TPCHIconColor:${pIconColor};`,
	`--TPCHImageDuration:${pImageDuration};`,
	`--TPCHImageScale:${cImageScale};`,
	`--TPCHImagePan:${pImagePan};`,
	`--TPCHImagePosition:${pImagePosition};`,
	`--TPCHIntroDelay:${pIntroDelay};`,
	GetStyleText(pGivenStyle),
].filter(Boolean).join(" ");

const cPlace = new Place({
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
}, cCssVars);

const cRootClass = [
	"ThemedPriceCardHz",
	cForcedHz ? "ForcedHz" : "CanFlip",
	cMoveClass,
	cIconMask ? "UseMaskIcon" : "UseImageIcon",
	cIconMotionClass,
	cIntro ? "UseIntro" : "NoIntro",
	pImage ? "HasImage" : "NoImage",
	pIcon ? "HasIcon" : "NoIcon",
	cActionTitle && cActionHref ? "HasAction" : "NoAction",
	cPlace.Class,
	pGivenClass,
].filter(Boolean).join(" ");

function GetBoolAttr(pValue: unknown) {
	return pValue === true || pValue === "" || pValue === "true";
}

function GetMoveClass(pValue: unknown) {
	if (pValue === "y") return "MoveY";
	if (pValue === "xy") return "MoveXY";
	if (pValue === "none") return "MoveNone";
	return "MoveX";
}

function GetIconMotionClass(pValue: unknown) {
	if (pValue === "launch") return "IconLaunch";
	if (pValue === "fly") return "IconFly";
	if (pValue === "spin") return "IconSpin";
	if (pValue === "pulse") return "IconPulse";
	if (pValue === "none") return "IconNone";
	return "IconFloat";
}

function BuildCssUrl(pValue?: string) {
	return pValue ? `url("${pValue}")` : "none";
}

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---




















<article
	class = {cRootClass}
	style = {cPlace.Style}
	id={pGivenID}
	data-own-size={cOwnSize ? "true" : undefined}
	{...RemAttr}
>







	<div class = " TPCHFrame ">

		<div class = " TPCHMedia " aria-hidden={pImage ? undefined : "true"}>

			{ pImage && (

				<img
					class = " TPCHMediaImg "
					src={pImage}
					alt={pImageAlt}
					loading="lazy"
					decoding="async"
				/>
			) }

		</div>

		<div class = " TPCHBody ">

			<div class = " TPCHContent ">

				<slot />

			</div>

			{ cActionTitle && cActionHref && (

				<a
					class = " TPCHAction "
					href={cActionHref}
					target={pActionTarget || undefined}
					rel={cActionRel}
				>

					<span>
						{cActionTitle}
					</span>

				</a>

			) }

		</div>

		<div class = " TPCHIconBadge " aria-hidden={pIcon && !cIconMask ? undefined : "true"}>

			{ pIcon ? (
				cIconMask ? (

					<span class = " TPCHMaskIcon " />

					) : (

						<img
							class = " TPCHIconImg "
							src={pIcon}
							alt={pIconAlt}
							loading="lazy"
							decoding="async"
						/>

					)
					) : (

						<span class = " TPCHFallbackIcon " />

					) }

			</div>

		</div>

	</article>




















<style>



	.ThemedPriceCardHz {
		position: relative;
		box-sizing: border-box;
		width: var(--TPCHWidthL);
		height: var(--TPCHHeightL);
		max-width: 100%;
		container: TPCHHz / inline-size;
		color: #ffffff;
		text-align: center;
	}


	.TPCHFrame {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--TPCHMediaWidthL);
		grid-template-rows: minmax(0, 1fr);
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		border-radius: var(--TPCHRadiusL);
		background: radial-gradient(circle at 18% 14%, rgba(255, 255, 255, .26), transparent 32%),
			linear-gradient(45deg,
				color-mix(in srgb, var(--TPCHTheme) 70%, #2c617f) 0%,
				color-mix(in srgb, var(--TPCHTheme) 42%, #ffffff) 100%);
		box-shadow: 0 17px 46px -10px rgba(0, 0, 0, .30),
			0 22px 50px -30px color-mix(in srgb, var(--TPCHTheme) 60%, transparent);
		overflow: hidden;
	}

	.TPCHFrame::before {
		background: linear-gradient(120deg, rgba(255, 255, 255, .15), transparent 43%),
			radial-gradient(circle at 9% 93%, color-mix(in srgb, var(--TPCHTheme) 20%, #ffffff) 0 8%, transparent 32%);
		opacity: .36;
	}

	.TPCHFrame::after {
		background: linear-gradient(90deg, rgba(255,255,255,.07), transparent 38%, rgba(0,0,0,.04));
		opacity: .28;
	}


	.TPCHMedia {
		position: relative;
		z-index: 1;
		grid-column: 2;
		grid-row: 1;
		width: 100%;
		height: 100%;
		overflow: hidden;
		background: linear-gradient(135deg,
				color-mix(in srgb, var(--TPCHTheme) 22%, #ffffff),
				color-mix(in srgb, var(--TPCHTheme) 52%, #243b86));
	}

	.TPCHMedia::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(90deg, color-mix(in srgb, var(--TPCHTheme) 12%, transparent), transparent 58%),
			linear-gradient(180deg, rgba(255,255,255,.07), rgba(0,0,0,.04));
		pointer-events: none;
	}


	.TPCHMediaImg {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--TPCHImagePosition);
		filter: saturate(1.04) contrast(1.02) brightness(1.02);
		transform: scale(var(--TPCHImageScale));
		transform-origin: center;
		will-change: transform;
	}


	.TPCHBody {
		position: relative;
		z-index: 2;
		grid-column: 1;
		grid-row: 1;
		min-width: 0;
		min-height: 0;
		padding: var(--TPCHPadL);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--TPCHGapL);
		direction: rtl;
		text-align: center;
		color: #ffffff;
	}


	.TPCHContent {
		width: min(88%, 560px);
		min-height: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--TPCHGapL);
		color: #ffffff;
	}

	.TPCHContent :global(*) {
		box-sizing: border-box;
		max-width: 100%;
	}


	.TPCHIconBadge {
		position: absolute;
		z-index: 4;
		right: var(--TPCHMediaWidthL);
		top: 50%;
		width: var(--TPCHIconSizeL);
		height: var(--TPCHIconSizeL);
		min-width: 46px;
		min-height: 46px;
		max-width: 84px;
		max-height: 84px;
		aspect-ratio: 1 / 1;
		border-radius: 999px;
		transform: translate(50%, -50%);
		display: grid;
		place-items: center;
		background: radial-gradient(circle at 34% 26%, #ffffff 0%, #f8f8f6 58%, #ecebea 100%);
		border: 4px solid rgba(255, 255, 255, .94);
		box-shadow: 0 8px 20px rgba(0, 0, 0, .22),
			0 0 0 7px color-mix(in srgb, var(--TPCHTheme) 14%, transparent),
			0 12px 22px color-mix(in srgb, var(--TPCHTheme) 20%, transparent);
		overflow: hidden;
	}


	.TPCHIconImg {
		object-fit: contain;
		filter: drop-shadow(0 2px 2px rgba(0,0,0,.12));
	}


	.TPCHMaskIcon {
		background-color: var(--TPCHIconColor);
		-webkit-mask: var(--TPCHIconUrl) center / contain no-repeat;
		mask: var(--TPCHIconUrl) center / contain no-repeat;
		filter: drop-shadow(0 2px 2px rgba(0,0,0,.12));
	}


	.TPCHFallbackIcon {
		width: 18%;
		height: 18%;
		border-radius: 50%;
		background: var(--TPCHIconColor);
		box-shadow: 0 0 0 10px color-mix(in srgb, var(--TPCHIconColor) 16%, transparent);
	}


	.TPCHAction {
		align-self: center;
		min-height: 44px;
		padding: 10px 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 900;
		line-height: 1.1;
		color: #ffffff;
		background: linear-gradient(180deg,
				color-mix(in srgb, var(--TPCHAction) 28%, #ffffff),
				var(--TPCHAction) 58%,
				color-mix(in srgb, var(--TPCHAction) 86%, #111111));
		border: 1px solid rgba(255, 255, 255, .34);
		box-shadow: 0 16px 28px color-mix(in srgb, var(--TPCHAction) 26%, transparent),
			0 7px 16px rgba(0, 0, 0, .18),
			inset 0 1px 0 rgba(255, 255, 255, .34);
		transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
	}

	.TPCHAction:hover {
		transform: translateY(-2px);
		filter: saturate(1.08) brightness(1.03);
	}



	.ThemedPriceCardHz.UseIntro .TPCHFrame {
		animation: TPCHIntro .82s var(--TPCHIntroDelay) both cubic-bezier(.18,.82,.28,1.2);
	}


	.ThemedPriceCardHz.MoveX .TPCHMediaImg {
		animation: TPCHPanX var(--TPCHImageDuration) ease-in-out infinite alternate;
	}


	.ThemedPriceCardHz.MoveY .TPCHMediaImg {
		animation: TPCHPanY var(--TPCHImageDuration) ease-in-out infinite alternate;
	}


	.ThemedPriceCardHz.MoveXY .TPCHMediaImg {
		animation: TPCHPanXY var(--TPCHImageDuration) ease-in-out infinite alternate;
	}


	.ThemedPriceCardHz.MoveNone .TPCHMediaImg {
		animation: none;
	}


	.ThemedPriceCardHz.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		z-index: var(--PlaceZ, 1);
		opacity: var(--PlaceOpacityL, 100%);
		transform: rotate(var(--PlaceRotateL, 0deg));
		transform-origin: var(--PlaceOrigin, center center);
		pointer-events: var(--PlaceClickable, auto);
		min-width: 0;
	}



	.ThemedPriceCardHz,
	.ThemedPriceCardHz *
	{
		box-sizing: border-box;
	}


	.TPCHFrame::before,
	.TPCHFrame::after
	{
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
		pointer-events: none;
	}


	.TPCHContent :global(h1),
	.TPCHContent :global(h2),
	.TPCHContent :global(h3),
	.TPCHContent :global(h4),
	.TPCHContent :global(h5),
	.TPCHContent :global(h6),
	.TPCHContent :global(p)
	{
		margin: 0;
		color: #ffffff;
		text-shadow: 0 3px 4px rgba(0, 0, 0, .16);
	}


	.TPCHContent :global(h1),
	.TPCHContent :global(h2),
	.TPCHContent :global(h3),
	.TPCHContent :global(.title),
	.TPCHContent :global([data-title])
	{
		font-size: clamp(21px, 2.15vw, 28px);
		font-weight: 900;
		line-height: 1.14;
		letter-spacing: -.015em;
	}


	.TPCHContent :global(.price),
	.TPCHContent :global([data-price])
	{
		font-size: clamp(42px, 4.8vw, 62px);
		font-weight: 900;
		line-height: .92;
		letter-spacing: -.05em;
		text-shadow: 0 0 10px rgba(0, 0, 0, .38);
		direction: ltr;
		unicode-bidi: isolate;
	}


	.TPCHContent :global(p),
	.TPCHContent :global(li)
	{
		font-size: clamp(13px, 1.05vw, 15px);
		line-height: 1.6;
		font-weight: 400;
		color: #ffffff;
	}


	.TPCHContent :global(ul),
	.TPCHContent :global(ol)
	{
		margin: 0;
		padding-inline-start: 1.15em;
		text-align: start;
	}


	.TPCHIconImg,
	.TPCHMaskIcon,
	.TPCHFallbackIcon
	{
		display: block;
		width: 43%;
		height: 43%;
		position: relative;
		transition: transform .2s ease, opacity .2s ease;
	}


	.ThemedPriceCardHz.IconFloat .TPCHIconImg,
	.ThemedPriceCardHz.IconFloat .TPCHMaskIcon,
	.ThemedPriceCardHz.IconFloat .TPCHFallbackIcon
	{
		animation: TPCHIconFloat 2.4s ease-in-out infinite alternate;
	}


	.ThemedPriceCardHz.IconLaunch:hover .TPCHIconImg,
	.ThemedPriceCardHz.IconLaunch:hover .TPCHMaskIcon,
	.ThemedPriceCardHz.IconLaunch:hover .TPCHFallbackIcon
	{
		animation: TPCHLaunch .95s ease-in-out both;
	}


	.ThemedPriceCardHz.IconFly:hover .TPCHIconImg,
	.ThemedPriceCardHz.IconFly:hover .TPCHMaskIcon,
	.ThemedPriceCardHz.IconFly:hover .TPCHFallbackIcon
	{
		animation: TPCHFly .95s ease-in-out both;
	}


	.ThemedPriceCardHz.IconSpin:hover .TPCHIconImg,
	.ThemedPriceCardHz.IconSpin:hover .TPCHMaskIcon,
	.ThemedPriceCardHz.IconSpin:hover .TPCHFallbackIcon
	{
		animation: TPCHSpin .85s ease-in-out both;
	}


	.ThemedPriceCardHz.IconPulse:hover .TPCHIconImg,
	.ThemedPriceCardHz.IconPulse:hover .TPCHMaskIcon,
	.ThemedPriceCardHz.IconPulse:hover .TPCHFallbackIcon
	{
		animation: TPCHPulse .75s ease-in-out both;
	}


	@keyframes TPCHIntro {
	0% { transform: scale(0); } 25% { transform: scale(1.06); } 50% { transform: scale(.965); } 75% { transform: scale(1.02); } 100% { transform: scale(1); }
	}


	@keyframes TPCHPanX {
	from { transform: translate3d(calc(0px - var(--TPCHImagePan)), 0, 0) scale(var(--TPCHImageScale)); } to { transform: translate3d(var(--TPCHImagePan), 0, 0) scale(var(--TPCHImageScale)); }
	}


	@keyframes TPCHPanY {
	from { transform: translate3d(0, calc(0px - var(--TPCHImagePan)), 0) scale(var(--TPCHImageScale)); } to { transform: translate3d(0, var(--TPCHImagePan), 0) scale(var(--TPCHImageScale)); }
	}


	@keyframes TPCHPanXY {
	from { transform: translate3d(calc(0px - var(--TPCHImagePan)), var(--TPCHImagePan), 0) scale(var(--TPCHImageScale)); } to { transform: translate3d(var(--TPCHImagePan), calc(0px - var(--TPCHImagePan)), 0) scale(var(--TPCHImageScale)); }
	}


	@keyframes TPCHIconFloat {
	from { transform: translateY(1px); } to { transform: translateY(-4px); }
	}


	@keyframes TPCHLaunch {
	0% { transform: translate(0, 0) rotate(0deg); } 25% { transform: translate(0, -72px) rotate(0deg); } 50% { transform: translate(-95px, -20px) rotate(-20deg); } 75% { transform: translate(42px, 64px) rotate(40deg); } 100% { transform: translate(0, 0) rotate(0deg); }
	}


	@keyframes TPCHFly {
	0% { transform: translate(0, 0) rotate(0deg); } 25% { transform: translate(48px, -58px) rotate(12deg); } 50% { transform: translate(-112px, -12px) rotate(-12deg); } 75% { transform: translate(32px, 58px) rotate(8deg); } 100% { transform: translate(0, 0) rotate(0deg); }
	}


	@keyframes TPCHSpin {
	0% { transform: rotate(0deg); } 100% { transform: rotate(720deg); }
	}


	@keyframes TPCHPulse {
	0% { transform: scale(1); } 45% { transform: scale(1.22); } 100% { transform: scale(1); }
	}


	@container TPCHHz (max-width: 700px) {
	.ThemedPriceCardHz.CanFlip .TPCHFrame {
				grid-template-columns: minmax(0, 1fr);
				grid-template-rows: var(--TPCHMediaHeightP) minmax(0, 1fr);
				border-radius: var(--TPCHRadiusP);
			}
	
			.ThemedPriceCardHz.CanFlip .TPCHMedia { grid-column: 1; grid-row: 1; width: 100%; height: var(--TPCHMediaHeightP); }
			.ThemedPriceCardHz.CanFlip .TPCHBody { grid-column: 1; grid-row: 2; padding: calc(var(--TPCHIconSizeP) / 2 + 14px) var(--TPCHPadP) var(--TPCHPadP); gap: var(--TPCHGapP); }
			.ThemedPriceCardHz.CanFlip .TPCHContent { width: min(100%, 280px); gap: var(--TPCHGapP); }
			.ThemedPriceCardHz.CanFlip .TPCHIconBadge { left: 50%; right: auto; top: var(--TPCHMediaHeightP); width: var(--TPCHIconSizeP); height: var(--TPCHIconSizeP); max-width: 78px; max-height: 78px; transform: translate(-50%, -50%); }
	}



</style>




















<style>



	@media (orientation: landscape) {
		.ThemedPriceCardHz.PlaceHideLand {
			display: none;
		}
	}


	@media (orientation: portrait) {
		.ThemedPriceCardHz.PlaceHidePort {
			display: none;
		}
	}



	@media (orientation: portrait), (max-width: 700px) {
		.ThemedPriceCardHz {
			width: var(--TPCHWidthP);
			height: var(--TPCHHeightP);
		}

		.ThemedPriceCardHz.CanFlip .TPCHFrame {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: var(--TPCHMediaHeightP) minmax(0, 1fr);
			border-radius: var(--TPCHRadiusP);
		}

		.ThemedPriceCardHz.CanFlip .TPCHMedia {
			grid-column: 1;
			grid-row: 1;
			width: 100%;
			height: var(--TPCHMediaHeightP);
		}

		.ThemedPriceCardHz.CanFlip .TPCHBody {
			grid-column: 1;
			grid-row: 2;
			padding: calc(var(--TPCHIconSizeP) / 2 + 14px) var(--TPCHPadP) var(--TPCHPadP);
			gap: var(--TPCHGapP);
		}

		.ThemedPriceCardHz.CanFlip .TPCHContent {
			width: min(100%, 280px);
			gap: var(--TPCHGapP);
		}

		.ThemedPriceCardHz.CanFlip .TPCHIconBadge {
			left: 50%;
			right: auto;
			top: var(--TPCHMediaHeightP);
			width: var(--TPCHIconSizeP);
			height: var(--TPCHIconSizeP);
			max-width: 78px;
