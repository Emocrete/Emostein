---
import { NumPer, Place, type PlaceProps, Size, Text } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"article">, PlaceProps {
	pCaption?: Text;
	pStart?: Text;
	pPrice?: string | number;
	pPriceFnt?: Text;
	pCurrency?: Text;
	"data-own-size"?: boolean | string;
}

const cProps = Astro.props as Props & Record<string, unknown>;
const {
	pCaption = Text.H6.OfSize(17, 12).Bold.OfText("تقرير معتمد من مهندس استشاري ونقابة المهندسين"),
	pStart = Text.H3.OfSize(28, 20).Bold.OfText("يبدأ من"),
	pPrice = 3000,
	pPriceFnt = Text.H3.OfSize(31, 22).Bold,
	pCurrency = Text.H3.OfSize(24, 18).Bold.OfText("جنيه"),
	pSize = new Size(new NumPer(418, 320), new NumPer(172, 132)),
	pLoc,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
	id: pGivenID = GetWidgetId("PriceCard5"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	"data-own-size": pOwnSize = false,
	...RemAttr
} = cProps;

const cOwnSize = pOwnSize === true || pOwnSize === "" || pOwnSize === "true";
const cStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";
const cPlace = new Place({
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
} as PlaceProps, cStyle);
---

<article class={`PriceCard5 ${cPlace.Class} ${pGivenClass}`.trim()} style={cPlace.Style} id={pGivenID} data-own-size={cOwnSize ? "true" : undefined} {...RemAttr}>
<svg viewBox="0 0 418 172" role="img" aria-label={`${pCaption.text ?? ""} — ${pStart.text ?? ""} ${pPrice} ${pCurrency.text ?? ""}`}>
<defs><linearGradient id={`${pGivenID}_teal5`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#15969b"/><stop offset="1" stop-color="#0a7f88"/></linearGradient><filter id={`${pGivenID}_sh5`} x="-20%" y="-30%" width="150%" height="170%"><feDropShadow dx="0" dy="4" stdDeviation="5" flood-color="#294f52" flood-opacity=".18"/></filter></defs>
<rect x="1" y="1" width="416" height="169" rx="17" fill={`url(#${pGivenID}_teal5)`} filter={`url(#${pGivenID}_sh5)`}/>
<path d="M33 62H389Q417 62 417 90V153Q417 170 400 170H54L33 151Z" fill="#fff"/>
<rect x="34" y="65" width="366" height="84" rx="18" fill="#fff" stroke="#dce4e4"/>
<foreignObject x="43" y="10" width="344" height="39"><div xmlns="http://www.w3.org/1999/xhtml" class="Caption" style={`${pCaption.GetStyle()} color:#fff; font-size:12px; line-height:1.25; white-space:nowrap;`}>{pCaption.text}</div></foreignObject>
<foreignObject x="98" y="83" width="285" height="50"><div xmlns="http://www.w3.org/1999/xhtml" class="PriceLine"><span class="Start" style={pStart.GetStyle()}>{pStart.text}</span><span class="Price" dir="ltr" style={`${pPriceFnt.GetStyle()} color:#13aaa8;`}>{pPrice}</span><span class="Currency" style={pCurrency.GetStyle()}>{pCurrency.text}</span></div></foreignObject>
<g fill="#d8f0f0" opacity=".85"><circle cx="12" cy="44" r="1.25"/><circle cx="20" cy="44" r="1.25"/><circle cx="28" cy="44" r="1.25"/><circle cx="12" cy="52" r="1.25"/><circle cx="20" cy="52" r="1.25"/><circle cx="28" cy="52" r="1.25"/><circle cx="12" cy="60" r="1.25"/><circle cx="20" cy="60" r="1.25"/><circle cx="28" cy="60" r="1.25"/><circle cx="12" cy="68" r="1.25"/><circle cx="20" cy="68" r="1.25"/><circle cx="28" cy="68" r="1.25"/></g>
<circle cx="45" cy="126" r="36" fill="#0b8088" stroke="#58c1c4" stroke-width="2"/>
<g transform="translate(23 103)" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="22" cy="18" r="12"/><path d="m22 10 2.5 5 5.5.8-4 4 1 5.5-5-2.8-5 2.8 1-5.5-4-4 5.5-.8Z"/><path d="M14 29 9 43l12-6 12 6-4-14"/></g>
</svg></article>

<style>
	.PriceCard5 { position: relative; display: block; width: 418px; height: 172px; max-width: 100%; direction: rtl; box-sizing: border-box; overflow: visible; --TextSize: var(--TextSizeL); }
	.PriceCard5 > svg { display: block; width: 100%; height: 100%; overflow: visible; }
	.PriceCard5 .Caption { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; direction: rtl; font-family: inherit; white-space: normal; overflow: hidden; }
	.PriceCard5 .PriceLine { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; direction: rtl; font-family: inherit; white-space: nowrap; }
	.PriceCard5 .Start { color:#16191d; }
	.PriceCard5 .Price { color:#13aaa8; unicode-bidi: isolate; }
	.PriceCard5 .Currency { color:#16191d; }
	.PriceCard5.PlaceSized { width: var(--PlaceWidthL); height: var(--PlaceHeightL); }
	.PriceCard5.IsPlaced { position: absolute; left: var(--PlaceXL); top: var(--PlaceYL); width: var(--PlaceWidthL); height: var(--PlaceHeightL); z-index: var(--PlaceZ, 1); opacity: var(--PlaceOpacityL, 100%); transform: rotate(var(--PlaceRotateL, 0deg)); transform-origin: var(--PlaceOrigin, center center); pointer-events: var(--PlaceClickable, auto); min-width: 0; box-sizing: border-box; }
	@media (orientation: portrait) {
		.PriceCard5 { --TextSize: var(--TextSizeP); }
		.PriceCard5.PlaceSized, .PriceCard5.IsPlaced { width: var(--PlaceWidthP); height: var(--PlaceHeightP); }
		.PriceCard5.IsPlaced { left: var(--PlaceXP); top: var(--PlaceYP); opacity: var(--PlaceOpacityP, var(--PlaceOpacityL, 100%)); transform: rotate(var(--PlaceRotateP, var(--PlaceRotateL, 0deg))); }
	}
</style>
