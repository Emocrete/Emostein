---
import { existsSync, readFileSync } from "fs";
import { isAbsolute, relative, resolve } from "path";
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
// @ts-ignore

type StoneProductType = "Marble" | "Granite" | "marble" | "granite" | "رخام" | "جرانيت";
type CssValue = string | number;

type GalleryJsonItem = {
	File?: string;
	Src?: string;
	NameAr?: string;
	Alt?: string;
	Use?: string;
	file?: string;
	src?: string;
	nameAr?: string;
	alt?: string;
	use?: string;
};

type GalleryItem = {
	Src: string;
	File: string;
	NameAr: string;
	Alt: string;
	Use: string;
	HiddenOnMobile: boolean;
};

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	/** Marble / Granite / رخام / جرانيت. يغير زخرفة الخلفية تلقائيًا. */
	pStoneType?: StoneProductType;

	/** فولدر الصور داخل public، مثل /Media/Emostone/ProductStripSample. */
	pFolder?: string;

	/** صور جاهزة مباشرة. لها أولوية على pFolder وملف JSON. */
	pImages?: GalleryJsonItem[];

	/** اسم ملف الجسون داخل نفس فولدر الصور. */
	pJson?: string;

	/** بيانات الخامة. */
	pName?: string;
	pKind?: string;
	pColor?: string;
	pCountry?: string;
	pUses?: string | string[];
	pSizes?: string | string[];
	pBody?: string | string[];

	pCtaText?: string;
	pCtaHref?: string;
	pCtaAria?: string;

	pMaxWidth?: CssValue;
	pPad?: CssValue;
	pGap?: CssValue;
	pRadius?: CssValue;
	pAccent?: string;
	pAccentSoft?: string;
	pTextColor?: string;
	pMutedColor?: string;
	pCardColor?: string;
	pGalleryHeight?: CssValue;
	pDesktopVisibleColumns?: number;
	pMobileInitialCount?: number;
	pAutoSlide?: boolean;
	pDwellMs?: number;
	pMoveMs?: number;
	pColorizeMs?: number;
}

const cProps = Astro.props as Props & Record<string, unknown>;

const {
	pStoneType = "Marble",
	pFolder = "",
	pImages = [],
	pJson = "gallery.json",
	pName = "جلالة روزا",
	pKind = "رخام مصري طبيعي",
	pColor = "وردي مائل للبيج",
	pCountry = "مصر",
	pUses = ["أرضيات", "حوائط", "درج", "سلالم", "مطابخ", "أحواض", "واجهات داخلية"],
	pSizes = ["40", "60", "80", "ترابيع"],
	pBody = [
		"يتوفر توريد وتركيب الخامة للأرضيات والحوائط والسلالم والأحواض والمداخل حسب الفرز والمقاسات المتاحة.",
		"يمكن تنفيذ التصميمات السكنية والتجارية مع معاينة الخامة، رفع المقاسات، التقطيع، التركيب، الجلي، والتشطيب النهائي.",
		"يوجد لدينا توريد وتشطيب وتركيب على أعلى مستوى مع ترشيح بدائل مناسبة للميزانية والاستخدام."
	],
	pCtaText = "اطلب عرض سعر",
	pCtaHref = "tel:+201014490054",
	pCtaAria = "اطلب عرض سعر للخامة",
	pMaxWidth = "1480px",
	pPad = "clamp(28px, 4.2vw, 76px)",
	pGap = "clamp(24px, 3.2vw, 56px)",
	pRadius = "30px",
	pAccent,
	pAccentSoft,
	pTextColor = "#24313a",
	pMutedColor = "#62707a",
	pCardColor = "rgba(255,255,255,0.84)",
	pGalleryHeight = "clamp(430px, 33vw, 560px)",
	pDesktopVisibleColumns = 3,
	pMobileInitialCount = 3,
	pAutoSlide = true,
	pDwellMs = 2000,
	pMoveMs = 760,
	pColorizeMs = 500,

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("StoneProductStrip"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

const cStoneType = NormalizeStoneType(pStoneType);
const cAccent = pAccent ?? (cStoneType === "granite" ? "#2c6674" : "#c8909a");
const cAccentSoft = pAccentSoft ?? (cStoneType === "granite" ? "#86bdc8" : "#f0c0c7");
const cUses = ToList(pUses);
const cSizes = ToList(pSizes);
const cBodyLines = ToList(pBody);
const cMobileCount = Math.max(1, pMobileInitialCount);
const cGalleryItems = GetGalleryItems(pFolder, pJson, cUses.join("، "), pImages).map((pItem, pIndex) => ({
	...pItem,
	HiddenOnMobile: pIndex >= cMobileCount,
}));
const cHasImages = cGalleryItems.length > 0;
const cVisibleColumns = Math.max(1, pDesktopVisibleColumns);

const cStyle = [
	`--StoneProductMaxWidth:${NormalizeCssValue(pMaxWidth)};`,
	`--StoneProductPad:${NormalizeCssValue(pPad)};`,
	`--StoneProductGap:${NormalizeCssValue(pGap)};`,
	`--StoneProductRadius:${NormalizeCssValue(pRadius)};`,
	`--StoneProductAccent:${cAccent};`,
	`--StoneProductAccentSoft:${cAccentSoft};`,
	`--StoneProductText:${pTextColor};`,
	`--StoneProductMuted:${pMutedColor};`,
	`--StoneProductCard:${pCardColor};`,
	`--StoneProductGalleryHeight:${NormalizeCssValue(pGalleryHeight)};`,
	`--StoneProductVisibleCols:${cVisibleColumns};`,
	`--StoneProductMoveMs:${Math.max(120, pMoveMs)}ms;`,
	`--StoneProductColorizeMs:${Math.max(120, pColorizeMs)}ms;`,
	GetStyleText(pGivenStyle),
].filter(Boolean).join(" ");

const cPlace = new Place({
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
}, cStyle);

const cRootClass = [
	"StoneProductStripV5",
	cStoneType === "granite" ? "IsGranite" : "IsMarble",
	cPlace.Class,
	pGivenClass,
].filter(Boolean).join(" ");

function NormalizeStoneType(pValue: unknown) {
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	if (cValue === "granite" || cValue === "جرانيت") return "granite";
	return "marble";
}

function ToList(pValue: string | string[] | undefined) {
	if (Array.isArray(pValue)) {
		return pValue.map((pItem) => `${pItem}`.trim()).filter(Boolean);
	}

	return `${pValue ?? ""}`
		.split(/\r?\n|\||،|,/g)
		.map((pItem) => pItem.trim())
		.filter(Boolean);
}

function NormalizeCssValue(pValue: CssValue) {
	return typeof pValue === "number" ? `${pValue}px` : `${pValue}`;
}

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}

function GetGalleryItems(pFolderValue: string, pJsonName: string, pDefaultUse: string, pDirectItems: GalleryJsonItem[] = []): GalleryItem[] {
	if (pDirectItems.length > 0) {
		return NormalizeGalleryItems(pDirectItems, pFolderValue, pDefaultUse);
	}

	const cPublicRoot = resolve(process.cwd(), "public");
	const cFolder = NormalizePublicFolder(pFolderValue);
	if (!cFolder) return [];

	const cFolderPath = resolve(cPublicRoot, cFolder);
	const cRelative = relative(cPublicRoot, cFolderPath);

	if (cRelative.startsWith("..") || cRelative === ".." || isAbsolute(cRelative) || !existsSync(cFolderPath)) {
		return [];
	}

	const cJsonPath = resolve(cFolderPath, pJsonName);
	const cJsonRelative = relative(cFolderPath, cJsonPath);

	if (cJsonRelative.startsWith("..") || cJsonRelative === ".." || isAbsolute(cJsonRelative) || !existsSync(cJsonPath)) {
		return [];
	}

	try {
		const cRaw = JSON.parse(readFileSync(cJsonPath, "utf-8"));
		const cItems = Array.isArray(cRaw) ? cRaw : Array.isArray(cRaw?.Images) ? cRaw.Images : Array.isArray(cRaw?.images) ? cRaw.images : [];

		return NormalizeGalleryItems(cItems, cFolder, pDefaultUse);
	} catch {
		return [];
	}
}


function NormalizeGalleryItems(pItems: GalleryJsonItem[], pFolderValue: string, pDefaultUse: string): GalleryItem[] {
	const cFolder = NormalizePublicFolder(pFolderValue);

	return pItems
		.map((pItem) => {
			const cFile = `${pItem.File ?? pItem.file ?? pItem.Src ?? pItem.src ?? ""}`.trim();
			if (!cFile) return null;

			const cName = `${pItem.NameAr ?? pItem.nameAr ?? StripExt(cFile)}`.trim();
			const cAlt = `${pItem.Alt ?? pItem.alt ?? cName}`.trim();
			const cUse = `${pItem.Use ?? pItem.use ?? pDefaultUse}`.trim();
			const cSrc = cFile.startsWith("/") ? cFile : JoinPublicUrl(cFolder, cFile);

			return {
				Src: cSrc,
				File: cFile,
				NameAr: cName,
				Alt: cAlt,
				Use: cUse,
				HiddenOnMobile: false,
			};
		})
		.filter(Boolean) as GalleryItem[];
}

function NormalizePublicFolder(pFolderValue: string) {
	return `${pFolderValue ?? ""}`
		.trim()
		.replace(/\\/g, "/")
		.replace(/^public\//, "")
		.replace(/^\/+/, "")
		.replace(/\/+$/, "");
}

function JoinPublicUrl(pFolderValue: string, pFileValue: string) {
	const cSegments = `${pFolderValue}/${pFileValue}`
		.replace(/\\/g, "/")
		.split("/")
		.filter(Boolean)
		.map((pSegment) => encodeURIComponent(pSegment));

	return `/${cSegments.join("/")}`;
}

function StripExt(pFile: string) {
	return pFile.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ");
}
---




















<section
	class = {cRootClass}
	style = {cPlace.Style}
	id={pGivenID}
	dir="rtl"
	data-own-size="true"
	data-emo-auto-container="true"
	data-emo-explicit-height="false"
	data-emo-empty-height="300"
	data-stone-product-strip="v5"
	data-auto-slide={pAutoSlide ? "true" : "false"}
	data-dwell-ms={Math.max(500, pDwellMs)}
	data-move-ms={Math.max(120, pMoveMs)}
	data-colorize-ms={Math.max(120, pColorizeMs)}
	data-visible-columns={cVisibleColumns}
	data-mobile-count={cMobileCount}
	{...RemAttr}
>







	<article class = " StoneProductCardV5 " aria-label={`كرت خامة ${pName}`}>

		<div
			class = " StoneProductGalleryPaneV5 "
			aria-label={`صور خامة ${pName}`}
			data-has-images={cHasImages ? "true" : "false"}
		>

			<div class = " StoneProductGalleryShadowV5 " aria-hidden="true">

			</div>

			<div class = " StoneProductViewportV5 ">

				<div class = " StoneProductTrackV5 ">

					{ cHasImages ? cGalleryItems.map((pItem, pIndex) => (

						<button
							class = {`StoneProductThumbV5 ${pItem.HiddenOnMobile ? "IsMobileHiddenInitial" : ""}`.trim()}
							type="button"
							data-index={pIndex}
							data-src={pItem.Src}
							data-alt={pItem.Alt}
							data-name={pItem.NameAr}
							data-use={pItem.Use}
						>

							<img
								src={pItem.Src}
								alt={pItem.Alt}
								loading={pIndex < 6 ? "eager" : "lazy"}
								decoding="async"
							/>

							<span class = " StoneProductCaptionV5 ">

								<strong>
									{pItem.NameAr}
								</strong>

								<small>

									{pItem.Use}

								</small>

							</span>

						</button>

						)) : (

							<div class = " StoneProductEmptyV5 ">

								راجع pFolder وملف

								{pJson}

							</div>

						) }

				</div>

			</div>

			{ cGalleryItems.length > cMobileCount && (

				<button
					class = " StoneProductMoreV5 "
					type="button"
					data-more-closed="عرض المزيد"
					data-more-open="إخفاء الصور الزائدة"
				>
				
					عرض المزيد
				
				</button>
			) }

		</div>

		<div class = " StoneProductInfoPaneV5 " aria-label={`بيانات خامة ${pName}`}>

			<p class = " StoneProductEyebrowV5 ">
				{cStoneType === "granite" ? "مجموعة الجرانيت" : "مجموعة الرخام"}
			</p>

			<h2 class = " StoneProductTitleV5 ">
				{pName}
			</h2>

			<dl class = " StoneProductMetaV5 ">

				<div>

					<dt>

						اسم الخامة:

					</dt>

					<dd>

						{pName}

					</dd>

				</div>

				<div>

					<dt>

						نوع الخامة:

					</dt>

					<dd>

						{pKind}

					</dd>

				</div>

				<div>

					<dt>

						لون الخامة:

					</dt>

					<dd>

						{pColor}

					</dd>

				</div>

				<div>

					<dt>

						بلد المنشأ:

					</dt>

					<dd>

						{pCountry}

					</dd>

				</div>

				{ cUses.length > 0 && (

					<div class = " StoneProductUsesRowV5 ">
					
					
					
					
					
					
					
						<dt>
					
							الاستخدامات:
					
						</dt>
					
					
					
					
					
					
					
						<dd>
					
							{cUses.join("، ")}
					
						</dd>
					
					
					
					
					
					
					
					</div>
				) }

			</dl>

			{ cSizes.length > 0 && (

				<div class = " StoneProductSizesV5 " aria-label="المقاسات المتاحة">
				
					{ cSizes.map((pSizeItem) => (
				
						<span>
							{pSizeItem}
						</span>
				
					)) }
				
				</div>
			) }

			{ cBodyLines.length > 0 && (

				<div class = " StoneProductBodyV5 ">
				
					{ cBodyLines.map((pLine) => (
				
						<p>
							{pLine}
						</p>
				
					)) }
				
				</div>
			) }

			{ pCtaText && (

				<a
					class = " StoneProductCtaV5 "
					href={pCtaHref}
					aria-label={pCtaAria}
				>
				
				
				
				
				
				
				
					<svg viewBox="0 0 24 24" aria-hidden="true">
				
						<path
							d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1v3.6c0 .6-.4 1-1 1C10.7 21.7 2.3 13.3 2.3 3.7c0-.6.4-1 1-1h3.6c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1l-2.2 2.2Z"
						/>
				
					</svg>
				
				
				
				
				
				
				
					<span>
						{pCtaText}
					</span>
				
				
				
				
				
				
				
				</a>
			) }

		</div>

	</article>

	{ cHasImages && (

		<div
			class = " StoneProductLightboxV5 "
			hidden
			aria-hidden="true"
			role="dialog"
			aria-modal="true"
			aria-label={`معرض صور ${pName}`}
		>
		
		
		
		
		
		
		
			<button
				class = " StoneProductCloseV5 "
				type="button"
				aria-label="إغلاق المعرض"
			>
		
				×
		
			</button>
		
		
		
		
		
		
		
			<button
				class = " StoneProductNavV5 StoneProductPrevV5 "
				type="button"
				aria-label="الصورة السابقة"
			>
		
				<svg viewBox="0 0 24 24" aria-hidden="true">
		
					<path d="M15 5 8 12l7 7" />
		
				</svg>
		
			</button>
		
		
		
		
		
		
		
			<div class = " StoneProductLightboxBodyV5 ">
		
				<img
					class = " StoneProductLightboxImgV5 "
					src={cGalleryItems[0].Src}
					alt={cGalleryItems[0].Alt}
				/>
		
				<div class = " StoneProductLightboxTitleV5 ">
		
					<strong>
						{cGalleryItems[0].NameAr}
					</strong>
		
					<small>
		
						{cGalleryItems[0].Use}
		
					</small>
		
				</div>
		
				<div class = " StoneProductFilmV5 " aria-label="صور الخامة">
		
					{ cGalleryItems.map((pItem, pIndex) => (
		
						<button
							class = {`StoneProductFilmItemV5 ${pIndex === 0 ? "IsActive" : ""}`.trim()}
							type="button"
							data-index={pIndex}
							data-src={pItem.Src}
							data-alt={pItem.Alt}
							data-name={pItem.NameAr}
							data-use={pItem.Use}
						>
		
							<img
								src={pItem.Src}
								alt={pItem.Alt}
								loading="lazy"
								decoding="async"
							/>
		
						</button>
		
					)) }
		
				</div>
		
			</div>
		
		
		
		
		
		
		
			<button
				class = " StoneProductNavV5 StoneProductNextV5 "
				type="button"
				aria-label="الصورة التالية"
			>
		
				<svg viewBox="0 0 24 24" aria-hidden="true">
		
					<path d="m9 5 7 7-7 7" />
		
				</svg>
		
			</button>
		
		
		
		
		
		
		
		</div>
	) }

</section>




















<style>



	.StoneProductStripV5 {
		position: relative;
		isolation: isolate;
		display: block;
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		overflow: hidden;
		padding: var(--StoneProductPad);
		color: var(--StoneProductText);
		background: radial-gradient(circle at 12% 12%, color-mix(in srgb, var(--StoneProductAccentSoft) 22%, transparent), transparent 34%),
			linear-gradient(135deg, #fbfaf6 0%, #f3efe7 46%, #ffffff 100%);
	}

	.StoneProductStripV5::before {
		opacity: 0.18;
		background-repeat: repeat;
		background-size: 420px 420px;
	}

	.StoneProductStripV5::after {
		opacity: 0.54;
		background: linear-gradient(90deg, rgba(255,255,255,0.82), transparent 28%, transparent 72%, rgba(255,255,255,0.74)),
			radial-gradient(circle at 74% 34%, rgba(255,255,255,0.78), transparent 35%);
	}


	.StoneProductCardV5 {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
		width: min(100%, var(--StoneProductMaxWidth));
		max-width: 100%;
		margin-inline: auto;
		padding: clamp(16px, 1.7vw, 28px);
		display: grid;
		grid-template-columns: minmax(0, 1.28fr) minmax(330px, 0.86fr);
		grid-template-areas: "gallery info";
		align-items: stretch;
		gap: var(--StoneProductGap);
		direction: ltr;
		border: 1px solid rgba(255,255,255,0.72);
		border-radius: calc(var(--StoneProductRadius) + 10px);
		background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(255,255,255,0.64)),
			var(--StoneProductCard);
		box-shadow: 0 28px 74px rgba(32, 38, 43, 0.13),
			inset 0 1px 0 rgba(255,255,255,0.86);
		backdrop-filter: blur(8px);
	}


	.StoneProductGalleryPaneV5 {
		position: relative;
		grid-area: gallery;
		display: block;
		height: var(--StoneProductGalleryHeight);
		min-height: 320px;
		padding-bottom: 32px;
	}


	.StoneProductInfoPaneV5 {
		grid-area: info;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		text-align: right;
		padding: clamp(18px, 2.5vw, 42px) clamp(10px, 2.4vw, 36px);
		border-radius: calc(var(--StoneProductRadius) - 6px);
		background: transparent;
	}


	.StoneProductEyebrowV5 {
		width: 100%;
		margin: 0 0 12px;
		text-align: right;
		color: var(--StoneProductAccent);
		font-size: clamp(14px, 1vw, 18px);
		font-weight: 800;
	}


	.StoneProductTitleV5 {
		width: 100%;
		margin: 0;
		text-align: right;
		color: #18a9ef;
		font-size: clamp(40px, 4.6vw, 78px);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: -0.055em;
		text-shadow: 0 10px 24px rgba(24, 169, 239, 0.14);
	}


	.StoneProductMetaV5 {
		align-self: stretch;
		width: min(100%, 620px);
		margin: clamp(18px, 2.6vw, 34px) 0 0;
		display: grid;
		gap: 8px;
		font-size: clamp(14px, 1.05vw, 18px);
		line-height: 1.65;
	}

	.StoneProductMetaV5 div {
		display: flex;
		justify-content: flex-start;
		gap: 8px;
		flex-wrap: wrap;
		text-align: right;
	}

	.StoneProductMetaV5 dt {
		margin: 0;
		color: var(--StoneProductAccent);
		font-weight: 900;
	}

	.StoneProductMetaV5 dd {
		margin: 0;
		color: var(--StoneProductText);
		font-weight: 600;
	}


	.StoneProductUsesRowV5 dd {
		max-width: 520px;
	}


