<script is:inline>
	(() => {
	if (window.__StoneProductStripV5Booted) return;
	window.__StoneProductStripV5Booted = true;

	const mqlMobile = window.matchMedia("(max-width: 900px)");
	const initialized = new WeakSet();
	let activeLightbox = null;

	function boot() {
	document.querySelectorAll(".StoneProductStripV5").forEach(initStrip);
	}

	function initStrip(root) {
	if (initialized.has(root)) return;
	initialized.add(root);

	const track = root.querySelector(".StoneProductTrackV5");
	const cards = Array.from(root.querySelectorAll(".StoneProductThumbV5"));
	const more = root.querySelector(".StoneProductMoreV5");

	if (more && track) {
	more.addEventListener("click", () => {
	const isOpen = track.classList.toggle("IsMobileExpanded");
	more.textContent = isOpen ? more.dataset.moreOpen : more.dataset.moreClosed;
	});
	}

	cards.forEach((card) => {
	card.addEventListener("click", () => openLightbox(root, Number(card.dataset.index || 0)));
	});

	initLightbox(root);

	if (root.dataset.autoSlide !== "false" && cards.length > 6 && track) {
	initCarousel(root, track, cards);
	}
	}

	function initCarousel(root, track, cards) {
	let station = 0;
	let dir = 1;
	let timer = 0;
	let moving = false;
	const rows = 2;
	const visibleCols = Math.max(1, Number(root.dataset.visibleColumns || 3));
	const dwellMs = Math.max(500, Number(root.dataset.dwellMs || 2000));
	const moveMs = Math.max(120, Number(root.dataset.moveMs || 760));
	const colorizeMs = Math.max(120, Number(root.dataset.colorizeMs || 500));

	function totalCols() {
	return Math.ceil(cards.length / rows);
	}

	function maxStation() {
	return Math.max(0, totalCols() - visibleCols);
	}

	function colWidth() {
	if (cards.length === 0) return 0;
	const first = cards[0];
	const rect = first.getBoundingClientRect();
	const style = window.getComputedStyle(track);
	const gap = parseFloat(style.columnGap || style.gap || "0") || 0;
	return rect.width + gap;
	}

	function applyTransform() {
	track.style.transform = `translate3d(${-station * colWidth()}px, 0, 0)`;
	}

	function clearEntering() {
	cards.forEach((card) => card.classList.remove("IsEntering", "IsColoring", "IsReleased"));
	}

	function markColumn(col) {
	clearEntering();
	cards.forEach((card, index) => {
	if (Math.floor(index / rows) === col) card.classList.add("IsEntering");
	});
	}

	function releaseMarked() {
	const marked = cards.filter((card) => card.classList.contains("IsEntering"));
	marked.forEach((card) => {
	card.classList.remove("IsEntering");
	card.classList.add("IsColoring");
	});

	requestAnimationFrame(() => {
	requestAnimationFrame(() => {
	marked.forEach((card) => card.classList.add("IsReleased"));
	window.setTimeout(() => {
	marked.forEach((card) => card.classList.remove("IsColoring", "IsReleased"));
	}, colorizeMs + 80);
	});
	});
	}

	function step() {
	if (mqlMobile.matches || moving || maxStation() <= 0) {
	timer = window.setTimeout(step, dwellMs);
	return;
	}

	let next = station + dir;
	if (next > maxStation()) {
	dir = -1;
	next = station + dir;
	}
	if (next < 0) {
	dir = 1;
	next = station + dir;
	}

	const enteringCol = dir > 0 ? next + visibleCols - 1 : next;
	markColumn(enteringCol);
	moving = true;
	station = next;
	applyTransform();

	window.setTimeout(() => {
	moving = false;
	releaseMarked();
	timer = window.setTimeout(step, dwellMs);
	}, moveMs + 40);
	}

	function resetForViewport() {
	window.clearTimeout(timer);
	if (mqlMobile.matches) {
	track.style.transform = "";
	clearEntering();
	return;
	}

	station = Math.min(station, maxStation());
	applyTransform();
	timer = window.setTimeout(step, dwellMs);
	}

	window.addEventListener("resize", debounce(resetForViewport, 160));
	mqlMobile.addEventListener?.("change", resetForViewport);
	resetForViewport();
	}

	function initLightbox(root) {
	const box = root.querySelector(".StoneProductLightboxV5");
	if (!box) return;

	box.querySelector(".StoneProductCloseV5")?.addEventListener("click", () => closeLightbox(box));
	box.querySelector(".StoneProductPrevV5")?.addEventListener("click", () => shiftLightbox(box, -1));
	box.querySelector(".StoneProductNextV5")?.addEventListener("click", () => shiftLightbox(box, 1));
	box.addEventListener("click", (event) => {
	if (event.target === box) closeLightbox(box);
	});

	box.querySelectorAll(".StoneProductFilmItemV5").forEach((item) => {
	item.addEventListener("click", () => setLightboxIndex(box, Number(item.dataset.index || 0)));
	});
	}

	function openLightbox(root, index) {
	const box = root.querySelector(".StoneProductLightboxV5");
	if (!box) return;

	setLightboxIndex(box, index);
	box.hidden = false;
	box.setAttribute("aria-hidden", "false");
	activeLightbox = box;
	document.documentElement.classList.add("StoneProductNoScrollV5");
	box.querySelector(".StoneProductCloseV5")?.focus({ preventScroll: true });
	}

	function closeLightbox(box) {
	box.hidden = true;
	box.setAttribute("aria-hidden", "true");
	if (activeLightbox === box) activeLightbox = null;
	document.documentElement.classList.remove("StoneProductNoScrollV5");
	}

	function shiftLightbox(box, delta) {
	const items = Array.from(box.querySelectorAll(".StoneProductFilmItemV5"));
	if (items.length === 0) return;

	const current = Number(box.dataset.currentIndex || 0);
	const next = (current + delta + items.length) % items.length;
	setLightboxIndex(box, next);
	}

	function setLightboxIndex(box, index) {
	const items = Array.from(box.querySelectorAll(".StoneProductFilmItemV5"));
	if (items.length === 0) return;

	const safeIndex = ((index % items.length) + items.length) % items.length;
	const item = items[safeIndex];
	const img = box.querySelector(".StoneProductLightboxImgV5");
	const title = box.querySelector(".StoneProductLightboxTitleV5 strong");
	const use = box.querySelector(".StoneProductLightboxTitleV5 small");

	if (img) {
	img.src = item.dataset.src || "";
	img.alt = item.dataset.alt || "";
	}
	if (title) title.textContent = item.dataset.name || "";
	if (use) use.textContent = item.dataset.use || "";

	items.forEach((filmItem) => filmItem.classList.remove("IsActive"));
	item.classList.add("IsActive");
	item.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
	box.dataset.currentIndex = String(safeIndex);
	}

	function debounce(fn, wait) {
	let timer = 0;
	return () => {
	window.clearTimeout(timer);
	timer = window.setTimeout(fn, wait);
	};
	}

	document.addEventListener("keydown", (event) => {
	if (!activeLightbox) return;
	if (event.key === "Escape") closeLightbox(activeLightbox);
	if (event.key === "ArrowLeft") shiftLightbox(activeLightbox, -1);
	if (event.key === "ArrowRight") shiftLightbox(activeLightbox, 1);
	});

	if (document.readyState === "loading") {
	document.addEventListener("DOMContentLoaded", boot, { once: true });
	} else {
	boot();
	}

	document.addEventListener("astro:page-load", boot);
	})();
</script>
