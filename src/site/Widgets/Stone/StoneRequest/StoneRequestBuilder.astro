		function OpenNewItem() {
			const cExistingWorking = cState.ui?.workingItem;
			if (cExistingWorking && !cState.ui.editingItemId) OpenItem(cExistingWorking, "");
			else OpenItem(NewItem(), "");
		}

		function OpenItem(pItem, pEditingId) {
			cState.ui.workingItem = NormalizeItem(DeepClone(pItem));
			cState.ui.editingItemId = pEditingId || "";
			cState.ui.currentStep = Math.max(0, Math.min(4, Number(cState.ui.currentStep) || 0));
			FillItemForm(cState.ui.workingItem);
			RenderMeasurements();
			RenderAttachments();
			SetText(pRoot.querySelector("[data-item-mode-label='true']"), pEditingId ? "تعديل صنف قائم" : "إضافة صنف جديد");
			SetText(pRoot.querySelector("[data-item-dialog-title='true']"), cState.ui.workingItem.title || UsageLabel(cState.ui.workingItem.usageType) || "بيانات الصنف");
			OpenOverlay(cItemOverlay);
			GoItemStep(cState.ui.currentStep, false);
			TouchDraft(false);
		}

		function FillItemForm(pItem) {
			if (!cItemForm) return;
			cItemForm.reset();
			SetFormValue(cItemForm, "usageType", pItem.usageType);
			SetFormValue(cItemForm, "title", pItem.title);
			SetFormValue(cItemForm, "location", pItem.location);
			SetFormValue(cItemForm, "workState", pItem.workState || "جديد");
			SetCheckboxes(cItemForm, "itemServices", pItem.services);
			SetFormValue(cItemForm, "itemDescription", pItem.description);
			SetFormValue(cItemForm, "materialCategory", pItem.material.category);
			SetFormValue(cItemForm, "materialOrigin", pItem.material.origin || "غير محدد");
			SetFormValue(cItemForm, "materialName", pItem.material.name);
			SetFormValue(cItemForm, "materialColor", pItem.material.color);
			SetFormValue(cItemForm, "materialPattern", pItem.material.pattern || "غير محدد");
			SetFormValue(cItemForm, "thicknessCm", pItem.material.thicknessCm);
