			SetFormValue(cProjectForm, "phone", cState.customer.phone);
			SetFormValue(cProjectForm, "whatsapp", cState.customer.whatsapp);
			SetFormValue(cProjectForm, "customerRole", cState.customer.role || "مالك المشروع");
			SetFormValue(cProjectForm, "contactTime", cState.customer.contactTime || "أي وقت");
			SetFormValue(cProjectForm, "governorate", cState.project.governorate);
			SetFormValue(cProjectForm, "city", cState.project.city);
			SetFormValue(cProjectForm, "district", cState.project.district);
			SetFormValue(cProjectForm, "projectType", cState.project.type || "شقة");
			SetFormValue(cProjectForm, "siteState", cState.project.siteState || "جاهز للقياس والتركيب");
			SetFormValue(cProjectForm, "executionTime", cState.project.executionTime || "في أقرب وقت");
			SetFormValue(cProjectForm, "floor", cState.logistics.floor);
			SetFormValue(cProjectForm, "elevator", cState.logistics.elevator || "غير محدد");
			SetFormValue(cProjectForm, "liftingAccess", cState.logistics.liftingAccess || "رفع عادي");
			SetFormValue(cProjectForm, "vehicleAccess", cState.logistics.vehicleAccess || "أمام المدخل");
			SetFormValue(cProjectForm, "workRestrictions", cState.logistics.workRestrictions);
			SetFormValue(cProjectForm, "generalNotes", cState.project.generalNotes);
