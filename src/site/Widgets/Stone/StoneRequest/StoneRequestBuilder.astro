---
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import StoneRequestHeader from "./StoneRequestHeader.astro";
import StoneRequestResume from "./StoneRequestResume.astro";
import StoneRequestItemsTable from "./StoneRequestItemsTable.astro";
import StoneRequestProjectOverlay from "./StoneRequestProjectOverlay.astro";
import StoneRequestItemOverlay from "./StoneRequestItemOverlay.astro";
import StoneRequestReviewOverlay from "./StoneRequestReviewOverlay.astro";

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	/** API used to save, resume and submit StoneReq drafts. DefVal = "/api/stone-req" */
	pApiUrl?: string;

	/** Logical source page stored with the request. DefVal = "صفحة الرخام والجرانيت" */
	pSourcePage?: string;

	/** Main widget title. */
	pTitle?: string;

	/** Short explanation below the title. */
	pDesc?: string;

	/** IndexedDB record key. Change it only when separate drafts are required on the same site. */
	pStorageKey?: string;

	/** Maximum compressed images stored inside one item. DefVal = 5 */
	pMaxAttachments?: number;

	/** Approximate maximum size of each compressed image in KB. DefVal = 300 */
	pMaxImageKb?: number;

	/** Maximum decoded image payload across the whole request in MB. Capped at 2.5 for Vercel payload safety. DefVal = 2.5 */
	pMaxRequestImageMb?: number;
}

const cProps = Astro.props as Props & Record<string, unknown>;
const {
	pApiUrl = "/api/stone-req",
	pSourcePage = "صفحة الرخام والجرانيت",
	pTitle = "كوّن طلبية الرخام أو الجرانيت",
	pDesc = "أضف كل صنف ومقاس على حدة. بياناتك تُحفظ تلقائيًا ويمكنك استكمال الطلب لاحقًا.",
	pStorageKey = "EmoStoneRequestDraftV1",
	pMaxAttachments = 5,
	pMaxImageKb = 300,
	pMaxRequestImageMb = 2.5,

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("StoneRequestBuilder"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";
	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => pValue === undefined || pValue === null ? "" : `${pName.startsWith("--") ? pName : pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`)}:${pValue};`)
		.filter(Boolean)
		.join(" ");
}

const cStyle = `
	--StoneReqHead:#273548;
	--StoneReqHead2:#172331;
	--StoneReqPanel:#f4f6f8;
	--StoneReqText:#17202a;
	--StoneReqMuted:#657180;
	--StoneReqBorder:#d9dfe5;
	--StoneReqAccent:#177a72;
	--StoneReqAccentSoft:#dff3f0;
	--StoneReqOk:#177245;
	--StoneReqOkSoft:#e0f4e8;
	--StoneReqWarnSoft:#fff4d6;
	--StoneReqDanger:#ad2c35;
	--StoneReqRadius:20px;
	${GetStyleText(pGivenStyle)}
`;
const cPlace = new Place(cProps as PlaceProps, cStyle);
---

<section
	class={`StoneRequestBuilder ${cPlace.Class} ${pGivenClass}`.trim()}
	style={cPlace.Style}
	id={pGivenID}
	dir="rtl"
	data-stone-request-builder="true"
	data-api-url={pApiUrl}
	data-source-page={pSourcePage}
	data-storage-key={pStorageKey}
	data-max-attachments={Math.max(1, Math.trunc(pMaxAttachments))}
	data-max-image-kb={Math.max(100, Math.trunc(pMaxImageKb))}
	data-max-request-image-mb={Math.min(2.5, Math.max(1, Number(pMaxRequestImageMb) || 2.5))}
	{...RemAttr}
>
	<StoneRequestHeader pTitle={pTitle} pDesc={pDesc} />
	<StoneRequestResume />
	<StoneRequestItemsTable />
	<StoneRequestProjectOverlay />
	<StoneRequestItemOverlay />
	<StoneRequestReviewOverlay />

	<footer class="StoneReqBuilderFoot">
		<p><strong>الحفظ التلقائي:</strong> يحتفظ بكل تعديل على هذا الجهاز، وبعد وجود بيانات فعلية ينشئ مسودة آمنة على الخادم يمكن استكمالها من رابط خاص.</p>
		<p data-builder-message="true"></p>
	</footer>
</section>

<style>
	.StoneRequestBuilder {
		width: min(1280px, 100%);
		margin-inline: auto;
		box-sizing: border-box;
		color: var(--StoneReqText);
		font-family: inherit;
		border-radius: var(--StoneReqRadius);
		box-shadow: 0 18px 55px rgba(28, 38, 49, .14);
	}

	.StoneReqBuilderFoot {
		display: grid;
		gap: 5px;
		padding: 16px 20px;
		background: var(--StoneReqPanel);
		border: 1px solid var(--StoneReqBorder);
		border-top: 0;
		border-radius: 0 0 var(--StoneReqRadius) var(--StoneReqRadius);
	}

	.StoneReqBuilderFoot p {
		margin: 0;
		color: var(--StoneReqMuted);
		font-size: 13px;
		line-height: 1.8;
	}

	.StoneReqBuilderFoot p[data-mode="error"] {
		color: var(--StoneReqDanger);
		font-weight: 800;
	}

	.StoneReqBuilderFoot p[data-mode="success"] {
		color: var(--StoneReqOk);
		font-weight: 800;
	}
</style>

<script is:inline>
(function () {
	const cRoots = document.querySelectorAll("[data-stone-request-builder='true']");
	for (const cRoot of cRoots) RegisterStoneRequestBuilder(cRoot);

	function RegisterStoneRequestBuilder(pRoot) {
		if (!pRoot || pRoot.dataset.ready === "true") return;
		pRoot.dataset.ready = "true";

		const cUsage = {
			kitchen: { label: "مطبخ أو كاونتر", pieces: ["رخامة رئيسية", "رخامة جانبية", "جزيرة", "بار", "وزرة", "حائط خلفي Backsplash", "جانب هابط"] },
			stairs: { label: "سلم", pieces: ["نائمة", "قائمة", "بسطة", "وزرة سلم", "صدفة أو حافة", "برامق"] },
			floor: { label: "أرضيات", pieces: ["منطقة أرضية", "إطار محيط", "ميدالية", "وزرة أرضية", "عتبة انتقال"] },
			wall: { label: "حوائط داخلية", pieces: ["لوح حائط", "منطقة تكسية", "ركن", "حلية", "نيش", "وزرة حائط"] },
			facade: { label: "واجهة أو مدخل خارجي", pieces: ["لوح واجهة", "عمود", "كرنيش", "حلية", "عتب فتحة", "جلسة خارجية", "درج مدخل"] },
			sills: { label: "جلسات وأعتاب ووزرات", pieces: ["جلسة شباك", "عتب باب", "عتب مصعد", "وزرة", "حلق", "قفلة جانبية"] },
			bathroom: { label: "حمام أو وحدة حوض", pieces: ["رخامة حوض", "رف", "نيش", "عتبة شاور", "جلسة بانيو", "وزرة", "جانب هابط"] },
			furniture: { label: "ترابيزة أو أثاث", pieces: ["سطح ترابيزة", "جانب", "قاعدة", "رف", "قطعة ديكور"] },
			decor: { label: "مدفأة أو ديكور خاص", pieces: ["واجهة مدفأة", "رف مدفأة", "حلية", "لوح ديكور", "قاعدة", "قطعة خاصة"] },
			other: { label: "استخدام آخر", pieces: ["قطعة", "لوح", "بلاطة", "وزرة", "حلية", "قطعة خاصة"] },
		};

		const cApiUrl = pRoot.dataset.apiUrl || "/api/stone-req";
		const cSourcePage = pRoot.dataset.sourcePage || "صفحة الرخام والجرانيت";
		const cStorageKey = pRoot.dataset.storageKey || "EmoStoneRequestDraftV1";
		const cMaxAttachments = Math.max(1, Number(pRoot.dataset.maxAttachments) || 5);
		const cMaxImageBytes = Math.max(100, Number(pRoot.dataset.maxImageKb) || 300) * 1024;
		const cMaxRequestImageBytes = Math.min(2.5, Math.max(1, Number(pRoot.dataset.maxRequestImageMb) || 2.5)) * 1024 * 1024;
		const cProjectOverlay = pRoot.querySelector("[data-project-overlay='true']");
		const cProjectForm = pRoot.querySelector("[data-project-form='true']");
		const cItemOverlay = pRoot.querySelector("[data-item-overlay='true']");
		const cItemForm = pRoot.querySelector("[data-item-form='true']");
		const cReviewOverlay = pRoot.querySelector("[data-review-overlay='true']");
		const cResumePanel = pRoot.querySelector("[data-resume-panel='true']");
		const cMessage = pRoot.querySelector("[data-builder-message='true']");
		const cSaveState = pRoot.querySelector("[data-save-state='true']");
		const cCompletion = pRoot.querySelector("[data-completion='true']");
		const cItemsBody = pRoot.querySelector("[data-items-body='true']");
		const cEmptyState = pRoot.querySelector("[data-empty-state='true']");
		const cMeasureBody = pRoot.querySelector("[data-measure-body='true']");
		const cAttachmentInput = pRoot.querySelector("[data-attachment-input='true']");
		let cState = NewDraft();
		let cPendingLocal = null;
		let cSaveTimer = 0;
		let cRemoteTimer = 0;
		let cSavingRemote = false;
		let cInitialized = false;
		let cPendingGalleryPrefill = null;

		Initialize();

		async function Initialize() {
			BindEvents();
			const cUrlDraft = new URL(window.location.href);
			const cDraftId = Clean(cUrlDraft.searchParams.get("stoneDraft"));
			const cToken = Clean(cUrlDraft.searchParams.get("stoneToken"));
			if (cDraftId && cToken) {
				SetSaveState("جارٍ تحميل المسودة من الخادم…");
				const cRemote = await LoadRemoteDraft(cDraftId, cToken);
				if (cRemote) {
					cState = NormalizeDraft(cRemote);
					cInitialized = true;
					RenderAll();
					SetMessage("تم استكمال الطلب المحفوظ من الخادم.", "success");
					ResumeInterruptedEditor();
					ApplyPendingGalleryPrefill();
					return;
				}
			}

			cPendingLocal = await LoadLocalDraft();
			cInitialized = true;
			if (IsMeaningful(cPendingLocal) && cPendingLocal.meta?.status !== "submitted") {
				ShowResumePrompt(cPendingLocal);
			} else {
				RenderAll();
			}
			ApplyPendingGalleryPrefill();
		}

		function BindEvents() {
			pRoot.addEventListener("click", HandleClick);
			pRoot.addEventListener("input", HandleInput);
			pRoot.addEventListener("change", HandleInput);
			cProjectForm?.addEventListener("submit", SaveProjectForm);
			cItemForm?.addEventListener("submit", SaveItemForm);
			cAttachmentInput?.addEventListener("change", HandleAttachments);
			document.addEventListener("keydown", HandleKeyDown);
			document.addEventListener("emo-stone-request-prefill", HandleGalleryPrefill);
		}

		function HandleGalleryPrefill(pEvent) {
			const cDetail = pEvent?.detail;
			if (!cDetail || typeof cDetail !== "object" || !cDetail.stone) return;
			const cTargetId = Clean(cDetail.requestBuilderId);
			if (cTargetId && pRoot.id !== cTargetId) return;
			if (!cTargetId && document.querySelector("[data-stone-request-builder='true']") !== pRoot) return;
			if (!cInitialized) {
				cPendingGalleryPrefill = cDetail;
				return;
			}
			ApplyGalleryPrefill(cDetail);
		}

		function ApplyPendingGalleryPrefill() {
			if (!cPendingGalleryPrefill) return;
			const cDetail = cPendingGalleryPrefill;
			cPendingGalleryPrefill = null;
			ApplyGalleryPrefill(cDetail);
		}

		function ApplyGalleryPrefill(pDetail) {
			const cStone = pDetail.stone || {};
			const cEstimate = pDetail.estimate || {};
			if (cPendingLocal && IsMeaningful(cPendingLocal)) {
				cState = NormalizeDraft(cPendingLocal);
				cPendingLocal = null;
				if (cResumePanel) cResumePanel.hidden = true;
				RenderAll();
			}
			PreserveWorkingItem();

			const cItem = NewItem();
			cItem.usageType = GalleryUsageKey(cEstimate.use || cStone.Uses?.[0]);
			cItem.title = `${UsageLabel(cItem.usageType) || "خامة"} - ${Clean(cStone.Name) || "اختيار من الجاليري"}`;
			cItem.location = GalleryLocationLabel(cEstimate.location);
			cItem.services = GalleryServices(cEstimate.service);
			cItem.description = Clean(cStone.Description) || "اختيار مبدئي من جاليري الخامات ويحتاج اعتماد صورة الدفعة أو اللوح الفعلي.";
			cItem.material.category = GalleryMaterialCategory(cStone.Type);
			cItem.material.origin = GalleryMaterialOrigin(cStone.Country);
			cItem.material.name = Clean(cStone.Name);
			cItem.material.color = Clean(cStone.Color);
			cItem.material.pattern = GalleryPattern(cStone.Pattern);
			cItem.material.surfaceFinish = GalleryFinish(cStone.Finishes?.[0]);
			cItem.material.priceLevel = GalleryPriceLevel(cStone.PriceLevel);
			cItem.material.sameBatchRequired = true;
			cItem.referenceUrl = Clean(pDetail.pageUrl) || window.location.href;

			const cArea = Math.max(0, Num(cEstimate.area));
			if (cArea > 0) {
				cItem.measurements = [{
					id: Uid("measure"),
					pieceType: GalleryPieceType(cItem.usageType),
					description: "مساحة تقريبية من جاليري الخامات",
					quantity: 1,
					lengthCm: 0,
					widthCm: 0,
					thicknessCm: 0,
					edgeTreatment: "",
					areaM2: Round(cArea, 2),
					areaManual: true,
					visibleEdgeM: 0,
					notes: "تُراجع المساحة بالقياس النهائي قبل التسعير.",
				}];
			}

			if (Num(cEstimate.priceFrom) > 0) {
				cItem.processing.notes = `تقدير الجاليري: ${FormatNumber(cEstimate.priceFrom)} إلى ${FormatNumber(cEstimate.priceTo)} ${Clean(cEstimate.currency)} — دقة ${Num(cEstimate.accuracy)}%. التقدير استدلالي وليس عرض سعر.`;
			}

			OpenItem(cItem, "");
			SetMessage(`تم نقل خامة ${Clean(cStone.Name) || "المختارة"} والمساحة المبدئية إلى الطلب. راجع المقاسات والتجهيزات قبل الحفظ.`, "success");
			pRoot.dispatchEvent(new CustomEvent("emo-stone-request-prefilled", { bubbles: true, detail: { item: DeepClone(cItem), source: "StoneGallery" } }));
		}

		function PreserveWorkingItem() {
			const cWorking = cState.ui?.workingItem;
			if (!cWorking || !GalleryItemHasData(cWorking)) return;
			const cNormalized = NormalizeItem(DeepClone(cWorking));
			const cEditingId = Clean(cState.ui.editingItemId);
			if (cEditingId) {
				const cIndex = cState.items.findIndex((pItem) => pItem.id === cEditingId);
				if (cIndex >= 0) cState.items[cIndex] = cNormalized;
			} else if (!cState.items.some((pItem) => pItem.id === cNormalized.id)) {
				cState.items.push(cNormalized);
			}
		}

		function GalleryItemHasData(pItem) {
			return Boolean(Clean(pItem.title) || Clean(pItem.material?.name) || Clean(pItem.material?.color) || pItem.measurements?.length || pItem.attachments?.length);
		}

		function GalleryUsageKey(pValue) {
			const cValue = Clean(pValue).toLowerCase();
			if (cValue.includes("مطبخ") || cValue.includes("كاونتر")) return "kitchen";
			if (cValue.includes("سلم") || cValue.includes("سلالم") || cValue.includes("درج")) return "stairs";
			if (cValue.includes("أرض") || cValue.includes("ارض")) return "floor";
			if (cValue.includes("حائط") || cValue.includes("حوائط") || cValue.includes("تكسية")) return "wall";
			if (cValue.includes("واجهة") || cValue.includes("مدخل")) return "facade";
			if (cValue.includes("جلس") || cValue.includes("عتب") || cValue.includes("وزر")) return "sills";
			if (cValue.includes("حمام") || cValue.includes("حوض")) return "bathroom";
			if (cValue.includes("ترابيزة") || cValue.includes("أثاث") || cValue.includes("اثاث")) return "furniture";
			if (cValue.includes("ديكور") || cValue.includes("مدفأة") || cValue.includes("مدفاه")) return "decor";
			return "other";
		}

		function GalleryMaterialCategory(pValue) {
			const cValue = Clean(pValue);
			if (cValue.includes("جرانيت")) return "جرانيت";
			if (cValue.includes("كوارتز")) return "كوارتز صناعي";
			if (cValue.includes("رخام")) return "رخام";
			return "حجر طبيعي";
		}

		function GalleryMaterialOrigin(pValue) {
			const cValue = Clean(pValue);
			if (!cValue || cValue === "غير محدد") return "غير محدد";
			if (cValue.includes("مصر") || cValue.includes("مصري") || cValue.toLowerCase().includes("egypt")) return "مصري";
			return "مستورد";
		}

		function GalleryPattern(pValue) {
			const cValue = Clean(pValue);
			if (cValue.includes("حبيب") || cValue.includes("نقط")) return "حبيبات";
			if (cValue.includes("قوي") || cValue.includes("واضح") || cValue.includes("عريض")) return "عروق قوية";
			if (cValue.includes("عرق") || cValue.includes("هادئ") || cValue.includes("هادي")) return "عروق هادئة";
			if (cValue.includes("ساد") || cValue.includes("متجانس")) return "سادة أو متجانس";
			return "غير محدد";
		}

		function GalleryFinish(pValue) {
			const cValue = Clean(pValue).toLowerCase();
			if (cValue.includes("مطفي") || cValue.includes("honed")) return "مطفي Honed";
			if (cValue.includes("محروق") || cValue.includes("flamed")) return "محروق Flamed";
			if (cValue.includes("خشن") || cValue.includes("انزلاق")) return "خشن مضاد للانزلاق";
			if (cValue.includes("معتق") || cValue.includes("خاص")) return "معتق أو خاص";
			if (cValue.includes("مصقول") || cValue.includes("لامع") || cValue.includes("polished")) return "لامع مصقول";
			return "غير محدد";
		}

		function GalleryPriceLevel(pValue) {
			const cValue = Clean(pValue);
			if (cValue === "اقتصادي" || cValue === "متوسط") return cValue;
			if (cValue === "فاخر" || cValue === "مرتفع") return "مرتفع";
			return "غير محدد";
		}

		function GalleryServices(pValue) {
			if (Clean(pValue) === "supply") return ["توريد"];
			if (Clean(pValue) === "selection") return ["توريد"];
			return ["توريد", "قص وتجهيز", "نقل ورفع", "تركيب"];
		}

		function GalleryLocationLabel(pValue) {
			if (pValue === "cairo-giza") return "القاهرة أو الجيزة";
			if (pValue === "other-egypt") return "محافظة أخرى داخل مصر";
			if (pValue === "remote-egypt") return "مشروع داخل مصر بمتابعة عن بُعد";
			if (pValue === "outside-egypt") return "مشروع خارج مصر";
			return "";
		}

		function GalleryPieceType(pUsage) {
			if (pUsage === "stairs") return "سلم أو مجموعة درجات";
			if (pUsage === "floor") return "منطقة أرضية";
			if (pUsage === "wall" || pUsage === "facade") return "منطقة تكسية";
			return "مساحة تقريبية";
		}

		function FormatNumber(pValue) {
			return new Intl.NumberFormat("ar-EG", { maximumFractionDigits: 0 }).format(Math.round(Num(pValue)));
		}

		function HandleKeyDown(pEvent) {
			if (pEvent.key !== "Escape") return;
			if (IsOpen(cReviewOverlay)) CloseOverlay(cReviewOverlay);
			else if (IsOpen(cItemOverlay)) CloseOverlay(cItemOverlay);
			else if (IsOpen(cProjectOverlay)) CloseOverlay(cProjectOverlay);
		}

		function HandleClick(pEvent) {
			const cButton = pEvent.target.closest("button");
			if (!cButton || !pRoot.contains(cButton)) return;
			const cAction = cButton.dataset.action || "";
			const cRowAction = cButton.dataset.rowAction || "";
			if (cAction) {
				pEvent.preventDefault();
				RunAction(cAction, cButton);
				return;
			}
			if (cRowAction) {
				pEvent.preventDefault();
				RunRowAction(cRowAction, cButton.dataset.itemId || "");
				return;
			}
			if (cButton.dataset.stepJump !== undefined) {
				pEvent.preventDefault();
				GoItemStep(Number(cButton.dataset.stepJump));
			}
		}

		function RunAction(pAction, pButton) {
			if (pAction === "edit-project") OpenProject();
			else if (pAction === "close-project") CloseOverlay(cProjectOverlay);
			else if (pAction === "add-item") OpenNewItem();
			else if (pAction === "close-item") CloseOverlay(cItemOverlay);
			else if (pAction === "add-measure") AddMeasure();
			else if (pAction === "item-prev") GoItemStep(CurrentItemStep() - 1);
			else if (pAction === "item-next") GoItemStep(CurrentItemStep() + 1);
			else if (pAction === "save-item") cItemForm?.requestSubmit();
			else if (pAction === "save-item-draft") SaveWorkingItemDraft();
			else if (pAction === "review-order") OpenOrderReview();
			else if (pAction === "close-review") CloseOverlay(cReviewOverlay);
			else if (pAction === "save-later") SaveAndShowResume();
			else if (pAction === "save-draft-now") SaveAndShowResume();
			else if (pAction === "copy-resume-link") CopyResumeLink();
			else if (pAction === "submit-order") SubmitOrder(pButton);
			else if (pAction === "resume-local") ResumeLocal();
			else if (pAction === "discard-local") DiscardLocal();
			else if (pAction === "remove-attachment") RemoveAttachment(Number(pButton.dataset.attachmentIndex));
			else if (pAction === "remove-measure") RemoveMeasure(Number(pButton.dataset.measureIndex));
		}

		function RunRowAction(pAction, pItemId) {
			const cIndex = cState.items.findIndex((pItem) => pItem.id === pItemId);
			if (cIndex < 0) return;
			if (pAction === "edit") OpenItem(cState.items[cIndex], pItemId);
			if (pAction === "duplicate") {
				const cCopy = DeepClone(cState.items[cIndex]);
				cCopy.id = Uid("item");
				cCopy.title = `${cCopy.title || UsageLabel(cCopy.usageType)} - نسخة`;
				cCopy.measurements = (cCopy.measurements || []).map((pMeasure) => ({ ...pMeasure, id: Uid("measure") }));
				cCopy.attachments = [];
				cCopy.createdAt = NowIso();
				cCopy.updatedAt = NowIso();
				cState.items.splice(cIndex + 1, 0, NormalizeItem(cCopy));
				TouchDraft();
				RenderAll();
			}
			if (pAction === "delete") {
				if (!window.confirm("حذف هذا الصنف بكل مقاساته؟")) return;
				cState.items.splice(cIndex, 1);
				TouchDraft();
				RenderAll();
			}
		}

		function HandleInput(pEvent) {
			const cTarget = pEvent.target;
			if (cProjectForm?.contains(cTarget)) {
				ApplyProjectFormToState();
				TouchDraft(true);
				return;
			}
			if (!cItemForm?.contains(cTarget)) return;
			if (cTarget.closest("[data-measure-row='true']")) UpdateMeasureFromInput(cTarget);
			else ApplyItemFormToWorking();
			if (cTarget.matches("[data-usage-type='true']")) RenderMeasurements();
			TouchDraft(true);
		}

		function OpenProject() {
			FillProjectForm();
			OpenOverlay(cProjectOverlay);
			cProjectForm?.querySelector("input")?.focus();
		}

		function SaveProjectForm(pEvent) {
			pEvent.preventDefault();
			ApplyProjectFormToState();
			const cError = pRoot.querySelector("[data-project-error='true']");
			if (!Clean(cState.customer.name) || !Clean(cState.customer.phone)) {
				SetText(cError, "الاسم ورقم الهاتف مطلوبان قبل الإرسال النهائي، ويمكن حفظ المسودة بدونهما محليًا.");
			} else SetText(cError, "");
			TouchDraft();
			RenderAll();
			CloseOverlay(cProjectOverlay);
		}

