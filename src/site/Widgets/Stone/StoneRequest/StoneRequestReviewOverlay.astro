<section class="StoneReqOverlay" data-review-overlay="true" hidden aria-hidden="true">
	<div class="StoneReqDialog StoneReqReviewDialog">
		<header class="StoneReqDialogHead">
			<div>
				<p>مراجعة الطلب قبل الإرسال</p>
				<h3>ملخص طلب المقايسة</h3>
			</div>
			<button type="button" data-action="close-review" aria-label="إغلاق">×</button>
		</header>

		<div class="StoneReqOrderReview" data-order-review="true"></div>

		<section class="StoneReqResumeLink" data-resume-link-box="true" hidden>
			<strong>رابط استكمال الطلب</strong>
			<p>احتفظ بهذا الرابط للعودة إلى الطلب من أي جهاز.</p>
			<div>
				<input type="text" readonly data-resume-link="true" />
				<button type="button" data-action="copy-resume-link">نسخ الرابط</button>
			</div>
		</section>

		<footer class="StoneReqDialogFoot">
			<span data-submit-status="true"></span>
			<button type="button" data-action="close-review">العودة للتعديل</button>
			<button type="button" data-action="save-draft-now">حفظ كمسودة</button>
			<button type="button" data-action="submit-order" class="Primary">إرسال طلب المقايسة</button>
		</footer>
	</div>
</section>

<style>
	.StoneReqOverlay {
		position: fixed;
		inset: 0;
		z-index: 1000000;
		display: grid;
		place-items: center;
		padding: 18px;
		background: rgba(14, 18, 24, .72);
		backdrop-filter: blur(6px);
		direction: rtl;
	}

	.StoneReqOverlay[hidden],
	.StoneReqResumeLink[hidden] {
		display: none;
	}

	.StoneReqDialog {
		width: min(1050px, 100%);
		max-height: min(900px, calc(100vh - 36px));
		overflow: auto;
		background: #fff;
		color: var(--StoneReqText);
		border-radius: 18px;
		box-shadow: 0 24px 80px rgba(0, 0, 0, .34);
	}

	.StoneReqDialogHead,
	.StoneReqDialogFoot {
		position: sticky;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 15px 18px;
		background: #fff;
	}

	.StoneReqDialogHead {
		top: 0;
		justify-content: space-between;
		border-bottom: 1px solid var(--StoneReqBorder);
	}

	.StoneReqDialogHead p,
	.StoneReqDialogHead h3 {
		margin: 0;
	}

	.StoneReqDialogHead p {
		font-size: 12px;
		color: var(--StoneReqMuted);
	}

	.StoneReqDialogHead h3 {
		font-size: 24px;
	}

	.StoneReqDialogHead > button {
		width: 40px;
		height: 40px;
		border: 1px solid var(--StoneReqBorder);
		border-radius: 10px;
		background: var(--StoneReqPanel);
		font-size: 25px;
		cursor: pointer;
	}

	.StoneReqOrderReview {
		display: grid;
		gap: 14px;
		padding: 20px;
	}

	.StoneReqOrderBlock {
		padding: 16px;
		border: 1px solid var(--StoneReqBorder);
		border-radius: 13px;
		background: var(--StoneReqPanel);
	}

	.StoneReqOrderBlock h4,
	.StoneReqOrderBlock p {
		margin: 0;
	}

	.StoneReqOrderBlock h4 {
		margin-bottom: 7px;
	}

	.StoneReqOrderBlock p {
		line-height: 1.9;
		color: var(--StoneReqMuted);
	}

	.StoneReqOrderItems {
		display: grid;
		gap: 9px;
	}

	.StoneReqOrderItem {
		padding: 13px;
		border: 1px solid var(--StoneReqBorder);
		border-radius: 10px;
		background: #fff;
	}

	.StoneReqOrderItem strong {
		display: block;
		margin-bottom: 5px;
	}

	.StoneReqMissing {
		color: var(--StoneReqDanger);
		font-weight: 800;
	}

	.StoneReqResumeLink {
		margin: 0 20px 20px;
		padding: 15px;
		border: 1px solid var(--StoneReqBorder);
		border-radius: 12px;
		background: var(--StoneReqAccentSoft);
	}

	.StoneReqResumeLink p {
		margin: 5px 0 10px;
		color: var(--StoneReqMuted);
	}

	.StoneReqResumeLink > div {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 8px;
	}

	.StoneReqResumeLink input {
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--StoneReqBorder);
		border-radius: 9px;
		padding: 10px;
		font: inherit;
		direction: ltr;
	}

	.StoneReqResumeLink button,
	.StoneReqDialogFoot button {
		border: 1px solid var(--StoneReqBorder);
		border-radius: 10px;
		background: #fff;
		padding: 10px 16px;
		font: inherit;
		font-weight: 800;
		cursor: pointer;
	}

	.StoneReqDialogFoot {
		bottom: 0;
		justify-content: flex-end;
		border-top: 1px solid var(--StoneReqBorder);
	}

	.StoneReqDialogFoot span {
		margin-inline-end: auto;
		font-size: 13px;
		font-weight: 800;
	}

	.StoneReqDialogFoot span[data-mode="error"] {
		color: var(--StoneReqDanger);
	}

	.StoneReqDialogFoot span[data-mode="success"] {
		color: var(--StoneReqOk);
	}

	.StoneReqDialogFoot .Primary {
		background: var(--StoneReqAccent);
		border-color: var(--StoneReqAccent);
		color: #fff;
	}

	@media (max-width: 650px) {
		.StoneReqOverlay {
			padding: 0;
		}

		.StoneReqDialog {
			min-height: 100vh;
			max-height: 100vh;
			border-radius: 0;
		}

		.StoneReqDialogFoot {
			flex-wrap: wrap;
		}

		.StoneReqDialogFoot span {
			width: 100%;
		}

		.StoneReqResumeLink > div {
			grid-template-columns: 1fr;
		}
	}
</style>

<style is:global>
	[data-review-overlay="true"] .StoneReqOrderBlock {
		padding: 16px;
		border: 1px solid var(--StoneReqBorder);
		border-radius: 13px;
		background: var(--StoneReqPanel);
	}

	[data-review-overlay="true"] .StoneReqOrderBlock h4,
	[data-review-overlay="true"] .StoneReqOrderBlock p {
		margin: 0;
	}

	[data-review-overlay="true"] .StoneReqOrderBlock h4 {
		margin-bottom: 7px;
	}

	[data-review-overlay="true"] .StoneReqOrderBlock p {
		line-height: 1.9;
		color: var(--StoneReqMuted);
	}

	[data-review-overlay="true"] .StoneReqOrderItems {
		display: grid;
		gap: 9px;
	}

	[data-review-overlay="true"] .StoneReqOrderItem {
		padding: 13px;
		border: 1px solid var(--StoneReqBorder);
		border-radius: 10px;
		background: #fff;
	}

	[data-review-overlay="true"] .StoneReqOrderItem strong {
		display: block;
		margin-bottom: 5px;
	}

	[data-review-overlay="true"] .StoneReqMissing {
		color: var(--StoneReqDanger);
		font-weight: 800;
	}
</style>
