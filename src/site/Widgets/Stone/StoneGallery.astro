---
import { existsSync, readdirSync, readFileSync } from "fs";
import { basename, dirname, extname, isAbsolute, relative, resolve } from "path";
import { fileURLToPath } from "url";
import { Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import { CreateStoneGalleryExcelImageMatcher, ReadStoneGalleryExcelFile } from "./StoneGalleryExcel";

type CssValue = string | number;
type StoneImageRole = "sample" | "slab" | "application" | "detail";

export interface StoneGalleryImageInput {
	File?: string;
	Src?: string;
	Alt?: string;
	Label?: string;
	Role?: StoneImageRole | string;
}

export interface StoneGalleryItemInput {
	Id?: string;
	Name?: string;
	NameAr?: string;
	File?: string;
	Image?: string;
	Src?: string;
	Alt?: string;
	Type?: string;
	Kind?: string;
	Country?: string;
	Origin?: string;
	Color?: string;
	Pattern?: string;
	Description?: string;
	Desc?: string;
	Uses?: string | string[];
	Use?: string | string[];
	Finishes?: string | string[];
	Finish?: string | string[];
	Available?: boolean | string;
	Badge?: string;
	PriceFrom?: number | string;
	PriceTo?: number | string;
	PriceLevel?: string;
	Currency?: string;
	SlabFile?: string;
	SlabImage?: string;
	ApplicationFile?: string;
	ApplicationImage?: string;
	Images?: Array<string | StoneGalleryImageInput>;
	Tags?: string | string[];
	[key: string]: unknown;
}

type NormalizedStoneImage = {
	Src: string;
	Alt: string;
	Label: string;
	Role: StoneImageRole;
};

type NormalizedStoneItem = {
	Id: string;
	Name: string;
	Alt: string;
	Type: string;
	Country: string;
	Color: string;
	Pattern: string;
	Description: string;
	Uses: string[];
	Finishes: string[];
	Available: boolean;
	Badge: string;
	PriceFrom: number;
	PriceTo: number;
	PriceLevel: string;
	Currency: string;
	Images: NormalizedStoneImage[];
	PrimaryImage: string;
	Tags: string[];
	SearchText: string;
};

interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
	/** بيانات جاهزة مباشرة. عند تمريرها لها أولوية على Excel وJSON ومسح الفولدر. */
	pItems?: StoneGalleryItemInput[];

	/** فولدر صور الخامات داخل public. */
	pFolder?: string;

	/** ملف Excel داخل pFolder. إذا كان موجودًا تكون له أولوية على JSON ومسح الفولدر. */
	pExcel?: string;

	/** اسم ورقة بيانات الخامات داخل ملف Excel. */
	pExcelSheet?: string;

	/** إظهار تحذيرات المطابقة في طرفية البناء للملفات الناقصة أو الأسماء المكررة. */
	pExcelWarnings?: boolean;

	/** ملف بيانات اختياري داخل pFolder. يدعم array أو Stones / stones / Products / products. */
	pJson?: string;

	/** يبحث داخل الفولدرات الفرعية أثناء ربط Excel أو عند الاعتماد على الصور فقط. */
	pRecursive?: boolean;

	/** الامتدادات المقبولة عند مسح الفولدر. */
	pExts?: string[];

	pTitle?: string;
	pDesc?: string;
	pSearchPlaceholder?: string;
	pEmptyText?: string;

	pDefaultType?: string;
	pDefaultCountry?: string;
	pDefaultUses?: string | string[];
	pDefaultFinishes?: string | string[];
	pDefaultCurrency?: string;

	pColumns?: number;
	pColumnsP?: number;
	pMaxCompare?: number;
	pShowFilters?: boolean;
	pAvailableOnly?: boolean;
	pAllowShare?: boolean;
	pEnableQuote?: boolean;
	pSelectFirst?: boolean;

	/** معرّف StoneRequestBuilder الذي يستقبل بيانات الخامة بعد حفظ الطلب المبدئي. */
	pRequestBuilderId?: string;

	/** رابط احتياطي بعد إطلاق حدث الطلب. يترك فارغًا للبقاء داخل الصفحة. */
	pRequestHref?: string;

	/** مفتاح حفظ القائمة المختصرة والمقارنة على جهاز الزائر. */
	pStorageKey?: string;

	pMaxWidth?: CssValue;
	pPad?: CssValue;
	pGap?: CssValue;
	pRadius?: CssValue;
	pAccent?: string;
	pAccentSoft?: string;
	pBgColor?: string;
	pPanelColor?: string;
	pTextColor?: string;
	pMutedColor?: string;
	pBorderColor?: string;

	/** يحافظ الودجت على عرضه الداخلي داخل Stack / Strip. */
	"data-own-size"?: boolean | string;
}

const cProps = Astro.props as Props & Record<string, unknown>;

const {
	pItems,
	pFolder = "",
	pExcel = "stones.xlsx",
	pExcelSheet = "الخامات",
	pExcelWarnings = true,
	pJson = "stones.json",
	pRecursive = false,
	pExts = [".webp", ".jpg", ".jpeg", ".png", ".avif"],

	pTitle = "اختر الخامة المناسبة",
	pDesc = "تصفّح الخامات، افحص اللوح الفعلي، وقارن اختياراتك قبل طلب السعر.",
	pSearchPlaceholder = "ابحث باسم الخامة",
	pEmptyText = "لا توجد خامات مطابقة للاختيارات الحالية.",

	pDefaultType = "حجر طبيعي",
	pDefaultCountry = "غير محدد",
	pDefaultUses = [],
	pDefaultFinishes = ["مصقول"],
	pDefaultCurrency = "ج.م",

	pColumns = 4,
	pColumnsP = 2,
	pMaxCompare = 3,
	pShowFilters = true,
	pAvailableOnly = false,
	pAllowShare = true,
	pEnableQuote = true,
	pSelectFirst = false,

	pRequestBuilderId = "",
	pRequestHref = "",
	pStorageKey = "EmoStoneGalleryV1",

	pMaxWidth = "1480px",
	pPad = "clamp(20px, 3vw, 48px)",
	pGap = "clamp(18px, 2vw, 30px)",
	pRadius = "26px",
	pAccent = "#3899ec",
	pAccentSoft = "#dceeff",
	pBgColor = "#f8f5ef",
	pPanelColor = "#fffdf9",
	pTextColor = "#1f252b",
	pMutedColor = "#68717a",
	pBorderColor = "#ddd8cf",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	Readable: pReadableValue = true,
	id: pGivenID = GetWidgetId("StoneGallery"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	"data-own-size": pOwnSizeValue = true,
	...RemAttr
} = cProps;

const cAllowedExts = pExts.map(NormalizeExt);
const cDefaultUses = ToList(pDefaultUses);
const cDefaultFinishes = ToList(pDefaultFinishes);
const cDataWarnings: string[] = [];
const cPublicRoots = GetPublicRoots();
const cRawItems = GetRawItems();
const cUsedIds = new Set<string>();
const cItems = cRawItems
	.map((pItem, pIndex) => NormalizeItem(pItem, pIndex))
	.filter((pItem): pItem is NormalizedStoneItem => pItem !== null);

const cTypes = UniqueValues(cItems.map((pItem) => pItem.Type));
const cColors = UniqueValues(cItems.map((pItem) => pItem.Color));
const cCountries = UniqueValues(cItems.map((pItem) => pItem.Country));
const cUses = UniqueValues(cItems.flatMap((pItem) => pItem.Uses));
const cPriceLevels = UniqueValues(cItems.map((pItem) => pItem.PriceLevel));
const cColumns = ClampInt(pColumns, 1, 6);
const cColumnsP = ClampInt(pColumnsP, 1, 3);
const cCompareCount = ClampInt(pMaxCompare, 2, 4);
const cReadable = GetBoolAttr(pReadableValue, true);
const cOwnSize = GetBoolAttr(pOwnSizeValue, true);

const cStyle = [
	`--StoneGalleryMaxWidth:${NormalizeCssValue(pMaxWidth)};`,
	`--StoneGalleryPad:${NormalizeCssValue(pPad)};`,
	`--StoneGalleryGap:${NormalizeCssValue(pGap)};`,
	`--StoneGalleryRadius:${NormalizeCssValue(pRadius)};`,
	`--StoneGalleryAccent:${pAccent};`,
	`--StoneGalleryAccentSoft:${pAccentSoft};`,
	`--StoneGalleryBg:${pBgColor};`,
	`--StoneGalleryPanel:${pPanelColor};`,
	`--StoneGalleryText:${pTextColor};`,
	`--StoneGalleryMuted:${pMutedColor};`,
	`--StoneGalleryBorder:${pBorderColor};`,
	`--StoneGalleryColumns:${cColumns};`,
	`--StoneGalleryColumnsP:${cColumnsP};`,
	GetStyleText(pGivenStyle),
].filter(Boolean).join(" ");

const cPlace = new Place({
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,
}, cStyle);

const cDataJson = JSON.stringify(cItems).replaceAll("<", "\\u003c");
const cQuoteLocationName = `${pGivenID}-location`;

function FormatStonePriceText(pItem: NormalizedStoneItem) {
	if (!(pItem.PriceFrom > 0)) {
		return pItem.PriceLevel && pItem.PriceLevel !== "غير محدد"
			? pItem.PriceLevel
			: "يُراجع حسب الدفعة";
	}

	const cFormat = new Intl.NumberFormat("ar-EG", { maximumFractionDigits: 0 });
	const cFrom = cFormat.format(Math.round(pItem.PriceFrom));

	if (pItem.PriceTo > pItem.PriceFrom) {
		const cTo = cFormat.format(Math.round(pItem.PriceTo));
		return `${cFrom} – ${cTo} ${pItem.Currency}/م²`;
	}

	return `يبدأ من ${cFrom} ${pItem.Currency}/م²`;
}

function JoinStoneList(pItems: string[]) {
	return pItems.length > 0 ? pItems.join("، ") : "غير محدد";
}

function GetRawItems(): StoneGalleryItemInput[] {
	if (Array.isArray(pItems) && pItems.length > 0) return pItems;

	const cExcelItems = ReadExcelItems();
	if (cExcelItems !== null) return cExcelItems;

	const cJsonItems = ReadJsonItems();
	if (cJsonItems.length > 0) return cJsonItems;

	return ScanFolderItems();
}

function ReadExcelItems(): StoneGalleryItemInput[] | null {
	const cFolderPath = GetSafePublicFolderPath(pFolder);
	if (!pExcel) return null;
	if (!cFolderPath) {
		AddDataWarning(`لم أجد فولدر الصور "${pFolder}" داخل public. المسارات التي تم فحصها: ${cPublicRoots.join("، ")}.`);
		return null;
	}

	const cExcelPath = GetSafeFolderFilePath(cFolderPath, pExcel);
	if (!cExcelPath || !existsSync(cExcelPath)) return null;

	let cExcelData: ReturnType<typeof ReadStoneGalleryExcelFile>;
	try {
		cExcelData = ReadStoneGalleryExcelFile(cExcelPath, pExcelSheet);
	} catch (pError) {
		const cMessage = pError instanceof Error ? pError.message : `${pError}`;
		throw new Error(`[StoneGallery:${pGivenID}] تعذر قراءة ملف Excel "${pExcel}": ${cMessage}`);
	}
	if (cExcelData.Items.length === 0) AddDataWarning(`تمت قراءة "${pExcel}" لكن ورقة "${pExcelSheet}" لا تحتوي صفوف خامات مفعلة.`);

	const cImageFiles = CollectImageFiles(cFolderPath)
		.map((pFile) => relative(cFolderPath, pFile).replaceAll("\\", "/"))
		.sort((pA, pB) => pA.localeCompare(pB, "ar", { numeric: true }));
	const cMatchExcelImage = CreateStoneGalleryExcelImageMatcher(cImageFiles, pFolder);
	const cWarnings: string[] = [];
	const cItems: StoneGalleryItemInput[] = [];

	for (const [cIndex, cExcelItem] of cExcelData.Items.entries()) {
		const cRowNumber = cExcelData.RowNumbers[cIndex] || cExcelData.HeaderRow + cIndex + 1;
		const cRawItem = cExcelItem as Record<string, unknown>;
		const cMainReference = ReadText(cRawItem, ["File"]);
		const cMainMatch = cMatchExcelImage(cMainReference);

		if (!cMainMatch.File) {
			cWarnings.push(GetExcelMatchWarning(cRowNumber, "الصورة الرئيسية", cMainReference, cMainMatch.Candidates));
			continue;
		}

		const cItem = { ...cRawItem, File: cMainMatch.File } as StoneGalleryItemInput;
		const cSlabReference = ReadText(cRawItem, ["SlabFile"]);
		const cApplicationReference = ReadText(cRawItem, ["ApplicationFile"]);
		const cSlabMatch = cMatchExcelImage(cSlabReference);
		const cApplicationMatch = cMatchExcelImage(cApplicationReference);

		if (cSlabReference && !cSlabMatch.File) cWarnings.push(GetExcelMatchWarning(cRowNumber, "صورة اللوح", cSlabReference, cSlabMatch.Candidates));
		if (cApplicationReference && !cApplicationMatch.File) cWarnings.push(GetExcelMatchWarning(cRowNumber, "صورة التنفيذ", cApplicationReference, cApplicationMatch.Candidates));
		if (cSlabMatch.File) cItem.SlabFile = cSlabMatch.File;
		else delete cItem.SlabFile;
		if (cApplicationMatch.File) cItem.ApplicationFile = cApplicationMatch.File;
		else delete cItem.ApplicationFile;

		const cExtraImages = Array.isArray(cRawItem.Images) ? cRawItem.Images : ToList(cRawItem.Images);
		const cMatchedExtraImages: string[] = [];
		for (const cImageReference of cExtraImages) {
			const cReference = `${cImageReference ?? ""}`.trim();
			if (!cReference) continue;
			const cMatch = cMatchExcelImage(cReference);
			if (cMatch.File) cMatchedExtraImages.push(cMatch.File);
			else cWarnings.push(GetExcelMatchWarning(cRowNumber, "صورة إضافية", cReference, cMatch.Candidates));
		}
		cItem.Images = cMatchedExtraImages;
		cItems.push(cItem);
	}

	if (pExcelWarnings && cWarnings.length > 0) {
		console.warn(`[StoneGallery:${pGivenID}] ملاحظات ربط ملف ${pExcel}:\n- ${cWarnings.join("\n- ")}`);
	}
	for (const cWarning of cWarnings) AddDataWarning(cWarning);

	return cItems;
}

function AddDataWarning(pWarning: string) {
	const cWarning = `${pWarning ?? ""}`.trim();
	if (cWarning && !cDataWarnings.includes(cWarning)) cDataWarnings.push(cWarning);
}

function GetSafeFolderFilePath(pFolderPath: string, pFileValue: string) {
	const cFilePath = resolve(pFolderPath, `${pFileValue}`.trim());
	const cRelative = relative(pFolderPath, cFilePath);
	if (cRelative.startsWith("..") || cRelative === ".." || isAbsolute(cRelative)) return null;
	return cFilePath;
}

function GetExcelMatchWarning(pRowNumber: number, pRole: string, pReference: string, pCandidates: string[]) {
	if (!pReference) return `الصف ${pRowNumber}: حقل ${pRole} فارغ، لذلك لم يتم إنشاء الكارت.`;
	if (pCandidates.length > 1) return `الصف ${pRowNumber}: الاسم "${pReference}" في ${pRole} مكرر. اكتب المسار النسبي كاملًا: ${pCandidates.join("، ")}.`;
	return `الصف ${pRowNumber}: لم أجد الملف "${pReference}" الخاص بـ ${pRole} داخل فولدر الصور.`;
}

function ReadJsonItems(): StoneGalleryItemInput[] {
	const cFolderPath = GetSafePublicFolderPath(pFolder);
	if (!cFolderPath || !pJson) return [];

	const cJsonPath = resolve(cFolderPath, pJson);
	const cRelative = relative(cFolderPath, cJsonPath);
	if (cRelative.startsWith("..") || cRelative === ".." || isAbsolute(cRelative) || !existsSync(cJsonPath)) return [];

	try {
		const cRaw = JSON.parse(readFileSync(cJsonPath, "utf-8"));
		const cList = Array.isArray(cRaw)
			? cRaw
			: Array.isArray(cRaw?.Stones)
				? cRaw.Stones
				: Array.isArray(cRaw?.stones)
					? cRaw.stones
					: Array.isArray(cRaw?.Products)
						? cRaw.Products
						: Array.isArray(cRaw?.products)
							? cRaw.products
							: [];

		return cList.filter((pItem: unknown) => pItem && typeof pItem === "object") as StoneGalleryItemInput[];
	} catch {
		return [];
	}
}

function ScanFolderItems(): StoneGalleryItemInput[] {
	const cFolderPath = GetSafePublicFolderPath(pFolder);
	if (!cFolderPath) return [];

	return CollectImageFiles(cFolderPath)
		.sort((pA, pB) => pA.localeCompare(pB, "ar", { numeric: true }))
		.map((pFile) => ({
			File: relative(cFolderPath, pFile).replaceAll("\\", "/"),
			Name: StripExt(basename(pFile)).replace(/[-_]+/g, " ").trim(),
		}));
}

function CollectImageFiles(pFolderPath: string): string[] {
	const cFiles: string[] = [];

	for (const cEntry of readdirSync(pFolderPath, { withFileTypes: true })) {
		if (cEntry.name.startsWith(".")) continue;
		const cFullPath = resolve(pFolderPath, cEntry.name);

		if (cEntry.isDirectory()) {
			if (pRecursive) cFiles.push(...CollectImageFiles(cFullPath));
			continue;
		}

		if (cEntry.isFile() && cAllowedExts.includes(extname(cEntry.name).toLowerCase())) cFiles.push(cFullPath);
	}

	return cFiles;
}

function GetSafePublicFolderPath(pFolderValue: string) {
	const cFolder = NormalizePublicFolder(pFolderValue);
	if (!cFolder) return null;

	for (const cPublicRoot of cPublicRoots) {
		const cFolderPath = resolve(cPublicRoot, cFolder);
		const cRelative = relative(cPublicRoot, cFolderPath);
		if (cRelative.startsWith("..") || cRelative === ".." || isAbsolute(cRelative) || !existsSync(cFolderPath)) continue;
		return cFolderPath;
	}

	return null;
}

function GetPublicRoots() {
	const cRoots: string[] = [];
	const cAddRoot = (pValue: string) => {
		const cValue = resolve(pValue);
		if (!cRoots.includes(cValue)) cRoots.push(cValue);
	};

	try {
		let cFolder = dirname(fileURLToPath(import.meta.url));
		for (let cIndex = 0; cIndex < 8; cIndex += 1) {
			const cPublicRoot = resolve(cFolder, "public");
			if (existsSync(cPublicRoot)) cAddRoot(cPublicRoot);
			const cParent = resolve(cFolder, "..");
			if (cParent === cFolder) break;
			cFolder = cParent;
		}
	} catch {
		// بعض بيئات التجميع تحول import.meta.url إلى عنوان افتراضي؛ مسار التشغيل يظل البديل.
	}

	cAddRoot(resolve(process.cwd(), "public"));
	return cRoots;
}

function NormalizeItem(pRawValue: StoneGalleryItemInput, pIndex: number): NormalizedStoneItem | null {
	const cRaw = pRawValue as Record<string, unknown>;
	const cFile = ReadText(cRaw, ["File", "file", "Image", "image", "Src", "src"]);
	const cName = ReadText(cRaw, ["Name", "name", "NameAr", "nameAr", "Title", "title"])
		|| StripExt(basename(cFile || `خامة-${pIndex + 1}`)).replace(/[-_]+/g, " ").trim();
	if (!cName) return null;

	const cImages = NormalizeImages(cRaw, cFile, cName);
	if (cImages.length === 0) return null;

	const cRawId = ReadText(cRaw, ["Id", "id", "Slug", "slug"]);
	const cId = GetUniqueId(cRawId || Slugify(cName) || `stone-${pIndex + 1}`);
	const cType = ReadText(cRaw, ["Type", "type", "Kind", "kind", "Category", "category"]) || pDefaultType;
	const cCountry = ReadText(cRaw, ["Country", "country", "Origin", "origin"]) || pDefaultCountry;
	const cColor = ReadText(cRaw, ["Color", "color"]) || "غير محدد";
	const cPattern = ReadText(cRaw, ["Pattern", "pattern", "Texture", "texture"]) || "غير محدد";
	const cDescription = ReadText(cRaw, ["Description", "description", "Desc", "desc", "Body", "body"]);
	const cUses = ToList(ReadValue(cRaw, ["Uses", "uses", "Use", "use"]));
	const cFinishes = ToList(ReadValue(cRaw, ["Finishes", "finishes", "Finish", "finish", "SurfaceFinish", "surfaceFinish"]));
	const cPriceFrom = ToNumber(ReadValue(cRaw, ["PriceFrom", "priceFrom", "StartPrice", "startPrice"]));
	const cPriceTo = ToNumber(ReadValue(cRaw, ["PriceTo", "priceTo", "EndPrice", "endPrice"]));
	const cPriceLevel = ReadText(cRaw, ["PriceLevel", "priceLevel", "Budget", "budget"]) || GetPriceLevel(cPriceFrom);
	const cCurrency = ReadText(cRaw, ["Currency", "currency"]) || pDefaultCurrency;
	const cTags = ToList(ReadValue(cRaw, ["Tags", "tags"]));
	const cAvailableValue = ReadValue(cRaw, ["Available", "available", "InStock", "inStock"]);
	const cAvailable = cAvailableValue === undefined ? true : ToBoolean(cAvailableValue);
	const cBadge = ReadText(cRaw, ["Badge", "badge"]);
	const cFinalUses = cUses.length > 0 ? cUses : cDefaultUses;
	const cFinalFinishes = cFinishes.length > 0 ? cFinishes : cDefaultFinishes;
	const cAlt = ReadText(cRaw, ["Alt", "alt"]) || `${cName} - ${cType}`;
	const cSearchText = [cName, cType, cCountry, cColor, cPattern, cDescription, ...cFinalUses, ...cFinalFinishes, ...cTags]
		.join(" ")
		.toLocaleLowerCase("ar");

	return {
		Id: cId,
		Name: cName,
		Alt: cAlt,
		Type: cType,
		Country: cCountry,
		Color: cColor,
		Pattern: cPattern,
		Description: cDescription,
		Uses: cFinalUses,
		Finishes: cFinalFinishes,
		Available: cAvailable,
		Badge: cBadge,
		PriceFrom: cPriceFrom,
		PriceTo: cPriceTo,
		PriceLevel: cPriceLevel,
		Currency: cCurrency,
		Images: cImages,
		PrimaryImage: cImages[0].Src,
		Tags: cTags,
		SearchText: cSearchText,
	};
}

function NormalizeImages(pRaw: Record<string, unknown>, pMainFile: string, pName: string) {
	const cImages: NormalizedStoneImage[] = [];

	AddImage(cImages, pMainFile, ReadText(pRaw, ["Alt", "alt"]) || pName, "العينة", "sample");
	AddImage(cImages, ReadText(pRaw, ["SlabFile", "slabFile", "SlabImage", "slabImage"]), `${pName} - اللوح الفعلي`, "اللوح الفعلي", "slab");
	AddImage(cImages, ReadText(pRaw, ["ApplicationFile", "applicationFile", "ApplicationImage", "applicationImage", "AppliedFile", "appliedFile"]), `${pName} - تنفيذ حقيقي`, "تنفيذ حقيقي", "application");

	const cExtraImages = ReadValue(pRaw, ["Images", "images"]);
	if (Array.isArray(cExtraImages)) {
		for (const cImageValue of cExtraImages) {
			if (typeof cImageValue === "string") {
				AddImage(cImages, cImageValue, pName, "تفصيل", "detail");
				continue;
			}

			if (!cImageValue || typeof cImageValue !== "object") continue;
			const cImage = cImageValue as Record<string, unknown>;
			const cFile = ReadText(cImage, ["File", "file", "Src", "src"]);
			const cRole = NormalizeImageRole(ReadText(cImage, ["Role", "role"]));
			const cLabel = ReadText(cImage, ["Label", "label"]) || GetImageRoleLabel(cRole);
			const cAlt = ReadText(cImage, ["Alt", "alt"]) || `${pName} - ${cLabel}`;
			AddImage(cImages, cFile, cAlt, cLabel, cRole);
		}
	}

	return cImages.filter((pImage, pIndex, pAll) => pAll.findIndex((pOther) => pOther.Src === pImage.Src) === pIndex);
}

function AddImage(pImages: NormalizedStoneImage[], pFile: string, pAlt: string, pLabel: string, pRole: StoneImageRole) {
	const cSrc = ResolveImageUrl(pFile);
	if (!cSrc) return;
	pImages.push({ Src: cSrc, Alt: pAlt, Label: pLabel, Role: pRole });
}

function ResolveImageUrl(pValue: string) {
	const cValue = `${pValue ?? ""}`.trim().replaceAll("\\", "/");
	if (!cValue) return "";
	if (/^(https?:|data:|blob:)/i.test(cValue) || cValue.startsWith("/")) return cValue;

	const cFolder = NormalizePublicFolder(pFolder);
	return JoinPublicUrl(cFolder, cValue);
}

function NormalizePublicFolder(pFolderValue: string) {
	return `${pFolderValue ?? ""}`.trim().replaceAll("\\", "/").replace(/^public\//, "").replace(/^\/+/, "").replace(/\/+$/, "");
}

function JoinPublicUrl(pFolderValue: string, pFileValue: string) {
	const cSegments = `${pFolderValue}/${pFileValue}`.split("/").filter(Boolean).map((pSegment) => encodeURIComponent(pSegment));
	return `/${cSegments.join("/")}`;
}

function ReadValue(pObject: Record<string, unknown>, pNames: string[]) {
	for (const cName of pNames) {
		if (Object.prototype.hasOwnProperty.call(pObject, cName)) return pObject[cName];
	}
	return undefined;
}

function ReadText(pObject: Record<string, unknown>, pNames: string[]) {
	const cValue = ReadValue(pObject, pNames);
	return typeof cValue === "string" || typeof cValue === "number" ? `${cValue}`.trim() : "";
}

function ToList(pValue: unknown) {
	if (Array.isArray(pValue)) return pValue.map((pItem) => `${pItem ?? ""}`.trim()).filter(Boolean);
	return `${pValue ?? ""}`.split(/\r?\n|\||،|,/g).map((pItem) => pItem.trim()).filter(Boolean);
}

function ToBoolean(pValue: unknown) {
	if (typeof pValue === "boolean") return pValue;
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	return ["true", "1", "yes", "نعم", "متوفر", "متاح", "نشط", "عرض"].includes(cValue);
}

function ToNumber(pValue: unknown) {
	const cValue = Number.parseFloat(`${pValue ?? ""}`.replaceAll(",", ""));
	return Number.isFinite(cValue) && cValue > 0 ? cValue : 0;
}

function NormalizeImageRole(pValue: string): StoneImageRole {
	const cValue = pValue.trim().toLowerCase();
	if (cValue === "sample" || cValue === "عينة") return "sample";
	if (cValue === "slab" || cValue === "لوح") return "slab";
	if (cValue === "application" || cValue === "applied" || cValue === "تنفيذ") return "application";
	return "detail";
}

function GetImageRoleLabel(pRole: StoneImageRole) {
	if (pRole === "sample") return "العينة";
	if (pRole === "slab") return "اللوح الفعلي";
	if (pRole === "application") return "تنفيذ حقيقي";
	return "تفصيل";
}

function GetPriceLevel(pPriceFrom: number) {
	if (pPriceFrom <= 0) return "غير محدد";
	if (pPriceFrom < 1200) return "اقتصادي";
	if (pPriceFrom < 2500) return "متوسط";
	return "فاخر";
}

function GetUniqueId(pBaseValue: string) {
	const cBase = pBaseValue || "stone";
	let cId = cBase;
	let cIndex = 2;
	while (cUsedIds.has(cId)) cId = `${cBase}-${cIndex++}`;
	cUsedIds.add(cId);
	return cId;
}

function Slugify(pValue: string) {
	return pValue
		.trim()
		.toLocaleLowerCase("ar")
		.replace(/[\u064B-\u065F\u0670]/g, "")
		.replace(/[^a-z0-9\u0600-\u06ff]+/gi, "-")
		.replace(/^-+|-+$/g, "");
}

function StripExt(pFile: string) {
	return pFile.replace(/\.[^.]+$/, "");
}

function UniqueValues(pValues: string[]) {
	return [...new Set(pValues.map((pValue) => pValue.trim()).filter((pValue) => pValue && pValue !== "غير محدد"))]
		.sort((pA, pB) => pA.localeCompare(pB, "ar", { numeric: true }));
}

function NormalizeExt(pValue: string) {
	const cValue = `${pValue ?? ""}`.trim().toLowerCase();
	return cValue.startsWith(".") ? cValue : `.${cValue}`;
}

function NormalizeCssValue(pValue: CssValue) {
	return typeof pValue === "number" ? `${pValue}px` : `${pValue}`;
}

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			const cName = pName.startsWith("--") ? pName : pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
			return `${cName}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function ClampInt(pValue: unknown, pMin: number, pMax: number) {
	const cValue = Number.parseInt(`${pValue ?? ""}`, 10);
	return Math.min(pMax, Math.max(pMin, Number.isFinite(cValue) ? cValue : pMin));
}

function GetBoolAttr(pValue: unknown, pDefault = false) {
	if (pValue === undefined || pValue === null) return pDefault;
	return pValue === true || pValue === "" || pValue === "true";
}
