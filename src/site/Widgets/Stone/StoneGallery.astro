					<button class = " StoneGalleryPrimary " type="submit">
		
						احفظ الطلب وأرسله
		
					</button>
		
				</footer>
		
				<p class = " StoneGalleryQuoteStatus " data-quote-status role="status">
		
				</p>
		
			</form>
		
		
		
		
		
		
		
		</div>
	) }

</section>





<style>



	.StoneGallery {
		position: relative;
		width: 100%;
		padding: var(--StoneGalleryPad);
		overflow: clip;
		isolation: isolate;
		color: var(--StoneGalleryText);
		background: radial-gradient(circle at 8% 4%, color-mix(in srgb, var(--StoneGalleryAccentSoft) 54%, transparent), transparent 31rem),
			linear-gradient(145deg, var(--StoneGalleryBg), color-mix(in srgb, var(--StoneGalleryBg) 82%, white));
		font-family: inherit;
		line-height: 1.55;
	}

	.StoneGallery::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background-image: linear-gradient(112deg, transparent 32%, rgba(255, 255, 255, .52) 49%, transparent 68%);
		content: "";
		pointer-events: none;
	}

	.StoneGallery button {
		color: inherit;
	}

	.StoneGallery svg {
		width: 1.2em;
		height: 1.2em;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.StoneGallery [hidden] {
		display: none;
	}

	.StoneGallery .StoneGalleryVisuallyHidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		border: 0;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.StoneGallery [hidden][hidden] {
		display: none;
	}


	.StoneGalleryHead {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: clamp(20px, 2.2vw, 32px);
	}


	.StoneGalleryHeading {
		max-width: 760px;
	}

	.StoneGalleryHeading h2 {
		margin: 0;
		font-size: clamp(27px, 3.2vw, 48px);
		font-weight: 900;
		letter-spacing: -.035em;
		line-height: 1.12;
	}

	.StoneGalleryHeading p {
		max-width: 670px;
		margin: 10px 0 0;
		color: var(--StoneGalleryMuted);
		font-size: clamp(14px, 1.1vw, 17px);
	}


	.StoneGalleryHeadActions {
		display: flex;
		flex: 0 0 auto;
		gap: 10px;
	}


	.StoneGalleryHeadAction {
		display: grid;
		grid-template-columns: auto auto;
		grid-template-areas: "icon count" "label label";
		align-items: center;
		min-width: 92px;
		padding: 10px 14px 8px;
		border: 1px solid var(--StoneGalleryBorder);
		border-radius: 16px;
		background: color-mix(in srgb, var(--StoneGalleryPanel) 87%, transparent);
		box-shadow: 0 9px 24px rgba(32, 42, 52, .06);
		cursor: pointer;
		transition: border-color .2s ease, transform .2s ease, background .2s ease;
	}

	.StoneGalleryHeadAction:hover {
		border-color: color-mix(in srgb, var(--StoneGalleryAccent) 55%, var(--StoneGalleryBorder));
		transform: translateY(-2px);
	}

	.StoneGalleryHeadAction svg {
		grid-area: icon;
		font-size: 19px;
	}

	.StoneGalleryHeadAction span {
		grid-area: label;
		margin-top: 3px;
		font-size: 12px;
		font-weight: 800;
	}

	.StoneGalleryHeadAction b {
		grid-area: count;
		justify-self: end;
		min-width: 23px;
		padding: 2px 7px;
		border-radius: 99px;
		color: white;
		background: var(--StoneGalleryAccent);
		font-size: 11px;
		line-height: 1.6;
		text-align: center;
	}


	.StoneGalleryFilters {
		display: grid;
		grid-template-columns: minmax(220px, 1.7fr) repeat(5, minmax(110px, .72fr)) auto auto;
		align-items: end;
		gap: 10px;
		padding: 13px;
		border: 1px solid color-mix(in srgb, var(--StoneGalleryBorder) 85%, transparent);
		border-radius: 19px;
		background: color-mix(in srgb, var(--StoneGalleryPanel) 91%, transparent);
		box-shadow: 0 14px 38px rgba(32, 42, 52, .07);
		backdrop-filter: blur(16px);
	}


	.StoneGalleryFilter > span {
		padding-inline: 4px;
		color: var(--StoneGalleryMuted);
		font-size: 10px;
		font-weight: 800;
	}


	.StoneGallerySearch svg {
		position: absolute;
		z-index: 1;
		top: 50%;
		right: 14px;
		color: var(--StoneGalleryMuted);
		transform: translateY(-50%);
	}

	.StoneGallerySearch input {
		padding: 9px 42px 9px 13px;
	}


	.StoneGalleryAvailable {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 46px;
		padding-inline: 8px;
		white-space: nowrap;
		cursor: pointer;
	}

	.StoneGalleryAvailable input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.StoneGalleryAvailable > span {
		position: relative;
		width: 37px;
		height: 21px;
		border-radius: 20px;
		background: #cfd4d9;
		transition: background .2s ease;
	}

	.StoneGalleryAvailable > span::after {
		position: absolute;
		top: 3px;
		right: 3px;
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: white;
		box-shadow: 0 2px 6px rgba(0, 0, 0, .18);
		content: "";
		transition: transform .2s ease;
	}

	.StoneGalleryAvailable input:checked + span {
		background: var(--StoneGalleryAccent);
	}

	.StoneGalleryAvailable input:checked + span::after {
		transform: translateX(-16px);
	}


	.StoneGalleryClearFilters {
		min-height: 46px;
		padding: 8px 12px;
		border: 0;
		color: var(--StoneGalleryMuted);
		background: transparent;
		font-weight: 800;
		white-space: nowrap;
		cursor: pointer;
	}

	.StoneGalleryClearFilters:hover {
		color: var(--StoneGalleryAccent);
	}


	.StoneGalleryResultBar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 15px;
		padding: 15px 3px 12px;
		color: var(--StoneGalleryMuted);
		font-size: 12px;
	}

	.StoneGalleryResultBar b {
		color: var(--StoneGalleryText);
	}


	.StoneGalleryBody {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: var(--StoneGalleryGap);
		transition: grid-template-columns .28s ease;
	}


	.StoneGalleryCatalog {
		min-width: 0;
	}


	.StoneGalleryGrid {
		display: grid;
		grid-template-columns: repeat(var(--StoneGalleryColumns), minmax(0, 1fr));
		gap: clamp(12px, 1.25vw, 19px);
	}


	.StoneGalleryCard {
		position: relative;
		min-width: 0;
		border: 1px solid color-mix(in srgb, var(--StoneGalleryBorder) 88%, transparent);
		border-radius: 18px;
		background: var(--StoneGalleryPanel);
		box-shadow: 0 10px 30px rgba(31, 37, 43, .07);
		transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
	}

	.StoneGalleryCard:hover {
		border-color: color-mix(in srgb, var(--StoneGalleryAccent) 52%, var(--StoneGalleryBorder));
		box-shadow: 0 14px 36px rgba(31, 37, 43, .11);
		transform: translateY(-3px);
	}

	.StoneGalleryCard:hover .StoneGalleryCardMedia img {
		transform: scale(1.04);
	}


	.StoneGalleryCardMain {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		border-radius: inherit;
		background: transparent;
		text-align: right;
		cursor: pointer;
	}


	.StoneGalleryCardMedia {
		position: relative;
		display: block;
		aspect-ratio: 1.42;
		overflow: hidden;
		border-radius: 17px 17px 9px 9px;
		background: #e6e1d8;
	}

	.StoneGalleryCardMedia::after {
		position: absolute;
		inset: auto 0 0;
		height: 28%;
		background: linear-gradient(transparent, rgba(0, 0, 0, .25));
		content: "";
		pointer-events: none;
	}

	.StoneGalleryCardMedia img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform .45s cubic-bezier(.2, .8, .2, 1);
	}


	.StoneGalleryCardBadge {
		position: absolute;
		z-index: 1;
		top: 10px;
		right: 10px;
		padding: 4px 8px;
		border-radius: 99px;
		color: #fff;
		background: rgba(20, 27, 33, .78);
		font-size: 9px;
		font-weight: 800;
		backdrop-filter: blur(8px);
	}


	.StoneGallerySelectedMark {
		position: absolute;
		z-index: 2;
		bottom: 10px;
		left: 10px;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border: 2px solid white;
		border-radius: 50%;
		color: white;
		background: var(--StoneGalleryAccent);
