<section
	class = {`StoneGallery ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	dir="rtl"
	readable={cReadable ? "" : undefined}
	data-own-size={cOwnSize ? "true" : undefined}
	data-stone-gallery="true"
	data-ops-scope="true"
	data-ops-widget="StoneGallery"
	data-ops-title={pTitle}
	data-max-compare={cCompareCount}
	data-storage-key={pStorageKey}
	data-request-builder-id={pRequestBuilderId}
	data-request-href={pRequestHref}
	data-allow-share={pAllowShare ? "true" : "false"}
	data-enable-quote={pEnableQuote ? "true" : "false"}
	data-select-first={pSelectFirst ? "true" : "false"}
	data-empty-text={pEmptyText}
	data-emo-auto-container="true"
	data-emo-explicit-height="false"
	data-emo-empty-height="620"
	{...RemAttr}
>







	<header class = " StoneGalleryHead ">

