										</small>
		
									</span>
		
								</label>
		
								<label>
		
									<input type="radio" name={cQuoteLocationName} value="other-egypt" />
		
									<span>
		
										<strong>
											محافظة أخرى
										</strong>
		
										<small>
		
											نراجع إمكانية التوريد أو التنفيذ
		
										</small>
		
									</span>
		
								</label>
		
								<label>
		
									<input type="radio" name={cQuoteLocationName} value="remote-egypt" />
		
									<span>
		
										<strong>
											أنا خارج مصر والمشروع داخل مصر
										</strong>
		
										<small>
		
											اختيار ومتابعة عن بُعد
		
										</small>
		
									</span>
		
								</label>
		
								<label>
		
									<input type="radio" name={cQuoteLocationName} value="outside-egypt" />
		
									<span>
		
										<strong>
											المشروع خارج مصر
										</strong>
		
										<small>
		
											يُراجع نطاق التوريد أولًا
		
										</small>
		
									</span>
		
								</label>
		
							</div>
		
						</fieldset>
		
					</div>
		
					<aside class = " StoneGalleryEstimate ">
		
						<small>
		
							نطاق سعر مبدئي
		
						</small>
		
						<strong data-estimate-value>
							يُحدد بعد اختيار البيانات
						</strong>
		
						<p data-estimate-note>
							السعر يتأثر بالدفعة الفعلية والسمك والتشطيب والقياسات النهائية.
						</p>
		
						<div>
		
							<span>
								دقة التقدير
							</span>
		
							<b data-estimate-accuracy>
		
								45%
		
							</b>
		
						</div>
		
						<progress max="100" value="45" data-estimate-progress>
		
							45%
		
						</progress>
		
