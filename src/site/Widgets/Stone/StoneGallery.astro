<script is:inline>



	(function ()
	{

		// ==================== Definitions: Variables & Methods ====================

		const cRoots = document.querySelectorAll("[data-stone-gallery='true']");





		function RegisterStoneGallery(pRoot)
		{
			if (!pRoot || pRoot.dataset.galleryReady === "true") return;
			pRoot.dataset.galleryReady = "true";
			const cDataElement = pRoot.querySelector("[data-stone-gallery-data]");
			let cItems = [];
			try
			{
				cItems = JSON.parse(cDataElement?.textContent || "[]");
			} catch {
				cItems = [];
			}
			const cItemMap = new Map(cItems.map((pItem) => [
						pItem.Id,
						pItem
			]));
			const cCards = Array.from(pRoot.querySelectorAll("[data-stone-card]"));
			const cStorageKey = pRoot.dataset.storageKey || "EmoStoneGalleryV1";
			const cMaxCompare = Math.max(2, Number(pRoot.dataset.maxCompare) || 3);
			const cFiltersForm = pRoot.querySelector("[data-filters-form]");
			const cDetailsPanels = Array.from(pRoot.querySelectorAll("[data-details-panel]"));
			const cLightbox = pRoot.querySelector("[data-lightbox]");
			const cCompareOverlay = pRoot.querySelector("[data-compare-overlay]");
			const cQuoteOverlay = pRoot.querySelector("[data-quote-overlay]");
			const cQuoteForm = pRoot.querySelector("[data-quote-form]");
			const cGrid = pRoot.querySelector("[data-gallery-grid]");
			const cEmpty = pRoot.querySelector("[data-gallery-empty]");
			const cResultCount = pRoot.querySelector("[data-result-count]");
			const cShortlistCount = pRoot.querySelector("[data-shortlist-count]");
			const cCompareCount = pRoot.querySelector("[data-compare-count]");
			const cShortlistButton = pRoot.querySelector("[data-action='open-shortlist']");
			const cLightboxImage = pRoot.querySelector("[data-lightbox-image]");
			const cInspectStage = pRoot.querySelector("[data-inspect-stage]");
			const cLightboxFilm = pRoot.querySelector("[data-lightbox-film]");
			const cQuoteStatus = pRoot.querySelector("[data-quote-status]");
			const cPersisted = LoadPersistedState();
			let cSelectedId = "";
			let cDetailsPanel = null;
			let cShortlist = ValidIds(cPersisted.shortlist);
			let cCompare = ValidIds(cPersisted.compare).slice(0, cMaxCompare);
			let cShortlistOnly = false;
			let cLightboxIndex = 0;
			let cZoom = 1;
			let cLastFocused = null;
			let cLastEstimate = null;
			const cLive = MakeLiveRegion();
			pRoot.addEventListener("click", HandleClick);
			cFiltersForm?.addEventListener("input", ApplyFilters);
			cFiltersForm?.addEventListener("change", ApplyFilters);
			cFiltersForm?.addEventListener("reset", () =>
				{
					window.setTimeout(() =>
						{
							cShortlistOnly = false;
							UpdateCollections();
							ApplyFilters();
						}, 0);
			});
			cQuoteForm?.addEventListener("input", UpdateEstimate);
			cQuoteForm?.addEventListener("change", UpdateEstimate);
			cQuoteForm?.addEventListener("submit", SubmitQuote);
			document.addEventListener("keydown", HandleKeyDown);
			UpdateCollections();
			ApplyFilters();
			RestoreSelection();
			function HandleClick(pEvent)
			{
				const cButton = pEvent.target.closest("button[data-action]");
				if (!cButton || !pRoot.contains(cButton)) return;
				const cAction = cButton.dataset.action || "";
				const cStoneId = cButton.dataset.stoneId || cButton.closest("[data-stone-id]")?.dataset.stoneId || "";
				pEvent.preventDefault();
				if (cAction === "select-stone") SelectStone(cStoneId, true);
				else if (cAction === "toggle-shortlist") ToggleShortlist(cStoneId);
				else if (cAction === "open-shortlist") ToggleShortlistView();
				else if (cAction === "open-compare") OpenCompare();
				else if (cAction === "clear-filters") ClearFilters();
				else if (cAction === "close-details") CloseDetails();
				else if (cAction === "inspect-stone") OpenLightbox();
				else if (cAction === "toggle-compare") ToggleCompare(cSelectedId);
				else if (cAction === "share-stone") ShareStone();
				else if (cAction === "close-lightbox") CloseOverlay(cLightbox);
				else if (cAction === "lightbox-prev") StepLightbox(-1);
				else if (cAction === "lightbox-next") StepLightbox(1);
				else if (cAction === "show-lightbox-image") SetLightboxImage(Number(cButton.dataset.imageIndex));
				else if (cAction === "zoom-out") SetZoom(cZoom -.25);
				else if (cAction === "zoom-reset") SetZoom(1);
				else if (cAction === "zoom-in") SetZoom(cZoom +.25);
				else if (cAction === "fullscreen") ToggleFullscreen();
				else if (cAction === "close-compare") CloseOverlay(cCompareOverlay);
				else if (cAction === "remove-compare") RemoveCompare(cButton.closest("[data-compare-slot]")?.dataset.stoneId || "");
				else if (cAction === "choose-compare") ChooseComparedStone(cButton.closest("[data-compare-slot]")?.dataset.stoneId || "");
				else if (cAction === "share-comparison") ShareComparison();
				else if (cAction === "open-quote") OpenQuote();
				else if (cAction === "close-quote") CloseOverlay(cQuoteOverlay);
			}
			function RestoreSelection()
			{
				const cUrl = new URL(window.location.href);
				const cUrlId = cUrl.searchParams.get("stone") || "";
				if (cItemMap.has(cUrlId))
				{
					SelectStone(cUrlId, false);
					return;
				}
				if (pRoot.dataset.selectFirst === "true" && cItems[0]) SelectStone(cItems[0].Id, false);
			}
			function SelectStone(pStoneId, pAllowReselect)
			{
				const cItem = cItemMap.get(pStoneId);
				if (!cItem) return;
				if (cSelectedId === pStoneId && pAllowReselect)
				{
					Emit("emo-stone-gallery-reselect", { stone: cItem, stoneId: pStoneId });
					OpenLightbox();
					return;
				}
				cSelectedId = pStoneId;
				cDetailsPanel = cDetailsPanels.find((pPanel) => pPanel.dataset.stoneId === pStoneId) || null;
				pRoot.classList.add("HasSelection");
				for (const cPanel of cDetailsPanels) cPanel.hidden = cPanel !== cDetailsPanel;
				for (const cCard of cCards)
				{
					const cSelected = cCard.dataset.stoneId === pStoneId;
					cCard.classList.toggle("IsSelected", cSelected);
					const cSelectButton = cCard.querySelector("[data-action='select-stone']");
					cSelectButton?.setAttribute("aria-pressed", cSelected ? "true" : "false");
				}
				SetPanelStatus("");
				UpdateCompareButtons();
				UpdateSelectedUrl(pStoneId);
				Emit("emo-stone-gallery-select", { stone: cItem, stoneId: pStoneId });
				if (pAllowReselect && window.matchMedia("(max-width: 920px)").matches)
				{
					cDetailsPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
				}
			}
			function CloseDetails()
			{
				cSelectedId = "";
				pRoot.classList.remove("HasSelection");
				for (const cPanel of cDetailsPanels) cPanel.hidden = true;
				cDetailsPanel = null;
				for (const cCard of cCards)
				{
					cCard.classList.remove("IsSelected");
					cCard.querySelector("[data-action='select-stone']")?.setAttribute("aria-pressed", "false");
				}
				UpdateSelectedUrl("");
			}
			function ApplyFilters()
			{
				const cSearch = NormalizeSearch(cFiltersForm?.querySelector("[data-filter-search]")?.value || "");
				const cType = cFiltersForm?.querySelector("[data-filter-type]")?.value || "";
				const cColor = cFiltersForm?.querySelector("[data-filter-color]")?.value || "";
				const cUse = cFiltersForm?.querySelector("[data-filter-use]")?.value || "";
				const cCountry = cFiltersForm?.querySelector("[data-filter-country]")?.value || "";
				const cPrice = cFiltersForm?.querySelector("[data-filter-price]")?.value || "";
				const cAvailableOnly = Boolean(cFiltersForm?.querySelector("[data-filter-available]")?.checked);
				let cVisibleCount = 0;
				for (const cCard of cCards)
				{
					const cItem = cItemMap.get(cCard.dataset.stoneId || "");
					if (!cItem) continue;
					const cVisible = (!cSearch || NormalizeSearch(cItem.SearchText).includes(cSearch))
					&& (!cType || cItem.Type === cType)
					&& (!cColor || cItem.Color === cColor)
					&& (!cUse || cItem.Uses.includes(cUse))
					&& (!cCountry || cItem.Country === cCountry)
					&& (!cPrice || cItem.PriceLevel === cPrice)
					&& (!cAvailableOnly || cItem.Available)
					&& (!cShortlistOnly || cShortlist.includes(cItem.Id));
					cCard.hidden = !cVisible;
					if (cVisible) cVisibleCount += 1;
				}
				if (cResultCount) cResultCount.textContent = String(cVisibleCount);
				if (cGrid) cGrid.hidden = cVisibleCount === 0;
				if (cEmpty) cEmpty.hidden = cVisibleCount !== 0;
			}
			function ClearFilters()
			{
				cShortlistOnly = false;
				cFiltersForm?.reset();
				UpdateCollections();
				window.setTimeout(ApplyFilters, 0);
			}
			function ToggleShortlist(pStoneId)
			{
				const cItem = cItemMap.get(pStoneId);
				if (!cItem) return;
				const cWasSaved = cShortlist.includes(pStoneId);
				cShortlist = cWasSaved ? cShortlist.filter((pId) => pId !== pStoneId) : [
					...cShortlist,
					pStoneId
				];
				SavePersistedState();
				UpdateCollections();
				if (cShortlistOnly) ApplyFilters();
				Announce(cWasSaved ? `تم حذف ${cItem.Name} من المحفوظة.` : `تم حفظ ${cItem.Name} للرجوع إليها.`);
				Emit("emo-stone-gallery-shortlist", { stone: cItem, stoneId: pStoneId, saved: !cWasSaved, shortlist: [...cShortlist] });
			}
			function ToggleShortlistView()
			{
				if (cShortlist.length === 0 && !cShortlistOnly)
				{
					Announce("لم تحفظ أي خامة بعد. استخدم علامة القلب فوق الصورة.");
					return;
				}
				cShortlistOnly = !cShortlistOnly;
				UpdateCollections();
				ApplyFilters();
				Announce(cShortlistOnly ? `نعرض ${cShortlist.length} خامة محفوظة فقط.` : "نعرض كل الخامات مرة أخرى.");
			}
			function ToggleCompare(pStoneId)
			{
				const cItem = cItemMap.get(pStoneId);
				if (!cItem) return;
				const cAlreadyAdded = cCompare.includes(pStoneId);
				if (!cAlreadyAdded && cCompare.length >= cMaxCompare)
				{
					SetPanelStatus(`المقارنة تستوعب ${cMaxCompare} خامات. احذف خامة ثم أضف ${cItem.Name}.`);
					Announce(`وصلت للحد الأقصى: ${cMaxCompare} خامات.`);
					return;
				}
				cCompare = cAlreadyAdded ? cCompare.filter((pId) => pId !== pStoneId) : [
					...cCompare,
					pStoneId
				];
				SavePersistedState();
				UpdateCollections();
				RenderComparison();
				SetPanelStatus(cAlreadyAdded ? "تم حذف الخامة من المقارنة." : `تمت إضافة الخامة للمقارنة (${cCompare.length}/${cMaxCompare}).`);
				Emit("emo-stone-gallery-compare", { stone: cItem, stoneId: pStoneId, added: !cAlreadyAdded, comparison: [...cCompare] });
			}
			function RemoveCompare(pStoneId)
			{
				if (!pStoneId) return;
				cCompare = cCompare.filter((pId) => pId !== pStoneId);
				SavePersistedState();
				UpdateCollections();
				RenderComparison();
			}
			function OpenCompare()
			{
				RenderComparison();
				OpenOverlay(cCompareOverlay);
				Emit("emo-stone-gallery-compare-open", { comparison: cCompare.map((pId) => cItemMap.get(pId)).filter(Boolean) });
			}
			function RenderComparison()
			{
				const cSlots = Array.from(pRoot.querySelectorAll("[data-compare-slot]"));
				for (let cIndex = 0; cIndex < cSlots.length; cIndex += 1)
				{
					const cSlot = cSlots[cIndex];
					const cItem = cItemMap.get(cCompare[cIndex]);
					cSlot.hidden = !cItem;
					cSlot.dataset.stoneId = cItem?.Id || "";
					if (!cItem) continue;
					SetImage(cSlot.querySelector("[data-compare-image]"), cItem.PrimaryImage, cItem.Alt);
					SetSlotText(cSlot, "[data-compare-name]", cItem.Name);
					SetSlotText(cSlot, "[data-compare-kind]", [
							cItem.Type,
							cItem.Country
						].filter(Boolean).join(" · "));
					SetSlotText(cSlot, "[data-compare-color]", cItem.Color);
					SetSlotText(cSlot, "[data-compare-pattern]", cItem.Pattern);
					SetSlotText(cSlot, "[data-compare-uses]", JoinList(cItem.Uses));
					SetSlotText(cSlot, "[data-compare-finishes]", JoinList(cItem.Finishes));
					SetSlotText(cSlot, "[data-compare-available]", cItem.Available ? "متوفر" : "حسب الطلب");
					SetSlotText(cSlot, "[data-compare-price]", FormatStonePrice(cItem));
				}
				const cEmptySlot = pRoot.querySelector("[data-compare-empty]");
				if (cEmptySlot) cEmptySlot.hidden = cCompare.length >= cMaxCompare;
			}
			function ChooseComparedStone(pStoneId)
			{
				if (!pStoneId) return;
				CloseOverlay(cCompareOverlay, false);
				SelectStone(pStoneId, false);
				pRoot.querySelector(`[data-stone-card][data-stone-id="${EscapeSelector(pStoneId)}"]`)?.scrollIntoView({ behavior: "smooth", block: "center" });
			}
			function UpdateCollections()
			{
				if (cShortlistCount) cShortlistCount.textContent = String(cShortlist.length);
				if (cCompareCount) cCompareCount.textContent = String(cCompare.length);
				cShortlistButton?.classList.toggle("IsActive", cShortlistOnly);
				cShortlistButton?.setAttribute("aria-pressed", cShortlistOnly ? "true" : "false");
				for (const cButton of pRoot.querySelectorAll("[data-action='toggle-shortlist']"))
				{
					const cSaved = cShortlist.includes(cButton.dataset.stoneId || "");
					cButton.classList.toggle("IsSaved", cSaved);
					cButton.setAttribute("aria-pressed", cSaved ? "true" : "false");
				}
				UpdateCompareButtons();
			}
			function UpdateCompareButtons()
			{
				const cCompared = Boolean(cSelectedId && cCompare.includes(cSelectedId));
				for (const cButton of pRoot.querySelectorAll("[data-action='toggle-compare']"))
				{
					cButton.classList.toggle("IsActive", cCompared);
					cButton.setAttribute("aria-pressed", cCompared ? "true" : "false");
					if (cButton.querySelector("[data-compare-action-text]"))
					{
						cButton.querySelector("[data-compare-action-text]").textContent = cCompared ? "احذف من المقارنة" : "أضف للمقارنة";
					} else if (!cButton.closest("[data-compare-overlay]")) {
						cButton.textContent = cCompared ? "احذف من المقارنة" : "أضف للمقارنة";
					}
				}
			}
			function OpenLightbox()
			{
				const cItem = cItemMap.get(cSelectedId);
				if (!cItem || !cLightbox) return;
				cLightboxIndex = 0;
				SetText("[data-lightbox-name]", cItem.Name);
				BuildFilm(cItem);
				SetLightboxImage(0);
				OpenOverlay(cLightbox);
				Emit("emo-stone-gallery-inspect", { stone: cItem, stoneId: cItem.Id, images: cItem.Images.length });
			}
			function BuildFilm(pItem)
			{
				if (!cLightboxFilm) return;
				cLightboxFilm.replaceChildren();
				for (let cIndex = 0; cIndex < pItem.Images.length; cIndex += 1)
				{
					const cImage = pItem.Images[cIndex];
					const cButton = document.createElement("button");
					cButton.type = "button";
					cButton.dataset.action = "show-lightbox-image";
					cButton.dataset.imageIndex = String(cIndex);
					cButton.setAttribute("aria-label", `عرض ${cImage.Label}`);
					const cImg = document.createElement("img");
					cImg.src = cImage.Src;
					cImg.alt = cImage.Alt;
					cImg.loading = "lazy";
					const cLabel = document.createElement("small");
					cLabel.textContent = cImage.Label;
					cButton.append(cImg, cLabel);
					cLightboxFilm.append(cButton);
				}
			}
			function SetLightboxImage(pIndex)
			{
				const cItem = cItemMap.get(cSelectedId);
				if (!cItem || cItem.Images.length === 0) return;
				cLightboxIndex = (Number(pIndex) + cItem.Images.length) % cItem.Images.length;
				const cImage = cItem.Images[cLightboxIndex];
				SetImage(cLightboxImage, cImage.Src, cImage.Alt);
				SetZoom(1);
				const cFilmButtons = Array.from(cLightboxFilm?.querySelectorAll("button") || []);
				for (let cIndex = 0; cIndex < cFilmButtons.length; cIndex += 1)
				{
					cFilmButtons[cIndex].classList.toggle("IsActive", cIndex === cLightboxIndex);
					cFilmButtons[cIndex].setAttribute("aria-current", cIndex === cLightboxIndex ? "true" : "false");
				}
				const cNavButtons = pRoot.querySelectorAll("[data-action='lightbox-prev'], [data-action='lightbox-next']");
				for (const cButton of cNavButtons) cButton.hidden = cItem.Images.length < 2;
			}
			function StepLightbox(pStep)
			{
				SetLightboxImage(cLightboxIndex + pStep);
			}
			function SetZoom(pValue)
			{
				cZoom = Math.max(.5, Math.min(3, Math.round(Number(pValue) * 100) / 100));
				cInspectStage?.style.setProperty("--StoneGalleryZoom", String(cZoom));
				const cResetButton = pRoot.querySelector("[data-action='zoom-reset']");
				if (cResetButton) cResetButton.textContent = `${Math.round(cZoom * 100)}%`;
			}
			async function ToggleFullscreen()
			{
				try
				{
					if (document.fullscreenElement) await document.exitFullscreen();
					else await cInspectStage?.requestFullscreen?.();
				} catch {
					Announce("ملء الشاشة غير متاح في هذا المتصفح.");
				}
			}
			function OpenQuote()
			{
				if (pRoot.dataset.enableQuote !== "true" || !cQuoteOverlay) return;
				const cOpenedFromOverlay = Boolean((cLightbox && !cLightbox.hidden) || (cCompareOverlay && !cCompareOverlay.hidden));
				if (!cSelectedId && cCompare[0]) SelectStone(cCompare[0], false);
				const cItem = cItemMap.get(cSelectedId);
				if (!cItem)
				{
					Announce("اختر خامة أولًا حتى نحسب التقدير المبدئي.");
					return;
				}
				SetImage(pRoot.querySelector("[data-quote-image]"), cItem.PrimaryImage, cItem.Alt);
				SetText("[data-quote-name]", cItem.Name);
				SetText("[data-quote-kind]", [
						cItem.Type,
						cItem.Country
					].filter(Boolean).join(" · "));
				SetQuoteUse(cItem);
				SetQuoteStatus("");
				UpdateEstimate();
				CloseOverlay(cLightbox, false);
				CloseOverlay(cCompareOverlay, false);
				OpenOverlay(cQuoteOverlay, cOpenedFromOverlay);
				Emit("emo-stone-gallery-quote-open", { stone: cItem, stoneId: cItem.Id, comparison: [...cCompare] });
			}
			function SetQuoteUse(pItem)
			{
				const cInputs = Array.from(cQuoteForm?.querySelectorAll("[data-quote-uses] input") || []);
				const cPreferred = cInputs.find((pInput) => pItem.Uses.includes(pInput.value)) || cInputs[0];
				if (cPreferred) cPreferred.checked = true;
			}
			function UpdateEstimate()
			{
				const cItem = cItemMap.get(cSelectedId);
				if (!cQuoteForm || !cItem) return;
				const cData = new FormData(cQuoteForm);
				const cArea = Math.max(0, Number(cData.get("area")) || 0);
				const cUse = String(cData.get(`${pRoot.id}-use`) || "أرضيات");
				const cService = String(cData.get("service") || "supply-install");
				const cLocationName = Array.from(cQuoteForm.querySelectorAll(".StoneGalleryLocationGrid input")).find((pInput) => pInput.checked)?.name || "";
				const cLocation = String(cLocationName ? cData.get(cLocationName) || "" : "");
				const cUseFactor = cUse === "سلالم" ? 1.28 : cUse === "حوائط" ? 1.12 : cUse === "أخرى" ? 1.16 : 1;
				const cServiceFactor = cService === "supply-install" ? 1.22 : cService === "supply" ? 1 : 0;
				const cLocationFactor = cLocation === "other-egypt" ? 1.06 : cLocation === "remote-egypt" ? 1.03 : cLocation === "outside-egypt" ? 1.15 : 1;
				const cHasPrice = cItem.PriceFrom > 0;
				let cFrom = 0;
				let cTo = 0;
				if (cHasPrice && cArea > 0 && cServiceFactor > 0)
				{
					cFrom = cItem.PriceFrom * cArea * cUseFactor * cServiceFactor * cLocationFactor;
					cTo = (cItem.PriceTo || cItem.PriceFrom * 1.28) * cArea * cUseFactor * cServiceFactor * cLocationFactor;
				}
				const cAccuracy = Math.min(92, 25 + (cArea > 0 ? 24 : 0) + (cUse ? 10 : 0) + (cService ? 10 : 0) + (cLocation ? 10 : 0) + (cHasPrice ? 13 : 0));
				const cValue = pRoot.querySelector("[data-estimate-value]");
				const cNote = pRoot.querySelector("[data-estimate-note]");
				if (cService === "selection")
				{
					if (cValue) cValue.textContent = "خدمة المعاينة تُسعّر حسب الموقع";
					if (cNote) cNote.textContent = "سنراجع مكان المشروع وطريقة عرض العينات قبل تحديد تكلفة الخدمة.";
				} else if (!cHasPrice) {
					if (cValue) cValue.textContent = "السعر يحتاج مراجعة الدفعة الحالية";
					if (cNote) cNote.textContent = "تم حفظ المساحة والاستخدام؛ يُستكمل السعر بعد مراجعة اللوح والتوفر.";
				} else if (cArea <= 0) {
					if (cValue) cValue.textContent = "أدخل المساحة لحساب النطاق";
					if (cNote) cNote.textContent = "يمكنك إدخال مساحة تقريبية الآن وتصحيحها عند القياس النهائي.";
				} else {
					if (cValue) cValue.textContent = `${FormatMoney(cFrom)} – ${FormatMoney(cTo)} ${cItem.Currency}`;
					if (cNote) cNote.textContent = "نطاق استدلالي وليس عرض سعر نهائيًا؛ لا يشمل الأعمال غير الظاهرة أو القياسات الخاصة.";
				}
				SetText("[data-estimate-accuracy]", `${cAccuracy}%`);
				const cProgress = pRoot.querySelector("[data-estimate-progress]");
				if (cProgress) cProgress.value = cAccuracy;
				cLastEstimate = { area: cArea, use: cUse, service: cService, location: cLocation, priceFrom: Math.round(cFrom), priceTo: Math.round(cTo), currency: cItem.Currency, accuracy: cAccuracy };
			}
			function SubmitQuote(pEvent)
			{
				pEvent.preventDefault();
				const cItem = cItemMap.get(cSelectedId);
				if (!cItem || !cLastEstimate)
				{
					SetQuoteStatus("اختر خامة وأدخل بيانات المشروع أولًا.", "error");
					return;
				}
				const cDetail = {
					version: 1,
					stone: cItem,
					stoneId: cItem.Id,
					comparison: cCompare.map((pId) => cItemMap.get(pId)).filter(Boolean),
					estimate: {...cLastEstimate },
					requestBuilderId: pRoot.dataset.requestBuilderId || "",
					pageUrl: window.location.href,
					createdAt: new Date().toISOString(),
				};
				try
				{
					localStorage.setItem(`${cStorageKey}:quote`, JSON.stringify(cDetail));
				} catch {
					// يظل الحدث المباشر متاحًا حتى إذا منع المتصفح التخزين المحلي.
				}
				document.dispatchEvent(new CustomEvent("emo-stone-request-prefill", { detail: cDetail }));
				Emit("emo-stone-gallery-quote-submit", cDetail);
				const cBuilderSelector = cDetail.requestBuilderId
				? `#${EscapeSelector(cDetail.requestBuilderId)}[data-stone-request-builder='true']`
				: "[data-stone-request-builder='true']";
				const cBuilder = document.querySelector(cBuilderSelector);
				const cRequestHref = pRoot.dataset.requestHref || "";
				if (cBuilder)
				{
					SetQuoteStatus("تم نقل الخامة والتقدير إلى طلبك. أكمل المقاسات أو بيانات التواصل عندما تكون جاهزًا.", "success");
					window.setTimeout(() =>
						{
							CloseOverlay(cQuoteOverlay, false);
							cBuilder.scrollIntoView({ behavior: "smooth", block: "start" });
						}, 650);
				} else if (cRequestHref) {
					SetQuoteStatus("تم حفظ الاختيار. جارٍ الانتقال لاستكمال الطلب…", "success");
					window.setTimeout(() => window.location.assign(cRequestHref), 450);
				} else {
					SetQuoteStatus("تم حفظ الاختيار والتقدير على هذا الجهاز. أضف StoneRequestBuilder للصفحة لنقل البيانات إليه مباشرة.", "success");
				}
			}
			async function ShareStone()
			{
				const cItem = cItemMap.get(cSelectedId);
				if (!cItem || pRoot.dataset.allowShare !== "true") return;
				const cUrl = BuildShareUrl([cItem.Id]);
				await Share({ title: cItem.Name, text: `شاهد خامة ${cItem.Name} وقارنها لمشروعك.`, url: cUrl });
				Emit("emo-stone-gallery-share", { stone: cItem, stoneId: cItem.Id, url: cUrl });
			}
			async function ShareComparison()
			{
				if (cCompare.length === 0)
				{
					Announce("أضف خامة واحدة على الأقل قبل مشاركة المقارنة.");
					return;
				}
				const cNames = cCompare.map((pId) => cItemMap.get(pId)?.Name).filter(Boolean).join("، ");
				const cUrl = BuildShareUrl(cCompare);
				await Share({ title: "مقارنة خامات الحجر", text: `مقارنة بين: ${cNames}`, url: cUrl });
				Emit("emo-stone-gallery-share-comparison", { comparison: [...cCompare], url: cUrl });
			}
			async function Share(pData)
			{
				try
				{
					if (navigator.share) await navigator.share(pData);
					else if (navigator.clipboard?.writeText)
					{
						await navigator.clipboard.writeText(pData.url);
						Announce("تم نسخ رابط المشاركة.");
					} else {
						const cInput = document.createElement("input");
						cInput.value = pData.url;
						document.body.append(cInput);
						cInput.select();
						document.execCommand("copy");
						cInput.remove();
						Announce("تم نسخ رابط المشاركة.");
					}
				} catch (pError) {
					if (pError?.name !== "AbortError") Announce("تعذرت المشاركة الآن؛ جرّب مرة أخرى.");
				}
			}
			function BuildShareUrl(pIds)
			{
				const cUrl = new URL(window.location.href);
				if (pIds[0]) cUrl.searchParams.set("stone", pIds[0]);
				if (pIds.length > 1) cUrl.searchParams.set("stones", pIds.join(","));
				else cUrl.searchParams.delete("stones");
				return cUrl.toString();
			}
			function OpenOverlay(pOverlay, pPreserveLastFocus = false)
			{
				if (!pOverlay || !pOverlay.hidden) return;
				if (!pPreserveLastFocus) cLastFocused = document.activeElement;
				pOverlay.hidden = false;
				pOverlay.setAttribute("aria-hidden", "false");
				document.documentElement.classList.add("StoneGalleryNoScroll");
				window.setTimeout(() => pOverlay.querySelector("header button[data-action]")?.focus(), 0);
			}
			function CloseOverlay(pOverlay, pRestoreFocus = true)
			{
				if (!pOverlay || pOverlay.hidden) return;
				pOverlay.hidden = true;
				pOverlay.setAttribute("aria-hidden", "true");
				if (![
						cLightbox,
						cCompareOverlay,
						cQuoteOverlay
					].some((pItem) => pItem && !pItem.hidden)) {
					document.documentElement.classList.remove("StoneGalleryNoScroll");
				}
				if (pRestoreFocus && cLastFocused?.focus) cLastFocused.focus();
			}
			function HandleKeyDown(pEvent)
			{
				const cOpenOverlay = [
					cQuoteOverlay,
					cCompareOverlay,
					cLightbox
				].find((pItem) => pItem && !pItem.hidden);
				if (!cOpenOverlay) return;
				if (pEvent.key === "Escape")
				{
					pEvent.preventDefault();
					CloseOverlay(cOpenOverlay);
					return;
				}
				if (pEvent.key === "Tab")
				{
					const cFocusable = Array.from(cOpenOverlay.querySelectorAll("button:not([hidden]):not([disabled]), input:not([hidden]):not([disabled]), select:not([hidden]):not([disabled]), [href], [tabindex]:not([tabindex='-1'])"))
					.filter((pElement) => pElement.getClientRects().length > 0);
					if (cFocusable.length === 0) return;
					const cFirst = cFocusable[0];
					const cLast = cFocusable[cFocusable.length - 1];
					if (pEvent.shiftKey && document.activeElement === cFirst)
					{
						pEvent.preventDefault();
						cLast.focus();
					} else if (!pEvent.shiftKey && document.activeElement === cLast) {
						pEvent.preventDefault();
						cFirst.focus();
					}
					return;
				}
				if (cOpenOverlay !== cLightbox) return;
				if (pEvent.key === "ArrowRight") StepLightbox(-1);
				else if (pEvent.key === "ArrowLeft") StepLightbox(1);
				else return;
				pEvent.preventDefault();
			}
			function LoadPersistedState()
			{
				try
				{
					const cValue = JSON.parse(localStorage.getItem(cStorageKey) || "{}");
					return cValue && typeof cValue === "object" ? cValue : {};
				} catch {
					return {};
				}
			}
			function SavePersistedState()
			{
				try
				{
					localStorage.setItem(cStorageKey, JSON.stringify({ version: 1, shortlist: cShortlist, compare: cCompare }));
				} catch {
					// الودجت يعمل في الجلسة الحالية حتى إذا منع المتصفح التخزين المحلي.
				}
			}
			function ValidIds(pIds)
			{
				return Array.isArray(pIds) ? [...new Set(pIds.map(String).filter((pId) => cItemMap.has(pId)))] : [];
			}
			function UpdateSelectedUrl(pStoneId)
			{
				try
				{
					const cUrl = new URL(window.location.href);
					if (pStoneId) cUrl.searchParams.set("stone", pStoneId);
					else cUrl.searchParams.delete("stone");
					history.replaceState(history.state, "", cUrl);
				} catch {
					// لا يمنع فشل الرابط تجربة الاختيار نفسها.
				}
			}
			function FormatStonePrice(pItem)
			{
				if (!(pItem.PriceFrom > 0)) return pItem.PriceLevel && pItem.PriceLevel !== "غير محدد" ? pItem.PriceLevel : "يُراجع حسب الدفعة";
				if (pItem.PriceTo > pItem.PriceFrom) return `${FormatMoney(pItem.PriceFrom)} – ${FormatMoney(pItem.PriceTo)} ${pItem.Currency}/م²`;
				return `يبدأ من ${FormatMoney(pItem.PriceFrom)} ${pItem.Currency}/م²`;
			}
			function FormatMoney(pValue)
			{
				return new Intl.NumberFormat("ar-EG", { maximumFractionDigits: 0 }).format(Math.round(Number(pValue) || 0));
			}
			function JoinList(pItems)
			{
				return Array.isArray(pItems) && pItems.length ? pItems.join("، ") : "غير محدد";
			}
			function NormalizeSearch(pValue)
			{
				return String(pValue || "").trim().toLocaleLowerCase("ar").replace(/[أإآ]/g, "ا").replace(/ى/g, "ي").replace(/ة/g, "ه");
			}
			function SetText(pSelector, pValue)
			{
				const cElement = pRoot.querySelector(pSelector);
				if (cElement) cElement.textContent = String(pValue ?? "");
			}
			function SetSlotText(pSlot, pSelector, pValue)
			{
				const cElement = pSlot.querySelector(pSelector);
				if (cElement) cElement.textContent = String(pValue ?? "");
			}
			function SetImage(pElement, pSrc, pAlt)
			{
				if (!pElement) return;
				pElement.src = String(pSrc || "");
				pElement.alt = String(pAlt || "");
			}
			function SetPanelStatus(pValue)
			{
				const cPanelStatus = cDetailsPanel?.querySelector("[data-panel-status]");
				if (cPanelStatus) cPanelStatus.textContent = pValue;
			}
			function SetQuoteStatus(pValue, pMode = "")
			{
				if (!cQuoteStatus) return;
				cQuoteStatus.textContent = pValue;
				cQuoteStatus.dataset.mode = pMode;
			}
			function MakeLiveRegion()
			{
				const cElement = document.createElement("p");
				cElement.className = "StoneGalleryVisuallyHidden";
				cElement.setAttribute("role", "status");
				cElement.setAttribute("aria-live", "polite");
				pRoot.append(cElement);
				return cElement;
			}
			function Announce(pValue)
			{
				cLive.textContent = "";
				window.setTimeout(() =>
					{
						cLive.textContent = pValue;
					}, 15);
			}
			function EscapeSelector(pValue)
			{
				if (window.CSS?.escape) return window.CSS.escape(String(pValue));
				return String(pValue).replace(/["\\]/g, "\\$&");
			}
			function Emit(pName, pDetail)
			{
				pRoot.dispatchEvent(new CustomEvent(pName, { bubbles: true, detail: { galleryId: pRoot.id,...pDetail } }));
			}
		}





		// ==================== Execution Logic ====================

		for (const cRoot of cRoots) RegisterStoneGallery(cRoot);

		document.addEventListener("astro:page-load", () =>
			{
				const cPageRoots = document.querySelectorAll("[data-stone-gallery='true']");
				for (const cRoot of cPageRoots) RegisterStoneGallery(cRoot);
		});
	})();
</script>
