	async function HandleSubmit(cEvent) {
	cEvent.preventDefault();

	if (!fCampaign?.isActive) return;

	const cName = GetInputValue(cNameInput);
	const cPhoneRaw = GetInputValue(cPhoneInput);
	const cPhone = NormalizeEgyptPhone(cPhoneRaw);
	const cGovernorate = GetInputValue(cGovernorateSelect);
	const cArea = GetInputValue(cAreaSelect);
	const cDayKey = GetInputValue(cDaySelect);
	const cSlotKey = GetInputValue(cSlotSelect);

	if (!cName || !cPhoneRaw || !cGovernorate || !cArea || !cDayKey || !cSlotKey) {
	SetMessage("برجاء استكمال البيانات المطلوبة قبل تسجيل الطلب.", "error");
	return;
	}

	if (!IsValidEgyptPhone(cPhone)) {
	SetMessage("برجاء كتابة رقم موبايل مصري صحيح يبدأ بـ 01 ويتكون من 11 رقمًا.", "error");
	return;
	}

	if (IsPhoneAlreadySubmitted(cPhone)) {
	SetMessage("تم تسجيل طلب سابق بهذا الرقم. سيتم التواصل معك للتنسيق.", "warning");
	ShowWhatsAppButton(cName, cPhone, cGovernorate, cArea, cDayKey, cSlotKey);
	return;
	}

	if (IsSlotTaken(cDayKey, cSlotKey)) {
	SetMessage("هذا الموعد تم طلبه بالفعل. اختر موعدًا آخر من المواعيد المتاحة.", "error");
	RenderSlotOptions();
	RenderSchedule();
	return;
