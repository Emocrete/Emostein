	if (!IsApiReady()) {
	SetMessage("لم يتم ضبط رابط Google Apps Script بعد، لذلك لا يمكن حفظ الطلب حاليًا.", "error");
	return;
	}

	SetSubmitState(true);
	SetMessage("جاري تسجيل طلب المعاينة...", "info");

	try {
	const cDay = GetDayByKey(cDayKey);
	const cSlot = GetSlotByKey(cSlotKey);

	const cData = await CallApi({
	action: "createBooking",
	campaignKey: fCampaign.key,
	campaignYear: fCampaign.year,
	campaignMonth: fCampaign.month,
	pharmacistName: cName,
	phone: cPhone,
	phoneRaw: cPhoneRaw,
	governorate: cGovernorate,
	area: cArea,
	dayKey: cDayKey,
	dayLabel: cDay?.label || cDayKey,
	slotKey: cSlotKey,
	slotLabel: cSlot?.label || cSlotKey,
	status: "pending",
	pageUrl: window.location.href,
	pageTitle: document.title,
	createdAtIso: new Date().toISOString(),
	userAgent: navigator.userAgent,
	createdAtCairo: GetCairoDateText()
	});

	if (!cData.ok) {
	if (cData.code === "DUPLICATE_PHONE") {
