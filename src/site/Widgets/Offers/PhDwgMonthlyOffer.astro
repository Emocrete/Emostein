	UpdateCounters();
	return;
	}

	SetMessage("جاري تحميل حالة الحجوزات...", "info");

	try {
	const cData = await CallApi({
	action: "getBookings",
	campaignKey: fCampaign.key,
	campaignYear: fCampaign.year,
	campaignMonth: fCampaign.month,
	days: fCampaign.days,
	slots: cSlots
	});

	if (!cData.ok) {
	throw new Error(cData.message || "تعذر تحميل الحجوزات.");
	}

	fBookings = Array.isArray(cData.bookings) ? cData.bookings : [];

	RenderSlotOptions();
	RenderSchedule();
	UpdateCounters();
	SetMessage("", "");
	} catch (cError) {
	SetMessage("تعذر تحميل حالة الحجوزات حاليًا. يمكن المحاولة مرة أخرى بعد قليل.", "error");
	}
