	async function LoadBookings() {
	if (!IsApiReady()) {
	SetMessage("لم يتم ضبط رابط Google Apps Script حتى الآن. الودجت تعمل للمعاينة فقط، ولن تحفظ الطلبات قبل ضبط الرابط.", "warning");
