	ShowWhatsAppButton(cName, cPhone, cGovernorate, cArea, cDayKey, cSlotKey);
	return;
	}

	if (cData.code === "SLOT_TAKEN") {
	SetMessage("هذا الموعد لم يعد متاحًا. اختر موعدًا آخر من الشريط.", "error");
	await LoadBookings();
	return;
	}

	throw new Error(cData.message || "تعذر تسجيل الطلب.");
	}

	if (Array.isArray(cData.bookings)) {
	fBookings = cData.bookings;
	} else {
	fBookings.push({
	campaignKey: fCampaign.key,
	pharmacistName: cName,
	phone: cPhone,
	governorate: cGovernorate,
	area: cArea,
	dayKey: cDayKey,
	slotKey: cSlotKey,
	status: "pending"
	});
	}

	RenderSlotOptions();
	RenderSchedule();
	UpdateCounters();
	ShowWhatsAppButton(cName, cPhone, cGovernorate, cArea, cDayKey, cSlotKey);

	SetMessage("تم تسجيل طلب المعاينة بنجاح. سيتم التواصل معك للتنسيق وتأكيد الموعد.", "success");

	cForm.reset();
	ResetAreaSelect();
	RenderDayOptions();
	RenderSlotOptions();
	fSelectedDayKey = "";
	fSelectedSlotKey = "";
	MarkSelectedSlot();
	} catch (cError) {
	console.error("PhDwgMonthlyOffer submit error:", cError);
	SetMessage(`تعذر تسجيل الطلب: ${cError?.message || cError}`, "error");
	} finally {
	SetSubmitState(false);
	}
	}

	function HandleGovernorateChange() {
	const cGovernorate = GetInputValue(cGovernorateSelect);
	RenderAreaOptions(cGovernorate);
	}

	function HandleDayChange() {
	fSelectedDayKey = GetInputValue(cDaySelect);
	fSelectedSlotKey = "";
	RenderSlotOptions();
	MarkSelectedSlot();
	}

	function HandleSlotChange() {
	fSelectedDayKey = GetInputValue(cDaySelect);
	fSelectedSlotKey = GetInputValue(cSlotSelect);
	MarkSelectedSlot();
	}

	function RenderOfferText() {
	if (!cOfferText || !fCampaign) return;

	if (fCampaign.phase === "pre") {
	cOfferText.textContent = "احجز معاينة الرسم الهندسي للصيدلية الجديدة خلال أول 3 أيام من الشهر القادم، واستفد من خصم 1000 جنيه على الخدمة.";
	return;
	}

	if (fCampaign.phase === "dev") {
	cOfferText.textContent = "وضع المعاينة مفعل لأغراض التطوير. هذه النسخة تظهر خارج فترة العرض عند استخدام pForceShow أو phOffer=show.";
	return;
	}

	cOfferText.textContent = "العرض متاح الآن لحجوزات معاينة الرسم الهندسي للصيدليات الجديدة خلال أول 3 أيام من هذا الشهر.";
	}

	function RenderDayOptions() {
	if (!cDaySelect || !fCampaign) return;

	cDaySelect.innerHTML = `<option value="">اختر</option>`;

	for (const cDay of fCampaign.days) {
	const cOption = document.createElement("option");
	cOption.value = cDay.key;
	cOption.textContent = cDay.label;
	cDaySelect.appendChild(cOption);
	}
	}

	function RenderSlotOptions() {
	if (!cSlotSelect) return;

	const cDayKey = GetInputValue(cDaySelect);
	cSlotSelect.innerHTML = `<option value="">اختر</option>`;

	for (const cSlot of cSlots) {
	const cBooking = cDayKey ? GetBooking(cDayKey, cSlot.key) : null;
	const cOption = document.createElement("option");

	cOption.value = cSlot.key;
	cOption.textContent = cBooking
	? `${cSlot.label} - ${GetStatusLabel(cBooking.status)}`
	: cSlot.label;

	cOption.disabled = Boolean(cBooking && cBooking.status !== "cancelled");

	cSlotSelect.appendChild(cOption);
	}
	}

	function RenderAreaOptions(cGovernorate) {
	if (!cAreaSelect) return;

	const cSelectedAreas = cAreas[cGovernorate] || [];

	cAreaSelect.innerHTML = "";

	if (!cSelectedAreas.length) {
	ResetAreaSelect();
	return;
	}

	const cEmptyOption = document.createElement("option");
	cEmptyOption.value = "";
	cEmptyOption.textContent = "اختر";
	cAreaSelect.appendChild(cEmptyOption);

	for (const cArea of cSelectedAreas) {
	const cOption = document.createElement("option");
	cOption.value = cArea;
	cOption.textContent = cArea;
	cAreaSelect.appendChild(cOption);
	}

	cAreaSelect.disabled = false;
	}

	function ResetAreaSelect() {
	if (!cAreaSelect) return;

	cAreaSelect.innerHTML = `<option value="">اختر المحافظة أولًا</option>`;
	cAreaSelect.disabled = true;
	}

	function RenderSchedule() {
	if (!cSchedule || !fCampaign) return;

	cSchedule.innerHTML = "";

	for (const cDay of fCampaign.days) {
	const cDayEl = document.createElement("article");
	cDayEl.className = "PhDwgMonthlyOffer__Day";
	cDayEl.dataset.dayKey = cDay.key;

	const cTitle = document.createElement("h4");
	cTitle.textContent = cDay.label;

	const cSlotsEl = document.createElement("div");
	cSlotsEl.className = "PhDwgMonthlyOffer__Slots";

	for (const cSlot of cSlots) {
	const cBooking = GetBooking(cDay.key, cSlot.key);
	const cStatus = NormalizeStatus(cBooking?.status || "available");
	const cColors = GetSlotColors(cStatus);
	const cSvgId = `PhSlotGrad-${cDay.key}-${cSlot.key}`.replace(/[^\w-]/g, "");

	const cButton = document.createElement("button");
	cButton.type = "button";
	cButton.className = `PhDwgMonthlyOffer__Slot is-${cStatus}`;
	cButton.dataset.dayKey = cDay.key;
	cButton.dataset.slotKey = cSlot.key;
	cButton.dataset.status = cStatus;

	cButton.innerHTML = `
	<svg class="PhDwgMonthlyOffer__SlotSvg" viewBox="0 0 220 110" preserveAspectRatio="none" aria-hidden="true" focusable="false">
	<defs>
	<linearGradient id="${cSvgId}" x1="0" y1="0" x2="1" y2="1">
	<stop offset="0%" stop-color="${cColors.start}" />
	<stop offset="100%" stop-color="${cColors.end}" />
	</linearGradient>
	</defs>
	<polygon points="16,0 220,0 204,110 0,110" fill="url(#${cSvgId})"></polygon>
	<polygon points="28,10 210,10 196,100 10,100" fill="rgba(255,255,255,0.22)"></polygon>
	</svg>

	<span class="PhDwgMonthlyOffer__SlotContent">
	<span class="PhDwgMonthlyOffer__SlotTime">${cSlot.label}</span>
	<span class="PhDwgMonthlyOffer__SlotState">${GetStatusLabel(cStatus)}</span>
	</span>
	`;

	if (cStatus === "available" || cStatus === "cancelled") {
	cButton.addEventListener("click", HandleSlotButtonClick);
	} else {
	cButton.disabled = true;
	}

	cSlotsEl.appendChild(cButton);
	}

	cDayEl.appendChild(cTitle);
	cDayEl.appendChild(cSlotsEl);
	cSchedule.appendChild(cDayEl);
	}

	MarkSelectedSlot();
	UpdateCounters();
	}

	function HandleSlotButtonClick(cEvent) {
	const cButton = cEvent.currentTarget;
	const cDayKey = cButton.dataset.dayKey || "";
	const cSlotKey = cButton.dataset.slotKey || "";

	if (!cDayKey || !cSlotKey || IsSlotTaken(cDayKey, cSlotKey)) return;

	fSelectedDayKey = cDayKey;
	fSelectedSlotKey = cSlotKey;

	if (cDaySelect) {
	cDaySelect.value = cDayKey;
	}

	RenderSlotOptions();

	if (cSlotSelect) {
	cSlotSelect.value = cSlotKey;
	}

	MarkSelectedSlot();
	}

	function MarkSelectedSlot() {
	if (!cSchedule) return;

	const cButtons = cSchedule.querySelectorAll(".PhDwgMonthlyOffer__Slot");

	for (const cButton of cButtons) {
	const cIsSelected =
	cButton.dataset.dayKey === fSelectedDayKey &&
	cButton.dataset.slotKey === fSelectedSlotKey;

	cButton.classList.toggle("is-selected", cIsSelected);
	}
	}

	function UpdateCounters() {
	const cTotal = fCampaign ? fCampaign.days.length * cSlots.length : 15;

	const cBooked = fBookings.filter(function (cBooking) {
	return NormalizeStatus(cBooking.status) !== "cancelled";
	}).length;

	if (cBookedTitle) {
	cBookedTitle.textContent = `تم حجز ${cBooked} عروض من أصل ${cTotal} عرض`;
	}
	}

	function StartCountdown() {
	if (fCountdownTimer) {
	clearInterval(fCountdownTimer);
	}

	UpdateCountdown();
	fCountdownTimer = window.setInterval(UpdateCountdown, 1000);
	}

	function UpdateCountdown() {
	if (!cCountdown || !fCampaign) return;

	const cNow = GetCairoDate();
	const cStartsAt = fCampaign.startsAt;
	const cEndsAt = fCampaign.endsAt;
	const cTotalOfferMs = 3 * 24 * 60 * 60 * 1000;
	const cRemainingMs = cEndsAt.getTime() - cNow.getTime();

	if (cRemainingMs <= 0 && !cForceShow) {
	cCountdown.textContent = "انتهى العرض";
	if (cRoot) cRoot.hidden = true;
	return;
	}

	if (cRemainingMs <= 0 && cForceShow) {
	SetTimeProgress(0, "red");
	cCountdown.textContent = "انتهى العرض - وضع تطوير";
	return;
	}

	let cPercent = 100;
	let cColorState = "blue";

	if (cNow.getTime() >= cStartsAt.getTime()) {
	cPercent = Math.max(0, Math.min(100, (cRemainingMs / cTotalOfferMs) * 100));

	const cElapsedMs = cNow.getTime() - cStartsAt.getTime();
	const cOneDayMs = 24 * 60 * 60 * 1000;
	const cThreeHoursMs = 3 * 60 * 60 * 1000;

	if (cRemainingMs <= cThreeHoursMs) {
	cColorState = "red";
	} else if (cElapsedMs >= cOneDayMs * 2) {
	cColorState = "orange";
	} else if (cElapsedMs >= cOneDayMs) {
	cColorState = "yellow";
	} else {
	cColorState = "blue";
	}
	}

	SetTimeProgress(cPercent, cColorState);
	cCountdown.textContent = `ينتهي العرض خلال ${FormatRemainingTime(cRemainingMs)}`;
	}

	function SetTimeProgress(cPercent, cColorState) {
	if (cTimeFill) {
	cTimeFill.style.width = `${cPercent}%`;
	}

	if (!cRoot) return;

	cRoot.classList.remove(
	"is-time-blue",
	"is-time-yellow",
	"is-time-orange",
	"is-time-red"
	);

	cRoot.classList.add(`is-time-${cColorState}`);
	}

	function FormatRemainingTime(cRemainingMs) {
	const cTotalSeconds = Math.max(0, Math.floor(cRemainingMs / 1000));
	const cDays = Math.floor(cTotalSeconds / 86400);
	const cHours = Math.floor((cTotalSeconds % 86400) / 3600);
	const cMinutes = Math.floor((cTotalSeconds % 3600) / 60);
	const cSeconds = cTotalSeconds % 60;

	return `${cDays} يوم ${Pad2(cHours)} ساعة ${Pad2(cMinutes)} دقيقة ${Pad2(cSeconds)} ثانية`;
	}

	function GetCampaign(cNow) {
	const cCurrentYear = cNow.getFullYear();
	const cCurrentMonthIndex = cNow.getMonth();
	const cCurrentDay = cNow.getDate();
	const cLastDayInMonth = new Date(cCurrentYear, cCurrentMonthIndex + 1, 0).getDate();

	const cInLastWeek = cCurrentDay >= cLastDayInMonth - 6;
	const cInFirstThreeDays = cCurrentDay <= 3;

	if (!cInLastWeek && !cInFirstThreeDays) {
	return { isActive: false };
	}

	if (cInLastWeek && !cInFirstThreeDays) {
	return BuildCampaign(cCurrentYear, cCurrentMonthIndex + 1, "pre");
	}

	return BuildCampaign(cCurrentYear, cCurrentMonthIndex, "active");
	}

	function GetForcedCampaign(cNow) {
	let cTargetYear = cNow.getFullYear();
	let cTargetMonthIndex = cNow.getMonth();

	if (cNow.getDate() > 3) {
	cTargetMonthIndex += 1;
	}

	return BuildCampaign(cTargetYear, cTargetMonthIndex, "dev");
	}

	function BuildCampaign(cYear, cMonthIndex, cPhase) {
	while (cMonthIndex > 11) {
	cMonthIndex -= 12;
	cYear += 1;
	}

	while (cMonthIndex < 0) {
	cMonthIndex += 12;
	cYear -= 1;
	}

	const cMonth = cMonthIndex + 1;
	const cCampaignKey = `${cYear}-${Pad2(cMonth)}`;
	const cDays = [];

	for (let cDay = 1; cDay <= 3; cDay += 1) {
	const cDate = new Date(cYear, cMonthIndex, cDay);
	const cKey = `${cYear}-${Pad2(cMonth)}-${Pad2(cDay)}`;

	cDays.push({
	key: cKey,
	label: FormatArabicDay(cDate),
	day: cDay
	});
	}

	return {
	isActive: true,
	key: cCampaignKey,
	year: cYear,
	month: cMonth,
	monthIndex: cMonthIndex,
	phase: cPhase,
	days: cDays,
	startsAt: new Date(cYear, cMonthIndex, 1, 0, 0, 0),
	endsAt: new Date(cYear, cMonthIndex, 4, 0, 0, 0)
	};
	}

	function GetCairoDate() {
	const cFormatter = new Intl.DateTimeFormat("en-CA", {
	timeZone: "Africa/Cairo",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
	hour: "2-digit",
	minute: "2-digit",
	second: "2-digit",
	hourCycle: "h23"
	});

	const cParts = cFormatter.formatToParts(new Date());
	const cMap = {};

	for (const cPart of cParts) {
	if (cPart.type !== "literal") {
	cMap[cPart.type] = cPart.value;
	}
	}

	return new Date(
	Number(cMap.year),
	Number(cMap.month) - 1,
	Number(cMap.day),
	Number(cMap.hour),
	Number(cMap.minute),
	Number(cMap.second)
	);
	}

	function GetCairoDateText() {
	return GetCairoDate().toLocaleString("ar-EG", {
	dateStyle: "medium",
	timeStyle: "short"
	});
	}

	function FormatArabicDay(cDate) {
	return cDate.toLocaleDateString("ar-EG", {
	weekday: "long",
	day: "numeric",
	month: "long"
	});
	}

	function Pad2(cValue) {
	return String(cValue).padStart(2, "0");
	}

	function GetBooking(cDayKey, cSlotKey) {
	const cCampaignKey = String(fCampaign?.key || "").trim();
	const cDay = String(cDayKey || "").trim();
	const cSlot = String(cSlotKey || "").trim();

	return fBookings.find(function (cBooking) {
	return (
	String(cBooking.campaignKey || "").trim() === cCampaignKey &&
	String(cBooking.dayKey || "").trim() === cDay &&
	String(cBooking.slotKey || "").trim() === cSlot &&
	NormalizeStatus(cBooking.status) !== "cancelled"
	);
	});
	}

	function NormalizeStatus(cStatus) {
	const cValue = String(cStatus || "available").trim().toLowerCase();

	if (cValue === "pending") return "pending";
	if (cValue === "confirmed") return "confirmed";
	if (cValue === "cancelled") return "cancelled";

	return "available";
	}

	function IsSlotTaken(cDayKey, cSlotKey) {
	return Boolean(GetBooking(cDayKey, cSlotKey));
	}

	function IsPhoneAlreadySubmitted(cPhone) {
	return fBookings.some(function (cBooking) {
	return NormalizeEgyptPhone(cBooking.phone || "") === cPhone && cBooking.status !== "cancelled";
	});
	}

	function GetDayByKey(cDayKey) {
	return fCampaign?.days.find(function (cDay) {
	return cDay.key === cDayKey;
	});
	}

	function GetSlotByKey(cSlotKey) {
	return cSlots.find(function (cSlot) {
	return cSlot.key === cSlotKey;
	});
	}

	function GetStatusLabel(cStatus) {
	if (cStatus === "pending") return "تم طلبه";
	if (cStatus === "confirmed") return "محجوز";
	if (cStatus === "cancelled") return "متاح";
	return "متاح";
	}

	function GetSlotColors(cStatus) {
	if (cStatus === "pending") {
	return {
	start: "#FFE8A3",
	end: "#FFC83D"
	};
	}

	if (cStatus === "confirmed") {
	return {
	start: "#FFC6C6",
	end: "#FF7E7E"
	};
	}

	return {
	start: "#A8F5C4",
	end: "#27D86F"
	};
	}

	async function CallApi(cPayload) {
	console.log("PhDwgMonthlyOffer request:", cPayload);

	const cResponse = await fetch(cApiUrl, {
	method: "POST",
	headers: {
	"Content-Type": "text/plain;charset=utf-8"
	},
	body: JSON.stringify(cPayload)
	});

	const cText = await cResponse.text();

	console.log("PhDwgMonthlyOffer response status:", cResponse.status);
	console.log("PhDwgMonthlyOffer response text:", cText);

	try {
	return JSON.parse(cText);
	} catch (cError) {
	return {
	ok: false,
	code: "INVALID_RESPONSE",
	message: "Invalid JSON response",
	raw: cText
	};
	}
	}

	function IsApiReady() {
	return Boolean(cApiUrl && !cApiUrl.includes("PUT_GOOGLE_APPS_SCRIPT_WEB_APP_URL_HERE"));
	}

	function NormalizeEgyptPhone(cPhone) {
	return String(cPhone || "")
	.replace(/[^\d+]/g, "")
	.replace(/^0020/, "0")
	.replace(/^\+20/, "0");
	}

	function IsValidEgyptPhone(cPhone) {
	return /^01[0125][0-9]{8}$/.test(cPhone);
	}

	function GetInputValue(cElement) {
	return String(cElement?.value || "").trim();
	}

	function SetSubmitState(cIsLoading) {
	if (!cSubmitButton) return;

	cSubmitButton.disabled = cIsLoading;

	const cTextEl = cSubmitButton.querySelector(".BtnText");

	if (cTextEl) {
	cTextEl.textContent = cIsLoading ? "جاري التسجيل..." : "تسجيل الطلب";
	return;
	}

	cSubmitButton.textContent = cIsLoading ? "جاري التسجيل..." : "تسجيل الطلب";
	}

	function SetMessage(cText, cType) {
	if (!cMessage) return;

	cMessage.textContent = cText || "";
	cMessage.dataset.type = cType || "";
	cMessage.hidden = !cText;
	}

	function ShowWhatsAppButton(cName, cPhone, cGovernorate, cArea, cDayKey, cSlotKey) {
	if (!cWhatsApp) return;

	const cDay = GetDayByKey(cDayKey);
	const cSlot = GetSlotByKey(cSlotKey);

	const cText = [
	"مرحبًا، قمت بتسجيل طلب معاينة الرسم الهندسي للصيدلية الجديدة.",
	`الاسم: ${cName}`,
	`رقم الهاتف: ${cPhone}`,
	`المحافظة: ${cGovernorate}`,
	`المنطقة: ${cArea}`,
	`اليوم: ${cDay?.label || cDayKey}`,
	`الموعد: ${cSlot?.label || cSlotKey}`
	].join("\n");

	cWhatsApp.href = `https://wa.me/${cWhatsAppNumber}?text=${encodeURIComponent(cText)}`;
	cWhatsApp.hidden = false;
	}
</script>
