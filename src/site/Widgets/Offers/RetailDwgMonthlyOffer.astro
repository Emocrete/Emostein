---
import { EmoBtn, Emograph, Stack } from "@/Widgets/Comp";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, NumPer, Pixel, type PlaceProps, Size, Text } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"div">, PlaceProps {
	pForceShow?: boolean;
}

const {
	id: pGivenID = GetWidgetId("RetailDwgMonthlyOffer"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	pForceShow = false,
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = typeof pGivenStyle === "string" ? pGivenStyle : "";

const cWidgetId = pGivenID;
---




















<EmoStr
	class = {`RetailDwgMonthlyOffer ${pGivenClass}`.trim()}
	style = {cGivenStyle}
	id={cWidgetId}
	hidden
	data-retail-dwg-monthly-offer
	pBg={new ElemBg("#102d25")}
	pSize={new Size(new NumPer("100%", "100%"), new NumPer(400, "auto"))}
	pSlot={{ Size: new Size(new NumPer("100%", "100%"), new NumPer("100%", "auto")), Align: Align.Center }}
	pLoc={pLoc}
	pSize={pSize}
	pRotate={pRotate}
	pZ={pZ}
	pOrigin={pOrigin}
	pOpacity={pOpacity}
	pClickable={pClickable}
	pLandOnly={pLandOnly}
	pPortOnly={pPortOnly}
	{...RemAttr}
>







	<Stack
		class = " RetailDwgMonthlyOffer__Main "
		pDir="Row"
		pPad={new Pixel(15, 10)}
		pGap={new Pixel(15, 10)}
	>

		<Stack>

			<Emograph pTitle={Text.Body.OfSize(30).White.Centered.OfText("خصم")} />

			<Emograph pTitle={Text.Body.OfSize(80,60).DarkSky.Centered.OfText("1000 جنيه")} />

			<Emograph
				pTitle={Text.Body.OfSize(30, 18).White.Centered.OfText("على الرسم الهندسي للمحل التجاري عند حجز معاينة خلال الأيام الثلاثة الأولى من الشهر")}
			/>

		</Stack>

		<form
			class = " RetailDwgMonthlyOffer__Form "
			method="post"
			autocomplete="on"
			data-retail-form
		>

			<div class = " RetailDwgMonthlyOffer__TimePanel ">

				<div class = " RetailDwgMonthlyOffer__TimeProgress " data-retail-time-progress>

					<div class = " RetailDwgMonthlyOffer__TimeProgressFill " data-retail-time-fill>

					</div>

					<span class = " RetailDwgMonthlyOffer__TimeProgressText " data-retail-countdown>
						جاري حساب الوقت المتبقي
					</span>

				</div>

			</div>

			<label class = " RetailDwgMonthlyOffer__Field " for={`${cWidgetId}-Name`}>

				<span>
					اسم صاحب المحل / اسم المحل
				</span>

				<input
					id={`${cWidgetId}-Name`}
					name="clientName"
					type="text"
					autocomplete="name"
					required
					placeholder="اكتب الاسم"
					data-retail-name
				/>

			</label>

			<label class = " RetailDwgMonthlyOffer__Field " for={`${cWidgetId}-Phone`}>

				<span>
					رقم التليفون
				</span>

				<input
					id={`${cWidgetId}-Phone`}
					name="phone"
					type="tel"
					inputmode="tel"
					autocomplete="tel"
					required
					placeholder="01xxxxxxxxx"
					data-retail-phone
				/>

			</label>

			<label class = " RetailDwgMonthlyOffer__Field " for={`${cWidgetId}-Gov`}>

				<span>
					المحافظة
				</span>

				<select
					id={`${cWidgetId}-Gov`}
					name="governorate"
					required
					data-retail-governorate
				>

					<option value="">

						اختر

					</option>

					<option value="القاهرة">

						القاهرة

					</option>

					<option value="الجيزة">

						الجيزة

					</option>

				</select>

			</label>

			<label class = " RetailDwgMonthlyOffer__Field " for={`${cWidgetId}-Area`}>

				<span>
					الحي أو المنطقة
				</span>

				<select
					id={`${cWidgetId}-Area`}
					name="area"
					required
					data-retail-area
					disabled
				>

					<option value="">

						اختر المحافظة أولًا

					</option>

				</select>

			</label>

			<label class = " RetailDwgMonthlyOffer__Field " for={`${cWidgetId}-Day`}>

				<span>
					اليوم
				</span>

				<select
					id={`${cWidgetId}-Day`}
					name="dayKey"
					required
					data-retail-day
				>

					<option value="">

						اختر

					</option>

				</select>

			</label>

			<label class = " RetailDwgMonthlyOffer__Field " for={`${cWidgetId}-Slot`}>

				<span>
					الموعد
				</span>

				<select
					id={`${cWidgetId}-Slot`}
					name="slotKey"
					required
					data-retail-slot
				>

					<option value="">

						اختر

					</option>

				</select>

			</label>

			<EmoBtn
				class = " RetailDwgMonthlyOffer__Submit "
				pText="تسجيل الطلب"
				pWidth="100%"
				pHeight="34px"
				pRadius="9px"
				pBgColor="#1f3d34"
				pBgColorHover="#284f44"
				pTextColor="#ffffff"
				pFontSize="0.82rem"
				type="submit"
				data-retail-submit
			/>

			<p class = " RetailDwgMonthlyOffer__Note ">
				التسجيل لا يعني تأكيد الموعد نهائيًا. سيتم التواصل مع صاحب المحل للتنسيق وتأكيد التفاصيل.
			</p>

			<div
				class = " RetailDwgMonthlyOffer__Message "
				role="status"
				data-retail-message
			>

			</div>

			<a
				class = " RetailDwgMonthlyOffer__WhatsApp "
				href="#"
				target="_blank"
				rel="noopener"
				hidden
				data-retail-whatsapp
			>
				متابعة الطلب على واتساب
			</a>

		</form>

		<Stack
			class = " RetailDwgMonthlyOffer__ScheduleArea "
			pDir="Col"
			pWidth={new Pixel(900, 360)}
			pPad={new Pixel(0, 0)}
			pGap={new Pixel(8, 8)}
			pHzAlign="Start"
			pVrAlign="Start"
			pFlipNarrow={false}
		>

			<header class = " RetailDwgMonthlyOffer__ScheduleTitle ">

				<h3 data-retail-booked-title>
					تم حجز 0 عروض من أصل 15 عرض
				</h3>

				<p>
					اضغط على أي موعد متاح لاختياره مباشرة داخل النموذج.
				</p>

			</header>

			<div class = " RetailDwgMonthlyOffer__Schedule " data-retail-schedule>

			</div>

		</Stack>

	</Stack>







</EmoStr>




















<style is:global>



	.RetailDwgMonthlyOffer__Kicker {
		display: inline-flex;
		width: fit-content;
		padding: 6px 14px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.13);
		border: 1px solid rgba(255, 255, 255, 0.22);
		font-size: 0.82rem;
		font-weight: 900;
		line-height: 1.2;
	}


	.RetailDwgMonthlyOffer__Descr {
		max-width: 100%;
		margin: 0;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.9rem;
		line-height: 1.55;
		text-align: right;
	}


	.RetailDwgMonthlyOffer__Form {
		flex: 0 0 420px;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-content: start;
		gap: 8px;
		width: 420px;
		height: 100%;
		padding: 14px;
		border-radius: 18px;
		background: #ffffff;
		color: #1b1b1b;
		overflow: hidden;
		box-shadow: 0 14px 35px rgba(0, 0, 0, 0.25);
		direction: rtl;
	}


	.RetailDwgMonthlyOffer__TimePanel {
		grid-column: 1 / -1;
	}


	.RetailDwgMonthlyOffer__TimeProgress {
		position: relative;
		width: 100%;
		height: 34px;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.10);
		border: 1px solid rgba(0, 0, 0, 0.10);
	}


	.RetailDwgMonthlyOffer__TimeProgressFill {
		position: absolute;
		inset-block: 0;
		right: 0;
		width: 100%;
		border-radius: inherit;
		transition: width 0.45s linear, background 0.3s ease;
	}


	.RetailDwgMonthlyOffer__TimeProgressText {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: grid;
		place-items: center;
		padding: 0 10px;
		color: #111111;
		font-size: 0.68rem;
		font-weight: 950;
		line-height: 1.2;
		text-align: center;
		white-space: nowrap;
	}


	.RetailDwgMonthlyOffer__Field {
		display: grid;
		gap: 3px;
		min-width: 0;
	}

	.RetailDwgMonthlyOffer__Field span {
		font-size: 0.68rem;
		font-weight: 900;
		color: #1f3d34;
		white-space: nowrap;
	}


	.RetailDwgMonthlyOffer__Submit .BtnText {
		font-weight: 950;
	}


	.RetailDwgMonthlyOffer__Note {
		grid-column: 1 / -1;
		margin: 0;
		color: #5a5a5a;
		font-size: 0.68rem;
		line-height: 1.35;
	}


	.RetailDwgMonthlyOffer__Message {
		grid-column: 1 / -1;
		min-height: 26px;
		max-height: 38px;
		overflow: hidden;
		padding: 5px 8px;
		border-radius: 9px;
		font-size: 0.68rem;
		line-height: 1.35;
	}


	.RetailDwgMonthlyOffer__WhatsApp {
		grid-column: 1 / -1;
		display: grid;
		place-items: center;
		min-height: 28px;
		border-radius: 9px;
		background: #25d366;
		color: #ffffff;
		text-decoration: none;
		font-size: 0.74rem;
		font-weight: 900;
	}


	.RetailDwgMonthlyOffer__ScheduleTitle {
		display: grid;
		justify-items: start;
		align-content: center;
		gap: 3px;
		min-height: 38px;
		padding: 0;
	}

	.RetailDwgMonthlyOffer__ScheduleTitle h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 950;
	}

	.RetailDwgMonthlyOffer__ScheduleTitle p {
		margin: 0;
		color: rgba(255, 255, 255, 0.75);
		font-size: 0.74rem;
		line-height: 1.3;
	}


	.RetailDwgMonthlyOffer__Schedule {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: repeat(3, minmax(0, 1fr));
		gap: 8px;
		width: 100%;
		height: calc(100% - 46px);
		min-height: 0;
		padding: 0;
	}


	.RetailDwgMonthlyOffer__Day {
		display: grid;
		grid-template-rows: 28px minmax(0, 1fr);
		min-height: 0;
		overflow: hidden;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.10);
		border: 1px solid rgba(255, 255, 255, 0.16);
	}

	.RetailDwgMonthlyOffer__Day h4 {
		display: grid;
		place-items: center;
		margin: 0;
		padding: 4px 8px;
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.06));
		font-size: 0.82rem;
		font-weight: 950;
		line-height: 1.1;
	}


	.RetailDwgMonthlyOffer__Slots {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 8px;
		min-height: 0;
		padding: 8px;
	}


	.RetailDwgMonthlyOffer__Slot {
		position: relative;
		display: grid;
		place-items: center;
		min-width: 0;
		min-height: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #10241f;
		font: inherit;
		cursor: pointer;
		isolation: isolate;
		overflow: hidden;
		transition: transform 0.18s ease, filter 0.18s ease;
	}

	.RetailDwgMonthlyOffer__Slot:hover {
		transform: translateY(-2px);
		filter: brightness(1.03);
	}

	.RetailDwgMonthlyOffer__Slot:disabled {
		cursor: not-allowed;
		transform: none;
	}


	.RetailDwgMonthlyOffer__SlotSvg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}


	.RetailDwgMonthlyOffer__SlotContent {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 3px;
		place-items: center;
		padding: 5px;
		text-align: center;
	}


	.RetailDwgMonthlyOffer__SlotTime {
		display: block;
		font-size: clamp(0.74rem, 0.9vw, 0.95rem);
		line-height: 1.15;
		font-weight: 950;
	}


	.RetailDwgMonthlyOffer__SlotState {
		display: block;
		font-size: 0.68rem;
		line-height: 1.1;
		font-weight: 900;
	}



	.EmoStr.RetailDwgMonthlyOffer {
		width: 100%;
		max-width: 100%;
		height: 400px;
		margin-inline: 0;
		background: radial-gradient(circle at 15% 0%, rgba(255, 255, 255, 0.10), transparent 35%),
		linear-gradient(135deg, #102d25, #17382f);
		overflow: hidden;
		direction: rtl;
		color: #ffffff;
	}

	.EmoStr.RetailDwgMonthlyOffer {
		box-sizing: border-box;
	}

	.EmoStr.RetailDwgMonthlyOffer > .SlotBox {
		width: 100%;
		height: 100%;
		align-items: stretch;
	}

	.EmoStr.RetailDwgMonthlyOffer > .SlotBox > .SlotContent {
		width: 100%;
		height: 100%;
		max-width: 100%;
		align-items: stretch;
		justify-content: stretch;
		flex-wrap: nowrap;
	}


	.RetailDwgMonthlyOffer__Main.EmoStack {
		width: 100%;
		height: 100%;
		max-width: 100%;
		margin: 0;
		padding: 15px;
		gap: 15px;
		align-items: stretch;
		direction: rtl;
	}

	.RetailDwgMonthlyOffer__Main.EmoStack > * {
		height: 100%;
		min-width: 0;
	}


	.RetailDwgMonthlyOffer__IntroPane.EmoStack {
		flex: 0 0 32%;
		width: auto;
		height: 100%;
		margin: 0;
		padding: 10px;
		gap: 10px;
		justify-content: center;
		align-items: flex-start;
		direction: rtl;
	}


	.RetailDwgMonthlyOffer__IntroGraph.Emograph {
		align-items: flex-start;
	}

	.RetailDwgMonthlyOffer__IntroGraph.Emograph h2 {
		font-size: clamp(1.7rem, 2.7vw, 3rem) !important;
		line-height: 1.12 !important;
		font-weight: 950 !important;
		text-align: right !important;
		text-wrap: balance;
	}


	.RetailDwgMonthlyOffer.is-time-blue .RetailDwgMonthlyOffer__TimeProgressFill {
		background: linear-gradient(90deg, #5ee7ff, #23b7ff);
	}


	.RetailDwgMonthlyOffer.is-time-yellow .RetailDwgMonthlyOffer__TimeProgressFill {
		background: linear-gradient(90deg, #fff07a, #ffd63d);
	}


	.RetailDwgMonthlyOffer.is-time-orange .RetailDwgMonthlyOffer__TimeProgressFill {
		background: linear-gradient(90deg, #ffc06a, #ff982b);
	}


	.RetailDwgMonthlyOffer.is-time-red .RetailDwgMonthlyOffer__TimeProgressFill {
		background: linear-gradient(90deg, #ff8a8a, #ff3f3f);
	}


	.RetailDwgMonthlyOffer__Submit.Btn {
		grid-column: 1 / -1;
		min-height: 34px;
		font-weight: 950;
	}


	.RetailDwgMonthlyOffer__ScheduleArea.EmoStack {
		flex: 1 1 0;
		width: auto;
		height: 100%;
		margin: 0;
		padding: 0;
		gap: 8px;
		align-items: stretch;
		direction: rtl;
	}


	.RetailDwgMonthlyOffer__Slot.is-selected {
		outline: 3px solid #ffffff;
		outline-offset: -7px;
		transform: translateY(-3px);
	}



	.EmoStr.RetailDwgMonthlyOffer,
	.EmoStr.RetailDwgMonthlyOffer *
	{
		box-sizing: border-box;
	}


	.EmoStr.RetailDwgMonthlyOffer[hidden] {
		display: none;
	}


	.RetailDwgMonthlyOffer__Field input,
	.RetailDwgMonthlyOffer__Field select
	{
		width: 100%;
		height: 32px;
		padding: 5px 8px;
		border: 1px solid #d7dedb;
		border-radius: 9px;
		background: #ffffff;
		color: #111111;
		font: inherit;
		font-size: 0.76rem;
		outline: none;
	}


	.RetailDwgMonthlyOffer__Message[hidden] {
		display: none;
	}


	.RetailDwgMonthlyOffer__Message[data-type="success"] {
		background: #e8f7ee;
		color: #176b3a;
	}


	.RetailDwgMonthlyOffer__Message[data-type="error"] {
		background: #fdecec;
		color: #a32828;
	}


	.RetailDwgMonthlyOffer__Message[data-type="warning"] {
		background: #fff6df;
		color: #8a5b00;
	}


	.RetailDwgMonthlyOffer__Message[data-type="info"] {
		background: #eef4ff;
		color: #244a86;
	}


	.RetailDwgMonthlyOffer__WhatsApp[hidden] {
		display: none;
	}



</style>




















<style is:global>



	@media (max-width: 1100px) {
		.EmoStr.RetailDwgMonthlyOffer {
			height: auto;
			min-height: 400px;
			overflow: visible;
		}

		.EmoStr.RetailDwgMonthlyOffer > .SlotBox,
		.EmoStr.RetailDwgMonthlyOffer > .SlotBox > .SlotContent
		{
			height: auto;
		}

		.RetailDwgMonthlyOffer__Main.EmoStack {
			height: auto;
			flex-direction: column;
		}

		.RetailDwgMonthlyOffer__IntroPane.EmoStack,
		.RetailDwgMonthlyOffer__Form,
		.RetailDwgMonthlyOffer__ScheduleArea.EmoStack
		{
			flex: none;
			width: 100%;
			height: auto;
		}

		.RetailDwgMonthlyOffer__Form {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.RetailDwgMonthlyOffer__Schedule {
			height: auto;
			grid-template-rows: auto;
		}

		.RetailDwgMonthlyOffer__Day {
			min-height: 90px;
		}
	}


	@media (max-width: 650px) {
		.EmoStr.RetailDwgMonthlyOffer {
			height: auto !important;
			min-height: 0;
			padding: 12px 10px;
			overflow: visible;
		}

		.EmoStr.RetailDwgMonthlyOffer > .SlotBox,
		.EmoStr.RetailDwgMonthlyOffer > .SlotBox > .SlotContent
		{
			height: auto !important;
			min-height: 0;
			overflow: visible;
		}

		.RetailDwgMonthlyOffer__Main.EmoStack {
			height: auto !important;
			padding: 10px;
			gap: 10px;
			overflow: visible;
		}

		.RetailDwgMonthlyOffer__IntroPane.EmoStack {
			height: auto !important;
			padding: 0;
			gap: 6px;
		}

		.RetailDwgMonthlyOffer__IntroGraph.Emograph h2 {
			font-size: 1.65rem !important;
			line-height: 1.12 !important;
			text-align: center !important;
		}

		.RetailDwgMonthlyOffer__Descr {
			font-size: 0.78rem;
			line-height: 1.35;
			text-align: center;
		}

		.RetailDwgMonthlyOffer__Kicker {
			margin-inline: auto;
			font-size: 0.72rem;
			padding: 5px 12px;
		}

		.RetailDwgMonthlyOffer__Form {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 7px;
			width: 100%;
			height: auto !important;
			max-height: none;
			padding: 10px;
			border-radius: 14px;
			overflow: visible;
		}

		.RetailDwgMonthlyOffer__TimePanel,
		.RetailDwgMonthlyOffer__Submit,
		.RetailDwgMonthlyOffer__Note,
		.RetailDwgMonthlyOffer__Message,
		.RetailDwgMonthlyOffer__WhatsApp
		{
			grid-column: 1 / -1;
		}

		.RetailDwgMonthlyOffer__TimeProgress {
			height: 30px;
		}

		.RetailDwgMonthlyOffer__TimeProgressText {
			font-size: 0.58rem;
			white-space: normal;
			line-height: 1.15;
		}

		.RetailDwgMonthlyOffer__Field {
			gap: 2px;
		}

		.RetailDwgMonthlyOffer__Field span {
			font-size: 0.58rem;
			line-height: 1.1;
		}

		.RetailDwgMonthlyOffer__Field input,
		.RetailDwgMonthlyOffer__Field select
		{
			height: 30px;
			padding: 4px 6px;
			border-radius: 8px;
			font-size: 0.66rem;
		}

