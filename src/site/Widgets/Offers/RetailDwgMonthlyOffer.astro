<script define:vars={{ cWidgetId, pForceShow }}>
	const cApiUrl = "https://script.google.com/macros/s/AKfycbzeTnfUKH9Y3shjoCq9FUsYTxTf7FvUImLcwQZEx2ppnX1EHirIuOZTiLxnQB_HpVfNXQ/exec";
	const cWhatsAppNumber = "201014490054";
	const cAllowedHosts = new Set(["emocrete.com", "www.emocrete.com"]);
	const cIsRealDomain = cAllowedHosts.has(window.location.hostname.toLowerCase());

	const cRoot = document.getElementById(cWidgetId);
	const cUrlParams = new URLSearchParams(window.location.search);

	const cForceShow =
	Boolean(pForceShow) ||
	cRoot?.dataset.forceShow === "true" ||
	cUrlParams.get("retailOffer") === "show";

	const cForm = cRoot?.querySelector("[data-retail-form]");
	const cNameInput = cRoot?.querySelector("[data-retail-name]");
	const cPhoneInput = cRoot?.querySelector("[data-retail-phone]");
	const cGovernorateSelect = cRoot?.querySelector("[data-retail-governorate]");
