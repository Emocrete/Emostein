	const cMessage = cRoot?.querySelector("[data-retail-message]");
	const cSchedule = cRoot?.querySelector("[data-retail-schedule]");
	const cOfferText = cRoot?.querySelector("[data-retail-offer-text]");
	const cBookedTitle = cRoot?.querySelector("[data-retail-booked-title]");
	const cCountdown = cRoot?.querySelector("[data-retail-countdown]");
	const cTimeFill = cRoot?.querySelector("[data-retail-time-fill]");
	const cWhatsApp = cRoot?.querySelector("[data-retail-whatsapp]");

	const cSlots = [
	{ key: "12:00", label: "12:00 ظهرًا" },
	{ key: "14:00", label: "2:00 مساءً" },
	{ key: "16:00", label: "4:00 مساءً" },
	{ key: "18:00", label: "6:00 مساءً" },
	{ key: "20:00", label: "8:00 مساءً" }
	];

	const cAreas = {
	"القاهرة": [
