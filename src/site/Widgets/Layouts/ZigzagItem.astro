---
import { Place, type PlaceProps, RespString } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import { GetLayoutBackground, GetLayoutPair, GetRootAttributes, GetStyleText, type LayoutBackground, type LayoutValue } from "./LayoutUtils";

type MediaSide = "Auto" | "Start" | "End";
type MediaClip = "None" | "Diagonal" | "Arch" | "Inset";

export interface Props extends DebugOutlineProps, HTMLAttributes<"article">, PlaceProps {
  pMediaShare?: number;
  pSide?: MediaSide;
  pGap?: LayoutValue;
  pPad?: LayoutValue;
  pMinHeight?: LayoutValue;
  pMediaMinHeight?: LayoutValue;
  pBg?: LayoutBackground;
  pColor?: string;
  pRadius?: LayoutValue;
  pMediaBg?: LayoutBackground;
  pMediaRadius?: LayoutValue;
  pClip?: MediaClip;
  pClipP?: MediaClip;
}

const cProps = Astro.props as Props & Record<string, unknown>;
const {
  pMediaShare = 54,
  pSide = "Auto",
  pGap = new RespString("0px", "0px"),
  pPad = new RespString("0px", "0px"),
  pMinHeight = new RespString("380px", "440px"),
  pMediaMinHeight = new RespString("280px", "220px"),
  pBg = "#ffffff",
  pColor = "#17212a",
  pRadius = new RespString("30px", "22px"),
  pMediaBg = "linear-gradient(145deg, #17232e, #3e5868)",
  pMediaRadius = new RespString("0px", "18px"),
  pClip = "None",
  pClipP = "None",
  id: pGivenID = GetWidgetId("ZigzagItem"),
  class: pGivenClass = "",
  style: pGivenStyle = "",
} = cProps;

const cSafeShare = Math.min(75, Math.max(25, Number(pMediaShare) || 54));
const cGap = GetLayoutPair(pGap, "0px");
const cPad = GetLayoutPair(pPad, "0px");
const cMinHeight = GetLayoutPair(pMinHeight, "380px");
const cMediaMinHeight = GetLayoutPair(pMediaMinHeight, "280px");
const cRadius = GetLayoutPair(pRadius, "30px");
const cMediaRadius = GetLayoutPair(pMediaRadius, "0px");
const cHasMedia = Astro.slots.has("media");
const cHasContent = Astro.slots.has("default");

const cCoreStyle = [
  `--ZigzagItemMediaShare:${cSafeShare}fr;`,
  `--ZigzagItemContentShare:${100 - cSafeShare}fr;`,
  `--ZigzagItemGapL:${cGap.Landscape};`,
  `--ZigzagItemGapP:${cGap.Portrait};`,
  `--ZigzagItemPadL:${cPad.Landscape};`,
  `--ZigzagItemPadP:${cPad.Portrait};`,
  `--ZigzagItemMinHeightL:${cMinHeight.Landscape};`,
  `--ZigzagItemMinHeightP:${cMinHeight.Portrait};`,
  `--ZigzagMediaMinHeightL:${cMediaMinHeight.Landscape};`,
  `--ZigzagMediaMinHeightP:${cMediaMinHeight.Portrait};`,
  `--ZigzagItemBg:${GetLayoutBackground(pBg)};`,
  `--ZigzagItemColor:${pColor};`,
  `--ZigzagItemRadiusL:${cRadius.Landscape};`,
  `--ZigzagItemRadiusP:${cRadius.Portrait};`,
  `--ZigzagMediaBg:${GetLayoutBackground(pMediaBg)};`,
  `--ZigzagMediaRadiusL:${cMediaRadius.Landscape};`,
  `--ZigzagMediaRadiusP:${cMediaRadius.Portrait};`,
  GetStyleText(pGivenStyle),
]
  .filter(Boolean)
  .join(" ");

const cPlace = new Place(cProps as PlaceProps, cCoreStyle);
const cRootAttrs = GetRootAttributes(cProps, [
  "pMediaShare",
  "pSide",
  "pGap",
  "pPad",
  "pMinHeight",
  "pMediaMinHeight",
  "pBg",
  "pColor",
  "pRadius",
  "pMediaBg",
  "pMediaRadius",
  "pClip",
  "pClipP",
]);
---





<article
	style = {cPlace.Style}
	class:list={["ZigzagItem", `${pSide}Side`, `ClipL${pClip}`, `ClipP${pClipP}`, cPlace.Class, pGivenClass]}
	id={pGivenID}
	{...cRootAttrs}
>







	<div class = " ZigzagItemMedia ">

		{ cHasMedia ?

			<slot name="media" />

			:

			<span class = " ZigzagMediaFallback ">
				MEDIA
			</span>

		}

	</div>







	<div class = " ZigzagItemContent ">

		{ cHasContent ? (

			<slot />
		) : (

			<>
			
			
			
			
			
			
			
				<small>
			
					قصة متعاقبة
			
				</small>
			
			
			
			
			
			
			
				<h3>
					عنوان المرحلة داخل السرد
				</h3>
			
			
			
			
			
			
			
				<p>
					الجزء يعمل بتكوين جاهز، ويمكن وضع أي ودجات محتوى داخله مباشرة.
				</p>
			
			
			
			
			
			
			
			</>
		) }

	</div>







</article>





<style>



	.ZigzagItem {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, var(--ZigzagItemMediaShare)) minmax(0, var(--ZigzagItemContentShare));
		box-sizing: border-box;
		min-width: 0;
		min-height: var(--ZigzagItemMinHeightL);
		padding: var(--ZigzagItemPadL);
		gap: var(--ZigzagItemGapL);
		border-radius: var(--ZigzagItemRadiusL);
		background: var(--ZigzagItemBg);
		color: var(--ZigzagItemColor);
		overflow: hidden;
		box-shadow: 0 20px 50px rgba(27, 37, 46, 0.08);
	}


	.ZigzagItemMedia {
		align-items: center;
		justify-content: center;
		min-height: var(--ZigzagMediaMinHeightL);
		border-radius: var(--ZigzagMediaRadiusL);
		background: var(--ZigzagMediaBg);
		overflow: hidden;
	}

	.ZigzagItemMedia > :global(*) {
		max-width: 100%;
	}


	.ZigzagItemContent {
		align-items: flex-start;
		justify-content: center;
		padding: clamp(30px, 5vw, 68px);
		gap: 12px;
	}

	.ZigzagItemContent > small {
		font-weight: 900;
		letter-spacing: 0.08em;
		opacity: 0.56;
	}

	.ZigzagItemContent > h3 {
		max-width: 18ch;
		font-size: clamp(28px, 4vw, 52px);
		line-height: 1.15;
	}

	.ZigzagItemContent > p {
		max-width: 42ch;
		line-height: 1.85;
		opacity: 0.72;
	}


	.ZigzagMediaFallback {
		font-size: clamp(48px, 8vw, 110px);
		font-weight: 200;
		letter-spacing: 0.08em;
		color: rgba(255, 255, 255, 0.88);
	}



	.ZigzagItem.EndSide .ZigzagItemMedia {
		order: 2;
	}

	.ZigzagItem.EndSide .ZigzagItemContent {
		order: 1;
	}


	.ZigzagItem.ClipLDiagonal .ZigzagItemMedia {
		clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
	}


	.ZigzagItem.ClipLArch .ZigzagItemMedia {
		clip-path: ellipse(92% 100% at 40% 50%);
	}


	.ZigzagItem.ClipLInset .ZigzagItemMedia {
		margin: 22px;
		border-radius: 26px;
	}


	.ZigzagItem.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
	}



	.ZigzagItemMedia,
	.ZigzagItemContent
	{
		position: relative;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		min-width: 0;
	}


	.ZigzagItemContent > small,
	.ZigzagItemContent > h3,
	.ZigzagItemContent > p
	{
		margin: 0;
	}


	.ZigzagItem.PlaceSized:not(.IsPlaced),
	.ZigzagItem.IsPlaced
	{
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}



</style>





<style>



	@media (orientation: portrait) {
		.ZigzagItem {
			grid-template-columns: minmax(0, 1fr);
			min-height: var(--ZigzagItemMinHeightP);
			padding: var(--ZigzagItemPadP);
			gap: var(--ZigzagItemGapP);
			border-radius: var(--ZigzagItemRadiusP);
		}

		.ZigzagItemMedia,
		.ZigzagItemContent
		{
			order: initial;
		}

		.ZigzagItemMedia {
			min-height: var(--ZigzagMediaMinHeightP);
			border-radius: var(--ZigzagMediaRadiusP);
			clip-path: none;
		}

		.ZigzagItem.ClipPDiagonal .ZigzagItemMedia {
			clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
		}

		.ZigzagItem.ClipPArch .ZigzagItemMedia {
			clip-path: ellipse(100% 92% at 50% 42%);
		}

		.ZigzagItem.ClipPInset .ZigzagItemMedia {
			margin: 14px;
			border-radius: 20px;
		}

		.ZigzagItem.PlaceSized:not(.IsPlaced),
		.ZigzagItem.IsPlaced
		{
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}

		.ZigzagItem.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
		}
	}



</style>
