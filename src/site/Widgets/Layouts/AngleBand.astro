---
import { Place, type PlaceProps, RespString } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import { GetLayoutBackground, GetLayoutPair, GetRootAttributes, GetStyleText, type LayoutBackground, type LayoutValue } from "./LayoutUtils";

type BandDirection = "Rise" | "Fall" | "Chevron" | "Peak";

export interface Props extends DebugOutlineProps, HTMLAttributes<"section">, PlaceProps {
  pBg?: LayoutBackground;
  pColor?: string;
  pCut?: LayoutValue;
  pDirection?: BandDirection;
  pPad?: LayoutValue;
  pMinHeight?: LayoutValue;
  pMaxWidth?: LayoutValue;
  pOverflow?: "visible" | "hidden" | "clip";
}

const cProps = Astro.props as Props & Record<string, unknown>;
const {
  pBg = "linear-gradient(120deg, #111b25, #273b4a)",
  pColor = "#f7fafc",
  pCut = new RespString("9%", "3%"),
  pDirection = "Rise",
  pPad = new RespString("56px", "28px"),
  pMinHeight = new RespString("320px", "260px"),
  pMaxWidth = new RespString("1200px", "100%"),
  pOverflow = "hidden",
  id: pGivenID = GetWidgetId("AngleBand"),
  class: pGivenClass = "",
  style: pGivenStyle = "",
} = cProps;

const cCut = GetLayoutPair(pCut, "9%", "%");
const cPad = GetLayoutPair(pPad, "56px");
const cMinHeight = GetLayoutPair(pMinHeight, "320px");
const cMaxWidth = GetLayoutPair(pMaxWidth, "1200px");
const cHasSlot = Astro.slots.has("default");

const cCoreStyle = [
  `--AngleBandBg:${GetLayoutBackground(pBg)};`,
  `--AngleBandColor:${pColor};`,
  `--AngleBandCutL:${cCut.Landscape};`,
  `--AngleBandCutP:${cCut.Portrait};`,
  `--AngleBandPadL:${cPad.Landscape};`,
  `--AngleBandPadP:${cPad.Portrait};`,
  `--AngleBandMinHeightL:${cMinHeight.Landscape};`,
  `--AngleBandMinHeightP:${cMinHeight.Portrait};`,
  `--AngleBandMaxWidthL:${cMaxWidth.Landscape};`,
  `--AngleBandMaxWidthP:${cMaxWidth.Portrait};`,
  `--AngleBandOverflow:${pOverflow};`,
  GetStyleText(pGivenStyle),
]
  .filter(Boolean)
  .join(" ");

const cPlace = new Place(cProps as PlaceProps, cCoreStyle);
const cRootAttrs = GetRootAttributes(cProps, ["pBg", "pColor", "pCut", "pDirection", "pPad", "pMinHeight", "pMaxWidth", "pOverflow"]);
---





<section
	style = {cPlace.Style}
	class:list={["AngleBand", `Direction${pDirection}`, cPlace.Class, pGivenClass]}
	id={pGivenID}
	data-emo-auto-container="true"
	data-emo-empty-height="320"
	{...cRootAttrs}
>







	<div class = " AngleBandContent ">

		{ cHasSlot ? (

			<slot />
		) : (

			<>
			
			
			
			
			
			
			
				<small>
			
					ANGLE BAND
			
				</small>
			
			
			
			
			
			
			
				<h3>
					قطاع مائل والمحتوى يظل مستقيمًا
				</h3>
			
			
			
			
			
			
			
				<p>
					بديل منظم للسكاشن التي كانت تحتاج قصًا يدويًا وطبقات CSS خارجية.
				</p>
			
			
			
			
			
			
			
			</>
		) }

	</div>







</section>





<style>



	.AngleBand {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: min(100%, var(--AngleBandMaxWidthL));
		min-height: var(--AngleBandMinHeightL);
		margin-inline: auto;
		padding: calc(var(--AngleBandPadL) + var(--AngleBandCutL)) var(--AngleBandPadL);
		background: var(--AngleBandBg);
		color: var(--AngleBandColor);
		overflow: var(--AngleBandOverflow);
		isolation: isolate;
	}


	.AngleBandContent {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		box-sizing: border-box;
		width: min(100%, 980px);
		gap: 12px;
	}

	.AngleBandContent > :global(*) {
		max-width: 100%;
	}

	.AngleBandContent > small {
		font-weight: 900;
		letter-spacing: 0.2em;
		opacity: 0.65;
	}

	.AngleBandContent > h3 {
		max-width: 18ch;
		font-size: clamp(32px, 5vw, 68px);
		line-height: 1.12;
	}

	.AngleBandContent > p {
		max-width: 48ch;
		font-size: 18px;
		line-height: 1.85;
		opacity: 0.78;
	}



	.AngleBand.DirectionRise {
		clip-path: polygon(0 var(--AngleBandCutL), 100% 0, 100% calc(100% - var(--AngleBandCutL)), 0 100%);
	}


	.AngleBand.DirectionFall {
		clip-path: polygon(0 0, 100% var(--AngleBandCutL), 100% 100%, 0 calc(100% - var(--AngleBandCutL)));
	}


	.AngleBand.DirectionChevron {
		clip-path: polygon(0 var(--AngleBandCutL), 50% 0, 100% var(--AngleBandCutL), 100% 100%, 50% calc(100% - var(--AngleBandCutL)), 0 100%);
	}


	.AngleBand.DirectionPeak {
		clip-path: polygon(
      0 0,
      50% var(--AngleBandCutL),
      100% 0,
      100% calc(100% - var(--AngleBandCutL)),
      50% 100%,
      0 calc(100% - var(--AngleBandCutL))
    );
	}


	.AngleBand.IsPlaced {
		position: absolute;
		left: var(--PlaceXL);
		top: var(--PlaceYL);
		margin: 0;
	}



	.AngleBandContent > small,
	.AngleBandContent > h3,
	.AngleBandContent > p
	{
		margin: 0;
	}


	.AngleBand.PlaceSized:not(.IsPlaced),
	.AngleBand.IsPlaced
	{
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}



</style>





<style>



	@media (orientation: portrait) {
		.AngleBand {
			width: min(100%, var(--AngleBandMaxWidthP));
			min-height: var(--AngleBandMinHeightP);
			padding: calc(var(--AngleBandPadP) + var(--AngleBandCutP)) var(--AngleBandPadP);
		}

		.AngleBand.DirectionRise {
			clip-path: polygon(0 var(--AngleBandCutP), 100% 0, 100% calc(100% - var(--AngleBandCutP)), 0 100%);
		}

		.AngleBand.DirectionFall {
			clip-path: polygon(0 0, 100% var(--AngleBandCutP), 100% 100%, 0 calc(100% - var(--AngleBandCutP)));
		}

		.AngleBand.DirectionChevron {
			clip-path: polygon(
        0 var(--AngleBandCutP),
        50% 0,
        100% var(--AngleBandCutP),
        100% 100%,
        50% calc(100% - var(--AngleBandCutP)),
        0 100%
      );
		}

		.AngleBand.DirectionPeak {
			clip-path: polygon(
        0 0,
        50% var(--AngleBandCutP),
        100% 0,
        100% calc(100% - var(--AngleBandCutP)),
        50% 100%,
        0 calc(100% - var(--AngleBandCutP))
      );
		}

		.AngleBand.PlaceSized:not(.IsPlaced),
		.AngleBand.IsPlaced
		{
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}

		.AngleBand.IsPlaced {
			left: var(--PlaceXP);
			top: var(--PlaceYP);
		}
	}



</style>
