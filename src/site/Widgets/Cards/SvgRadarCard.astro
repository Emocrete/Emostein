---
const {
    fTitle = "رادار المتابعة",
    fText = "حركة لطيفة تشبه السونار…",
    fColor = "#7CFFB2",
} = Astro.props;

const fId = "rad_" + Math.random().toString(36).slice(2);
---

<article class="radCard reveal" data-reveal="up">
    <div class="radSvg" aria-hidden="true">
        <svg viewBox="0 0 360 220" preserveAspectRatio="xMidYMid meet">
            <defs>
                <radialGradient id={`${fId}_rg`} cx="50%" cy="50%" r="60%">
                    <stop offset="0" stop-color={fColor} stop-opacity="0.28"
                    ></stop>
                    <stop offset="1" stop-color={fColor} stop-opacity="0"
                    ></stop>
                </radialGradient>

                <linearGradient id={`${fId}_sweep`} x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0" stop-color={fColor} stop-opacity="0"
                    ></stop>
                    <stop offset="1" stop-color={fColor} stop-opacity="0.35"
                    ></stop>
                </linearGradient>

                <clipPath id={`${fId}_clip`}>
                    <circle cx="110" cy="110" r="86"></circle>
                </clipPath>
            </defs>

            <!-- screen -->
            <rect x="0" y="0" width="360" height="220" rx="18" fill="#0f1115"
            ></rect>
            <circle cx="110" cy="110" r="86" fill={`url(#${fId}_rg)`}></circle>

            <!-- grid -->
            <g opacity="0.45" stroke="rgba(255,255,255,.22)" stroke-width="1">
                <circle cx="110" cy="110" r="28" fill="none"></circle>
                <circle cx="110" cy="110" r="56" fill="none"></circle>
                <circle cx="110" cy="110" r="86" fill="none"></circle>
                <line x1="24" y1="110" x2="196" y2="110"></line>
                <line x1="110" y1="24" x2="110" y2="196"></line>
            </g>

            <!-- sweep -->
            <g clip-path={`url(#${fId}_clip)`} class="sweep">
                <path
                    d="M110,110 L110,24 A86,86 0 0 1 196,110 Z"
                    fill={`url(#${fId}_sweep)`}></path>
                <circle cx="110" cy="110" r="2.8" fill={fColor} opacity="0.9"
                ></circle>
            </g>

            <!-- blips -->
            <g fill={fColor}>
                <circle class="blip b1" cx="78" cy="82" r="3"></circle>
                <circle class="blip b2" cx="150" cy="130" r="2.6"></circle>
                <circle class="blip b3" cx="120" cy="60" r="2.2"></circle>
            </g>

            <!-- right side text bars (decor) -->
            <g opacity="0.35" fill="rgba(255,255,255,.75)">
                <rect x="220" y="54" width="118" height="10" rx="6"></rect>
                <rect x="220" y="78" width="92" height="10" rx="6"></rect>
                <rect x="220" y="102" width="112" height="10" rx="6"></rect>
                <rect x="220" y="126" width="84" height="10" rx="6"></rect>
            </g>
        </svg>
    </div>

    <div class="radBody">
        <h3 class="radTitle">{fTitle}</h3>
        <p class="radText">{fText}</p>
    </div>
</article>

<style>
    .radCard {
        position: relative;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.1);
        background: #fff;
    }
    .radSvg {
        width: 100%;
    }
    .radSvg svg {
        width: 100%;
        height: auto;
        display: block;
    }
    .radBody {
        padding: 14px 16px 18px;
    }
    .radTitle {
        margin: 0 0 6px 0;
        font-weight: 900;
    }
    .radText {
        margin: 0;
        color: rgba(16, 17, 20, 0.72);
        line-height: 1.8;
    }

    .sweep {
        transform-origin: 110px 110px;
        animation: sweepRot 2.2s linear infinite;
    }
    @keyframes sweepRot {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    .blip {
        opacity: 0.15;
        animation: blip 1.8s ease-in-out infinite;
    }
    .b1 {
        animation-delay: 0.1s;
    }
    .b2 {
        animation-delay: 0.6s;
    }
    .b3 {
        animation-delay: 1.1s;
    }
    @keyframes blip {
        0%,
        100% {
            opacity: 0.15;
            transform: scale(1);
        }
        50% {
            opacity: 0.95;
            transform: scale(1.35);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sweep,
        .blip {
            animation: none !important;
            opacity: 0.9;
        }
    }
</style>
