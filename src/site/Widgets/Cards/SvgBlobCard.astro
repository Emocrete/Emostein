---
const {
    fTitle = "عنوان",
    fText = "وصف قصير…",
    fCtaText = "تفاصيل",
    fCtaHref = "#",
    fHue = 42,
    id: fIdAttr,
    class: fClass = "",
    style: fStyle = "",
    ...cAttrs
} = Astro.props;

const fId = "blob_" + Math.random().toString(36).slice(2);
const fC1 = `hsl(${fHue} 92% 55%)`;
const fC2 = `hsl(${(fHue + 40) % 360} 92% 55%)`;
---

<article id={fIdAttr} class={`svgCard reveal ${fClass}`.trim()} style={fStyle} data-reveal="up" {...cAttrs}>
    <div class="svgBg" aria-hidden="true">
        <svg viewBox="0 0 600 360" preserveAspectRatio="none">
            <defs>
                <linearGradient id={`${fId}_g`} x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color={fC1} stop-opacity="0.95"
                    ></stop>
                    <stop offset="1" stop-color={fC2} stop-opacity="0.85"
                    ></stop>
                </linearGradient>

                <filter
                    id={`${fId}_blur`}
                    x="-20%"
                    y="-20%"
                    width="140%"
                    height="140%"
                >
                    <feGaussianBlur stdDeviation="18"></feGaussianBlur>
                </filter>
            </defs>

            <g filter={`url(#${fId}_blur)`} opacity="0.95">
                <path
                    class="blob b1"
                    fill={`url(#${fId}_g)`}
                    d="M126,112 C178,60 292,48 356,92 C420,136 436,228 370,276 C304,324 202,330 142,270 C82,210 74,164 126,112 Z"
                ></path>
                <path
                    class="blob b2"
                    fill={fC2}
                    opacity="0.55"
                    d="M330,70 C400,30 520,70 540,156 C560,242 478,320 392,308 C306,296 272,200 292,130 C304,92 312,80 330,70 Z"
                ></path>
            </g>
        </svg>
    </div>

    <div class="svgBody">
        <h3 class="svgTitle">{fTitle}</h3>
        <p class="svgText">{fText}</p>
        <a class="svgBtn" href={fCtaHref}>{fCtaText}</a>
    </div>
</article>

<style>
    .svgCard {
        position: relative;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.1);
        background: #0f1115;
        color: #fff;
        min-height: 180px;
    }
    .svgBg {
        position: absolute;
        inset: 0;
        z-index: 0;
    }
    .svgBg svg {
        width: 100%;
        height: 100%;
        display: block;
    }
    .svgBody {
        position: relative;
        z-index: 1;
        padding: 18px;
        max-width: 60ch;
    }
    .svgTitle {
        margin: 0 0 8px 0;
        font-weight: 900;
        font-size: 18px;
    }
    .svgText {
        margin: 0 0 14px 0;
        opacity: 0.88;
        line-height: 1.8;
    }
    .svgBtn {
        display: inline-flex;
        padding: 11px 14px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.92);
        color: #111;
        font-weight: 900;
        text-decoration: none;
    }
    .svgBtn:hover {
        filter: brightness(0.96);
    }

    .blob {
        transform-origin: 50% 50%;
    }

    .b1 {
        animation: float1 6.5s ease-in-out infinite;
    }
    .b2 {
        animation: float2 8.5s ease-in-out infinite;
    }

    @keyframes float1 {
        0% {
            transform: translate(-12px, 8px) rotate(0deg) scale(1);
        }
        50% {
            transform: translate(10px, -10px) rotate(12deg) scale(1.06);
        }
        100% {
            transform: translate(-12px, 8px) rotate(0deg) scale(1);
        }
    }
    @keyframes float2 {
        0% {
            transform: translate(10px, -6px) rotate(0deg) scale(1.02);
        }
        50% {
            transform: translate(-14px, 12px) rotate(-10deg) scale(1.08);
        }
        100% {
            transform: translate(10px, -6px) rotate(0deg) scale(1.02);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .b1,
        .b2 {
            animation: none !important;
        }
    }
</style>
