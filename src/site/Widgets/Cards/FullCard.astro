---
import { EmoMediaData, Place, type PlaceProps, Text } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";
import BgMedia from "../Media/BgMedia.astro";
import RespImg from "../Media/RespImage.astro";

export interface Props extends DebugOutlineProps, HTMLAttributes<"div">, PlaceProps {
	pTitle?: Text;
	pText?: Text;
	pMedia?: EmoMediaData;
	pBgMedia?: EmoMediaData;
	pBgClr?: string;
}

const {
	pBgMedia,
	pBgClr = "rgb(247, 202, 52)",
	pMedia = new EmoMediaData("Img", "/Media/", "ErrorImg.webp"),
	pTitle = Text.Body.OfText("عنوان الكرت"),
	pText = Text.Body.OfText("محتوى الكرت"),

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("FullCard"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = Astro.props as Props;

const cGivenStyle = GetStyleText(pGivenStyle);
const TitleTag = pTitle.GetTag() as keyof astroHTML.JSX.DefinedIntrinsicElements;

const cCardStyle = [
	`--BgColor:${pBgClr};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(Astro.props as PlaceProps, cCardStyle);

function GetStyleText(pStyle: Props["style"]) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;

	return Object.entries(pStyle)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---




















<div
	class = {`FullCard ${cPlace.Class} ${pGivenClass}`.trim()}
	style = {cPlace.Style}
	id={pGivenID}
	{...RemAttr}
>

	{ pBgMedia?.Type === "Vid" && (

		<BgMedia pVid={pBgMedia} />
	) }

	{ pBgMedia?.Type === "Img" && (

		<BgMedia pImg={pBgMedia} />
	) }

	<div class = " FullCardContentBox ">

		{ pMedia && (

			<RespImg class = " FullCardMedia " pImg={pMedia} />
		) }

		<TitleTag class = " FullCardTitle " style = {pTitle.GetStyle()}>

			{pTitle.text}

		</TitleTag>

		{ pText && (

			<p class = " FullCardText " style = {pText.GetStyle()}>
				{pText.text}
			</p>
		) }

	</div>







</div>




















<style>



	.FullCard {
		position: relative;
		isolation: isolate;
		display: flex;
		flex: 0 1 auto;
		flex-direction: column;
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		min-height: 600px;
		padding: 10px;
		overflow: hidden;
		align-items: center;
		justify-content: flex-end;
		background-color: var(--BgColor);
	}


	.FullCardContentBox {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		width: min(50%, 720px);
		max-width: calc(100% - 20px);
		min-width: 0;
		height: auto;
		margin-block-end: 40px;
		padding: 30px;
		gap: 8px;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(2px);
		-webkit-backdrop-filter: blur(2px);
	}

	.FullCardContentBox > :global(*) {
		max-width: 100%;
		min-width: 0;
	}

	.FullCardContentBox > :global(.FullCardMedia) {
		flex: 0 1 auto;
		width: auto;
		height: auto;
	}



	.FullCardContentBox :global(.RespImgPicBox),
	.FullCardContentBox :global(.RespImgImg)
	{
		max-width: 100%;
	}


	.FullCardTitle,
	.FullCardText
	{
		box-sizing: border-box;
		width: 100%;
		overflow-wrap: anywhere;
	}


	.FullCard.PlaceSized,
	.FullCard.IsPlaced
	{
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
		min-height: 0;
	}



</style>




















<style>



	@media (orientation: portrait) {
		.FullCardContentBox {
			width: min(80%, 640px);
			max-width: calc(100% - 20px);
			padding: 10px;
		}

		.FullCard.PlaceSized,
		.FullCard.IsPlaced
		{
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}
	}



</style>
