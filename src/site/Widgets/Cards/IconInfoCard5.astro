---
import { Pixel, Place, type PlaceProps } from "@/TypesLib";
import type { HTMLAttributes } from "astro/types";

interface Props extends DebugOutlineProps, HTMLAttributes<"article">, PlaceProps {
	pTitle: string;
	pIcon?: string;
	pIconAlt?: string;
	pDesc?: string;
	pTitleLevel?: number | string;
	pBg?: string;
	pColor?: string;
	pHoverBg?: string;
	pHoverColor?: string;
	pIconBg?: string;
	pIconHoverBg?: string;
	pTitleColor?: string;
	pBodyColor?: string;
	pRadius?: Pixel;
	pPad?: Pixel;
	pGap?: Pixel;
	pIconSize?: Pixel;
	pIconHoverTransform?: string;
	pIconHoverFilter?: string;
	pCardEnterDuration?: string;
	pCardExitDuration?: string;
	pIconStartDelay?: string;
	pIconFlipDuration?: string;
	pIconBgDuration?: string;
	pIconFilterDuration?: string;
	pReveal?: boolean;
	pRevealDuration?: string;
}

const cProps = Astro.props as Props & Record<string, unknown>;

const {
	pTitle = "العنوان",
	pIcon = "/Media/ErrorImg.webp",
	pIconAlt,
	pDesc ="المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى المحتوى ",
	pTitleLevel = 4,
	pBg = "transparent",
	pColor,
	pHoverBg,
	pHoverColor,
	pIconBg = "#ededed",
	pIconHoverBg = "#ffed87",
	pTitleColor = "#000000",
	pBodyColor = "#737373",
	pRadius = new Pixel(10),
	pPad = new Pixel(30),
	pGap = new Pixel(15),
	pIconSize = new Pixel(70),
	pIconHoverTransform = "rotateX(360deg)",
	pIconHoverFilter = "brightness(0) saturate(100%)",
	pCardEnterDuration = "55ms",
	pCardExitDuration = "80ms",
	pIconStartDelay = "35ms",
	pIconFlipDuration = "220ms",
	pIconBgDuration = "120ms",
	pIconFilterDuration = "90ms",
	pReveal = true,
	pRevealDuration = "0.8s",

	pLoc,
	pSize,
	pRotate,
	pZ,
	pOrigin,
	pOpacity,
	pClickable,
	pLandOnly,
	pPortOnly,
	pMove,
	pMoveDuration,
	pMoveLoc,
	pMoveBox,
	pMoveDistance,
	pMoveKeyPoints,
	pMoveIntervals,
	pMoveDelay,
	pMoveEase,
	pMoveLoop,
	pMoveLoopFor,
	pMoveLoopInterval,
	pMoveReverse,
	pMoveStartOnView,
	pMoveReplayOnView,
	pMovePauseWhenOut,
	pMoveViewThreshold,
	pMoveViewMargin,
	pMoveViewTarget,

	id: pGivenID = GetWidgetId("IconInfoCard"),
	class: pGivenClass = "",
	style: pGivenStyle = "",
	...RemAttr
} = cProps;

const cHeadingLevel = NormalizeHeadingLevel(pTitleLevel);
const TitleTag = `h${cHeadingLevel}` as keyof astroHTML.JSX.DefinedIntrinsicElements;
const cIconAlt = pIconAlt ?? pTitle;
const cHasSlot = Astro.slots.has("default");
const cHoverBg = pHoverBg ?? pHoverColor ?? pColor ?? "#ffdb0f";
const cGivenStyle = GetStyleText(pGivenStyle);

const cStyle = [
	`--IconInfoCardBg:${pBg};`,
	`--IconInfoCardHoverBg:${cHoverBg};`,
	`--IconInfoCardIconBg:${pIconBg};`,
	`--IconInfoCardIconHoverBg:${pIconHoverBg};`,
	`--IconInfoCardTitleColor:${pTitleColor};`,
	`--IconInfoCardBodyColor:${pBodyColor};`,
	`--IconInfoCardRadiusL:${pRadius.Landscape};`,
	`--IconInfoCardRadiusP:${pRadius.Portrait};`,
	`--IconInfoCardPadL:${pPad.Landscape};`,
	`--IconInfoCardPadP:${pPad.Portrait};`,
	`--IconInfoCardGapL:${pGap.Landscape};`,
	`--IconInfoCardGapP:${pGap.Portrait};`,
	`--IconInfoCardIconSizeL:${pIconSize.Landscape};`,
	`--IconInfoCardIconSizeP:${pIconSize.Portrait};`,
	`--IconInfoCardIconHoverTransform:${pIconHoverTransform};`,
	`--IconInfoCardIconHoverFilter:${pIconHoverFilter};`,
	`--IconInfoCardCardEnterDuration:${pCardEnterDuration};`,
	`--IconInfoCardCardExitDuration:${pCardExitDuration};`,
	`--IconInfoCardIconStartDelay:${pIconStartDelay};`,
	`--IconInfoCardIconFlipDuration:${pIconFlipDuration};`,
	`--IconInfoCardIconBgDuration:${pIconBgDuration};`,
	`--IconInfoCardIconFilterDuration:${pIconFilterDuration};`,
	`--IconInfoCardRevealDuration:${pRevealDuration};`,
	cGivenStyle,
].filter(Boolean).join(" ");

const cPlace = new Place(cProps as PlaceProps, cStyle);
const cClass = [
	"IconInfoCard",
	pReveal ? "IconReveal" : "",
	cPlace.Class,
	pGivenClass,
].filter(Boolean).join(" ");

function NormalizeHeadingLevel(pValue: unknown) {
	const cValue = typeof pValue === "number" ? pValue : Number.parseInt(`${pValue}`, 10);
	if (!Number.isFinite(cValue)) return 4;
	return Math.min(6, Math.max(2, Math.floor(cValue)));
}

function GetStyleText(pStyle: unknown) {
	if (!pStyle) return "";
	if (typeof pStyle === "string") return pStyle;
	if (typeof pStyle !== "object") return "";

	return Object.entries(pStyle as Record<string, string | number | null | undefined>)
		.map(([pName, pValue]) => {
			if (pValue === undefined || pValue === null) return "";
			return `${GetCssName(pName)}:${pValue};`;
		})
		.filter(Boolean)
		.join(" ");
}

function GetCssName(pName: string) {
	if (pName.startsWith("--")) return pName;
	return pName.replace(/[A-Z]/g, (pChar) => `-${pChar.toLowerCase()}`);
}
---




















<article
	class = {cClass}
	style = {cPlace.Style}
	id={pGivenID}
	{...RemAttr}
>

	{ pIcon && (

		<div class = " IconInfoCardIconRevealBox ">
		
		
		
		
		
		
		
			<div class = " IconInfoCardIconBox ">
		
				<img
					class = " IconInfoCardIcon "
					src={pIcon}
					alt={cIconAlt}
					loading="lazy"
					decoding="async"
				/>
		
			</div>
		
		
		
		
		
		
		
		</div>
	) }

	<TitleTag class = " IconInfoCardTitle ">

		{pTitle}

	</TitleTag>

	{ pDesc && (

		<p class = " IconInfoCardBody ">
			{pDesc}
		</p>
	) }

	{ cHasSlot && (

		<div class = " IconInfoCardBody ">
		
		
		
		
		
		
		
			<slot />
		
		
		
		
		
		
		
		</div>
	) }

</article>




















<style>



	.IconInfoCard {
		direction: rtl;
		text-align: right;
		display: flex;
		flex-direction: column;
		height: 100%;
		align-items: flex-start;
		box-sizing: border-box;
		min-width: 0;
		contain: layout paint style;
		gap: var(--IconInfoCardGapL);
		padding: var(--IconInfoCardPadL);
		border-radius: var(--IconInfoCardRadiusL);
		background-color: var(--IconInfoCardBg);
		transition-property: background-color;
		transition-duration: var(--IconInfoCardCardExitDuration);
		transition-timing-function: linear;
		transition-delay: 0ms;
	}


	.IconInfoCardIconRevealBox {
		display: flex;
		align-items: center;
		justify-content: center;
		width: var(--IconInfoCardIconSizeL);
		height: var(--IconInfoCardIconSizeL);
	}


	.IconInfoCardIconBox {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: 50%;
		background-color: var(--IconInfoCardIconBg);
		transform: rotateX(0deg) translateZ(0);
		transform-style: preserve-3d;
		transition-property: background-color, transform;
		transition-duration: var(--IconInfoCardIconBgDuration), var(--IconInfoCardIconFlipDuration);
		transition-timing-function: linear, linear;
		transition-delay: 0ms, 0ms;
		will-change: background-color, transform;
	}


	.IconInfoCardIcon {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		transition-property: filter;
		transition-duration: var(--IconInfoCardIconFilterDuration);
		transition-timing-function: linear;
		transition-delay: 0ms;
	}


	.IconInfoCardTitle {
		margin: 0;
		font-family: var(--IconInfoCardTitleFamily, "Bahij-Janna-Bold", "Cairo", system-ui, Arial, sans-serif);
		color: var(--IconInfoCardTitleColor);
		font-size: var(--IconInfoCardTitleSizeL, 28px);
		font-weight: var(--IconInfoCardTitleWeight, 800);
		line-height: 1.5;
		text-align: right;
	}


	.IconInfoCardBody {
		margin: 0;
		font-family: var(--IconInfoCardBodyFamily, "Cairo", system-ui, Arial, sans-serif);
		color: var(--IconInfoCardBodyColor);
		font-size: var(--IconInfoCardBodySizeL, 20px);
		font-weight: var(--IconInfoCardBodyWeight, 400);
		line-height: 1.5;
		text-align: right;
	}

	.IconInfoCardBody :global(*) {
		margin-block-start: 0;
		text-align: right;
	}

	.IconInfoCardBody :global(*:last-child) {
		margin-block-end: 0;
	}



	.IconInfoCard.IconReveal .IconInfoCardIconRevealBox {
		visibility: visible;
		animation-name: IconInfoCardFadeInRight;
		animation-duration: var(--IconInfoCardRevealDuration);
		animation-fill-mode: both;
	}


	.IconInfoCard.IsPlaced {
		position: absolute;
		width: var(--PlaceWidthL);
		height: var(--PlaceHeightL);
	}



	.IconInfoCard:hover,
	.IconInfoCard:focus-within
	{
		background-color: var(--IconInfoCardHoverBg);
		transition-duration: var(--IconInfoCardCardEnterDuration);
		transition-delay: 0ms;
	}


	.IconInfoCard:hover .IconInfoCardIconBox,
	.IconInfoCard:focus-within .IconInfoCardIconBox
	{
		background-color: var(--IconInfoCardIconHoverBg);
		transform: var(--IconInfoCardIconHoverTransform) translateZ(0);
		transition-delay: var(--IconInfoCardIconStartDelay), var(--IconInfoCardIconStartDelay);
	}


	.IconInfoCard:hover .IconInfoCardIcon,
	.IconInfoCard:focus-within .IconInfoCardIcon
	{
		filter: var(--IconInfoCardIconHoverFilter);
		transition-delay: var(--IconInfoCardIconStartDelay);
	}


	@keyframes IconInfoCardFadeInRight {
	0% {
						opacity: 0;
						transform: translate3d(100%, 0, 0);
					}
	
					100% {
						opacity: 1;
						transform: translate3d(0, 0, 0);
					}
	}



</style>




















<style>



	@media (orientation: portrait), (max-width: 920px) {
		.IconInfoCard {
			gap: var(--IconInfoCardGapP, var(--IconInfoCardGapL));
			padding: var(--IconInfoCardPadP, var(--IconInfoCardPadL));
			border-radius: var(--IconInfoCardRadiusP, var(--IconInfoCardRadiusL));
		}

		.IconInfoCardIconRevealBox {
			width: var(--IconInfoCardIconSizeP, var(--IconInfoCardIconSizeL));
			height: var(--IconInfoCardIconSizeP, var(--IconInfoCardIconSizeL));
		}

		.IconInfoCardTitle {
			font-size: var(--IconInfoCardTitleSizeP, var(--IconInfoCardTitleSizeL, 28px));
		}

		.IconInfoCardBody {
			font-size: var(--IconInfoCardBodySizeP, var(--IconInfoCardBodySizeL, 20px));
		}

		.IconInfoCard.IsPlaced {
			width: var(--PlaceWidthP);
			height: var(--PlaceHeightP);
		}
	}



</style>
