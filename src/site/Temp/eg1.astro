---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, EmoWhats } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { DivCol, DivStr, EmoSec } from "@/Widgets/Sections";
import { ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";

const cInk = "#111719";
const cMist = "#E9EEF0";
const cIce = "#F8FAF8";
const cSteel = "#718087";
const cLime = "#C8F04B";
const cWhite = "#FFFFFF";
const cMedia = "/Media/Emostone/Granit/Eg/";

const Image = (pFile: string, pAlt: string, pWidth = "100%", pHeight = "100%") => new EmoMediaData("Img", cMedia, pFile, false, pAlt, new Size(new NumPer(pWidth, "100%"), new NumPer(pHeight, "auto")));
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت مصري للمشروعات"
	pDescr="تسعير وتوريد وتركيب الجرانيت المصري للمشروعات من مراجعة المقايسة والاعتماد حتى التصنيع والتوريد والتركيب والتسليم."
>







	<EmoSec
		class = " granite-hero "
		id="GraniteProjectsHero"
		Service
		data-hero
		pBg={new ElemBg(cInk)}
		pMinH={new NumPer("820px", "760px")}
		pHzAlign="Center"
		pVrAlign="Center"
	>

		<DivStr
			class = " hero-grid "
			pBox={new Size(new NumPer("1280px", "100%"))}
			pMinH={new NumPer("820px", "760px")}
			pGap={new Pixel(0)}
		>

			<DivCol
				class = " hero-copy "
				pSize={new Size(new NumPer("86%", "100%"))}
				pPad={new Pixel(90, 28)}
				pGap={new Pixel(30, 22)}
				pHzAlign="Start"
				pVrAlign="Center"
			>

				<p class = " eyebrow ">
					EGYPTIAN GRANITE / PROJECT SUPPLY
				</p>

				<Emograph
					pTitle={Text.H1.WithColor(cWhite).OfText("جرانيت مصري\nيبدأ من المقايسة\nولا ينتهي عند التوريد")}
					pText={Text.H3.WithColor(cMist).OfText("حزمة هندسية وتجارية تربط الـBOQ بالخامة والتصنيع والبرنامج التنفيذي، حتى تصبح كل قطعة قابلة للتسعير والتتبع والاستلام.")}
				/>

				<div class = " hero-actions ">

					<EmoWhats
						BlackGreen
						pText="أرسل ملف المقايسة"
						pMessage="أرغب في إرسال مقايسة جرانيت مصري للتسعير الفني والمالي."
						pWidth="230px"
						pHeight="58px"
						pRadius="0px"
					/>

					<EmoCall
						WhiteBlack
						pText="ناقش نطاق المشروع"
						pWidth="230px"
						pHeight="58px"
						pRadius="0px"
					/>

				</div>

				<p class = " audience ">
					للمقاولين · المطورين · الاستشاريين · المكاتب الفنية · المشتريات
				</p>

			</DivCol>

			<DivCol class = " hero-visual " pSize={new Size(new NumPer("44%", "100%"))} pPad={new Pixel(0)}>

				<RespImg pImg={Image("quarry.webp", "كتل جرانيت مصري ضخمة داخل محجر", "100%", "820px")} />

				<div class = " hero-stat ">

					<strong>
						من الخام
					</strong>

					<span>
						إلى كود القطعة المركبة
					</span>

				</div>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		class = " editorial-section "
		id="GraniteScope"
		Service
		pBg={new ElemBg(cIce)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(110, 22)}
	>

		<DivStr class = " scope-layout " pBox={new Size(new NumPer("1180px", "100%"))} pGap={new Pixel(48, 26)}>

			<DivCol pSize={new Size(new NumPer("42%", "100%"))} pPad={new Pixel(0)} pHzAlign="Start">

				<p class = " section-index ">
					01 / النطاق
				</p>

				<Emograph
					pTitle={Text.H2.WithColor(cInk).OfText("توريد وتركيب جرانيت مصري للمشروعات والمقايسات")}
					pText={Text.Body.WithColor(cSteel).OfText("نحوّل جدول الكميات والمواصفات والرسومات إلى حزمة قابلة للتسعير والتعاقد والتنفيذ. تتاح كتوريد فقط أو توريد وتركيب كامل، وفق نظام التعاقد والبرنامج التنفيذي.")}
				/>

			</DivCol>

			<DivCol
				class = " scope-list "
				pSize={new Size(new NumPer("58%", "100%"))}
				pPad={new Pixel(0)}
				pHzAlign="Start"
			>

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pItemsBg={new ElemBg("transparent")}
					pItemFnt={Text.H4.WithColor(cInk)}
					pNumbered={true}
					pItems={["أرضيات ودرج وبسطات ووزرات وجلسات وعتبات.","مداخل ومصاعد وكسوات حوائط وواجهات.","لاندسكيب ومشايات وبلدورات وأغطية أسوار.","قطع خاصة وCut-to-Size طبقًا للرسومات."]}
				/>

				<p class = " scope-note ">
					أعمال حجر مرتبطة بالمشروع، لا بيع خامة منفصلة.
				</p>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		class = " boq-section "
		id="GraniteBoq"
		Service
		pBg={new ElemBg(cMist)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(110, 22)}
	>

		<DivStr class = " boq-frame " pBox={new Size(new NumPer("1180px", "100%"))} pGap={new Pixel(0)}>

			<DivCol
				pSize={new Size(new NumPer("39%", "100%"))}
				pBg={new ElemBg(cInk)}
				pPad={new Pixel(58, 28)}
				pGap={new Pixel(28, 18)}
				pHzAlign="Start"
			>

				<p class = " section-index lime ">
					02 / التسعير
				</p>

				<Emograph
					pTitle={Text.H2.WithColor(cWhite).OfText("السعر لا يبدأ من المتر؛ يبدأ من المستند")}
					pText={Text.Body.WithColor(cMist).OfText("تدخل المقايسة مع الرسومات والمواصفات وجدول التشطيبات والبرنامج. نراجع التعارضات والبيانات الناقصة ونثبت افتراضات التسعير وحدود المسؤولية داخل العرض.")}
				/>

				<div class = " doc-stack ">

					<span>
						BOQ
					</span>

					<span>
						DRAWINGS
					</span>

					<span>
						SPECIFICATIONS
					</span>

					<span>
						FINISH SCHEDULE
					</span>

				</div>

			</DivCol>

			<DivCol
				class = " price-side "
				pSize={new Size(new NumPer("61%", "100%"))}
				pPad={new Pixel(58, 30)}
				pGap={new Pixel(30, 20)}
				pHzAlign="Start"
			>

				<Emograph
					pTitle={Text.H2.WithColor(cInk).OfText("ما الذي يدخل في تكوين السعر؟")}
					pText={Text.Body.WithColor(cSteel).OfText("كل بند يُربط بالخامة والسمك وتشطيب السطح والأبعاد والحواف وطريقة التصنيع والتركيب وموقع التنفيذ.")}
				/>

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pItemsBg={new ElemBg("transparent")}
					pItemFnt={Text.Body.WithColor(cInk)}
					pNumbered={true}
					pItems={["الخام ونسب الهالك والقص والتجهيز.","الحليات والمجارير والفتحات والترقيم والتعبئة.","النقل والرفع ومستلزمات التركيب والجلي والتشطيب.","الحماية حتى الاستلام بحسب نطاق كل بند."]}
				/>

				<p class = " highlight-line ">
					يمكن تقسيم العرض حسب المبنى أو المنطقة أو الدور أو مرحلة التسليم.
				</p>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		class = " material-section "
		id="EgyptianGraniteMaterials"
		Service
		pBg={new ElemBg(cIce)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(120, 22)}
	>

		<DivStr class = " material-grid " pBox={new Size(new NumPer("1180px", "100%"))} pGap={new Pixel(54, 28)}>

			<DivCol
				pSize={new Size(new NumPer("54%", "100%"))}
				pPad={new Pixel(0)}
				pGap={new Pixel(22, 16)}
				pHzAlign="Start"
			>

				<div class = " image-window ">

					<RespImg pImg={Image("samples.webp", "عينات جرانيت مصري مع رسومات وأداة قياس", "100%", "620px")} />

					<span class = " image-label ">
						MATERIAL APPROVAL
					</span>

				</div>

			</DivCol>

			<DivCol
				pSize={new Size(new NumPer("46%", "100%"))}
				pPad={new Pixel(20, 0)}
				pGap={new Pixel(28, 18)}
				pHzAlign="Start"
				pVrAlign="Center"
			>

				<p class = " section-index ">
					03 / الخامات
				</p>

				<Emograph
					pTitle={Text.H2.WithColor(cInk).OfText("الخامة ليست اسمًا تجاريًا؛ إنها قرار داخل جدول التشطيبات")}
					pText={Text.Body.WithColor(cSteel).OfText("نيو حلايب وحلايب ورمادي الشركة، جندولا وروزا هودي وروزا النصر، فيردي وفيردي غزال، بلاك أسوان وأحمر أسوان وفرسان. كل خامة تُربط بالبند والاستخدام والتشطيب والسمك والمقاس والكمية.")}
				/>

				<div class = " material-chips ">

					<span>
						فاتح / رمادي
					</span>

					<span>
						وردي / أخضر
					</span>

					<span>
						داكن / أحمر
					</span>

				</div>

				<Emograph
					pTitle={Text.H3.WithColor(cInk).OfText("Value Engineering واضح الأثر")}
					pText={Text.Body.WithColor(cSteel).OfText("بدائل تحقق التصميم ومستهدف التكلفة والمدة، مع بيان أثر كل بديل على سعر البند والتوفر والتوريد.")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		class = " process-section "
		id="GraniteApproval"
		Service
		pBg={new ElemBg(cInk)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(120, 22)}
	>

		<div class = " process-shell ">

			<p class = " section-index lime ">
				04 / من الاعتماد إلى الموقع
			</p>

			<Emograph
				pTitle={Text.H2.WithColor(cWhite).OfText("مسار واحد. أربع نقاط تحكم. قطعة يمكن تتبعها.")}
				pText={Text.Body.WithColor(cMist).OfText("لا تنفصل العينة المعتمدة عن التشغيل والتصنيع والتوريد والتنفيذ.")}
			/>

			<div class = " process-rail ">

				<article>

					<b>

						01

					</b>

					<h3>
						اعتماد الخامة
					</h3>

					<p>
						Material Submittal، عينة، بيانات فنية، اختبارات وMockup مرجعي.
					</p>

				</article>

				<article>

					<b>

						02

					</b>

					<h3>
						Shop Drawings
					</h3>

					<p>
						أبعاد وحواف وفتحات وميول وفواصل وتفاصيل تثبيت وقوائم تقطيع.
					</p>

				</article>

				<article>

					<b>

						03

					</b>

					<h3>
						تصنيع وترقيم
					</h3>

					<p>
						Cut-to-Size، Dry Lay، أكواد، بالات وقوائم تحميل لكل منطقة.
					</p>

				</article>

				<article>

					<b>

						04

					</b>

					<h3>
						توريد وتركيب
					</h3>

					<p>
						دفعات مرتبطة بجاهزية الموقع، فحص، Snag List وحماية حتى التسليم.
					</p>

				</article>

			</div>

		</div>

	</EmoSec>







	<EmoSec
		class = " factory-section "
		id="GraniteFactory"
		Service
		pBg={new ElemBg(cMist)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(0)}
	>

		<DivStr class = " factory-grid " pBox={new Size(new NumPer("100%", "100%"))} pGap={new Pixel(0)}>

			<DivCol class = " factory-image " pSize={new Size(new NumPer("58%", "100%"))} pPad={new Pixel(0)}>

				<RespImg pImg={Image("factory.webp", "مصنع جرانيت وتجهيز ألواح على ماكينة قص رقمية", "100%", "700px")} />

			</DivCol>

			<DivCol
				pSize={new Size(new NumPer("42%", "100%"))}
				pPad={new Pixel(70, 30)}
				pGap={new Pixel(26, 18)}
				pHzAlign="Start"
				pVrAlign="Center"
			>

				<p class = " section-index ">
					05 / التصنيع
				</p>

				<Emograph
					pTitle={Text.H2.WithColor(cInk).OfText("من الرسومات إلى أمر إنتاج قابل للتتبع")}
					pText={Text.Body.WithColor(cSteel).OfText("تتحول الرسومات المعتمدة إلى Shop Drawings وقوائم تقطيع. تحمل كل قطعة كودًا يربطها بالمبنى والمنطقة والدور والبند وموقع التركيب.")}
				/>

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pItemsBg={new ElemBg("transparent")}
					pItemFnt={Text.Body.WithColor(cInk)}
					pNumbered={false}
					pItems={["مصقول أو مطفي أو محروق أو مجلخ أو رملي.","ألواح وشرائح وترابيع وسلالم وواجهات ومقاسات خاصة.","توزيع أوامر الإنتاج على دفعات مرتبطة بأولوية الموقع."]}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		class = " quality-section "
		id="GraniteQuality"
		Service
		pBg={new ElemBg(cIce)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(120, 22)}
	>

		<DivStr class = " quality-grid " pBox={new Size(new NumPer("1180px", "100%"))} pGap={new Pixel(52, 26)}>

			<DivCol
				pSize={new Size(new NumPer("44%", "100%"))}
				pPad={new Pixel(0)}
				pGap={new Pixel(26, 18)}
				pHzAlign="Start"
				pVrAlign="Center"
			>

				<p class = " section-index ">
					06 / التنفيذ
				</p>

				<Emograph
					pTitle={Text.H2.WithColor(cInk).OfText("تركيب الجرانيت وضبط الجودة بالموقع")}
					pText={Text.Body.WithColor(cSteel).OfText("يبدأ التنفيذ بمراجعة جاهزية الأسطح والمناسيب والمحاور والميول والفتحات. تُثبت الطريقة في Method Statement وخطة ITP، ثم يعتمد نموذج التنفيذ الأول.")}
				/>

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pItemsBg={new ElemBg("transparent")}
					pItemFnt={Text.Body.WithColor(cInk)}
					pNumbered={true}
					pItems={["مطابقة الأكواد والأبعاد والسماكات والحواف.","ضبط اللحامات والفواصل ونظام التركيب.","طلبات الفحص وإقفال الملاحظات والـSnag List.","الجلي والحماية والكميات النهائية والمستخلصات."]}
				/>

			</DivCol>

			<DivCol class = " quality-image " pSize={new Size(new NumPer("56%", "100%"))} pPad={new Pixel(0)}>

				<RespImg pImg={Image("installation.webp", "سلم ومدخل مشروع تجاري منفذ بالجرانيت", "100%", "680px")} />

				<div class = " quality-caption ">

					<strong>
						QUALITY IS A PROCESS
					</strong>

					<span>
						فحص وتوثيق وإقفال لكل منطقة عمل
					</span>

				</div>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		class = " management-section "
		id="GranitePackageManagement"
		Service
		pBg={new ElemBg(cMist)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(115, 22)}
	>

		<DivStr pBox={new Size(new NumPer("1180px", "100%"))} pGap={new Pixel(48, 26)}>

			<DivCol pSize={new Size(new NumPer("37%", "100%"))} pPad={new Pixel(0)} pHzAlign="Start">

				<p class = " section-index ">
					07 / الإدارة
				</p>

				<Emograph
					pTitle={Text.H2.WithColor(cInk).OfText("إدارة فنية وتجارية لحزمة الجرانيت")}
					pText={Text.H3.WithColor(cSteel).OfText("مرجع واحد من رقم بند المقايسة إلى كود القطعة المركبة.")}
				/>

			</DivCol>

			<DivCol pSize={new Size(new NumPer("63%", "100%"))} pPad={new Pixel(0)} pHzAlign="Start">

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pItemsBg={new ElemBg("transparent")}
					pItemFnt={Text.H4.WithColor(cInk)}
					pNumbered={true}
					pItems={["عرض أساسي وبدائل Value Engineering وجدول مقارنة للخامات.","تقسيم الأسعار والكميات حسب المبنى والمنطقة والمرحلة.","بيان أثر التغييرات على السعر والبرنامج والتصنيع والتوريد.","حصر البنود المستثناة أو المؤجلة لحين الاعتماد."]}
				/>

				<p class = " relationship ">
					نستهدف علاقة توريد مستمرة تستوعب أكثر من مشروع وتعديلات الرسومات والكميات خلال الطرح والتنفيذ.
				</p>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		class = " contact-section "
		id="GraniteBoqContact"
		Service
		pBg={new ElemBg(cInk)}
		pHzAlign="Center"
		pVrAlign="Center"
		pPad={new Pixel(105, 22)}
	>

		<div class = " contact-shell ">

			<p class = " section-index lime ">
				08 / افتح قناة العمل
			</p>

			<Emograph
				pTitle={Text.H2.WithColor(cWhite).OfText("أرسل مقايسة الجرانيت للتسعير")}
				pText={Text.Body.WithColor(cMist).OfText("أرسل الـBOQ بصيغة Excel أو PDF، والرسومات PDF أو DWG، والمواصفات الفنية، وجدول التشطيبات، وموقع المشروع، والبرنامج المطلوب. تبدأ المراجعة بتحديد النطاق والاستفسارات ثم إعداد العرض الفني والمالي والبدائل.")}
			/>

			<div class = " contact-actions ">

				<EmoWhats
					BlackGreen
					pText="أرسل ملف المقايسة"
					pMessage="أرغب في إرسال مقايسة جرانيت مصري للتسعير الفني والمالي."
					pWidth="260px"
					pHeight="60px"
					pRadius="0px"
				/>

				<EmoCall
					WhiteBlack
					pText="مناقشة نطاق المشروع"
					pWidth="260px"
					pHeight="60px"
					pRadius="0px"
				/>

			</div>

			<p class = " contact-note ">
				مخصص لشركات المقاولات والمطورين والمكاتب الاستشارية ومديري المشروعات والمشتريات.
			</p>

		</div>

	</EmoSec>







</BLayout>





<style>



	.granite-hero {
		overflow: hidden;
	}


	.hero-grid {
		position: relative;
	}


	.hero-copy {
		z-index: 2;
	}

	.hero-copy :global(.Emograph) {
		align-items: flex-start;
	}

	.hero-copy :global(h1) {
		font-size: clamp(56px,5.1vw,92px)!important;
		line-height: 1.03!important;
		letter-spacing: -.045em;
		white-space: pre-line;
	}

	.hero-copy :global(p) {
		max-width: 680px;
		line-height: 1.85!important;
	}


	.lime {
		color: #c8f04b;
	}


	.audience {
		margin: 0;
		color: #9ca7ab;
		font: 500 14px/1.7 system-ui;
