---
import SubMenuHead from "../../Menu/SubMenuHead.astro";
import SubMenuItem from "../../Menu/SubMenuItem.astro";

const cMenuIconsList = import.meta.glob("./*.webp", {
	eager: true,
	import: "default",
	query: "?url",
});

const cMenuIcons = Object.fromEntries(
	Object.entries(cMenuIconsList).map(([fPath, fUrl]) => {
		const fFileName = fPath.split("/").pop() ?? "";
		const fBaseName = fFileName.replace(/\.[^.]+$/, "");
		return [fBaseName, fUrl];
	}),
);
---





<SubMenuHead fTitle="مقاولات عامة" fLink="/emocrete/contracting" fIcon={cMenuIcons.Lab} />

<SubMenuHead fTitle="تشطيبات" fLink="" fIcon={cMenuIcons.Lab}>







	<SubMenuItem fTitle="تشطيب شقة" fLink="/emocrete/finishing/apartment" />







	<SubMenuItem fTitle="تشطيب فيلا" fLink="/emocrete/finishing/villa" />







	<SubMenuItem fTitle="تشطيب محل" fLink="/emocrete/finishing/retail" />







	<SubMenuItem fTitle="تشطيب صيدلية" fLink="/emocrete/finishing/pharmacy" />







</SubMenuHead>

<SubMenuHead fTitle="تطوير عقاري" fLink="" fIcon={cMenuIcons.Lab}>







	<SubMenuItem fTitle="مشاركات" fLink="/emocrete/develop/share" />







	<SubMenuItem fTitle="اتحاد ملاك" fLink="/emocrete/develop/owners" />







</SubMenuHead>
