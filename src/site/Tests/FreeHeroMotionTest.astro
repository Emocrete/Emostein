<BLayout pSchemaType="Article" pTitle="FreeHero Motion Inspiration" pDescr="أربعون مثالًا لاستخدام ودجات FreeHero الحركية">

	<FreeHero pImgF="/Media/Emocrete/Contracting/">

		<FreeHeroSlideInRight
			pLoc={new Location("7%", "5%", "14%", "9%")}
			pBox={new Size("50%", "auto", "90%", "auto")}
			pDuration={900}
			pZ={2}
		>

			<Emograph
				pTitle={Text.H1.OfText("01 — SlideInRight")}
				pText={Text.Body.OfText("دخول العنوان من اليمين مع تثبيت مكانه النهائي داخل نظام إحداثيات الهيرو.")}
