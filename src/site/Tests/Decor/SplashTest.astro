---
import BLayout from "@/Layout.astro";
import { Angle, DirectSize, ElemBg, Loc, NumPer, Percent, Text, Align } from "@/TypesLib";
import { ESec, Emograph } from "@/Widgets";
import { Splash } from "@/Widgets/Shapes";
---

<BLayout pSchema="" pIntro={false} pTitle="اختبار Splash" pDescr="10 أمثلة منفصلة وواضحة لودجت Splash">

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#12313a")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer(36, 24), new NumPer(34, 30))}
			pSize={new DirectSize(new NumPer(190, 130), new NumPer(130, 105))}
			pRotate={new Angle(-6, -4)}
			pZ={6}
			pOpacity={new Percent(90, 90)}
			pFill="#A7C45C" pFill2="rgba(251,255,0,.55)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 1: ركن علوي يسار")}
			pText={Text.Body.White.Centered.OfText("موضع واضح داخل حافة السكشن مع حجم صغير.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#4a2035")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer("calc(100% - 250px)", "calc(100% - 160px)"), new NumPer(42, 36))}
			pSize={new DirectSize(new NumPer(210, 130), new NumPer(128, 105))}
			pRotate={new Angle(7, 5)}
			pZ={6}
			pOpacity={new Percent(90, 90)}
			pFill="#328fe8" pFill2="rgba(255,255,255,.42)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 2: ركن علوي يمين")}
			pText={Text.Body.White.Centered.OfText("الموضع محسوب من عرض السكشن بالكامل حتى لا يخرج في portrait.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#102620")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer(46, 26), new NumPer("calc(100% - 190px)", "calc(100% - 155px)"))}
			pSize={new DirectSize(new NumPer(240, 150), new NumPer(135, 110))}
			pRotate={new Angle(0, 0)}
			pZ={6}
			pOpacity={new Percent(88, 88)}
			pFill="#FFB000" pFill2="rgba(255,255,255,.38)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 3: ركن سفلي يسار")}
			pText={Text.Body.White.Centered.OfText("اختبار قرب الشكل من الحافة السفلية بدون خروجه من الشاشة.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#172136")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer("calc(100% - 320px)", "calc(100% - 190px)"), new NumPer("calc(100% - 205px)", "calc(100% - 160px)"))}
			pSize={new DirectSize(new NumPer(280, 160), new NumPer(155, 115))}
			pRotate={new Angle(-8, -5)}
			pZ={6}
			pOpacity={new Percent(90, 90)}
			pFill="#A7C45C" pFill2="rgba(251,255,0,.55)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 4: ركن سفلي يمين")}
			pText={Text.Body.White.Centered.OfText("حالة طرفية محسوبة بأرقام آمنة للديسكتوب والموبايل.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#2b1d12")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer("calc(50% - 220px)", "calc(50% - 115px)"), new NumPer("calc(50% - 150px)", "calc(50% - 115px)"))}
			pSize={new DirectSize(new NumPer(440, 280), new NumPer(230, 210))}
			pRotate={new Angle(0, 0)}
			pZ={3}
			pOpacity={new Percent(42, 42)}
			pFill="#328fe8" pFill2="rgba(255,255,255,.42)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 5: خلف المحتوى")}
			pText={Text.Body.White.Centered.OfText("طبقة كبيرة في منتصف السكشن مع شفافية واضحة خلف العنوان.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#20303a")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer("10%", "8%"), new NumPer("68%", "70%"))}
			pSize={new DirectSize(new NumPer("80%", "84%"), new NumPer(92, 74))}
			pRotate={new Angle(0, 0)}
			pZ={6}
			pOpacity={new Percent(78, 78)}
			pFill="#FFB000" pFill2="rgba(255,255,255,.38)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 6: امتداد عرضي")}
			pText={Text.Body.White.Centered.OfText("اختبار الشكل كزخرفة عريضة داخل مساحة السكشن.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#425a34")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer(70, 26), new NumPer(120, 130))}
			pSize={new DirectSize(new NumPer(120, 84), new NumPer(320, 250))}
			pRotate={new Angle(0, 0)}
			pZ={6}
			pOpacity={new Percent(86, 86)}
			pFill="#A7C45C" pFill2="rgba(251,255,0,.55)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 7: امتداد رأسي")}
			pText={Text.Body.White.Centered.OfText("اختبار الشكل كزخرفة جانبية طويلة بجوار المحتوى.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#0d1b2a")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer("calc(50% - 330px)", "calc(50% - 155px)"), new NumPer(88, 105))}
			pSize={new DirectSize(new NumPer(660, 310), new NumPer(170, 120))}
			pRotate={new Angle(-6, -3)}
			pZ={6}
			pOpacity={new Percent(76, 76)}
			pFill="#328fe8" pFill2="rgba(255,255,255,.42)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 8: شريط مائل")}
			pText={Text.Body.White.Centered.OfText("حالة دوران وحجم كبير مع ضمان ظهوره كاملًا.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#353535")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer("calc(100% - 330px)", "calc(100% - 185px)"), new NumPer("calc(50% - 80px)", "calc(50% - 70px)"))}
			pSize={new DirectSize(new NumPer(250, 150), new NumPer(145, 115))}
			pRotate={new Angle(9, 5)}
			pZ={6}
			pOpacity={new Percent(96, 96)}
			pFill="#FFB000" pFill2="rgba(255,255,255,.38)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 9: تراكب أمامي")}
			pText={Text.Body.White.Centered.OfText("عنصر واضح فوق المحتوى لاختبار z-index.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new DirectSize(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#3b2f1f")} pAlign={new Align("Center", "Center")}>
		<Splash
			pLoc={new Loc(new NumPer(-55, -28), new NumPer(100, 95))}
			pSize={new DirectSize(new NumPer(260, 155), new NumPer(150, 115))}
			pRotate={new Angle(-10, -7)}
			pZ={6}
			pOpacity={new Percent(88, 88)}
			pFill="#A7C45C" pFill2="rgba(251,255,0,.55)"
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("Splash / مثال 10: خروج جزئي مقصود")}
			pText={Text.Body.White.Centered.OfText("جزء بسيط خارج الحافة لاختبار القص بدون ضياع الشكل كله.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

</BLayout>
