---
import { Align, Angle, ElemBg, Loc, NumPer, Percent, Size, Text } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { Emograph, ESec } from "@/Widgets";
import { FloatingPanel } from "@/Widgets/Shapes";
---

<BLayout pSchema="" pIntro={false} pTitle="اختبار FloatingPanel" pDescr="10 أمثلة منفصلة وواضحة لودجت FloatingPanel">

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#12313a")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer("calc(50% - 240px)", "calc(50% - 145px)"), new NumPer("calc(50% - 110px)", "calc(50% - 115px)"))}
			pSize={new Size(new NumPer(480, 290), new NumPer(220, 230))}
			pRotate={new Angle(0,0)}
			pZ={8}
			pBg="rgba(17,24,32,.88)" pBorder="rgba(255,255,255,.22)" pAccent="#fbff00"
		>
			<h3>مثال 1</h3>
			<p>إطار محتوى واضح في منتصف السكشن.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 1: مركز السكشن")}
			pText={Text.Body.White.Centered.OfText("إطار محتوى واضح في منتصف السكشن.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#4a2035")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer(60, 28), new NumPer(80, 80))}
			pSize={new Size(new NumPer(420, 285), new NumPer(210, 220))}
			pRotate={new Angle(-2,-1)}
			pZ={8}
			pBg="rgba(7,18,24,.88)" pBorder="rgba(167,196,92,.42)" pAccent="#A7C45C"
		>
			<h3>مثال 2</h3>
			<p>إطار داخل منطقة أمان علوية.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 2: يسار علوي")}
			pText={Text.Body.White.Centered.OfText("إطار داخل منطقة أمان علوية.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#102620")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer("calc(100% - 500px)", "calc(100% - 315px)"), new NumPer(80, 80))}
			pSize={new Size(new NumPer(440, 287), new NumPer(210, 220))}
			pRotate={new Angle(2,1)}
			pZ={8}
			pBg="rgba(25,20,38,.88)" pBorder="rgba(50,143,232,.42)" pAccent="#328fe8"
		>
			<h3>مثال 3</h3>
			<p>اختبار تموضع الإطار يمينًا بدون خروجه.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 3: يمين علوي")}
			pText={Text.Body.White.Centered.OfText("اختبار تموضع الإطار يمينًا بدون خروجه.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#172136")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer(70, 30), new NumPer("calc(100% - 280px)", "calc(100% - 275px)"))}
			pSize={new Size(new NumPer(430, 290), new NumPer(210, 220))}
			pRotate={new Angle(2,1)}
			pZ={8}
			pBg="rgba(17,24,32,.88)" pBorder="rgba(255,255,255,.22)" pAccent="#fbff00"
		>
			<h3>مثال 4</h3>
			<p>إطار قريب من أسفل السكشن مع مساحة آمنة.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 4: يسار سفلي")}
			pText={Text.Body.White.Centered.OfText("إطار قريب من أسفل السكشن مع مساحة آمنة.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#2b1d12")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer("calc(100% - 520px)", "calc(100% - 318px)"), new NumPer("calc(100% - 285px)", "calc(100% - 275px)"))}
			pSize={new Size(new NumPer(460, 290), new NumPer(212, 220))}
			pRotate={new Angle(-2,-1)}
			pZ={8}
			pBg="rgba(7,18,24,.88)" pBorder="rgba(167,196,92,.42)" pAccent="#A7C45C"
		>
			<h3>مثال 5</h3>
			<p>حالة ركنية محسوبة للديسكتوب والportrait.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 5: يمين سفلي")}
			pText={Text.Body.White.Centered.OfText("حالة ركنية محسوبة للديسكتوب والportrait.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#20303a")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer("calc(50% - 320px)", "calc(50% - 155px)"), new NumPer("calc(50% - 100px)", "calc(50% - 110px)"))}
			pSize={new Size(new NumPer(640, 310), new NumPer(200, 220))}
			pRotate={new Angle(0,0)}
			pZ={8}
			pBg="rgba(25,20,38,.88)" pBorder="rgba(50,143,232,.42)" pAccent="#328fe8"
		>
			<h3>مثال 6</h3>
			<p>استخدام الإطار كبانل واسع داخل السكشن.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 6: لوحة عريضة")}
			pText={Text.Body.White.Centered.OfText("استخدام الإطار كبانل واسع داخل السكشن.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#425a34")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer(80, 32), new NumPer("calc(50% - 160px)", "calc(50% - 145px)"))}
			pSize={new Size(new NumPer(330, 230), new NumPer(290, 210))}
			pRotate={new Angle(0,0)}
			pZ={8}
			pBg="rgba(17,24,32,.88)" pBorder="rgba(255,255,255,.22)" pAccent="#fbff00"
		>
			<h3>مثال 7</h3>
			<p>تكوين ضيق نسبيًا بجوار المحتوى.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 7: لوحة رأسية")}
			pText={Text.Body.White.Centered.OfText("تكوين ضيق نسبيًا بجوار المحتوى.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#0d1b2a")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer("calc(50% - 210px)", "calc(50% - 130px)"), new NumPer(80, 70))}
			pSize={new Size(new NumPer(420, 260), new NumPer(210, 210))}
			pRotate={new Angle(-5,-3)}
			pZ={8}
			pBg="rgba(7,18,24,.88)" pBorder="rgba(167,196,92,.42)" pAccent="#A7C45C"
		>
			<h3>مثال 8</h3>
			<p>اختبار دوران الإطار مع بقاء النص مقروءًا.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 8: دوران خفيف")}
			pText={Text.Body.White.Centered.OfText("اختبار دوران الإطار مع بقاء النص مقروءًا.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#353535")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer("calc(50% - 245px)", "calc(50% - 145px)"), new NumPer("calc(100% - 265px)", "calc(100% - 260px)"))}
			pSize={new Size(new NumPer(490, 290), new NumPer(215, 220))}
			pRotate={new Angle(0,0)}
			pZ={8}
			pBg="rgba(25,20,38,.88)" pBorder="rgba(50,143,232,.42)" pAccent="#328fe8"
		>
			<h3>مثال 9</h3>
			<p>اختبار منطقة bleed السفلية بدون خروج.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 9: قرب الحافة السفلية")}
			pText={Text.Body.White.Centered.OfText("اختبار منطقة bleed السفلية بدون خروج.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(580, 650))} pBg={new ElemBg("#3b2f1f")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<FloatingPanel
			pLoc={new Loc(new NumPer("calc(50% - 250px)", "calc(50% - 145px)"), new NumPer(-18, -10))}
			pSize={new Size(new NumPer(500, 290), new NumPer(220, 220))}
			pRotate={new Angle(0,0)}
			pZ={8}
			pBg="rgba(17,24,32,.88)" pBorder="rgba(255,255,255,.22)" pAccent="#fbff00"
		>
			<h3>مثال 10</h3>
			<p>جزء من الإطار داخل منطقة تراكب أعلى السكشن.</p>
		</FloatingPanel>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("FloatingPanel / مثال 10: خروج علوي بسيط")}
			pText={Text.Body.White.Centered.OfText("جزء من الإطار داخل منطقة تراكب أعلى السكشن.")}
			style="position:absolute; inset-inline:0; top:22px; z-index:20; width:min(820px, 90%); margin-inline:auto; pointer-events:none; text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<style>
		:global(.GlassCard h3), :global(.FloatingPanel h3), :global(.BadgeFrame h3), :global(.TiltCard h3) { margin: 0 0 10px; font-size: clamp(20px, 2vw, 30px); line-height: 1.4; }
		:global(.GlassCard p), :global(.FloatingPanel p), :global(.BadgeFrame p), :global(.TiltCard p) { margin: 0; font-size: clamp(14px, 1.2vw, 18px); line-height: 1.9; }
	</style>

</BLayout>
