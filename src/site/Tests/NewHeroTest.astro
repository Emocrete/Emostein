			<Emograph pTitle={Text.H1.White.OfText("01 — هيرو حر بتكوين كلاسيكي")} pSize={new Size("100%", "auto", "100%", "auto")} />

		</FreeHeroItem>

		<FreeHeroItem
			pLoc={new Location("20%", "26%", "38%", "32%")}
			pBox={new Size("30%", "auto", "95%", "auto")}
