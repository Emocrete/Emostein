import { Emograph, Stack, EmoCall, RespImg, CardsGr,FreeHero, FreeHeroMoveItem, FreeHeroKeyPoint ,FreeHeroItem } from "@/Widgets";
---




















<BLayout pSchemaType="Article" pTitle="FreeHero Preview" pDescr="صفحة اختبار لعشرين حالة استخدام مختلفة لودجت FreeHero الجديد">

	<FreeHero pImgF="/Media/Home/">

		<FreeHeroMoveItem
			pKeyPoints={[
				new FreeHeroKeyPoint(
					new Location("8%", "5%", "20%", "12%"),
					new Size(340, 120, 280, 110),
					"0deg",
					1
				),
	
				new FreeHeroKeyPoint(
					new Location("58%", "20%", "28%", "42%"),
					new Size(420, 150, 300, 120),
					new RespString("8deg", "-6deg"),
					.85
				),
	
				new FreeHeroKeyPoint(
					new Location("35%", "8%", "62%", "68%"),
					new Size(300, 110, 260, 100),
					"0deg",
					1
				),
			]}
			pIntervals={[900, 1200]}
			pEase="cubic-bezier(.42, 0, .18, 1)"
			pZ={5}
		>

			<Emograph pTitle={Text.H2.Centered.OfText("عنصر متحرك")} pText={Text.Body.Centered.OfText("ينتقل بين عدة KeyPoints ثم يستقر على آخر حالة")} />

