---
import { Align, Angle, ElemBg, Loc, NumPer, Percent, Size, Text } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { Emograph, ESec } from "@/Widgets";
import { BlobDivider } from "@/Widgets/Shapes";
---

<BLayout pSchema="" pIntro={false} pTitle="اختبار BlobDivider" pDescr="10 أمثلة منفصلة وواضحة لودجت BlobDivider">

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#12313a")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer(0), new NumPer("calc(100% - 130px)", "calc(100% - 105px)"))}
			pSize={new Size(new NumPer("100%"), new NumPer(130, 105))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#328fe8"
			pFill2="rgba(251,255,0,.30)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 1: حافة سفلية كاملة")}
			pText={Text.Body.White.Centered.OfText("شكل فاصل على أسفل السكشن بعرض كامل.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#4a2035")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer(0), new NumPer(0))}
			pSize={new Size(new NumPer("100%"), new NumPer(130, 105))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#FFB000"
			pFill2="rgba(50,143,232,.35)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 2: حافة علوية كاملة")}
			pText={Text.Body.White.Centered.OfText("توظيف نفس الودجت أعلى السكشن.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#102620")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer(0), new NumPer("calc(50% - 70px)", "calc(50% - 55px)"))}
			pSize={new Size(new NumPer("100%"), new NumPer(140, 110))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#FAFAFA"
			pFill2="rgba(255,255,255,.35)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 3: منتصف السكشن")}
			pText={Text.Body.White.Centered.OfText("اختبار ظهور الفاصل في منتصف المشهد.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#172136")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer("5%", "4%"), new NumPer("calc(100% - 155px)", "calc(100% - 125px)"))}
			pSize={new Size(new NumPer("90%", "92%"), new NumPer(135, 105))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#A7C45C"
			pFill2="rgba(251,255,0,.30)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 4: هامش داخلي")}
			pText={Text.Body.White.Centered.OfText("فاصل بعرض أقل من السكشن لتوضيح الهامش الجانبي.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#2b1d12")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer("-4%", "-8%"), new NumPer("calc(100% - 150px)", "calc(100% - 120px)"))}
			pSize={new Size(new NumPer("108%", "116%"), new NumPer(140, 110))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#328fe8"
			pFill2="rgba(50,143,232,.35)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 5: نزيف خارج الحواف")}
			pText={Text.Body.White.Centered.OfText("توضيح bleed جانبي مع بقاء الشكل ظاهرًا بالكامل تقريبًا.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#20303a")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer(0), new NumPer(70, 90))}
			pSize={new Size(new NumPer("100%"), new NumPer(120, 95))}
			pRotate={new Angle(180,180)}
			pZ={4}
			pFill="#FFB000"
			pFill2="rgba(255,255,255,.35)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 6: دوران 180 درجة")}
			pText={Text.Body.White.Centered.OfText("اختبار دوران الشكل لاستخدامه بعكس اتجاهه.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#425a34")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer("calc(50% - 350px)", "calc(50% - 165px)"), new NumPer("calc(50% - 75px)", "calc(50% - 60px)"))}
			pSize={new Size(new NumPer(700, 330), new NumPer(150, 120))}
			pRotate={new Angle(-4,-2)}
			pZ={4}
			pFill="#FAFAFA"
			pFill2="rgba(251,255,0,.30)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 7: لوحة مائلة")}
			pText={Text.Body.White.Centered.OfText("حالة فاصل داخلية مائلة وليست على طرف السكشن.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#0d1b2a")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer(0), new NumPer("calc(100% - 190px)", "calc(100% - 145px)"))}
			pSize={new Size(new NumPer("100%"), new NumPer(185, 140))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#A7C45C"
			pFill2="rgba(50,143,232,.35)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 8: فاصل مرتفع")}
			pText={Text.Body.White.Centered.OfText("اختبار ارتفاع أكبر للفاصل في منطقة الأمان السفلية.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#353535")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer(0), new NumPer("calc(100% - 92px)", "calc(100% - 82px)"))}
			pSize={new Size(new NumPer("100%"), new NumPer(92, 82))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#328fe8"
			pFill2="rgba(255,255,255,.35)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 9: فاصل رفيع")}
			pText={Text.Body.White.Centered.OfText("حالة منخفضة الارتفاع مناسبة لفواصل بسيطة.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

	<ESec pBox={new Size(new NumPer("100%"), new NumPer(560, 620))} pBg={new ElemBg("#3b2f1f")} pHzAlign={new Align("Center", "Center")}
 pVrAlign={new Align("Center", "Center")}>
		<BlobDivider
			pLoc={new Loc(new NumPer(0), new NumPer(-22, -16))}
			pSize={new Size(new NumPer("100%"), new NumPer(150, 115))}
			pRotate={new Angle(0,0)}
			pZ={4}
			pFill="#FFB000"
			pFill2="rgba(251,255,0,.30)"
			pStroke="rgba(255,255,255,.55)"
			pStrokeWidth={1}
		/>
		<Emograph
			pTitle={Text.H2.White.Centered.OfText("BlobDivider / مثال 10: خروج علوي جزئي")}
			pText={Text.Body.White.Centered.OfText("شكل داخل منطقة bleed أعلى السكشن بدون كسر المحتوى.")}
			style="position:relative; z-index:20; width:min(760px, 88%); text-shadow:0 2px 12px rgba(0,0,0,.28);"
		/>
	</ESec>

</BLayout>
