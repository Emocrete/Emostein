---
const cRealHosts = new Set(["emocrete.com", "www.emocrete.com"]);
const cEnabled = cRealHosts.has(Astro.url.hostname.toLowerCase()) && import.meta.env.PUBLIC_EMO_OPS_ENABLED !== "false";
---

{cEnabled && (
<script is:inline>
(() => {
	if (window.__EmoClaritySessionIndexerStarted) return;
	window.__EmoClaritySessionIndexerStarted = true;

	const cEndpoint = "/api/ops/clarity";
	let fLastKey = "";
	let fRegistered = false;
	const fPendingKeys = new Set();

	function Str(pValue) { return String(pValue ?? "").trim(); }
	function Ids() {
		const Value = window.__EmoOpsIds || {};
		return {
			visitorId: Str(Value.visitorId),
			sessionId: Str(Value.sessionId),
			pageInstanceId: Str(Value.pageInstanceId)
		};
	}

	async function Publish(pMetadata, pPlayback, pAttempt = 0) {
		const Visit = Ids();
		const ProjectId = Str(pMetadata?.projectId || pMetadata?.project);
		const UserId = Str(pMetadata?.userId || pMetadata?.user);
		const ClaritySessionId = Str(pMetadata?.sessionId || pMetadata?.session);
		const PageNumberValue = Number(pMetadata?.pageNum || pMetadata?.page || 1);
		const PageNumber = Number.isFinite(PageNumberValue) && PageNumberValue > 0 ? Math.trunc(PageNumberValue) : 1;
		if (!Visit.sessionId || !ProjectId || !UserId || !ClaritySessionId) return;
		if (pPlayback === false) return;
		const Key = `${Visit.sessionId}|${ProjectId}|${UserId}|${ClaritySessionId}`;
		if (Key === fLastKey || fPendingKeys.has(Key)) return;
		fPendingKeys.add(Key);
		const ClarityUrl = `https://clarity.microsoft.com/player/${encodeURIComponent(ProjectId)}/${encodeURIComponent(UserId)}/${encodeURIComponent(ClaritySessionId)}/${PageNumber}`;
		try {
			const Response = await fetch(cEndpoint, {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({
					visitorId: Visit.visitorId,
					sessionId: Visit.sessionId,
					pageInstanceId: Visit.pageInstanceId,
					clarityProjectId: ProjectId,
					clarityUserId: UserId,
					claritySessionId: ClaritySessionId,
					clarityPageNumber: PageNumber,
					clarityUrl: ClarityUrl,
					indexedAt: new Date().toISOString()
				}),
				keepalive: true
			});
			if (!Response.ok) throw new Error(`HTTP ${Response.status}`);
			fLastKey = Key;
		} catch {
			if (pAttempt < 5) window.setTimeout(() => Publish(pMetadata, pPlayback, pAttempt + 1), 2000 * (pAttempt + 1));
		} finally {
			fPendingKeys.delete(Key);
		}
	}

	function Register() {
		if (fRegistered || typeof window.clarity !== "function") return;
		const Visit = Ids();
		if (!Visit.sessionId) return;
		fRegistered = true;
		try {
			window.clarity("metadata", (Metadata, Playback) => Publish(Metadata, Playback), true, true);
		} catch { fRegistered = false; }
	}

	function Start() {
		Register();
		if (fRegistered) return;
		let Attempts = 0;
		const Wait = window.setInterval(() => {
			Attempts += 1;
			Register();
			if (fRegistered || Attempts >= 120) window.clearInterval(Wait);
		}, 500);
	}

	window.addEventListener("emo:ops-page-open", Start, { once: true });
	if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", Start, { once: true });
	else Start();
})();
</script>
)}
