<script is:inline>
	(() => {
		const cContainerSelector = "[data-emo-auto-container]";
		const cSectionSelector = "section";
		const cIgnoredChildSelector = "[data-emo-container-bg], script, style, template, link, meta";
		const cDefaultEmptyHeight = 200;
		const cMaxPasses = 12;
		const cHeightTolerance = 0.5;

		const fSections = new Set();
		const fSectionRecords = new WeakMap();
		const fContainerStates = new WeakMap();
		const fObservedMedia = new WeakSet();

		function ToNumber(pValue, pFallback = 0) {
			const cValue = Number.parseFloat(`${pValue}`);
			return Number.isFinite(cValue) ? cValue : pFallback;
		}

		function IsExplicitHeight(pContainer) {
			return pContainer.dataset.emoExplicitHeight === "true";
		}

		function IsIgnoredChild(pChild) {
			return pChild.matches(cIgnoredChildSelector) || pChild.closest("[data-emo-container-bg]") !== null;
		}

		function GetContainerState(pContainer) {
			let cState = fContainerStates.get(pContainer);
			if (cState) return cState;

			cState = {
				OriginalMinHeight: pContainer.style.minHeight,
				AppliedMinHeight: null,
				BaseMinHeight: 0,
			};

			fContainerStates.set(pContainer, cState);
			return cState;
		}

		function GetSectionRoot(pElement) {
			if (!(pElement instanceof Element)) return null;
			const cSection = pElement.closest(cSectionSelector);
			return cSection instanceof HTMLElement ? cSection : null;
		}

		function GetSectionContainers(pSection) {
			const cContainers = [];

			if (pSection.matches(cContainerSelector)) {
				cContainers.push(pSection);
			}

			pSection.querySelectorAll(cContainerSelector).forEach((pContainer) => {
				if (!(pContainer instanceof HTMLElement)) return;
				if (GetSectionRoot(pContainer) !== pSection) return;
				cContainers.push(pContainer);
			});

			return cContainers;
		}

		function IsVisibleStyle(pStyle) {
			return pStyle.display !== "none" && pStyle.visibility !== "collapse";
		}

		function GetContentChildren(pContainer) {
			const cChildren = [];

			for (const cChild of pContainer.children) {
				if (!(cChild instanceof HTMLElement) || IsIgnoredChild(cChild) || cChild.hidden) continue;

				const cStyle = window.getComputedStyle(cChild);
				if (!IsVisibleStyle(cStyle)) continue;

				cChildren.push({ Element: cChild, Style: cStyle });
			}

			return cChildren;
		}

		function HasDirectTextContent(pContainer) {
			return Array.from(pContainer.childNodes).some((pNode) => {
				return pNode.nodeType === Node.TEXT_NODE && (pNode.textContent ?? "").trim().length > 0;
			});
		}

		function MeasureContentHeight(pContainer, pChildren) {
			const cContainerRect = pContainer.getBoundingClientRect();
			const cStyle = window.getComputedStyle(pContainer);
			const cBorderTop = ToNumber(cStyle.borderTopWidth, 0);
			const cBorderBottom = ToNumber(cStyle.borderBottomWidth, 0);
			const cPaddingBottom = ToNumber(cStyle.paddingBottom, 0);
			let cHeight = pContainer.scrollHeight;

			for (const cChild of pChildren) {
				const cChildRect = cChild.Element.getBoundingClientRect();
				const cChildBottom = cChildRect.bottom - cContainerRect.top + cBorderBottom;
				const cIsOutOfFlow = cChild.Style.position === "absolute" || cChild.Style.position === "fixed";

				if (cIsOutOfFlow) {
					cHeight = Math.max(cHeight, cChildBottom);
					continue;
				}

				cHeight = Math.max(cHeight, cChildBottom + cPaddingBottom);
			}

			return Math.max(0, Math.ceil(cHeight + cBorderTop));
		}

		function ResetGeneratedMinHeights(pRecord) {
			for (const cContainer of pRecord.Containers) {
				const cState = GetContainerState(cContainer);
				if (cContainer.style.minHeight !== cState.OriginalMinHeight) {
					cContainer.style.minHeight = cState.OriginalMinHeight;
				}
				cState.AppliedMinHeight = null;
			}
		}

		function MeasureSection(pRecord, pRefreshBase) {
			const cMeasurements = [];

			for (const cContainer of pRecord.Containers) {
				const cState = GetContainerState(cContainer);
				const cContainerStyle = window.getComputedStyle(cContainer);

				if (pRefreshBase) {
					cState.BaseMinHeight = ToNumber(cContainerStyle.minHeight, 0);
				}

				if (IsExplicitHeight(cContainer)) {
					cMeasurements.push({ Container: cContainer, State: cState, TargetHeight: null });
					continue;
				}

				const cChildren = GetContentChildren(cContainer);
				const cHasDirectTextContent = HasDirectTextContent(cContainer);
				let cTargetHeight;

				if (cChildren.length === 0 && !cHasDirectTextContent) {
					const cEmptyHeight = ToNumber(cContainer.dataset.emoEmptyHeight, cDefaultEmptyHeight);
					cTargetHeight = Math.max(cEmptyHeight, cState.BaseMinHeight);
				} else {
					const cContentHeight = MeasureContentHeight(cContainer, cChildren);
					cTargetHeight = Math.max(cContentHeight, cState.BaseMinHeight);
				}

				cMeasurements.push({ Container: cContainer, State: cState, TargetHeight: cTargetHeight });
			}

			return cMeasurements;
		}

		function ApplyMeasurements(pMeasurements) {
			let cChangedCount = 0;

			for (const cMeasurement of pMeasurements) {
				const { Container: cContainer, State: cState, TargetHeight: cTargetHeight } = cMeasurement;
				let cDesiredMinHeight = cState.OriginalMinHeight;
				let cAppliedHeight = null;

				if (cTargetHeight !== null && cTargetHeight > cState.BaseMinHeight + cHeightTolerance) {
					cAppliedHeight = Math.ceil(cTargetHeight);
					cDesiredMinHeight = `${cAppliedHeight}px`;
				}

				if (cContainer.style.minHeight !== cDesiredMinHeight) {
					cContainer.style.minHeight = cDesiredMinHeight;
					cChangedCount += 1;
				}

				cState.AppliedMinHeight = cAppliedHeight;
			}

			return cChangedCount;
		}

		function DiscardOwnMutations(pRecord) {
			pRecord.MutationObserver?.takeRecords();
		}

		function FinishSection(pRecord) {
			pRecord.Stabilizing = false;
			pRecord.Pass = 0;
			DiscardOwnMutations(pRecord);

			if (pRecord.PendingExternalChange) {
				pRecord.PendingExternalChange = false;
				QueueSection(pRecord);
			}
		}

		function WarnNonConvergingSection(pRecord) {
			if (location.hostname !== "localhost" && location.hostname !== "127.0.0.1") return;

			const cName = pRecord.Section.id
				? `#${pRecord.Section.id}`
				: pRecord.Section.className
					? `.${`${pRecord.Section.className}`.trim().replace(/\s+/g, ".")}`
					: pRecord.Section.tagName.toLowerCase();

			console.warn(`AutoContainerHeight did not converge inside ${cName} after ${cMaxPasses} passes.`);
		}

		function RunSectionPass(pRecord, pRefreshBase = false) {
			if (!pRecord.Section.isConnected) {
				FinishSection(pRecord);
				return;
			}

			pRecord.Pass += 1;

			if (pRefreshBase) {
				ResetGeneratedMinHeights(pRecord);
			}

			const cMeasurements = MeasureSection(pRecord, pRefreshBase);
			const cChangedCount = ApplyMeasurements(cMeasurements);
			DiscardOwnMutations(pRecord);

			if (cChangedCount === 0) {
				FinishSection(pRecord);
				return;
			}

			if (pRecord.Pass >= cMaxPasses) {
				WarnNonConvergingSection(pRecord);
				FinishSection(pRecord);
				return;
			}

			window.requestAnimationFrame(() => RunSectionPass(pRecord, false));
		}

		function QueueSection(pRecord) {
			if (!pRecord.Section.isConnected) return;

			if (pRecord.Stabilizing) {
				pRecord.PendingExternalChange = true;
				return;
			}

			if (pRecord.Queued) return;

			pRecord.Queued = true;
			window.requestAnimationFrame(() => {
				pRecord.Queued = false;
				if (!pRecord.Section.isConnected) return;

				pRecord.Stabilizing = true;
				pRecord.PendingExternalChange = false;
				pRecord.Pass = 0;
				RunSectionPass(pRecord, true);
			});
		}

		function HandleExternalMinHeightChange(pMutation) {
			if (pMutation.type !== "attributes" || pMutation.attributeName !== "style") return;
			if (!(pMutation.target instanceof HTMLElement) || !pMutation.target.matches(cContainerSelector)) return;

			const cState = GetContainerState(pMutation.target);
			const cCurrentMinHeight = pMutation.target.style.minHeight;
			const cAppliedMinHeight = cState.AppliedMinHeight === null ? null : `${cState.AppliedMinHeight}px`;

			if (cAppliedMinHeight === null || cCurrentMinHeight !== cAppliedMinHeight) {
				cState.OriginalMinHeight = cCurrentMinHeight;
				cState.AppliedMinHeight = null;
			}
		}

		function ObserveMediaInSection(pRecord) {
			pRecord.Section.querySelectorAll("img, video").forEach((pMedia) => {
				if (!(pMedia instanceof HTMLElement) || GetSectionRoot(pMedia) !== pRecord.Section || fObservedMedia.has(pMedia)) return;
				fObservedMedia.add(pMedia);

				const cInvalidate = () => QueueSection(pRecord);
				pMedia.addEventListener("load", cInvalidate, { passive: true });
				pMedia.addEventListener("loadedmetadata", cInvalidate, { passive: true });
			});
		}

		function SyncResizeTargets(pRecord) {
			if (!pRecord.ResizeObserver) return;

			pRecord.ResizeObserver.disconnect();
			const cObserved = new Set();

			for (const cContainer of pRecord.Containers) {
				for (const cChild of cContainer.children) {
					if (!(cChild instanceof HTMLElement) || IsIgnoredChild(cChild) || cObserved.has(cChild)) continue;
					cObserved.add(cChild);
					pRecord.ResizeObserver.observe(cChild);
				}
			}
		}

		function SyncSection(pRecord) {
			pRecord.Containers = GetSectionContainers(pRecord.Section);
			for (const cContainer of pRecord.Containers) GetContainerState(cContainer);
			SyncResizeTargets(pRecord);
			ObserveMediaInSection(pRecord);
		}

		function EnsureSection(pSection) {
			if (!(pSection instanceof HTMLElement)) return null;

			let cRecord = fSectionRecords.get(pSection);
			if (cRecord) return cRecord;

			const cContainers = GetSectionContainers(pSection);
			if (cContainers.length === 0) return null;

			cRecord = {
				Section: pSection,
				Containers: cContainers,
				ResizeObserver: null,
				MutationObserver: null,
				Queued: false,
				Stabilizing: false,
				PendingExternalChange: false,
				Pass: 0,
			};

			if ("ResizeObserver" in window) {
				cRecord.ResizeObserver = new ResizeObserver(() => {
					if (cRecord.Stabilizing) return;
					QueueSection(cRecord);
				});
			}

			if ("MutationObserver" in window) {
				cRecord.MutationObserver = new MutationObserver((pMutations) => {
					let cStructureChanged = false;

					for (const cMutation of pMutations) {
						HandleExternalMinHeightChange(cMutation);
						if (cMutation.type === "childList" || cMutation.attributeName === "data-emo-auto-container") {
							cStructureChanged = true;
						}
					}

					if (cStructureChanged) SyncSection(cRecord);

					if (cRecord.Stabilizing) {
						cRecord.PendingExternalChange = true;
						return;
					}

					QueueSection(cRecord);
				});

				cRecord.MutationObserver.observe(pSection, {
					childList: true,
					subtree: true,
					characterData: true,
					attributes: true,
					attributeFilter: [
						"class",
						"style",
						"hidden",
						"data-emo-auto-container",
						"data-emo-explicit-height",
						"data-emo-empty-height",
					],
				});
			}

			fSectionRecords.set(pSection, cRecord);
			fSections.add(pSection);
			SyncSection(cRecord);
			return cRecord;
		}

		function RemoveDisconnectedSections() {
			for (const cSection of fSections) {
				if (cSection.isConnected) continue;

				const cRecord = fSectionRecords.get(cSection);
				cRecord?.ResizeObserver?.disconnect();
				cRecord?.MutationObserver?.disconnect();
				fSections.delete(cSection);
			}
		}

		function ObserveSections() {
			RemoveDisconnectedSections();

			document.querySelectorAll(cSectionSelector).forEach((pSection) => {
				if (!(pSection instanceof HTMLElement)) return;
				EnsureSection(pSection);
			});
		}

		function QueueAllSections() {
			ObserveSections();

			for (const cSection of fSections) {
				const cRecord = fSectionRecords.get(cSection);
				if (cRecord) QueueSection(cRecord);
			}
		}

		window.addEventListener("load", QueueAllSections, { passive: true });
		window.addEventListener("resize", QueueAllSections, { passive: true });
		window.addEventListener("orientationchange", QueueAllSections, { passive: true });

		document.addEventListener("astro:page-load", () => {
			ObserveSections();
			QueueAllSections();
		});

		if (document.fonts?.ready) {
			document.fonts.ready.then(QueueAllSections).catch(() => {});
		}

		ObserveSections();
		QueueAllSections();
	})();
</script>
