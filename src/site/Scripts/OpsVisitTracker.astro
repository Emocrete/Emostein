		function ReadDebugRecordEvent(pState, pEventType, pTime, pMode, pHasBody)
		{
			if (!cReadDebugEnabled || !pState) return;
			const Snapshot = {
				Type: pEventType,
				Mode: pMode || "",
				Until: Date.now() + 2600,
				AccumMs: Number(pState.AccumMs || 0),
				OpsRecords: pHasBody ? 2 : 1
			};
			fReadDebugFlashes.set(pState, Snapshot);
			fReadDebugEventIndex += 1;
			fReadDebugEvents.unshift({
				Index: fReadDebugEventIndex,
				Type: pEventType === "read_full" ? "FULL" : "QUICK",
				Mode: Snapshot.Mode,
				OpsRecords: Snapshot.OpsRecords,
				Selector: ReadDebugSelector(pState),
				Title: ReadDebugTitle(pState)
			});
			if (fReadDebugEvents.length > 14) fReadDebugEvents.length = 14;
			QueueReadDebugOverlayUpdate();
