		function GetReadableBlocksText(pElem)
		{
			if (!pElem?.querySelectorAll) return CleanText(pElem?.textContent || "");
			const Blocks = Array.from(pElem.querySelectorAll("h1, h2, h3, h4, h5, h6, p, li"));
			const Parts = [];
			let OrderedIndex = 0;
			Blocks.forEach((pBlock) =>
				{
					if (FindReadTargetAncestor(pBlock) !== pElem) return;
					if (pBlock.closest("script, style, nav, form, button, a, summary")) return;
					const Text = CleanText(pBlock.textContent || "");
					if (!Text) return;
					const Tag = String(pBlock.tagName || "").toLowerCase();
					if (/^h[1-6]$/.test(Tag))
					{
						Parts.push(`## ${Text}`);
						return;
					}
					if (Tag === "li")
					{
						const List = pBlock.parentElement;
						if (List?.tagName?.toLowerCase() === "ol")
						{
							OrderedIndex = Array.from(List.children).indexOf(pBlock) + 1;
							Parts.push(`${OrderedIndex}. ${Text}`);
						} else {
							Parts.push(`• ${Text}`);
						}
						return;
					}
					Parts.push(Text);
			});
			if (Parts.length) return Parts.join("\n");
			const Clone = pElem.cloneNode(true);
			Clone.querySelectorAll?.("script, style, svg, img, nav, form, button, a, summary").forEach((pNode) => pNode.remove());
			return CleanText(Clone.textContent || "");
		}





		function FindReadTargetAncestor(pElem)
		{
			let Node = pElem;
			while (Node && Node !== document.body)
			{
				if (fReadStates.has(Node)) return Node;
				Node = Node.parentElement;
			}
			return null;
		}





		function GetReadFullMs(pElem, pWordCount)
		{
			const Manual = Number.parseFloat(pElem?.dataset?.opsReadMs || pElem?.dataset?.readMs || "");
			if (Number.isFinite(Manual) && Manual > 0) return Manual;
			return (Math.max(0, pWordCount) / cReadWordsPerMinute) * 60000;
		}





		function EnsureReadState(pElem, pWidgetName = "")
		{
			let State = fReadStates.get(pElem);
			if (State)
			{
				if (pWidgetName && !State.Widget) State.Widget = pWidgetName;
				return State;
			}
			State = {
				Elem: pElem,
				Widget: pWidgetName || GetWidgetName(pElem),
				Label: "",
				Text: "",
				WordCount: 0,
				FullMs: 0,
				QuickMs: 0,
				Parent: null,
				Children: [],
				InFocus: false,
				Active: false,
				Done: false,
				QuickCandidate: false,
				QuickDone: false,
				FullDone: false,
				AccumMs: 0,
				Cycle: 0,
				FullAt: 0,
				ResetAt: 0,
				Order: cReadTargets.length
			};
			fReadStates.set(pElem, State);
			cReadTargets.push(State);
			return State;
		}





		function IsReadableBoundary(pElem)
		{
			return pElem instanceof Element && pElem.hasAttribute("readable");
		}





		function GetReadableBoundary(pElem)
		{
			return pElem?.closest?.("[readable]") || null;
		}





		function RegisterReadElement(pElem, pWidgetName = "")
		{
			if (!pElem || pElem.dataset?.opsAuto === "off") return;
			const Boundary = GetReadableBoundary(pElem);
			if (Boundary && Boundary !== pElem) return;
			EnsureReadState(pElem, pWidgetName);
		}





		function ApplyReadableBoundaries()
		{
			const Boundaries = Array.from(document.querySelectorAll("[readable]"));
			Boundaries.forEach((pElem) => EnsureReadState(pElem, GetWidgetName(pElem)));
			for (let Index = cReadTargets.length - 1; Index >= 0; Index--)
			{
				const State = cReadTargets[Index];
				const Boundary = GetReadableBoundary(State.Elem);
				if (!Boundary || Boundary === State.Elem) continue;
				fReadStates.delete(State.Elem);
				cReadTargets.splice(Index, 1);
			}
			cReadTargets.forEach((pState, pIndex) => pState.Order = pIndex);
		}





		function PrepareReadStateText(pState)
		{
			pState.Label = BuildViewLabel(pState.Elem);
			pState.Text = GetReadableBlocksText(pState.Elem);
			pState.WordCount = CountWords(pState.Text);
			pState.FullMs = GetReadFullMs(pState.Elem, pState.WordCount);
			pState.QuickMs = pState.FullMs / 2;
		}





		function BuildReadHierarchy()
		{
			cReadTargets.forEach((pState) =>
				{
					pState.Parent = null;
					pState.Children = [];
					PrepareReadStateText(pState);
			});
			cReadTargets.forEach((pState) =>
				{
					let Node = pState.Elem.parentElement;
					while (Node && Node !== document.body)
					{
						const ParentState = fReadStates.get(Node);
						if (ParentState)
						{
							pState.Parent = ParentState;
							ParentState.Children.push(pState);
							break;
						}
						Node = Node.parentElement;
					}
			});
		}





		function ResetAncestorsForNewCycle(pState, pTime)
		{
			let Parent = pState.Parent;
			while (Parent)
			{
				Parent.ResetAt = pTime;
				Parent.FullDone = false;
				Parent.Done = false;
				Parent.FullAt = 0;
				Parent = Parent.Parent;
			}
		}





		function StartReadCycle(pState, pTime)
		{
			pState.Cycle += 1;
			pState.AccumMs = 0;
			pState.Active = false;
			pState.Done = false;
			pState.QuickCandidate = false;
			pState.QuickDone = false;
			pState.FullDone = false;
			pState.FullAt = 0;
			ResetAncestorsForNewCycle(pState, pTime);
		}





		function FinishReadCycleOnExit(pState, pTime)
		{
			if (fActiveReadState === pState) fActiveReadState = null;
			pState.Active = false;
			if (!pState.FullDone && pState.QuickCandidate && !pState.QuickDone)
			{
				TrackReadEvent(pState, "read_quick", pTime, "quick");
				pState.QuickDone = true;
				pState.Done = true;
			}
			pState.AccumMs = 0;
			pState.QuickCandidate = false;
		}





		function CompareDomOrder(pA, pB)
		{
			if (pA.Elem === pB.Elem) return 0;
			const Pos = pA.Elem.compareDocumentPosition(pB.Elem);
			if (Pos & Node.DOCUMENT_POSITION_PRECEDING) return 1;
			if (Pos & Node.DOCUMENT_POSITION_FOLLOWING) return - 1;
			return pA.Order - pB.Order;
		}





		function GetReadableLeavesInFocus()
		{
			return cReadTargets
			.filter((pState) => pState.InFocus && !pState.Done && pState.Children.length === 0 && pState.FullMs > 0 && pState.WordCount > 0)
			.sort(CompareDomOrder);
		}





		function TrackAnalyticsReadEvent(pState, pEventType)
		{
			const Analytics = window.EmoAnalytics;
			if (!Analytics || typeof Analytics.GetItemName !== "function" || typeof Analytics.TrackTemplate !== "function") return;
			const ElementId = String(pState.Elem?.id || "").trim();
			if (!ElementId) return;
			const ItemName = Analytics.GetItemName(pState.Elem);
			if (!ItemName) return;
			const IsFullRead = pEventType === "read_full";
			const IsServicEmoSection = pState.Elem?.matches?.('.EmoSection[data-ga-service="true"]') === true;
			const Prefix = IsServicEmoSection
			? (IsFullRead ? "Srv" : "SrvQ")
			: (IsFullRead ? "R" : "RQ");
			Analytics.TrackTemplate(Prefix, ItemName);
		}





		function TrackReadEvent(pState, pEventType, pTime, pMode)
		{
			TrackAnalyticsReadEvent(pState, pEventType);
			const WidgetName = pState.Widget || GetWidgetName(pState.Elem);
			const ReadTitle = pState.Label || BuildViewLabel(pState.Elem);
			const ReadableText = String(pState.Text || "");
			const BodyText = Shorten(ReadableText, 420);
			const ReadEventData = {
				readTitle: ReadTitle,
				readableText: ReadableText,
				readable: IsReadableBoundary(pState.Elem),
				id: String(pState.Elem?.id || ""),
				selector: GetReplaySelector(pState.Elem),
				tag: String(pState.Elem?.tagName || "").toLowerCase(),
				label: ReadTitle
			};
			if (BodyText)
			{
				TrackOpsEvent(pEventType, {
						eventOn: "read_body",
						widget: WidgetName,
						label: BodyText,
						labelMax: 420,
						value: pState.WordCount,
						durationMs: Math.round(pState.AccumMs),
						awayReason: `${pMode || ""}:body`,
						eventData: ReadEventData
				});
			}
			TrackOpsEvent(pEventType, {
					eventOn: "read",
					widget: WidgetName,
					label: ReadTitle,
					value: pState.WordCount,
					durationMs: Math.round(pState.AccumMs),
					awayReason: pMode || "",
					eventData: ReadEventData
			});
			if (pEventType === "read_full")
			{
				pState.FullDone = true;
				pState.Done = true;
				pState.FullAt = pTime;
				pState.QuickCandidate = false;
				CheckParentReadCompletion(pState.Parent, pTime);
			}
		}





		function IsReadRelevantState(pState)
		{
			if (!pState) return false;
			if (pState.WordCount > 0) return true;
			return pState.Children.some((pChild) => IsReadRelevantState(pChild));
		}





		function CheckParentReadCompletion(pParent, pTime)
		{
			if (!pParent || pParent.FullDone || !pParent.Children.length) return;
			const RequiredChildren = pParent.Children.filter((pChild) => IsReadRelevantState(pChild));
			if (!RequiredChildren.length) return;
			const AllChildrenFull = RequiredChildren.every((pChild) => pChild.FullAt > pParent.ResetAt);
			if (!AllChildrenFull) return;
			pParent.AccumMs = RequiredChildren.reduce((pSum, pChild) => pSum + (pChild.FullMs || pChild.AccumMs || 0), 0);
			pParent.WordCount = RequiredChildren.reduce((pSum, pChild) => pSum + (pChild.WordCount || 0), 0) || pParent.WordCount;
			TrackReadEvent(pParent, "read_full", pTime, "children_complete");
		}





		function UpdateReadFocusStates(pTime)
		{
			cReadTargets.forEach((pState) =>
				{
					const WasInFocus = pState.InFocus;
					const NowInFocus = IsReadableVisible(pState.Elem);
					if (NowInFocus && !WasInFocus) StartReadCycle(pState, pTime);
					if (!NowInFocus && WasInFocus) FinishReadCycleOnExit(pState, pTime);
					pState.InFocus = NowInFocus;
			});
		}





		function SelectActiveReadState()
		{
			if (fActiveReadState && fActiveReadState.InFocus && !fActiveReadState.Done) return fActiveReadState;
			const Leaves = GetReadableLeavesInFocus();
			fActiveReadState = Leaves.length ? Leaves[0] : null;
			if (fActiveReadState) fActiveReadState.Active = true;
			return fActiveReadState;
		}





		function CheckReading()
		{
			const Now = Date.now();
			const DeltaMs = Math.min(1000, Math.max(0, Now - fLastReadTickAt));
			fLastReadTickAt = Now;
			UpdateReadFocusStates(Now);
			const State = SelectActiveReadState();
			if (!State) return;
			State.AccumMs += DeltaMs;
			if (State.AccumMs >= State.QuickMs) State.QuickCandidate = true;
			if (State.AccumMs >= State.FullMs)
			{
				State.Active = false;
				TrackReadEvent(State, "read_full", Now, "full");
				fActiveReadState = null;
				SelectActiveReadState();
			}
		}





		function CheckVisibleViews()
		{
			CheckReading();
		}





		function CheckViewElement(pElem)
		{
			if (pElem) RegisterReadElement(pElem, GetWidgetName(pElem));
			BuildReadHierarchy();
			CheckReading();
		}





		function FlushPendingReadEvents()
		{
			const Now = Date.now();
			cReadTargets.forEach((pState) =>
				{
					if (pState.InFocus) FinishReadCycleOnExit(pState, Now);
			});
		}





		function GetWidgetName(pElem)
		{
			if (!pElem) return "";
			if (pElem.dataset?.opsWidget) return pElem.dataset.opsWidget;
			const Classes = Array.from(pElem.classList || []);
			return Classes.find((pClass) => /^(Emo|Price|Faq|Hero|FreeHero|ReadAlso|Related|RelService|Gallery|Card|Rating|Contact|Partner|Pipeline|Coverage|Stats)/.test(pClass)) || pElem.tagName.toLowerCase();
		}





		function GetClosestWidget(pElem)
		{
			return GetScopeElement(pElem) || pElem;
		}





		function GetOnceStore()
		{
			const Key = `${cOncePrefix}${GetPageInstanceId()}`;
			try
			{
				return {
					Key,
					Values: new Set(JSON.parse(sessionStorage.getItem(Key) || "[]"))
				};
			} catch {
				return { Key, Values: new Set() };
			}
		}





		function SaveOnceStore(pStore)
		{
			try
			{
				sessionStorage.setItem(pStore.Key, JSON.stringify(Array.from(pStore.Values)));
			} catch {}
		}





		function GetReplaySelector(pElem)
		{
			if (!pElem || !(pElem instanceof Element)) return "";
			if (pElem.id) return "#" + CSS.escape(pElem.id);
			const Parts = [];
			let Elem = pElem;
			let Depth = 0;
			while (Elem && Elem.nodeType === 1 && Elem !== document.body && Depth < 5)
			{
				let Name = Elem.tagName.toLowerCase();
				if (Elem.classList && Elem.classList.length)
				{
					Name += "." + Array.from(Elem.classList).slice(0, 2).map((Item) => CSS.escape(Item)).join(".");
				}
				const Parent = Elem.parentElement;
				if (Parent)
				{
					const Siblings = Array.from(Parent.children).filter((Item) => Item.tagName === Elem.tagName);
					if (Siblings.length > 1) Name += ":nth-of-type(" + (Siblings.indexOf(Elem) + 1) + ")";
				}
				Parts.unshift(Name);
				Elem = Parent;
				Depth += 1;
			}
			return Parts.join(" > ");
		}





		function GetPointerExtra(pEvent)
		{
			if (!pEvent) return {};
			return {
				pointerClientX: Number.isFinite(pEvent.clientX) ? Math.round(pEvent.clientX) : "",
				pointerClientY: Number.isFinite(pEvent.clientY) ? Math.round(pEvent.clientY) : "",
				pointerPageX: Number.isFinite(pEvent.pageX) ? Math.round(pEvent.pageX) : "",
				pointerPageY: Number.isFinite(pEvent.pageY) ? Math.round(pEvent.pageY) : "",
				targetSelector: GetReplaySelector(pEvent.target),
				targetText: Shorten(pEvent.target && pEvent.target.textContent ? pEvent.target.textContent : "", 80)
			};
		}





		function IsFocusLifecycleDebugEvent(pEventType)
		{
			const Type = String(pEventType || "").trim().toLowerCase();
			return Type === "page_focus_away"
			|| Type === "page_focus_return"
			|| Type === "page_exit";
		}





		function FocusLifecycleTrackerState()
		{
			return {
				pageOpenSent: fPageOpenSent,
				pageExitSent: fPageExitSent,
				pageInstanceId: fPageInstanceId,
				awayStartedAt: fAwayStartedAt,
				awayReason: fAwayReason,
				externalActionUntil: fExternalActionUntil,
				pageElapsedMs: Math.round(GetPageElapsedMs()),
				sessionElapsedMs: Math.round(GetSessionElapsedMs()),
				retryQueueCount: ReadRetryQueue().length
			};
		}





		function ReportFocusLifecycleDebug(pEventType, pEventData, pNativeEvent, pStage, pResult = null)
		{
			if (!window.EmoFocusLifecycleDebug?.Enabled) return "";
			return window.EmoFocusLifecycleDebug.Report({
				source: "OpsVisitTracker",
				eventType: pEventType,
				stage: pStage,
				eventData: pEventData,
				nativeEvent: pNativeEvent,
				trackerState: FocusLifecycleTrackerState(),
