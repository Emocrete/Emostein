		function TrackAnalyticsReadEvent(pState, pEventType)
		{
			const Analytics = window.EmoAnalytics;
			if (!Analytics || typeof Analytics.GetItemName !== "function" || typeof Analytics.TrackTemplate !== "function") return;
			const ElementId = String(pState.Elem?.id || "").trim();
			if (!ElementId) return;
			const ItemName = Analytics.GetItemName(pState.Elem);
			if (!ItemName) return;
			const IsFullRead = pEventType === "read_full";
			const IsServicEmoSection = pState.Elem?.matches?.('.EmoSection[data-ga-service="true"]') === true;
			const Prefix = IsServicEmoSection
			? (IsFullRead ? "Srv" : "SrvQ")
			: (IsFullRead ? "R" : "RQ");
			Analytics.TrackTemplate(Prefix, ItemName);
		}





		function TrackReadEvent(pState, pEventType, pTime, pMode)
		{
			TrackAnalyticsReadEvent(pState, pEventType);
			const WidgetName = pState.Widget || GetWidgetName(pState.Elem);
			const ReadTitle = pState.Label || BuildViewLabel(pState.Elem);
			const ReadableText = String(pState.Text || "");
			const BodyText = Shorten(ReadableText, 420);
			ReadDebugRecordEvent(pState, pEventType, pTime, pMode, Boolean(BodyText));
			const ReadEventData = {
				readTitle: ReadTitle,
				readableText: ReadableText,
				readable: IsReadableBoundary(pState.Elem),
				id: String(pState.Elem?.id || ""),
				selector: GetReplaySelector(pState.Elem),
				tag: String(pState.Elem?.tagName || "").toLowerCase(),
				label: ReadTitle
			};
			if (BodyText)
			{
				TrackOpsEvent(pEventType, {
						eventOn: "read_body",
						widget: WidgetName,
						label: BodyText,
						labelMax: 420,
						value: pState.WordCount,
						durationMs: Math.round(pState.AccumMs),
						awayReason: `${pMode || ""}:body`,
						eventData: ReadEventData
				});
			}
			TrackOpsEvent(pEventType, {
					eventOn: "read",
					widget: WidgetName,
					label: ReadTitle,
					value: pState.WordCount,
					durationMs: Math.round(pState.AccumMs),
					awayReason: pMode || "",
					eventData: ReadEventData
			});
			if (pEventType === "read_full")
			{
				pState.FullDone = true;
				pState.Done = true;
				pState.FullAt = pTime;
				pState.QuickCandidate = false;
				CheckParentReadCompletion(pState.Parent, pTime);
			}
		}





		function IsReadRelevantState(pState)
		{
			if (!pState) return false;
			if (pState.WordCount > 0) return true;
			return pState.Children.some((pChild) => IsReadRelevantState(pChild));
		}





		function CheckParentReadCompletion(pParent, pTime)
		{
			if (!pParent || pParent.FullDone || !pParent.Children.length) return;
			const RequiredChildren = pParent.Children.filter((pChild) => IsReadRelevantState(pChild));
			if (!RequiredChildren.length) return;
			const AllChildrenFull = RequiredChildren.every((pChild) => pChild.FullAt > pParent.ResetAt);
			if (!AllChildrenFull) return;
			pParent.AccumMs = RequiredChildren.reduce((pSum, pChild) => pSum + (pChild.FullMs || pChild.AccumMs || 0), 0);
			pParent.WordCount = RequiredChildren.reduce((pSum, pChild) => pSum + (pChild.WordCount || 0), 0) || pParent.WordCount;
			TrackReadEvent(pParent, "read_full", pTime, "children_complete");
		}





		function UpdateReadFocusStates(pTime)
		{
			cReadTargets.forEach((pState) =>
				{
					const WasInFocus = pState.InFocus;
					const NowInFocus = IsReadableVisible(pState.Elem);
					if (NowInFocus && !WasInFocus) StartReadCycle(pState, pTime);
					if (!NowInFocus && WasInFocus) FinishReadCycleOnExit(pState, pTime);
					pState.InFocus = NowInFocus;
			});
		}





		function SelectActiveReadState()
		{
			const Leaves = GetReadableLeavesInFocus();
			const NextState = Leaves.length ? Leaves[0] : null;
			if (fActiveReadState && fActiveReadState !== NextState) fActiveReadState.Active = false;
			fActiveReadState = NextState;
			if (fActiveReadState) fActiveReadState.Active = true;
			return fActiveReadState;
		}





		function CheckReading()
		{
			const Now = Date.now();
			const DeltaMs = Math.min(1000, Math.max(0, Now - fLastReadTickAt));
			fLastReadTickAt = Now;
			UpdateReadFocusStates(Now);
			const State = SelectActiveReadState();
			if (!State)
			{
				UpdateReadDebugOverlay(Now);
				return;
			}
			State.AccumMs += DeltaMs;
			if (State.AccumMs >= State.QuickMs) State.QuickCandidate = true;
			if (State.AccumMs >= State.FullMs)
			{
				State.Active = false;
				TrackReadEvent(State, "read_full", Now, "full");
				fActiveReadState = null;
				SelectActiveReadState();
			}
			UpdateReadDebugOverlay(Now);
		}





