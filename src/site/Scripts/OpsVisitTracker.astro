					focusDebugEvent: pNativeEvent
			});
		}





		function TrackPageReturn(pReason, pNativeEvent = null)
		{
			if (fPageExitSent) return;
			fExternalActionUntil = 0;
			if (!fPageOpenSent)
			{
				TrackPageOpen();
				return;
			}
			if (!fAwayStartedAt) return;
			const StartedAt = fAwayStartedAt;
			const AwayReason = fAwayReason;
			fAwayStartedAt = 0;
			fAwayReason = "";
			const DurationMs = Date.now() - StartedAt;
			if (DurationMs < cFocusAwayMinMs) return;
			TrackOpsEvent("page_focus_return", {
					eventOn: String(pReason || "focus"),
					widget: "Page",
					label: `رجع للصفحة بعد ${FormatDuration(DurationMs)}`,
					value: Math.round(DurationMs / 1000),
					durationMs: DurationMs,
					awayReason: AwayReason,
					focusState: "visible",
					useBeacon: true,
					important: false,
					notifyMobile: false,
					sound: false,
					focusDebugEvent: pNativeEvent
			});
		}





		function InitFocusAwayEvents()
		{
			window.addEventListener("blur", (pEvent) => MarkPageAway("blur", pEvent));
			window.addEventListener("focus", (pEvent) => TrackPageReturn("focus", pEvent));
		}





		function TrackPageAlive()
		{
			if (!fPageOpenSent || fPageExitSent) return;
			const Hidden = !document.hasFocus();
			if (Hidden && !fAwayStartedAt) MarkPageAway("focus_ping");
			TrackOpsEvent("page_alive", {
					eventOn: Hidden ? "heartbeat_hidden" : "heartbeat",
					widget: "Page",
					label: Hidden ? "الصفحة ما زالت مفتوحة خارج التركيز" : "الصفحة ما زالت مفتوحة",
					value: GetScrollPercent(),
					durationMs: Math.round(GetPageElapsedMs()),
					awayReason: Hidden ? (fAwayReason || "hidden") : "",
					focusState: Hidden ? "away" : "visible",
					allowBeforeOpen: true,
					useBeacon: Hidden,
					notifyMobile: false,
					sound: false
			});
		}





		function TrackPageExit(pReason, pNativeEvent = null)
		{
			if (!fPageOpenSent) return;
			if (fPageExitSent) return;
			const Reason = String(pReason || "pagehide");
			if (Date.now() < fExternalActionUntil && (Reason === "pagehide" || Reason === "beforeunload"))
			{
				MarkPageAway("external_action", pNativeEvent);
				return;
			}
			FlushPendingReadEvents();
			fPageExitSent = true;
			fAwayStartedAt = 0;
			fAwayReason = "";
			if (fPagePingTimer)
			{
				clearInterval(fPagePingTimer);
				fPagePingTimer = 0;
			}
			TrackOpsEvent("page_exit", {
					eventOn: String(pReason || "pagehide"),
					widget: "Page",
					label: "غادر الصفحة",
					value: GetScrollPercent(),
					durationMs: Math.round(GetPageElapsedMs()),
					awayReason: String(pReason || "pagehide"),
					focusState: "closed",
					allowBeforeOpen: true,
					useBeacon: true,
					focusDebugEvent: pNativeEvent
			});
		}





		function InitPageLiveEvents()
		{
			if (fPagePingTimer) clearInterval(fPagePingTimer);
			fPagePingTimer = window.setInterval(TrackPageAlive, cPagePingMs);
			window.addEventListener("pagehide", (pEvent) => TrackPageExit("pagehide", pEvent));
			window.addEventListener("beforeunload", (pEvent) => TrackPageExit("beforeunload", pEvent));
			window.addEventListener("pageshow", (pEvent) =>
				{
					fExternalActionUntil = 0;
					if (!fPageExitSent || !pEvent.persisted) return;
					fPageExitSent = false;
					fAwayStartedAt = Date.now() - cFocusAwayMinMs;
					fAwayReason = "pagehide";
					TrackPageReturn("pageshow", pEvent);
					if (fPagePingTimer) clearInterval(fPagePingTimer);
					fPagePingTimer = window.setInterval(TrackPageAlive, cPagePingMs);
					TrackPageAlive();
			});
			window.addEventListener("freeze", (pEvent) =>
				{
					MarkPageAway("freeze", pEvent);
					TrackPageAlive();
			});
			setTimeout(TrackPageAlive, 1000);
		}





		function ResetPreQualificationReadState()
		{
			fActiveReadState = null;
			fFocusedFaqReadState = null;
			fLastReadTickAt = Date.now();
			cReadTargets.forEach((pState) =>
				{
					pState.InFocus = false;
					pState.Active = false;
					pState.Done = false;
					pState.QuickCandidate = false;
					pState.QuickDone = false;
					pState.FullDone = false;
					pState.AccumMs = 0;
					pState.Cycle = 0;
					pState.FullAt = 0;
					pState.ResetAt = 0;
				});
			CheckReading();
		}




		function ClearVisitQualification()
		{
			if (fVisitQualificationTimer)
			{
				clearTimeout(fVisitQualificationTimer);
				fVisitQualificationTimer = 0;
			}
			if (!fVisitQualificationBound) return;
			fVisitQualificationBound = false;
			document.removeEventListener("pointerdown", OnVisitQualificationInput, true);
			document.removeEventListener("keydown", OnVisitQualificationInput, true);
			document.removeEventListener("touchstart", OnVisitQualificationInput, true);
			document.removeEventListener("wheel", OnVisitQualificationInput, true);
			window.removeEventListener("focus", OnVisitQualificationFocus, true);
		}




		function BlockCurrentTracking(pReason)
		{
			fTrackingBlocked = true;
			ClearVisitQualification();
			window.__EMO_OPS_TRAFFIC_ALLOWED__ = false;
			window.__EMO_OPS_PAGE_OPENED__ = false;
			if (fPagePingTimer)
			{
				clearInterval(fPagePingTimer);
				fPagePingTimer = 0;
			}
			PublishTrackingDecision(false, String(pReason || "server_synthetic_traffic"));
		}




		function QualifyVisit(pReason)
		{
			if (fTrackingBlocked || fPageOpenSent || fPageOpenPromise) return fPageOpenPromise;
			if (!document.hasFocus()) return Promise.resolve({ ok: true, skipped: true, reason: "page_not_focused" });
			fVisitQualificationReason = String(pReason || "qualified").trim() || "qualified";
			return TrackPageOpen(fVisitQualificationReason);
		}




		function OnVisitQualificationInput(pEvent)
		{
			if (!pEvent || pEvent.isTrusted !== true) return;
			QualifyVisit(`trusted_${String(pEvent.type || "input")}`);
		}




		function OnVisitQualificationFocus()
		{
			if (Date.now() - fPageStartedAt < cVisitQualificationMs) return;
			QualifyVisit("focused_after_dwell");
		}




		function InitVisitQualification()
		{
			if (fVisitQualificationBound || fPageOpenSent || fTrackingBlocked) return;
			fVisitQualificationBound = true;
			document.addEventListener("pointerdown", OnVisitQualificationInput, { capture: true, passive: true });
			document.addEventListener("keydown", OnVisitQualificationInput, { capture: true });
			document.addEventListener("touchstart", OnVisitQualificationInput, { capture: true, passive: true });
			document.addEventListener("wheel", OnVisitQualificationInput, { capture: true, passive: true });
			window.addEventListener("focus", OnVisitQualificationFocus, true);
			const RemainingMs = Math.max(0, cVisitQualificationMs - (Date.now() - fPageStartedAt));
			fVisitQualificationTimer = window.setTimeout(() =>
				{
					fVisitQualificationTimer = 0;
					if (document.hasFocus()) QualifyVisit("focused_dwell");
				}, RemainingMs);
		}




		function TrackPageOpen(pQualificationReason = "qualified")
		{
			if (fPageOpenSent || fPageOpenPromise) return fPageOpenPromise;
			if (IsSyntheticTraffic()) return Promise.resolve({ ok: true, skipped: true, reason: "synthetic_traffic" });
			if (!document.hasFocus()) return Promise.resolve({ ok: true, skipped: true, reason: "page_not_focused" });
			const QualifiedAt = Date.now();
			const QualificationReason = String(pQualificationReason || fVisitQualificationReason || "qualified").trim() || "qualified";
			fPageOpenPromise = TrackOpsEventOnce("page_open", "page_open", {
					eventOn: "load",
					widget: "Page",
					label: CleanText(document.title),
					important: true,
					notifyMobile: true,
					sound: true,
					createdAtClient: new Date(fPageStartedAt).toISOString(),
					pageElapsedMs: 0,
					eventData: {
						replayAvailable: window.__EMO_REPLAY_RECORDER__ === true,
						viewportWidth: window.innerWidth || document.documentElement.clientWidth || 0,
						viewportHeight: window.innerHeight || document.documentElement.clientHeight || 0,
						pageUrl: `${location.pathname}${location.search}${location.hash}`,
						trafficGateDelayMs: Math.max(0, Number(fTrafficGateDiagnostics?.durationMs) || 0),
						preTrackingDelayMs: Math.max(0, fPageStartedAt - cTrackerLoadedAt),
						trackerLoadedAtClient: new Date(cTrackerLoadedAt).toISOString(),
						trackingStartedAtClient: new Date(fPageStartedAt).toISOString(),
						qualifiedAtClient: new Date(QualifiedAt).toISOString(),
						visitQualification: {
							reason: QualificationReason,
							thresholdMs: cVisitQualificationMs,
							delayMs: Math.max(0, QualifiedAt - fPageStartedAt)
						},
						replayCaptureStartsAfterPageOpen: true,
						clientDiagnostics: fClientDiagnostics,
						trafficGate: fTrafficGateDiagnostics,
						locationResolution: fLocationResolution
					}
			}).then((Result) =>
				{
					const Accepted = Result && Result.ok && Result.skipped !== true && Result.ignored !== true && Result.blocked !== true;
					if (Accepted)
					{
						fPageOpenSent = true;
						ClearVisitQualification();
						ResetPreQualificationReadState();
						window.__EMO_OPS_PAGE_OPENED__ = true;
						if (fPendingLocationUpdateReason)
						{
							const PendingReason = fPendingLocationUpdateReason;
							fPendingLocationUpdateReason = "";
							EmitLocationUpdate(PendingReason);
						}
						window.dispatchEvent(new CustomEvent("emo:ops-page-open", { detail: window.__EmoOpsIds }));
						StartLocationEnhancement();
						setTimeout(FlushRetryQueue, 1500);
					}
					else if (Result && (Result.blocked === true || Result.ignored === true))
					{
						BlockCurrentTracking(`server_${String(Result.reason || "synthetic_traffic")}`);
					}
					return Result;
			}).finally(() =>
				{
					fPageOpenPromise = null;
			});
			return fPageOpenPromise;
		}




		function HasExplicitVideoTracking(pElem)
		{
			return !!(pElem && (pElem.dataset.opsTrackVideo === "1" || pElem.closest("[data-ops-track-video='1']")));
		}





		function HasExplicitVideoIgnore(pElem)
		{
			return !!(pElem && (pElem.dataset.opsIgnoreVideo === "1" || pElem.closest("[data-ops-ignore-video='1'], [data-background-video], [data-bg-video], .background-video, .bg-video, .hero-video, .video-bg, .decorative-video, .decor-video")));
		}





		function IsTrackableContentVideo(pVideo)
		{
			if (!pVideo) return false;
			if (HasExplicitVideoTracking(pVideo)) return true;
			if (HasExplicitVideoIgnore(pVideo)) return false;
			if (!pVideo.controls) return false;
			if (pVideo.autoplay || pVideo.loop) return false;
			const Source = String(pVideo.currentSrc || pVideo.getAttribute("src") || "").toLowerCase();
			if (/([?&](autoplay|loop|background|muted?)=1)|(^|[?&])playlist=/.test(Source)) return false;
			if (pVideo.muted && !pVideo.controls) return false;
			return true;
		}





		function IsTrackableVideoFrame(pFrame)
		{
			if (!pFrame) return false;
			if (HasExplicitVideoTracking(pFrame)) return true;
			if (HasExplicitVideoIgnore(pFrame)) return false;
			const Source = String(pFrame.getAttribute("src") || "").toLowerCase();
			if (!/(youtube\.com|youtu\.be|youtube-nocookie\.com|vimeo\.com)/.test(Source)) return false;
			if (/([?&]controls=0)|([?&](autoplay|loop|background|muted?)=1)/.test(Source)) return false;
			return true;
		}





		function HasRecentUserVideoIntent(pElem)
		{
			const IntentAt = Number(pElem?.dataset?.opsUserVideoIntentAt || "0");
			return !!IntentAt && Date.now() - IntentAt <= 3500;
		}





		function InitVideoEvents()
		{
			document.querySelectorAll("video").forEach((pVideo, pIndex) =>
				{
					if (pVideo.dataset.opsVideoBound === "1") return;
					pVideo.dataset.opsVideoBound = "1";
					pVideo.dataset.opsUserVideoIntentAt = "0";
					const MarkVideoIntent = () =>
					{
						pVideo.dataset.opsUserVideoIntentAt = String(Date.now());
					};
					pVideo.addEventListener("pointerdown", MarkVideoIntent, { passive: true });
					pVideo.addEventListener("click", MarkVideoIntent, { passive: true });
					pVideo.addEventListener("keydown", MarkVideoIntent, { passive: true });
					pVideo.addEventListener("play", () =>
						{
							if (!IsTrackableContentVideo(pVideo)) return;
							if (!HasExplicitVideoTracking(pVideo) && !HasRecentUserVideoIntent(pVideo)) return;
							const Source = pVideo.currentSrc || pVideo.getAttribute("src") || "";
							const Title = pVideo.getAttribute("title") || pVideo.getAttribute("aria-label") || pVideo.dataset.opsLabel || BuildViewLabel(GetClosestWidget(pVideo)) || Source || `Video ${pIndex + 1}`;
							TrackOpsEvent("video_play", {
									eventOn: "video_player",
									widget: "VideoPlayer",
									label: Title,
									href: Source,
									important: true,
									notifyMobile: false,
									sound: false
							});
						}, { passive: true });
			});
			document.querySelectorAll("iframe[src*='youtube'], iframe[src*='youtu.be'], iframe[src*='youtube-nocookie'], iframe[src*='vimeo']").forEach((
					pFrame,
					pIndex
				) =>
				{
					if (pFrame.dataset.opsVideoBound === "1") return;
					pFrame.dataset.opsVideoBound = "1";
					pFrame.addEventListener("pointerdown", () =>
						{
							if (!IsTrackableVideoFrame(pFrame)) return;
							const Source = pFrame.getAttribute("src") || "";
							const Title = pFrame.getAttribute("title") || pFrame.dataset.opsLabel || BuildViewLabel(GetClosestWidget(pFrame)) || Source || `Video ${pIndex + 1}`;
							TrackOpsEvent("video_play", {
									eventOn: "video_player",
									widget: "VideoPlayer",
									label: Title,
									href: Source,
									important: true,
									notifyMobile: false,
									sound: false
							});
						}, { passive: true });
			});
		}





		async function InitOps()
		{
			if (IsSyntheticTraffic())
			{
				PublishTrackingDecision(false, "client_synthetic_traffic");
				return;
			}
			if (!(await TrafficAllowed()))
			{
				PublishTrackingDecision(false, "traffic_gate_denied");
				return;
			}
			PublishTrackingDecision(true, "traffic_gate_allowed");
			fClientDiagnostics = await CollectClientDiagnostics();
			if (IsSyntheticTraffic())
			{
				PublishTrackingDecision(false, "client_synthetic_fingerprint");
				return;
			}
			fPageStartedAt = Date.now();
			GetVisitorId();
			GetSessionId();
			GetPageInstanceId();
			GetSessionStartedAt();
			PublishVisitIds();
			InitClarityIdentifiers();
			window.addEventListener("online", FlushRetryQueue);
			window.TrackOpsEvent = TrackOpsEvent;
			window.TrackOpsEventBatch = TrackOpsEventBatch;
			window.TrackOpsEventOnce = TrackOpsEventOnce;
			window.EmoOpsTrackEvent = TrackOpsEvent;
			window.__EMO_OPS_TRAFFIC_ALLOWED__ = true;
			window.__EMO_OPS_TRACKING_STARTED_AT__ = fPageStartedAt;
			window.dispatchEvent(new CustomEvent("emo:ops-traffic-ready", { detail: { ids: window.__EmoOpsIds, trafficGate: fTrafficGateDiagnostics, trackingStartedAt: fPageStartedAt } }));
			InitViewObserver();
			InitDeclarativeEvents();
			InitToggleEvents();
			InitClickEvents();
			InitFormEvents();
			InitVideoEvents();
			InitAutoViews();
			InitReadTracking();
			InitScrollMilestones();
			InitContinuousReplayEvents();
			InitFocusAwayEvents();
			InitPageLiveEvents();
			InitVisitQualification();
		}





		// ==================== Execution Logic ====================

		if (cReplayParams.has("emoNoAnalytics"))
		{
			try
			{
				sessionStorage.setItem("emo_no_analytics_v1", "1");
			}catch {}
		}

		try
		{
			fNoAnalytics = sessionStorage.getItem("emo_no_analytics_v1") === "1";
		}catch {}

		if (window.__EMO_REPLAY__ || fNoAnalytics || cReplayParams.has("emoReplay") || cReplayParams.has("emo_replay")) return;

		if (window.__EMO_OPS_TRACKER_ACTIVE__) return;

		window.__EMO_OPS_TRACKER_ACTIVE__ = true;

		if (document.readyState === "loading")
		{
			document.addEventListener("DOMContentLoaded", InitOps, { once: true });
		} else {
			InitOps();
		}
	})();
</script>
