					const ReverseSources = [];
					if (BigData)
					{
						const BigCity = String(BigData.city || "").trim();
						const BigLocality = String(BigData.locality || "").trim();
						const Source = { source: "browser_geolocation_bigdatacloud", type: "device", countryCode: BigData.countryCode, country: BigData.countryName, region: BigData.principalSubdivision, regionCode: BigData.principalSubdivisionCode, city: BigCity || BigLocality, locality: BigLocality, area: BigLocality && GeoNorm(BigLocality) !== GeoNorm(BigCity) ? BigLocality : "", areaType: BigLocality && GeoNorm(BigLocality) !== GeoNorm(BigCity) ? "locality" : "", postal: BigData.postcode, latitude: Latitude, longitude: Longitude, accuracyMeters: Accuracy, timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "" };
						ReverseSources.push(Source.source);
						Changed = AddOrReplaceLocationSource(Source, "device_bigdatacloud") || Changed;
					}
					if (Nominatim)
					{
						const Address = Nominatim.address && typeof Nominatim.address === "object" ? Nominatim.address : {};
						const City = String(Address.city || Address.town || Address.village || Address.municipality || "").trim();
						const Area = String(Address.neighbourhood || Address.suburb || Address.city_district || Address.quarter || "").trim();
						const Region = String(Address.state || Address.governorate || Address.county || "").trim();
						const Source = { source: "browser_geolocation_nominatim", type: "device", countryCode: String(Address.country_code || "").toUpperCase(), country: Address.country || "", region: Region, city: City, locality: Area, area: Area, areaType: Area ? (Address.neighbourhood ? "neighbourhood" : Address.suburb ? "suburb" : Address.city_district ? "district" : "quarter") : "", postal: Address.postcode || "", latitude: Latitude, longitude: Longitude, accuracyMeters: Accuracy, timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "" };
