						return;
					}
					fDeviceGeoDiagnostics = { attempted: true, status: "requesting_position", permission: fGeoPermission, trigger: String(pTrigger || ""), startedAt: new Date().toISOString() };
					const Result = await GetCurrentDevicePosition();
					if (!Result?.position?.coords)
					{
						fDeviceGeoDiagnostics = { ...fDeviceGeoDiagnostics, status: "position_failed", errorCode: Number(Result?.error?.code) || 0, error: String(Result?.error?.message || "") };
