						const Source = { source: "browser_geolocation_nominatim", type: "device", countryCode: String(Address.country_code || "").toUpperCase(), country: Address.country || "", region: Region, city: Locality, locality: Locality, postal: Address.postcode || "", latitude: Latitude, longitude: Longitude, accuracyMeters: Accuracy, timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "" };
						ReverseSources.push(Source.source);
