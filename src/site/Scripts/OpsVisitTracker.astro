		async function TrafficAllowed()
		{
			const StartedAt = Date.now();
			window.__EMO_OPS_TRAFFIC_GATE__ = { status: "pending", startedAtClient: new Date(StartedAt).toISOString() };
			try
			{
				const Res = await fetch(`${cTrafficGateUrl}?phase=gate`, { method: "GET", headers: { accept: "application/json" }, cache: "no-store" });
				const Data = await Res.json();
				const CompletedAt = Date.now();
				const ExplicitDenied = Res.ok && Data?.track === false;
				const Allowed = ExplicitDenied ? false : true;
				fTrafficGateDiagnostics = {
					status: ExplicitDenied ? "denied" : (Res.ok ? "allowed" : "fail_open"),
					startedAtClient: new Date(StartedAt).toISOString(),
					completedAtClient: new Date(CompletedAt).toISOString(),
					durationMs: Math.max(0, CompletedAt - StartedAt),
					httpStatus: Res.status,
					track: Allowed,
					reason: String(Data?.reason || (Res.ok ? "accepted" : "traffic_gate_http_fail_open")).trim(),
					server: Data?.diagnostics && typeof Data.diagnostics === "object" ? Data.diagnostics : null
				};
				window.__EMO_OPS_TRAFFIC_GATE__ = fTrafficGateDiagnostics;
				const ServerSources = Array.isArray(fTrafficGateDiagnostics?.server?.geoSources) ? fTrafficGateDiagnostics.server.geoSources : [];
				fLocationSources = ServerSources.map((Item) => GeoSourceView({ ...Item, type: "ip" })).filter(Boolean);
				ApplyLocationResolution("traffic_gate_ip_sources");
				return !ExplicitDenied;
			} catch (Error)
			{
				const CompletedAt = Date.now();
				fTrafficGateDiagnostics = {
					status: "fail_open",
					startedAtClient: new Date(StartedAt).toISOString(),
					completedAtClient: new Date(CompletedAt).toISOString(),
					durationMs: Math.max(0, CompletedAt - StartedAt),
					track: true,
					reason: "traffic_gate_error_fail_open",
					error: String(Error?.message || Error || "")
				};
				window.__EMO_OPS_TRAFFIC_GATE__ = fTrafficGateDiagnostics;
				return true;
			}
		}





