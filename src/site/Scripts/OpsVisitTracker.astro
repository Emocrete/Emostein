		function EnqueueRetry(pBody)
		{
			if (!pBody) return false;
			if (pBody.eventType === "page_alive" && !(pBody.eventData && pBody.eventData.locationUpdate === true)) return false;
			if (fQueueFlushRunning)
			{
				if (!fRetryDuringFlush.some((Item) => Item?.clientEventUid === pBody.clientEventUid)) fRetryDuringFlush.push(pBody);
				return true;
			}
			const Queue = ReadRetryQueue();
			if (!Queue.some((Item) => Item && Item.clientEventUid === pBody.clientEventUid)) Queue.push(pBody);
			return SaveRetryQueue(Queue);
		}





		async function SendFetchPayload(pBody)
		{
			try
			{
				const JsonBody = JSON.stringify(pBody);
				const Res = await fetch(cApiUrl, {
						method: "POST",
						headers: { "content-type": "application/json" },
						body: JsonBody,
						keepalive: JsonBody.length < 60000
				});
				let Data = {};
				try
				{
					Data = await Res.json();
				}catch {}
				return { ok: Res.ok && Data.ok !== false, status: Res.status,...Data };
			} catch { return { ok: false, networkError: true }; }
		}





		async function FlushRetryQueue()
		{
			if (fQueueFlushRunning || !navigator.onLine || !fPageOpenSent || IsSyntheticTraffic()) return;
			fQueueFlushRunning = true;
			try
			{
				const Queue = ReadRetryQueue();
				const Remaining = [];
				for (let Index = 0; Index < Queue.length; Index += 500)
				{
					const Batch = Queue.slice(Index, Index + 500);
					const Result = await SendFetchPayload({ events: Batch });
					if (!Result.ok) Remaining.push(...Batch);
				}
				for (const Body of fRetryDuringFlush)
				{
					if (!Remaining.some((Item) => Item?.clientEventUid === Body?.clientEventUid)) Remaining.push(Body);
				}
				fRetryDuringFlush = [];
				SaveRetryQueue(Remaining);
			} finally { fQueueFlushRunning = false; }
		}





		async function SendOpsPayload(pBody, pPreferBeacon)
		{
			if (pPreferBeacon && navigator.sendBeacon)
			{
				try
				{
					const Accepted = navigator.sendBeacon(cApiUrl, new Blob([JSON.stringify(pBody)], { type: "application/json" }));
					if (Accepted) return { ok: true, beacon: true };
				} catch {}
			}
			const Result = await SendFetchPayload(pBody);
			if (Result.ok) return Result;
			const Queued = EnqueueRetry(pBody);
			return Queued ? {...Result, ok: true, queued: true } : Result;
		}





		function BuildOpsPayload(pEventType, pOptions =
