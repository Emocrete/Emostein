		function BrowserAutomationSignal()
		{
			const Diagnostics = fClientDiagnostics;
			if (!Diagnostics || typeof Diagnostics !== "object") return "";
			const Hardware = Number(Diagnostics.hardwareConcurrency || 0);
			const DeviceMemory = Number(Diagnostics.deviceMemory || 0);
			const Renderer = String(Diagnostics.webgl?.renderer || "").toLowerCase();
			const SwiftShader = Renderer.includes("swiftshader");
			const EmptyBrowserSurface = Number(Diagnostics.pluginsLength || 0) === 0 && Number(Diagnostics.mimeTypesLength || 0) === 0;
			const UserAgent = String(Diagnostics.userAgent || navigator.userAgent || "");
			const UserAgentData = Diagnostics.userAgentData && typeof Diagnostics.userAgentData === "object" ? Diagnostics.userAgentData : null;
			const UaFamily = UserAgentPlatformFamily(UserAgent);
			const NavigatorFamily = NavigatorPlatformFamily(Diagnostics.platform);
			const UaDataFamily = UserAgentDataPlatformFamily(UserAgentData?.platform);
			const UaChromeMajor = ChromeMajorFromUserAgent(UserAgent);
			const UaDataChromeMajor = ChromeMajorFromUserAgentData(UserAgentData);
			const UaLooksMobile = /iphone|ipad|ipod|android|\bmobile\b/i.test(UserAgent);

			const Reasons = [];
			if (Diagnostics.webdriver === true) Reasons.push("webdriver");
			if (UserAgentDataHasHeadlessBrand(UserAgentData)) Reasons.push("headless_client_hint");
			if (DeviceMemory > 8) Reasons.push("device_memory_impossible");
			if (Hardware >= 256) Reasons.push("hardware_concurrency_extreme");
			if (!IsNavigatorPlatformCompatible(UaFamily, NavigatorFamily)) Reasons.push("ua_navigator_platform_mismatch");
			if (UaDataFamily && UaFamily && UaFamily !== "ios" && UaFamily !== UaDataFamily) Reasons.push("ua_client_hint_platform_mismatch");
			if (UserAgentData && UaLooksMobile && UserAgentData.mobile === false) Reasons.push("mobile_client_hint_mismatch");
			if (UaChromeMajor && UaDataChromeMajor && Math.abs(UaChromeMajor - UaDataChromeMajor) >= 2) Reasons.push("chrome_version_mismatch");
			if (SwiftShader && EmptyBrowserSurface) Reasons.push("swiftshader_empty_browser_surface");
			if (SwiftShader && Hardware >= 64) Reasons.push("swiftshader_high_concurrency");
			return Reasons.join(",");
		}




		function BotSignal()
		{
			const UserAgent = String(navigator.userAgent || "");
			const Reasons = [];
			if (cBotUserAgentPattern.test(UserAgent)) Reasons.push("ua_bot");
			if (navigator.webdriver) Reasons.push("webdriver");
			if (window.callPhantom || window._phantom || window.__nightmare) Reasons.push("headless_marker");
			if (document.visibilityState === "prerender") Reasons.push("prerender");
			const ReferrerSignal = ReferrerAutomationSignal();
			if (ReferrerSignal) Reasons.push(ReferrerSignal);
			const BrowserSignal = BrowserAutomationSignal();
			if (BrowserSignal) Reasons.push(BrowserSignal);
			return Reasons.join(",");
		}




