					}
					const Latitude = Number(Result.position.coords.latitude);
					const Longitude = Number(Result.position.coords.longitude);
					const Accuracy = Math.max(0, Number(Result.position.coords.accuracy) || 0);
					fDeviceGeoDiagnostics = { ...fDeviceGeoDiagnostics, status: "position_received", latitude: Latitude, longitude: Longitude, accuracyMeters: Accuracy, timestamp: Number(Result.position.timestamp) || Date.now() };
