		function PositionReadDebugBox(pState, pBox, pQueueIndex, pNow)
		{
			const Elem = pState?.Elem;
			if (!Elem?.isConnected || pQueueIndex < 0)
			{
				pBox.hidden = true;
				return;
			}
			const Rect = Elem.getBoundingClientRect();
			if (!Rect || Rect.width <= 0 || Rect.height <= 0 || Rect.bottom <= 0 || Rect.top >= window.innerHeight)
			{
				pBox.hidden = true;
				return;
			}
			pBox.hidden = false;
			const BoxPadX = 3;
			const BoxPadY = 6;
			const Left = Math.max(0, Rect.left - BoxPadX);
			const Top = Math.max(0, Rect.top - BoxPadY);
			const Right = Math.min(window.innerWidth, Rect.right + BoxPadX);
			const Bottom = Math.min(window.innerHeight, Rect.bottom + BoxPadY);
			pBox.style.left = `${Left}px`;
			pBox.style.top = `${Top}px`;
			pBox.style.width = `${Math.max(1, Right - Left)}px`;
			pBox.style.height = `${Math.max(1, Bottom - Top)}px`;
			pBox.className = "emo-read-debug-box";

			const IsCurrent = pQueueIndex === 0;
			const IsNext = pQueueIndex === 1;
			const AccumMs = Number(pState.AccumMs || 0);
			const Progress = GetReadDebugProgress(pState, AccumMs);
			if (IsCurrent)
			{
				pBox.classList.add(Progress >= 0.5 ? "emo-read-debug-current-full-half" : "emo-read-debug-current-quick-half");
			} else if (IsNext) {
				pBox.classList.add("emo-read-debug-next");
			} else {
				pBox.classList.add("emo-read-debug-later");
			}

			const ShowInfo = IsCurrent || IsNext;
			pBox.__emoCaption.hidden = !ShowInfo;
			pBox.__emoCaption.className = `emo-read-debug-caption ${IsCurrent ? "emo-read-debug-caption-current" : "emo-read-debug-caption-next"}`;
