		function TrackOpsEvent(pEventType, pOptions =
			{
			}) {
			const EventType = String(pEventType || "").trim();
			const DebugLifecycle = IsFocusLifecycleDebugEvent(EventType);
			const NativeEvent = pOptions.focusDebugEvent || null;
			if (!EventType) return Promise.resolve({ ok: false, error: "Missing event type" });
			if (IsSyntheticTraffic())
			{
				const Result = { ok: true, skipped: true, reason: "synthetic_traffic", signal: BotSignal() };
				if (DebugLifecycle) ReportFocusLifecycleDebug(EventType, pOptions, NativeEvent, "skipped", Result);
				return Promise.resolve(Result);
			}
			if (EventType !== "page_open" && !fPageOpenSent && !BoolValue(pOptions.allowBeforeOpen))
			{
				if (fPageOpenPromise)
				{
					return fPageOpenPromise.then(() =>
						{
							if (fPageOpenSent) return TrackOpsEvent(pEventType, pOptions);
							const Result = { ok: true, skipped: true, reason: "page_not_qualified" };
							if (DebugLifecycle) ReportFocusLifecycleDebug(EventType, pOptions, NativeEvent, "skipped", Result);
							return Result;
						});
				}
				const Result = { ok: true, skipped: true, reason: "page_not_qualified" };
				if (DebugLifecycle) ReportFocusLifecycleDebug(EventType, pOptions, NativeEvent, "skipped", Result);
				return Promise.resolve(Result);
			}
			const Body = BuildOpsPayload(EventType, pOptions);
			const IsHiddenNow = document.hidden || document.visibilityState !== "visible";
			const PreferBeacon = BoolValue(pOptions.useBeacon) || (IsHiddenNow && IsLifecycleEvent(EventType)) || EventType === "page_exit";
			const DebugId = DebugLifecycle ? ReportFocusLifecycleDebug(EventType, Body, NativeEvent, "sending") : "";
			const Request = SendOpsPayload(Body, PreferBeacon);
			if (!DebugId) return Request;
			return Request.then(
				(Result) =>
				{
					window.EmoFocusLifecycleDebug?.Complete(DebugId, Result);
					return Result;
				},
				(Error) =>
				{
					window.EmoFocusLifecycleDebug?.Complete(DebugId, { ok: false, error: String(Error?.message || Error) });
					throw Error;
				}
			);
		}




		async function TrackOpsEventBatch(pEvents)
		{
			if (!Array.isArray(pEvents) || !pEvents.length) return { ok: true, skipped: true };
			if (IsSyntheticTraffic()) return { ok: true, skipped: true, reason: "synthetic_traffic" };
			if (!fPageOpenSent && fPageOpenPromise) await fPageOpenPromise;
			if (!fPageOpenSent) return { ok: true, skipped: true, reason: "page_not_qualified" };
			let QueuedAny = false;
			for (let Index = 0; Index < pEvents.length; Index += 500)
			{
				const Items = pEvents.slice(Index, Index + 500);
				const Bodies = Items.map((Item) => BuildOpsPayload(Item?.eventType || Item?.type || "system.event", Item || {}));
				const PreferBeacon = Items.some((Item) => BoolValue(Item?.useBeacon));
				if (PreferBeacon && navigator.sendBeacon)
				{
					try
					{
						const Accepted = navigator.sendBeacon(cApiUrl, new Blob([JSON.stringify({ events: Bodies })], { type: "application/json" }));
						if (Accepted) continue;
					} catch {}
				}
				const Result = await SendFetchPayload({ events: Bodies });
				if (Result.ok) continue;
				let AllQueued = true;
				for (const Body of Bodies) AllQueued = EnqueueRetry(Body) && AllQueued;
				if (!AllQueued) return Result;
				QueuedAny = true;
			}
			return { ok: true, queued: QueuedAny };
		}





		async function TrackOpsEventOnce(pEventType, pOnceKey, pOptions =
			{
		}) {
			const EventType = String(pEventType || "").trim();
			const Store = GetOnceStore();
			const Key = `${pEventType}:${pOnceKey}`;
			if (Store.Values.has(Key)) return { ok: true, skipped: true };
			const Result = await TrackOpsEvent(pEventType, pOptions);
			if (Result && Result.ok && Result.skipped !== true && Result.ignored !== true && Result.blocked !== true)
			{
				Store.Values.add(Key);
				SaveOnceStore(Store);
			}
			return Result;
		}





