			State = {
				Elem: pElem,
				Widget: pWidgetName || GetWidgetName(pElem),
				Label: "",
				Text: "",
				WordCount: 0,
				FullMs: 0,
				QuickMs: 0,
				Parent: null,
				Children: [],
				InFocus: false,
				Active: false,
				Done: false,
				QuickCandidate: false,
				QuickDone: false,
				FullDone: false,
				AccumMs: 0,
				Cycle: 0,
				FullAt: 0,
