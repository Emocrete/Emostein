const cEnabled = cRealHosts.has(Astro.url.hostname.toLowerCase()) && import.meta.env.PUBLIC_EMO_OPS_ENABLED !== "false";
---





{ cEnabled && (

	<script is:inline NoMove>
	
	
	
		(() =>
		{
	
			// ==================== Definitions: Variables & Methods ====================
	
	
	
	
	
			// ==================== Execution Logic ====================
	
			// باقي كود التتبع الموجود حاليًا
		})();
	</script>
) }





<script is:inline>



	(() =>
	{

		// ==================== Definitions: Variables & Methods ====================

		const cReplayParams = new URLSearchParams(location.search);

		let fNoAnalytics = false;

		const cVisitorKey = "emo_ops_visitor_id";

		const cSessionKey = "emo_ops_session_id";

		const cOncePrefix = "emo_ops_once_";

		const cApiUrl = "/api/ops/visit";

		const cTrafficGateUrl = "/api/ops/traffic";

		const cLocationEnrichmentUrl = "/api/ops/traffic?phase=location";

		const cRetryQueueKey = "emo_ops_retry_queue_v3";

		const cSessionSeqKey = "emo_ops_session_seq_v1";

		const cSessionStartedKey = "emo_ops_session_started_at_v1";

		const cViewThreshold = [
			0,
			0.01,
			0.05
		];

		const cViewRootMargin = "0px";

		const cScrollMarks = [
			10,
			20,
			30,
			40,
			50,
			60,
			70,
			80,
			90
		];

		const cReadWordsPerMinute = 200;

		const cReadFocusTopRatio = 0.25;

		const cReadFocusBottomRatio = 0.75;

		const cReadFocusMinRatio = 0.5;

		const cReadTickMs = 250;

		let fPageInstanceId = "";

		const cTrackerLoadedAt = Date.now();

		let fPageStartedAt = cTrackerLoadedAt;

		let fTrafficGateDiagnostics = null;

		let fClientDiagnostics = null;

		let fLocationResolution = null;

		let fLocationSources = [];

		let fGeoPermission = "unknown";

		let fLocationEnhancementStarted = false;

		let fLocationEnrichmentDiagnostics = null;

		let fDeviceGeoDiagnostics = { attempted: false, status: "not_started", permission: "unknown" };

		const cGeoSourceWeights = { vercel: 0.9, ipapi: 1, ipwho: 1, freeipapi: 1.05, iplocationinfo: 0.95, ipinfo: 1.15, maxmind: 1.2, bigdatacloud_ip: 1.1 };

		const cArabCountryCodes = new Set(["EG", "SA", "AE", "KW", "QA", "BH", "OM", "YE", "JO", "LB", "SY", "IQ", "PS", "MA", "DZ", "TN", "LY", "SD", "SO", "DJ", "KM", "MR"]);

		const cFocusAwayMinMs = 1500;

		const cObservedViewElems = new Set();

		const cReadTargets = [];

		const fReadStates = new WeakMap();

		let fSeq = 0;

		let fViewObserver = null;

		let fAwayStartedAt = 0;

		let fAwayReason = "";

		let fLastScrollMark = null;

		let fLastScrollSampleAt = 0;

		let fLastPointerSampleAt = 0;

		let fScrollIdleTimer = 0;

		let fPageExitSent = false;

		let fExternalActionUntil = 0;

		let fPageOpenSent = false;

		let fPageOpenPromise = null;

		let fQueueFlushRunning = false;

		let fRetryDuringFlush = [];

		let fPagePingTimer = 0;

		let fReadTimer = 0;

		let fLastReadTickAt = Date.now();

		let fActiveReadState = null;

		const cPagePingMs = 1500;

		const cBotUserAgentPattern = /(bot|crawl|spider|slurp|googlebot|googleother|bingbot|yandex|baiduspider|duckduckbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|google-inspectiontool|apis-google|adsbot|mediapartners-google|lighthouse|chrome-lighthouse|pagespeed|headlesschrome|puppeteer|playwright|phantomjs|selenium|webdriver|gtmetrix|pingdom|ahrefs|semrush|mj12bot|dotbot|petalbot|screaming frog|sitebulb)/i;





		function NewId(pPrefix)
		{
			const Rand = Math.random().toString(36).slice(2, 10);
			const Time = Date.now().toString(36);
			return `${pPrefix}_${Time}_${Rand}`;
		}





		function StableProfile()
		{
			const Parts = [
				navigator.userAgent || "", navigator.platform || "", navigator.language || "",
				Array.from(navigator.languages || []).join(","), navigator.hardwareConcurrency || 0,
				navigator.deviceMemory || 0, screen.width || 0, screen.height || 0,
				screen.colorDepth || 0, screen.pixelDepth || 0,
				Intl.DateTimeFormat().resolvedOptions().timeZone || ""
			];
			let Hash = 2166136261;
			const Text = Parts.join("|");
			for (let Index = 0; Index < Text.length; Index++)
			{
				Hash ^= Text.charCodeAt(Index);
				Hash = Math.imul(Hash, 16777619);
			}
			return `bp_${(Hash >>> 0).toString(36)}`;
		}





		function GeoNorm(pValue)
		{
			return String(pValue || "").toLowerCase()
				.normalize("NFKD").replace(/[\u0300-\u036f]/g, "")
				.replace(/[\u064B-\u065F\u0670]/g, "").replace(/[إأآ]/g, "ا").replace(/ى/g, "ي").replace(/ة/g, "ه")
				.replace(/[^a-z0-9ا-ي]+/g, " ").replace(/\s+/g, " ").trim();
		}




		function HasGeoWord(pText, pWords)
		{
			const Text = ` ${GeoNorm(pText)} `;
			return pWords.some((pWord) =>
				{
					const Word = GeoNorm(pWord);
					return Word && (Text.includes(` ${Word} `) || (Word.length > 2 && Text.includes(Word)));
		});
		}




		function ClassifyResolvedLocation(pCountryCode, pRegion, pCity)
		{
			const CountryCode = String(pCountryCode || "").trim().toUpperCase();
			const Region = String(pRegion || "").trim();
			const City = String(pCity || "").trim();
			const All = `${City} ${Region}`;
			if (CountryCode === "EG")
			{
				if (HasGeoWord(All, ["c", "cai", "cairo", "al qahirah", "القاهرة", "القاهره", "محافظة القاهرة", "qahira"])) return { band: "cairo", label: City || Region || "Cairo", borderColor: "#00C853" };
				if (HasGeoWord(All, ["gz", "giza", "al jizah", "jizah", "6th of october", "6 october", "october", "sheikh zayed", "الجيزة", "الجيزه", "اكتوبر", "السادس من اكتوبر", "الشيخ زايد"])) return { band: "giza", label: City || Region || "Giza", borderColor: "#00D5FF" };
				return { band: "egypt", label: City || Region || "Egypt", borderColor: "#FFD740" };
			}
			if (cArabCountryCodes.has(CountryCode)) return { band: "arab", label: City || CountryCode || "Arab country", borderColor: "#FF8A00" };
			return { band: "world", label: City || CountryCode || "Outside Arab region", borderColor: "#FF3B30" };
		}




		function GeoSourceView(pSource)
		{
			if (!pSource || typeof pSource !== "object") return null;
			const Latitude = Number(pSource.latitude);
			const Longitude = Number(pSource.longitude);
			return {
				source: String(pSource.source || "").trim(),
				type: String(pSource.type || "ip").trim(),
				countryCode: String(pSource.countryCode || "").trim().toUpperCase(),
				country: String(pSource.country || "").trim(),
				region: String(pSource.region || "").trim(),
				regionCode: String(pSource.regionCode || "").trim(),
				city: String(pSource.city || "").trim(),
				locality: String(pSource.locality || "").trim(),
				postal: String(pSource.postal || "").trim(),
				latitude: Number.isFinite(Latitude) ? Latitude : null,
				longitude: Number.isFinite(Longitude) ? Longitude : null,
				accuracyMeters: Number.isFinite(Number(pSource.accuracyMeters)) ? Math.max(0, Number(pSource.accuracyMeters)) : null,
				accuracyRadiusKm: Number.isFinite(Number(pSource.accuracyRadiusKm)) ? Math.max(0, Number(pSource.accuracyRadiusKm)) : null,
				timezone: String(pSource.timezone || "").trim(),
				asn: String(pSource.asn || "").trim(),
				org: String(pSource.org || "").trim(),
				hostname: String(pSource.hostname || "").trim(),
				networkType: String(pSource.networkType || "").trim(),
				isMobile: pSource.isMobile === true,
				isHosting: pSource.isHosting === true,
				isAnonymous: pSource.isAnonymous === true
			};
		}




		function GeoVoteWeight(pSource)
		{
			let Weight = cGeoSourceWeights[pSource?.source] || 1;
			const BrowserTimezone = String(fClientDiagnostics?.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone || "").trim();
			const SourceTimezone = String(pSource?.timezone || "").trim();
			if (BrowserTimezone && SourceTimezone && BrowserTimezone === SourceTimezone) Weight *= 1.25;
			return Weight;
		}




		function BestGeoVotes(pSources, pField, pCountryCode = "")
		{
			const Votes = new Map();
			for (const Source of pSources)
			{
				if (!Source || Source.type === "device") continue;
				if (pCountryCode && Source.countryCode && Source.countryCode !== pCountryCode) continue;
				const Raw = String(Source[pField] || "").trim();
				const Key = pField === "countryCode" ? Raw.toUpperCase() : GeoNorm(Raw);
				if (!Key) continue;
				const Existing = Votes.get(Key) || { value: Raw, score: 0, sources: [] };
				Existing.score += GeoVoteWeight(Source);
				Existing.sources.push(Source.source);
				Votes.set(Key, Existing);
			}
			return Array.from(Votes.values()).sort((A, B) => B.score - A.score || B.sources.length - A.sources.length);
		}




		function IsLowCityReliabilitySource(pSource)
		{
			if (!pSource) return false;
			if (pSource.isMobile) return true;
			const Text = `${pSource.org || ""} ${pSource.hostname || ""} ${pSource.networkType || ""}`.toLowerCase();
			return /(starlink|spacex|satellite|oneweb|viasat|hughes)/i.test(Text);
		}




		function ResolveIpLocationClient()
		{
			const Sources = fLocationSources.filter((Item) => Item && Item.type !== "device");
			if (!Sources.length) return null;
			const CountryVotes = BestGeoVotes(Sources, "countryCode");
			const CountryVote = CountryVotes[0] || null;
			const CandidateCountryCode = String(CountryVote?.value || "").trim().toUpperCase();
			const RegionVotes = BestGeoVotes(Sources, "region", CandidateCountryCode);
			const CityVotes = BestGeoVotes(Sources, "city", CandidateCountryCode);
			const RegionVote = RegionVotes[0] || null;
			const CityVote = CityVotes[0] || null;
			const CountrySources = CountryVote?.sources || [];
			const CitySources = CityVote?.sources || [];
			const IndependentCountrySources = CountrySources.filter((Name) => Name !== "vercel").length;
			const IndependentCitySources = CitySources.filter((Name) => Name !== "vercel").length;
			const CountryVerified = CountrySources.length >= 2 && IndependentCountrySources >= 1;
			const CityVerified = CountryVerified && CitySources.length >= 2 && IndependentCitySources >= 1;
			const BrowserTimezone = String(fClientDiagnostics?.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone || "").trim();
			const WinnerSources = Sources.filter((Source) => Source.countryCode === CandidateCountryCode);
			const TimezoneSupportSources = WinnerSources.filter((Source) => BrowserTimezone && Source.timezone === BrowserTimezone).map((Source) => Source.source);
			const TimezoneConflictSources = WinnerSources.filter((Source) => BrowserTimezone && Source.timezone && Source.timezone !== BrowserTimezone).map((Source) => Source.source);
			const LowCityReliabilitySources = WinnerSources.filter(IsLowCityReliabilitySource).map((Source) => Source.source);

			if (!CountryVerified)
			{
				return {
					method: "ip_unverified",
					sourceType: "ip",
					confidence: "low",
					countryCode: "", region: "", city: "", band: "", label: "", borderColor: "",
					candidateCountryCode: CandidateCountryCode,
					candidateRegion: String(RegionVote?.value || "").trim(),
					candidateCity: String(CityVote?.value || "").trim(),
					countryCandidates: CountryVotes.slice(0, 5),
					regionCandidates: RegionVotes.slice(0, 5),
					cityCandidates: CityVotes.slice(0, 5),
					timezone: BrowserTimezone,
					timezoneSupportSources: TimezoneSupportSources,
					timezoneConflictSources: TimezoneConflictSources,
					sources: Sources.map(GeoSourceView).filter(Boolean),
					note: "Single or conflicting IP source: location is kept for diagnostics but is not displayed as verified visitor location"
				};
			}

			const Region = String(RegionVote?.value || "").trim();
			const City = CityVerified ? String(CityVote?.value || "").trim() : "";
			const Classified = ClassifyResolvedLocation(CandidateCountryCode, Region, City);
			let Confidence = CityVerified ? (CitySources.length >= 3 ? "medium" : "medium_low") : "country_only";
			if (LowCityReliabilitySources.length && City) Confidence = "low";
			if (TimezoneConflictSources.length > TimezoneSupportSources.length && City) Confidence = "low";
			return {
				method: "ip_consensus",
				sourceType: "ip",
				confidence: Confidence,
				countryCode: CandidateCountryCode,
				region: Region,
				city: City,
				band: Classified.band,
				label: Classified.label,
				borderColor: Classified.borderColor,
				countryAgreementSources: CountrySources,
				regionAgreementSources: RegionVote?.sources || [],
				cityAgreementSources: CitySources,
				countryCandidates: CountryVotes.slice(0, 5),
				regionCandidates: RegionVotes.slice(0, 5),
				cityCandidates: CityVotes.slice(0, 5),
				timezone: BrowserTimezone,
				timezoneSupportSources: TimezoneSupportSources,
				timezoneConflictSources: TimezoneConflictSources,
				lowCityReliabilitySources: LowCityReliabilitySources,
				sources: Sources.map(GeoSourceView).filter(Boolean),
				note: City ? "IP city is a multi-provider estimate of network egress; satellite/mobile networks can still be physically far from this city" : "Country is corroborated, but city was not independently corroborated"
			};
		}




		function DeviceConfidence(pAccuracyMeters)
		{
			const Accuracy = Number(pAccuracyMeters);
			if (!Number.isFinite(Accuracy)) return "low";
			if (Accuracy <= 500) return "very_high";
			if (Accuracy <= 2000) return "high";
			if (Accuracy <= 10000) return "medium";
			return "low";
		}




		function ResolveFinalLocation()
		{
			const DeviceSources = fLocationSources.filter((Item) => Item && Item.type === "device");
			const RawDevice = DeviceSources.find((Item) => Item.source === "browser_geolocation_raw") || DeviceSources[0] || null;
			const LabeledDeviceSources = DeviceSources.filter((Item) => Item.countryCode || Item.region || Item.city || Item.locality);
			const Device = LabeledDeviceSources.sort((A, B) =>
				{
					const AScore = (A.locality ? 4 : 0) + (A.city ? 3 : 0) + (A.region ? 2 : 0) + (A.countryCode ? 1 : 0) + (A.source === "browser_geolocation_nominatim" ? 0.25 : 0);
					const BScore = (B.locality ? 4 : 0) + (B.city ? 3 : 0) + (B.region ? 2 : 0) + (B.countryCode ? 1 : 0) + (B.source === "browser_geolocation_nominatim" ? 0.25 : 0);
					return BScore - AScore;
				})[0] || null;
			const Accuracy = Number(RawDevice?.accuracyMeters ?? Device?.accuracyMeters);
			if ((RawDevice || Device) && Number.isFinite(Accuracy) && Accuracy <= 50000)
			{
				const Latitude = Number(RawDevice?.latitude ?? Device?.latitude);
				const Longitude = Number(RawDevice?.longitude ?? Device?.longitude);
				if (Device)
				{
					const City = String(Device.locality || Device.city || "").trim();
					const Classified = ClassifyResolvedLocation(Device.countryCode, Device.region, City);
					return {
						method: "device_geolocation",
						sourceType: "device",
						sourceName: Device.source,
						confidence: DeviceConfidence(Accuracy),
						countryCode: Device.countryCode,
						region: Device.region,
						city: City,
						band: Classified.band,
						label: Classified.label,
						borderColor: Classified.borderColor,
						latitude: Latitude,
						longitude: Longitude,
						accuracyMeters: Accuracy,
						permission: fGeoPermission,
						deviceReverseSources: LabeledDeviceSources.map((Item) => Item.source),
						sources: fLocationSources.map(GeoSourceView).filter(Boolean),
						note: "Browser/device coordinates override IP estimates; locality is reverse-geocoded from the same physical coordinates"
					};
				}
				const IpFallback = ResolveIpLocationClient();
				return {
					...(IpFallback || {}),
					method: "device_coordinates_pending_reverse",
					sourceType: "device",
					sourceName: "browser_geolocation_raw",
					confidence: DeviceConfidence(Accuracy),
					latitude: Latitude,
					longitude: Longitude,
					accuracyMeters: Accuracy,
					permission: fGeoPermission,
					sources: fLocationSources.map(GeoSourceView).filter(Boolean),
					note: "Precise browser coordinates were obtained, but reverse-geocoding has not produced a locality yet"
				};
			}
			return ResolveIpLocationClient();
		}




		function LocationSignature(pLocation)
		{
			if (!pLocation) return "";
			return [pLocation.method, pLocation.sourceName, pLocation.countryCode, pLocation.region, pLocation.city, pLocation.band, pLocation.confidence, Math.round(Number(pLocation.latitude) * 100000) || 0, Math.round(Number(pLocation.longitude) * 100000) || 0, Math.round(Number(pLocation.accuracyMeters) || 0)].join("|");
		}




		function ApplyLocationResolution(pReason = "")
		{
			const Previous = LocationSignature(fLocationResolution);
			const Next = ResolveFinalLocation();
			if (!Next) return false;
			Next.updatedAtClient = new Date().toISOString();
			Next.updateReason = String(pReason || "").trim();
			Next.providerStatus = Array.isArray(fLocationEnrichmentDiagnostics?.server?.geoProviderStatus) ? fLocationEnrichmentDiagnostics.server.geoProviderStatus : [];
			Next.deviceGeolocation = { ...fDeviceGeoDiagnostics, permission: fGeoPermission };
			fLocationResolution = Next;
			window.__EMO_OPS_LOCATION__ = fLocationResolution;
			const Changed = Previous !== LocationSignature(Next);
			if (Changed) window.dispatchEvent(new CustomEvent("emo:ops-location", { detail: fLocationResolution }));
			return Changed;
		}




		function AddOrReplaceLocationSource(pSource, pReason = "")
		{
			const Source = GeoSourceView(pSource);
			if (!Source || !Source.source) return false;
			const ExistingIndex = fLocationSources.findIndex((Item) => Item?.source === Source.source && Item?.type === Source.type);
			if (ExistingIndex >= 0) fLocationSources[ExistingIndex] = Source;
			else fLocationSources.push(Source);
			return ApplyLocationResolution(pReason || Source.source);
		}




		async function GetGeolocationPermissionState()
		{
			if (!("geolocation" in navigator)) return "unsupported";
			if (!navigator.permissions || typeof navigator.permissions.query !== "function") return "unknown";
			try
			{
				const Status = await navigator.permissions.query({ name: "geolocation" });
				return String(Status?.state || "unknown").trim() || "unknown";
			} catch { return "unknown"; }
		}




		async function FetchBigDataCloudLocation(pLatitude = null, pLongitude = null)
		{
			try
			{
				const Params = new URLSearchParams();
				if (Number.isFinite(Number(pLatitude)) && Number.isFinite(Number(pLongitude)))
				{
					Params.set("latitude", String(Number(pLatitude)));
					Params.set("longitude", String(Number(pLongitude)));
				}
				Params.set("localityLanguage", "en");
				const Res = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?${Params.toString()}`, { headers: { accept: "application/json" }, cache: "no-store" });
				if (!Res.ok) return null;
				const Data = await Res.json();
				return Data && typeof Data === "object" ? Data : null;
			} catch { return null; }
		}




		async function CollectBigDataCloudIpSource()
		{
			const Data = await FetchBigDataCloudLocation();
			if (!Data) return;
			const Source = {
				source: "bigdatacloud_ip",
				type: "ip",
				countryCode: Data.countryCode,
				country: Data.countryName,
				region: Data.principalSubdivision,
				regionCode: Data.principalSubdivisionCode,
				city: Data.city || Data.locality,
				locality: Data.locality,
				postal: Data.postcode,
				latitude: Data.latitude,
				longitude: Data.longitude,
				timezone: ""
			};
			const Changed = AddOrReplaceLocationSource(Source, "bigdatacloud_ip");
			if (Changed) EmitLocationUpdate("bigdatacloud_ip");
		}




		async function CollectServerIpSources()
		{
			const StartedAt = Date.now();
			try
			{
				const Res = await fetch(cLocationEnrichmentUrl, { method: "GET", headers: { accept: "application/json" }, cache: "no-store" });
				const Data = await Res.json();
				const CompletedAt = Date.now();
				fLocationEnrichmentDiagnostics = {
					status: Res.ok ? "completed" : "http_error",
					httpStatus: Res.status,
					durationMs: Math.max(0, CompletedAt - StartedAt),
					reason: String(Data?.reason || "").trim(),
					server: Data?.diagnostics && typeof Data.diagnostics === "object" ? Data.diagnostics : null
				};
				const ServerSources = Array.isArray(fLocationEnrichmentDiagnostics?.server?.geoSources) ? fLocationEnrichmentDiagnostics.server.geoSources : [];
				let Changed = false;
				for (const Item of ServerSources) Changed = AddOrReplaceLocationSource({ ...Item, type: "ip" }, "server_ip_enrichment") || Changed;
				ApplyLocationResolution("server_ip_enrichment_complete");
				if (fLocationResolution) EmitLocationUpdate(Changed ? "server_ip_enrichment" : "server_ip_diagnostics");
			} catch (Error)
			{
				fLocationEnrichmentDiagnostics = { status: "error", durationMs: Math.max(0, Date.now() - StartedAt), error: String(Error?.message || Error || "") };
			}
		}




		function GetCurrentDevicePosition()
		{
			return new Promise((Resolve) =>
				{
					if (!("geolocation" in navigator)) return Resolve({ position: null, error: { code: 0, message: "geolocation_unsupported" } });
					navigator.geolocation.getCurrentPosition(
						(Position) => Resolve({ position: Position || null, error: null }),
						(Error) => Resolve({ position: null, error: { code: Number(Error?.code) || 0, message: String(Error?.message || "geolocation_failed") } }),
						{ enableHighAccuracy: true, timeout: 10000, maximumAge: 15000 }
					);
				});
		}




		async function FetchNominatimLocation(pLatitude, pLongitude)
		{
			try
			{
				const Params = new URLSearchParams({ format: "jsonv2", addressdetails: "1", zoom: "14", lat: String(Number(pLatitude)), lon: String(Number(pLongitude)), "accept-language": "ar,en" });
				const Res = await fetch(`https://nominatim.openstreetmap.org/reverse?${Params.toString()}`, { headers: { accept: "application/json" }, cache: "no-store" });
				if (!Res.ok) return null;
				const Data = await Res.json();
				return Data && typeof Data === "object" ? Data : null;
			} catch { return null; }
		}




		async function CollectDeviceLocationIfAlreadyGranted()
		{
			if (!("geolocation" in navigator))
			{
				fDeviceGeoDiagnostics = { attempted: false, status: "unsupported", permission: "unsupported" };
				return;
			}
			if (!navigator.permissions || typeof navigator.permissions.query !== "function")
			{
				fDeviceGeoDiagnostics = { attempted: false, status: "permissions_api_unavailable", permission: "unknown" };
				return;
			}
			let Status;
			try { Status = await navigator.permissions.query({ name: "geolocation" }); }
			catch
			{
				fDeviceGeoDiagnostics = { attempted: false, status: "permission_query_failed", permission: "unknown" };
				return;
			}
			fGeoPermission = String(Status?.state || "unknown").trim() || "unknown";
			if (fClientDiagnostics?.geolocation) fClientDiagnostics.geolocation.permission = fGeoPermission;

			const TryCollect = async (pTrigger) =>
				{
					fGeoPermission = String(Status?.state || "unknown").trim() || "unknown";
