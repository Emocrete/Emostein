		})();
	</script>
) }





<script is:inline>



	(() =>
	{

		// ==================== Definitions: Variables & Methods ====================

		const cReplayParams = new URLSearchParams(location.search);

		let fNoAnalytics = false;

		const cVisitorKey = "emo_ops_visitor_id";

		const cSessionKey = "emo_ops_session_id";

		const cOncePrefix = "emo_ops_once_";

		const cApiUrl = "/api/ops/visit";

		const cTrafficGateUrl = "/api/ops/traffic";

		const cLocationEnrichmentUrl = "/api/ops/traffic?phase=location";

		const cRetryQueueKey = "emo_ops_retry_queue_v3";

		const cSessionSeqKey = "emo_ops_session_seq_v1";

		const cSessionStartedKey = "emo_ops_session_started_at_v1";

		const cViewThreshold = [
			0,
			0.01,
			0.05
		];

		const cViewRootMargin = "0px";

		const cScrollMarks = [
			10,
			20,
			30,
			40,
			50,
			60,
			70,
			80,
			90
		];

		const cReadWordsPerMinute = 200;

		const cReadFocusTopRatio = 0.10;

		const cReadFocusBottomRatio = 0.90;

		const cReadFocusMinRatio = 0.5;

		const cReadTickMs = 250;

		const cReadDebugEnabled = cReplayParams.has("d");

		let fReadDebugRoot = null;


		let fReadDebugFrame = 0;

		let fReadDebugEventIndex = 0;

		const fReadDebugBoxes = new Map();

		const fReadDebugFlashes = new Map();

		const fReadDebugEvents = [];

		let fVisitorId = "";

		let fSessionId = "";

		let fPageInstanceId = "";

		const cTrackerLoadedAt = Date.now();

		let fPageStartedAt = cTrackerLoadedAt;

		let fTrafficGateDiagnostics = null;

		let fClientDiagnostics = null;

		let fLocationResolution = null;

		let fLocationSources = [];

		let fGeoPermission = "unknown";

		let fLocationEnhancementStarted = false;

		let fLocationEnrichmentDiagnostics = null;

		let fNetworkAutomationHint = false;

		let fServerLocationResolution = null;

		let fLocationEnrichmentAttempt = 0;

		let fLocationEnrichmentTimer = 0;

		let fLocationEnrichmentHistory = [];

		let fPendingLocationUpdateReason = "";

		let fDeviceGeoDiagnostics = { attempted: false, status: "not_started", permission: "unknown" };

		const cGeoSourceWeights = { vercel: 0.65, ipapi: 1, ipwho: 1, freeipapi: 1.1, iplocationinfo: 1, ipinfo: 1.2, maxmind: 1.25, bigdatacloud_ip: 0.35 };

		const cInvalidGeoTextPattern = /\b(atlantic|pacific|indian ocean|ocean|sea|gulf of|mediterranean|red sea|arabian sea)\b|المحيط|البحر/i;

		const cArabCountryCodes = new Set(["EG", "SA", "AE", "KW", "QA", "BH", "OM", "YE", "JO", "LB", "SY", "IQ", "PS", "MA", "DZ", "TN", "LY", "SD", "SO", "DJ", "KM", "MR"]);

		const cFocusAwayMinMs = 1500;

		const cObservedViewElems = new Set();

		const cReadTargets = [];

		const fReadStates = new WeakMap();

		let fSeq = 0;

		let fViewObserver = null;

		let fAwayStartedAt = 0;

		let fAwayReason = "";

		let fLastScrollMark = null;

		let fLastScrollSampleAt = 0;

		let fLastPointerSampleAt = 0;

		let fScrollIdleTimer = 0;

		let fPageExitSent = false;

		let fExternalActionUntil = 0;

		let fPageOpenSent = false;

		let fPageOpenPromise = null;

		let fQueueFlushRunning = false;

		let fRetryDuringFlush = [];

		let fPagePingTimer = 0;

		let fReadTimer = 0;

		let fLastReadTickAt = Date.now();

		let fActiveReadState = null;

		let fFocusedFaqReadState = null;

		const cPagePingMs = 1500;

		const cVisitQualificationMs = 10000;

		const cSyntheticReferrerHosts = new Set(["pagespeed.web.dev"]);

		let fTrackingBlocked = false;

		let fVisitQualificationTimer = 0;

		let fVisitQualificationBound = false;

		let fVisitQualificationReason = "";

		const cBotUserAgentPattern = /(bot|crawl|spider|slurp|googlebot|googleother|bingbot|yandex|baiduspider|duckduckbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|google-inspectiontool|apis-google|adsbot|mediapartners-google|lighthouse|chrome-lighthouse|pagespeed|headlesschrome|puppeteer|playwright|phantomjs|selenium|webdriver|gtmetrix|pingdom|ahrefs|semrush|mj12bot|dotbot|petalbot|screaming frog|sitebulb|pageburst|google-read-aloud|google-notebooklm|google-gemininotebook|google-agent|googlemessages|google-pinpoint|google-cws|feedfetcher-google|ptst(?:\/|\b))/i;





		function NewId(pPrefix)
		{
			const Rand = Math.random().toString(36).slice(2, 10);
			const Time = Date.now().toString(36);
			return `${pPrefix}_${Time}_${Rand}`;
		}





		function StableProfile()
		{
			const Parts = [
				navigator.userAgent || "", navigator.platform || "", navigator.language || "",
				Array.from(navigator.languages || []).join(","), navigator.hardwareConcurrency || 0,
				navigator.deviceMemory || 0, screen.width || 0, screen.height || 0,
				screen.colorDepth || 0, screen.pixelDepth || 0,
				Intl.DateTimeFormat().resolvedOptions().timeZone || ""
			];
			let Hash = 2166136261;
			const Text = Parts.join("|");
			for (let Index = 0; Index < Text.length; Index++)
			{
				Hash ^= Text.charCodeAt(Index);
				Hash = Math.imul(Hash, 16777619);
			}
			return `bp_${(Hash >>> 0).toString(36)}`;
		}





		function GeoNorm(pValue)
		{
			return String(pValue || "").toLowerCase()
				.normalize("NFKD").replace(/[\u0300-\u036f]/g, "")
				.replace(/[\u064B-\u065F\u0670]/g, "").replace(/[إأآ]/g, "ا").replace(/ى/g, "ي").replace(/ة/g, "ه")
				.replace(/[^a-z0-9ا-ي]+/g, " ").replace(/\s+/g, " ").trim();
		}




		function HasGeoWord(pText, pWords)
		{
			const Text = ` ${GeoNorm(pText)} `;
			return pWords.some((pWord) =>
				{
					const Word = GeoNorm(pWord);
					return Word && (Text.includes(` ${Word} `) || (Word.length > 2 && Text.includes(Word)));
		});
		}




		function CanonicalEgyptGovernorate(pRegion, pRegionCode, pCity)
		{
			const Region = String(pRegion || "").trim();
			const Code = String(pRegionCode || "").trim().toUpperCase();
			const All = `${Region} ${pCity || ""}`;
			if (Code === "C" || Code === "CAI" || HasGeoWord(All, ["cairo", "cairo governorate", "al qahirah", "القاهرة", "القاهره"])) return "Cairo";
			if (Code === "GZ" || Code === "GIZ" || HasGeoWord(All, ["giza", "giza governorate", "al jizah", "jizah", "الجيزة", "الجيزه"])) return "Giza";
			if (HasGeoWord(All, ["qalyubia", "qalubia", "القليوبية", "القليوبيه"])) return "Qalyubia";
			if (HasGeoWord(All, ["alexandria", "الاسكندرية", "الإسكندرية"])) return "Alexandria";
			return Region;
		}





		function ClassifyResolvedLocation(pCountryCode, pGovernorate, pCity, pArea = "")
		{
			const CountryCode = String(pCountryCode || "").trim().toUpperCase();
			const Governorate = String(pGovernorate || "").trim();
			const City = String(pCity || "").trim();
			const Area = String(pArea || "").trim();
			if (!CountryCode) return { band: "", label: "", borderColor: "" };
			if (CountryCode === "EG")
			{
				const Gov = GeoNorm(Governorate);
				if (Gov === "cairo") return { band: "cairo", label: City || Governorate || "Cairo", borderColor: "#00C853" };
				if (Gov === "giza") return { band: "giza", label: City || Governorate || "Giza", borderColor: "#00D5FF" };
				const All = `${City} ${Area}`;
				if (HasGeoWord(All, ["cairo", "al qahirah", "القاهرة", "القاهره"])) return { band: "cairo", label: City || Area || "Cairo", borderColor: "#00C853" };
				if (HasGeoWord(All, ["giza", "6th of october", "6 october", "october", "sheikh zayed", "الجيزة", "الجيزه", "اكتوبر", "السادس من اكتوبر", "الشيخ زايد"])) return { band: "giza", label: City || Area || "Giza", borderColor: "#00D5FF" };
				return { band: "egypt", label: City || Governorate || Area || "Egypt", borderColor: "#FFD740" };
			}
			if (cArabCountryCodes.has(CountryCode)) return { band: "arab", label: City || Governorate || CountryCode || "Arab country", borderColor: "#FF8A00" };
			return { band: "world", label: City || Governorate || CountryCode || "Outside Arab region", borderColor: "#FF3B30" };
		}





		function IsInvalidGeoSource(pSource)
		{
			if (!pSource || typeof pSource !== "object") return "missing_source";
			const Text = `${pSource.city || ""} ${pSource.locality || ""} ${pSource.area || ""} ${pSource.region || ""}`.trim();
			if (cInvalidGeoTextPattern.test(Text)) return "waterbody_or_non_city_label";
			const Latitude = Number(pSource.latitude);
			const Longitude = Number(pSource.longitude);
			if (Number.isFinite(Latitude) && Number.isFinite(Longitude))
			{
				if (Math.abs(Latitude) < 0.000001 && Math.abs(Longitude) < 0.000001) return "zero_coordinates";
				if (Math.abs(Latitude) > 90 || Math.abs(Longitude) > 180) return "invalid_coordinates";
			}
			if (!String(pSource.countryCode || "").trim() && !String(pSource.country || "").trim() && (pSource.city || pSource.locality || pSource.area || pSource.region)) return "missing_country";
			return "";
		}





		function GeoSourceView(pSource)
		{
			if (!pSource || typeof pSource !== "object") return null;
			const Latitude = Number(pSource.latitude);
			const Longitude = Number(pSource.longitude);
			const CountryCode = String(pSource.countryCode || "").trim().toUpperCase();
			const Region = String(pSource.region || pSource.governorate || "").trim();
			const RegionCode = String(pSource.regionCode || "").trim();
			const City = String(pSource.city || "").trim();
			const RejectionReason = String(pSource.rejectionReason || IsInvalidGeoSource(pSource)).trim();
			return {
				source: String(pSource.source || "").trim(),
				type: String(pSource.type || "ip").trim(),
				countryCode: CountryCode,
				country: String(pSource.country || "").trim(),
				region: Region,
				governorate: String(pSource.governorate || (CountryCode === "EG" ? CanonicalEgyptGovernorate(Region, RegionCode, City) : Region)).trim(),
				regionCode: RegionCode,
				city: City,
				locality: String(pSource.locality || "").trim(),
				area: String(pSource.area || "").trim(),
				areaType: String(pSource.areaType || "").trim(),
				postal: String(pSource.postal || "").trim(),
				latitude: Number.isFinite(Latitude) ? Latitude : null,
				longitude: Number.isFinite(Longitude) ? Longitude : null,
				accuracyMeters: Number.isFinite(Number(pSource.accuracyMeters)) ? Math.max(0, Number(pSource.accuracyMeters)) : null,
				accuracyRadiusKm: Number.isFinite(Number(pSource.accuracyRadiusKm)) ? Math.max(0, Number(pSource.accuracyRadiusKm)) : null,
				timezone: String(pSource.timezone || "").trim(),
				asn: String(pSource.asn || "").trim(),
				org: String(pSource.org || "").trim(),
				hostname: String(pSource.hostname || "").trim(),
				networkType: String(pSource.networkType || "").trim(),
				isMobile: pSource.isMobile === true,
				isHosting: pSource.isHosting === true,
				isAnonymous: pSource.isAnonymous === true,
				voteEligible: pSource.voteEligible === false ? false : !RejectionReason,
				rejectionReason: RejectionReason
			};
		}





		function ResolveIpLocationClient()
		{
			const Sources = fLocationSources.filter((Item) => Item && Item.type !== "device").map(GeoSourceView).filter(Boolean);
			if (fServerLocationResolution && typeof fServerLocationResolution === "object")
			{
				const Result = { ...fServerLocationResolution };
				Result.governorate = String(Result.governorate || Result.region || "").trim();
				Result.region = Result.governorate;
				Result.area = String(Result.area || "").trim();
				Result.areaType = String(Result.areaType || "").trim();
				Result.sources = Sources;
				return Result;
			}
			if (!Sources.length) return null;
			const First = Sources.find((Item) => Item.voteEligible !== false) || Sources[0];
			return {
				method: "ip_unverified",
				sourceType: "ip",
				confidence: "low",
				countryConfidence: "low",
				governorateConfidence: "none",
				cityConfidence: "none",
				areaConfidence: "none",
				countryCode: "",
				governorate: "",
				region: "",
				city: "",
				area: "",
				areaType: "",
				band: "",
				label: "",
				borderColor: "",
				candidateCountryCode: String(First?.countryCode || "").trim(),
				candidateGovernorate: String(First?.governorate || First?.region || "").trim(),
				candidateRegion: String(First?.governorate || First?.region || "").trim(),
				candidateCity: String(First?.city || "").trim(),
				sources: Sources,
				note: "Single or conflicting IP source: location is kept for diagnostics but is not displayed as verified visitor location"
			};
		}




		function DeviceConfidence(pAccuracyMeters)
		{
			const Accuracy = Number(pAccuracyMeters);
			if (!Number.isFinite(Accuracy)) return "low";
			if (Accuracy <= 500) return "very_high";
			if (Accuracy <= 2000) return "high";
			if (Accuracy <= 10000) return "medium";
			return "low";
		}




		function ResolveFinalLocation()
		{
			const DeviceSources = fLocationSources.filter((Item) => Item && Item.type === "device" && Item.voteEligible !== false);
			const RawDevice = DeviceSources.find((Item) => Item.source === "browser_geolocation_raw") || DeviceSources[0] || null;
			const LabeledDeviceSources = DeviceSources.filter((Item) => Item.countryCode || Item.governorate || Item.region || Item.city || Item.locality || Item.area);
			const Device = LabeledDeviceSources.sort((A, B) =>
				{
					const AScore = (A.area ? 5 : 0) + (A.locality ? 4 : 0) + (A.city ? 3 : 0) + (A.governorate || A.region ? 2 : 0) + (A.countryCode ? 1 : 0) + (A.source === "browser_geolocation_nominatim" ? 0.25 : 0);
					const BScore = (B.area ? 5 : 0) + (B.locality ? 4 : 0) + (B.city ? 3 : 0) + (B.governorate || B.region ? 2 : 0) + (B.countryCode ? 1 : 0) + (B.source === "browser_geolocation_nominatim" ? 0.25 : 0);
					return BScore - AScore;
				})[0] || null;
			const Accuracy = Number(RawDevice?.accuracyMeters ?? Device?.accuracyMeters);
			if ((RawDevice || Device) && Number.isFinite(Accuracy) && Accuracy <= 50000)
			{
				const Latitude = Number(RawDevice?.latitude ?? Device?.latitude);
				const Longitude = Number(RawDevice?.longitude ?? Device?.longitude);
				if (Device)
				{
					const Governorate = String(Device.governorate || Device.region || "").trim();
					const City = String(Device.city || "").trim();
					const Area = String(Device.area || Device.locality || "").trim();
					const Classified = ClassifyResolvedLocation(Device.countryCode, Governorate, City, Area);
					return {
						method: "device_geolocation",
						sourceType: "device",
						sourceName: Device.source,
						confidence: DeviceConfidence(Accuracy),
						countryConfidence: "very_high",
						governorateConfidence: DeviceConfidence(Accuracy),
						cityConfidence: City ? DeviceConfidence(Accuracy) : "none",
						areaConfidence: Area ? DeviceConfidence(Accuracy) : "none",
						countryCode: Device.countryCode,
						governorate: Governorate,
						region: Governorate,
						city: City,
						area: Area,
						areaType: String(Device.areaType || (Area ? "locality" : "")).trim(),
						band: Classified.band,
						label: Classified.label,
						borderColor: Classified.borderColor,
						latitude: Latitude,
						longitude: Longitude,
						accuracyMeters: Accuracy,
						permission: fGeoPermission,
						deviceReverseSources: LabeledDeviceSources.map((Item) => Item.source),
						sources: fLocationSources.map(GeoSourceView).filter(Boolean),
						note: "Browser/device coordinates override IP estimates; city and area are reverse-geocoded from the same physical coordinates"
					};
				}
				const IpFallback = ResolveIpLocationClient();
				return {
					...(IpFallback || {}),
					method: "device_coordinates_pending_reverse",
					sourceType: "device",
					sourceName: "browser_geolocation_raw",
					confidence: DeviceConfidence(Accuracy),
					latitude: Latitude,
					longitude: Longitude,
					accuracyMeters: Accuracy,
					permission: fGeoPermission,
					sources: fLocationSources.map(GeoSourceView).filter(Boolean),
					note: "Precise browser coordinates were obtained, but reverse-geocoding has not produced a locality yet"
				};
			}
			return ResolveIpLocationClient();
		}



		function LocationSignature(pLocation)
		{
			if (!pLocation) return "";
			return [pLocation.method, pLocation.sourceName, pLocation.countryCode, pLocation.governorate || pLocation.region, pLocation.city, pLocation.area, pLocation.areaType, pLocation.band, pLocation.confidence, Math.round(Number(pLocation.latitude) * 100000) || 0, Math.round(Number(pLocation.longitude) * 100000) || 0, Math.round(Number(pLocation.accuracyMeters) || 0)].join("|");
		}




		function ApplyLocationResolution(pReason = "")
		{
			const Previous = LocationSignature(fLocationResolution);
			const Next = ResolveFinalLocation();
			if (!Next) return false;
			Next.updatedAtClient = new Date().toISOString();
			Next.updateReason = String(pReason || "").trim();
			Next.providerStatus = Array.isArray(fLocationEnrichmentDiagnostics?.server?.geoProviderStatus) ? fLocationEnrichmentDiagnostics.server.geoProviderStatus : [];
			Next.deviceGeolocation = { ...fDeviceGeoDiagnostics, permission: fGeoPermission };
			fLocationResolution = Next;
			window.__EMO_OPS_LOCATION__ = fLocationResolution;
			const Changed = Previous !== LocationSignature(Next);
			if (Changed) window.dispatchEvent(new CustomEvent("emo:ops-location", { detail: fLocationResolution }));
			return Changed;
		}




		function AddOrReplaceLocationSource(pSource, pReason = "")
		{
			const Source = GeoSourceView(pSource);
			if (!Source || !Source.source) return false;
			const ExistingIndex = fLocationSources.findIndex((Item) => Item?.source === Source.source && Item?.type === Source.type);
			if (ExistingIndex >= 0) fLocationSources[ExistingIndex] = Source;
			else fLocationSources.push(Source);
			return ApplyLocationResolution(pReason || Source.source);
		}




		async function GetGeolocationPermissionState()
		{
			if (!("geolocation" in navigator)) return "unsupported";
			if (!navigator.permissions || typeof navigator.permissions.query !== "function") return "unknown";
			try
			{
				const Status = await navigator.permissions.query({ name: "geolocation" });
				return String(Status?.state || "unknown").trim() || "unknown";
			} catch { return "unknown"; }
		}




		async function FetchBigDataCloudLocation(pLatitude = null, pLongitude = null)
		{
			try
			{
				const Params = new URLSearchParams();
				if (Number.isFinite(Number(pLatitude)) && Number.isFinite(Number(pLongitude)))
				{
					Params.set("latitude", String(Number(pLatitude)));
					Params.set("longitude", String(Number(pLongitude)));
				}
				Params.set("localityLanguage", "en");
				const Res = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?${Params.toString()}`, { headers: { accept: "application/json" }, cache: "no-store" });
				if (!Res.ok) return null;
				const Data = await Res.json();
				return Data && typeof Data === "object" ? Data : null;
			} catch { return null; }
		}




		async function CollectBigDataCloudIpSource()
		{
			const Data = await FetchBigDataCloudLocation();
			if (!Data) return;
			const Source = {
				source: "bigdatacloud_ip",
				type: "ip",
				countryCode: Data.countryCode,
				country: Data.countryName,
				region: Data.principalSubdivision,
				regionCode: Data.principalSubdivisionCode,
				city: Data.city || Data.locality,
				locality: Data.locality,
				postal: Data.postcode,
				latitude: Data.latitude,
				longitude: Data.longitude,
				timezone: ""
			};
			const Changed = AddOrReplaceLocationSource(Source, "bigdatacloud_ip");
			if (Changed) EmitLocationUpdate("bigdatacloud_ip");
		}




		function LocationResolutionStrength(pResolution)
		{
			if (!pResolution || typeof pResolution !== "object") return 0;
			if (pResolution.method === "device_geolocation") return 100;
			if (pResolution.method !== "ip_consensus") return 10;
			let Score = 40;
			if (pResolution.governorateVerified) Score += 20;
			if (pResolution.cityVerified) Score += 20;
			if (pResolution.area) Score += 5;
			return Score;
		}





		function ScheduleLocationEnrichmentRetry()
		{
			if (fLocationEnrichmentAttempt >= 3 || fLocationEnrichmentTimer) return;
			const Delay = fLocationEnrichmentAttempt <= 1 ? 700 : fLocationEnrichmentAttempt === 2 ? 1800 : 3500;
			fLocationEnrichmentTimer = window.setTimeout(() =>
				{
					fLocationEnrichmentTimer = 0;
					CollectServerIpSources();
				}, Delay);
		}





		function PublishTrackingDecision(pAllowed, pReason)
		{
			const Detail = {
				allowed: pAllowed === true,
				reason: String(pReason || (pAllowed ? "allowed" : "blocked")),
				atClient: new Date().toISOString()
			};
			window.__EMO_OPS_TRACKING_DECISION__ = Detail;
			window.dispatchEvent(new CustomEvent("emo:ops-tracking-decision", { detail: Detail }));
		}




		function PublishNetworkClassification(pStatus = "completed")
		{
			const Detail = {
				status: String(pStatus || "completed"),
				automationSuspect: fNetworkAutomationHint === true,
				attempt: fLocationEnrichmentAttempt,
				completedAtClient: new Date().toISOString()
			};
			window.__EMO_OPS_NETWORK_CLASSIFICATION__ = Detail;
			window.dispatchEvent(new CustomEvent("emo:ops-network-classified", { detail: Detail }));
		}




		async function CollectServerIpSources()
		{
			const Attempt = ++fLocationEnrichmentAttempt;
			const StartedAt = Date.now();
			try
			{
				const Res = await fetch(cLocationEnrichmentUrl, { method: "GET", headers: { accept: "application/json" }, cache: "no-store", keepalive: true });
				let Data = {};
				try { Data = await Res.json(); } catch {}
				const CompletedAt = Date.now();
				const Server = Data?.diagnostics && typeof Data.diagnostics === "object" ? Data.diagnostics : null;
				if (Server?.networkAutomationHint === true) fNetworkAutomationHint = true;
				const AttemptDiagnostics = {
					attempt: Attempt,
					status: Res.ok ? "completed" : "http_error",
					httpStatus: Res.status,
					durationMs: Math.max(0, CompletedAt - StartedAt),
					reason: String(Data?.reason || "").trim(),
					startedAtClient: new Date(StartedAt).toISOString(),
					completedAtClient: new Date(CompletedAt).toISOString(),
					server: Server
