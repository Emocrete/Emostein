	function GetCookieValue(pName) {
	const Name = `${pName}=`;
	const Parts = String(document.cookie || "").split(";");
	for (const Part of Parts) {
	const Text = Part.trim();
	if (Text.startsWith(Name)) {
	try {
	return decodeURIComponent(Text.slice(Name.length));
	} catch {
	return Text.slice(Name.length);
	}
	}
	}
	return "";
	}

	function GetClarityCookieId(pCookieName) {
