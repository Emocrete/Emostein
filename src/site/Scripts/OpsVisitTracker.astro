	const AvailableAfter = HasIds ? new Date(cPageStartedAt + cClarityReadyDelayMs).toISOString() : "";
	return { ProjectId, UserId, SessionId, Url, AvailableAfter, Status: HasIds ? "pending" : "missing_ids" };
	}

	function GetClarityRecordingUrl() {
	return GetClarityState().Url;
