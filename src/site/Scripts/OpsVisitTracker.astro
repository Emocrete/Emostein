---
const cEnabled = import.meta.env.PUBLIC_EMO_OPS_ENABLED !== "false";
---




















{ cEnabled && (



<script is:inline>
	(() => {
	const cVisitorKey = "emo_ops_visitor_id";
	const cSessionKey = "emo_ops_session_id";
	const cOncePrefix = "emo_ops_once_";
	const cApiUrl = "/api/ops/visit";
	const cViewThreshold = [0, 0.01, 0.05];
	const cViewRootMargin = "0px";
	const cStayDelayMs = 3500;
	const cScrollMarks = [10, 20, 30, 40, 50, 60, 70, 80, 90];
	const cPageInstanceId = NewId("p");
	const cFocusAwayMinMs = 1500;
	const cObservedViewElems = new Set();
	const fStayTimers = new WeakMap();
	let fSeq = 0;
	let fViewObserver = null;
	let fAwayStartedAt = 0;
	let fAwayReason = "";
	let fLastScrollMark = null;
	let fPageExitSent = false;
	let fPagePingTimer = 0;
	const cPagePingMs = 20000;

	function NewId(pPrefix) {
	const Rand = Math.random().toString(36).slice(2, 10);
	const Time = Date.now().toString(36);
	return `${pPrefix}_${Time}_${Rand}`;
	}

	function GetStoredId(pStorage, pKey, pPrefix) {
	let Id = pStorage.getItem(pKey);
	if (!Id) {
	Id = NewId(pPrefix);
	pStorage.setItem(pKey, Id);
	}
	return Id;
	}

	function GetVisitorId() {
	return GetStoredId(localStorage, cVisitorKey, "v");
	}

	function GetSessionId() {
	return GetStoredId(sessionStorage, cSessionKey, "s");
	}

	function GetPageInstanceId() {
	return cPageInstanceId;
	}

	function CleanText(pText) {
	return String(pText || "")
	.replace(/\s*\|\s*/g, " ")
	.replace(/م\.?\s*أيمن\s*عاشور/gi, "")
	.replace(/أيمن\s*عاشور/gi, "")
	.replace(/Ayman\s*Ashour/gi, "")
	.replace(/Emostein|Emodsign|Emocrete|Emostone|Emochain|Emoperm|Emomed|Emonsult|Emostate/gi, "")
	.replace(/إيموستين|إيموديزاين|إيموكريت|إيموستون|إيموتشين|إيموبيرم|إيموميد|إيمونسلت|إيموستيت/g, "")
	.replace(/\b20\d{2}\b/g, "")
	.replace(/\s+/g, " ")
	.trim();
	}

	function BoolValue(pValue) {
	if (pValue === true) return true;
	const Value = String(pValue ?? "").trim().toLowerCase();
	return Value === "true" || Value === "1" || Value === "yes" || Value === "on" || Value === "important";
	}

	function Shorten(pText, pMax = 140) {
	const Text = CleanText(pText);
	if (Text.length <= pMax) return Text;
	return `${Text.slice(0, pMax).trim()}…`;
	}

	function GetText(pElem, pSelector) {
	const Elem = pSelector ? pElem?.querySelector?.(pSelector) : pElem;
	return Shorten(Elem ? Elem.textContent : "");
	}

	function GetDirectActionText(pElem) {
	if (!pElem) return "";
	const Explicit = pElem.dataset?.opsLabel || pElem.getAttribute?.("aria-label") || pElem.getAttribute?.("title") || pElem.getAttribute?.("alt") || "";
	if (Explicit) return Shorten(Explicit);

	const ImgAlt = pElem.querySelector?.("img[alt]")?.getAttribute("alt") || "";
	const Value = pElem.value || pElem.getAttribute?.("value") || "";
	const Direct = GetText(pElem, ".FaqQuestionText, .BtnText, .BtnTextNormal, .PriceCardHead, .RatingTitle, .TitleBox, strong, summary, button, a");
	return Shorten(Direct || Value || pElem.textContent || ImgAlt || "");
	}

	function IsSameText(pA, pB) {
	return CleanText(pA).toLowerCase() === CleanText(pB).toLowerCase();
	}

	function GetHeadingSelectors() {
	return "h1, h2, h3, h4, h5, h6, .TitleBox, .SecTitle, .SectionTitle, .FaqTitle, .IndexSecTitle, [data-title], [data-ops-title]";
	}

	function GetExplicitTitle(pElem) {
	return Shorten(pElem?.dataset?.opsTitle || pElem?.getAttribute?.("data-ops-title") || pElem?.dataset?.title || pElem?.getAttribute?.("data-title") || "");
	}

	function GetExplicitLabel(pElem) {
	return Shorten(pElem?.dataset?.opsLabel || pElem?.getAttribute?.("data-ops-label") || "");
	}

	function FindHeadingIn(pElem) {
	if (!pElem) return "";

	const Explicit = GetExplicitTitle(pElem);
	if (Explicit) return Explicit;

	if (!pElem.querySelector) return "";
	const Heading = pElem.querySelector(GetHeadingSelectors());
	if (!Heading) return "";
	return Shorten(GetExplicitTitle(Heading) || Heading.textContent || "");
	}

	function GetScopeElement(pElem) {
	return pElem?.closest?.("[data-ops-scope], [data-ops-widget], .Hero, .FreeHero, .EmoSection, .EmoStrip, .IndexSecBox, .EmoFaq, .FaqItem, .PriceCard, .Price, .EmoGallery, .galleryGrid, .EmoRatingStrip, .EmoContactStrip, .EmoPartnerStrip, .EmoCoverageMapStrip, .EmoPipelineStrip, .EmoStatsStrip, .ReadAlso, .RelatedServices, .ReadAlsoItem, .RelServiceItem, .EmoList, .Emograph, .FullCard, .CardsGrCard, .Card, .RespImg") || null;
	}

	function GetHeadingBefore(pElem) {
	if (!pElem) return "";
	const All = Array.from(document.querySelectorAll("h1, h2, h3, h4, h5, h6, .TitleBox, .SecTitle, .SectionTitle, .FaqTitle, .IndexSecTitle, [data-title], [data-ops-title]"));
	let Last = "";
	for (const Heading of All) {
	if (Heading === pElem || pElem.contains?.(Heading)) continue;
	const Pos = Heading.compareDocumentPosition(pElem);
	if (Pos & 4) Last = Shorten(GetExplicitTitle(Heading) || Heading.textContent || "");
	}
	return Last;
	}

	function GetNearestHeadingText(pElem) {
	if (!pElem) return "";

	const Scope = GetScopeElement(pElem);
	const ScopeHeading = FindHeadingIn(Scope);
	if (ScopeHeading) return ScopeHeading;

	let Node = pElem.parentElement;
	let Guard = 0;

	while (Node && Node !== document.body && Guard++ < 12) {
	const Text = FindHeadingIn(Node);
	if (Text) return Text;
	Node = Node.parentElement;
	}

	return GetHeadingBefore(pElem);
	}

	function BuildActionLabel(pElem, pFallbackElem, pExplicitAction = "") {
	const Action = Shorten(pExplicitAction || GetDirectActionText(pElem));
	const Heading = GetNearestHeadingText(pElem) || (pFallbackElem && pFallbackElem !== pElem ? GetNearestHeadingText(pFallbackElem) : "");
	if (Action && Heading && !IsSameText(Action, Heading)) return Shorten(`${Action} / ${Heading}`, 190);
	return Shorten(Action || Heading || GetDirectActionText(pFallbackElem), 190);
	}

	function BuildEventLabel(pElem, pFallbackElem) {
	return BuildActionLabel(pElem, pFallbackElem);
	}

	function BuildViewLabel(pElem) {
	const Explicit = GetExplicitLabel(pElem) || GetExplicitTitle(pElem);
	if (Explicit) return Shorten(Explicit, 190);

	const Heading = FindHeadingIn(pElem) || GetHeadingBefore(pElem) || GetNearestHeadingText(pElem);
	if (Heading) return Shorten(Heading, 190);

	const Direct = GetText(pElem, ".FaqQuestionText, .TitleBox, .SecTitle, .SectionTitle, .FaqTitle, .IndexSecTitle, h1, h2, h3, h4, h5, h6, strong, p");
	return Shorten(Direct || GetDirectActionText(pElem), 190);
	}

	function BuildFaqLabel(pDetails, pSummary) {
	const Question = GetText(pSummary || pDetails, ".FaqQuestionText") || GetText(pSummary || pDetails);
	const ParentFaq = pDetails?.closest?.(".EmoFaq") || pDetails;
	const Heading = GetNearestHeadingText(ParentFaq) || BuildViewLabel(ParentFaq);
	if (Question && Heading && !IsSameText(Question, Heading)) return Shorten(`${Question} / ${Heading}`, 190);
	return Shorten(Question || Heading, 190);
	}

	function GetVisibleInfo(pElem) {
	const Rect = pElem?.getBoundingClientRect?.();
	if (!Rect || Rect.width <= 0 || Rect.height <= 0) return null;

	const Vw = window.innerWidth || document.documentElement.clientWidth || 0;
	const Vh = window.innerHeight || document.documentElement.clientHeight || 0;
	const VisibleW = Math.max(0, Math.min(Rect.right, Vw) - Math.max(Rect.left, 0));
	const VisibleH = Math.max(0, Math.min(Rect.bottom, Vh) - Math.max(Rect.top, 0));
	const VisibleArea = VisibleW * VisibleH;
	const ElemArea = Math.max(1, Rect.width * Rect.height);

	return { Rect, Vw, Vh, VisibleW, VisibleH, VisibleArea, Ratio: VisibleArea / ElemArea };
	}

	function IsReadableVisible(pElem) {
	const Info = GetVisibleInfo(pElem);
	if (!Info) return false;

	const NeededH = Math.min(
	Math.max(70, Info.Vh * 0.14),
	Math.max(32, Info.Rect.height * 0.18)
	);
	const NeededW = Math.min(120, Math.max(24, Info.Rect.width * 0.2));
	return Info.VisibleH >= NeededH && Info.VisibleW >= NeededW;
	}

	function GetStayEventType(pSeenEventType) {
	const EventType = String(pSeenEventType || "");
	if (EventType.endsWith("_seen")) return EventType.replace(/_seen$/, "_stay");
	if (EventType.endsWith("_view")) return EventType.replace(/_view$/, "_stay");
	return `${EventType}_stay`;
	}

	function CancelStayTimer(pElem) {
	const Timer = fStayTimers.get(pElem);
	if (!Timer) return;
	clearTimeout(Timer);
	fStayTimers.delete(pElem);
	}

	function ScheduleStayEvent(pElem, pSeenEventType, pOnceKey) {
	if (pElem.dataset.opsStayDone === "true" || fStayTimers.has(pElem)) return;

	const Timer = setTimeout(() => {
	fStayTimers.delete(pElem);
	if (!IsReadableVisible(pElem)) return;

	pElem.dataset.opsStayDone = "true";
	TrackFromElementOnce(pElem, GetStayEventType(pSeenEventType), "stay", `${pOnceKey}:stay`, {
	widget: GetWidgetName(pElem),
	label: BuildViewLabel(pElem)
	});
	}, cStayDelayMs);

	fStayTimers.set(pElem, Timer);
	}

	function CheckViewElement(pElem) {
	if (!pElem || pElem.dataset?.opsAuto === "off") return;

	if (!IsReadableVisible(pElem)) {
	CancelStayTimer(pElem);
	return;
	}

	const EventType = pElem.dataset.opsEvent || pElem.dataset.opsViewEvent;
	if (!EventType) return;

	const OnceKey = pElem.dataset.opsOnceKey || pElem.id || EventType;
	if (pElem.dataset.opsSeenDone !== "true") {
	pElem.dataset.opsSeenDone = "true";
	TrackFromElementOnce(pElem, EventType, "view", OnceKey, {
	widget: GetWidgetName(pElem),
	label: BuildViewLabel(pElem)
	});
	}

	ScheduleStayEvent(pElem, EventType, OnceKey);
	}

	function CheckVisibleViews() {
	cObservedViewElems.forEach((pElem) => CheckViewElement(pElem));
	}

	function GetWidgetName(pElem) {
	if (!pElem) return "";
	if (pElem.dataset?.opsWidget) return pElem.dataset.opsWidget;
	const Classes = Array.from(pElem.classList || []);
	return Classes.find((pClass) => /^(Emo|Price|Faq|Hero|FreeHero|ReadAlso|Related|RelService|Gallery|Card|Rating|Contact|Partner|Pipeline|Coverage|Stats)/.test(pClass)) || pElem.tagName.toLowerCase();
	}

	function GetClosestWidget(pElem) {
	return GetScopeElement(pElem) || pElem;
	}

	function GetOnceStore() {
	const Key = `${cOncePrefix}${GetPageInstanceId()}`;
	try {
	return {
	Key,
	Values: new Set(JSON.parse(sessionStorage.getItem(Key) || "[]"))
	};
	} catch {
	return { Key, Values: new Set() };
	}
	}

	function SaveOnceStore(pStore) {
	try {
	sessionStorage.setItem(pStore.Key, JSON.stringify(Array.from(pStore.Values)));
	} catch {}
	}

	function TrackOpsEvent(pEventType, pOptions = {}) {
	const EventType = String(pEventType || "").trim();
	if (!EventType) return Promise.resolve({ ok: false, error: "Missing event type" });

	const Body = {
	eventType: EventType,
	eventOn: String(pOptions.eventOn || "").trim(),
	visitorId: GetVisitorId(),
	sessionId: GetSessionId(),
	pageInstanceId: GetPageInstanceId(),
	pagePath: location.pathname,
	pageTitle: document.title,
	pageTitleShort: CleanText(document.title),
	referrer: document.referrer || "",
	screen: `${window.screen.width}x${window.screen.height}`,
	viewport: `${window.innerWidth}x${window.innerHeight}`,
	language: navigator.language || "",
	timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "",
	widget: String(pOptions.widget || "").trim(),
	label: Shorten(pOptions.label || ""),
	value: pOptions.value ?? "",
	href: String(pOptions.href || "").trim(),
	important: BoolValue(pOptions.important),
	notifyMobile: BoolValue(pOptions.notifyMobile),
	sound: BoolValue(pOptions.sound),
	durationMs: pOptions.durationMs ?? "",
	awayReason: String(pOptions.awayReason || "").trim(),
	clientEventSeq: ++fSeq,
	createdAtClient: new Date().toISOString()
	};

	return fetch(cApiUrl, {
	method: "POST",
	headers: { "content-type": "application/json" },
	body: JSON.stringify(Body),
	keepalive: true
	}).catch(() => ({ ok: false }));
	}

	function TrackOpsEventOnce(pEventType, pOnceKey, pOptions = {}) {
	const Store = GetOnceStore();
	const Key = `${pEventType}:${pOnceKey}`;
	if (Store.Values.has(Key)) return Promise.resolve({ ok: true, skipped: true });

	Store.Values.add(Key);
	SaveOnceStore(Store);
	return TrackOpsEvent(pEventType, pOptions);
	}

	function TrackFromElement(pElem, pEventType, pEventOn, pExtra = {}) {
	if (!pElem || pElem.dataset?.opsAuto === "off") return;

	const Widget = GetClosestWidget(pElem);
	const Important = pExtra.important ?? pElem.dataset?.opsImportant;
	const Notify = pExtra.notifyMobile ?? pElem.dataset?.opsNotify ?? pElem.dataset?.opsNotifyMobile;
	const Sound = pExtra.sound ?? pElem.dataset?.opsSound;
	const Href = pExtra.href ?? pElem.getAttribute?.("href") ?? "";
	const Value = pExtra.value ?? pElem.value ?? pElem.dataset?.opsValue ?? "";
	const Label = (pExtra.label ?? BuildActionLabel(pElem, Widget, GetExplicitLabel(pElem))) || BuildEventLabel(Widget, pElem);

	return TrackOpsEvent(pEventType, {
	eventOn: pEventOn,
	widget: pExtra.widget || GetWidgetName(Widget),
	label: Label,
	value: Value,
	href: Href,
	important: Important,
	notifyMobile: Notify,
	sound: Sound
	});
	}

	function TrackFromElementOnce(pElem, pEventType, pEventOn, pOnceKey, pExtra = {}) {
	if (String(pEventType || "").endsWith("_seen")) return;
	if (!pElem || pElem.dataset?.opsAuto === "off") return;
	const Widget = GetClosestWidget(pElem);
	const Label = (pExtra.label ?? BuildActionLabel(pElem, Widget, GetExplicitLabel(pElem))) || BuildEventLabel(Widget, pElem);

	return TrackOpsEventOnce(pEventType, pOnceKey, {
	eventOn: pEventOn,
	widget: pExtra.widget || GetWidgetName(Widget),
	label: Label,
	value: pExtra.value ?? pElem.dataset?.opsValue ?? "",
	href: pExtra.href ?? pElem.getAttribute?.("href") ?? "",
	important: pExtra.important ?? pElem.dataset?.opsImportant,
	notifyMobile: pExtra.notifyMobile ?? pElem.dataset?.opsNotify ?? pElem.dataset?.opsNotifyMobile,
	sound: pExtra.sound ?? pElem.dataset?.opsSound
	});
	}

	function ObserveView(pSelector, pEventType, pWidgetName) {
	const Items = document.querySelectorAll(pSelector);
	Items.forEach((pElem, pIndex) => {
	if (pElem.dataset.opsAuto === "off") return;
	const OnceKey = `${pSelector}:${pElem.id || pIndex}`;
	pElem.dataset.opsViewEvent = pElem.dataset.opsViewEvent || pEventType;
	pElem.dataset.opsWidget = pElem.dataset.opsWidget || pWidgetName;
	pElem.dataset.opsOnceKey = pElem.dataset.opsOnceKey || OnceKey;
	cObservedViewElems.add(pElem);
	fViewObserver.observe(pElem);
	setTimeout(() => CheckViewElement(pElem), 500);
	});
	}

	function InitViewObserver() {
	if (!("IntersectionObserver" in window)) return;

	fViewObserver = new IntersectionObserver((pEntries) => {
	pEntries.forEach((pEntry) => {
	const Elem = pEntry.target;
	if (!pEntry.isIntersecting) {
	CancelStayTimer(Elem);
	return;
	}

	CheckViewElement(Elem);
	});
	}, {
	threshold: cViewThreshold,
	rootMargin: cViewRootMargin
	});
	}

	function InitDeclarativeEvents() {
	document.querySelectorAll("[data-ops-event]").forEach((pElem, pIndex) => {
	if (pElem.dataset.opsAuto === "off") return;
	const EventOn = (pElem.dataset.opsOn || "").trim().toLowerCase();
	const OnceKey = pElem.dataset.opsOnceKey || pElem.id || `manual_${pIndex}`;

	if (EventOn === "view") {
	if (fViewObserver) {
	pElem.dataset.opsViewEvent = pElem.dataset.opsEvent;
	pElem.dataset.opsOnceKey = OnceKey;
	cObservedViewElems.add(pElem);
	fViewObserver.observe(pElem);
	setTimeout(() => CheckViewElement(pElem), 500);
	}
	return;
	}

	if (EventOn === "toggle" || EventOn === "open" || EventOn === "toggle-open") {
	pElem.addEventListener("toggle", () => {
	if (pElem.open) TrackFromElement(pElem, pElem.dataset.opsEvent, "toggle-open");
	});
	return;
	}

	if (EventOn === "submit") {
	pElem.addEventListener("submit", () => TrackFromElement(pElem, pElem.dataset.opsEvent, "submit"));
	return;
	}

	if (EventOn === "change" || EventOn === "input") {
	pElem.addEventListener(EventOn, () => TrackFromElement(pElem, pElem.dataset.opsEvent, EventOn));
	return;
	}

	if (EventOn === "scroll") return;
	pElem.addEventListener("click", () => TrackFromElement(pElem, pElem.dataset.opsEvent, "click"));
	});
	}

	function GetLinkEvent(pLink) {
	const Href = String(pLink.getAttribute("href") || "").toLowerCase();
	if (Href.startsWith("tel:")) return "call_click";
	if (Href.includes("wa.me") || Href.includes("whatsapp")) return "whatsapp_click";
	if (Href.includes("maps.google") || Href.includes("google.com/maps") || Href.startsWith("geo:")) return "map_click";
	if (pLink.hasAttribute("download") || /\.(pdf|doc|docx|xls|xlsx|zip|rar)(\?|#|$)/i.test(Href)) return "download_click";
	return "";
	}

	function InitClickEvents() {
	document.addEventListener("click", (pEvent) => {
	const Target = pEvent.target;
	if (!(Target instanceof Element)) return;

	const Manual = Target.closest("[data-ops-event]");
	if (Manual && (!Manual.dataset.opsOn || Manual.dataset.opsOn === "click")) return;

	const RatingStar = Target.closest("[data-star-value]");
	if (RatingStar) {
	TrackFromElement(RatingStar, "rating_click", "click", {
	widget: "EmoRatingStrip",
	label: BuildEventLabel(RatingStar, GetClosestWidget(RatingStar)),
	value: RatingStar.dataset.starValue
	});
	return;
	}

	const RatingSubmit = Target.closest("[data-rating-submit]");
	if (RatingSubmit) {
	TrackFromElement(RatingSubmit, "rating_submit", "click", {
	widget: "EmoRatingStrip",
	label: BuildEventLabel(RatingSubmit, GetClosestWidget(RatingSubmit))
	});
	return;
	}

	const LeadSubmit = Target.closest("[data-lead-submit], [data-submit-btn]");
	if (LeadSubmit) {
	TrackFromElement(LeadSubmit, "lead_submit_click", "click");
	return;
	}

	const ActionButton = Target.closest("button.Btn, [data-service-btn], [data-lead-btn], [data-action-btn]");
	if (ActionButton) {
	TrackFromElement(ActionButton, ActionButton.dataset.opsEvent || "button_click", "click");
	return;
	}

	const GalleryItem = Target.closest(".EmoGallery button, .EmoGallery [data-gallery-item], .galleryGrid [data-gallery-item]");
	if (GalleryItem) {
	TrackFromElement(GalleryItem, "gallery_click", "click", {
	widget: "EmoGallery",
	value: GalleryItem.dataset.index || GalleryItem.dataset.galleryIndex || ""
	});
	return;
	}

	const FaqSummary = Target.closest("details.FaqItem summary, .FaqItem summary");
	if (FaqSummary) {
	const FaqItem = FaqSummary.closest("details.FaqItem") || FaqSummary.closest(".FaqItem");
	const Key = `faq_${FaqItem?.id || BuildFaqLabel(FaqItem, FaqSummary)}`;

	setTimeout(() => {
	const IsOpen = !FaqItem || FaqItem.open !== false;
	TrackFromElementOnce(FaqItem || FaqSummary, IsOpen ? "faq_open" : "faq_click", IsOpen ? "toggle-open" : "click", Key, {
	widget: "FaqItem",
	label: BuildFaqLabel(FaqItem, FaqSummary)
	});
	}, 0);
	return;
	}

	const Link = Target.closest("a[href]");
	if (Link) {
	const EventType = GetLinkEvent(Link);
	if (EventType) {
	TrackFromElement(Link, EventType, "click", { href: Link.href });
	return;
	}

	if (Link.closest(".ReadAlso, .ReadAlsoItem")) {
	TrackFromElement(Link, "readalso_click", "click", { href: Link.href, widget: "ReadAlso" });
	return;
	}

	if (Link.closest(".RelatedServices, .RelServiceItem")) {
	TrackFromElement(Link, "related_service_click", "click", { href: Link.href, widget: "RelatedServices" });
	return;
	}
	}
	}, true);
	}

	function InitToggleEvents() {
	document.querySelectorAll("details.FaqItem").forEach((pElem, pIndex) => {
	if (pElem.dataset.opsAuto === "off") return;
	pElem.addEventListener("toggle", () => {
	if (!pElem.open) return;
	TrackFromElementOnce(pElem, "faq_open", "toggle-open", `faq_open_${pElem.id || pIndex}`, {
	widget: "FaqItem",
	label: BuildFaqLabel(pElem, pElem.querySelector("summary"))
	});
	});
	});
	}

	function InitFormEvents() {
	document.querySelectorAll("form").forEach((pForm, pIndex) => {
	if (pForm.dataset.opsAuto === "off") return;
	const Widget = GetClosestWidget(pForm);
	const WidgetName = GetWidgetName(Widget);
	const BaseKey = pForm.id || Widget?.id || `form_${pIndex}`;

	pForm.addEventListener("input", () => {
	TrackFromElementOnce(pForm, "form_start", "input", `${BaseKey}_start`, { widget: WidgetName });
	}, true);

	pForm.addEventListener("change", () => {
	TrackFromElementOnce(pForm, "form_start", "change", `${BaseKey}_start`, { widget: WidgetName });
	}, true);

	pForm.addEventListener("submit", () => {
	const IsRating = !!pForm.closest(".EmoRatingStrip");
	TrackFromElement(pForm, IsRating ? "rating_submit" : "form_submit", "submit", { widget: WidgetName });
	}, true);
	});
	}

	function InitAutoViews() {
	if (!fViewObserver) return;

	ObserveView(".Hero, .FreeHero", "hero_seen", "Hero");
	ObserveView(".IndexSecBox", "index_section_seen", "IndexSec");
	ObserveView(".EmoSection", "section_seen", "EmoSection");
	ObserveView(".EmoStrip", "strip_seen", "EmoStrip");
	ObserveView(".EmoFaq", "faq_seen", "EmoFaq");
	ObserveView("details.FaqItem, .FaqItem", "faq_item_seen", "FaqItem");
	ObserveView(".PriceCard, .Price", "price_seen", "Price");
	ObserveView(".EmoGallery, .galleryGrid", "gallery_seen", "EmoGallery");
	ObserveView(".EmoRatingStrip", "rating_seen", "EmoRatingStrip");
	ObserveView(".EmoContactStrip", "contact_strip_seen", "EmoContactStrip");
	ObserveView(".EmoPartnerStrip", "partner_strip_seen", "EmoPartnerStrip");
	ObserveView(".EmoCoverageMapStrip", "coverage_map_seen", "EmoCoverageMapStrip");
	ObserveView(".EmoPipelineStrip", "pipeline_seen", "EmoPipelineStrip");
	ObserveView(".EmoStatsStrip", "stats_seen", "EmoStatsStrip");
	ObserveView(".ReadAlso", "readalso_seen", "ReadAlso");
	ObserveView(".RelatedServices", "related_services_seen", "RelatedServices");
	ObserveView(".EmoList", "list_seen", "EmoList");
	ObserveView(".Emograph", "emograph_seen", "Emograph");
	ObserveView(".FullCard, .CardsGrCard, .Card", "card_seen", "Card");
	ObserveView(".RespImg", "image_seen", "RespImg");
	}

	function GetScrollPercent() {
	const Height = Math.max(
	document.documentElement.scrollHeight,
	document.body.scrollHeight
	) - window.innerHeight;

	return Height > 0 ? Math.max(0, Math.min(100, Math.round((window.scrollY / Height) * 100))) : 100;
	}

	function GetCurrScrollMark(pPercent) {
	let CurrMark = null;

	for (const Mark of cScrollMarks) {
	if (pPercent >= Mark) CurrMark = Mark;
	else break;
	}

	return CurrMark;
	}

	function InitScrollMilestones() {
	function CheckScroll() {
	const Percent = GetScrollPercent();
	const CurrMark = GetCurrScrollMark(Percent);

	if (CurrMark === null) {
	fLastScrollMark = null;
	return;
	}

	if (CurrMark === fLastScrollMark) return;

	const Direction = fLastScrollMark === null
	? "start"
	: CurrMark > fLastScrollMark
	? "down"
	: "up";

	fLastScrollMark = CurrMark;

	TrackOpsEvent(`scroll_${CurrMark}`, {
	eventOn: "scroll",
	widget: "Page",
	label: `دخل نطاق ${CurrMark}% من الصفحة`,
	value: CurrMark,
	durationMs: "",
	awayReason: Direction
	});
	}

	window.addEventListener("scroll", () => {
	CheckScroll();
	CheckVisibleViews();
	}, { passive: true });
	window.addEventListener("resize", () => {
	CheckScroll();
	CheckVisibleViews();
	}, { passive: true });
	setTimeout(CheckScroll, 800);
	setTimeout(CheckVisibleViews, 900);
	}

	function FormatDuration(pMs) {
	const Seconds = Math.max(1, Math.round(pMs / 1000));
	if (Seconds < 60) return `${Seconds} ثانية`;

	const Minutes = Math.floor(Seconds / 60);
	const Rest = Seconds % 60;
	if (Rest === 0) return `${Minutes} دقيقة`;
	return `${Minutes} دقيقة و ${Rest} ثانية`;
	}

	function MarkPageAway(pReason) {
	if (fAwayStartedAt) return;
	fAwayStartedAt = Date.now();
	fAwayReason = String(pReason || "blur");
	}

	function TrackPageReturn(pReason) {
	if (!fAwayStartedAt) return;

	const StartedAt = fAwayStartedAt;
	const AwayReason = fAwayReason;
	fAwayStartedAt = 0;
	fAwayReason = "";

	const DurationMs = Date.now() - StartedAt;
	if (DurationMs < cFocusAwayMinMs) return;

	TrackOpsEvent("page_focus_return", {
	eventOn: String(pReason || "focus"),
	widget: "Page",
	label: `رجع للصفحة بعد ${FormatDuration(DurationMs)}`,
	value: Math.round(DurationMs / 1000),
	durationMs: DurationMs,
	awayReason: AwayReason
	});
	}

	function InitFocusAwayEvents() {
	document.addEventListener("visibilitychange", () => {
	if (document.hidden) MarkPageAway("hidden");
	else TrackPageReturn("visible");
	});

	window.addEventListener("blur", () => MarkPageAway("blur"));
	window.addEventListener("focus", () => TrackPageReturn("focus"));
	}

	function TrackPagePing() {
	if (document.hidden) return;
	TrackOpsEvent("page_ping", {
	eventOn: "heartbeat",
	widget: "Page",
	label: "الصفحة ما زالت مفتوحة",
	value: GetScrollPercent()
	});
	}

	function TrackPageExit(pReason) {
	if (fPageExitSent) return;
	fPageExitSent = true;
	TrackOpsEvent("page_exit", {
	eventOn: String(pReason || "pagehide"),
	widget: "Page",
	label: "غادر الصفحة",
	value: GetScrollPercent(),
	awayReason: String(pReason || "pagehide")
	});
	}

	function InitPageLiveEvents() {
	if (fPagePingTimer) clearInterval(fPagePingTimer);
	fPagePingTimer = window.setInterval(TrackPagePing, cPagePingMs);

	window.addEventListener("pagehide", () => TrackPageExit("pagehide"));
	window.addEventListener("beforeunload", () => TrackPageExit("beforeunload"));
	}

	function TrackPageOpen() {
	TrackOpsEventOnce("page_open", "page_open", {
	eventOn: "load",
	widget: "Page",
	label: CleanText(document.title),
	important: true,
	notifyMobile: true,
	sound: true
	});
	}

	function InitOps() {
	GetVisitorId();
	GetSessionId();
	GetPageInstanceId();

	window.TrackOpsEvent = TrackOpsEvent;
	window.TrackOpsEventOnce = TrackOpsEventOnce;
	window.EmoOpsTrackEvent = TrackOpsEvent;

	InitViewObserver();
	InitDeclarativeEvents();
	InitToggleEvents();
	InitClickEvents();
	InitFormEvents();
	InitAutoViews();
	InitScrollMilestones();
	InitFocusAwayEvents();
	InitPageLiveEvents();
	TrackPageOpen();
	}

	if (document.readyState === "loading") {
	document.addEventListener("DOMContentLoaded", InitOps, { once: true });
	} else {
	InitOps();
	}
	})();
</script>



