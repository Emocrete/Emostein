---
const cEnabled = import.meta.env.PUBLIC_EMO_OPS_ENABLED !== "false";
const cSnapshotDelayMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_SNAPSHOT_DELAY_MS ?? "1400");
const cPointerEveryMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_POINTER_EVERY_MS ?? "80");
const cScrollEveryMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_SCROLL_EVERY_MS ?? "120");
const cFlushEveryMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_FLUSH_EVERY_MS ?? "1000");
const cNetworkBatchSize = Number(import.meta.env.PUBLIC_EMO_REPLAY_NETWORK_BATCH_SIZE ?? "120");
---

{cEnabled && (
<script
	is:inline
	define:vars={{ cSnapshotDelayMs, cPointerEveryMs, cScrollEveryMs, cFlushEveryMs, cNetworkBatchSize }}
>
(() => {
	if (window.__EmoReplayRecorderStarted) return;
	let NoAnalytics = !!window.__EMO_REPLAY__;
	try { NoAnalytics = NoAnalytics || sessionStorage.getItem("emo_no_analytics_v1") === "1"; } catch {}
	if (NoAnalytics || new URLSearchParams(location.search).has("emoNoAnalytics")) return;
	window.__EmoReplayRecorderStarted = true;

	const cPageStartedAt = Date.now();
	const cSessionStartedKey = "emo_ops_session_started_at_v1";
	const cEvents = [];
	let fCaptureSeq = 0;
	let fFlushRunning = false;
	let fFlushTimer = 0;
	let fLastPointerAt = 0;
	let fLastScrollAt = 0;
	let fStarted = false;
	let fUnloading = false;

	function Str(pValue) { return String(pValue ?? "").trim(); }
	function NowPage() { return Math.max(0, Date.now() - cPageStartedAt); }
	function NowSession() {
		let Started = cPageStartedAt;
		try { Started = Number(sessionStorage.getItem(cSessionStartedKey) || cPageStartedAt); } catch {}
		return Math.max(0, Date.now() - (Number.isFinite(Started) ? Started : cPageStartedAt));
	}
	function Shorten(pText, pMax = 180) {
		const Text = Str(pText).replace(/\s+/g, " ");
		return Text.length > pMax ? `${Text.slice(0, pMax).trim()}…` : Text;
	}
	function CssEscape(pValue) {
		if (window.CSS && typeof CSS.escape === "function") return CSS.escape(String(pValue));
		return String(pValue).replace(/([ #;?%&,.+*~\\':"!^$[\]()=>|/@])/g, "\\$1");
	}
	function ExactSelector(pElem) {
		if (!(pElem instanceof Element)) return "";
		if (pElem.id) return `#${CssEscape(pElem.id)}`;
		for (const Attr of ["data-replay-id", "data-ops-widget", "data-ops-scope", "data-ops-id"]) {
			const Value = Str(pElem.getAttribute(Attr));
			if (Value) return `[${Attr}="${CssEscape(Value)}"]`;
		}
		const Parts = [];
		let Elem = pElem;
		for (let Depth = 0; Elem && Elem !== document.documentElement && Depth < 7; Depth += 1) {
			let Part = Elem.tagName.toLowerCase();
			const Name = Str(Elem.getAttribute("name"));
			if (Name) Part += `[name="${CssEscape(Name)}"]`;
			const Parent = Elem.parentElement;
			if (Parent) {
				const Same = Array.from(Parent.children).filter((Item) => Item.tagName === Elem.tagName);
				if (Same.length > 1) Part += `:nth-of-type(${Same.indexOf(Elem) + 1})`;
			}
			Parts.unshift(Part);
			Elem = Parent;
		}
		return Parts.join(" > ");
	}
	function TargetData(pElem) {
		const Elem = pElem instanceof Element ? pElem : null;
		return {
			selector: ExactSelector(Elem),
			tag: Str(Elem?.tagName).toLowerCase(),
			label: Shorten(Elem?.getAttribute?.("aria-label") || Elem?.getAttribute?.("title") || Elem?.getAttribute?.("placeholder") || Elem?.innerText || Elem?.textContent || ""),
			name: Str(Elem?.getAttribute?.("name")),
			id: Str(Elem?.id)
		};
	}
	function ViewportData() {
		const Root = document.documentElement;
		return {
			viewportWidth: Math.round(window.innerWidth || Root.clientWidth || 0),
			viewportHeight: Math.round(window.innerHeight || Root.clientHeight || 0),
			documentWidth: Math.max(Root.scrollWidth, document.body?.scrollWidth || 0),
			documentHeight: Math.max(Root.scrollHeight, document.body?.scrollHeight || 0),
			dpr: Number(window.devicePixelRatio || 1),
			scrollX: Math.round(window.scrollX || 0),
			scrollY: Math.round(window.scrollY || 0)
		};
	}
	function Capture(pType, pData = {}, pImmediate = false) {
		if (!fStarted || typeof window.TrackOpsEventBatch !== "function") return;
		const PageElapsedMs = NowPage();
		const SessionElapsedMs = NowSession();
		cEvents.push({
			eventType: `system.${pType}`,
			eventSource: "site",
			pageElapsedMs: PageElapsedMs,
			sessionElapsedMs: SessionElapsedMs,
			createdAtClient: new Date().toISOString(),
			focusState: document.hidden ? "away" : "visible",
			eventData: { captureSeq: ++fCaptureSeq, t: PageElapsedMs, sessionT: SessionElapsedMs, ...pData }
		});
		if (pImmediate) Flush();
	}

	async function Flush() {
		if (fFlushRunning || !cEvents.length || typeof window.TrackOpsEventBatch !== "function") return;
		fFlushRunning = true;
		try {
			const Size = Math.min(500, Math.max(1, Number(cNetworkBatchSize) || 120));
			while (cEvents.length) {
				const Batch = cEvents.splice(0, Size);
				const Result = await window.TrackOpsEventBatch(Batch);
				if (!Result?.ok) {
					cEvents.unshift(...Batch);
					break;
				}
				if (fUnloading) break;
			}
		} finally { fFlushRunning = false; }
	}

	function FreezeCss() {
		const Rules = [];
		for (const Sheet of Array.from(document.styleSheets || [])) {
			try {
				for (const Rule of Array.from(Sheet.cssRules || [])) Rules.push(Rule.cssText);
			} catch {}
		}
		return Rules.join("\n");
	}

	function BuildSnapshotHtml() {
		const Clone = document.documentElement.cloneNode(true);
		const Originals = Array.from(document.querySelectorAll("canvas"));
		const Clones = Array.from(Clone.querySelectorAll("canvas"));
		Originals.forEach((Canvas, Index) => {
			try {
				const Img = document.createElement("img");
				Img.src = Canvas.toDataURL("image/png");
				Img.width = Canvas.width; Img.height = Canvas.height;
				Clones[Index]?.replaceWith(Img);
			} catch { Clones[Index]?.remove(); }
		});
		Clone.querySelectorAll("script, noscript, iframe").forEach((Elem) => Elem.remove());
		Clone.querySelectorAll("*").forEach((Elem) => {
			for (const Attr of Array.from(Elem.attributes || [])) {
				if (Attr.name.toLowerCase().startsWith("on")) Elem.removeAttribute(Attr.name);
			}
			if (Elem.matches("input, textarea, select")) {
				const CaptureValue = Elem.getAttribute("data-replay-capture") === "value" && Elem.getAttribute("data-replay-private") !== "true";
				if (Elem.matches("input")) Elem.setAttribute("value", CaptureValue ? Str(Elem.value) : "");
				if (Elem.matches("textarea")) Elem.textContent = CaptureValue ? Str(Elem.value) : "";
				if (Elem.matches("select")) Array.from(Elem.options || []).forEach((Option) => { Option.selected = CaptureValue && Option.selected; });
			}
		});
		const FrozenStyle = document.createElement("style");
		FrozenStyle.setAttribute("data-emo-replay-frozen", "true");
		FrozenStyle.textContent = `${FreezeCss()}\nhtml{scroll-behavior:auto!important}*{animation-play-state:paused!important;caret-color:transparent!important}`;
		(Clone.querySelector("head") || Clone).appendChild(FrozenStyle);
		Clone.setAttribute("data-emo-replay-snapshot", "true");
		return `<!doctype html>${Clone.outerHTML}`;
	}

	async function SendSnapshot() {
		if (!fStarted || typeof window.TrackOpsEventOnce !== "function") return;
		let SnapshotHtml = "";
		try { SnapshotHtml = BuildSnapshotHtml(); }
		catch (Ex) { SnapshotHtml = `<!doctype html><html><body>Snapshot unavailable: ${Shorten(Ex?.message || Ex)}</body></html>`; }
		await window.TrackOpsEventOnce("system.page_snapshot", "page_snapshot", {
			eventSource: "site",
			label: "Replay page snapshot",
			notifyMobile: false,
			eventData: { snapshotHtml: SnapshotHtml, snapshotLength: SnapshotHtml.length, ...ViewportData() }
		});
	}

	function InputValue(pElem) {
		if (!(pElem instanceof Element)) return { value: "", private: true };
		const Allowed = pElem.getAttribute("data-replay-capture") === "value" && pElem.getAttribute("data-replay-private") !== "true";
		if (!Allowed) return { value: "", private: true };
		if (pElem instanceof HTMLInputElement && ["checkbox", "radio"].includes(pElem.type)) return { value: "", checked: pElem.checked, private: false };
		return { value: Str(pElem.value), private: false };
	}

	function WireEvents() {
		window.addEventListener("scroll", () => {
			const Now = performance.now(); if (Now - fLastScrollAt < Number(cScrollEveryMs || 120)) return; fLastScrollAt = Now;
			Capture("scroll", ViewportData());
		}, { passive: true });
		window.addEventListener("resize", () => Capture("resize", ViewportData()), { passive: true });
		document.addEventListener("pointermove", (Event) => {
			const Now = performance.now(); if (Now - fLastPointerAt < Number(cPointerEveryMs || 80)) return; fLastPointerAt = Now;
			Capture("pointer_move", { x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), pointerType: Event.pointerType || "mouse", ...TargetData(Event.target) });
		}, true);
		for (const [DomType, ReplayType] of [["pointerdown", "pointer_down"], ["pointerup", "pointer_up"]]) {
			document.addEventListener(DomType, (Event) => Capture(ReplayType, { x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), button: Event.button, pointerType: Event.pointerType || "mouse", ...TargetData(Event.target) }), true);
		}
		document.addEventListener("click", (Event) => Capture("click", { x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), button: Event.button, ...TargetData(Event.target) }), true);
		for (const Type of ["input", "change"]) {
			document.addEventListener(Type, (Event) => Capture(Type, { ...TargetData(Event.target), ...InputValue(Event.target) }), true);
		}
		document.addEventListener("submit", (Event) => Capture("submit", TargetData(Event.target), true), true);
		document.addEventListener("toggle", (Event) => Capture("widget_state", { ...TargetData(Event.target), open: !!Event.target?.open }), true);
		window.addEventListener("focus", () => Capture("focus", { state: "visible" }), true);
		window.addEventListener("blur", () => Capture("blur", { state: "away" }), true);
		document.addEventListener("visibilitychange", () => Capture("visibility", { state: document.visibilityState }, document.hidden));
		window.addEventListener("pagehide", () => {
			fUnloading = true;
			Capture("page_hide", { persisted: false, ...ViewportData() });
			Flush();
		});
	}

	function Start() {
		if (fStarted || typeof window.TrackOpsEventBatch !== "function") return;
		fStarted = true;
		WireEvents();
		Capture("page_ready", { readyState: document.readyState, ...ViewportData() }, true);
		fFlushTimer = window.setInterval(Flush, Math.max(250, Number(cFlushEveryMs) || 1000));
		window.setTimeout(SendSnapshot, Math.max(200, Number(cSnapshotDelayMs) || 1400));
	}

	window.addEventListener("emo:ops-page-open", Start, { once: true });
	if (window.__EMO_OPS_PAGE_OPENED__) Start();
	else {
		let Attempts = 0;
		const Wait = window.setInterval(() => {
			Attempts += 1;
			if (window.__EMO_OPS_PAGE_OPENED__) { window.clearInterval(Wait); Start(); }
			else if (Attempts > 120) window.clearInterval(Wait);
		}, 250);
	}
})();
</script>
)}
