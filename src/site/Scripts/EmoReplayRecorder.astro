---
const cEnabled = import.meta.env.PUBLIC_EMO_OPS_ENABLED !== "false" && import.meta.env.EMO_DEPLOY_MODE !== "replay";
const cPointerEveryMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_POINTER_EVERY_MS ?? "250");
const cScrollEveryMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_SCROLL_EVERY_MS ?? "200");
const cTouchFrameEveryMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_TOUCH_FRAME_EVERY_MS ?? "50");
const cFlushEveryMs = Number(import.meta.env.PUBLIC_EMO_REPLAY_FLUSH_EVERY_MS ?? "1500");
const cNetworkBatch = Number(import.meta.env.PUBLIC_EMO_REPLAY_NETWORK_BATCH ?? "160");
---





{ cEnabled && (

	<script is:inline define:vars={{ cPointerEveryMs, cScrollEveryMs, cTouchFrameEveryMs, cFlushEveryMs, cNetworkBatch }} NoMove>
	
	
	
		(() =>
		{
	
			// ==================== Definitions: Variables & Methods ====================
	
			let fCaptureStartedAt = 0;

			let fCaptureStartedIso = "";
	
			const cGeneratedId = /^(.+?)-(\d{6})-(\d{6})-(\d{3})-(\d{3})$/;
	
			let fLastPointerAt = 0;
	
			let fLastScrollAt = 0;
	
			let fLastPointerType = "mouse";
	
			let fTouchActive = false;
	
			let fTouchGestureId = 0;
	
			let fTouchPointerId = -1;
	
			let fTouchIdentifier = -1;
	
			let fTouchClientX = -1;
	
			let fTouchClientY = -1;
	
			let fTouchTarget = null;
	
			let fTouchFrameRaf = 0;
	
			let fTouchFrameTimer = 0;
	
			let fLastTouchFrameAt = 0;
	
			let fUnloading = false;

	
			let fFlushing = false;
	
			let fFlushTimer = 0;
	
			const fQueue = [];

	
	
	
	
	
			function Str(pValue)
			{
				return String(pValue ?? "").trim();
			}
	
	
	
	
	
			function Shorten(pValue, pMax = 160)
			{
				return Str(pValue).replace(/\s+/g, " ").slice(0, pMax);
			}
	
	
	
	
	
			function CssEscape(pValue)
			{
				if (window.CSS?.escape) return window.CSS.escape(Str(pValue));
				return Str(pValue).replace(/[^a-zA-Z0-9_-]/g, (Char) => `\\${Char}`);
			}
	
	
	
	
	
			function SessionStartedAt()
			{
				try
				{
					const Value = Number(sessionStorage.getItem("emo_ops_session_started_at_v1") || 0);
					const Fallback = fCaptureStartedAt > 0 ? fCaptureStartedAt : Date.now();
					return Number.isFinite(Value) && Value > 0 ? Value : Fallback;
				} catch { return fCaptureStartedAt > 0 ? fCaptureStartedAt : Date.now(); }
			}
	
	
	
	
	
			function ParseGeneratedId(pId)
			{
				const Match = Str(pId).match(cGeneratedId);
				if (!Match) return null;
				const DatePart = Match[2];
				const TimePart = Match[3];
				const Stamp = Date.UTC(
					2000 + Number(DatePart.slice(0, 2)),
					Number(DatePart.slice(2, 4)) - 1,
					Number(DatePart.slice(4, 6)),
					Number(TimePart.slice(0, 2)),
					Number(TimePart.slice(2, 4)),
					Number(TimePart.slice(4, 6)),
					Number(Match[4])
				);
				return { prefix: Match[1], stampMs: Stamp, count: Number(Match[5]) };
			}
	
	
	
	
	
			function StructuralPath(pElem)
			{
				if (!(pElem instanceof Element)) return "";
				const Parts = [];
				let Current = pElem;
				while (Current && Current !== document.documentElement && Parts.length < 14)
				{
					let Part = Current.tagName.toLowerCase();
					const Parent = Current.parentElement;
					if (Parent)
					{
						const Same = Array.from(Parent.children).filter((Elem) => Elem.tagName === Current.tagName);
						if (Same.length > 1) Part += `:nth-of-type(${Same.indexOf(Current) + 1})`;
					}
					Parts.unshift(Part);
					Current = Parent;
				}
				return Parts.join(" > ");
			}
	
	
	
	
	
			function SamePrefixIndex(pElem, pPrefix)
			{
				if (!(pElem instanceof Element) || !pPrefix) return - 1;
				const Matches = Array.from(document.querySelectorAll("[id]")).filter((Elem) => ParseGeneratedId(Elem.id)?.prefix === pPrefix);
				return Matches.indexOf(pElem);
			}
	
	
	
	
	
			function ExactSelector(pElem)
			{
				if (!(pElem instanceof Element)) return "";
				if (pElem.id) return `#${CssEscape(pElem.id)}`;
				const ReplayId = pElem.getAttribute("data-replay-id");
				if (ReplayId) return `[data-replay-id="${CssEscape(ReplayId)}"]`;
				const OpsId = pElem.getAttribute("data-ops-id");
				if (OpsId) return `[data-ops-id="${CssEscape(OpsId)}"]`;
				return StructuralPath(pElem);
			}
	
	
	
	
	
			function TargetData(pTarget)
			{
				const Elem = pTarget instanceof Element ? pTarget : null;
				if (!Elem) return { selector: "", structuralPath: "", tag: "", label: "", name: "", id: "" };
				const Generated = ParseGeneratedId(Elem.id);
				return {
					selector: ExactSelector(Elem),
					structuralPath: StructuralPath(Elem),
					tag: Elem.tagName.toLowerCase(),
					label: Shorten(Elem.getAttribute("aria-label") || Elem.getAttribute("title") || Elem.textContent || "", 180),
					name: Str(Elem.getAttribute("name")),
					id: Str(Elem.id),
					idPrefix: Generated?.prefix || "",
					autoIdStampMs: Generated?.stampMs || 0,
					autoIdCount: Generated?.count || 0,
					samePrefixIndex: Generated ? SamePrefixIndex(Elem, Generated.prefix) : -1
				};
			}
	
	
	
	
	
			function ScrollData()
			{
				return {
					scrollX: Math.round(window.scrollX || window.pageXOffset || 0),
					scrollY: Math.round(window.scrollY || window.pageYOffset || 0)
				};
			}
	
	
	
	
	
			function ViewportData()
			{
				return {
					viewportWidth: window.innerWidth || document.documentElement.clientWidth || 0,
					viewportHeight: window.innerHeight || document.documentElement.clientHeight || 0,
					documentWidth: Math.max(document.documentElement.scrollWidth, document.body?.scrollWidth || 0),
					documentHeight: Math.max(document.documentElement.scrollHeight, document.body?.scrollHeight || 0),
					screenWidth: window.screen.width || 0,
					screenHeight: window.screen.height || 0,
					devicePixelRatio: window.devicePixelRatio || 1,
					orientation: window.matchMedia("(orientation: portrait)").matches ? "portrait" : "landscape",
					...ScrollData(),
					pageUrl: `${location.pathname}${location.search}${location.hash}`
				};
			}
	
	
	
	
	




			function QueueCapture(pType, pData =
				{
				}, pUseBeacon = false, pTiming = {}) {
				const Now = Date.now();
				const Item = {
					eventType: `system.${pType}`,
					eventSource: "site",
					eventOn: "replay",
					label: `Replay ${pType}`,
					notifyMobile: false,
					sound: false,
					important: false,
					useBeacon: pUseBeacon,
					pageElapsedMs: Number.isFinite(Number(pTiming.pageElapsedMs)) ? Number(pTiming.pageElapsedMs) : Math.max(0, Now - fCaptureStartedAt),
					sessionElapsedMs: Number.isFinite(Number(pTiming.sessionElapsedMs)) ? Number(pTiming.sessionElapsedMs) : Math.max(0, Now - SessionStartedAt()),
					createdAtClient: Str(pTiming.createdAtClient || new Date(Now).toISOString()),
					eventData: pData
				};
				fQueue.push(Item);
				if (pUseBeacon || fQueue.length >= Math.max(20, Number(cNetworkBatch) || 160)) Flush();
				return Item;
			}





			function Capture(pType, pData =
				{
				}, pUseBeacon = false) {
				return QueueCapture(pType, pData, pUseBeacon);
			}





			async function Flush()
			{
				if (fFlushing || !fQueue.length || typeof window.TrackOpsEventBatch !== "function" || !window.__EMO_OPS_PAGE_OPENED__) return;
				fFlushing = true;
				const Batch = fQueue.splice(0, Math.max(20, Number(cNetworkBatch) || 160));
				try
				{
					const Result = await window.TrackOpsEventBatch(Batch);
					if (!Result?.ok && !Result?.queued) fQueue.unshift(...Batch);
				} catch (Error)
				{
					fQueue.unshift(...Batch);
				}
				finally
				{
					fFlushing = false;
					if (fQueue.length && !fUnloading) setTimeout(Flush, 100);
				}
			}





			function InputValue(pElem)
			{
				if (!(pElem instanceof Element)) return { value: "", private: false };
				if (pElem instanceof HTMLInputElement && [
						"checkbox",
						"radio"
					].includes(pElem.type)) return { value: "", checked: pElem.checked, private: false };

				if (pElem instanceof HTMLInputElement || pElem instanceof HTMLTextAreaElement || pElem instanceof HTMLSelectElement)
				{
					const Result = { value: String(pElem.value ?? ""), private: false };
					try
					{
						if (Number.isFinite(Number(pElem.selectionStart))) Result.selectionStart = Number(pElem.selectionStart);
						if (Number.isFinite(Number(pElem.selectionEnd))) Result.selectionEnd = Number(pElem.selectionEnd);
						if (pElem.selectionDirection) Result.selectionDirection = String(pElem.selectionDirection);
					} catch {}
					return Result;
				}

				if (pElem.isContentEditable) return { value: String(pElem.textContent ?? ""), contentEditable: true, private: false };
				return { value: "", private: false };
			}
	
	
	
	
	
			function SetTouchPoint(pPoint, pTarget = null)
			{
				if (!pPoint) return;
				const X = Number(pPoint.clientX);
				const Y = Number(pPoint.clientY);
				if (Number.isFinite(X)) fTouchClientX = X;
				if (Number.isFinite(Y)) fTouchClientY = Y;
				if (pTarget instanceof Element) fTouchTarget = pTarget;
			}
	
	
	
	
	
			function TouchFrameData(pPhase)
			{
				const Scroll = ScrollData();
				const X = Math.round(Math.max(0, fTouchClientX));
				const Y = Math.round(Math.max(0, fTouchClientY));
				return {
					gestureId: fTouchGestureId,
					phase: pPhase,
					x: X,
					y: Y,
					pageX: X + Scroll.scrollX,
					pageY: Y + Scroll.scrollY,
					scrollX: Scroll.scrollX,
					scrollY: Scroll.scrollY,
					pointerType: "touch",
					pointerId: fTouchPointerId,
					touchIdentifier: fTouchIdentifier,
					...(pPhase === "start" ? TargetData(fTouchTarget) : {})
				};
			}
	
	
	
	
	
			function CaptureTouchFrame(pPhase)
			{
				if (!fTouchActive) return;
				Capture("touch_frame", TouchFrameData(pPhase));
				fLastTouchFrameAt = performance.now();
			}
	
	
	
	
	
			function FlushTouchMove()
			{
				fTouchFrameRaf = 0;
				if (!fTouchActive) return;
				CaptureTouchFrame("move");
			}
	
	
	
	
	
			function ScheduleTouchMove()
			{
				if (!fTouchActive || fTouchFrameRaf || fTouchFrameTimer) return;
				const Interval = Math.max(16, Number(cTouchFrameEveryMs) || 50);
				const Remaining = Math.max(0, Interval - (performance.now() - fLastTouchFrameAt));
				const StartFrame = () =>
				{
					if (!fTouchActive || fTouchFrameRaf) return;
					fTouchFrameRaf = requestAnimationFrame(FlushTouchMove);
				};
				if (Remaining <= 1)
				{
					StartFrame();
					return;
				}
				fTouchFrameTimer = window.setTimeout(() =>
					{
						fTouchFrameTimer = 0;
						StartFrame();
					}, Remaining);
			}
	
	
	
	
	
			function BeginTouch(pPoint, pTarget, pPointerId = -1, pIdentifier = -1)
			{
				if (fTouchActive) return false;
				fTouchActive = true;
				fTouchGestureId++;
				fTouchPointerId = Number.isFinite(Number(pPointerId)) ? Number(pPointerId) : -1;
				fTouchIdentifier = Number.isFinite(Number(pIdentifier)) ? Number(pIdentifier) : -1;
				fTouchTarget = pTarget instanceof Element ? pTarget : null;
				SetTouchPoint(pPoint, pTarget);
				CaptureTouchFrame("start");
				return true;
			}
	
	
	
	
	
			function EndTouch(pPoint, pPhase = "end")
			{
				if (!fTouchActive) return;
				SetTouchPoint(pPoint);
				if (fTouchFrameTimer)
				{
					clearTimeout(fTouchFrameTimer);
					fTouchFrameTimer = 0;
				}
				if (fTouchFrameRaf)
				{
					cancelAnimationFrame(fTouchFrameRaf);
					fTouchFrameRaf = 0;
				}
				CaptureTouchFrame(pPhase);
				fTouchActive = false;
				fTouchPointerId = -1;
				fTouchIdentifier = -1;
				fTouchClientX = -1;
				fTouchClientY = -1;
				fTouchTarget = null;
			}
	
	
	
	
	
			function ActiveTouchFromList(pTouches)
			{
				if (!pTouches?.length) return null;
				if (fTouchIdentifier < 0) return pTouches[0] || null;
				for (const Touch of pTouches) if (Number(Touch.identifier) === fTouchIdentifier) return Touch;
				return null;
			}
	
	
	
	
	
			function WireEvents()
			{
				window.addEventListener("scroll", () =>
					{
						if (fTouchActive)
						{
							ScheduleTouchMove();
							return;
						}
						const Now = performance.now();
						if (Now - fLastScrollAt < Math.max(80, Number(cScrollEveryMs) || 200)) return;
						fLastScrollAt = Now;
						Capture("scroll", ScrollData());
					}, { passive: true });
				window.addEventListener("resize", () => Capture("resize", ViewportData()), { passive: true });
				document.addEventListener("pointermove", (Event) =>
					{
						const PointerType = Event.pointerType || "mouse";
						fLastPointerType = PointerType;
						if (PointerType === "touch")
						{
							if (!fTouchActive) BeginTouch(Event, Event.target, Event.pointerId, -1);
							if (fTouchPointerId >= 0 && Number(Event.pointerId) !== fTouchPointerId) return;
							SetTouchPoint(Event, Event.target);
							ScheduleTouchMove();
							return;
						}
						const Now = performance.now();
						if (Now - fLastPointerAt < Math.max(100, Number(cPointerEveryMs) || 250)) return;
						fLastPointerAt = Now;
						Capture(
							"pointer_move",
							{ x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), pointerType: PointerType }
						);
					}, true);
				document.addEventListener("pointerdown", (Event) =>
					{
						const PointerType = Event.pointerType || "mouse";
						fLastPointerType = PointerType;
						if (PointerType === "touch")
						{
							if (!fTouchActive) BeginTouch(Event, Event.target, Event.pointerId, -1);
							else
							{
								if (fTouchPointerId < 0) fTouchPointerId = Number(Event.pointerId);
								SetTouchPoint(Event, Event.target);
							}
							return;
						}
						Capture(
							"pointer_down",
							{ x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), button: Event.button, pointerType: PointerType,...TargetData(Event.target) }
						);
					}, true);
				document.addEventListener("pointerup", (Event) =>
					{
						const PointerType = Event.pointerType || fLastPointerType || "mouse";
						fLastPointerType = PointerType;
						if (PointerType === "touch")
						{
							if (fTouchPointerId < 0 || Number(Event.pointerId) === fTouchPointerId) EndTouch(Event, "end");
							return;
						}
						Capture(
							"pointer_up",
							{ x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), button: Event.button, pointerType: PointerType,...TargetData(Event.target) }
						);
					}, true);
				document.addEventListener("pointercancel", (Event) =>
					{
						const PointerType = Event.pointerType || fLastPointerType || "mouse";
						fLastPointerType = PointerType;
						if (PointerType === "touch")
						{
							if (fTouchActive && (fTouchPointerId < 0 || Number(Event.pointerId) === fTouchPointerId))
							{
								SetTouchPoint(Event, Event.target);
								fTouchPointerId = -1;
								ScheduleTouchMove();
							}
							return;
						}
						Capture(
							"pointer_cancel",
							{ x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), button: Event.button, pointerType: PointerType,...TargetData(Event.target) }
						);
					}, true);
				document.addEventListener("touchstart", (Event) =>
					{
						const Touch = Event.touches?.[0] || Event.changedTouches?.[0];
						if (!Touch) return;
						fLastPointerType = "touch";
						if (!fTouchActive) BeginTouch(Touch, Event.target, -1, Touch.identifier);
						else
						{
							if (fTouchIdentifier < 0) fTouchIdentifier = Number(Touch.identifier);
							SetTouchPoint(Touch, Event.target);
						}
					}, { passive: true, capture: true });
				document.addEventListener("touchmove", (Event) =>
					{
						if (!fTouchActive) return;
						const Touch = ActiveTouchFromList(Event.touches) || ActiveTouchFromList(Event.changedTouches);
						if (!Touch) return;
						SetTouchPoint(Touch, Event.target);
						ScheduleTouchMove();
					}, { passive: true, capture: true });
				document.addEventListener("touchend", (Event) =>
					{
						if (!fTouchActive) return;
						const Touch = ActiveTouchFromList(Event.changedTouches);
						if (!Touch) return;
						EndTouch(Touch, "end");
					}, { passive: true, capture: true });
				document.addEventListener("touchcancel", (Event) =>
					{
						if (!fTouchActive) return;
						const Touch = ActiveTouchFromList(Event.changedTouches);
						if (!Touch) return;
						EndTouch(Touch, "cancel");
					}, { passive: true, capture: true });
				document.addEventListener(
					"click",
					(Event) => Capture(
						"click",
						{ x: Math.round(Event.clientX), y: Math.round(Event.clientY), pageX: Math.round(Event.pageX), pageY: Math.round(Event.pageY), button: Event.button, pointerType: Event.pointerType || fLastPointerType || "mouse",...TargetData(Event.target) }
					),
					true
				);
				for (const Type of ["input", "change"]) document.addEventListener(
					Type,
					(Event) => Capture(Type, {
						...TargetData(Event.target),
						...InputValue(Event.target),
						inputType: String(Event.inputType || ""),
						inputData: Event.data == null ? "" : String(Event.data),
						isComposing: Event.isComposing === true
					}),
					true
				);
				document.addEventListener("submit", (Event) => Capture("submit", TargetData(Event.target), true), true);
				document.addEventListener("toggle", (Event) => Capture("widget_state", {...TargetData(Event.target), open: !!Event.target?.open }), true);
				window.addEventListener("pagehide", (pEvent) =>
					{
						if (fTouchActive) EndTouch(null, "cancel");

						fUnloading = true;
						Capture("page_hide", { persisted: Boolean(pEvent.persisted),...ViewportData() }, true);
						Flush();
				});
			}

	
	
	
	
	
			function OnOpsReady()
			{
				Flush();
			}
	
	
	
	
	
			// ==================== Execution Logic ====================
	
			if (window.__EMO_REPLAY_RECORDER__) return;

			window.__EMO_REPLAY_RECORDER__ = true;

			window.__EMO_REPLAY_CAPTURE_ENABLED__ = false;

			let fStarted = false;

			function StartReplayCapture()
			{
				if (fStarted || window.__EMO_OPS_PAGE_OPENED__ !== true) return;
				fStarted = true;
				fCaptureStartedAt = Date.now();
				fCaptureStartedIso = new Date(fCaptureStartedAt).toISOString();
				window.__EMO_REPLAY_CAPTURE_ENABLED__ = true;
				WireEvents();
				const Gate = window.__EMO_OPS_TRAFFIC_GATE__ || null;
				QueueCapture("page_ready", {
					readyState: document.readyState,
					trafficGateDelayMs: Math.max(0, Number(Gate?.durationMs) || 0),
					...ViewportData()
				}, false, {
					pageElapsedMs: 0,
					sessionElapsedMs: Math.max(0, fCaptureStartedAt - SessionStartedAt()),
					createdAtClient: fCaptureStartedIso
				});
				QueueCapture("scroll", { scrollX: 0, scrollY: 0 }, false, {
					pageElapsedMs: 0,
					sessionElapsedMs: Math.max(0, fCaptureStartedAt - SessionStartedAt()),
					createdAtClient: fCaptureStartedIso
				});
				fFlushTimer = window.setInterval(Flush, Math.max(500, Number(cFlushEveryMs) || 1500));
				OnOpsReady();
			}

			window.addEventListener("emo:ops-page-open", StartReplayCapture, { once: true });

			if (window.__EMO_OPS_PAGE_OPENED__ === true) StartReplayCapture();
		})();
	</script>
) }
