			<div class = " FaqBox " id="faq-non-pharmacist">

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor(Colors.BistageLite).OfText("ترخيص صيدلية لغير صيدلي")}
					pText={Text.Body.WithColor("white").OfText("")}
					pSize={new Size(1200, "auto", "100%", "auto")}
				>

					<p>
						لا يحق لغير الصيدلي الحصول على ترخيص صيدلية، ولكن يمكن لغير الصيدلي عمل تعاقد مشاركة مادية لتمويل مشروع الصيدلية مع أحد الصيادلة المصرح لهم بالحصول على ترخيص صيدلية، على أن يكون ترخيص الصيدلية وإدارتها الفعلية من خلال الصيدلي المشارك، وليس مجرد إعطاء اسمه للشريك بدون تواجده الفعلي.
					</p>

					<p>
						ولا يحق للشريك غير الصيدلي العمل بالصيدلية أو إدارتها من الباطن تحت أي ظرف، وإلا تعرض الطرفان للعقوبة المقررة قانونا في هذا الشأن.
					</p>

				</Emograph>

			</div>

			<div class = " FaqBox " id="faq-penalty">

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor(Colors.BistageLite).OfText("عقوبة فتح صيدلية بدون ترخيص")}
