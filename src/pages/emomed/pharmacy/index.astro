function BuildTopicProps(pItems: Array<string | { fTitle?: string; fText?: string; fDesc?: string }>) {
	return Object.fromEntries(
		pItems.slice(0, 8).map((pItem, pIndex) => {
			const cTitle = typeof pItem === "string" ? "" : pItem.fTitle ?? "";
			const cBody = typeof pItem === "string" ? pItem : pItem.fText ?? pItem.fDesc ?? "";
			return [`pTopic${pIndex + 1}`, new Topic(cTitle, cBody)];
		}),
	);
}



