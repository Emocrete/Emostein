					pSize={new Size(1200, "auto", "100%", "auto")}
				>

					<p>
						يحق للصيدلي فتح صيدلية بعد مرور سنة على مزاولته الفعلية للمهنة في أي مؤسسة حكومية أو خاصة، وليس سنة من تاريخ التخرج.
					</p>

				</Emograph>

			</div>

			<div class = " FaqBox " id="faq-count">

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor(Colors.BistageLite).OfText("كم صيدلية يحق للصيدلي فتحها")}
					pText={Text.Body.WithColor("white").OfText("")}
					pSize={new Size(1200, "auto", "100%", "auto")}
				>

					<p>
						يحق للصيدلي أن يكون مالكا أو شريكا في صيدليتين فقط.
					</p>

				</Emograph>

