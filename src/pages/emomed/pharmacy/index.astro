---
import BLayout from "@/Layout.astro";
import { Align, Colors, DirectSize, ElemBg, EmoMediaData, HoverColors, Loc, Location, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import { Badge, BottTriSep, CardsGr, DuoCol, DuoSec, EmoBtn, EmoCall, EmoContactStrip, EmoCoverageMapStrip, EmoFaq, Emograph, EmoList, EmoPipelineStrip, EmoRatingStrip, EmoStatsStrip, EmoStrip, ESec, FaqItem, FreeHero, FreeHeroFadeIn, FreeHeroFloatY, FreeHeroItem, FreeHeroPulse, FreeHeroSlideInBottom, FreeHeroSlideInLeft, FreeHeroSlideInRight, Grid, HzStack, IncLineSep, IndexBtn, IndexSec, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack, YTPlayer } from "@/Widgets";
import BlurBlob from "@/Widgets/Shapes/Decor/BlurBlob.astro";
import CircleGlow from "@/Widgets/Shapes/Decor/CircleGlow.astro";
import FloatingIcon from "@/Widgets/Shapes/Decor/FloatingIcon.astro";
import LinePath from "@/Widgets/Shapes/Decor/LinePath.astro";
import Ribbon from "@/Widgets/Shapes/Decor/Ribbon.astro";
import Splash from "@/Widgets/Shapes/Decor/Splash.astro";
import SvgDots from "@/Widgets/Shapes/Decor/SvgDots.astro";
import DoubleWave from "@/Widgets/Shapes/Edges/DoubleWave.astro";
import BadgeFrame from "@/Widgets/Shapes/Frames/BadgeFrame.astro";
import FloatingPanel from "@/Widgets/Shapes/Frames/FloatingPanel.astro";
import GlassCard from "@/Widgets/Shapes/Frames/GlassCard.astro";
import TiltCard from "@/Widgets/Shapes/Frames/TiltCard.astro";
import SvgBlobCard from "@/Widgets/Cards/SvgBlobCard.astro";
import SvgRadarCard from "@/Widgets/Cards/SvgRadarCard.astro";
import { PriceCard } from "../../../site/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="خدمات ترخيص الصيدليات"
	pDescr="شروط ترخيص صيدلية والأوراق المطلوبة والإجراءات وخدمات الرسم الهندسي وقياس المسافة بين الصيدليات في القاهرة والجيزة."
>







	<FreeHero pImgF="/Media/Emomed/Pharmacy/">

		<BlurBlob
			pColor="rgba(50,143,232,.46)"
			pColor2="rgba(215,245,140,.42)"
			pBlur={26}
			pLoc={new Loc(new NumPer("-7%", "-22%"), new NumPer("-10%", "-8%"))}
			pSize={new DirectSize(new NumPer("42%", "70%"), new NumPer("45%", "34%"))}
			pZ={1}
		/>

		<CircleGlow
			pColor="rgba(215,245,140,.72)"
			pColor2="rgba(255,255,255,.32)"
			pBlur={34}
			pLoc={new Loc(new NumPer("62%", "42%"), new NumPer("14%", "58%"))}
			pSize={new DirectSize(new NumPer("33%", "70%"), new NumPer("42%", "30%"))}
			pZ={1}
		/>

		<SvgDots
			pColor="rgba(255,255,255,.34)"
			pGap={24}
			pDot={2}
			pLoc={new Loc(new NumPer("4%", "6%"), new NumPer("4%", "5%"))}
			pSize={new DirectSize(new NumPer("36%", "88%"), new NumPer("70%", "36%"))}
			pZ={1}
		/>

		<FreeHeroSlideInRight
			pLoc={new Location("6%", "5%", "12%", "9%")}
			pBox={new Size("48%", "auto", "90%", "auto")}
			pZ={4}
		>

			<GlassCard
				pBg="rgba(17,24,32,.74)"
				pBorder="rgba(255,255,255,.22)"
				pRadius={32}
				pBlur={14}
			>

				<VrStack
					pGap={new Pixel(18, 12)}
					pPad={new Pixel(0)}
					pAlign="Center"
				>

					<Emograph
						pTitle={Text.H1.Centered.White.OfText("ترخيص صيدلية")}
						pText={Text.Body.Centered.White.OfText("دليل عملي وخدمة هندسية لترخيص الصيدليات: فحص صلاحية المكان، قياس المسافة، حساب المساحة والارتفاع، تجهيز الرسم الهندسي، ترتيب المستندات، ومتابعة إجراءات الترخيص في القاهرة والجيزة.")}
					/>

					<HzStack pGap={new Pixel(14, 10)} pPad={new Pixel(0)}>

						<EmoCall
							BlackSky
							pText="للطلب والاستفسار"
							pWidth="220px"
							pHeight="54px"
							pRadius="18px"
						/>

						<EmoCall
							pText="واتساب سريع"
							pWidth="220px"
							pHeight="54px"
							pRadius="18px"
							pBgColors={new HoverColors(Colors.BistageLite, Colors.Bistage)}
							pTitleColors={new HoverColors(Colors.BlackOff)}
						/>

					</HzStack>

				</VrStack>

			</GlassCard>

		</FreeHeroSlideInRight>

		<FreeHeroFadeIn
			pLoc={new Location("63%", "10%", "12%", "56%")}
			pBox={new Size("29%", "auto", "80%", "auto")}
			pDelay={500}
			pZ={4}
		>

			<FloatingPanel
				pBg="rgba(255,255,255,.86)"
				pBorder="rgba(255,255,255,.55)"
				pAccent={Colors.BistageLite}
			>

				<CardsGr
					pWidth={new RespString("100%", "100%")}
					pCardBg={new ElemBg("rgba(255,255,255,.92)")}
					pGrTitle={Text.H4.Centered.Sky.OfText("أرقام لا يبدأ الترخيص بدونها")}
					pCardTitleFnt={Text.H3.Centered.Bistage}
					pCardBodyFnt={Text.Body.Centered}
					pStackDir="Col"
					pTopic1={new Topic("100 م", "أقل مسافة عن أقرب صيدلية مرخصة.")}
					pTopic2={new Topic("25 م²", "الحد الأدنى للمساحة الصافية الداخلية.")}
					pTopic3={new Topic("2.6 م", "أقل ارتفاع صافي داخل الصيدلية.")}
				/>

			</FloatingPanel>

		</FreeHeroFadeIn>

		<FreeHeroFloatY
			pLoc={new Location("77%", "73%", "78%", "78%")}
			pBox={new Size(150, 150, 96, 96)}
			pDelay={1800}
			pZ={5}
		>

			<FloatingIcon
				pIcon="check"
				pBg={Colors.BistageLite}
				pFill={Colors.BlackOff}
			/>

		</FreeHeroFloatY>

		<FreeHeroPulse
			pLoc={new Location("7%", "7%", "76%", "84%")}
			pBox={new Size(360, 64, 270, 54)}
			pDelay={900}
			pZ={5}
		>

			<Ribbon
				pText="خدمة هندسية في القاهرة والجيزة"
				pBg={Colors.BistageLite}
				pColor={Colors.BlackOff}
			/>

		</FreeHeroPulse>

	</FreeHero>







	<IndexSec
		pMedia={new EmoMediaData("Vid", "/Media/", "IndexBgVid.mp4")}
		pTitleClr="white"
		pBlurL="on"
		pBlurP="on"
	>

		<VrStack>

			<IndexBtn pText="صلاحية المكان قبل التقديم" onclick="location.href='#overview'" />

			<IndexBtn pText="شروط ترخيص صيدلية" onclick="location.href='#conditions'" />

			<IndexBtn pText="الأوراق المطلوبة" onclick="location.href='#documents'" />

			<IndexBtn pText="إجراءات الترخيص" onclick="location.href='#procedures'" />

		</VrStack>

		<VrStack>

			<IndexBtn pText="المعاينة الأولى والثانية" onclick="location.href='#inspection'" />

			<IndexBtn pText="صلاحية الترخيص" onclick="location.href='#validity'" />

			<IndexBtn pText="الأسئلة الشائعة" onclick="location.href='#faq'" />

			<IndexBtn pText="الخدمات المرتبطة" onclick="location.href='#related-services'" />

		</VrStack>

	</IndexSec>







	<ESec
		id="pharmacy-license-service"
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={new Align("Center", "Center", "Center", "Center")}
	>

		<BlurBlob
			pColor="rgba(50,143,232,.22)"
			pColor2="rgba(215,245,140,.34)"
			pBlur={34}
			pLoc={new Loc(new NumPer("-10%", "-28%"), new NumPer("-14%", "-6%"))}
			pSize={new DirectSize(new NumPer("42%", "78%"), new NumPer("360px", "230px"))}
			pOpacity={new Percent(82, 70)}
			pZ={1}
		/>

		<CircleGlow
			pColor="rgba(215,245,140,.46)"
			pColor2="rgba(255,255,255,.24)"
			pBlur={42}
			pLoc={new Loc(new NumPer("68%", "48%"), new NumPer("12%", "62%"))}
			pSize={new DirectSize(new NumPer("30%", "70%"), new NumPer("300px", "190px"))}
			pZ={1}
		/>

		<SvgDots
			pColor="rgba(50,143,232,.13)"
			pGap={24}
			pDot={2}
			pLoc={new Loc(new NumPer("2%", "0%"), new NumPer("2%", "0%"))}
			pSize={new DirectSize(new NumPer("96%", "100%"), new NumPer("90%", "100%"))}
			pZ={1}
		/>

		<SecTitle
			SkyLite
			pTitle="خدمة ترخيص الصيدليات"
			pDesc="خدمة هندسية مختصرة هدفها التأكد من صلاحية مقر الصيدلية قبل التقديم، وتجهيز الرسم الهندسي وقياس المسافة ومراجعة البنود التي قد توقف الترخيص."
		/>

		<DuoSec
			pContentSize={new DirectSize(new NumPer("92%", "96%"))}
			pGap={new Pixel(28, 16)}
			pPad={new Pixel(30, 16)}
		>

			<DuoCol pBgColor={new ElemBg(Colors.BlackOff)} pGap={new Pixel(22, 14)}>

				<GlassCard
					pBg="rgba(17,24,32,.92)"
					pBorder="rgba(255,255,255,.16)"
					pRadius={34}
					pBlur={12}
				>

					<Emograph
						pTitle={Text.H3.Bistage.OfText("طبيعة الخدمة")}
						pText={Text.Body.White.OfText("نراجع المكان كحالة ترخيص فعلية، وليس كشرح عام للشروط. يتم فحص المسافة والمساحة والارتفاع، ورفع المقاسات، وتجهيز الرسم الهندسي، وتحديد المخاطر قبل دفع مقدم الإيجار أو البدء في التشطيب.")}
					/>

					<EmoList
						pWidth={new RespString("100%", "100%")}
						pTitle={Text.H4.Bistage.OfText("ما الذي يتم تنفيذه؟")}
						pDesc={Text.Body.White.OfText("بنود عملية مباشرة مرتبطة بقبول مقر الصيدلية.")}
						pItemFnt={Text.Body.White}
						pItemsBg={new ElemBg("transparent")}
						pNumbered={false}
						pItems={[
						"قياس المسافة من أقرب صيدلية مرخصة طبقًا لمسار المشاة الصحيح.",
						"رفع أبعاد العين وحساب المساحة الصافية القابلة للترخيص.",
						"قياس الارتفاع الصافي ومراجعة تأثير السقف المستعار أو التشطيبات.",
						"تجهيز الرسم الهندسي المطلوب للملف بعد المعاينة.",
						"تنبيه العميل إلى المخاطر الفنية قبل الالتزام بالمكان."
					]}
					/>

				</GlassCard>

			</DuoCol>

			<DuoCol
				Centered
				pBgColor={new ElemBg(Colors.SkyLite)}
				pGap={new Pixel(20, 14)}
			>

				<CardsGr
					pWidth={new RespString("100%", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pCardRadius={new Pixel(24, 18)}
					pGrTitle={Text.H3.Centered.Sky.OfText("النقاط الحاسمة قبل التقديم")}
					pCardTitleFnt={Text.H3.Centered.Bistage}
					pCardBodyFnt={Text.Body.Centered}
					pStackDir="Col"
					pSpacing={16}
					pTopic1={new Topic("100 م", "شرط المسافة عن أقرب صيدلية مرخصة.")}
					pTopic2={new Topic("25 م²", "الحد الأدنى للمساحة الصافية الداخلية.")}
					pTopic3={new Topic("2.60 م", "الحد الأدنى للارتفاع الصافي داخل الصيدلية.")}
					pTopic4={new Topic("رسم مختوم", "لوحة هندسية معتمدة ضمن ملف الترخيص.")}
				/>

				<HzStack
					pGap={new Pixel(14, 10)}
					pPad={new Pixel(0)}
					pForceHz
				>

					<EmoCall
						BlackSky
						pText="فحص مقر صيدلية"
						pWidth="230px"
						pHeight="54px"
						pRadius="18px"
					/>

					<EmoCall
						pText="واتساب سريع"
						pWidth="210px"
						pHeight="54px"
						pRadius="18px"
						pBgColors={new HoverColors(Colors.BistageLite, Colors.Bistage)}
						pTitleColors={new HoverColors(Colors.BlackOff)}
					/>

				</HzStack>

			</DuoCol>

		</DuoSec>

	</ESec>







	<ESec
		id="pharmacy-license-cost"
		pBg={new ElemBg(Colors.Gray5)}
		pAlign={new Align("Center", "Center", "Center", "Center")}
	>

		<CircleGlow
			pColor="rgba(215,245,140,.40)"
			pColor2="rgba(255,255,255,.16)"
			pBlur={48}
			pLoc={new Loc(new NumPer("74%", "42%"), new NumPer("-16%", "-8%"))}
			pSize={new DirectSize(new NumPer("30%", "70%"), new NumPer("260px", "170px"))}
			pZ={1}
		/>

		<SvgDots
			pColor="rgba(255,255,255,.12)"
			pGap={22}
			pDot={2}
			pLoc={new Loc(new NumPer("0%", "0%"), new NumPer("0%", "0%"))}
			pSize={new DirectSize(new NumPer("100%"), new NumPer("100%"))}
			pZ={1}
		/>

		<Ribbon
			pText="القاهرة والجيزة"
			pBg={Colors.BistageLite}
			pColor={Colors.BlackOff}
			pLoc={new Loc(new NumPer("6%", "12%"), new NumPer("28px", "20px"))}
			pSize={new DirectSize(new NumPer("310px", "250px"), new NumPer("58px", "48px"))}
			pZ={3}
		/>

		<SecTitle
			BistageLite
			pTitle="تكلفة خدمة ترخيص الصيدلية"
			pDesc="التكلفة التالية تخص البنود الهندسية العملية: قياس المسافة والرسم الهندسي. أي رسوم حكومية أو نقابية أو تشطيبات أو متابعة إضافية خارج هذه البنود لا تدخل في السعر."
		/>

		<Grid
			pMax={3}
			pMaxP={1}
			pSize={new DirectSize(new NumPer("1120px", "94%"))}
			pGap={new Pixel(22, 16)}
			pPad={new Pixel(30, 16)}
			Centered
		>

			<BadgeFrame
				pBadge="قياس"
				pBg="rgba(255,255,255,.96)"
				pBadgeBg={Colors.SkyDark}
				pColor={Colors.BlackOff}
			>

				<PriceCard
					pCaption={Text.H4.White.Bold.OfText("قياس المسافة بين الصيدليات")}
					pStart={Text.H3.Bold.OfText("قيمة")}
					pPrice={1000}
					pCurrency={Text.H3.Bold.OfText("جنيه")}
					pSize={new DirectSize(new NumPer("100%", "300px"), new NumPer(126, 104))}
					data-own-size
				/>

				<Emograph pText={Text.Body.Centered.OfText("فحص شرط المسافة قبل التعاقد أو قبل تقديم ملف الترخيص.")} />

			</BadgeFrame>

			<BadgeFrame
				pBadge="رسم"
				pBg="rgba(255,255,255,.96)"
				pBadgeBg={Colors.BistageLite}
				pColor={Colors.BlackOff}
			>

				<PriceCard
					pCaption={Text.H4.White.Bold.OfText("الرسم الهندسي للمعاينة الأولى")}
					pStart={Text.H3.Bold.OfText("يبدأ من")}
					pPrice={2500}
					pCurrency={Text.H3.Bold.OfText("جنيه")}
					pSize={new DirectSize(new NumPer("100%", "300px"), new NumPer(126, 104))}
					data-own-size
				/>

				<Emograph pText={Text.Body.Centered.OfText("يشمل رفع المقاسات وتجهيز 3 نسخ مختومة بختم مهندس نقابي.")} />

			</BadgeFrame>

			<BadgeFrame
				pBadge="باقة"
				pBg="rgba(255,255,255,.96)"
				pBadgeBg={Colors.SkyDark}
				pColor={Colors.BlackOff}
			>

				<PriceCard
					pCaption={Text.H4.White.Bold.OfText("أقل باقة عملية للترخيص")}
					pStart={Text.H3.Bold.OfText("تبدأ من")}
					pPrice={3500}
					pCurrency={Text.H3.Bold.OfText("جنيه")}
					pSize={new DirectSize(new NumPer("100%", "300px"), new NumPer(126, 104))}
					data-own-size
				/>

				<Emograph pText={Text.Body.Centered.OfText("قياس المسافة + الرسم الهندسي. السعر النهائي يراجع حسب موقع الصيدلية وحالة المقر.")} />

			</BadgeFrame>

		</Grid>

		<GlassCard
			pBg="rgba(255,255,255,.10)"
			pBorder="rgba(255,255,255,.20)"
			pRadius={30}
			pBlur={10}
			pSize={new DirectSize(new NumPer("980px", "94%"))}
		>

			<CardsGr
				pWidth={new RespString("100%", "100%")}
				pCardBg={new ElemBg("rgba(255,255,255,.92)")}
				pCardRadius={new Pixel(22, 16)}
				pGrTitle={Text.H3.Centered.Bistage.OfText("حدود السعر")}
				pCardTitleFnt={Text.H4.Centered.Sky}
				pCardBodyFnt={Text.Body.Centered}
				pStackDir="Row"
				pSpacing={18}
				pTopic1={new Topic("لا يشمل", "رسوم حكومية أو نقابية أو تكاليف تشطيب وتجهيز الصيدلية.")}
				pTopic2={new Topic("يتغير عند", "طلب متابعة ملف بدأ بالفعل أو مراجعة ملاحظات معاينة أو انتقال خارج النطاق المعتاد.")}
				pTopic3={new Topic("يثبت بعد", "معرفة عنوان المقر ونوع المطلوب: قياس فقط، رسم فقط، أو قياس مع رسم.")}
			/>

			<EmoCall
				BlackSky
				pText="اسأل عن تكلفة حالتك"
				pWidth="270px"
				pHeight="54px"
				pRadius="18px"
			/>

		</GlassCard>

	</ESec>







	<ESec
		id="overview"
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={new Align("Center", "Center", "Center", "Center")}
	>

		<Splash
			pFill="rgba(215,245,140,.34)"
			pFill2="rgba(50,143,232,.18)"
			pLoc={new Loc(new NumPer("-5%", "-12%"), new NumPer("5%", "3%"))}
			pSize={new DirectSize(new NumPer("36%", "70%"), new NumPer("260px", "170px"))}
			pZ={1}
		/>

		<SecTitle
			SkyLite
			pTitle="ترخيص الصيدلية يبدأ من صلاحية المكان"
			pDesc="أكبر مخاطرة في ترخيص الصيدليات أن يتم اختيار محل غير مطابق ثم تظهر المشكلة عند المعاينة الأولى. لذلك يتم التعامل مع الترخيص كقرار فني وإجرائي يبدأ بفحص الموقع، وليس مجرد تجميع مستندات وإرسال طلب."
		/>

		<DuoSec
			pContentSize={new DirectSize(new NumPer("92%", "96%"))}
			pGap={new Pixel(28, 16)}
			pPad={new Pixel(28, 18)}
		>

			<DuoCol
				pBgColor={new ElemBg(Colors.Gray5)}
				pBgOpacity={new Percent(100)}
				pBlur={new Pixel(0)}
			>

				<FloatingPanel
					pBg="rgba(17,24,32,.96)"
					pBorder="rgba(255,255,255,.14)"
					pAccent={Colors.SkyDark}
				>

					<Emograph
						pTitle={Text.H3.Bistage.OfText("ما الذي نقدمه في ترخيص الصيدليات؟")}
						pText={Text.Body.White.OfText("نراجع موقف مقر الصيدلية من الشروط الأساسية، ونجهز الرسم الهندسي المطلوب، ونساعد في قراءة ملاحظات المعاينات وترتيب المستندات. الهدف أن يكون الملف منظما وأن تكون المخاطر الفنية واضحة قبل الالتزام بالمكان أو البدء في التشطيب.")}
					/>

					<EmoList
						pWidth={new RespString("100%", "100%")}
						pTitle={Text.H4.Bistage.OfText("مراجعة فنية قبل الالتزام بالمقر")}
						pDesc={Text.Body.White.OfText("الاختيار السليم للمقر أهم من علاج المشكلة بعد ظهورها في المعاينة.")}
						pItemFnt={Text.Body.White}
						pItemsBg={new ElemBg("transparent")}
						pNumbered={false}
