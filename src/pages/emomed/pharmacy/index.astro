	<EmoFaq>

		<FaqItem
			id="faq-distance"
			pQuestion="كيفية قياس المسافة بين صيدليتين؟"
			pAnswer="يتم قياس المسافة بين الصيدليات باعتبارها طول أقصر مسار للمشاة يمكن للشخص المترجل سلوكه مشيًا على الأقدام بين الصيدليتين، على أن يكون هذا المسار من خطوط مستقيمة عمودية تبدأ من منتصف باب الصيدلية الأولى وتنتهي عند منتصف باب الصيدلية الثانية. ويتم اختيار أقرب صيدلية من أي اتجاه، سواء كانت في نفس جانب الشارع أو الجانب المقابل أو شارع عمودي أو شارع موازي. مسار المشاة غير مقيد بفتحات الدوران المرورية للسيارات ولا بمناطق عبور المشاة المخططة، وإنما يحسب من أقرب نقطة يمكن للمترجل العبور منها فعليًا. تتوفر لدينا خدمة قياس المسافة بين الصيدليات طبقا للأسلوب المتبع من هيئة الدواء المصرية في القاهرة والجيزة فقط."
		/>

		<FaqItem
			id="faq-area"
			pQuestion="ما أقل مساحة لترخيص صيدلية وكيف يتم حسابها؟"
			pAnswer="أقل مساحة لترخيص صيدلية هي 25 م2، ويتم حسابها باعتبارها المساحة الصافية الداخلية المتاحة للفرش بعد استبعاد المساحات المستغلة في بناء الحوائط الخارجية والداخلية ومساحات الأعمدة وبروزاتها. ويدخل ضمن مساحة الصيدلية المساحة المخصصة لعمل حمام أو معمل بالصيدلية."
		/>

		<FaqItem
			id="faq-height"
			pQuestion="كيفية حساب ارتفاع الصيدلية؟"
			pAnswer="أقل ارتفاع صالح لترخيص صيدلية هو 2.6 م، ويكون هو ارتفاع الفراغ الصافي من منسوب تشطيب الصيدلية إلى باطن منسوب السقف الخرساني الأصلي أو إلى باطن منسوب السقف المستعار لو كان مستخدما."
		/>

		<FaqItem
			id="faq-when"
			pQuestion="متى يحق للصيدلي فتح صيدلية؟"
			pAnswer="يحق للصيدلي فتح صيدلية بعد مرور سنة على مزاولته الفعلية للمهنة في أي مؤسسة حكومية أو خاصة، وليس سنة من تاريخ التخرج."
		/>

		<FaqItem id="faq-count" pQuestion="كم صيدلية يحق للصيدلي فتحها؟" pAnswer="يحق للصيدلي أن يكون مالكا أو شريكا في صيدليتين فقط." />

		<FaqItem
			id="faq-non-pharmacist"
			pQuestion="هل يمكن ترخيص صيدلية لغير صيدلي؟"
			pAnswer="لا يحق لغير الصيدلي الحصول على ترخيص صيدلية، ولكن يمكن لغير الصيدلي عمل تعاقد مشاركة مادية لتمويل مشروع الصيدلية مع أحد الصيادلة المصرح لهم بالحصول على ترخيص صيدلية، على أن يكون الترخيص والإدارة الفعلية من خلال الصيدلي المشارك وليس مجرد إعطاء اسمه للشريك بدون تواجده الفعلي. ولا يحق للشريك غير الصيدلي العمل بالصيدلية أو إدارتها من الباطن تحت أي ظرف، وإلا تعرض الطرفان للعقوبة المقررة قانونا في هذا الشأن."
		/>

		<FaqItem
			id="faq-penalty"
			pQuestion="ما عقوبة فتح صيدلية بدون ترخيص؟"
			pAnswer="عقوبة فتح صيدلية بدون ترخيص تشمل الحبس مدة لا تقل عن سنة، وغرامة مالية من 5 إلى 10 آلاف جنيه مصري، والغلق الإداري للصيدلية المخالفة."
		/>

		<FaqItem
			id="faq-deadline"
			pQuestion="كيفية حساب المهلة بين المعاينتين؟"
			pAnswer="المهلة الأولى بين المعاينة الأولى والثانية تكون 8 شهور، ويمكن قطعها من خلال طلب تقديم موعد المعاينة الثانية. وفي حالة فشل المعاينة الثانية وعدم تحقق الاشتراطات تكون المهلة الثانية 4 شهور إذا استفاد الصيدلي من مدة المهلة الأولى كاملة، أو تكون مساوية لنصف الفترة الزمنية بين المعاينة الأولى وتاريخ تقديم طلب إجراء المعاينة الثانية."
		/>

	</EmoFaq>







