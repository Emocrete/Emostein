---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, EmoWhats, Grid, HzStack, ListItem, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg, YTPlayer } from "@/Widgets/Media";
import { PharmacyWorkCard } from "@/Widgets/Pharmacy";
import { DivCol, DivStr, EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { IncLineSep } from "@/Widgets/Separators";
import { BadgeFrame, CircleGlow, FloatingIcon, FloatingPanel, GlassCard, LinePath, Splash, SvgDots, TiltCard } from "@/Widgets/Shapes";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="خدمات ترخيص الصيدليات"
	pDescr="نتولى السير في إجراءات ترخيص الصيدليات وتجهيز وتقديم كافة الأوراق المطلوبة لترخيص صيدلية بهيئة الدواء المصرية ، ومتابعة الحي والجهات ذات العلاقة"
>







	<Hero>

		<GlassCard
			pMove="SlideInRight"
			pMoveLoc={new Loc(new NumPer("45%", "2.5%"), new NumPer("50%", "45%"))}
			pMoveBox={new Size(new NumPer("40%", "95%"), new NumPer("auto", "auto"))}
			pMoveDuration={1000}
			pMoveViewTarget="self"
			pZ={4}
			pBg="rgba(17,24,32,.74)"
			pBorder="rgba(255,255,255,.22)"
			pRadius={15}
			pBlur={2}
		>

			<VrStack
				pGap={new Pixel(20, 10)}
				pPad={new Pixel(10,5)}
				pHzAlign="Center"
				pVrAlign="Center"
			>

				<Emograph
					pTitle={Text.H1.Centered.White.OfText("ترخيص صيدلية")}
					pText={Text.Body.Centered.White.OfText("خدمات استخراج ترخيص الصيدليات وتجهيز وتقديم كافة الأوراق المطلوبة لترخيص صيدلية بهيئة الدواء المصرية ، ومتابعة الحي والجهات ذات العلاقة")}
				/>

				<HzStack pGap={new Pixel(20, 10)} pPad={new Pixel(20,10)}>

					<EmoCall BlackSky pText="للطلب والاستفسار" />

					<EmoWhats BistageSky pText="أرسل رسالة" />

				</HzStack>

			</VrStack>

		</GlassCard>

	</Hero>







	<EmoSec id="secRegHint" pBg={new ElemBg(Colors.Gray1)}>

		<DivStr>

			<DivCol pVrAlign={"Center"} pHzAlign={"Center"}>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/Emomed/Pharmacy","EDA_Logo.png",false,"شعار هيئة الدواء المصرية",new Size(new NumPer("80%","80%"),new NumPer("auto","auto")))}
				/>

			</DivCol>

			<DivCol pVrAlign={"Center"}>

				<Emograph
					pText={Text.Body.Bold.Centered.OrangeDark.OfText("تأكد من تسجيل حسابك الشخصي كصيدلي على المنصة الإلكترونية لهيئة الدواء المصرية ، يمكننا المساعدة في التسجيل كأولى خطوات الإجراءات لترخيص صيدلية ، قد يتطلب زيارة شخصية من الصيدلي لفرع هيئة الدواء التابع له الصيدلية لإتمام تفعيل تسجيل حساب الصيدلي ، ليتم تفعيل قائمة الخدمات الإلكترونية على المنصة")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		id="secCondVerification"
		pMinH={new NumPer(800)}
		pHzAlign={new Align("Center","Top","Center","Top")}
		pVrAlign={new Align("Center","Top","Center","Top")}
	>

		<SecTitle pTitle="تأكد من صلاحية المكان قبل البدء بترخيص الصيدلية" />

		<DivStr
			pMinH={new NumPer(800)}
			pHzAlign={new Align("Center","Top","Center","Top")}
			pVrAlign={new Align("Center","Top","Center","Top")}
			pContentSize={new Size(new NumPer("100%") )}
			pPad={new Pixel(50,5)}
			pGap={new Pixel(50,5)}
		>

			<DivCol>

				<FloatingPanel
					pMove="SlideInRight"
					pMoveLoc={new Loc(new NumPer("0%", "0%"), new NumPer("10%", "13%"))}
					pMoveBox={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
					pMoveDuration={900}
					pMoveViewTarget="self"
					pZ={4}
					pBg="rgb(39, 39, 39)"
					pBorder="rgb(255, 186, 37)"
					pAccent={Colors.Green}
				>

					<CardsGr
						pWidth={new RespString("100%", "100%")}
						pCardBg={new ElemBg(Colors.Green)}
						pGrTitle={Text.H3.Centered.OfText("إذا كان لديك مقر يحقق الآتي ..")}
						pCardTitleFnt={Text.H4.Centered}
						pCardBodyFnt={Text.Body.Centered}
						pStackDir="Col"
						pTopic1={new Topic("100 م", "أقل مسافة عن أقرب صيدلية مرخصة.")}
						pTopic2={new Topic("25 م²", "الحد الأدنى للمساحة الصافية الداخلية.")}
						pTopic3={new Topic("2.6 م", "أقل ارتفاع صافي داخل الصيدلية.")}
					/>

					<Emograph pTitle={Text.Body.Centered.OfSize(25,20).OfText("فأنت مؤهل لاجتياز المعاينة الأولى")} />

					<FloatingIcon
						pMove="FloatY"
						pLoc={new Loc(new NumPer("20%", "5%"),new NumPer( "68%", "85%"))}
						pMoveBox={new Size(new NumPer(100, 50), new NumPer(100, 50))}
						pMoveDistance="300px"
						pMoveDuration={3000}
						pZ={5}
						pIcon="check"
						pBg={Colors.BistageLite}
						pFill={Colors.BlackOff}
					/>

				</FloatingPanel>

			</DivCol>

			<DivCol>

				<FloatingPanel
					pMove="SlideInLeft"
					pMoveLoc={new Loc(new NumPer("0%", "2.5%"), new NumPer("10%", "13%"))}
					pMoveBox={new Size(new NumPer("100%", "95%"), new NumPer("auto", "auto"))}
					pMoveDuration={900}
					pMoveViewTarget="self"
					pZ={4}
					pBg="rgb(39, 39, 39)"
					pBorder="rgb(255, 186, 37)"
					pAccent={Colors.OrangeDark}
				>

					<VrStack pHzAlign="Center" pVrAlign="Center">

						<Emograph pTitle={Text.Body.Centered.OfSize(25,20).OfText("إذا كنت غير متأكد من تحقق الشروط يمكنك طلب المساعدة")} />

						<EmoCall SkyBistage />

					</VrStack>

				</FloatingPanel>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		Service
		id="secServiceCost"
		pBg={new ElemBg(Colors.Gray5)}
		pMinH={new NumPer(780, 980)}
		pHzAlign={new Align("Center", "Center", "Center", "Center")}
		pVrAlign={new Align("Center", "Center", "Center", "Center")}
		pPad={new Pixel(50,20)}
		pGap={new Pixel(50,30)}
	>

		<SvgDots
			pColor="rgba(255,255,255,.10)"
			pGap={24}
			pDot={2}
			pLoc={new Loc(new NumPer("0%"), new NumPer("0%"))}
			pSize={new Size(new NumPer("100%"), new NumPer("100%"))}
			pZ={1}
		/>

		<SecTitle BistageLite pTitle="تكلفة خدمات ترخيص الصيدليات" pDesc="اختر باقة الخدمات المناسبة لحالتك" />

		<Grid
			id="srvPackages"
			pMax={3}
			pMaxP={1}
			pSize={new Size(new NumPer("80%", "95%"))}
			pGap={new Pixel(40, 40)}
			pPad={new Pixel(50, 5)}
			Centered
		>

			<BadgeFrame
				id="srvMainPackage"
				pBadge="أساسية"
				pBg="white"
				pBadgeBg={Colors.SkyDark}
				pColor={Colors.BlackOff}
				pMove="SlideInRight"
				pMoveDuration={800}
				pMoveViewTarget="self"
			>

				<Emograph pTitle={Text.Body.Bold.DarkSky.OfSize(80,50).Centered.OfText("10,000")} pText={Text.Body.Centered.OfText("جنيه")} />

				<Emograph
					pTitle={Text.H3.Centered.OfText("استخراج ترخيص صيدلية")}
					pText={Text.Body.Centered.OfText("مناسبة لمن لديه مقاسات ورسومات جاهزة ويريد البدء باستخراج الترخيص فقط.")}
				/>

			</BadgeFrame>

			<BadgeFrame
				id="srvMostReqPackage"
				pBadge="الأكثر طلبًا"
				pBg="white"
				pBadgeBg={Colors.BistageLite}
				pColor={Colors.BlackOff}
				pMove="SlideInTop"
				pMoveDuration={850}
				pMoveViewTarget="self"
			>

				<Emograph pTitle={Text.Body.Bold.Bistage.OfSize(80,50).Centered.OfText("11,000")} pText={Text.Body.Centered.OfText("جنيه")} />

				<Emograph
					pTitle={Text.H3.Centered.OfText("رسم هندسي + ترخيص")}
					pText={Text.Body.Centered.OfText("اختيار عملي لمن يريد تجهيز الرسم المطلوب للملف مع متابعة إجراءات الترخيص.")}
				/>

			</BadgeFrame>

			<BadgeFrame
				id="srvFullPackage"
				pBadge="كاملة"
				pBg="rgba(255,255,255,.96)"
				pBadgeBg={Colors.OrangeDark}
				pColor={Colors.BlackOff}
				pMove="SlideInLeft"
				pMoveDuration={900}
				pMoveViewTarget="self"
			>

				<Emograph pTitle={Text.Body.Bold.OrangeDark.OfSize(80,50).Centered.OfText("12,000")} pText={Text.Body.Centered.OfText("جنيه")} />

				<Emograph
					pTitle={Text.H3.Centered.OfText("قياس + رسم + ترخيص")}
					pText={Text.Body.Centered.OfText("أفضل اختيار قبل الالتزام بالمكان أو عند الحاجة لفحص صلاحية المقر وتجهيز ملف الترخيص.")}
				/>

			</BadgeFrame>

		</Grid>

		<GlassCard
			pBg="rgba(255,255,255,.10)"
			pBorder="rgba(255,255,255,.20)"
			pRadius={20}
			pBlur={10}
			pSize={new Size(new NumPer("60%", "95%"))}
			pHzAlign={new Align("Center", "Center", "Center", "Center")}
		>

			<VrStack pPad={new Pixel(30,10)} pGap={new Pixel(30,10)} pHzAlign={new Align("Center","Center")}>

				<Emograph
					pTitle={Text.H3.Centered.Bistage.OfText("لا يشمل")}
					pText={Text.Body.Centered.White.OfText("رسوم حكومية أو نقابية أو تكاليف تشطيب وتجهيز الصيدلية.")}
				/>

				<EmoCall BlackSky />

			</VrStack>

		</GlassCard>

	</EmoSec>







	<EmoSec
		hidden
		id="pharmacy-current-works"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={new Align("Center", "Top", "Center", "Top")}
		pVrAlign={new Align("Center", "Top", "Center", "Top")}
	>

		<SecTitle SkyLite pTitle="أعمال ترخيص الصيدليات الجارية" pDesc="متابعة مختصرة لحالة ملفات الصيدليات المفتوحة ونسبة إنجاز كل ملف." />

		<Grid
			pMax={3}
			pMaxP={1}
			pSize={new Size(new NumPer("1180px", "94%"))}
			pGap={new Pixel(22, 16)}
			pPad={new Pixel(24, 12)}
			Centered
		>

			<PharmacyWorkCard
				pName="صيدلية النور"
				pAddress="مدينة نصر - القاهرة"
				pCode="ملف PH-01"
				pStatus="قيد التنفيذ"
				pActivity="جاري إعداد الرسم الهندسي بعد رفع المقاسات."
				pUpdatedAt="آخر تحديث: هذا الأسبوع"
				pAccent="#22c55e"
				pAccent2="#0ea5e9"
				pSteps={[
				{ Title: "استلام بيانات المكان", Done: true, Time: "يوم", Percent: 10 },
				{ Title: "فحص شروط الترخيص", Done: true, Time: "يوم", Percent: 15 },
				{ Title: "قياس المسافة لأقرب صيدلية", Done: true, Time: "يوم", Percent: 20 },
				{ Title: "رفع المقاسات", Done: true, Time: "يوم", Percent: 15 },
				{ Title: "إعداد الرسم الهندسي", Done: false, Time: "2-3 أيام", Percent: 30 },
				{ Title: "تسليم الملف", Done: false, Time: "يوم", Percent: 10 }
			]}
			/>

			<PharmacyWorkCard
				pName="صيدلية الرحمة"
				pAddress="الهرم - الجيزة"
				pCode="ملف PH-02"
				pStatus="مرحلة فحص"
				pActivity="جاري مراجعة شرط المسافة قبل بدء الرسم الهندسي."
				pUpdatedAt="آخر تحديث: اليوم"
				pAccent="#16a34a"
				pAccent2="#f59e0b"
				pSteps={[
				{ Title: "استلام بيانات المكان", Done: true, Time: "يوم", Percent: 10 },
				{ Title: "فحص شروط الترخيص", Done: true, Time: "يوم", Percent: 20 },
				{ Title: "قياس المسافة لأقرب صيدلية", Done: false, Time: "يوم", Percent: 25 },
				{ Title: "رفع المقاسات", Done: false, Time: "يوم", Percent: 15 },
				{ Title: "إعداد الرسم الهندسي", Done: false, Time: "2-3 أيام", Percent: 20 },
				{ Title: "تسليم الملف", Done: false, Time: "يوم", Percent: 10 }
			]}
			/>

			<PharmacyWorkCard
				pName="صيدلية الشفاء"
				pAddress="فيصل - الجيزة"
				pCode="ملف PH-03"
				pStatus="قرب التسليم"
				pActivity="جاري تجهيز النسخ النهائية للتسليم."
				pUpdatedAt="آخر تحديث: أمس"
				pAccent="#22c55e"
				pAccent2="#6366f1"
				pSteps={[
				{ Title: "استلام بيانات المكان", Done: true, Time: "يوم", Percent: 10 },
				{ Title: "فحص شروط الترخيص", Done: true, Time: "يوم", Percent: 15 },
				{ Title: "قياس المسافة لأقرب صيدلية", Done: true, Time: "يوم", Percent: 20 },
				{ Title: "رفع المقاسات", Done: true, Time: "يوم", Percent: 15 },
				{ Title: "إعداد الرسم الهندسي", Done: true, Time: "2-3 أيام", Percent: 30 },
				{ Title: "تسليم الملف", Done: false, Time: "يوم", Percent: 10 }
			]}
			/>

		</Grid>

	</EmoSec>







	<EmoSec
		hidden
		id="overview"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={new Align("Center", "Center", "Center", "Center")}
		pVrAlign={new Align("Center", "Center", "Center", "Center")}
	>

		<Splash
			pFill="rgba(215,245,140,.34)"
			pFill2="rgba(50,143,232,.18)"
			pLoc={new Loc(new NumPer("-5%", "-12%"), new NumPer("5%", "3%"))}
			pSize={new Size(new NumPer("36%", "70%"), new NumPer("260px", "170px"))}
			pZ={1}
		/>

		<SecTitle
			SkyLite
			pTitle="ترخيص الصيدلية يبدأ من صلاحية المكان"
			pDesc="أكبر مخاطرة في ترخيص الصيدليات أن يتم اختيار محل غير مطابق ثم تظهر المشكلة عند المعاينة الأولى. لذلك يتم التعامل مع الترخيص كقرار فني وإجرائي يبدأ بفحص الموقع، وليس مجرد تجميع مستندات وإرسال طلب."
		/>

		<DivStr pContentSize={new Size(new NumPer("92%", "96%"))} pGap={new Pixel(28, 16)} pPad={new Pixel(28, 18)}>

			<DivCol pBgColor={new ElemBg(Colors.Gray5)} pBgOpacity={new Percent(100)} pBlur={new Pixel(0)}>

				<FloatingPanel pBg="rgba(17,24,32,.96)" pBorder="rgba(255,255,255,.14)" pAccent={Colors.SkyDark}>

					<Emograph
						pTitle={Text.H3.Bistage.OfText("ما الذي نقدمه في ترخيص الصيدليات؟")}
						pText={Text.Body.White.OfText("نراجع موقف مقر الصيدلية من الشروط الأساسية، ونجهز الرسم الهندسي المطلوب، ونساعد في قراءة ملاحظات المعاينات وترتيب المستندات. الهدف أن يكون الملف منظما وأن تكون المخاطر الفنية واضحة قبل الالتزام بالمكان أو البدء في التشطيب.")}
					/>

					<EmoList
						pWidth={new RespString("100%", "100%")}
						pTitle={Text.H4.Bistage.OfText("مراجعة فنية قبل الالتزام بالمقر")}
						pDesc={Text.Body.White.OfText("الاختيار السليم للمقر أهم من علاج المشكلة بعد ظهورها في المعاينة.")}
						pItemFnt={Text.Body.White}
						pItemsBg={new ElemBg("transparent")}
						pNumbered={false}
						pItems={[
							"قياس المسافة إلى أقرب صيدلية مرخصة من مسار المشاة الصحيح.",
							"رفع أبعاد العين وحساب المساحة الصافية القابلة للفرش.",
							"قياس الارتفاع الصافي ومراجعة تأثير السقف المستعار إن وجد.",
							"مراجعة إمكانية تنفيذ المعمل أو الحمام أو الصرف والتهوية قبل التشطيب.",
							"قراءة موقف العقار من الترخيص أو التصالح أو تحويل الاستخدام قبل وضعه في ملف الترخيص."
						]}
					/>

				</FloatingPanel>

			</DivCol>

			<DivCol Centered pBgColor={new ElemBg(Colors.SkyLite)}>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"/Media/Emomed/Pharmacy/",
						"PhRet.webp",
						false,
						"فحص وتجهيز مقر صيدلية للترخيص",
						new Size(new NumPer(520, 310), new NumPer("auto", "auto"))
					)}
				/>

				<EmoCall
					BlackSky
					pText="اطلب فحص مقر الصيدلية"
					pWidth="270px"
					pHeight="54px"
					pRadius="18px"
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec id="conditions" pBg={new ElemBg(Colors.Gray5)}>

		<CircleGlow
			pColor="rgba(215,245,140,.52)"
			pColor2="rgba(255,255,255,.22)"
			pBlur={42}
			pLoc={new Loc(new NumPer("70%", "45%"), new NumPer("-12%", "-5%"))}
			pSize={new Size(new NumPer("32%", "60%"), new NumPer("250px", "180px"))}
			pZ={1}
		/>

		<SecTitle
			BistageLite
			pTitle="شروط ترخيص صيدلية"
			pDesc="شروط الترخيص ليست في مستوى واحد. بعضها يخص الصيدلي طالب الترخيص، وبعضها يخص مقر الصيدلية، وبعضها يتم فحصه عند المعاينة الأولى، ثم تستكمل الاشتراطات الصحية والتجهيزية عند المعاينة الثانية."
		/>

		<CardsGr
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pGrTitle={Text.H3.Centered.Bistage.OfText("مراحل فحص شروط ترخيص الصيدليات")}
			pCardTitleFnt={Text.H4.Centered.DarkSky}
			pCardBodyFnt={Text.Body.Centered}
			pStackDir="Row"
			pSpacing={25}
			pTopic1={new Topic("أولا: عند تقديم الملف", "يتم مراجعة المستندات المرفوعة على المنصة والتحقق من صحة البيانات ومدة السريان للمستندات ذات الصلاحية الزمنية.")}
			pTopic2={new Topic("ثانيا: أثناء المعاينة الأولى", "يتم التحقق من الصلاحية المبدئية لمقر الصيدلية من خلال الشروط الأساسية وهي المسافة والمساحة والارتفاع.")}
			pTopic3={new Topic("ثالثا: أثناء المعاينة الثانية", "يتم التحقق من توفر الاشتراطات الصحية واستكمال أعمال التشطيب والتجهيز والفرش الأساسي ومدى صلاحية الصيدلية للتشغيل.")}
			pTopic4={new Topic("رابعا: بعد المعاينة الثانية", "يتم التحقق من استيفاء باقي المستندات المطلوبة قبل إصدار ترخيص الصيدلية.")}
		/>

		<BadgeFrame
			pBadge="طالب الترخيص"
			pBg="rgba(17,17,17,.92)"
			pBadgeBg={Colors.BistageLite}
			pColor={Colors.BlackOff}
			pHzAlign={"Center"}
			pSize={new Size(new NumPer("60%"))}
