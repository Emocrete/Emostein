---
import BLayout from "@/Layout.astro";
import { CardsGr, FullCard, SvgBlobCard, SvgRadarCard } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, ESec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStrip } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Article"
	pTitle="شروط ترخيص صيدلية"
	pDescr="شرح شامل لشروط ترخيص صيدلية في مصر، يشمل شروط الصيدلي طالب الترخيص، شروط مقر الصيدلية، المسافة، المساحة، الارتفاع، حدود العين، المعاينة الأولى، المعاينة الثانية، المياه، الكهرباء، التهوية، الحمام، المعمل، وموقف العقار."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("50%","2.5%"),new NumPer("50%","65%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("شروط ترخيص صيدلية")}
				pText={Text.Body.Centered.OfText("قبل اختيار محل الصيدلية أو توقيع عقد الإيجار، يجب التأكد من شروط الترخيص الأساسية: أهلية الصيدلي، المسافة، المساحة، الارتفاع، حدود العين، صلاحية العقار، والتجهيزات المطلوبة للمعاينة الثانية.")}
			/>

			<EmoCall id="callHero" OrangeBlack />

		</VrStack>

	</Hero>







	<ESec
		id="secCondTypes"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			Gray2
			pTitle="تصنيف شروط ترخيص صيدلية"
			pDesc="الشروط لا تقع كلها في مرحلة واحدة. بعضها يخص الصيدلي، وبعضها يخص المقر قبل التجهيز، وبعضها يظهر عند المعاينة الأولى، ثم تأتي اشتراطات التشغيل في المعاينة الثانية."
		/>

		<CardsGr
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pCardTitleFnt={Text.H3}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("شروط الصيدلي", "ترخيص مزاولة المهنة، الخبرة، القيد النقابي، وعدد الصيدليات التي يملكها أو يشارك فيها طالب الترخيص.")}
			pTopic2={new Topic("شروط المكان", "المسافة، المساحة، الارتفاع، حدود العين، استقلال الصيدلية، وموقف العقار من الترخيص أو التصالح.")}
			pTopic3={new Topic("المعاينة الأولى", "الفحص الحاسم لصلاحية المقر قبل التشطيب النهائي، ويشمل المسافة والمساحة والارتفاع وحدود العين.")}
			pTopic4={new Topic("المعاينة الثانية", "فحص التشطيبات والتجهيزات والمياه والكهرباء والتهوية والحمام والمعمل والصرف ومطابقة الرسم النهائي.")}
		/>

	</ESec>







	<ESec
		id="secPharmacistCond"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle pTitle="شروط الصيدلي طالب الترخيص" BistageLite />

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("620px", "100%")}
				pTitle={Text.H3.OfText("الشروط الأساسية في طالب الترخيص")}
				pDesc={Text.Body.OfText("هذه البنود تخص الشخص طالب الترخيص، ويجب تجهيز ما يثبتها ضمن الملف.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"أن يكون طالب الترخيص صيدليًا حاصلًا على ترخيص مزاولة المهنة.",
					"أن تكون له خبرة فعلية لا تقل عن سنة في مؤسسة حكومية أو أهلية.",
					"ألا يكون مالكًا أو شريكًا في أكثر من صيدليتين.",
					"أن تكون بياناته النقابية والمهنية قابلة للاستكمال أمام الجهة المختصة.",
					"أن يكون الترخيص والإدارة الفنية باسم الصيدلي الحقيقي، وليس مجرد استخدام اسم صيدلي لصالح ممول أو شريك غير صيدلي."
				]}
			/>

			<CardsGr
				pWidth={new RespString("500px", "100%")}
				pGrTitle={Text.H3.Centered.OfText("نقاط يجب الانتباه لها")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4.Centered}
				pCardBodyFnt={Text.Body.Centered}
				pStackDir="Col"
				pSpacing={15}
				pTopic1={new Topic("غير الصيدلي", "لا يتعامل ترخيص الصيدلية كترخيص تجاري عادي يصدر لأي مستثمر. يمكن تنظيم المشاركة المالية قانونيًا، لكن الترخيص والإدارة الفنية للصيدلي.")}
				pTopic2={new Topic("عدد الصيدليات", "إذا كان الصيدلي مالكًا أو شريكًا في الحد الأقصى المسموح به، فقد يصبح الطلب غير مقبول حتى لو كان المكان نفسه مطابقًا.")}
				pTopic3={new Topic("الخبرة", "يجب مراجعة شرط الخبرة الفعلية قبل الاعتماد على اسم الصيدلي في طلب الترخيص.")}
			/>

		</HzStack>

	</ESec>







	<ESec
		id="place-conditions"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="شروط مقر الصيدلية قبل التعاقد"
			pDesc="المكان التجاري الناجح لا يعني بالضرورة أنه يصلح للترخيص كصيدلية. يجب فحص العين هندسيًا وقانونيًا قبل الإيجار أو الشراء."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardBg={new ElemBg(Colors.Gray1)}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("هل المسافة مطابقة؟", "يجب ألا تقل المسافة إلى أقرب صيدلية مرخصة عن 100 متر وفق طريقة القياس المتبعة في المعاينة.")}
			pTopic2={new Topic("هل المساحة صافية؟", "المطلوب 25 مترًا مربعًا كمساحة صافية داخلية، وليس مجرد رقم مكتوب في عقد الإيجار.")}
			pTopic3={new Topic("هل الارتفاع كافٍ؟", "يجب مراجعة الارتفاع الصافي بعد التشطيب والسقف المستعار، وليس الارتفاع قبل التنفيذ فقط.")}
			pTopic4={new Topic("هل العين مستقلة؟", "يجب أن تكون الصيدلية محددة الحدود وغير مفتوحة على وحدة سكنية أو محل آخر أو مدخل عقار بصورة مخالفة.")}
		/>

	</ESec>







	<ESec
		id="distance-condition"
		pBg={new ElemBg(Colors.SkyLite)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="شرط المسافة بين الصيدليات"
			pDesc="شرط المسافة هو أكثر شرط يسبب خسائر عملية، لأنه مرتبط بالموقع نفسه، ولا يمكن علاجه عادة بعد التعاقد على المحل."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(520, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("المسافة لا تقاس بالنظر")}
				pText={Text.Body.OfText("يجب فحص أقرب صيدلية مرخصة من كل الاتجاهات، وليس من نفس الشارع فقط. الصيدلية الأقرب قد تكون في شارع جانبي أو شارع موازٍ أو في الجهة المقابلة. لذلك لا يكفي تقدير المسافة بالعين أو الاعتماد على خريطة الهاتف وحدها.")}
			/>

			<EmoList
				pWidth={new RespString("580px", "100%")}
				pTitle={Text.H3.OfText("ما الذي يراجع في شرط المسافة؟")}
				pDesc={Text.Body.OfText("يجب توثيق قراءة المسافة قبل دفع مقدم أو تجهيز ملف الترخيص.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"تحديد أقرب الصيدليات المرخصة من جميع الاتجاهات المحيطة.",
					"قياس المسار العملي للمشاة من باب الصيدلية إلى باب أقرب صيدلية.",
					"مراجعة التقاطعات والشوارع الجانبية والشوارع الموازية.",
					"توضيح المسار داخل كروكي الموقع أو الرسم الهندسي عند الحاجة.",
					"تجنب التعاقد على محل قبل حسم شرط المسافة."
				]}
			/>

		</HzStack>

	</ESec>







	<EmoStrip
		id="area-height"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("المساحة والارتفاع في ترخيص الصيدلية")}
				pText={Text.Body.Centered.OfText("المساحة والارتفاع يتم فحصهما على الطبيعة، لذلك يجب الاعتماد على رفع مقاسات هندسي وليس على وصف المالك أو بيانات العقد فقط.")}
				pSize={new Size(new NumPer(980, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("شرط المساحة الصافية")}
				pDesc={Text.Body.OfText("أقل مساحة مطلوبة لترخيص الصيدلية 25 مترًا مربعًا كمساحة صافية داخلية.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"المساحة المعتمدة هي المساحة الصافية القابلة للاستخدام داخل حدود الصيدلية.",
					"لا يتم الاعتماد على المساحة المكتوبة في عقد الإيجار وحدها.",
					"يجب مراعاة تأثير الأعمدة والحوائط والبروزات وفروق المناسيب.",
					"الحمام أو المعمل إذا وجدا داخل حدود الصيدلية يجب أن يظهرا في الرسم.",
					"يجب أن تكون الأبعاد والمساحة واضحة في الرسم الهندسي المقدم."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("شرط الارتفاع الصافي")}
				pDesc={Text.Body.OfText("أقل ارتفاع صالح لترخيص الصيدلية 2.60 متر، ويجب حسابه بعد أي تشطيبات مؤثرة.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"يقاس الارتفاع من منسوب تشطيب الأرضية إلى باطن السقف المؤثر.",
					"السقف المستعار قد يقلل الارتفاع المقبول في المعاينة.",
					"رفع الأرضية أو تركيب دكتات تكييف قد يؤثر في نقاط محددة من الفراغ.",
					"يجب حساب الارتفاع قبل تنفيذ الديكورات النهائية.",
					"في حالة وجود أكثر من مستوى يجب مراجعة كل مستوى على حدة."
				]}
			/>

		</HzStack>

	</EmoStrip>







	<ESec
		id="independent-unit"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="حدود العين واستقلال الصيدلية"
			pDesc="الصيدلية يجب أن تكون عينًا واضحة مستقلة، وليست جزءًا مفتوحًا من محل أكبر أو وحدة متصلة بنشاط آخر."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/",
					"PhRet.webp",
					false,
					"استقلال مقر الصيدلية",
					new Size(new NumPer(440, 300), new NumPer("auto", "auto"))
				)}
			/>

			<EmoList
				pWidth={new RespString("620px", "100%")}
				pTitle={Text.H3.OfText("متى تكون العين غير مناسبة؟")}
				pDesc={Text.Body.OfText("هذه الحالات يجب علاجها قبل المعاينة، أو تجنب المكان إذا كان العلاج غير ممكن.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"إذا كانت الصيدلية مفتوحة على وحدة سكنية أو محل آخر.",
					"إذا كان الدخول أو التشغيل مرتبطًا بمدخل عقار بصورة مخالفة.",
					"إذا لم تكن حدود العين واضحة بحوائط وسقف وفتحة دخول.",
					"إذا كان الحمام أو المعمل تابعًا لوحدة أخرى خارج حدود الصيدلية.",
					"إذا كانت العين جزءًا من مساحة أكبر لم يتم فصلها فعليًا."
				]}
			/>

		</HzStack>

	</ESec>







	<ESec
		id="secTwoFloors"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			Gray3
			pTitle="ترخيص صيدلية على دورين أو بميزانين"
			pDesc="وجود ميزانين أو صندرة أو دور علوي لا يعني قبوله تلقائيًا ضمن الصيدلية. يجب فحص المساحة والارتفاع والاتصال الداخلي والاستقلال."
		/>

		<CardsGr
			pGrTitle={Text.H3.Centered.OfText("نقاط فحص الصيدلية متعددة المستويات")}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("الدور الأرضي", "يجب مراجعة مساحة الدور الأرضي وحدوده، لأنه هو أساس التعامل مع الصيدلية ومدخلها وتشغيلها.")}
			pTopic2={new Topic("السلم الداخلي", "الاتصال بين المستويات يجب أن يكون داخليًا ضمن حدود الصيدلية، وليس من خلال مدخل خارجي أو وحدة أخرى.")}
			pTopic3={new Topic("الارتفاع", "كل مستوى مستخدم يجب أن يراجع من حيث الارتفاع الصافي، خصوصًا تحت الميزانين أو الصندرة.")}
			pTopic4={new Topic("الاستقلال", "لا يصح أن يتصل أي مستوى بنشاط آخر أو مسكن أو مساحة غير داخلة في الترخيص.")}
		/>

	</ESec>







	<ESec
		id="secInspection1"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("شروط المعاينة الأولى للصيدلية")}
				pText={Text.Body.Centered.OfText("المعاينة الأولى تفحص صلاحية المقر مبدئيًا. هذه المرحلة تحسم أغلب المخاطر التي لا يمكن إصلاحها بسهولة بعد اختيار المكان.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<EmoList
			pWidth={new RespString("1000px", "100%")}
			pTitle={Text.H3.Centered.OfText("ما الذي تفحصه المعاينة الأولى؟")}
			pDesc={Text.Body.Centered.OfText("إذا فشل المكان في شرط جوهري من هذه البنود فقد يتم حفظ الطلب أو رفض استكماله.")}
			pHeadBg={new ElemBg(Colors.SkyLite)}
			pItemsBg={new ElemBg(Colors.Gray1)}
			pItemFnt={Text.Body}
			pNumbered={true}
			pItems={[
				"تحقق شرط المسافة عن أقرب صيدلية مرخصة.",
				"تحقق الحد الأدنى للمساحة الصافية.",
				"تحقق الحد الأدنى للارتفاع الصافي.",
				"وضوح حدود العين ووجود جوانب وسقف وفتحة دخول.",
				"مطابقة الرسم الهندسي المقدم للحالة الفعلية.",
				"عدم وجود اتصال مخالف بوحدة سكنية أو محل آخر أو مدخل عقار.",
				"إمكانية استكمال التجهيزات المطلوبة للمعاينة الثانية دون مخالفة شروط الترخيص."
			]}
		/>

	</ESec>







	<ESec
		id="secInspection2"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			SkyLite
			pTitle="شروط المعاينة الثانية للصيدلية"
			pDesc="بعد قبول المكان مبدئيًا، يتم تجهيز الصيدلية للمعاينة الثانية. هنا يتم فحص الحالة النهائية للتشطيب والتشغيل وليس مجرد صلاحية الموقع."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("التجهيزات الصحية والتشطيب")}
				pDesc={Text.Body.OfText("بنود تظهر غالبًا عند فحص الحالة النهائية للصيدلية.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"توفير حوض معمل مناسب مع رخامة جانبية عند الحاجة.",
