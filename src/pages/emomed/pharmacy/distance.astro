---
import BLayout from "@/Layout.astro";
import Price from "@/Widgets/Prices/Price.astro";
import { Hero, IndexSec, ESec, Emograph, EmoList, EmoBtn, DataCard, SecTitle, VrStack, HzStack } from "@/Widgets";
import { Text, ElemBg, Size, RespString, EmoMediaData, Colors } from "@/TypesLib";
import IndexBtn from "@/Widgets/Comp/IndexLinkButton.astro";
---




















<BLayout
	pSchemaType="Service"
	pTitle="المتر ما بيعديش !! | خدمات قياس المسافة بين الصيدليات"
	pDescr="قياس دقيق للمسافة بين الصيدليات طبقاً للأسلوب المتبع من قبل هيئة الدواء المصرية للتحقق من شرط المسافة لأقرب صيدلية قبل المبادرة بالشراء أو الاستئجار."
>







	<Hero
		pTitle="خدمات قياس المسافة بين الصيدليات"
		pDesc="قياس دقيق للمسافة بين الصيدليات طبقاً للأسلوب المتبع من قبل هيئة الدواء المصرية ، للتحقق من شرط المسافة لأقرب صيدلية قبل المبادرة بالشراء أو الاستئجار"
		pTitleClr="#f7ca34"
		pDescClr="#ffffff"
		pAlign="right"
		pPosL="38% 45% 12% 6%"
		pPosP="48% 8% 8% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="عرض التفاصيل"
			pWidth="190px"
			pHeight="50px"
			pRadius="12px"
			pBgColor="#f7ca34"
			pBgColorHover="#ffffff"
			pBgColorActive="#b8d85e"
			pTextColor="#111111"
			pFontSize="18px"
			onclick="window.location.href='#page-topics'"
		/>

	</Hero>







	<IndexSec
		id="page-topics"
		pMedia={new EmoMediaData("Vid", "/Media/", "IndexBgVid.mp4")}
		pTitleClr="white"
	>

		<VrStack>

			<IndexBtn pText="إلغاء شرط المسافة بين الصيدليات" onclick="window.location.href='#cancel-distance-rule'" />

			<IndexBtn pText="كيفية قياس المسافة بين الصيدليات" onclick="window.location.href='#how-to-measure-distance'" />

			<IndexBtn pText="أمثلة لطريقة القياس لبعض الحالات" onclick="window.location.href='#distance-examples'" />

		</VrStack>

	</IndexSec>







	<ESec id="cancel-distance-rule" pBg={new ElemBg("#ffffff")}>

		<SecTitle
			style = " --StripBg : #2f3340 "
			pTitle="إلغاء شرط المسافة بين الصيدليات"
			pDesc="الشرط لا يزال قائما وله أساس مهني وقانوني واضح"
		/>

		<VrStack>

			<Emograph
				pSize={new Size("min(1100px, 100%)", "auto", "100%", "auto")}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "لماذا لا يتم إلغاء شرط المسافة بين الصيدليات ؟")}
				pText={new Text(0, 19 as any, false, "#222222", "right", "inherit", "بالنظر إلى حقيقة أن أساس مهنة الصيدلة هو تقديم الخدمة الدوائية وليس تجارة الأدوية ، فإن هذا الشرط يعتبر محوريا جدا تقوم على أساسه مهنة الصيدلة والتي تهدف لتقديم الخدمة الصيدلانية إلى أكبر نطاق جغرافي ممكن ، وعدم وجود هذا الشرط يهدم فكرة الخدمة الصيدلانية من أساسها .")}
			/>

			<EmoList
				pWidth={new RespString("min(1100px, 100%)", "100%") as any}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "الموقف القانوني لشرط المسافة بين الصيدليات")}
				pDesc={new Text(0, 18 as any, false, "#222222", "right", "inherit", "يتأيد استمرار العمل بشرط المسافة بين الصيدليات في مصر إلى الآتي :")}
				pItems={[
					{
						Title: "النص القانوني القائم",
						Items: [
							"الشرط منصوص عليه صراحة في المادة 30 من القانون رقم 127 لسنة 1955 بشأن مزاولة مهنة الصيدلة.",
							"لا يمنح الترخيص بإنشاء صيدلية إلا إذا روعي ألا تقل المسافة بينها وبين أقرب صيدلية مرخصة عن مائة متر.",
						],
					},
					{
						Title: "حكم المحكمة الدستورية العليا",
						Items: [
							"قضت المحكمة الدستورية العليا بحكم نهائي بعدم دستورية إلغاء شرط المسافة بين الصيدليات وعدم دستورية الاستثناءات التي كانت تسمح بنقل الصيدلية في حالة هدم العقار أو الحريق دون الالتزام بشرط المسافة.",
							"أصبح شرط المسافة بين الصيدليات لازما أيضا حتى لمثل هذه الحالات ، مما أكد على إلزامية تطبيق هذا الشرط الأساسي.",
						],
					},
				]}
				pNumbered={false}
				pItemFnt={new Text(0, 18 as any, false, "#222222", "right", "inherit", "")}
				pItemsBg={new ElemBg("#f6f7f8")}
			/>

			<Emograph
				pSize={new Size("min(1100px, 100%)", "auto", "100%", "auto")}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "فائدة الالتزام بشرط المسافة بالنسبة للصيدلي")}
				pText={new Text(0, 19 as any, false, "#222222", "right", "inherit", "حماية حقوق الصيدليات القائمة ، حيث يهدف الشرط إلى حماية المراكز القانونية للصيدليات المرخصة بالفعل ، من خلال منع فتح صيدلية جديدة على مسافة قريبة جدًا قد تؤثر بشكل كبير على مبيعاتها .")}
			/>

			<Emograph
				pSize={new Size("min(1100px, 100%)", "auto", "100%", "auto")}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "فائدة الالتزام بشرط المسافة بالنسبة للمرضى")}
				pText={new Text(0, 19 as any, false, "#222222", "right", "inherit", "ضمان التوزيع العادل ، الهدف الأساسي من وجود شرط المسافة هو تنظيم سوق الأدوية والصيدليات ، ومنع المنافسة غير العادلة التي قد تؤدي إلى تكدس الصيدليات في مناطق معينة وحرمان مناطق أخرى من الحصول على الخدمة الصيدلانية ، مما يضمن وصول المرضى للأدوية بسهولة .")}
			/>

		</VrStack>

	</ESec>







	<ESec id="how-to-measure-distance" pBg={new ElemBg("#ffffff")}>

		<SecTitle
			style = " --StripBg : #c9def0 "
			pTitle="كيفية قياس المسافة بين صيدليتين"
			pDesc="المسافة تحتسب كمسار مشاة فعلي وليس كخط هوائي مباشر"
		/>

		<VrStack>

			<Emograph
				pSize={new Size("min(1100px, 100%)", "auto", "100%", "auto")}
				pText={new Text(0, 20 as any, false, "#222222", "right", "inherit", "مسار المشاة الذي يتم حسابه غير مقيد بفتحات الدوران المرورية المخصصة للسيارات ، ولا بمناطق عبور المشاة المخططة في الطريق العام المخصص للسيارات أو فتحات عبور المشاة المفتوحة بالرصيف ، يتم حساب نقطة عبور الطريق للجانب المقابل من أقرب نقطة يمكن للشخص السليم السوي العبور منها فعليا ما دام ارتفاع الرصيف مناسب ويمكن تخطيه .")}
			/>

			<Emograph
				pSize={new Size("min(1100px, 100%)", "auto", "100%", "auto")}
				pText={new Text(0, 20 as any, false, "#222222", "right", "inherit", "ويتم اختيار الصيدلية الثانية التي يتم القياس إليها باعتبارها الأقرب من أي اتجاه ، سواء كانت في نفس الجانب من نفس الشارع الموجود به الصيدلية المطلوب ترخيصها ، أو كانت في الجانب المقابل من نفس الشارع ، أو كانت في شارع عمودي على الشارع الموجود به الصيدلية المراد ترخيصها ، أو كانت في الشارع الموازي السابق أو التالي للشارع الموجود به الصيدلية الأولى .")}
			/>

			<Emograph
				pSize={new Size("min(1100px, 100%)", "auto", "100%", "auto")}
				pText={new Text(0, 20 as any, false, "#222222", "right", "inherit", "يتم قياس المسافة بين الصيدليات باعتبارها طول أقصر مسار للمشاة يمكن للشخص المترجل سلوكه مشيا على الأقدام بين الصيدليتين ، على أن يكون هذا المسار من خطوط مستقيمة عمودية تبدأ من منتصف الباب للصيدلية الأولى وتنتهي عند منتصف الباب للصيدلية الثانية .")}
			/>

		</VrStack>

	</ESec>







