---
import BLayout from "@/Layout.astro";
import { DataCard } from "@/Widgets/Cards";
import { EmoBtn, Emograph, EmoList, HzStack, IndexBtn, SecTitle, VrStack } from "@/Widgets/Comp";
import { Price } from "@/Widgets/Prices";
import { EmoSec, Hero, IndexSec } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import { BadgeFrame, BlurBlob, FloatingIcon, FloatingPanel, GlassCard, SvgDots, TiltCard } from "../../../site/Widgets/Shapes";
import { CardsGr, DivCol, DivStr, EmoCall, Grid, PriceCard, RelServiceItem, RelServices } from "../../../site/Widgets";
import { SvgRadarCard } from "../../../site/Widgets/Cards";
---




















<BLayout
	pSchemaType="Service"
	pTitle="المتر ما بيعديش !! | خدمات قياس المسافة بين الصيدليات"
	pDescr="قياس دقيق للمسافة بين الصيدليات طبقاً للأسلوب المتبع من قبل هيئة الدواء المصرية للتحقق من شرط المسافة لأقرب صيدلية قبل المبادرة بالشراء أو الاستئجار."
>







	<Hero>

		<VrStack
			pBlur={new Pixel(10)}
			pBgOpacity={new Percent(50)}
			pBgColor={new ElemBg(Colors.BlackOff)}
			pLoc={new Loc(new NumPer("10%","2.5%"),new NumPer("30%","10%"))}
			pSize={new Size(new NumPer("45%","95%"))}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.Yellow.OfText("قياس المسافة بين الصيدليات")}
				pText={Text.Body.Centered.White.OfSize(16).OfText("قياس دقيق للمسافة بين الصيدليات طبقاً للأسلوب المتبع من قبل هيئة الدواء المصرية ، للتحقق من شرط المسافة لأقرب صيدلية قبل المبادرة بالشراء أو الاستئجار")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="تواصل معنا"
			/>

		</VrStack>

	</Hero>







	<IndexSec pMedia={new EmoMediaData("Vid", "/Media/", "IndexBgVid.mp4")} pTitleClr="white">

		<VrStack>

			<IndexBtn pText="إلغاء شرط المسافة بين الصيدليات" onclick="window.location.href='#cancel-distance-rule'" />

			<IndexBtn pText="كيفية قياس المسافة بين الصيدليات" onclick="window.location.href='#how-to-measure-distance'" />

			<IndexBtn pText="أمثلة لطريقة القياس لبعض الحالات" onclick="window.location.href='#distance-examples'" />

		</VrStack>

	</IndexSec>







	<EmoSec>

		<DivStr
			id="service-summary"
			pBg={new ElemBg("#101820")}
			pMinH={new NumPer(620, 780)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
			pGap={new Pixel(28, 18)}
			pPad={new Pixel(70, 42)}
		>

			<BlurBlob
				pColor="rgba(50,143,232,.42)"
				pColor2="rgba(215,245,140,.34)"
				pBlur={30}
				pLoc={new Loc(new NumPer("-8%", "-30%"), new NumPer("-18%", "-8%"))}
				pSize={new Size(new NumPer("48%", "90%"), new NumPer("55%", "32%"))}
				pZ={1}
			/>

			<SvgDots
				pColor="rgba(255,255,255,.20)"
				pGap={26}
				pDot={2}
				pLoc={new Loc(new NumPer("62%", "8%"), new NumPer("8%", "4%"))}
				pSize={new Size(new NumPer("34%", "84%"), new NumPer("70%", "28%"))}
				pZ={1}
			/>

			<FloatingIcon
				pIcon="pin"
				pBg={Colors.BistageLite}
				pFill={Colors.BlackOff}
				pLoc={new Loc(new NumPer("83%", "74%"), new NumPer("68%", "77%"))}
				pSize={new Size(new NumPer(92, 70), new NumPer(92, 70))}
				pZ={3}
			/>

			<DivCol
				pHzAlign="Start"
				pVrAlign="Start"
				pGap={new Pixel(18, 14)}
				pPad={new Pixel(0)}
			>

				<GlassCard
					pBg="rgba(255,255,255,.10)"
					pBorder="rgba(255,255,255,.22)"
					pRadius={34}
					pBlur={16}
				>

					<VrStack
						pGap={new Pixel(22, 16)}
						pPad={new Pixel(0)}
						pHzAlign="Center"
						pVrAlign="Center"
					>

						<Emograph
							pTitle={Text.H2.Centered.White.OfText("خدمة قياس المسافة بين الصيدليات")}
							pText={Text.Body.Centered.White.OfText("معاينة وقياس ميداني للتأكد من تحقق شرط المسافة قبل شراء أو استئجار مكان صيدلية، بحيث تعرف مبكرًا هل الموقع قابل للدخول في إجراءات الترخيص أم لا.")}
						/>

						<CardsGr
							pWidth={new RespString("100%", "100%")}
							pCardBg={new ElemBg("rgba(255,255,255,.92)")}
							pGrTitle={Text.H4.Centered.Sky.OfText("قرار سريع قبل التعاقد")}
							pCardTitleFnt={Text.H3.Centered.Bistage}
							pCardBodyFnt={Text.Body.Centered}
							pStackDir="Row"
							pTopic1={new Topic("100 م", "الرقم الحاكم في قبول أو رفض الموقع بالنسبة لأقرب صيدلية مرخصة.")}
							pTopic2={new Topic("مسار مشاة", "القياس لا يكون خطًا هوائيًا، بل أقصر مسار مشاة فعلي بين البابين.")}
							pTopic3={new Topic("قبل الإيجار", "الغرض الأساسي تجنب دفع مقدم أو توقيع عقد على محل غير صالح للترخيص.")}
						/>

					</VrStack>

				</GlassCard>

			</DivCol>

			<DivCol
				pHzAlign="Start"
				pVrAlign="Start"
				pGap={new Pixel(18, 14)}
				pPad={new Pixel(0)}
			>

				<FloatingPanel
					pBg="rgba(255,255,255,.88)"
					pBorder="rgba(255,255,255,.62)"
					pAccent={Colors.BistageLite}
				>

					<VrStack
						pGap={new Pixel(18, 14)}
						pPad={new Pixel(0)}
						pHzAlign="Center"
						pVrAlign="Center"
					>

						<SvgRadarCard
							fTitle="رادار أقرب صيدلية"
							fText="نحدد الصيدلية الأقرب من نفس الشارع أو المقابل أو الشارع الجانبي أو الموازي، ثم نحسب أقصر مسار مشاة فعلي من منتصف الباب إلى منتصف الباب."
							fColor={Colors.BistageLite}
						/>

						<Grid
							pMax={2}
							pMaxP={1}
							pGap={new Pixel(16, 12)}
							pPad={new Pixel(0)}
						>

							<BadgeFrame
								pBadge="البداية"
								pBg="#ffffff"
								pBadgeBg={Colors.SkyDark}
								pColor={Colors.BlackOff}
							>

								<Emograph
									pTitle={Text.H4.Centered.Sky.OfText("منتصف باب المحل")}
									pText={Text.Body.Centered.OfText("نقطة القياس تبدأ من منتصف باب الصيدلية المطلوب ترخيصها.")}
								/>

							</BadgeFrame>

							<BadgeFrame
								pBadge="النهاية"
								pBg="#ffffff"
								pBadgeBg={Colors.Bistage}
								pColor={Colors.BlackOff}
							>

								<Emograph
									pTitle={Text.H4.Centered.Bistage.OfText("منتصف باب الأقرب")}
									pText={Text.Body.Centered.OfText("النهاية عند منتصف باب أقرب صيدلية مرخصة من أي اتجاه مؤثر.")}
								/>

							</BadgeFrame>

						</Grid>

					</VrStack>

				</FloatingPanel>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec Service>

		<DivStr
			id="service-price"
			pBg={new ElemBg("#F5F1E8")}
			pMinH={new NumPer(560, 720)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
			pGap={new Pixel(28, 18)}
			pPad={new Pixel(70, 42)}
		>

			<BlurBlob
				pColor="rgba(247,202,52,.46)"
				pColor2="rgba(50,143,232,.22)"
				pBlur={34}
				pLoc={new Loc(new NumPer("68%", "46%"), new NumPer("-14%", "-7%"))}
				pSize={new Size(new NumPer("42%", "78%"), new NumPer("46%", "28%"))}
				pZ={1}
			/>

			<SvgDots
				pColor="rgba(16,24,32,.13)"
				pGap={22}
				pDot={2}
				pLoc={new Loc(new NumPer("3%", "6%"), new NumPer("60%", "70%"))}
				pSize={new Size(new NumPer("38%", "78%"), new NumPer("34%", "24%"))}
				pZ={1}
			/>

			<DivCol
				pHzAlign="Center"
				pVrAlign="Center"
				pGap={new Pixel(20, 14)}
				pPad={new Pixel(0)}
			>

				<TiltCard
					pBg={Colors.BlackOff}
					pColor={Colors.WhiteOff}
					pTilt={-2}
				>

					<VrStack
						pGap={new Pixel(20, 14)}
						pPad={new Pixel(0)}
						pHzAlign="Center"
						pVrAlign="Center"
					>

						<PriceCard
							data-own-size
							pCaption={Text.H6.White.Bold.OfText("قيمة خدمة قياس المسافة")}
							pStart={Text.H3.Bold.OfText("السعر")}
							pPrice="1000"
							pPriceFnt={Text.H3.OfSize(42, 30).Bold.WithColor(Colors.SkyDark)}
							pCurrency={Text.H3.OfSize(24, 18).Bold.OfText("جنيه")}
						/>

						<Emograph
							pTitle={Text.H3.Centered.Bistage.OfText("بنود الخدمة")}
							pText={Text.Body.Centered.White.OfText("التكلفة مقابل معاينة المكان وقياس المسافة لأقرب صيدلية وإبلاغك بالنتيجة العملية قبل بدء إجراءات الترخيص أو التعاقد على المحل.")}
						/>

					</VrStack>

				</TiltCard>

			</DivCol>

			<DivCol
				pHzAlign="Start"
				pVrAlign="Start"
				pGap={new Pixel(18, 14)}
				pPad={new Pixel(0)}
			>

				<GlassCard
					pBg="rgba(255,255,255,.86)"
					pBorder="rgba(255,255,255,.90)"
					pRadius={34}
					pBlur={10}
				>

					<VrStack
						pGap={new Pixel(22, 16)}
						pPad={new Pixel(0)}
						pHzAlign="Center"
						pVrAlign="Center"
					>

						<Emograph
							pTitle={Text.H2.Centered.OfText("نطاق الخدمة والسعر")}
							pText={Text.Body.Centered.OfText("الخدمة متاحة داخل القاهرة والجيزة. يتم استخدامها كفحص أولي سريع قبل الدخول في التزامات مالية أو إجراءات ترخيص قد تتعطل بسبب شرط المسافة.")}
						/>

						<CardsGr
							pWidth={new RespString("100%", "100%")}
							pCardBg={new ElemBg("#ffffff")}
							pGrTitle={Text.H4.Centered.Sky.OfText("ما الذي تحصل عليه؟")}
							pCardTitleFnt={Text.H4.Centered.Bistage}
							pCardBodyFnt={Text.Body.Centered}
							pStackDir="Col"
							pTopic1={new Topic("معاينة الموقع", "تحديد باب الصيدلية المقترحة ونطاق البحث عن أقرب صيدلية مرخصة.")}
							pTopic2={new Topic("حساب المسار", "قياس أقصر مسار مشاة فعلي طبقًا لطبيعة الشوارع والأرصفة ونقاط العبور الممكنة.")}
							pTopic3={new Topic("قرار قبل التعاقد", "توضيح هل الموقع مطمئن من ناحية شرط المسافة أم يحتاج استبعاد أو مراجعة.")}
						/>

						<HzStack
							pGap={new Pixel(14, 10)}
							pPad={new Pixel(0)}
							data-fit-content
						>

							<EmoCall
								data-own-size
								BlackSky
								pText="اتصال مباشر"
								pWidth="190px"
								pHeight="54px"
								pRadius="18px"
							/>

							<EmoBtn
								data-own-size
								pText="واتساب"
								pWidth="190px"
								pHeight="54px"
								pRadius="18px"
								pBgColor="#22c55e"
								pBgColorHover="#16a34a"
								pTextColor="#ffffff"
								pFontSize="18px"
								onclick="window.location.href='https://wa.me/201014490054'"
							/>

						</HzStack>

					</VrStack>

				</GlassCard>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec id="cancel-distance-rule" pBg={new ElemBg("#ffffff")}>

		<SecTitle
			style = " --StripBg : #2f3340 "
			pTitle="إلغاء شرط المسافة بين الصيدليات"
			pDesc="الشرط لا يزال قائما وله أساس مهني وقانوني واضح"
		/>

		<VrStack>

			<Emograph
				pSize={new Size(new NumPer("min(1100px, 100%)", "100%"), new NumPer("auto", "auto"))}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "لماذا لا يتم إلغاء شرط المسافة بين الصيدليات ؟")}
				pText={new Text(0, 19 as any, false, "#222222", "right", "inherit", "بالنظر إلى حقيقة أن أساس مهنة الصيدلة هو تقديم الخدمة الدوائية وليس تجارة الأدوية ، فإن هذا الشرط يعتبر محوريا جدا تقوم على أساسه مهنة الصيدلة والتي تهدف لتقديم الخدمة الصيدلانية إلى أكبر نطاق جغرافي ممكن ، وعدم وجود هذا الشرط يهدم فكرة الخدمة الصيدلانية من أساسها .")}
			/>

			<EmoList
				pWidth={new RespString("min(1100px, 100%)", "100%") as any}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "الموقف القانوني لشرط المسافة بين الصيدليات")}
				pDesc={new Text(0, 18 as any, false, "#222222", "right", "inherit", "يتأيد استمرار العمل بشرط المسافة بين الصيدليات في مصر إلى الآتي :")}
				pItems={[
					{
						Title: "النص القانوني القائم",
						Items: [
							"الشرط منصوص عليه صراحة في المادة 30 من القانون رقم 127 لسنة 1955 بشأن مزاولة مهنة الصيدلة.",
							"لا يمنح الترخيص بإنشاء صيدلية إلا إذا روعي ألا تقل المسافة بينها وبين أقرب صيدلية مرخصة عن مائة متر.",
						],
					},
					{
						Title: "حكم المحكمة الدستورية العليا",
						Items: [
							"قضت المحكمة الدستورية العليا بحكم نهائي بعدم دستورية إلغاء شرط المسافة بين الصيدليات وعدم دستورية الاستثناءات التي كانت تسمح بنقل الصيدلية في حالة هدم العقار أو الحريق دون الالتزام بشرط المسافة.",
							"أصبح شرط المسافة بين الصيدليات لازما أيضا حتى لمثل هذه الحالات ، مما أكد على إلزامية تطبيق هذا الشرط الأساسي.",
						],
					},
				]}
				pNumbered={false}
				pItemFnt={new Text(0, 18 as any, false, "#222222", "right", "inherit", "")}
				pItemsBg={new ElemBg("#f6f7f8")}
			/>

			<Emograph
				pSize={new Size(new NumPer("min(1100px, 100%)", "100%"), new NumPer("auto", "auto"))}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "فائدة الالتزام بشرط المسافة بالنسبة للصيدلي")}
				pText={new Text(0, 19 as any, false, "#222222", "right", "inherit", "حماية حقوق الصيدليات القائمة ، حيث يهدف الشرط إلى حماية المراكز القانونية للصيدليات المرخصة بالفعل ، من خلال منع فتح صيدلية جديدة على مسافة قريبة جدًا قد تؤثر بشكل كبير على مبيعاتها .")}
			/>

			<Emograph
				pSize={new Size(new NumPer("min(1100px, 100%)", "100%"), new NumPer("auto", "auto"))}
				pTitle={new Text(3, 26 as any, true, "#6f6b7c", "right", "inherit", "فائدة الالتزام بشرط المسافة بالنسبة للمرضى")}
				pText={new Text(0, 19 as any, false, "#222222", "right", "inherit", "ضمان التوزيع العادل ، الهدف الأساسي من وجود شرط المسافة هو تنظيم سوق الأدوية والصيدليات ، ومنع المنافسة غير العادلة التي قد تؤدي إلى تكدس الصيدليات في مناطق معينة وحرمان مناطق أخرى من الحصول على الخدمة الصيدلانية ، مما يضمن وصول المرضى للأدوية بسهولة .")}
			/>

		</VrStack>

	</EmoSec>







	<EmoSec id="how-to-measure-distance" pBg={new ElemBg("#ffffff")}>

		<SecTitle
			style = " --StripBg : #c9def0 "
			pTitle="كيفية قياس المسافة بين صيدليتين"
			pDesc="المسافة تحتسب كمسار مشاة فعلي وليس كخط هوائي مباشر"
		/>

		<VrStack>

			<Emograph
				pSize={new Size(new NumPer("min(1100px, 100%)", "100%"), new NumPer("auto", "auto"))}
				pText={new Text(0, 20 as any, false, "#222222", "right", "inherit", "مسار المشاة الذي يتم حسابه غير مقيد بفتحات الدوران المرورية المخصصة للسيارات ، ولا بمناطق عبور المشاة المخططة في الطريق العام المخصص للسيارات أو فتحات عبور المشاة المفتوحة بالرصيف ، يتم حساب نقطة عبور الطريق للجانب المقابل من أقرب نقطة يمكن للشخص السليم السوي العبور منها فعليا ما دام ارتفاع الرصيف مناسب ويمكن تخطيه .")}
			/>

			<Emograph
				pSize={new Size(new NumPer("min(1100px, 100%)", "100%"), new NumPer("auto", "auto"))}
				pText={new Text(0, 20 as any, false, "#222222", "right", "inherit", "ويتم اختيار الصيدلية الثانية التي يتم القياس إليها باعتبارها الأقرب من أي اتجاه ، سواء كانت في نفس الجانب من نفس الشارع الموجود به الصيدلية المطلوب ترخيصها ، أو كانت في الجانب المقابل من نفس الشارع ، أو كانت في شارع عمودي على الشارع الموجود به الصيدلية المراد ترخيصها ، أو كانت في الشارع الموازي السابق أو التالي للشارع الموجود به الصيدلية الأولى .")}
			/>

			<Emograph
				pSize={new Size(new NumPer("min(1100px, 100%)", "100%"), new NumPer("auto", "auto"))}
				pText={new Text(0, 20 as any, false, "#222222", "right", "inherit", "يتم قياس المسافة بين الصيدليات باعتبارها طول أقصر مسار للمشاة يمكن للشخص المترجل سلوكه مشيا على الأقدام بين الصيدليتين ، على أن يكون هذا المسار من خطوط مستقيمة عمودية تبدأ من منتصف الباب للصيدلية الأولى وتنتهي عند منتصف الباب للصيدلية الثانية .")}
			/>

		</VrStack>

	</EmoSec>







	<EmoSec id="distance-examples" pBg={new ElemBg("#ffffff")}>

		<SecTitle
			style = " --StripBg : #2f3340 "
			pTitle="أمثلة لطريقة قياس المسافة بين صيدليتين للحالات المختلفة"
			pDesc="كل حالة يتم التعامل معها حسب أقصر مسار مشاة فعلي بين منتصف باب الصيدلية الأولى ومنتصف باب الصيدلية الثانية"
		/>

		<VrStack>

			<DataCard
				style = "
						width : min(980px,100%) ;
						background : #ffffff ;
						border-color : #d8d8d8
					"
				TitleTag="h3"
