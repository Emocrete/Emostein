---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="إجراءات ترخيص صيدلية"
	pDescr="شرح تفصيلي لإجراءات ترخيص صيدلية في مصر من فحص المقر قبل التقديم، تجهيز المستندات، رفع طلب الترخيص عبر برنامج ميكنة التراخيص، المعاينة الأولى، المعاينة الثانية، الاستكمال، إصدار الترخيص، وفتح الصيدلية خلال المهلة القانونية."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("55%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("إجراءات ترخيص صيدلية")}
				pText={Text.Body.Centered.OfText("خطوات عملية لترخيص صيدلية من فحص المكان وتجهيز المستندات، إلى رفع الطلب عبر برنامج ميكنة التراخيص، ثم المعاينة الأولى، والمعاينة الثانية، واستكمال المستندات حتى إصدار الرخصة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec
		id="intro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="إجراءات الترخيص تبدأ قبل رفع الطلب"
			pDesc="رفع الطلب خطوة مهمة، لكنها ليست البداية الحقيقية. البداية الصحيحة هي التأكد من صلاحية المكان وتجهيز المستندات والرسم الهندسي حتى لا يدخل الملف في ملاحظات كان يمكن تجنبها."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(620, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("المسار العملي لترخيص الصيدلية")}
				pText={Text.Body.OfText("إجراءات الترخيص تمر بمسار واضح: فحص مقر الصيدلية، تجهيز مستندات الصيدلي والمقر، إعداد الرسم الهندسي، رفع الطلب عبر برنامج ميكنة التراخيص، مراجعة الملف، المعاينة الأولى، تجهيز الصيدلية، المعاينة الثانية، ثم الاستكمال وإصدار الترخيص.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/",
					"PreparePharmacyFile.webp",
					false,
					"تجهيز ملف ترخيص صيدلية",
					new Size(new NumPer(420, 300), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="procedure-map"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="خريطة إجراءات ترخيص صيدلية"
			pDesc="هذه هي الصورة المختصرة للمسار الكامل قبل الدخول في تفاصيل كل مرحلة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pGrTitle={Text.H3.Centered.OfText("مراحل الملف")}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("قبل التقديم", "فحص المسافة والمساحة والارتفاع وحدود العين وموقف العقار قبل رفع الطلب أو دفع مقدم إيجار.")}
			pTopic2={new Topic("تجهيز الملف", "مستندات الصيدلي، مستندات العين، الرسم الهندسي، وبيانات الطلب المطلوب رفعها على برنامج الميكنة.")}
			pTopic3={new Topic("المعاينات", "المعاينة الأولى لصلاحية المقر، ثم المعاينة الثانية بعد تنفيذ التجهيزات والتشطيبات المطلوبة.")}
			pTopic4={new Topic("إصدار الترخيص", "استكمال المستندات النهائية، مراجعة الملاحظات، إصدار الترخيص، ثم فتح الصيدلية خلال المهلة القانونية.")}
		/>

	</EmoSec>







	<EmoStr
		id="pre-check"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("المرحلة الأولى: فحص مقر الصيدلية قبل التقديم")}
				pText={Text.Body.Centered.OfText("هذه المرحلة تقلل احتمال رفض الملف أو حفظه بسبب عيب جوهري في المكان. لا تبدأ بإجراءات رسمية قبل قراءة صلاحية المقر.")}
				pSize={new Size(new NumPer(980, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("620px", "100%")}
				pTitle={Text.H3.OfText("ما الذي يتم فحصه قبل الطلب؟")}
				pDesc={Text.Body.OfText("الفحص المبكر يحسم هل المقر يستحق الدخول في إجراءات الترخيص أم يجب البحث عن بديل.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"تحديد أقرب الصيدليات المرخصة من كل اتجاه.",
					"قياس المسافة إلى أقرب صيدلية مرخصة.",
					"رفع أبعاد المحل وحساب المساحة الصافية.",
					"قياس الارتفاع الصافي قبل وبعد أي تشطيب مؤثر.",
					"مراجعة حدود العين واستقلالها عن أي نشاط آخر.",
					"مراجعة موقف العقار من الترخيص أو التصالح أو تحويل الاستخدام.",
					"تقدير إمكانية تنفيذ الحمام أو المعمل أو الصرف والتهوية عند الحاجة."
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/",
					"Inspection.webp",
					false,
					"معاينة مقر الصيدلية قبل الترخيص",
					new Size(new NumPer(420, 300), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		id="pharmacist-docs"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="المرحلة الثانية: تجهيز مستندات الصيدلي"
			pDesc="مستندات طالب الترخيص تثبت أهلية الصيدلي وتطابق بياناته مع الطلب المقدم."
		/>

		<EmoList
			pWidth={new RespString("1000px", "100%")}
			pTitle={Text.H3.Centered.OfText("مستندات الصيدلي الأساسية")}
			pDesc={Text.Body.Centered.OfText("قد تختلف التفاصيل أو الصيغة حسب متطلبات الجهة المختصة وقت التقديم، لكن هذه هي المستندات التي يجب الاستعداد بها مبكرًا.")}
			pHeadBg={new ElemBg(Colors.BistageLite)}
			pItemsBg={new ElemBg(Colors.Gray1)}
			pItemFnt={Text.Body}
			pNumbered={true}
			pItems={[
				"صورة بطاقة الرقم القومي أو جواز السفر، ويجب أن يكون المستند ساريًا.",
				"صورة ترخيص مزاولة المهنة.",
				"صورة كارنيه النقابة العامة للصيادلة أو ما يثبت القيد أو سداد الاشتراك حسب المطلوب.",
				"مستخرج شهادة ميلاد كمبيوتر عند طلبه ضمن الملف.",
				"صحيفة حالة جنائية حديثة وموجهة للجهة المختصة.",
				"شهادة أو مستند يوضح موقف الصيدلي من التكليف عند طلبه.",
				"شهادة بعدد الصيدليات المملوكة أو التي يشارك فيها الصيدلي.",
				"بيانات اتصال واضحة لأن الجهة المختصة قد تستخدمها في الإخطارات أو الملاحظات."
			]}
		/>

	</EmoSec>







	<EmoSec
		id="place-docs"
		pBg={new ElemBg(Colors.SkyLite)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="المرحلة الثالثة: تجهيز مستندات مقر الصيدلية"
			pDesc="مستندات المقر تثبت حق شغل العين وموقف العقار والمرافق التي تؤثر في صلاحية الصيدلية للتشغيل."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("مستندات حق شغل العين")}
				pDesc={Text.Body.OfText("يجب أن يكون لصاحب الملف سند واضح لاستعمال المكان محل الترخيص.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"عقد ملكية أو عقد إيجار للعين محل الصيدلية.",
					"مراعاة مدة الإيجار المطلوبة لقبول الملف.",
					"تطابق بيانات العنوان في العقد مع العنوان الذي سيتم رفعه في الطلب.",
					"توضيح حدود العين محل الترخيص إذا كان العقار يضم أكثر من محل أو وحدة.",
					"مراجعة أي قيود تعاقدية تمنع تغيير النشاط أو تنفيذ تعديلات لازمة للترخيص."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("مستندات العقار والمرافق")}
				pDesc={Text.Body.OfText("هذه المستندات قد تظهر في مرحلة التقديم أو الاستكمال حسب حالة العقار.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"مستند يوضح موقف العقار من الترخيص أو التصالح أو التقنين.",
					"مستند يثبت وجود مورد مائي مقبول.",
					"مستند يثبت وجود مصدر كهرباء دائم.",
					"مستندات تحويل الاستخدام أو التصالح عند وجود اختلاف في استخدام العقار.",
					"أي مستند إضافي تطلبه الجهة المختصة حسب موقع الصيدلية وحالة المبنى."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoStr
		id="drawing"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("المرحلة الرابعة: إعداد الرسم الهندسي للصيدلية")}
				pText={Text.Body.Centered.OfText("الرسم الهندسي ليس ملحقًا شكليًا. هو المستند الذي يربط بين بيانات الطلب والمعاينة على الطبيعة.")}
				pSize={new Size(new NumPer(980, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(520, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("رسم للمعاينة الأولى ورسم نهائي")}
				pText={Text.Body.OfText("يستخدم الرسم الأول في إثبات صلاحية المقر مبدئيًا من حيث المساحة والارتفاع والحدود والموقع. بعد التجهيز قد يلزم رسم نهائي مطابق للحالة التي سيتم تشغيل الصيدلية عليها، خاصة إذا حدثت تعديلات في الحمام أو المعمل أو التقسيمات الداخلية.")}
			/>

			<EmoList
				pWidth={new RespString("580px", "100%")}
				pTitle={Text.H3.OfText("بيانات يجب ظهورها في الرسم")}
				pDesc={Text.Body.OfText("كل بند من هذه البنود يساعد في ربط الرسم بالمعاينة.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"المسقط الأفقي للصيدلية.",
					"الأبعاد الداخلية والمساحة الصافية.",
					"أماكن الأعمدة والبروزات والمداخل.",
					"القطاع الرأسي والارتفاع الصافي.",
					"واجهة الصيدلية ومكان المدخل.",
					"كروكي الموقع العام وأقرب صيدلية عند الحاجة.",
					"موضع الحمام أو المعمل إذا وجدا."
				]}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		id="digital-application"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="المرحلة الخامسة: رفع الطلب عبر برنامج ميكنة التراخيص"
			pDesc="يجب تحديث الصفحة هنا بوضوح: المسار الحديث لطلبات ترخيص الصيدليات العامة أصبح من خلال برنامج ميكنة التراخيص، وليس الاعتماد على نص البريد المسجل كطريقة تقديم أساسية."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/",
					"SendReq.webp",
					false,
					"رفع طلب ترخيص صيدلية",
					new Size(new NumPer(420, 300), new NumPer("auto", "auto"))
				)}
			/>

			<EmoList
				pWidth={new RespString("620px", "100%")}
				pTitle={Text.H3.OfText("قبل رفع الطلب إلكترونيًا")}
				pDesc={Text.Body.OfText("رفع الطلب لا يعوض نقص التجهيز. يجب مراجعة الملف قبل إدخال البيانات حتى لا يبدأ المسار بملاحظات مباشرة.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"تجهيز بيانات الصيدلي طالب الترخيص بدقة.",
					"تجهيز عنوان الصيدلية وبيانات العين محل الترخيص.",
					"رفع المستندات المطلوبة بالصيغة والجودة المقبولة.",
					"إرفاق الرسم الهندسي المطلوب للمرحلة.",
					"مراجعة بيانات التواصل لأن الإخطارات والملاحظات قد ترتبط بها.",
					"الاحتفاظ بما يثبت رفع الطلب ورقم المعاملة أو القيد عند ظهوره."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="review-first-inspection"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="المرحلة السادسة: مراجعة الطلب والمعاينة الأولى"
			pDesc="بعد رفع الطلب ومراجعته، تأتي مرحلة المعاينة الأولى التي تختبر صلاحية المقر الأساسية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pGrTitle={Text.H3.Centered.OfText("ما يحدث في هذه المرحلة")}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مراجعة الملف", "تراجع الجهة المختصة البيانات والمستندات المرفوعة، وقد تطلب استكمالًا أو تصحيحًا قبل تحديد المعاينة.")}
			pTopic2={new Topic("تحديد المعاينة", "يتم إخطار طالب الترخيص بموعد المعاينة أو المرحلة التالية وفق النظام والإجراءات المعمول بها.")}
			pTopic3={new Topic("المعاينة الأولى", "يتم فحص المسافة، المساحة، الارتفاع، حدود العين، ومدى مطابقة الرسم للحالة الفعلية.")}
			pTopic4={new Topic("نتيجة المعاينة", "قد يتم قبول المكان مبدئيًا، أو تسجيل ملاحظات، أو حفظ الطلب إذا ظهر عيب جوهري لا يمكن استيفاؤه.")}
		/>

	</EmoSec>







	<EmoStr
		id="after-first-inspection"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("بعد اجتياز المعاينة الأولى")}
				pText={Text.Body.Centered.OfText("بعد قبول المكان مبدئيًا لا يبدأ التشغيل، بل تبدأ مرحلة التجهيز للمعاينة الثانية واستكمال المستندات النهائية.")}
				pSize={new Size(new NumPer(980, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<EmoList
			pWidth={new RespString("1000px", "100%")}
			pTitle={Text.H3.Centered.OfText("ما الذي يتم بعد المعاينة الأولى؟")}
			pDesc={Text.Body.Centered.OfText("هذه المرحلة تتحول من فحص صلاحية المكان إلى تجهيز الصيدلية فعليًا للتشغيل.")}
			pHeadBg={new ElemBg(Colors.SkyLite)}
			pItemsBg={new ElemBg(Colors.Gray1)}
			pItemFnt={Text.Body}
			pNumbered={true}
			pItems={[
