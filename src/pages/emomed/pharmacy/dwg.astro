---
import { Align, Colors, ElemBg, EmoMediaData, HoverColors, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { Badge, CardsGr, DuoCol, DuoStr, EmoBtn, EmoCall, EmoContactStrip, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, PhDwgMonthlyOffer, PriceCard, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, RetailDwgMonthlyOffer, SecTitle, ThemedPriceCardHz, ThemedPriceCardVr, VrStack } from "@/Widgets";
import EmoGallery from "@/Widgets/Media/EmoGallery.astro";
---




















<BLayout
	pSchemaType="Service"
	pTitle="خدمات الرسم الهندسي للصيدليات - معاينة أولى - معاينة ثانية - تعديل رسم هندسي"
	pDescr="خدمة إعداد الرسم الهندسي المطلوب لترخيص صيدلية جديدة اللازم للتقديم للمعاينة الأولى معتمد بختم مهندس نقابي ، والرسم الهندسي للمعاينة الثانية أو تعديل الرسم الهندسي للصيدلية معتمد بختم نقابة المهندسين"
>







	<Hero pImgAlt="واجهة صيدلية مرخصة مفروشة بالأدوية">

		<VrStack
			pSize={new Size(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("52%","2.5%"),new NumPer("20%","60%"))}
			pBgColor={new ElemBg(Colors.Gray5)}
			pBgOpacity={new Percent(50)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("رسم هندسي لصيدلية")}
				pText={Text.Body.Centered.White.OfText("خدمة إعداد الرسم الهندسي المطلوب لترخيص صيدلية جديدة اللازم للتقديم للمعاينة الأولى معتمد بختم مهندس نقابي ، والرسم الهندسي للمعاينة الثانية أو تعديل الرسم الهندسي للصيدلية معتمد بختم نقابة المهندسين")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="للطلب والاستفسار"
			/>

		</VrStack>

		<VrStack
			pLandOnly
			pSize={new Size(new NumPer("60%","95%"))}
			pLoc={new Loc(new NumPer("40%","2.5%"),new NumPer("75%","60%"))}
		>

			<Badge
				pYears={6}
				pWorks={120}
				pDuration={24}
				pDurationText="خلال يوم واحد"
				pUseBg={true}
				pBgColor="white"
			/>

		</VrStack>

	</Hero>







	<ESec data-port-only>

		<Badge
			pYears={6}
			pWorks={120}
			pDuration={24}
			pDurationText="خلال يوم واحد"
		/>

	</ESec>







	<PhDwgMonthlyOffer />







	<ESec id="secDwgStages">

		<SecTitle
			SkyLite
			pTitle="مراحل الرسم الهندسي المطلوب لترخيص صيدلية جديدة"
			pDesc="يتم تقديم الرسم الهندسي للصيدلية مرتين ، أحدهما يرسل كمرفق بطلب ترخيص الصيدلية عند التقديم ، والثاني يقدم كنسخة أخيرة مطابقة للواقع النهائي الذي سيتم تشغيل الصيدلية عليه"
		/>

		<DuoStr
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
			pPad={new Pixel(40,20)}
		>

			<DuoCol pBgColor={new ElemBg(Colors.Gray1)} pPad={new Pixel(30, 10)}>

				<EmoList
					pTitle={Text.H3.Centered.OfText("الرسم الهندسي للمعاينة الأولى")}
					pDesc={Text.Body.OfText("يوفر الرسم الهندسي للمعاينة الأولى للصيدلية المعلومات المبدئية التي توضح صلاحية مقر الصيدلية للترخيص ، واستيفاءه للشروط الثلاثة الأساسية التي يجب توفرها في مقر الصيدلية وهي :")}
					pItems={[
					"بيان تحقق شرط المسافة لأقرب صيدلية وتوضيح موقعها وشكل المسار بين الصيدلية الأخرى والصيدلية المطلوب ترخيصها وأن طول المسافة بين الصيدليتين أكبر من 100 م .",
					"بيان تحقق شرط مساحة الصيدلية من خلال توضيح أبعاد الصيدلية من الداخل والتي يجب أن تكون مساحتها أكبر من 25 م2 .",
					"بيان تحقق شرط ارتفاع الصيدلية وأنه يزيد عن 2.6 م ."
						]}
					pWidth={new RespString("600px","auto")}
				/>

			</DuoCol>

			<DuoCol pBgColor={new ElemBg(Colors.Gray1)} pPad={new Pixel(30, 10)}>

				<Emograph
					pTitle={Text.H3.Centered.OfText("الرسم الهندسي للمعاينة الثانية")}
					pText={Text.Body.OfText("يحتوي الرسم الهندسي للمعاينة الثانية للصيدلية على نفس عناصر الرسم الهندسي للمعاينة الأولى ، ولكن بما يطابق الوضع والأبعاد النهائية للصيدلية بعد اكتمال أعمال التشطيبات والتعديلات التي قد ينفذها الصيدلي صاحب الترخيص مثل إضافة حمام أو معمل أو كليهما .")}
				/>

			</DuoCol>

		</DuoStr>

	</ESec>







	<ESec id="secDwgSpecs">

		<SecTitle
			Sky
			pTitle="شروط الرسم الهندسي المطلوب لترخيص صيدلية"
			pDesc="يجب أن يتضمن الرسم الهندسي لترخيص الصيدلية عدة عناصر رئيسية لتوصيف مقر الصيدلية ، حيث يوضح الرسم الهندسي للمعاينة الأولى مدى استيفاء مقر الصيدلية للشروط القانونية المطلوبة لترخيص الصيدليات وهي ( المسافة - المساحة - الارتفاع ) ، وبناءا على محتوى الرسم الهندسي يتم عمل المعاينة الأولى للصيدلية وتحديد مدى صلاحية الموقع المبدئية لفتح صيدلية . ويوضح الرسم الهندسي للمعاينة الثانية مدى استيفاء المقر للشروط الصحية الخاصة بحوض المعمل والحمام إن وجد"
		/>

		<DuoStr
			id="secDwgTypes"
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/Dwg/Specs",
					"Plan.webp",
					false,
					"مسقط أفقي لصيدلية",
					new Size(new NumPer(600, 310), new NumPer("auto", "auto"))
				)}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("1- مسقط أفقي للصيدلية")}
					pDesc={Text.Body.OfText("المسقط الأفقي هو أهم جزء في الرسم لأنه يوضح المساحة والأبعاد وطريقة توزيع الفراغات داخل العين.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"المساحة الكلية والمساحة الصافية القابلة للاستخدام.",
					"الأبعاد الخارجية والداخلية وسمك الحوائط المؤثرة.",
					"أماكن الأعمدة والبروزات والمداخل والمنافذ.",
					"موقع وأبعاد الحمام أو المعمل إن وجدا، وطريقة الصرف المستخدمة.",
				]}
				/>

			</DuoCol>

		</DuoStr>

		<DuoStr
			id="secDwgTypes"
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("2- قطاع رأسي للصيدلية")}
					pDesc={Text.Body.OfText("القطاع الرأسي يوضح علاقة أرضية الصيدلية بالطريق والارتفاعات الداخلية، وهي نقاط مؤثرة في قبول المقر.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"ارتفاع أرضية الصيدلية بالنسبة للطريق العام.",
					"عدد مستويات الأرضية الداخلية إن وجدت.",
					"ارتفاعات السقف عند كل مستوى.",
					"تأثير السقف المستعار أو أي تجهيز يقلل الارتفاع الصافي.",
				]}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
				"Img",
				"/Media/Emomed/Pharmacy/Dwg/Specs",
				"Sec.webp",
				false,
				"قطاع رأسي لصيدلية",
				new Size(new NumPer(600, 310), new NumPer("auto", "auto"))
			)}
				/>

			</DuoCol>

		</DuoStr>

		<DuoStr
			id="secDwgTypes"
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/Dwg/Specs",
					"Elev.webp",
					false,
					"واجهة الصيدلية",
					new Size(new NumPer(600, 310), new NumPer("auto", "auto"))
				)}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("3- واجهة الصيدلية")}
					pDesc={Text.Body.OfText("الواجهة تربط الرسم بالشكل الخارجي الفعلي للمحل وتوضح مكان المدخل واللافتة والعلاقة بالمداخل والمحال المجاورة.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"مدخل الصيدلية وعرضه وموقعه من الواجهة.",
					"اللافتة النهائية بالاسم التجاري المعتمد لصاحب الترخيص.",
					"موقع الصيدلية بالنسبة إلى مدخل العقار.",
					"ترتيب الصيدلية بالنسبة للمحال المجاورة داخل نفس العقار.",
				]}
				/>

			</DuoCol>

		</DuoStr>

		<DuoStr
			id="secDwgTypes"
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("4- كروكي الموقع العام")}
					pDesc={Text.Body.OfText("كروكي الموقع العام يوضح موقع الصيدلية داخل شبكة الشوارع وعلاقتها بالصيدليات المحيطة والطرق المؤدية إليها.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"الموقع العام للصيدلية والشارع أو الشوارع المؤدية إليها.",
					"الصيدليات المجاورة في المنطقة المحيطة عند الحاجة لتوضيح شرط المسافة.",
					"مسار الحركة بين الصيدلية المطلوب ترخيصها وأقرب صيدلية مرخصة.",
					"المعالم أو التقاطعات التي تساعد لجنة المعاينة على قراءة الموقع.",
				]}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/Dwg/Specs",
					"Map.webp",
					false,
					"كروكي الموقع العام لصيدلية",
					new Size(new NumPer(600, 310), new NumPer("auto", "auto"))
				)}
				/>

			</DuoCol>

		</DuoStr>

	</ESec>







	<ESec id="secSamples">

		<SecTitle BistageLite pTitle="نماذج رسم هندسي لصيدلية" />

		<EmoGallery pFolder="/Media/Emomed/Pharmacy/Dwg/Samples" />

	</ESec>







	<ESec Service>

		<SecTitle BistageLite pTitle="خدمات الرسم الهندسي للصيدليات" />

		<EmoStrip pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<VrStack
				pPad={new Pixel(50,20)}
				pGap={new Pixel(50,20)}
				pHzAlign="Center"
				pVrAlign="Center"
			>

				<ThemedPriceCardHz
					pThemeColor="#097a2f"
					pImage="/Media/Emomed/Pharmacy/Dwg/Offers/First-Visit.webp"
					pIcon="/Media/Emomed/Pharmacy/Dwg/Offers/First-Visit.webp"
					pActionTitle="اطلب الخدمة"
					pActionLink="/emocrete/"
					pSize={new Size(new NumPer(1200,"95%"),new NumPer(500,"auto"))}
					pActionColor="black"
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("رسم هندسي للمعاينة الأولى")}
						pText={Text.Body.Centered.OfText("3 نسخ بختم مهندس نقابي للتقديم مرفقة بطلب ترخيص صيدلية")}
					/>

					<Emograph pTitle={Text.Body.Bold.Centered.OfSize(100,70).OfText("2500")} pText={Text.Body.Centered.OfText("جنيه")} />

				</ThemedPriceCardHz>

				<ThemedPriceCardHz
					pThemeColor="#177737"
					pImage="/Media/Emomed/Pharmacy/Dwg/Offers/First-Visit.webp"
					pIcon="/Media/Emomed/Pharmacy/Dwg/Offers/First-Visit.webp"
					pActionTitle="اطلب الخدمة"
					pActionLink="/emocrete/"
					pSize={new Size(new NumPer(1200,"95%"),new NumPer(500,"auto"))}
					pActionColor="black"
				>

					<VrStack>

						<Emograph
							pTitle={Text.H3.Centered.OfText("رسم هندسي للمعاينة الثانية")}
							pText={Text.Body.Centered.OfText("نسخة أصل مختومة بختم نقابة المهندسين + عدد 2 صورة طبق الأصل بختم حي من مهندس نقابي")}
						/>

						<Emograph pTitle={Text.Body.Bold.Centered.OfSize(100,70).OfText("3500")} pText={Text.Body.Centered.OfText("جنيه")} />

					</VrStack>

				</ThemedPriceCardHz>

				<ThemedPriceCardHz
					pThemeColor="#28c25b"
					pImage="/Media/Emomed/Pharmacy/Dwg/Offers/First-Visit.webp"
					pIcon="/Media/Emomed/Pharmacy/Dwg/Offers/First-Visit.webp"
					pActionTitle="اطلب الخدمة"
					pActionLink="/emocrete/"
					pSize={new Size(new NumPer(1200,"95%"),new NumPer(500,"auto"))}
					pActionColor="black"
				>

					<VrStack>

						<Emograph
							pTitle={Text.H3.Centered.OfText("تعديل الرسم الهندسي لصيدلية")}
							pText={Text.Body.Centered.OfText("نسخة أصل مختومة بختم نقابة المهندسين + عدد 2 صورة طبق الأصل بختم حي من مهندس نقابي")}
						/>

						<Emograph pTitle={Text.Body.Bold.Centered.OfSize(100,70).OfText("4000")} pText={Text.Body.Centered.OfText("جنيه")} />

					</VrStack>

				</ThemedPriceCardHz>

			</VrStack>

		</EmoStrip>

	</ESec>







	<PhDwgMonthlyOffer />







	<EmoFaq>

		<FaqItem
			pQuestion="هل يكفي رسم هندسي واحد لترخيص الصيدلية؟"
			pAnswer="غالبًا يحتاج الملف إلى رسم مبدئي للمعاينة الأولى ثم رسم نهائي مطابق للحالة بعد التجهيز للمعاينة الثانية، خاصة إذا حدثت تعديلات داخلية أو تمت إضافة حمام أو معمل أو تغيير في توزيع الفراغات."
		/>

		<FaqItem
			pQuestion="ما أهم رقم في الرسم الهندسي للصيدلية؟"
			pAnswer="يجب مراجعة المسافة عن أقرب صيدلية، والمساحة الصافية، والارتفاع الصافي. أي خلل في هذه البنود قد يؤثر على قبول المقر."
		/>

		<FaqItem
			pQuestion="هل يمكن إعداد الرسم بدون معاينة الموقع؟"
			pAnswer="لا يفضل ذلك. الرسم المطلوب للترخيص يجب أن يطابق الواقع، لذلك يعتمد على رفع مقاسات فعلي وفحص للعناصر المؤثرة مثل الأعمدة والمداخل والحمام والمعمل والارتفاعات."
		/>

		<FaqItem
			pQuestion="هل الرسم يوضح قياس المسافة بين الصيدليات؟"
			pAnswer="نعم، يجب أن يوضح موقع الصيدلية المطلوب ترخيصها وموقع أقرب صيدلية مرخصة والمسار المستخدم في القياس عندما يكون شرط المسافة محل مراجعة."
		/>

		<FaqItem
			pQuestion="ما الفرق بين رسم الصيدلية ورسم محل تجاري عادي؟"
			pAnswer="رسم الصيدلية يرتبط باشتراطات محددة مثل المسافة بين الصيدليات، المساحة الصافية، الارتفاع، موضع المعمل أو الحمام، وشروط التهوية والصرف، بينما الرسم التجاري العام يركز على النشاط التجاري ومتطلباته البلدية."
		/>

	</EmoFaq>







	<ReadAlso
		pTitle={Text.H2.Centered.OfText("اقرأ أيضًا")}
		pDesc={Text.Body.Centered.OfText("صفحات تساعدك على فهم ملف ترخيص الصيدلية من ناحية الشروط والإجراءات والمسافة.")}
		pHeadBg={new ElemBg(Colors.SkyLite)}
		pBodyBg={new ElemBg(Colors.WhiteOff)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
	>

		<ReadAlsoItem
			pTitle="ترخيص صيدلية"
			pDesc="الصفحة الرئيسية لخدمة ترخيص الصيدليات وخطوات تجهيز الملف."
			pHref="/emomed/pharmacy"
		/>

		<ReadAlsoItem
			pTitle="شروط ترخيص صيدلية"
			pDesc="الشروط الخاصة بالصيدلي والمقر والمعاينة الأولى والثانية."
			pHref="/emomed/pharmacy/cond"
		/>

		<ReadAlsoItem
			pTitle="إجراءات ترخيص صيدلية"
			pDesc="ترتيب خطوات الطلب والمعاينات واستكمال المستندات."
			pHref="/emomed/pharmacy/proc"
		/>

		<ReadAlsoItem
			pTitle="قياس المسافة بين صيدليتين"
			pDesc="فهم شرط المسافة وطريقة قراءته قبل استئجار محل الصيدلية."
			pHref="/emomed/pharmacy/distance"
		/>

	</ReadAlso>







	<RelServices
		pTitle={Text.H2.Centered.WithColor(Colors.BistageLite).OfText("خدمات ذات علاقة")}
		pDesc={Text.Body.Centered.White.OfText("خدمات تجارية مرتبطة بتجهيز ملف الصيدلية أو تنفيذها بعد قبول المقر.")}
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.SkyLite)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
	>

		<RelServiceItem
			pTitle="استخراج ترخيص صيدلية"
			pDesc="مباشرة إجراءات استخراج رخصة صيدلية وتجهيز الملف ومتابعة الملاحظات."
			pHref="/emomed/pharmacy"
			pBtnText="اطلب الخدمة"
		/>

		<RelServiceItem
			pTitle="قياس المسافة بين صيدليتين"
			pDesc="فحص شرط المسافة قبل التعاقد على المحل أو البدء في تجهيزات الصيدلية."
			pHref="/emomed/pharmacy/distance"
			pBtnText="اطلب الخدمة"
		/>

