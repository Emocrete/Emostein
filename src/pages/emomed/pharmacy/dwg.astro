---
import BLayout from "@/Layout.astro";
import { DirectSize, NumPer, Loc, HoverColors, Text, ElemBg, EmoMediaData, Colors, Pixel, Topic, Size, Align, RespString, Percent } from "@/TypesLib";
import { Hero, DuoSec, DuoCol, ESec, PhDwgMonthlyOffer, SecTitle, EmoStrip, ReadAlsoItem, Badge, EmoCall, HzStack, VrStack, CardsGr, PriceCard, EmoList, EmoBtn, EmoContactStrip, Emograph, RespImg, ReadAlso, RelServices, EmoFaq, RetailDwgMonthlyOffer, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لصيدلية"
	pDescr="يعتبر الرسم الهندسي من المستندات الأساسية المطلوبة لترخيص الصيدليات ، يتم تقديم الرسم الهندسي للصيدلية مرتين ، أحدهما يرسل كمرفق بطلب ترخيص الصيدلية عند التقديم ، والثاني يقدم كنسخة أخيرة مطابقة للواقع النهائي الذي سيتم تشغيل الصيدلية عليه ."
>







	<ESec data-hero pImgAlt="واجهة صيدلية مرخصة مفروشة بالأدوية">

		<VrStack
			pSize={new DirectSize(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("52%","2.5%"),new NumPer("20%","60%"))}
			pBgColor={new ElemBg(Colors.Gray5)}
			pBgOpacity={new Percent(50)}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("رسم هندسي لترخيص صيدلية")}
				pText={Text.Body.Centered.White.OfText("يعتبر الرسم الهندسي من المستندات الأساسية المطلوبة لترخيص الصيدليات ، يتم تقديم الرسم الهندسي للصيدلية مرتين ، أحدهما يرسل كمرفق بطلب ترخيص الصيدلية عند التقديم ، والثاني يقدم كنسخة أخيرة مطابقة للواقع النهائي الذي سيتم تشغيل الصيدلية عليه .")}
			/>

			<EmoCall BlackSky pText="للطلب والاستفسار" />

		</VrStack>

		<VrStack
			pLandOnly
			pSize={new DirectSize(new NumPer("60%","95%"))}
			pLoc={new Loc(new NumPer("40%","2.5%"),new NumPer("75%","60%"))}
		>

			<Badge
				pYears={6}
				pWorks={120}
				pDuration={24}
				pDurationText="خلال يوم واحد"
				pUseBg={true}
				pBgColor="white"
			/>

		</VrStack>

	</ESec>







	<ESec data-port-only>

		<Badge
			pYears={6}
			pWorks={120}
			pDuration={24}
			pDurationText="خلال يوم واحد"
		/>

	</ESec>







	<PhDwgMonthlyOffer />







	<DuoSec
		id="secDwgTypes"
		pBg={new ElemBg(Colors.Gray1)}
		pContentSize={new DirectSize(new NumPer("90%", "95%"))}
		pGap={new Pixel(40, 20)}
	>

		<SecTitle
			SkyLite
			pTitle="مراحل الرسم الهندسي المطلوب لترخيص الصيدليات"
			pDesc="يعتبر الرسم الهندسي من المستندات الأساسية المطلوبة لترخيص الصيدليات ، يتم تقديم الرسم الهندسي للصيدلية مرتين ، أحدهما يرسل كمرفق بطلب ترخيص الصيدلية عند التقديم ، والثاني يقدم كنسخة أخيرة مطابقة للواقع النهائي الذي سيتم تشغيل الصيدلية عليه"
		/>

		<DuoCol pBgColor={new ElemBg(Colors.Gray2)} pPad={new Pixel(40, 20)}>

			<EmoList
				pTitle={Text.H3.Centered.OfText("الرسم الهندسي للمعاينة الأولى")}
				pDesc={Text.Body.OfText("يوفر الرسم الهندسي للمعاينة الأولى للصيدلية المعلومات المبدئية التي توضح صلاحية مقر الصيدلية للترخيص ، واستيفاءه للشروط الثلاثة الأساسية التي يجب توفرها في مقر الصيدلية وهي :")}
				pItems={[
							"بيان تحقق شرط المسافة لأقرب صيدلية وتوضيح موقعها وشكل المسار بين الصيدلية الأخرى والصيدلية المطلوب ترخيصها وأن طول المسافة بين الصيدليتين أكبر من 100 م .",
							"بيان تحقق شرط مساحة الصيدلية من خلال توضيح أبعاد الصيدلية من الداخل والتي يجب أن تكون مساحتها أكبر من 25 م2 .",
							"بيان تحقق شرط ارتفاع الصيدلية وأنه يزيد عن 2.6 م ."
								]}
				pWidth={new RespString("600px","auto")}
			/>

		</DuoCol>

		<DuoCol pBgColor={new ElemBg(Colors.Gray2)} pPad={new Pixel(40, 20)}>

			<Emograph
				pTitle={Text.H3.Centered.OfText("الرسم الهندسي للمعاينة الثانية")}
				pText={Text.Body.OfText("يحتوي الرسم الهندسي للمعاينة الثانية للصيدلية على نفس عناصر الرسم الهندسي للمعاينة الأولى ، ولكن بما يطابق الوضع والأبعاد النهائية للصيدلية بعد اكتمال أعمال التشطيبات والتعديلات التي قد ينفذها الصيدلي صاحب الترخيص مثل إضافة حمام أو معمل أو كليهما .")}
			/>

		</DuoCol>

	</DuoSec>







	<ESec id="DwgCond">

		<SecTitle
			Sky
			pTitle="شروط الرسم الهندسي المطلوب لترخيص صيدلية"
			pDesc="يجب أن يتضمن الرسم الهندسي لترخيص الصيدلية عدة عناصر رئيسية لتوصيف مقر الصيدلية وتوضيح مدى استيفاء الرسم للمواصفات المطلوبة لترخيص الصيدليات ، وبناءا على محتوى الرسم الهندسي يتم عمل المعاينة الأولى للصيدلية لعمل مطابقة للرسم الهندسي على الواقع وتحديد مدى صلاحية الموقع لفتح صيدلية ومدى توفر الشروط القانونية والشروط الصحية في مقر الصيدلية"
		/>

		<DuoSec
			id="secDwgTypes"
			pContentSize={new DirectSize(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_fa7d8e9b98f54d95887a69f74be18f3f~mv2.jpg/v1/fill/w_339%2Ch_487%2Cal_c%2Cq_80%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/%D9%85%D8%B3%D9%82%D8%B7%20%D8%A3%D9%81%D9%82%D9%8A%20%D8%B5%D9%8A%D8%AF%D9%84%D9%8A%D8%A9.jpg",
					false,
					"مسقط أفقي لصيدلية",
					new Size(300, "auto", 280, "auto")
				)}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("1- مسقط أفقي للصيدلية")}
					pDesc={Text.Body.OfText("المسقط الأفقي هو أهم جزء في الرسم لأنه يوضح المساحة والأبعاد وطريقة توزيع الفراغات داخل العين.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"المساحة الكلية والمساحة الصافية القابلة للاستخدام.",
					"الأبعاد الخارجية والداخلية وسمك الحوائط المؤثرة.",
					"أماكن الأعمدة والبروزات والمداخل والمنافذ.",
					"موقع وأبعاد الحمام أو المعمل إن وجدا، وطريقة الصرف المستخدمة.",
				]}
				/>

			</DuoCol>

		</DuoSec>

		<DuoSec
			id="secDwgTypes"
			pContentSize={new DirectSize(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("2- قطاع رأسي للصيدلية")}
					pDesc={Text.Body.OfText("القطاع الرأسي يوضح علاقة أرضية الصيدلية بالطريق والارتفاعات الداخلية، وهي نقاط مؤثرة في قبول المقر.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"ارتفاع أرضية الصيدلية بالنسبة للطريق العام.",
					"عدد مستويات الأرضية الداخلية إن وجدت.",
					"ارتفاعات السقف عند كل مستوى.",
					"تأثير السقف المستعار أو أي تجهيز يقلل الارتفاع الصافي.",
				]}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
				"Img",
				"https://static.wixstatic.com/media/",
				"308dfd_79163f45df3849b1b02fe290d77c0b9f~mv2.jpg/v1/fill/w_339%2Ch_421%2Cal_c%2Cq_80%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/%D9%82%D8%B7%D8%A7%D8%B9%20%D8%B1%D8%A3%D8%B3%D9%8A%20%D8%B5%D9%8A%D8%AF%D9%84%D9%8A%D8%A9.jpg",
				false,
				"قطاع رأسي لصيدلية",
				new Size(300, "auto", 280, "auto")
			)}
				/>

			</DuoCol>

		</DuoSec>

		<DuoSec
			id="secDwgTypes"
			pContentSize={new DirectSize(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_489a61b971684fbeacad353b24a08c9c~mv2.jpg/v1/fill/w_680%2Ch_377%2Cal_c%2Cq_80%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/%D9%88%D8%A7%D8%AC%D9%87%D8%A9%20%D8%B5%D9%8A%D8%AF%D9%84%D9%8A%D8%A9.jpg",
					false,
					"واجهة الصيدلية",
					new Size(460, "auto", 300, "auto")
				)}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("3- واجهة الصيدلية")}
					pDesc={Text.Body.OfText("الواجهة تربط الرسم بالشكل الخارجي الفعلي للمحل وتوضح مكان المدخل واللافتة والعلاقة بالمداخل والمحال المجاورة.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"مدخل الصيدلية وعرضه وموقعه من الواجهة.",
					"اللافتة النهائية بالاسم التجاري المعتمد لصاحب الترخيص.",
					"موقع الصيدلية بالنسبة إلى مدخل العقار.",
					"ترتيب الصيدلية بالنسبة للمحال المجاورة داخل نفس العقار.",
				]}
				/>

			</DuoCol>

		</DuoSec>

		<DuoSec
			id="secDwgTypes"
			pContentSize={new DirectSize(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("4- كروكي الموقع العام")}
					pDesc={Text.Body.OfText("كروكي الموقع العام يوضح موقع الصيدلية داخل شبكة الشوارع وعلاقتها بالصيدليات المحيطة والطرق المؤدية إليها.")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"الموقع العام للصيدلية والشارع أو الشوارع المؤدية إليها.",
					"الصيدليات المجاورة في المنطقة المحيطة عند الحاجة لتوضيح شرط المسافة.",
					"مسار الحركة بين الصيدلية المطلوب ترخيصها وأقرب صيدلية مرخصة.",
					"المعالم أو التقاطعات التي تساعد لجنة المعاينة على قراءة الموقع.",
				]}
				/>

			</DuoCol>

			<DuoCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_7706b724c1994401b148a3e252385fdf~mv2.jpg/v1/fill/w_308%2Ch_577%2Cal_c%2Cq_80%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/%D9%83%D8%B1%D9%88%D9%83%D9%8A%20%D8%A7%D9%84%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D8%B9%D8%A7%D9%85%20%D8%B5%D9%8A%D8%AF%D9%84%D9%8A%D8%A9.jpg",
					false,
					"كروكي الموقع العام لصيدلية",
					new Size(280, "auto", 260, "auto")
				)}
				/>

			</DuoCol>

		</DuoSec>

	</ESec>







	<ESec id="DwgSamples">

		<SecTitle
			BistageLite
			pTitle="نماذج رسم هندسي لصيدلية"
			pDesc="نماذج توضح شكل اللوحات الفنية التي يمكن استخدامها في ملف الترخيص، مع ضرورة إعداد الرسم النهائي حسب أبعاد المقر الفعلية وليس نسخ نموذج جاهز."
		/>

		<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_6c6d5166033e45e384ae71f76ef228af~mv2.jpg/v1/fit/w_876%2Ch_636%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_6c6d5166033e45e384ae71f76ef228af~mv2.jpg",
					false,
					"نموذج رسم هندسي لصيدلية",
					new Size(360, "auto", 320, "auto")
				)}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_c03d543506f04c1d9727adb3a1b7668d~mv2.jpg/v1/fit/w_876%2Ch_636%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_c03d543506f04c1d9727adb3a1b7668d~mv2.jpg",
					false,
					"نموذج لوحة رسم هندسي لصيدلية",
					new Size(360, "auto", 320, "auto")
				)}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_a4ef967c230a4775b0d2a6a4c37bfd6b~mv2.jpg/v1/fit/w_876%2Ch_636%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_a4ef967c230a4775b0d2a6a4c37bfd6b~mv2.jpg",
					false,
					"نموذج رسم صيدلية للترخيص",
					new Size(360, "auto", 320, "auto")
				)}
			/>

		</HzStack>

	</ESec>







	<ESec id="secService">

		<SecTitle
			BistageLite
			pTitle="خدمة الرسم الهندسي للمعاينة الأولى"
			pDesc="الخدمة موجهة لصاحب الصيدلية الذي يحتاج لوحة هندسية واضحة ومختومة ضمن ملف الترخيص، مع فحص مبكر للنقاط التي قد تعطل قبول المقر."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("680px", "320px")}
				pTitle={Text.H3.OfText("تشمل الخدمة")}
				pDesc={Text.Body.OfText("بنود العمل التي يتم تنفيذها قبل تسليم الرسم المختوم.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"عمل المعاينة ورفع المقاسات على الطبيعة.",
					"مراجعة تحقق الحد الأدنى المطلوب لمساحة الصيدلية وهو 25 مترًا مربعًا.",
					"مراجعة تحقق الحد الأدنى المطلوب لارتفاع الصيدلية وهو 2.60 متر.",
					"قياس المسافة لأقرب صيدلية ومراجعة تحقق الحد الأدنى للمسافة وهو 100 متر.",
					"إعداد الرسم الهندسي من ثلاث نسخ مختومة بختم مهندس نقابي.",
				]}
			/>

			<CardsGr
				pWidth={new RespString("420px", "320px")}
				pGrTitle={Text.H3.Centered.OfText("قيمة الخدمة")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H3.Centered}
				pCardBodyFnt={Text.Body.Centered}
				pStackDir="Col"
				pSpacing={15}
				pTopic1={new Topic("2500 جنيه", "تبدأ قيمة إعداد الرسم الهندسي للمعاينة الأولى حسب نطاق المعاينة وحالة المقر.")}
				pTopic2={new Topic("3 نسخ", "تسليم نسخ مختومة بختم مهندس نقابي للاستخدام في ملف الترخيص.")}
			/>

		</HzStack>

		<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

			<EmoCall BlackSky pText="اطلب الخدمة" />

			<EmoCall BlackSky pText="اسأل عن الصيدلية" />

		</HzStack>

	</ESec>







	<PhDwgMonthlyOffer />







	<EmoFaq>

		<FaqItem
			pQuestion="هل يكفي رسم هندسي واحد لترخيص الصيدلية؟"
			pAnswer="غالبًا يحتاج الملف إلى رسم مبدئي للمعاينة الأولى ثم رسم نهائي مطابق للحالة بعد التجهيز للمعاينة الثانية، خاصة إذا حدثت تعديلات داخلية أو تمت إضافة حمام أو معمل أو تغيير في توزيع الفراغات."
		/>

		<FaqItem
			pQuestion="ما أهم رقم في الرسم الهندسي للصيدلية؟"
			pAnswer="يجب مراجعة المسافة عن أقرب صيدلية، والمساحة الصافية، والارتفاع الصافي. أي خلل في هذه البنود قد يؤثر على قبول المقر."
		/>

		<FaqItem
			pQuestion="هل يمكن إعداد الرسم بدون معاينة الموقع؟"
			pAnswer="لا يفضل ذلك. الرسم المطلوب للترخيص يجب أن يطابق الواقع، لذلك يعتمد على رفع مقاسات فعلي وفحص للعناصر المؤثرة مثل الأعمدة والمداخل والحمام والمعمل والارتفاعات."
		/>

		<FaqItem
			pQuestion="هل الرسم يوضح قياس المسافة بين الصيدليات؟"
			pAnswer="نعم، يجب أن يوضح موقع الصيدلية المطلوب ترخيصها وموقع أقرب صيدلية مرخصة والمسار المستخدم في القياس عندما يكون شرط المسافة محل مراجعة."
		/>

