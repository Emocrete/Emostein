---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Article"
	pTitle="تسجيل مدير لصيدلية"
	pDescr="الشروط والأوراق والإجراءات المطلوبة لتسجيل مدير لصيدلية ، ونعمل كحلقة وصل بين المديرين وأصحاب الصيدليات"
>







	<Hero>

		<VrStack
			pHzAlign="Center"
			pVrAlign="Center"
			pSize={new Size(new NumPer("40%","98%"))}
			pLoc={new Loc(new NumPer("60%","1%"),new NumPer("55%","70%"))}
			pGap={new Pixel(50,5)}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تسجيل مدير لصيدلية")}
				pText={Text.Body.Centered.OfText("الشروط والأوراق والإجراءات المطلوبة لتسجيل مدير لصيدلية ، ونعمل كحلقة وصل بين المديرين وأصحاب الصيدليات")}
			/>

			<EmoCall
				data-own-size
				BlackOrange
				pText="للطلب والاستفسار"
			/>

		</VrStack>

	</Hero>







</BLayout>
