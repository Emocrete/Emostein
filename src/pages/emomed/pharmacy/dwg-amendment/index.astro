---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { SplitPane, SplitScene, StoryRail, StoryStep } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="تعديل الرسم الهندسي لصيدلية"
	pDescr="تعديل الرسم الهندسي لصيدلية — خدمة متخصصة في الإجراءات الهندسية للمؤسسات الصيدلية، مع مراجعة الحالة الفعلية والرسم والمستندات والتعديلات المطلوبة قبل أو أثناء مسار الترخيص. وفي هذه الصفحة يكون التركيز الخاص على اشتراطات المؤسسة الصيدلية وربط الرسم الهندسي بالحالة الفعلية للمحل. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="تعديل الرسم الهندسي لصيدلية">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("تعديل الرسم الهندسي لصيدلية")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("خدمة متخصصة في الإجراءات الهندسية للمؤسسات الصيدلية، مع مراجعة الحالة الفعلية والرسم والمستندات والتعديلات المطلوبة قبل أو أثناء مسار الترخيص. وفي هذه الصفحة يكون التركيز الخاص على اشتراطات المؤسسة الصيدلية وربط الرسم الهندسي بالحالة الفعلية للمحل.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<StoryRail pBg={Colors.Black} pTrackColor={Colors.Gray4} pAccent={Colors.Bistage} pGap={new RespString("24px","14px")} pPad={new RespString("44px","12px")}>
		<StoryStep pNumber="01" pKicker="البداية" pTitle="فحص الحالة" pText="مراجعة بيانات المؤسسة والمكان مع مراعاة اشتراطات المؤسسة الصيدلية وربط الرسم الهندسي بالحالة الفعلية للمحل." pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<StoryStep pNumber="02" pKicker="المعالجة" pTitle="إعداد المستندات" pText="رفع أو مراجعة الرسم الهندسي عند الحاجة." pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<StoryStep pNumber="03" pKicker="المخرج" pTitle="متابعة الإجراء" pText="تجهيز المستند الفني للإجراء المطلوب." pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
	</StoryRail>

	<SplitScene id="secSrvCost" pBg={Colors.Gray1} pColumns={new RespString("5fr 7fr","1fr")} pGap={new RespString("12px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("القيمة العملية")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("تقلل أخطاء الملف الهندسي وتساعد على اتخاذ القرار قبل التزام العميل بتكلفة تجهيز أو عقد طويل لمكان غير مناسب. ويُراجع القرار هنا تحديدًا في ضوء اشتراطات المؤسسة الصيدلية وربط الرسم الهندسي بالحالة الفعلية للمحل.")} />
		</SplitPane>
		<SplitPane pBg={Colors.WhiteOff} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("السعر المبدئي")} pText={Text.Body.WithColor(Colors.Black).OfText("يبدأ من 3,000 ج.م للخدمة الهندسية البسيطة، ويحدد السعر النهائي حسب الإجراء والزيارات المطلوبة.")} />
		</SplitPane>
	</SplitScene>

</BLayout>
