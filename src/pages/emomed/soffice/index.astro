---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مكتب علمي"
	pDescr="خدمة تجهيز ومتابعة ملف ترخيص مكتب علمي لشركات الأدوية أمام هيئة الدواء المصرية، تشمل مراجعة مستندات الشركة، مدير المكتب العلمي، مخزن العينات، الرسم الهندسي، سند الحيازة، المعاينة، وتجهيز الملف حتى صدور الترخيص."
>







	<Hero
		pImgL="https://www.edaegypt.gov.eg/media/nykldemm/%D9%85%D8%A4%D8%AA%D9%85%D8%B1-%D8%A7%D9%84%D8%B3%D9%81%D8%A7%D8%B1%D8%A9-%D8%A7%D9%84%D8%A7%D9%84%D9%85%D8%A7%D9%86%D9%8A%D8%A9.jpg?anchor=center&height=465&mode=crop&rnd=133505904739170000&width=825"
		pImgP="https://www.edaegypt.gov.eg/media/n30phs3j/%D8%A7%D9%84%D8%BA%D8%B1%D9%81%D8%A9-%D8%A7%D9%84%D8%AA%D8%AC%D8%A7%D8%B1%D9%8A%D8%A9.jpg?anchor=center&height=465&mode=crop&rnd=133565202378870000&width=825"
		pTitle="ترخيص مكتب علمي"
		pDesc="ملف تنظيمي دقيق لشركات الأدوية يبدأ من صفة الشركة ومدير المكتب ومخزن العينات وينتهي برخصة قابلة للتشغيل والدعاية"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="42% 40% 10% 8%"
		pPosP="14% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="راجع ملف المكتب" />

	</Hero>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="ملف ترخيص المكتب العلمي"
			pDesc="المكتب العلمي هو نقطة الشركة أمام هيئة الدواء في ملف الدعاية العلمية، ومخزن العينات، وإخطارات التسجيل، ومتابعة المستحضرات التي ستعمل عليها الشركة داخل مصر"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("الشركة")}
						pText={Text.Body.Centered.OfText("نراجع صفة الشركة، السجل التجاري، علاقتها بالمستحضرات، التفويضات، وسجل المستوردين أو إخطار التسجيل عند الحاجة.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("مدير المكتب")}
						pText={Text.Body.Centered.OfText("مدير المكتب العلمي يكون من أعضاء نقابات المهن الطبية، وتراجع مستنداته المهنية والجنائية والنقابية قبل إرسال الملف.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.OrangeLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("مخزن العينات")}
						pText={Text.Body.Centered.OfText("مخزن العينات يحتاج عنوانًا واضحًا ورسمًا هندسيًا ومطابقة صحية، ومديره يكون صيدليًا متفرغًا وفق ضوابط الدليل.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="متى تحتاج الشركة إلى مكتب علمي؟"
			pDesc="القرار يبدأ من نموذج العمل: شركة مصرية، شركة بالخارج، شركة لها مستحضرات مسجلة، أو كيان يريد تنظيم الدعاية والعينات داخل مصر"
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStr pBg={new ElemBg(Colors.SkyLite)} pSize={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}>

				<HzStack>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("المكتب العلمي ينظم الواجهة العلمية للشركة")}
						pText={Text.Body.WithAlign("right").OfText("ترخيص المكتب العلمي يرتبط بالدعاية العلمية للمستحضرات المسجلة لدى هيئة الدواء المصرية، ومتابعة الموافقات الدعائية، ومخزن العينات، والتواصل التنظيمي مع الإدارة المختصة. لذلك نقرأ ملف الشركة قبل اختيار المقر، لأن المستندات المطلوبة تختلف بين شركة مصرية، وشركة بالخارج، ومكتب مشترك لعدة شركات أو مصانع.")}
						pSize={new Size(new NumPer(720, "100%"), new NumPer("auto", "auto"))}
					/>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://www.edaegypt.gov.eg/media/nykldemm/",
					"%D9%85%D8%A4%D8%AA%D9%85%D8%B1-%D8%A7%D9%84%D8%B3%D9%81%D8%A7%D8%B1%D8%A9-%D8%A7%D9%84%D8%A7%D9%84%D9%85%D8%A7%D9%86%D9%8A%D8%A9.jpg?anchor=center&height=465&mode=crop&rnd=133505904739170000&width=825",
					false,
					"اجتماع تنظيمي في قطاع الدواء",
					new Size(new NumPer(430, "100%"), new NumPer("auto", "auto"))
				)}
					/>

				</HzStack>

			</EmoStr>

		</EmoStr>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStr pBg={new ElemBg(Colors.Creamy)} pSize={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}>

				<HzStack>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://www.edaegypt.gov.eg/media/n30phs3j/",
					"%D8%A7%D9%84%D8%BA%D8%B1%D9%81%D8%A9-%D8%A7%D9%84%D8%AA%D8%AC%D8%A7%D8%B1%D9%8A%D8%A9.jpg?anchor=center&height=465&mode=crop&rnd=133565202378870000&width=825",
					false,
					"اجتماع ممثلي قطاع الدواء",
					new Size(new NumPer(430, "100%"), new NumPer("auto", "auto"))
				)}
					/>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("الترخيص يفتح طريق الدعاية بعد استيفاء الملف")}
						pText={Text.Body.WithAlign("right").OfText("بعد صدور ترخيص المكتب العلمي تمنح الشركة مهلة لبدء العمل في مجال الدعاية بتقديم عقد الدعاية أو البدء في طلبات تخص إخطار التسجيل لدى الإدارة المركزية ذات الصلة. لذلك نجهز الملف بصورة قابلة للتشغيل، بحيث لا تكون الرخصة ورقة منفصلة عن خطة الدعاية والمنتجات والعينات.")}
						pSize={new Size(new NumPer(720, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

			</EmoStr>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="أنواع ملفات المكاتب العلمية"
			pDesc="الملف يتغير حسب مالك المستحضر، ومقر الشركة، والتفويضات، ومخزن العينات، ومدير المكتب"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("شركة داخل مصر")}
					pDesc={Text.Body.Centered.OfText("ملف شركة مصرية ترغب في إنشاء مكتب علمي باسمها")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "صفة الشركة", Items: ["سجل تجاري حديث.", "بيانات الممثل القانوني أو المفوض.", "تحديد اسم المكتب العلمي المقترح."] },
						{ Title: "مدير المكتب", Items: ["عضوية إحدى نقابات المهن الطبية.", "مستندات شخصية وجنائية ونقابية.", "بيان موقف وظيفي حسب الحالة."] },
						{ Title: "مخزن العينات", Items: ["عنوان تفصيلي.", "رسم هندسي.", "صيدلي مسئول متفرغ."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("شركة بالخارج")}
					pDesc={Text.Body.Centered.OfText("ملف مكتب علمي تابع لشركة أجنبية أو خارج مصر")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "خطاب الشركة", Items: ["خطاب موثق من الشركة بالخارج.", "تحديد عنوان المكتب داخل مصر.", "تفويض مدير المكتب العلمي."] },
						{ Title: "التوثيق", Items: ["توثيق من الغرفة التجارية في بلد الشركة.", "تصديق من السفارة المصرية في نفس الدولة."] },
						{ Title: "وكيل أو مستورد", Items: ["مراجعة سجل المستوردين للوكيل أو الموزع المصري عند الحاجة.", "إبراز صلة الشركة الأجنبية بالمنتجات."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("مكتب مشترك")}
					pDesc={Text.Body.Centered.OfText("مقر واحد يمثل أكثر من شركة أو مصنع")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.OrangeLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "أسماء الشركات", Items: ["تظهر الشركات المشتركة في ملف الترخيص.", "تحدد النفقات التي يتحملها كل طرف."] },
						{ Title: "المسئولية", Items: ["توضيح مدير المكتب العلمي.", "توضيح مخزن العينات وعلاقته بكل شركة."] },
						{ Title: "الرسم والحيازة", Items: ["رسم مقر المكتب ومخزن العينات.", "سند حيازة يطابق العنوان التفصيلي."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="مستندات ترخيص مكتب علمي جديد"
			pDesc="نقسم المستندات إلى ملف الشركة، ملف المدير، ملف مخزن العينات، وملف الرسم والحيازة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("ملف الشركة والمقر")}
					pDesc={Text.Body.Centered.OfText("هذه المستندات تثبت صفة طالب الترخيص وعنوان المقر")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "طلب الترخيص", Items: ["طلب على ورق الشركة أو النموذج المخصص.", "توقيع صاحب الصفة أو المفوض.", "تحديد اسم المكتب العلمي ونوع الطلب."] },
						{ Title: "السجل التجاري", Items: ["صورة من السجل التجاري للشركة طالبة الترخيص.", "تقديم الأصل للاطلاع عند الحضور."] },
						{ Title: "سند الحيازة", Items: ["عقد إيجار أو تمليك موثق أو مثبت التاريخ.", "العنوان مكتوب تفصيليًا برقم العقار والدور والشقة.", "الغرض من استخدام العين محدد بوضوح."] },
						{ Title: "تعهدات الشركة", Items: ["تعهد بنشر قرار الموافقة في جريدة الوقائع المصرية.", "تعهد بالاحتفاظ بالرسم الهندسي والرخصة داخل مقر المكتب ومخزن العينات."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("ملف المدير ومخزن العينات")}
					pDesc={Text.Body.Centered.OfText("هذه المستندات تثبت المسئولية الفنية والتنظيمية")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "مدير المكتب العلمي", Items: ["صورة بطاقة الرقم القومي.", "صحيفة حالة جنائية موجهة لهيئة الدواء المصرية.", "شهادة من النقابة المختصة بالقيد بها.", "ترخيص مزاولة المهنة عند الحاجة."] },
						{ Title: "الصيدلي المسئول عن مخزن العينات", Items: ["صورة بطاقة الرقم القومي.", "صحيفة حالة جنائية.", "شهادة قيد بالنقابة.", "إثبات التفرغ أو بيان موقف التكليف حسب الحالة."] },
						{ Title: "الرسم الهندسي", Items: ["رسم معتمد من مهندس نقابي.", "أصل وصورتان.", "مسقط أفقي يوضح أطوال مخزن العينات.", "مسقط رأسي يوضح ارتفاع مخزن العينات."] },
						{ Title: "بيانات العنوان", Items: ["عنوان المكتب العلمي تفصيليًا.", "عنوان مخزن العينات تفصيليًا.", "اسم المدير والصيدلي المسئول ورقم القيد."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="الرسم الهندسي في ملف المكتب العلمي"
			pDesc="الرسم يثبت مقر المكتب ومخزن العينات، ويستخدم في المعاينة لمطابقة العنوان والمساحة والارتفاع والاشتراطات الصحية"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(520, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.Creamy)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://www.planndesignpro.com/admin/uploads/images/",
							"Pharmaceutical-Factory-2D-CAD-Layout-30x60m-Floor-Plans.jpg",
							false,
							"مثال عام لرسم هندسي لمنشأة دوائية",
							new Size(new NumPer(460, "100%"), new NumPer("auto", "auto"))
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("لوحة مقر ومخزن عينات")}
						pText={Text.Body.Centered.OfText("اللوحة تعرض مقر المكتب العلمي ومخزن العينات الملحق به سواء داخل المقر أو خارجه، مع كتابة الاسم والعنوان وختم نقابة المهندسين بعد إجراء المعاينة.")}
						pSize={new Size(new NumPer(460, "100%"), new NumPer("auto", "auto"))}
					/>

					<EmoCall BlackSky pText="افتح خدمة الرسم الهندسي" />

				</VrStack>

				<EmoList
					pWidth={new RespString("700px", "100%")}
					pTitle={Text.H3.Centered.OfText("ماذا نراجع في الرسم؟")}
					pDesc={Text.Body.Centered.OfText("المراجعة الهندسية تسبق إرسال الملف لتقليل ملاحظات المعاينة")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "عنوان المقر", Items: ["اسم المكتب العلمي.", "رقم العقار والدور والشقة.", "حدود العين ومدخلها."] },
						{ Title: "مخزن العينات", Items: ["الأطوال.", "الارتفاع.", "العلاقة بمقر المكتب.", "موقعه داخل المكتب أو خارجه."] },
						{ Title: "المطابقة على الطبيعة", Items: ["المعاينة تطابق الرسم مع الواقع.", "أي اختلاف في العنوان أو الحدود أو المخزن يظهر كملاحظة."] },
						{ Title: "الاشتراطات الصحية", Items: ["تجهيزات مخزن العينات.", "التهوية والنظافة والفصل.", "حفظ العينات بطريقة تمنع التلف أو الاختلاط."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="إجراءات التقديم والمتابعة"
			pDesc="الدليل التنظيمي يعتمد إرسال ملف PDF، ثم مراجعة أولية، ثم حضور بالأصول، ثم معاينة مقر المكتب ومخزن العينات"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

