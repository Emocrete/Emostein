---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoSec, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمكتب علمي"
	pDescr="خدمة إعداد رسم هندسي لمكتب علمي ومخزن عينات لشركات الأدوية أمام هيئة الدواء المصرية، تشمل رفع المقاسات، تحديد مقر المكتب ومخزن العينات، المسقط الأفقي والرأسي، العنوان التفصيلي، سند الحيازة، واعتماد اللوحة هندسيًا لملف الترخيص."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("رسم هندسي لمكتب علمي")}
				pText={Text.Body.Centered.OfText("خدمة إعداد رسم هندسي لمكتب علمي ومخزن عينات لشركات الأدوية أمام هيئة الدواء المصرية، تشمل رفع المقاسات، تحديد مقر المكتب ومخزن العينات، المسقط الأفقي والرأسي، العنوان التفصيلي، سند الحيازة، واعتماد اللوحة هندسيًا لملف الترخيص.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec>

		<SecTitle OrangeLite pTitle="البيانات التي تظهر على الرسم" pDesc="نجهز اللوحة بحيث تجمع بيانات هندسية وتنظيمية تساعد في مراجعة ملف المكتب العلمي" />

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("650px", "100%")}
				pTitle={Text.H3.Centered.OfText("مكونات الرسم")}
				pDesc={Text.Body.Centered.OfText("كل بند له وظيفة مباشرة أثناء المراجعة والمعاينة")}
				pHeadBg={new ElemBg(Colors.WhiteOff)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
						{ Title: "المسقط الأفقي", Items: ["حدود مقر المكتب.", "تقسيمات الفراغات الداخلية.", "موضع مخزن العينات.", "الأطوال الصافية وفتحات الدخول."] },
						{ Title: "المسقط الرأسي", Items: ["الارتفاع الصافي لمخزن العينات.", "أي سقوطات أو كمرات مؤثرة.", "علاقة الأرضية بالسقف والفتحات."] },
						{ Title: "الواجهة والكروكي", Items: ["واجهة العقار أو مدخل الوحدة عند الحاجة.", "كروكي مبسط لموقع العين وحدودها.", "بيان الدور والشقة ورقم العقار."] },
						{ Title: "لوحة البيانات", Items: ["اسم المكتب العلمي.", "اسم الشركة طالبة الترخيص.", "عنوان المقر ومخزن العينات.", "اسم المهندس واعتماد اللوحة."] }
					]}
			/>

		</EmoStr>

	</EmoSec>







	<RelServices>

		<RelServiceItem pTitle="ترخيص مكتب علمي" pDesc="متابعة ملف الترخيص كاملًا من مراجعة المستندات حتى المعاينة وإصدار الترخيص." pHref="/emomed/soffice" />

	</RelServices>







</BLayout>
