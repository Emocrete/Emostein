---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="Service" pTitle="ترخيص مستشفى" pDescr="ترخيص مستشفى">







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("50%","2.5%"),new NumPer("30%","45%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.White.Centered.OfText("ترخيص مستشفى")} pText={Text.Body.White.Centered.OfText("ترخيص مستشفى")} />

			<EmoCall OrangeBlack />

		</VrStack>

	</Hero>







</BLayout>
