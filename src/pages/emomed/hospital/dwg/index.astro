---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمستشفى"
	pDescr="رسم هندسي لمستشفى"
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("50%","2.5%"),new NumPer("30%","45%"))}
			pHzAlign={"Center"}
		>

			<Emograph pTitle={Text.H1.White.Centered.OfText("رسم هندسي لمستشفى")} pText={Text.Body.White.Centered.OfText("رسم هندسي لمستشفى")} />

			<EmoCall OrangeBlack />

		</VrStack>

	</Hero>







</BLayout>
