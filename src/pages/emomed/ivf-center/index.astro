---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, ZigzagItem, ZigzagStory } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مركز إخصاب وأطفال أنابيب"
	pDescr="ترخيص مركز إخصاب وأطفال أنابيب — تجهيز هندسي لمسار ترخيص المنشأة الطبية حسب نوع النشاط، مع مراجعة توزيع الفراغات والخدمات والرسومات والاشتراطات المؤثرة على قبول المكان. ويُبنى نطاق ترخيص مركز إخصاب وأطفال أنابيب على حالة المشروع الفعلية لا على وصف عام للخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="ترخيص مركز إخصاب وأطفال أنابيب">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("ترخيص مركز إخصاب وأطفال أنابيب")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("تجهيز هندسي لمسار ترخيص المنشأة الطبية حسب نوع النشاط، مع مراجعة توزيع الفراغات والخدمات والرسومات والاشتراطات المؤثرة على قبول المكان. ويُبنى نطاق ترخيص مركز إخصاب وأطفال أنابيب على حالة المشروع الفعلية لا على وصف عام للخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<ZigzagStory pBg={Colors.Gray1} pGap={new RespString("36px","18px")} pPad={new RespString("44px","12px")} pAlternate={true}>
		<ZigzagItem pMediaShare={38} pBg={Colors.WhiteOff} pColor={Colors.Black} pMediaBg={Colors.BrownDark} pClip="Diagonal" pClipP="None">
			<Emograph slot="media" pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("فحص")} pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("مراجعة نوع المنشأة والاشتراطات المؤثرة")} />
			<VrStack pGap={new Pixel(12,8)} pPad={new Pixel(26,16)}>
				<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("القرار يبدأ من الواقع")} pText={Text.Body.WithColor(Colors.Black).OfText("يربط قرار استئجار أو تجهيز المكان بالمتطلبات الفنية من البداية، فيقل خطر إعادة التقسيم أو تعديل الخدمات بعد التنفيذ. ويظل القرار النهائي مرتبطًا ببيانات ترخيص مركز إخصاب وأطفال أنابيب نفسها قبل إصدار العرض.")} />
			</VrStack>
		</ZigzagItem>
		<ZigzagItem pMediaShare={42} pBg={Colors.Creamy} pColor={Colors.Black} pMediaBg={Colors.BistageLite} pClip="Arch" pClipP="None">
			<Emograph slot="media" pTitle={Text.H2.Centered.WithColor(Colors.Black).OfText("مخرج")} pText={Text.Body.Centered.WithColor(Colors.Black).OfText("تجهيز الرسومات وملف الإجراءات الهندسية")} />
			<VrStack pGap={new Pixel(12,8)} pPad={new Pixel(26,16)}>
				<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("التجهيز")} pText={Text.Body.WithColor(Colors.Black).OfText("فحص المسقط والخدمات ومسارات الحركة، ثم مراجعة الناتج قبل التسليم.")} />
			</VrStack>
		</ZigzagItem>
	</ZigzagStory>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 8,000 ج.م للمنشآت الصغيرة؛ المراكز والمستشفيات تسعر بعد تحديد الأقسام والمساحة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
