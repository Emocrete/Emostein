---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, ESec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStrip } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمخزن أدوية"
	pDescr="خدمة إعداد رسم هندسي لمخزن أدوية طبقًا لاشتراطات هيئة الدواء المصرية، تشمل رفع المقاسات، المسقط الأفقي، المسقط الرأسي، الواجهة، الكروكي، حدود العين، جدول الأطوال والارتفاع وفتحات التهوية، وتجهيز اللوحة للاعتماد النقابي."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("رسم هندسي لمخزن أدوية")}
				pText={Text.Body.Centered.OfText("لوحة هندسية معتمدة توضح أبعاد المخزن وارتفاعه وواجهته وفتحات التهوية وتجهيزاته قبل معاينة هيئة الدواء المصرية")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<ESec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="بنود الرسم الهندسي"
			pDesc="هذه العناصر يجب ضبطها قبل طباعة اللوحات الثلاث وتقديمها في ملف الترخيص"
		/>

		<EmoStrip
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("البيانات الهندسية على اللوحة")}
					pDesc={Text.Body.Centered.OfText("نرتب اللوحة بحيث تجمع الشكل والمقاسات والبيانات التنظيمية")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المسقط الأفقي", Items: ["إظهار حدود العين كاملة.", "كتابة الأطوال الصافية.", "توضيح المداخل والفتحات والأعمدة والحواجز الداخلية."] },
						{ Title: "المسقط الرأسي", Items: ["إظهار الارتفاع الصافي.", "توضيح بطنية السقف وأي صندرة إن وجدت.", "إظهار العلاقة بين الأرضية والسقف والفتحات."] },
						{ Title: "الواجهة والكروكي", Items: ["رسم واجهة المكان.", "إظهار المدخل المستقل واللافتة عند الحاجة.", "كروكي يوضح حدود العين وموقعها."] },
						{ Title: "جدول البيانات", Items: ["الأطوال.", "الارتفاع.", "فتحات التهوية.", "اسم طالب الترخيص.", "نوع الترخيص.", "عنوان الموقع."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("بيانات الموقع التي نراجعها")}
					pDesc={Text.Body.Centered.OfText("الرسم يطابق الموقع، لذلك لا نعتمد اللوحة قبل مراجعة هذه البنود")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المساحة", Items: ["حساب المساحة التخزينية.", "تحديد أي مساحات لا تدخل في الحساب.", "فصل الفراغات الخدمية عن التخزين عند الحاجة."] },
						{ Title: "الارتفاع", Items: ["قياس الارتفاع الصافي في أكثر من نقطة.", "تحديد أي كمرات أو صندرة أو سقوطات تؤثر على الارتفاع."] },
						{ Title: "التهوية", Items: ["قياس فتحات التهوية.", "تحديد مواقع الشبابيك أو مصدر التهوية الميكانيكية.", "تجهيز جدول واضح للفتحات."] },
						{ Title: "الصرف والمياه", Items: ["مراجعة دورة المياه إن وجدت.", "تحديد مسار الصرف وغرف التفتيش والجاليترب خارج العين.", "تجنب تعارض الصرف مع منطقة التخزين."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			Gray3
			pTitle="مطابقة اشتراطات المخزن على الرسم"
			pDesc="نضع الاشتراطات الحرجة أمامنا أثناء الرسم حتى لا تظهر المشكلة لأول مرة في لجنة المعاينة"
		/>

		<EmoStrip
			pBg={new ElemBg(Colors.Sky)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1200, 340)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("500 م² تخزينية")}
							pText={Text.Body.Centered.White.OfText("نراجع المساحة القابلة للاحتساب، ونفصل أي فراغات خدمية أو صندرة أو عناصر قد تؤثر على قراءة المساحة.")}
							pSize={new Size(new NumPer(320, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("ارتفاع 2.6 م")}
							pText={Text.Body.Centered.White.OfText("نقيس الارتفاع الصافي من الأرضية حتى بطنية السقف، ونوضح أي كمرات أو مناسيب مختلفة داخل المخزن.")}
							pSize={new Size(new NumPer(320, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("عين تجارية مستقلة")}
							pText={Text.Body.Centered.White.OfText("نوضح حدود العين ومدخلها المستقل، ونراجع اتصالها بأي نشاط آخر أو سكن أو جراج قبل إعداد اللوحة.")}
							pSize={new Size(new NumPer(320, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("تهوية وحرارة")}
							pText={Text.Body.Centered.White.OfText("نحدد مصادر التهوية وأماكن قياس الحرارة والرطوبة، ونوضح على الرسم ما يلزم لتوزيع الهواء داخل المخزن.")}
							pSize={new Size(new NumPer(320, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("ثلاجات وتبريد")}
							pText={Text.Body.Centered.White.OfText("نحدد مكان غرفة التبريد أو الثلاجات ومساحة الحركة حولها وارتباطها بمسار التخزين والصرف والاستلام.")}
							pSize={new Size(new NumPer(320, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("مناطق فصل واضحة")}
							pText={Text.Body.Centered.White.OfText("نخصص أماكن للتخزين، منطقة للمرتجعات أو المنتهي، ومناطق حركة واستلام وصرف بحسب طبيعة تشغيل المخزن.")}
							pSize={new Size(new NumPer(320, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle SkyDark pTitle="طريقة العمل في خدمة الرسم" />

		<EmoStrip
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<EmoList
				pWidth={new RespString("1100px", "100%")}
				pTitle={Text.H3.Centered.OfText("من المعاينة إلى اللوحة النهائية")}
				pDesc={Text.Body.Centered.OfText("كل مرحلة تضيف معلومة واضحة على الرسم وتقلل التعديلات بعد الطباعة")}
				pHeadBg={new ElemBg(Colors.Creamy)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					{ Title: "استلام بيانات الموقع", Items: ["العنوان التفصيلي.", "صور الواجهة والمدخل والداخل.", "مساحة تقريبية.", "نوع الحيازة أو العقد.", "موقف الحي أو جهاز المدينة إن وجد."] },
					{ Title: "زيارة رفع المقاسات", Items: ["قياس الأطوال والارتفاعات.", "تحديد الفتحات والأعمدة والكمرات.", "تحديد دورة المياه ومسار الصرف.", "رصد موضع الثلاجات والتهوية."] },
					{ Title: "تحليل صلاحية المكان", Items: ["مطابقة المساحة.", "مطابقة الارتفاع.", "مراجعة الاستقلال والمدخل.", "فحص أي تعارض مع بدروم أو جراج أو نشاط غير مناسب."] },
					{ Title: "إعداد اللوحة", Items: ["رسم المسقط الأفقي.", "إعداد المسقط الرأسي.", "إضافة الواجهة والكروكي.", "إضافة جدول الأطوال والارتفاع وفتحات التهوية."] },
					{ Title: "المراجعة قبل الطباعة", Items: ["مطابقة الرسم مع الواقع.", "مراجعة الاسم والعنوان ونوع الترخيص.", "إخراج اللوحة للطباعة والاعتماد النقابي."] }
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="تقسيمات وظيفية نراعيها في الرسم"
			pDesc="التقسيم الداخلي يساعد على تشغيل المخزن بعد الترخيص ويجعل المعاينة أكثر وضوحًا"
		/>

		<EmoStrip
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("منطقة استلام")}
							pText={Text.Body.Centered.OfText("نقطة واضحة لدخول الكراتين والفواتير ومراجعة الوارد قبل توزيعه داخل المخزن.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("منطقة تخزين")}
							pText={Text.Body.Centered.OfText("مسارات رفوف وباليتات تترك حركة كافية وتمنع تكدس المستحضرات أو ملامسة الحائط والأرض.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("ثلاجات وتبريد")}
							pText={Text.Body.Centered.OfText("تحديد مكان الثلاجات أو غرفة التبريد بحيث تكون قريبة من مسار التشغيل وسهلة المراقبة.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.GreenLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("منتهي الصلاحية")}
							pText={Text.Body.Centered.OfText("منطقة منفصلة وواضحة للمستحضرات منتهية الصلاحية أو المرتجعات حتى لا تختلط بباقي التخزين.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.OrangeLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("منطقة صرف")}
							pText={Text.Body.Centered.OfText("مسار واضح لخروج الطلبات وتجهيز السيارات دون تعارض مع الاستلام أو التخزين الداخلي.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("عدادات مراقبة")}
							pText={Text.Body.Centered.OfText("توزيع نقاط قياس الحرارة والرطوبة في مناطق التخزين والثلاجات حسب طبيعة الفراغ.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("دورة مياه")}
							pText={Text.Body.Centered.OfText("إظهار دورة المياه عند وجودها، ومراجعة تأثيرها على المورد المائي والصرف ومسار التخزين.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("الصندرة")}
							pText={Text.Body.Centered.OfText("تظهر الصندرة على الرسم عند وجودها، مع ارتفاعها وسلمها وحاجزها ومساحتها وتأثيرها على المخزن.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<EmoFaq>

		<FaqItem
			pQuestion="ما مقياس رسم مخزن الأدوية المطلوب؟"
			pAnswer="الدليل التنظيمي يطلب 3 نسخ من الرسم الهندسي للمكان المراد ترخيصه بمقياس رسم 1:50، مع اعتماد وختم مهندس نقابي."
		/>

		<FaqItem
			pQuestion="ما الذي يظهر في الرسم الهندسي؟"
			pAnswer="يظهر المسقط الأفقي بالأطوال، والمسقط الرأسي للارتفاع، والواجهة، والكروكي، وحدود العين، ولوحة بيانات صاحب الترخيص ونوع الترخيص والعنوان، وجدول الأطوال والارتفاع وفتحات التهوية."
		/>

		<FaqItem
			pQuestion="هل يمكن عمل الرسم من عقد أو كروكي فقط؟"
			pAnswer="الرسم المعتمد يحتاج رفع مقاسات فعليًا. العقد أو الكروكي يساعدان في العنوان والحدود، لكن لا يغنيان عن قياس الأطوال والارتفاعات والفتحات على الطبيعة."
		/>

		<FaqItem
			pQuestion="هل الصندرة تدخل في مساحة المخزن؟"
			pAnswer="الصندرة تظهر على الرسم عند وجودها، لكن مساحتها لا تحتسب ضمن المساحة الكلية للمخزن، ولها شروط خاصة في الارتفاع والتهوية والحاجز والسلم."
		/>

		<FaqItem
			pQuestion="هل دورة المياه يجب أن تظهر في الرسم؟"
			pAnswer="نعم، عند وجود دورة مياه يجب إظهارها ومراجعة مسار المياه والصرف؛ لأن وجودها يؤثر على مستندات المياه والصرف وطريقة قراءة الاشتراطات داخل العين."
		/>

		<FaqItem
			pQuestion="ما أهم سبب لتعديل الرسم؟"
			pAnswer="أكثر الملاحظات تأتي من اختلاف الرسم عن الواقع، أو عدم وضوح الارتفاع، أو نقص فتحات التهوية، أو عدم إظهار الحدود والواجهة والكروكي والبيانات المطلوبة."
		/>

	</EmoFaq>







	<RelServices
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.Gray1)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
		pWidth={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}
		pGap={new Pixel(20, 15)}
	>

