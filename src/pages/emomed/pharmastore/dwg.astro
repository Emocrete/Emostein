---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Pixel, EmoMediaData } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, EmoList, RespImg, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمخزن أدوية"
	pDescr="خدمة إعداد رسم هندسي لمخزن أدوية طبقًا لاشتراطات هيئة الدواء المصرية، تشمل رفع المقاسات، المسقط الأفقي، المسقط الرأسي، الواجهة، الكروكي، حدود العين، جدول الأطوال والارتفاع وفتحات التهوية، وتجهيز اللوحة للاعتماد النقابي."
>







	<Hero
		pImgL="https://www.planndesignpro.com/admin/uploads/images/Pharmaceutical-Factory-2D-CAD-Layout-30x60m-Floor-Plans.jpg"
		pImgP="https://www.vaisala.com/sites/default/files/inline-images/LIFT-pharmaceuticals-warehouse-800x450.jpg"
		pTitle="رسم هندسي لمخزن أدوية"
		pDesc="لوحة هندسية معتمدة توضح أبعاد المخزن وارتفاعه وواجهته وفتحات التهوية وتجهيزاته قبل معاينة هيئة الدواء المصرية"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="40% 38% 10% 8%"
		pPosP="14% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="اطلب رفع المقاسات" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="الرسم الهندسي هو بداية ملف مخزن الأدوية"
			pDesc="اللوحة المطلوبة للترخيص تربط بين المساحة الفعلية واشتراطات التخزين والتوزيع الجيد ومعاينة هيئة الدواء"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("رفع مقاسات")}
						pText={Text.Body.Centered.OfText("نقيس الأطوال والارتفاعات وفتحات التهوية والمدخل ودورة المياه ومواقع الأعمدة والصندرة إن وجدت.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("لوحة 1:50")}
						pText={Text.Body.Centered.OfText("نجهز الرسم بمقياس 1:50، مع مسقط أفقي ورأسي وواجهة وكروكي وحدود وجدول بيانات هندسية.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.OrangeLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("اعتماد نقابي")}
						pText={Text.Body.Centered.OfText("تخرج اللوحة بصيغة تصلح للتقديم ضمن ملف الترخيص، مع بيانات صاحب الطلب والعنوان ونوع الترخيص.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="محتوى اللوحة المطلوبة لهيئة الدواء"
			pDesc="الدليل التنظيمي يطلب بيانات هندسية محددة تظهر بوضوح على الرسم وتطابق الواقع أثناء المعاينة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStrip pBg={new ElemBg(Colors.SkyLite)} pSize={new Size(1300, "auto", "calc(100% - 30px)", "auto")}>

				<HzStack>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("اللوحة ليست رسمة مساحة فقط")}
						pText={Text.Body.WithAlign("right").OfText("الرسم المطلوب لمخزن الأدوية يوضح المسقط الأفقي بالأطوال، والمسقط الرأسي للارتفاع، وواجهة العين، ورسمًا كروكيًا للحدود، ولوحة بيانات باسم طالب الترخيص ونوع الترخيص والعنوان، وجدولًا للأطوال والارتفاع وفتحات التهوية. لذلك نبدأ من رفع هندسي دقيق، ثم ننظم المعلومات على لوحة واحدة قابلة للمراجعة أثناء المعاينة.")}
						pSize={new Size(720, "auto", "100%", "auto")}
					/>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://www.planndesignpro.com/admin/uploads/images/",
					"Pharmaceutical-Factory-2D-CAD-Layout-30x60m-Floor-Plans.jpg",
					false,
					"مثال تخطيطي عام لمسقط منشأة دوائية",
					new Size(430, "auto", "100%", "auto")
				)}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStrip pBg={new ElemBg(Colors.Creamy)} pSize={new Size(1300, "auto", "calc(100% - 30px)", "auto")}>

				<HzStack>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://www.vaisala.com/sites/default/files/inline-images/",
					"LIFT-pharmaceuticals-warehouse-800x450.jpg",
					false,
					"مخزن منتجات دوائية منظم",
					new Size(430, "auto", "100%", "auto")
				)}
					/>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("الرسم يقرأ التشغيل قبل الترخيص")}
						pText={Text.Body.WithAlign("right").OfText("توزيع الفراغات داخل مخزن الأدوية يؤثر على الحركة والتخزين والتهوية والتبريد ونقاط الرقابة. نراجع من البداية مواضع الاستلام والصرف والتخزين والثلاجات والمنتجات منتهية الصلاحية ودورة المياه والصندرة إن وجدت، حتى تكون اللوحة قريبة من الواقع التشغيلي.")}
						pSize={new Size(720, "auto", "100%", "auto")}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="بنود الرسم الهندسي"
			pDesc="هذه العناصر يجب ضبطها قبل طباعة اللوحات الثلاث وتقديمها في ملف الترخيص"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("البيانات الهندسية على اللوحة")}
					pDesc={Text.Body.Centered.OfText("نرتب اللوحة بحيث تجمع الشكل والمقاسات والبيانات التنظيمية")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المسقط الأفقي", Items: ["إظهار حدود العين كاملة.", "كتابة الأطوال الصافية.", "توضيح المداخل والفتحات والأعمدة والحواجز الداخلية."] },
						{ Title: "المسقط الرأسي", Items: ["إظهار الارتفاع الصافي.", "توضيح بطنية السقف وأي صندرة إن وجدت.", "إظهار العلاقة بين الأرضية والسقف والفتحات."] },
						{ Title: "الواجهة والكروكي", Items: ["رسم واجهة المكان.", "إظهار المدخل المستقل واللافتة عند الحاجة.", "كروكي يوضح حدود العين وموقعها."] },
						{ Title: "جدول البيانات", Items: ["الأطوال.", "الارتفاع.", "فتحات التهوية.", "اسم طالب الترخيص.", "نوع الترخيص.", "عنوان الموقع."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("بيانات الموقع التي نراجعها")}
					pDesc={Text.Body.Centered.OfText("الرسم يطابق الموقع، لذلك لا نعتمد اللوحة قبل مراجعة هذه البنود")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المساحة", Items: ["حساب المساحة التخزينية.", "تحديد أي مساحات لا تدخل في الحساب.", "فصل الفراغات الخدمية عن التخزين عند الحاجة."] },
						{ Title: "الارتفاع", Items: ["قياس الارتفاع الصافي في أكثر من نقطة.", "تحديد أي كمرات أو صندرة أو سقوطات تؤثر على الارتفاع."] },
						{ Title: "التهوية", Items: ["قياس فتحات التهوية.", "تحديد مواقع الشبابيك أو مصدر التهوية الميكانيكية.", "تجهيز جدول واضح للفتحات."] },
						{ Title: "الصرف والمياه", Items: ["مراجعة دورة المياه إن وجدت.", "تحديد مسار الصرف وغرف التفتيش والجاليترب خارج العين.", "تجنب تعارض الصرف مع منطقة التخزين."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.BlackOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="مطابقة اشتراطات المخزن على الرسم"
			pDesc="نضع الاشتراطات الحرجة أمامنا أثناء الرسم حتى لا تظهر المشكلة لأول مرة في لجنة المعاينة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1200, 340)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("500 م² تخزينية")}
							pText={Text.Body.Centered.White.OfText("نراجع المساحة القابلة للاحتساب، ونفصل أي فراغات خدمية أو صندرة أو عناصر قد تؤثر على قراءة المساحة.")}
							pSize={new Size(320, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("ارتفاع 2.6 م")}
							pText={Text.Body.Centered.White.OfText("نقيس الارتفاع الصافي من الأرضية حتى بطنية السقف، ونوضح أي كمرات أو مناسيب مختلفة داخل المخزن.")}
							pSize={new Size(320, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("عين تجارية مستقلة")}
							pText={Text.Body.Centered.White.OfText("نوضح حدود العين ومدخلها المستقل، ونراجع اتصالها بأي نشاط آخر أو سكن أو جراج قبل إعداد اللوحة.")}
							pSize={new Size(320, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("تهوية وحرارة")}
							pText={Text.Body.Centered.White.OfText("نحدد مصادر التهوية وأماكن قياس الحرارة والرطوبة، ونوضح على الرسم ما يلزم لتوزيع الهواء داخل المخزن.")}
							pSize={new Size(320, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("ثلاجات وتبريد")}
							pText={Text.Body.Centered.White.OfText("نحدد مكان غرفة التبريد أو الثلاجات ومساحة الحركة حولها وارتباطها بمسار التخزين والصرف والاستلام.")}
							pSize={new Size(320, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(360, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Gray5)}
					>

						<Emograph
							pTitle={Text.H4.Centered.White.OfText("مناطق فصل واضحة")}
							pText={Text.Body.Centered.White.OfText("نخصص أماكن للتخزين، منطقة للمرتجعات أو المنتهي، ومناطق حركة واستلام وصرف بحسب طبيعة تشغيل المخزن.")}
							pSize={new Size(320, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="طريقة العمل في خدمة الرسم"
			pDesc="نسير في خطوات واضحة حتى تكون اللوحة قابلة للتقديم والمطابقة على الطبيعة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1100px", "100%")}
				pTitle={Text.H3.Centered.OfText("من المعاينة إلى اللوحة النهائية")}
				pDesc={Text.Body.Centered.OfText("كل مرحلة تضيف معلومة واضحة على الرسم وتقلل التعديلات بعد الطباعة")}
				pHeadBg={new ElemBg(Colors.Creamy)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					{ Title: "استلام بيانات الموقع", Items: ["العنوان التفصيلي.", "صور الواجهة والمدخل والداخل.", "مساحة تقريبية.", "نوع الحيازة أو العقد.", "موقف الحي أو جهاز المدينة إن وجد."] },
					{ Title: "زيارة رفع المقاسات", Items: ["قياس الأطوال والارتفاعات.", "تحديد الفتحات والأعمدة والكمرات.", "تحديد دورة المياه ومسار الصرف.", "رصد موضع الثلاجات والتهوية."] },
					{ Title: "تحليل صلاحية المكان", Items: ["مطابقة المساحة.", "مطابقة الارتفاع.", "مراجعة الاستقلال والمدخل.", "فحص أي تعارض مع بدروم أو جراج أو نشاط غير مناسب."] },
					{ Title: "إعداد اللوحة", Items: ["رسم المسقط الأفقي.", "إعداد المسقط الرأسي.", "إضافة الواجهة والكروكي.", "إضافة جدول الأطوال والارتفاع وفتحات التهوية."] },
					{ Title: "المراجعة قبل الطباعة", Items: ["مطابقة الرسم مع الواقع.", "مراجعة الاسم والعنوان ونوع الترخيص.", "إخراج اللوحة للطباعة والاعتماد النقابي."] }
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="تفاصيل هندسية تؤثر على قبول الرسم"
			pDesc="أخطاء صغيرة في الرفع أو العرض قد تتحول إلى ملاحظة رسمية عند المعاينة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("أخطاء في المسقط")}
					pDesc={Text.Body.Centered.OfText("هذه الأخطاء تجعل الرسم ضعيفًا أمام المعاينة")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.OrangeLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "أطوال غير مغلقة", Items: ["مجموع الأبعاد لا يطابق حدود العين.", "وجود فراغات غير مسماة أو غير مقاسة."] },
						{ Title: "ارتفاع غير واضح", Items: ["إظهار ارتفاع واحد رغم وجود كمرات أو مناسيب مختلفة.", "عدم تحديد بطنية السقف بدقة."] },
						{ Title: "فتحات تهوية ناقصة", Items: ["عدم قياس الفتحات.", "عدم كتابة جدول الفتحات.", "خلط بين فتحات التهوية ومصادر التهوية الميكانيكية."] },
						{ Title: "مرافق غير موضحة", Items: ["دورة مياه غير مرسومة.", "صرف غير محدد.", "غرفة تبريد أو ثلاجات غير ظاهرة في مخطط الحركة."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("ما نضبطه في النسخة النهائية")}
					pDesc={Text.Body.Centered.OfText("المراجعة النهائية تحول الرسم إلى مستند قابل للتقديم")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "عنوان مطابق", Items: ["كتابة العنوان كما سيظهر في الطلب.", "مطابقة الوصف مع عقد الحيازة ومستند الكهرباء."] },
						{ Title: "حدود واضحة", Items: ["إظهار حدود العين.", "إظهار العلاقة مع الجيران والشارع والمدخل."] },
						{ Title: "بيانات منظمة", Items: ["اسم طالب الترخيص.", "نوع الترخيص.", "العنوان.", "مقياس الرسم.", "اسم المهندس واعتماده."] },
