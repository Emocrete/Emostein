---
import { Align, Colors, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مخزن أدوية"
	pDescr="خدمة تجهيز ومتابعة ملف ترخيص مخزن أدوية في مصر، تشمل مراجعة الموقع، الرسم الهندسي، مستندات الترخيص، اشتراطات هيئة الدواء المصرية، معاينة المخزن والسيارات، ملف المدير الصيدلي، ونطاق التوزيع."
>







	<Hero
		pImgL="https://www.vaisala.com/sites/default/files/inline-images/LIFT-pharmaceuticals-warehouse-800x450.jpg"
		pImgP="https://www.edaegypt.gov.eg/media/yhmhaf0p/%D8%B6%D8%A8%D8%B7%D9%8A%D8%A7%D8%AA-30-10.jpg?anchor=center&height=465&mode=crop&rnd=133115990350700000&width=825"
		pTitle="ترخيص مخزن أدوية"
		pDesc="ملف هندسي وتنظيمي دقيق يبدأ من صلاحية الموقع وينتهي برخصة صادرة من هيئة الدواء المصرية"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="42% 42% 10% 8%"
		pPosP="15% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="راجع موقع المخزن" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="ملف ترخيص مخزن الأدوية"
			pDesc="ترخيص مخزن الأدوية يعتمد على صلاحية العين، الرسم الهندسي، اشتراطات التخزين والتوزيع الجيد، مستندات صاحب الترخيص، المدير الصيدلي، والسيارات التابعة للمخزن"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("الموقع")}
						pText={Text.Body.Centered.OfText("المخزن يحتاج عين تجارية واضحة، داخل مدينة، مستقلة عن أي نشاط آخر، وبعيدة عن حالات البدروم والجراج والنشاط السكني أو الإداري.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("الرسم الهندسي")}
						pText={Text.Body.Centered.OfText("الرسم يوضح المسقط الأفقي والرأسي والواجهة والحدود والأطوال والارتفاع وفتحات التهوية، ويعتمد من مهندس نقابي قبل المطابقة على الطبيعة.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.OrangeLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("التشغيل")}
						pText={Text.Body.Centered.OfText("بعد استيفاء الاشتراطات، يرتبط التشغيل بالتخزين الجيد، المدير الصيدلي، السيارات، السجلات، الفواتير، ونطاق التوزيع المرخص.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="اختبار صلاحية الموقع قبل فتح الملف"
			pDesc="أكبر خسارة في ترخيص مخزن الأدوية أن يبدأ العميل في تجهيز عين غير قابلة للترخيص من الأساس"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStrip pBg={new ElemBg(Colors.SkyLite)} pSize={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}>

				<HzStack>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("المعاينة تبدأ من صفة العين")}
						pText={Text.Body.WithAlign("right").OfText("نراجع العنوان والنشاط التجاري وترخيص البناء والحي أو جهاز المدينة، ثم نراجع المساحة والارتفاع والمدخل المستقل وإمكانية فصل المخزن عن أي نشاط آخر. هذه القراءة المبكرة تحدد هل نبدأ ملف ترخيص مخزن أدوية، أم نحتاج تغيير الموقع قبل صرف وقت وتكلفة على رسومات وتجهيزات لن تمر في المعاينة.")}
						pSize={new Size(new NumPer(720, "100%"), new NumPer("auto", "auto"))}
					/>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://www.vaisala.com/sites/default/files/inline-images/",
					"LIFT-pharmaceuticals-warehouse-800x450.jpg",
					false,
					"مخزن منتجات دوائية منظم",
					new Size(new NumPer(430, "100%"), new NumPer("auto", "auto"))
				)}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStrip pBg={new ElemBg(Colors.Creamy)} pSize={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}>

				<HzStack>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://www.edaegypt.gov.eg/media/yhmhaf0p/",
					"%D8%B6%D8%A8%D8%B7%D9%8A%D8%A7%D8%AA-30-10.jpg?anchor=center&height=465&mode=crop&rnd=133115990350700000&width=825",
					false,
					"مخزن أدوية غير منظم ضمن حملات تفتيشية",
					new Size(new NumPer(430, "100%"), new NumPer("auto", "auto"))
				)}
					/>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("موقع المخزن قرار رقابي وتشغيلي")}
						pText={Text.Body.WithAlign("right").OfText("المخزن المرخص يخضع للتفتيش الدوري والمفاجئ. لذلك تصميم المكان وتجهيزه وسجلاته لا تُعامل كبنود شكلية، بل كمنظومة تشغيل كاملة تحمي الترخيص وتقلل الملاحظات عند المعاينة أو بعد بدء النشاط.")}
						pSize={new Size(new NumPer(720, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="اشتراطات المكان التي نراجعها"
			pDesc="الموقع المناسب يوفر مساحة كافية، ارتفاعًا صافياً، فصلًا عن الأنشطة الأخرى، مدخلًا مستقلًا، وتجهيزات صحية وتخزينية قابلة للمطابقة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1200, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("مساحة تخزينية")}
						pText={Text.Body.Centered.OfText("القرار التنظيمي يقرر مساحة تخزينية تجارية لا تقل عن 500 م²، ويجوز تقسيمها على دورين متصلين اتصالًا داخليًا ولهما باب دخول مستقل.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("ارتفاع صافٍ")}
						pText={Text.Body.Centered.OfText("الارتفاع الصافي بين الأرضية وبطنية السقف لا يقل عن 2.6 م، ويتم توضيحه في الرسم الهندسي ومعاينته على الطبيعة.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.GreenLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("استقلال النشاط")}
						pText={Text.Body.Centered.OfText("العين تكون مستقلة عن أي نشاط آخر، ولها مدخل مستقل، ولا تكون بدرومًا أو جراجًا أو نشاطًا سكنيًا أو إداريًا.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.OrangeLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("غرفة تبريد أو ثلاجات")}
						pText={Text.Body.Centered.OfText("تجهيز منطقة تبريد أو ثلاجات مزودة بميزان حرارة للأدوية التي تحتاج درجات حرارة أقل من درجة حرارة الغرفة، مع تسجيل القراءات بانتظام.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("أرضيات وحوائط قابلة للتنظيف")}
						pText={Text.Body.Centered.OfText("الحوائط تغطى بمواد سهلة التنظيف، والأرضيات تكون ملساء ملحومة الفواصل ومن مواد غير قابلة للاشتعال.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("رفوف ومسافات تخزين")}
						pText={Text.Body.Centered.OfText("الأدوية توضع على قوائم أو رفوف غير قابلة للاحتراق، بارتفاع 45 سم عن الأرض، مع ترك مسافات عن الحائط والسقف حسب الاشتراطات.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="مستندات ترخيص مخزن أدوية"
			pDesc="الملف ينقسم إلى مستندات أساسية لفتح الطلب، ومستندات تستكمل أثناء الإجراءات وقبل إصدار الرخصة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات فتح الطلب")}
					pDesc={Text.Body.Centered.OfText("هذه المجموعة تُبنى عليها بداية التعامل مع فرع هيئة الدواء المختص")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "نموذج الطلب", Items: ["نموذج طلب ترخيص مخزن أدوية على النموذج المعد بفرع هيئة الدواء المختص.", "يحرر بمعرفة صاحب طلب الترخيص أو المندوب عنه."] },
						{ Title: "مستندات طالب الترخيص", Items: ["صورة بطاقة رقم قومي سارية.", "مستخرج رسمي من شهادة الميلاد.", "صحيفة حالة جنائية سارية وموجهة إلى هيئة الدواء المصرية."] },
						{ Title: "الرسم الهندسي", Items: ["ثلاث نسخ من الرسم الهندسي بمقياس 1:50.", "اعتماد وختم مهندس نقابي.", "توضيح المسقط الأفقي والرأسي والواجهة والكروكي والبيانات المطلوبة."] },
						{ Title: "رسوم النظر", Items: ["إيصال سداد رسم النظر وفق الدليل التنظيمي.", "ثم تسدد الرسوم المقررة قبل استلام الرخصة بعد استيفاء الملف."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات تستكمل قبل الرخصة")}
					pDesc={Text.Body.Centered.OfText("هذه المجموعة تثبت الحيازة والتشغيل والمسئولية الفنية")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "سند الحيازة", Items: ["عقد إيجار أو تمليك باسم صاحب الترخيص.", "العقد يكون سارياً وموثقاً، وتراجع مدة السريان قبل تجهيز الملف."] },
						{ Title: "الكهرباء", Items: ["مستند يثبت وجود عداد كهرباء مستقل داخل العين.", "تطابق عنوان العداد مع عنوان المخزن عنصر مهم في الملف."] },
						{ Title: "الشركة أو التفويض", Items: ["عند الترخيص باسم شركة، تراجع بيانات السجل التجاري والتفويض للمفوض إليه بصدور الرخصة باسمه.", "يجب ضبط الصلاحيات والتوقيعات قبل التقديم."] },
						{ Title: "السيارات والمدير الصيدلي", Items: ["مستندات سيارات نقل المستحضرات ومعاينتها.", "بيانات المدير الصيدلي، كارنيه النقابة، وترخيص مزاولة المهنة حسب الحالة."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="الرسم الهندسي لمخزن الأدوية"
			pDesc="الرسم ليس مخطط مساحة فقط، بل وثيقة مطابقة بين العين والاشتراطات الصحية ومسار المعاينة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(500, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.Creamy)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("ما الذي يظهر على اللوحة؟")}
						pText={Text.Body.WithAlign("right").OfText("المسقط الأفقي بالأطوال، المسقط الرأسي للارتفاع، واجهة الموقع، الكروكي، حدود العين، جدول الأطوال والارتفاع وفتحات التهوية، لوحة بيانات صاحب الترخيص ونوع الترخيص والعنوان. يتم مطابقة الرسم على الواقع أثناء المعاينة، لذلك نبدأ بالرفع الصحيح قبل صياغة اللوحة.")}
						pSize={new Size(new NumPer(450, "100%"), new NumPer("auto", "auto"))}
					/>

					<EmoCall BlackSky pText="افتح خدمة الرسم الهندسي" />

				</VrStack>

				<EmoList
					pWidth={new RespString("700px", "100%")}
					pTitle={Text.H3.Centered.OfText("نقاط نراجعها قبل اعتماد الرسم")}
					pDesc={Text.Body.Centered.OfText("الرسم الجيد يقلل ملاحظات المعاينة ويمنع التعارض بين الواقع والملف")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المساحة والارتفاع", Items: ["حساب المساحة الكلية والتخزينية.", "إظهار الارتفاع الصافي بدقة."] },
						{ Title: "المداخل والفصل", Items: ["توضيح المدخل المستقل.", "إظهار فصل المخزن عن أي نشاط آخر."] },
						{ Title: "التبريد والتهوية", Items: ["تحديد منطقة الثلاجات أو غرفة التبريد.", "إظهار فتحات التهوية ومواقعها."] },
						{ Title: "دورة المياه والصرف", Items: ["توضيح مكان دورة المياه إن وجدت.", "إظهار الجاليترب وغرفة التفتيش خارج المخزن حسب الحالة."] },
						{ Title: "مسارات التخزين", Items: ["توزيع الرفوف ومسافات الحركة.", "تجنب وضع الأدوية مباشرة على الأرض أو ملاصقة للحائط والسقف."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="خط سير الترخيص"
			pDesc="الترخيص يتحرك بين فرع هيئة الدواء المختص، الجهة الإدارية للموقع، لجنة المعاينة، وإدارة تراخيص مخازن الأدوية"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1100px", "100%")}
				pTitle={Text.H3.Centered.OfText("من أول طلب إلى صدور الرخصة")}
				pDesc={Text.Body.Centered.OfText("نرتب الخطوات حسب الدليل التنظيمي ونجهز كل مرحلة قبل الدخول فيها")}
				pHeadBg={new ElemBg(Colors.WhiteOff)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					{ Title: "مراجعة الموقع", Items: ["قراءة العنوان والنشاط وترخيص البناء وموقف الحي أو جهاز المدينة.", "تحديد صلاحية العين قبل التعاقد أو التجهيز."] },
					{ Title: "تجهيز المستندات الأساسية", Items: ["نموذج الطلب، مستندات طالب الترخيص، الرسم الهندسي، رسم النظر، ومستندات الشركة إن وجدت."] },
