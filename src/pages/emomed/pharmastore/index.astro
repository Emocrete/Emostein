---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مخزن أدوية"
	pDescr="خدمة تجهيز ومتابعة ملف ترخيص مخزن أدوية في مصر، تشمل مراجعة الموقع، الرسم الهندسي، مستندات الترخيص، اشتراطات هيئة الدواء المصرية، معاينة المخزن والسيارات، ملف المدير الصيدلي، ونطاق التوزيع."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","10%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("ترخيص مخزن أدوية")}
				pText={Text.Body.Centered.OfText("خدمة تجهيز ومتابعة ملف ترخيص مخزن أدوية في مصر، تشمل مراجعة الموقع، الرسم الهندسي، مستندات الترخيص، اشتراطات هيئة الدواء المصرية، معاينة المخزن والسيارات، ملف المدير الصيدلي، ونطاق التوزيع.")}
			/>

			<EmoCall OrangeBlack />

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			OrangeLite
			pTitle="شروط ترخيص مخزن أدوية"
			pDesc="الموقع المناسب يوفر مساحة كافية، ارتفاعًا صافياً، فصلًا عن الأنشطة الأخرى، مدخلًا مستقلًا، وتجهيزات صحية وتخزينية قابلة للمطابقة"
		/>

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<VrStack pWidth={new Pixel(1200, 340)} pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px; border-radius:18px;`}
						pTitle={Text.H3.Centered.OfText("مساحة تخزينية")}
						pText={Text.Body.Centered.OfText("القرار التنظيمي يقرر مساحة تخزينية تجارية لا تقل عن 500 م²، ويجوز تقسيمها على دورين متصلين اتصالًا داخليًا ولهما باب دخول مستقل.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H3.Centered.OfText("ارتفاع صافٍ")}
						pText={Text.Body.Centered.OfText("الارتفاع الصافي بين الأرضية وبطنية السقف لا يقل عن 2.6 م، ويتم توضيحه في الرسم الهندسي ومعاينته على الطبيعة.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.GreenLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("استقلال النشاط")}
						pText={Text.Body.Centered.OfText("العين تكون مستقلة عن أي نشاط آخر، ولها مدخل مستقل، ولا تكون بدرومًا أو جراجًا أو نشاطًا سكنيًا أو إداريًا.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.OrangeLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("غرفة تبريد أو ثلاجات")}
						pText={Text.Body.Centered.OfText("تجهيز منطقة تبريد أو ثلاجات مزودة بميزان حرارة للأدوية التي تحتاج درجات حرارة أقل من درجة حرارة الغرفة، مع تسجيل القراءات بانتظام.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("أرضيات وحوائط قابلة للتنظيف")}
						pText={Text.Body.Centered.OfText("الحوائط تغطى بمواد سهلة التنظيف، والأرضيات تكون ملساء ملحومة الفواصل ومن مواد غير قابلة للاشتعال.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("رفوف ومسافات تخزين")}
						pText={Text.Body.Centered.OfText("الأدوية توضع على قوائم أو رفوف غير قابلة للاحتراق، بارتفاع 45 سم عن الأرض، مع ترك مسافات عن الحائط والسقف حسب الاشتراطات.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle Gray2 pTitle="المستندات المطلوبة لترخيص مخزن أدوية" />

		<EmoStr pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات فتح الطلب")}
					pDesc={Text.Body.Centered.OfText("هذه المجموعة تُبنى عليها بداية التعامل مع فرع هيئة الدواء المختص")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "نموذج الطلب", Items: ["نموذج طلب ترخيص مخزن أدوية على النموذج المعد بفرع هيئة الدواء المختص.", "يحرر بمعرفة صاحب طلب الترخيص أو المندوب عنه."] },
						{ Title: "مستندات طالب الترخيص", Items: ["صورة بطاقة رقم قومي سارية.", "مستخرج رسمي من شهادة الميلاد.", "صحيفة حالة جنائية سارية وموجهة إلى هيئة الدواء المصرية."] },
						{ Title: "الرسم الهندسي", Items: ["ثلاث نسخ من الرسم الهندسي بمقياس 1:50.", "اعتماد وختم مهندس نقابي.", "توضيح المسقط الأفقي والرأسي والواجهة والكروكي والبيانات المطلوبة."] },
						{ Title: "رسوم النظر", Items: ["إيصال سداد رسم النظر وفق الدليل التنظيمي.", "ثم تسدد الرسوم المقررة قبل استلام الرخصة بعد استيفاء الملف."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات تستكمل قبل الرخصة")}
					pDesc={Text.Body.Centered.OfText("هذه المجموعة تثبت الحيازة والتشغيل والمسئولية الفنية")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "سند الحيازة", Items: ["عقد إيجار أو تمليك باسم صاحب الترخيص.", "العقد يكون سارياً وموثقاً، وتراجع مدة السريان قبل تجهيز الملف."] },
						{ Title: "الكهرباء", Items: ["مستند يثبت وجود عداد كهرباء مستقل داخل العين.", "تطابق عنوان العداد مع عنوان المخزن عنصر مهم في الملف."] },
						{ Title: "الشركة أو التفويض", Items: ["عند الترخيص باسم شركة، تراجع بيانات السجل التجاري والتفويض للمفوض إليه بصدور الرخصة باسمه.", "يجب ضبط الصلاحيات والتوقيعات قبل التقديم."] },
						{ Title: "السيارات والمدير الصيدلي", Items: ["مستندات سيارات نقل المستحضرات ومعاينتها.", "بيانات المدير الصيدلي، كارنيه النقابة، وترخيص مزاولة المهنة حسب الحالة."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="ما أقل مساحة مطلوبة لمخزن أدوية؟"
			pAnswer="قرار هيئة الدواء يشترط مساحة تخزينية تجارية لا تقل عن 500 م²، مع إمكانية تقسيمها على دورين متصلين اتصالًا داخليًا ولهما باب دخول مستقل وفق الاشتراطات."
		/>

		<FaqItem
			pQuestion="هل يمكن ترخيص مخزن أدوية في بدروم أو جراج؟"
			pAnswer="لا. الاشتراطات تستبعد البدروم والجراج والنشاط السكني أو الإداري، وتطلب عينًا تجارية مستقلة قابلة للترخيص كنشاط مخزن أدوية."
		/>

		<FaqItem
			pQuestion="هل الرسم الهندسي مطلوب؟"
			pAnswer="نعم. يقدم الرسم الهندسي بثلاث نسخ، بمقياس رسم 1:50، ومعتمد من مهندس نقابي، ويوضح المسقط الأفقي والرأسي والواجهة والكروكي والحدود والأطوال والارتفاع وفتحات التهوية."
		/>

		<FaqItem
			pQuestion="هل يحتاج المخزن غرفة تبريد؟"
			pAnswer="الاشتراطات تتطلب تخصيص غرفة تبريد أو ثلاجات مزودة بميزان حرارة لحفظ الأدوية التي تحتاج درجات حرارة أقل من درجة حرارة الغرفة، مع تسجيل القراءة بصفة منتظمة."
		/>

		<FaqItem
			pQuestion="هل السيارات تدخل في ملف الترخيص؟"
			pAnswer="نعم. سيارات نقل المستحضرات لها مستندات ومعاينة، ويجب إخطار فرع هيئة الدواء المختص بأي سيارات جديدة تابعة للمخزن لمعاينتها وحفظ محضر المعاينة بالملف."
		/>

		<FaqItem
			pQuestion="ما نطاق توزيع المخزن الجديد؟"
			pAnswer="عند إصدار الرخصة يبدأ نطاق توزيع المخزن الجديد في المحافظة المرخص بها، ثم يمكن طلب تحديث بيانات الرخصة لزيادة النطاق بعد مزاولة النشاط واستيفاء المتطلبات."
		/>

		<FaqItem
			pQuestion="متى يصدر الترخيص؟"
			pAnswer="بعد استيفاء الاشتراطات والمستندات، يرسل الملف من فرع هيئة الدواء المختص إلى إدارة تراخيص مخازن الأدوية للمراجعة، ثم يتم إصدار الرخصة بعد اكتمال المتطلبات وسداد الرسوم المقررة."
		/>

	</EmoFaq>







	<RelServices>

		<RelServiceItem
			pTitle="رسم هندسي لمخزن أدوية"
			pDesc="رفع المساحة وإعداد لوحة هندسية معتمدة توضح الأبعاد والارتفاع والتهوية والواجهة وحدود العين."
			pHref="/emomed/pharmastore/dwg"
		/>

	</RelServices>







</BLayout>
