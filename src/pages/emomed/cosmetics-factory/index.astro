---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, SplitPane, SplitScene } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مصنع مستحضرات تجميل"
	pDescr="ترخيص مصنع مستحضرات تجميل — تجهيز هندسي لمسار ترخيص المنشأة الطبية حسب نوع النشاط، مع مراجعة توزيع الفراغات والخدمات والرسومات والاشتراطات المؤثرة على قبول المكان. وفي هذه الصفحة يكون التركيز الخاص على تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="ترخيص مصنع مستحضرات تجميل">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("ترخيص مصنع مستحضرات تجميل")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("تجهيز هندسي لمسار ترخيص المنشأة الطبية حسب نوع النشاط، مع مراجعة توزيع الفراغات والخدمات والرسومات والاشتراطات المؤثرة على قبول المكان. وفي هذه الصفحة يكون التركيز الخاص على تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<SplitScene pBg={Colors.Gray1} pColumns={new RespString("1fr 1fr","1fr")} pGap={new RespString("12px","10px")} pPad={new RespString("42px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pEdge="Chevron" pEdgeP="None" pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("نطاق الخدمة")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("مراجعة نوع المنشأة والاشتراطات المؤثرة مع مراعاة تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات، فحص المسقط والخدمات ومسارات الحركة، تجهيز الرسومات وملف الإجراءات الهندسية.")} />
		</SplitPane>
		<SplitPane pBg={Colors.SkyLite} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("الفائدة قبل الخطوة التالية")} pText={Text.Body.WithColor(Colors.Black).OfText("يربط قرار استئجار أو تجهيز المكان بالمتطلبات الفنية من البداية، فيقل خطر إعادة التقسيم أو تعديل الخدمات بعد التنفيذ. ويُراجع القرار هنا تحديدًا في ضوء تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات.")} />
		</SplitPane>
	</SplitScene>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 8,000 ج.م للمنشآت الصغيرة؛ المراكز والمستشفيات تسعر بعد تحديد الأقسام والمساحة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
