---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Pixel, EmoMediaData } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, EmoList, RespImg, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمعمل تحاليل"
	pDescr="خدمة إعداد رسم هندسي لمعمل تحاليل طبية لترخيص وزارة الصحة، تشمل رفع المقاسات، المسقط الأفقي، القطاع الرأسي، كروكي الموقع، توزيع غرف المعمل، المياه والصرف، التهوية، دورة المياه، غرفة سحب العينات، وغرف التحليل والتخزين."
>







	<Hero
		pImgL="HeroD.webp"
		pImgP="HeroM.webp"
		pTitle="رسم هندسي لمعمل تحاليل"
		pDesc="لوحة هندسية واضحة لموقع المعمل وغرفه وارتفاعه ومرافقه قبل تقديم ملف الترخيص والمعاينة"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="40% 40% 10% 8%"
		pPosP="14% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="اطلب رفع المقاسات" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="الرسم الهندسي هو ملف المعمل أمام لجنة المعاينة"
			pDesc="اللوحة تترجم المكان إلى مستند ترخيص: عنوان واضح، مساحات محسوبة، غرف محددة، ارتفاعات مكتوبة، مياه وصرف وتهوية ظاهرة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("رفع هندسي")}
						pText={Text.Body.Centered.OfText("نقيس حدود الوحدة، الغرف، الفتحات، الارتفاعات، دورة المياه، مصادر المياه، مخارج الصرف، ومسارات الحركة قبل رسم اللوحة.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("لوحة ترخيص")}
						pText={Text.Body.Centered.OfText("نجهز المسقط الأفقي والقطاع الرأسي وكروكي الموقع وجداول الغرف والفتحات والمرافق في صيغة مفهومة للجنة الصحة.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.OrangeLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("مطابقة قبل المعاينة")}
						pText={Text.Body.Centered.OfText("نراجع الرسم مع الواقع ومع العقد والعنوان قبل الطباعة، لأن أي اختلاف في اللوحة يظهر مباشرة في تقرير المعاينة.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="محتوى لوحة رسم معمل التحاليل"
			pDesc="نظم اللوحة بطريقة تجعل لجنة الترخيص تقرأ المكان من أول نظرة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStrip pBg={new ElemBg(Colors.SkyLite)} pSize={new Size(1300, "auto", "calc(100% - 30px)", "auto")}>

				<HzStack>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("المسقط الأفقي يقرأ توزيع المعمل")}
						pText={Text.Body.WithAlign("right").OfText("المسقط الأفقي يوضح حدود الوحدة، أبعاد الغرف، أماكن الأبواب والشبابيك، غرفة الاستقبال، غرفة سحب العينات، غرف التحليل، غرفة تجهيز العينات، غرفة الغسيل أو التحضير، المخزن، دورة المياه، مصادر المياه، ونقط الصرف. كل اسم غرفة يكتب على الرسم كما سيظهر في ملف الترخيص.")}
						pSize={new Size(720, "auto", "100%", "auto")}
					/>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/308dfd_944a010348834b29b32a4435f5a4b227~mv2.jpg/v1/fill/w_400,h_566,al_c,q_80,enc_avif,quality_auto/",
					"%D8%B1%D8%B3%D9%85%20%D9%87%D9%86%D8%AF%D8%B3%D9%8A%20%D9%84%D9%85%D8%B9%D9%85%D9%84%20%D8%AA%D8%AD%D8%A7%D9%84%D9%8A%D9%84%20%D8%B7%D8%A8%D9%8A%D8%A9%201.jpg",
					false,
					"نموذج رسم هندسي لمعمل تحاليل طبية",
					new Size(430, "auto", "100%", "auto")
				)}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)}>

			<EmoStrip pBg={new ElemBg(Colors.Creamy)} pSize={new Size(1300, "auto", "calc(100% - 30px)", "auto")}>

				<HzStack>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Lab/Dwg/",
					"HeroD.webp",
					false,
					"معمل تحاليل طبية",
					new Size(430, "auto", "100%", "auto")
				)}
					/>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("القطاع الرأسي يثبت الارتفاع ومناسيب المكان")}
						pText={Text.Body.WithAlign("right").OfText("القطاع الرأسي يوضح ارتفاع المعمل، أي كمرات أو سقوطات مؤثرة، مستوى الأرضية بالنسبة للمداخل، وجود صندرة إن وجدت، وعلاقة السقف بالتهوية والإضاءة. هذه البيانات تمنع تفسير المكان بشكل خاطئ أثناء المعاينة، خصوصًا في الدور الأرضي أو الوحدات ذات المناسيب المختلفة.")}
						pSize={new Size(720, "auto", "100%", "auto")}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="مكونات الرسم المطلوبة للترخيص"
			pDesc="الرسم الجيد يجمع بيانات قانونية وهندسية وتشغيلية في لوحة واحدة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("الجزء الهندسي")}
					pDesc={Text.Body.Centered.OfText("ما يظهر كرسومات وأبعاد")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "رسم إرشادي للموقع", Items: ["يبين موقع المعمل بالنسبة للشارع أو الميدان أو العلامات المحيطة.", "يساعد لجنة المعاينة على الوصول للمقر ومطابقة العنوان."] },
						{ Title: "مسقط أفقي", Items: ["يوضح حدود الوحدة، الأبعاد، الفتحات، الغرف، مصادر المياه، ونقط الصرف.", "يكتب على كل فراغ استخدامه الفعلي داخل المعمل."] },
						{ Title: "قطاع رأسي", Items: ["يوضح ارتفاع المحل وأي صندرة أو سقوطات أو كمرات.", "يفصل بين الارتفاع الصافي والارتفاعات المتأثرة بعناصر إنشائية."] },
						{ Title: "واجهة أو مدخل", Items: ["توضح مدخل المعمل واللافتة عند الحاجة.", "تساعد في مطابقة صور وفيديو المعمل مع الرسم."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("الجزء التشغيلي")}
					pDesc={Text.Body.Centered.OfText("ما يظهر كبيانات ومعاينة")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "جدول الغرف", Items: ["اسم كل غرفة.", "مساحة كل غرفة.", "استخدام كل غرفة.", "ارتباطها بسحب العينات أو التحليل أو التخزين."] },
						{ Title: "المياه والصرف", Items: ["موضع الأحواض.", "مصدر المياه.", "نقط الصرف.", "دورة المياه ومسارها بالنسبة لغرف العمل."] },
						{ Title: "التهوية والإضاءة", Items: ["أماكن الشبابيك أو الشفاطات.", "غرف تحتاج تهوية خاصة.", "نقط الإضاءة الأساسية داخل مناطق العمل."] },
						{ Title: "النفايات الطبية", Items: ["منطقة تجميع مؤقت للعبوات الحادة والنفايات.", "فصلها عن مناطق الاستقبال وسحب العينات والتحليل."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="تقسيم معمل التحاليل على الرسم"
			pDesc="التقسيم الصحيح يوضح مسار المريض والعينة والنتيجة والنفايات"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("الاستقبال")}
							pText={Text.Body.Centered.OfText("منطقة انتظار واستلام بيانات المريض، وتظهر على الرسم بعيدة عن طاولات التحليل ومناطق الكيماويات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("سحب العينات")}
							pText={Text.Body.Centered.OfText("غرفة قريبة من الاستقبال، بها كرسي أو سرير سحب، حوض عند الحاجة، ومساحة حركة مناسبة للمريض والفني.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("تجهيز العينات")}
							pText={Text.Body.Centered.OfText("منطقة فصل وطرد مركزي وتحضير، وتحتاج ربطًا واضحًا بين سحب العينات وغرف التحليل.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.GreenLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("غرف التحليل")}
							pText={Text.Body.Centered.OfText("تظهر كفراغات عمل واضحة للكيمياء والهيماتولوجي والميكروبيولوجي أو غيرها حسب نشاط المعمل.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.OrangeLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("الغسيل والتحضير")}
							pText={Text.Body.Centered.OfText("موضع الحوض والصرف وغسيل الأدوات أو تجهيز المحاليل يظهر بوضوح بعيدًا عن استقبال المرضى.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("مخزن الكيماويات")}
							pText={Text.Body.Centered.OfText("يوضح مكان تخزين الكواشف والمحاليل، مع مراعاة التهوية والفصل عن العينات والانتظار.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("دورة المياه")}
							pText={Text.Body.Centered.OfText("تظهر على الرسم مع اتجاه الفتح ومسار الصرف، ويفضل ألا تفتح مباشرة على غرفة تحليل أو تجهيز عينات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("النفايات الطبية")}
							pText={Text.Body.Centered.OfText("تحدد نقطة تجميع آمنة للعبوات الحادة والمخلفات لحين تسليمها وفق عقد التخلص من النفايات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="الرسم حسب حالة الترخيص"
			pDesc="شكل اللوحة يتغير حسب طلب العميل: ترخيص جديد، نقل، تعديل، فرع، أو معمل ملحق بمنشأة طبية"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("ترخيص معمل جديد")}
					pDesc={Text.Body.Centered.OfText("لوحة تأسيس من الصفر")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						"رفع كامل للوحدة قبل التشطيب أو بعد التشطيب.",
						"توزيع الغرف حسب نشاط المعمل المطلوب.",
						"تحديد مسار المريض والعينة والنفايات.",
						"مراجعة صلاحية العنوان والنشاط قبل الطباعة."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("معمل ملحق بمنشأة")}
					pDesc={Text.Body.Centered.OfText("داخل مستشفى أو مركز طبي")}
					pHeadBg={new ElemBg(Colors.SkyLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						"تحديد حدود المعمل داخل المنشأة.",
						"إظهار علاقته بالاستقبال والعيادات والخدمات.",
						"فصل مسارات العينات عن مسارات الجمهور قدر الإمكان.",
						"ربط اللوحة بترخيص المنشأة الطبية الأم."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("نقل أو تعديل")}
					pDesc={Text.Body.Centered.OfText("مقر جديد أو توزيع جديد")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						"رسم جديد للمقر الجديد عند النقل.",
						"إظهار التعديل المطلوب عند تغيير الغرف أو الأجهزة.",
						"توضيح الفروق عن الرسم القديم عند الحاجة.",
						"مراجعة العقد والعنوان والرخصة السابقة قبل الإخراج."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.BlackOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="طريقة العمل في خدمة الرسم"
			pDesc="نرتب الخدمة بحيث يصل العميل إلى لوحة قابلة للتقديم بدل رسمة شكلية تحتاج تعديل بعد المعاينة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1100px", "100%")}
				pTitle={Text.H3.Centered.OfText("من بيانات العميل إلى لوحة الترخيص")}
				pDesc={Text.Body.Centered.OfText("خطوات منظمة قبل الطباعة والاعتماد")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					{ Title: "استلام بيانات المعمل", Items: ["العنوان التفصيلي.", "نوع الطلب: جديد، نقل، تعديل، تجديد، أو معمل ملحق.", "صورة عقد الإيجار أو التمليك إن وجدت.", "صور أولية للواجهة والداخل."] },
