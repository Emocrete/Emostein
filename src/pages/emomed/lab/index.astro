---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="ترخيص معمل تحاليل طبية"
	pDescr="خدمة تجهيز ومتابعة ملف ترخيص معمل تحاليل طبية في مصر، تشمل المستندات، الرسم الهندسي، مدير المعمل، الاشتراطات الصحية والفنية، المعاينة، النفايات الطبية، وتجهيز ملف الترخيص أمام مديرية الشؤون الصحية ووزارة الصحة."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("ترخيص معمل تحاليل طبية")}
				pText={Text.Body.Centered.OfText("كل ما تحتاج معرفته عن الإجراءات والمستندات والمواصفات الفنية للرخصة")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle Gray3 pTitle="أنواع تراخيص معامل التحاليل الطبية" />

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("طلبات تأسيس وتشغيل")}
					pDesc={Text.Body.Centered.OfText("حالات بدء النشاط أو تشغيل موقع مستقل")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "ترخيص معمل تحاليل مستقل عام", Items: ["يختص بإجراء الفحوصات المخبرية العامة للعينات البيولوجية مثل الدم والبول والبراز والمسحات والسائل النخاعي.", "ويُعد هذا النوع الأكثر شيوعًا بين المستثمرين والأطباء الراغبين في إنشاء معامل خاصة."] },
						{ Title: "ترخيص معمل بالمستشفى أو المركز الطبي", Items: ["يُمنح للمؤسسات الطبية التي تمتلك معامل داخلية تقدم خدمات تحليل لمرضاها.", "يُعامل المعمل هنا كوحدة تابعة للمنشأة، مع ضرورة وجود فصل هندسي ووظيفي واضح."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("طلبات تعديل")}
					pDesc={Text.Body.Centered.OfText("حالات تغيير قائم أو إضافة نشاط")}
					pHeadBg={new ElemBg(Colors.SkyLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "ترخيص تعديل أو توسعة", Items: ["يُمنح عند إدخال أجهزة جديدة أو توسعة المساحة أو تغيير الرسم الهندسي أو إضافة تخصصات تحليلية جديدة داخل المعمل.", "يرفق معه رسم هندسي جديد يوضح التوسعات أو التعديلات المقترحة."] },
						{ Title: "ترخيص نقل معمل إلى عنوان جديد", Items: ["يُرفق مع الطلب المستندات الكاملة الخاصة بالموقع الجديد، وكأنها معاملة ترخيص جديدة.", "يُلغى الترخيص السابق بعد النقل مباشرة، ولا يجوز تشغيل المعمل في أكثر من موقع بنفس الترخيص."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("طلبات إدارية")}
					pDesc={Text.Body.Centered.OfText("تجديد أو بدل فاقد أو تنازل")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "ترخيص تجديد معمل قائم", Items: ["كل معمل تحاليل مرخص يخضع لتجديد الترخيص بشكل دوري لضمان استمرار مطابقة المعمل لاشتراطات التشغيل.", "في حالة التجديد، لا يُطلب تقديم رسم هندسي جديد إلا إذا تم تعديل في توزيع الغرف أو الأجهزة أو توسعة النشاط."] },
						{ Title: "ترخيص بدل فاقد أو تالف", Items: ["إذا فُقد أصل الترخيص أو تلف، يمكن لصاحب المعمل التقدم بطلب بدل فاقد إلى مديرية الشؤون الصحية.", "يقدم محضر فقد وصورة من الترخيص القديم إن وجدت وصورة بطاقة المالك أو المدير الفني."] },
						{ Title: "ترخيص شراكة أو تنازل", Items: ["إذا تم بيع المعمل أو تنازل صاحبه الأصلي عن الإدارة لشريك آخر، يجب إخطار وزارة الصحة وتقديم طلب رسمي بتغيير المالك أو المدير الفني.", "لا يجوز نقل الترخيص باسم شخص آخر دون موافقة الوزارة واعتماد المستندات الجديدة."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="الجهات الرسمية المسؤولة عن الترخيص"
			pDesc="الملف يتحرك بين الصحة والنقابة والحي والبيئة والحماية المدنية حسب حالة المعمل"
		/>

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<VrStack pWidth={new Pixel(1200, 340)} pGap={new Pixel(15, 15)} pPad={new Pixel(30, 15)}>

				<EmoStr pBg={new ElemBg(Colors.Creamy)}>

					<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pSize={new Size(new NumPer(1200, "100%"), new NumPer("auto", "auto"))}>

						<HzStack>

							<Emograph
								pTitle={Text.H3.WithAlign("right").OfText("وزارة الصحة والسكان ومديرية الشؤون الصحية")}
								pText={Text.Body.WithAlign("right").OfText("وزارة الصحة والسكان هي الجهة الرئيسية المسؤولة عن إصدار الترخيص النهائي للمعمل. تقوم بمراجعة المستندات والتأكد من مطابقة الرسم الهندسي للاشتراطات الفنية، ثم تُجري معاينة ميدانية للموقع قبل الموافقة على التشغيل. أما مديرية الشؤون الصحية بالمحافظة فتستقبل طلب الترخيص في البداية، وتفحص الأوراق والمستندات المقدمة، ثم تُشكل لجنة فنية لمعاينة المكان والتأكد من جاهزيته قبل رفع التقرير إلى الإدارة العامة للتحاليل الطبية لاعتماد الترخيص.")}
								pSize={new Size(new NumPer(850, "100%"), new NumPer("auto", "auto"))}
							/>

							<RespImg
								pImg={new EmoMediaData(
							"Img",
							"/Media/Emomed/Lab/",
							"HeroD.webp",
							false,
							"معمل تحاليل طبية",
							new Size(new NumPer(250, "100%"), new NumPer("auto", "auto"))
						)}
							/>

						</HzStack>

					</EmoStr>

				</EmoStr>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						pTitle={Text.H4.Centered.OfText("النقابة المختصة")}
						pText={Text.Body.Centered.OfText("تتولى اعتماد المؤهل العلمي للمسؤول الفني عن المعمل، والتأكد من تخصصه العلمي في مجال التحاليل الطبية، كما تصدر شهادة مزاولة المهنة المعتمدة التي تُرفق ضمن مستندات الترخيص.")}
						pSize={new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H4.Centered.OfText("الإدارة البيئية أو إدارة المخلفات الطبية")}
						pText={Text.Body.Centered.OfText("تختص بإصدار الموافقة على أسلوب التخلص من النفايات البيولوجية والكيميائية الناتجة عن تشغيل المعمل، سواء من خلال التعاقد مع شركة معتمدة أو توفير نظام داخلي مطابق للاشتراطات البيئية.")}
						pSize={new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H4.Centered.OfText("الحي أو الإدارة الهندسية")}
						pText={Text.Body.Centered.OfText("تتحقق من مطابقة النشاط لرخصة المبنى والتصنيف المسموح به، وقد تطلب موافقة كتابية على تشغيل النشاط بالموقع لضمان عدم مخالفة اشتراطات البناء والاستخدام.")}
						pSize={new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H4.Centered.OfText("جهات مساندة")}
						pText={Text.Body.Centered.OfText("قد تدخل الحماية المدنية أو جهات أمنية في بعض الحالات، خصوصًا عند معامل السموم أو المعامل ذات التجهيزات الخطرة أو النفايات الطبية ذات الطبيعة الخاصة.")}
						pSize={new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="المستندات المطلوبة لاستخراج ترخيص معمل تحاليل طبية"
			pDesc="القائمة التالية محفوظة من محتوى الصفحة السابقة، مع ترتيبها في ملف واضح للتقديم والمتابعة"
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات صاحب الترخيص والمدير الفني")}
					pDesc={Text.Body.Centered.OfText("مستندات الهوية والمهنة والأهلية العلمية")}
					pHeadBg={new ElemBg(Colors.SkyLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						"طلب رسمي للحصول على ترخيص معمل تحاليل طبية يُقدم على نموذج معتمد من مديرية الشؤون الصحية.",
						"صورة من بطاقة الرقم القومي لمالك المعمل، وتكون سارية ومطابقة لعنوان الطلب.",
						"في حالة الشركات: تُرفق صورة السجل التجاري والبطاقة الضريبية.",
						"شهادة تسجيل في النقابة المختصة للطبيب أو الأخصائي الذي سيتولى المسؤولية الفنية للمعمل.",
						"شهادة مزاولة المهنة من وزارة الصحة تثبت أن المسؤول الفني حاصل على ترخيص رسمي لمزاولة نشاط التحاليل الطبية داخل مصر.",
						"السيرة الذاتية والمؤهلات العلمية للمسؤول الفني، وتشمل المؤهلات الأكاديمية والخبرة العملية والدرجات العلمية في تخصص التحاليل.",
						"صحيفة الحالة الجنائية حديثة باسم مالك المعمل والمسؤول الفني.",
						"إقرار مسؤولية فنية موقع من المدير الفني يتعهد فيه بالإشراف الكامل على المعمل والتزامه بتطبيق تعليمات وزارة الصحة."
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات المكان والتشغيل")}
					pDesc={Text.Body.Centered.OfText("مستندات الحيازة والرسم والبيئة والتجهيزات")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						"عقد إيجار موثق أو سند ملكية لمقر المعمل، موثق بالشهر العقاري أو مثبت التاريخ.",
						"يجب أن يكون النشاط في العقد مذكورًا بوضوح “نشاط طبي / تحاليل طبية”.",
						"شهادة من الحي أو الوحدة المحلية تفيد بأن المكان مطابق لاستخدام النشاط التجاري أو الإداري وليس سكنيًا بحتًا.",
						"إيصال كهرباء ومياه حديث لإثبات جاهزية المكان من الناحية التشغيلية.",
						"الرسم الهندسي للمعمل معتمد من مهندس نقابي، موضح به توزيع الغرف والأقسام بدقة حسب المعايير الفنية.",
						"موافقة مبدئية من الجهة البيئية إن وُجدت نفايات طبية.",
						"صورة من عقد المحرقة أو ما يفيد سداد رسوم التخلص من أو تداول النفايات الخطرة.",
						"بيان بتجهيزات المعمل وأسماء العاملين به."
					]}
				/>

			</HzStack>

			<EmoList
				pWidth={new RespString("1100px", "100%")}
				pTitle={Text.H3.Centered.OfText("قائمة المستندات المختصرة من الصفحة السابقة")}
				pDesc={Text.Body.Centered.OfText("صيغة سريعة تصلح لمراجعة الملف قبل التقديم")}
				pHeadBg={new ElemBg(Colors.Creamy)}
				pItemsBg={new ElemBg(Colors.GreenLite)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"طلب ترخيص بفتح وإدارة معمل تحاليل طبية حسب النموذج المعد لذلك.",
					"ترخيص مزاولة المهنة لطالب ترخيص المعمل الذي يفيد القيد في سجلات وزارة الصحة.",
					"صورة بطاقة الرقم القومى لصاحب المعمل ومديره المسؤول.",
					"صحيفة حالة جنائية حديثة لطالب الترخيص والمدير المسئول عن المعمل.",
					"صورة من عقد إيجار / ملكية المنشأة المستخدمة كمقر لمعمل التحاليل.",
					"عدد ٣ نسخ من الرسم هندسي لمعمل التحاليل الطبية معتمدة بختم مهندس نقابي.",
					"حوالة بريدية بقيمة رسم المعاينة.",
					"شهادة التأمينات الاجتماعية على العاملين بالمعمل.",
					"شهادة صحية بخلو العاملين بالمعمل من الأمراض المعدية والجلدية.",
					"إقرار من صاحب المعمل والمدير الفنى المسؤول بعدم صدور أحكام سابقة ضدهم ترتب عليها غلق معمل سابق كان تحت مسئوليتهم.",
					"صورة من عقد المحرقة وصورة تفيد سداد رسوم التخلص من أو تداول النفايات الخطرة.",
					"بيان بتجهيزات المعمل وأسماء العاملين به.",
					"صورة من ترخيص مزاولة المهنة أو كارنيه النقابة للطبيب البشري المسئول عن سحب العينات.",
					"إقرار من صاحب المعمل بتعيين طبيب بشري مسؤول عن أخذ العينات.",
					"إقرار بالقبول من الطبيب البشري بالمسئولية عن أخذ العينات."
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle Gray2 pTitle="مراحل ترخيص معمل التحاليل" pDesc="المسار يبدأ بتجهيز الملف والرسم، ثم تقديم الطلب، ثم المعاينة، ثم الاعتماد واستلام الترخيص" />

		<EmoStr pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("من التقديم إلى المعاينة")}
					pDesc={Text.Body.Centered.OfText("الجزء الأول من مسار الترخيص")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المرحلة الأولى: التقديم المبدئي", Items: ["يتوجه مقدم الطلب إلى مديرية الشؤون الصحية بالمحافظة.", "يتم ملء نموذج طلب ترخيص معمل تحاليل طبية.", "يُرفق الطلب بالمستندات الأساسية مثل العقد والبطاقة والمؤهل والرسم الهندسي المبدئي."] },
						{ Title: "المرحلة الثانية: المراجعة الإدارية", Items: ["تُراجع الجهة المختصة صحة المستندات وتطابقها مع الشروط القانونية.", "إذا كانت الأوراق مستوفاة، يُحال الطلب إلى اللجنة الفنية للمعاينة."] },
						{ Title: "المرحلة الثالثة: المعاينة الميدانية", Items: ["لجنة متخصصة من مديرية الصحة تزور موقع المعمل لمراجعة الرسم الهندسي على أرض الواقع.", "يتم التأكد من المساحات الفعلية، التهوية، الإضاءة، الصرف الصحي، وفصل مناطق العمل عن الانتظار والإدارة."] },
						{ Title: "المرحلة الرابعة: تقديم الرسم الهندسي النهائي", Items: ["بعد أي ملاحظات من اللجنة، يتم تعديل الرسم الهندسي واعتماده نهائيًا من مهندس نقابي.", "يُسلَّم الرسم النهائي في ثلاث نسخ مختومة إلى مديرية الصحة."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("من الاعتماد إلى التشغيل")}
					pDesc={Text.Body.Centered.OfText("الجزء الثاني من مسار الترخيص")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المرحلة الخامسة: صدور الموافقة المبدئية", Items: ["تُخطر الجهة مقدم الطلب بالموافقة المبدئية.", "تُطلب منه بعض الإجراءات الثانوية مثل تقرير النفايات أو السجل التجاري حسب الحالة."] },
