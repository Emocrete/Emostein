---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { DivCol, DivStr, EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمعمل تحاليل"
	pDescr="خدمة إعداد رسم هندسي لمعمل تحاليل طبية لترخيص وزارة الصحة، تشمل رفع المقاسات، المسقط الأفقي، القطاع الرأسي، كروكي الموقع، توزيع غرف المعمل، المياه والصرف، التهوية، دورة المياه، غرفة سحب العينات، وغرف التحليل والتخزين."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("رسم هندسي لمعمل تحاليل")}
				pText={Text.Body.Centered.OfText("خدمة إعداد رسم هندسي لمعمل تحاليل طبية لترخيص وزارة الصحة، تشمل رفع المقاسات، المسقط الأفقي، القطاع الرأسي، كروكي الموقع، توزيع غرف المعمل، المياه والصرف، التهوية، دورة المياه، غرفة سحب العينات، وغرف التحليل والتخزين.")}
			/>

			<EmoCall BlackSky pText="تواصل معنا" />

		</VrStack>

	</Hero>







	<EmoSec id="secDwgSpecs" Readable>

		<SecTitle
			id="sectDwgSpecs"
			Sky
			Readable
			pTitle="مواصفات الرسم الهندسي لترخيص معمل تحاليل طبية"
		/>

		<DivStr
			id="strDwgSpecs1Plan"
			Readable
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DivCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/Dwg/Specs",
					"Plan.webp",
					false,
					"مسقط أفقي",
					new Size(new NumPer(600, 310), new NumPer("auto", "auto"))
				)}
				/>

			</DivCol>

			<DivCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("1- مسقط أفقي")}
					pDesc={Text.Body.OfText("هو العنصر الرئيسي في الرسم الهندسي لمعمل التحاليل الطبية لتوضيح:")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"المساحة الكلية والمساحة الصافية القابلة للاستخدام.",
					"الأبعاد والداخلية وسمك الحوائط المؤثرة.",
					"أماكن الأعمدة والبروزات والمداخل والمنافذ.",
					"توزيع الفراغات داخل المقر وعلاقتها ببعضها من الناحية الوظيفية",
				]}
				/>

			</DivCol>

		</DivStr>

		<DivStr
			id="strDwgSpecs2Sec"
			Readable
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DivCol Centered pPad={new Pixel(40, 20)}>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.Bistage.OfText("2- قطاع رأسي")}
					pDesc={Text.Body.OfText("لتوضيح المعلومات التالية:")}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
					"ارتفاع أرضية الصيدلية بالنسبة للطريق العام.",
					"عدد مستويات الأرضية الداخلية إن وجدت.",
					"ارتفاعات السقف عند كل مستوى.",
					"تأثير السقف المستعار أو أي تجهيز يقلل الارتفاع الصافي.",
				]}
				/>

			</DivCol>

			<DivCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
				"Img",
				"/Media/Emomed/Pharmacy/Dwg/Specs",
				"Sec.webp",
				false,
				"قطاع رأسي لصيدلية",
				new Size(new NumPer(600, 310), new NumPer("auto", "auto"))
			)}
				/>

			</DivCol>

		</DivStr>

		<DivStr
			id="strDwgSpecs4Map"
			Readable
			pContentSize={new Size(new NumPer("90%", "95%"))}
			pGap={new Pixel(40, 20)}
		>

			<DivCol Centered pPad={new Pixel(40, 20)}>

				<RespImg
					pImg={new EmoMediaData(
					"Img",
					"/Media/Emomed/Pharmacy/Dwg/Specs",
					"Map.webp",
					false,
					"كروكي الموقع العام لصيدلية",
					new Size(new NumPer(600, 310), new NumPer("auto", "auto"))
				)}
				/>

			</DivCol>

			<DivCol Centered pPad={new Pixel(40, 20)}>

				<Emograph
					pSize={new Size(new NumPer("420px", "320px"))}
					pTitle={Text.H3.Bistage.OfText("3- كروكي الموقع العام")}
					pText={Text.Body.OfText("لتوضيح الموقع العام للمعمل والطرق المؤدية إليه.")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle Gray3 pTitle="عناصر فراغات معمل التحاليل الطبية وتوزيع الغرف" />

		<EmoStr pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<VrStack pWidth={new Pixel(1300, 340)} pGap={new Pixel(20, 15)} pPad={new Pixel(30, 15)}>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("الاستقبال")}
							pText={Text.Body.Centered.OfText("منطقة انتظار واستلام بيانات المريض، وتظهر على الرسم بعيدة عن طاولات التحليل ومناطق الكيماويات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("غرفة سحب العينات")}
							pText={Text.Body.Centered.OfText("غرفة قريبة من الاستقبال، بها كرسي أو سرير سحب، حوض عند الحاجة، ومساحة حركة مناسبة للمريض والفني.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.GreenLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("غرفة المعمل")}
							pText={Text.Body.Centered.OfText("تظهر كفراغات عمل واضحة للكيمياء والهيماتولوجي والميكروبيولوجي أو غيرها حسب نشاط المعمل.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("غرفة المدير")}
							pText={Text.Body.Centered.OfText("وتكون في موضع متوسط يسمح لها بالمتابعة والإشراف على كل مناطق مقر المعمل")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("دورة المياه")}
							pText={Text.Body.Centered.OfText("تظهر على الرسم مع اتجاه الفتح ومسار الصرف، ويفضل ألا تفتح مباشرة على غرفة تحليل أو تجهيز عينات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(10, 10)}
						pPad={new Pixel(25, 15)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("غرفة النفايات")}
							pText={Text.Body.Centered.OfText("تحدد نقطة تجميع آمنة للعبوات الحادة والمخلفات لحين تسليمها وفق عقد التخلص من النفايات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل الرسم الهندسي مطلوب لترخيص معمل التحاليل؟"
			pAnswer="نعم، الرسم الهندسي من مستندات الترخيص الأساسية، ويعرض موقع المعمل ومسقطه الأفقي وقطاعه الرأسي ومرافقه وغرفه."
		/>

		<FaqItem
			pQuestion="ما أهم بيانات المسقط الأفقي؟"
			pAnswer="حدود الوحدة، أبعاد الغرف، الأبواب والشبابيك، توزيع غرف المعمل، مصادر المياه، الصرف، دورة المياه، وأماكن غرف السحب والتحليل والتخزين."
		/>

	</EmoFaq>







	<RelServices>

		<RelServiceItem pTitle="ترخيص معمل تحاليل طبية" pDesc="متابعة ملف الترخيص كاملًا من مراجعة الموقع حتى تجهيز المستندات والمعاينة." pHref="/emomed/lab" />

		<RelServiceItem
			pTitle="تقارير وشهادات هندسية"
			pDesc="تقارير فنية عند الحاجة لتوضيح حالة الموقع أو معالجة ملاحظات هندسية قبل الترخيص."
			pHref="/emonsult/report"
		/>

		<RelServiceItem
			pTitle="تشطيب وتجهيز منشآت طبية"
			pDesc="تجهيز الأرضيات والحوائط والفواصل ومناطق العمل بما يناسب المعاينة والتشغيل."
			pHref="/emocrete/finishing/pharmacy"
		/>

	</RelServices>







</BLayout>
