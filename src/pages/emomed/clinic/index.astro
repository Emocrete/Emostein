---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Pixel } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, EmoList, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص عيادة خاصة"
	pDescr="خدمة تجهيز ومتابعة ملف ترخيص عيادة خاصة في مصر، تشمل مراجعة مستندات الطبيب، عقد العيادة، الرسم الكروكي، تجهيزات المكان، ملف النفايات الطبية، ومتابعة إجراءات الترخيص أمام العلاج الحر ومديرية الشؤون الصحية."
>







	<Hero
		pTitle="ترخيص عيادة خاصة"
		pDesc="تجهيز ملف العيادة ابتداءً من مراجعة المقر والمستندات حتى تقديم الطلب ومتابعة المعاينة وإصدار الترخيص"
		pAlign="center"
		pBlurP="on"
		pPosL="40% 15% 40% 55%"
		pPosP="55% 2% 5% 2%"
	>

		<EmoCall BlackSky pText="تواصل معنا" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="ترخيص العيادة يبدأ من ملف واضح قبل المعاينة"
			pDesc="العيادة الخاصة منشأة طبية صغيرة في شكلها، لكنها تحتاج ملفًا منظمًا يجمع بين صفة الطبيب، سند حيازة المكان، الرسم الكروكي، التجهيزات، النفايات الطبية، ومتطلبات العلاج الحر في مديرية الشؤون الصحية"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.White.OfText("ما الذي نقدمه في خدمة ترخيص عيادة؟")}
					pText={Text.Body.White.OfText("نراجع حالة العيادة قبل تقديم الطلب، ونحدد المستندات الناقصة، ونجهز الرسم الكروكي وبيان التجهيزات، ونرتب ملف الترخيص بالطريقة المناسبة للتقديم إلى الإدارة المختصة، مع متابعة الملاحظات الفنية التي تظهر أثناء فحص الملف أو معاينة المكان.")}
				/>

				<Emograph
					pTitle={Text.H3.White.OfText("لماذا لا يفضل تجهيز الملف عشوائيًا؟")}
					pText={Text.Body.White.OfText("أغلب تأخير تراخيص العيادات لا ينتج من صعوبة الترخيص نفسه، بل من أخطاء بسيطة في العنوان، عقد الإيجار، الرسم، بيانات الطبيب، أو عدم وضوح تجهيزات العيادة والنفايات الطبية. لذلك نعالج الملف كحزمة واحدة بدل تقديم أوراق متفرقة ثم انتظار الرفض أو طلب الاستيفاء.")}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="ما الذي نفحصه قبل تقديم طلب ترخيص العيادة؟"
			pDesc="الفحص المسبق يقلل ملاحظات العلاج الحر ويجعل المعاينة أقرب إلى الاعتماد من أول مرة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("صفة الطبيب")}
					pText={Text.Body.Centered.White.OfText("مطابقة اسم الطبيب، بطاقة الرقم القومي، كارنيه النقابة، ترخيص مزاولة المهنة، وشهادة القيد أو التخصص المطلوب حسب حالة الطلب.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("المقر والعقد")}
					pText={Text.Body.Centered.White.OfText("مراجعة عقد الإيجار أو الملكية، العنوان التفصيلي، علاقة النشاط بالمبنى، ومدى الحاجة إلى مستندات إضافية من الحي أو الجهاز حسب موقع العيادة.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("الرسم الكروكي")}
					pText={Text.Body.Centered.White.OfText("إعداد رسم يوضح توزيع الفراغات، المدخل، غرفة الكشف، الانتظار، الخدمات، مصادر المياه والصرف، وأي ملاحظات هندسية مؤثرة في المعاينة.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("التجهيزات والمخلفات")}
					pText={Text.Body.Centered.White.OfText("تجهيز بيان المعدات، طفاية الحريق، مكان تعليق الرخصة، وآلية التعامل مع النفايات الطبية طبقًا لطبيعة التخصص وحجم النشاط.")}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="المستندات المطلوبة لترخيص عيادة خاصة"
			pDesc="القائمة التالية هي أساس الملف، وقد تزيد أو تتغير بعض التفاصيل حسب المحافظة، نوع التخصص، حالة المقر، أو تعليمات الإدارة المختصة وقت التقديم"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات الطبيب")}
					pDesc={Text.Body.Centered.OfText("إثبات الصفة المهنية وصلاحية مزاولة النشاط")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"إيصال أو شهادة تسجيل العيادة في النقابة المختصة لحين صدور الشهادة النهائية حسب المتبع.",
						"صورتان من بطاقة الرقم القومي للطبيب، وتكون البطاقة سارية وواضحة.",
						"صورة كارنيه النقابة العامة للأطباء أو أطباء الأسنان حسب تخصص العيادة.",
						"صورة ترخيص مزاولة المهنة الصادر للطبيب.",
						"صورة من القيد بسجل الأخصائيين أو ما يثبت الدرجة المهنية المطلوبة إذا كان الطلب مقدمًا كعيادة أخصائي.",
						"صورة شخصية للطبيب إذا طلبتها الإدارة المختصة ضمن نموذج الملف.",
						"تفويض أو توكيل رسمي عند تقديم الملف من خلال وكيل أو مكتب متابعة."
					]}
				/>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات المكان والتشغيل")}
					pDesc={Text.Body.Centered.OfText("إثبات صلاحية المقر وتجهيزات العيادة")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"عقد إيجار مثبت التاريخ أو عقد ملكية أو أي سند رسمي يثبت حق استعمال مقر العيادة.",
						"رسم كروكي للعيادة يوضح توزيع الفراغات والفتحات والخدمات والمداخل.",
						"بيان تفصيلي بتجهيزات العيادة والأجهزة والأدوات المستخدمة في التخصص.",
						"عقد أو مستند يوضح طريقة التخلص من النفايات الطبية إذا كانت طبيعة النشاط تنتج مخلفات طبية.",
						"إقرار بوجود طفاية حريق داخل العيادة طبقًا لما تطلبه الإدارة المختصة.",
						"إقرار بتعليق الترخيص في مكان ظاهر داخل العيادة بعد صدوره.",
						"إيصالات الرسوم والدمغات المطلوبة وتقديم الملف في دوسيه منظم حسب تعليمات المديرية."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="خطوات استخراج ترخيص عيادة"
			pDesc="تسلسل العمل العملي من اختيار المقر حتى الحصول على الترخيص"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1200px", "100%")}
				pTitle={Text.H3.Centered.OfText("طريقة العمل داخل الملف")}
				pDesc={Text.Body.Centered.OfText("كل خطوة لها مخرج واضح حتى لا يتحول ملف الترخيص إلى متابعة مفتوحة بلا نتيجة")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					{ Title: "فحص مبدئي للمقر", Items: ["مراجعة العنوان، علاقة العيادة بالعقار، توزيع الفراغات، وجود مدخل واضح، الخدمات، وطبيعة التشطيبات القائمة.", "في هذه المرحلة نحدد هل المكان قابل للتقديم مباشرة أم يحتاج تعديلًا قبل بدء الملف."] },
					{ Title: "تجميع مستندات الطبيب", Items: ["تجهيز صور الهوية، كارنيه النقابة، ترخيص مزاولة المهنة، القيد المهني، وأي مستندات تخص التخصص أو صفة الإدارة.", "يتم ترتيب المستندات حسب نموذج الإدارة المختصة لتقليل طلبات الاستيفاء."] },
					{ Title: "إعداد الرسم الكروكي وبيان التجهيزات", Items: ["رفع أبعاد العيادة وإعداد رسم واضح للمسقط الداخلي.", "كتابة بيان التجهيزات بصورة مناسبة للتخصص وطبيعة الكشف أو العلاج داخل العيادة."] },
					{ Title: "تقديم الطلب ومتابعة الفحص", Items: ["تقديم الملف إلى العلاج الحر أو الجهة المختصة في مديرية الشؤون الصحية.", "متابعة فحص الملف واستيفاء الملاحظات الورقية أو الفنية عند ظهورها."] },
					{ Title: "المعاينة وإصدار الترخيص", Items: ["التنسيق مع المعاينة للتحقق من مطابقة الواقع للرسم والمستندات.", "بعد قبول المعاينة واستكمال الرسوم والإجراءات يتم إصدار ترخيص العيادة وفق بيانات الطبيب والمقر."] }
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="الرسم الكروكي وتجهيزات العيادة"
			pDesc="الرسم ليس شكلًا توضيحيًا فقط؛ هو مستند يربط بين الواقع والمعاينة وبيان التجهيزات"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.OfText("ماذا يجب أن يظهر في الرسم؟")}
					pText={Text.Body.OfText("نوضح في الرسم حدود العيادة، أبعاد الفراغات، غرفة الكشف أو الإجراء، منطقة الانتظار، دورة المياه إن وجدت، المدخل، الشبابيك، مصادر المياه والصرف، وأي فراغ مساعد له علاقة بالتشغيل. الهدف أن يكون الرسم مفهومًا للموظف ولجنة المعاينة وليس مجرد مخطط مبهم.")}
					pSize={new Size(600, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.OfText("متى يحتاج المكان إلى تعديل قبل التقديم؟")}
					pText={Text.Body.OfText("قد يحتاج المكان إلى تعديل بسيط في توزيع الانتظار أو فصل بعض الفراغات أو إضافة تجهيزات أمان أو استكمال مصادر المياه والصرف أو تنظيم النفايات الطبية. لذلك يكون فحص المقر قبل الرسم مفيدًا، لأنه يمنع تقديم رسم لحالة لن يتم قبولها عند المعاينة.")}
					pSize={new Size(600, "auto", "100%", "auto")}
				/>

			</HzStack>

			<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 15)}>

				<Emograph
					pTitle={Text.H4.Centered.OfText("رفع المقاسات")}
					pText={Text.Body.Centered.OfText("زيارة للموقع أو استلام أبعاد دقيقة إذا كان المكان خارج نطاق المعاينة المباشرة.")}
					pSize={new Size(280, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("توزيع الفراغات")}
					pText={Text.Body.Centered.OfText("توضيح الغرف والخدمات بطريقة توافق الاستخدام الفعلي وتساعد لجنة المعاينة على قراءة المكان.")}
					pSize={new Size(280, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("مراجعة التجهيز")}
					pText={Text.Body.Centered.OfText("ربط الرسم ببيان الأجهزة والأدوات ومكان النفايات الطبية وطفاية الحريق.")}
					pSize={new Size(280, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("تسليم ملف واضح")}
					pText={Text.Body.Centered.OfText("تجهيز الرسم والملاحظات النهائية بشكل يصلح للإرفاق داخل ملف الترخيص.")}
					pSize={new Size(280, "auto", "100%", "auto")}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="الفرق بين العيادة الخاصة والعيادة التخصصية والمركز الطبي"
			pDesc="تحديد نوع المنشأة من البداية يمنع تقديم طلب على تصنيف غير مناسب للنشاط"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("عيادة خاصة")}
					pDesc={Text.Body.Centered.OfText("الاختيار المناسب للطبيب الذي يفتح عيادة باسمه")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"تكون باسم طبيب أو طبيب أسنان مرخص له في مزاولة المهنة.",
						"مخصصة لاستقبال المرضى ورعايتهم طبيًا داخل نطاق تخصص الطبيب.",
						"قد توجد أسرة ملاحظة في الحدود التي يقررها القانون واللوائح، لكنها ليست منشأة إقامة علاجية."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("عيادة تخصصية")}
					pDesc={Text.Body.Centered.OfText("اختيار مختلف عندما يوجد أكثر من طبيب وتخصصات متعددة")}
					pHeadBg={new ElemBg(Colors.SkyLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"تضم أكثر من طبيب من تخصصات مختلفة داخل إدارة مشتركة.",
						"يكون لها مدير فني مسؤول عن العيادات طبقًا للتصنيف المطلوب.",
						"قد تتطلب تجهيزات أو موافقات أوسع من العيادة الخاصة حسب طبيعة الخدمات."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("مركز طبي")}
					pDesc={Text.Body.Centered.OfText("تصنيف أوسع من العيادة ويحتاج ملفًا هندسيًا وفنيًا أكبر")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"يستخدم عندما تكون الخدمات أكبر من عيادة منفردة أو عيادات صغيرة مستقلة.",
						"يرتبط عادة بمساحات وتجهيزات ومسؤوليات تشغيلية أوسع.",
						"اختيار تصنيف المركز بدل العيادة يجب أن يتم بعد مراجعة النشاط الفعلي وخطة التشغيل."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		id="cta"
		pBg={new ElemBg(Colors.Creamy)}
		pAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="اطلب مراجعة ملف ترخيص العيادة"
			pDesc="أرسل بيانات الطبيب، عنوان العيادة، وصور المستندات المتاحة، وسنراجع لك النواقص ونوضح الإجراء المناسب قبل بدء التقديم"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.OfText("ما الذي نحتاجه منك في البداية؟")}
					pText={Text.Body.OfText("نحتاج صورة بطاقة الطبيب، كارنيه النقابة، ترخيص مزاولة المهنة، عنوان العيادة، صورة عقد الإيجار أو الملكية إن وجد، وبعض الصور الواضحة من داخل المكان. بعد المراجعة نحدد لك هل الملف جاهز للتقديم أم يحتاج رسمًا أو استيفاءات قبل البدء.")}
					pSize={new Size(700, "auto", "100%", "auto")}
				/>

				<VrStack
					pWidth={new Pixel(360, 320)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 20)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("اتصال مباشر")}
						pText={Text.Body.Centered.OfText("المراجعة الأولى تختصر وقتًا كبيرًا قبل تجهيز الرسم أو دفع رسوم أو تقديم ملف ناقص.")}
						pSize={new Size(320, "auto", "100%", "auto")}
					/>

					<EmoCall BlackSky pText="اتصل الآن" />

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن فتح عيادة قبل صدور الترخيص؟"
			pAnswer="لا يفضل تشغيل العيادة أو الإعلان عنها كمنشأة طبية قبل صدور الترخيص، لأن تشغيل منشأة طبية خاصة دون استكمال الإجراءات يعرض صاحبها لمخاطر الغلق أو المساءلة حسب حالة المخالفة."
		/>

		<FaqItem
			pQuestion="هل عقد الإيجار يكفي وحده لترخيص العيادة؟"
			pAnswer="عقد الإيجار أو الملكية يثبت حق استعمال المكان، لكنه لا يكفي وحده. الملف يحتاج أيضًا مستندات الطبيب، الرسم الكروكي، بيان التجهيزات، الرسوم، الدمغات، ومستندات النفايات الطبية أو الإقرارات المطلوبة."
		/>

		<FaqItem
			pQuestion="هل كل عيادة تحتاج عقد نفايات طبية؟"
			pAnswer="الأمر يرتبط بطبيعة التخصص والنشاط الفعلي داخل العيادة. بعض العيادات تنتج مخلفات طبية واضحة، وبعض الحالات يطلب منها مستند أو إقرار أو عقد التخلص من النفايات طبقًا لتعليمات الإدارة المختصة."
		/>

		<FaqItem
			pQuestion="هل يمكن لأكثر من طبيب العمل في نفس مقر العيادة؟"
			pAnswer="يمكن في بعض الحالات أن يعمل أكثر من طبيب في نفس المقر بترخيص مستقل أو بتصنيف مختلف، لكن ذلك يحتاج مراجعة قانونية وتنظيمية للمكان والتخصصات وطريقة الإدارة قبل تقديم الطلب."
		/>

		<FaqItem
			pQuestion="هل العيادة الخاصة مثل العيادة التخصصية؟"
			pAnswer="لا. العيادة الخاصة غالبًا ترتبط بطبيب أو طبيب أسنان في نطاق مهنته، أما العيادة التخصصية فتكون أوسع من حيث عدد الأطباء أو التخصصات وطريقة الإدارة، وقد تختلف مستنداتها ومعاينتها."
		/>

		<FaqItem
			pQuestion="ما أهمية الرسم الكروكي في ترخيص العيادة؟"
			pAnswer="الرسم الكروكي يوضح شكل العيادة وتوزيع الغرف والخدمات والمدخل والفتحات، ويستخدم أثناء فحص الملف والمعاينة للتأكد من أن الواقع مطابق للمستندات المقدمة."
		/>

		<FaqItem
			pQuestion="هل الخدمة تشمل تجهيز تشطيبات العيادة؟"
			pAnswer="خدمة الترخيص تركز على الملف والمستندات والرسم والمتابعة. يمكن دراسة أعمال التشطيب أو التعديلات المطلوبة في المكان كخدمة منفصلة إذا ظهر أثناء الفحص أن المقر يحتاج تجهيزًا قبل المعاينة."
		/>

	</EmoFaq>







