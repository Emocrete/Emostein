---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="ترخيص عيادة خاصة"
	pDescr="خدمة تجهيز ومتابعة ملف ترخيص عيادة خاصة في مصر، تشمل مراجعة مستندات الطبيب، عقد العيادة، الرسم الكروكي، تجهيزات المكان، ملف النفايات الطبية، ومتابعة إجراءات الترخيص أمام العلاج الحر ومديرية الشؤون الصحية."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("45%","2.5%"),new NumPer("30%","45%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("ترخيص عيادة خاصة")}
				pText={Text.Body.Centered.OfText("خدمة تجهيز ومتابعة ملف ترخيص عيادة خاصة في مصر، تشمل مراجعة مستندات الطبيب، عقد العيادة، الرسم الكروكي، تجهيزات المكان، ملف النفايات الطبية، ومتابعة إجراءات الترخيص أمام العلاج الحر ومديرية الشؤون الصحية.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="المستندات المطلوبة لترخيص عيادة خاصة"
			pDesc="القائمة التالية هي أساس الملف، وقد تزيد أو تتغير بعض التفاصيل حسب المحافظة، نوع التخصص، حالة المقر، أو تعليمات الإدارة المختصة وقت التقديم"
		/>

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات الطبيب")}
					pDesc={Text.Body.Centered.OfText("إثبات الصفة المهنية وصلاحية مزاولة النشاط")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"إيصال أو شهادة تسجيل العيادة في النقابة المختصة لحين صدور الشهادة النهائية حسب المتبع.",
						"صورتان من بطاقة الرقم القومي للطبيب، وتكون البطاقة سارية وواضحة.",
						"صورة كارنيه النقابة العامة للأطباء أو أطباء الأسنان حسب تخصص العيادة.",
						"صورة ترخيص مزاولة المهنة الصادر للطبيب.",
						"صورة من القيد بسجل الأخصائيين أو ما يثبت الدرجة المهنية المطلوبة إذا كان الطلب مقدمًا كعيادة أخصائي.",
						"صورة شخصية للطبيب إذا طلبتها الإدارة المختصة ضمن نموذج الملف.",
						"تفويض أو توكيل رسمي عند تقديم الملف من خلال وكيل أو مكتب متابعة."
					]}
				/>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات المكان والتشغيل")}
					pDesc={Text.Body.Centered.OfText("إثبات صلاحية المقر وتجهيزات العيادة")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"عقد إيجار مثبت التاريخ أو عقد ملكية أو أي سند رسمي يثبت حق استعمال مقر العيادة.",
						"رسم كروكي للعيادة يوضح توزيع الفراغات والفتحات والخدمات والمداخل.",
						"بيان تفصيلي بتجهيزات العيادة والأجهزة والأدوات المستخدمة في التخصص.",
						"عقد أو مستند يوضح طريقة التخلص من النفايات الطبية إذا كانت طبيعة النشاط تنتج مخلفات طبية.",
						"إقرار بوجود طفاية حريق داخل العيادة طبقًا لما تطلبه الإدارة المختصة.",
						"إقرار بتعليق الترخيص في مكان ظاهر داخل العيادة بعد صدوره.",
						"إيصالات الرسوم والدمغات المطلوبة وتقديم الملف في دوسيه منظم حسب تعليمات المديرية."
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="الفرق بين العيادة الخاصة والعيادة التخصصية والمركز الطبي"
			pDesc="تحديد نوع المنشأة من البداية يمنع تقديم طلب على تصنيف غير مناسب للنشاط"
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("عيادة خاصة")}
					pDesc={Text.Body.Centered.OfText("الاختيار المناسب للطبيب الذي يفتح عيادة باسمه")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"تكون باسم طبيب أو طبيب أسنان مرخص له في مزاولة المهنة.",
						"مخصصة لاستقبال المرضى ورعايتهم طبيًا داخل نطاق تخصص الطبيب.",
						"قد توجد أسرة ملاحظة في الحدود التي يقررها القانون واللوائح، لكنها ليست منشأة إقامة علاجية."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("عيادة تخصصية")}
					pDesc={Text.Body.Centered.OfText("اختيار مختلف عندما يوجد أكثر من طبيب وتخصصات متعددة")}
					pHeadBg={new ElemBg(Colors.SkyLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"تضم أكثر من طبيب من تخصصات مختلفة داخل إدارة مشتركة.",
						"يكون لها مدير فني مسؤول عن العيادات طبقًا للتصنيف المطلوب.",
						"قد تتطلب تجهيزات أو موافقات أوسع من العيادة الخاصة حسب طبيعة الخدمات."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("مركز طبي")}
					pDesc={Text.Body.Centered.OfText("تصنيف أوسع من العيادة ويحتاج ملفًا هندسيًا وفنيًا أكبر")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"يستخدم عندما تكون الخدمات أكبر من عيادة منفردة أو عيادات صغيرة مستقلة.",
						"يرتبط عادة بمساحات وتجهيزات ومسؤوليات تشغيلية أوسع.",
						"اختيار تصنيف المركز بدل العيادة يجب أن يتم بعد مراجعة النشاط الفعلي وخطة التشغيل."
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن فتح عيادة قبل صدور الترخيص؟"
			pAnswer="لا يفضل تشغيل العيادة أو الإعلان عنها كمنشأة طبية قبل صدور الترخيص، لأن تشغيل منشأة طبية خاصة دون استكمال الإجراءات يعرض صاحبها لمخاطر الغلق أو المساءلة حسب حالة المخالفة."
		/>

		<FaqItem
			pQuestion="هل عقد الإيجار يكفي وحده لترخيص العيادة؟"
			pAnswer="عقد الإيجار أو الملكية يثبت حق استعمال المكان، لكنه لا يكفي وحده. الملف يحتاج أيضًا مستندات الطبيب، الرسم الكروكي، بيان التجهيزات، الرسوم، الدمغات، ومستندات النفايات الطبية أو الإقرارات المطلوبة."
		/>

		<FaqItem
			pQuestion="هل كل عيادة تحتاج عقد نفايات طبية؟"
			pAnswer="الأمر يرتبط بطبيعة التخصص والنشاط الفعلي داخل العيادة. بعض العيادات تنتج مخلفات طبية واضحة، وبعض الحالات يطلب منها مستند أو إقرار أو عقد التخلص من النفايات طبقًا لتعليمات الإدارة المختصة."
		/>

		<FaqItem
			pQuestion="هل يمكن لأكثر من طبيب العمل في نفس مقر العيادة؟"
			pAnswer="يمكن في بعض الحالات أن يعمل أكثر من طبيب في نفس المقر بترخيص مستقل أو بتصنيف مختلف، لكن ذلك يحتاج مراجعة قانونية وتنظيمية للمكان والتخصصات وطريقة الإدارة قبل تقديم الطلب."
		/>

		<FaqItem
			pQuestion="هل العيادة الخاصة مثل العيادة التخصصية؟"
			pAnswer="لا. العيادة الخاصة غالبًا ترتبط بطبيب أو طبيب أسنان في نطاق مهنته، أما العيادة التخصصية فتكون أوسع من حيث عدد الأطباء أو التخصصات وطريقة الإدارة، وقد تختلف مستنداتها ومعاينتها."
		/>

		<FaqItem
			pQuestion="ما أهمية الرسم الكروكي في ترخيص العيادة؟"
			pAnswer="الرسم الكروكي يوضح شكل العيادة وتوزيع الغرف والخدمات والمدخل والفتحات، ويستخدم أثناء فحص الملف والمعاينة للتأكد من أن الواقع مطابق للمستندات المقدمة."
		/>

		<FaqItem
			pQuestion="هل الخدمة تشمل تجهيز تشطيبات العيادة؟"
			pAnswer="خدمة الترخيص تركز على الملف والمستندات والرسم والمتابعة. يمكن دراسة أعمال التشطيب أو التعديلات المطلوبة في المكان كخدمة منفصلة إذا ظهر أثناء الفحص أن المقر يحتاج تجهيزًا قبل المعاينة."
		/>

	</EmoFaq>







	<RelServices>

		<RelServiceItem pTitle="رسم هندسي لعيادة" pDesc="رفع أبعاد المكان وإعداد الرسم المطلوب لتقديم ملف الترخيص أو تعديل المقر." pHref="/emomed/clinic/dwg" />

		<RelServiceItem pTitle="تشطيب عيادات" pDesc="دراسة وتجهيز التعديلات أو التشطيبات التي يحتاجها المكان قبل معاينة الترخيص." pHref="/emocrete/finishing" />

	</RelServices>







</BLayout>
