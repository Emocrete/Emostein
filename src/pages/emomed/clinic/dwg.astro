---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لعيادة"
	pDescr="خدمة إعداد الرسم الهندسي والكروكي المطلوب ضمن ملف ترخيص عيادة خاصة، شامل رفع المقاسات، توزيع الفراغات، توضيح غرفة الكشف والانتظار والخدمات، ومراجعة الرسم قبل تقديمه ضمن ملف الترخيص أو قبل معاينة العيادة."
>







	<Hero
		pTitle="رسم هندسي لعيادة"
		pDesc="إعداد رسم واضح لمقر العيادة يوضح توزيع الفراغات والتجهيزات والخدمات بما يساعد على تجهيز ملف الترخيص ومراجعة المكان قبل المعاينة"
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="45% 12% 35% 50%"
		pPosP="55% 3% 6% 3%"
	>

		<EmoCall BlackSky pText="اطلب رسم عيادة" />

	</Hero>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="الرسم الهندسي للعيادة ليس مجرد كروكي"
			pDesc="الرسم المطلوب لترخيص العيادة يربط بين بيانات المكان وحالة التشطيب وتوزيع الفراغات وطبيعة النشاط الطبي، لذلك يجب أن يكون واضحًا ومقروءًا ومطابقًا للواقع قبل تقديمه ضمن ملف الترخيص"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.OfText("ما وظيفة الرسم في ملف ترخيص العيادة؟")}
					pText={Text.Body.OfText("الرسم يوضح حدود العيادة ومساحتها وتوزيع غرفها وعلاقتها بالخدمات والمداخل والفتحات. وهو يساعد جهة الفحص أو لجنة المعاينة على فهم المكان بسرعة، ومقارنة الواقع بالمستندات المقدمة بدل الاعتماد على وصف شفهي غير دقيق.")}
					pSize={new Size(new NumPer(600, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.OfText("متى تحتاج إلى رسم جديد؟")}
					pText={Text.Body.OfText("تحتاج إلى رسم جديد عند فتح عيادة لأول مرة، أو نقل العيادة إلى مقر آخر، أو تعديل توزيع الفراغات، أو تجهيز مقر قائم قبل التقديم، أو عند طلب استيفاء رسم أو كروكي أو بيان أوضح من الإدارة المختصة.")}
					pSize={new Size(new NumPer(600, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="ماذا يتضمن الرسم الهندسي للعيادة؟"
			pDesc="العناصر التالية تجعل الرسم قابلًا للقراءة والمراجعة وتقلل ملاحظات الملف أثناء الفحص أو المعاينة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H4.Centered.OfText("مسقط العيادة")}
					pText={Text.Body.Centered.OfText("توضيح حدود المكان وأبعاده الداخلية والخارجية، ومواقع الحوائط والأبواب والشبابيك والأعمدة والبروزات المؤثرة في الاستخدام.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("توزيع الفراغات")}
					pText={Text.Body.Centered.OfText("تحديد غرفة الكشف أو الإجراء، منطقة الانتظار، الاستقبال، دورة المياه، وأي فراغ مساعد مرتبط بطبيعة التخصص.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("الخدمات والتجهيزات")}
					pText={Text.Body.Centered.OfText("إظهار أماكن المياه والصرف والتهوية والتكييف وطفاية الحريق وموقع تجميع أو تسليم النفايات الطبية عند الحاجة.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("بيانات الرسم")}
					pText={Text.Body.Centered.OfText("كتابة العنوان، اسم الطبيب أو صاحب الطلب، المقياس، اتجاه الرسم، اسم كل فراغ، وأي ملاحظات لازمة لقراءة المخطط.")}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="خدمة رفع مقاسات العيادة وإعداد الرسم"
			pDesc="نبدأ من واقع المكان، وليس من تصور نظري، لأن الرسم الذي لا يطابق الواقع يسبب ملاحظات أثناء المعاينة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("ما يتم رفعه من الموقع")}
					pDesc={Text.Body.Centered.OfText("نراجع العناصر المؤثرة في قبول الرسم قبل تحويلها إلى مخطط")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"أبعاد العيادة بالكامل من الداخل وحدودها العامة.",
						"أبعاد غرف الكشف والانتظار والخدمات والاستقبال.",
						"أماكن الأبواب والشبابيك والفتحات ومداخل العيادة.",
						"مواقع الأعمدة أو المناور أو البروزات أو العوائق الثابتة.",
						"مواقع المياه والصرف والتهوية وأي تجهيزات ظاهرة.",
						"ملاحظات التشطيب التي قد تؤثر على المعاينة أو قراءة الرسم."
					]}
				/>

				<EmoList
					pWidth={new RespString("620px", "100%")}
					pTitle={Text.H3.Centered.OfText("ما يتم تسليمه بعد الرفع")}
					pDesc={Text.Body.Centered.OfText("الهدف هو تسليم رسم واضح يصلح للمراجعة داخل ملف العيادة")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"مسقط أفقي واضح يوضح توزيع الفراغات وأبعادها.",
						"تسمية كل فراغ داخل العيادة بطريقة مفهومة.",
						"توضيح المدخل والانتظار وغرفة الكشف والخدمات.",
						"إضافة الملاحظات الفنية اللازمة حسب حالة المكان.",
						"تجهيز الرسم بصيغة مناسبة للطباعة والإرفاق ضمن الملف.",
						"مراجعة أولية للرسم قبل استخدامه في التقديم أو الاستيفاء."
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Gray5)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="حالات تحتاج رسم عيادة مضبوط قبل التقديم"
			pDesc="ليست كل العيادات تحتاج نفس مستوى التفصيل، لذلك نحدد المطلوب حسب حالة المكان ومرحلة الترخيص"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray5)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("عيادة جديدة")}
					pText={Text.Body.Centered.White.OfText("إعداد رسم أولي للمقر قبل تقديم ملف الترخيص، مع توضيح التوزيع المقترح للفراغات والخدمات.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("عيادة قائمة")}
					pText={Text.Body.Centered.White.OfText("رفع الحالة الفعلية للمكان وتجهيز رسم مطابق للواقع عند الحاجة إلى ترخيص أو تعديل أو استيفاء.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("مقر تحت التجهيز")}
					pText={Text.Body.Centered.White.OfText("مراجعة التوزيع قبل تنفيذ التشطيبات حتى لا يتم تنفيذ أعمال يصعب قبولها أو تعديلها لاحقًا.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.White.OfText("طلب استيفاء")}
					pText={Text.Body.Centered.White.OfText("إعادة تنظيم الرسم أو توضيح عناصر ناقصة إذا طلبت الإدارة المختصة رسمًا أوضح أو بيانات إضافية.")}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="خطوات تنفيذ رسم هندسي لعيادة"
			pDesc="تسلسل العمل مصمم لتقليل الأخطاء بين المقاس المرفوع والرسم المسلم وحالة المكان وقت المعاينة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<EmoList
				pWidth={new RespString("1200px", "100%")}
				pTitle={Text.H3.Centered.OfText("طريقة العمل")}
				pDesc={Text.Body.Centered.OfText("كل خطوة مرتبطة بنتيجة محددة حتى يكون الرسم جاهزًا للاستخدام داخل ملف الترخيص")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					{ Title: "مراجعة بيانات العيادة", Items: ["نراجع عنوان المقر، نوع التخصص، حالة المكان، وسبب إعداد الرسم: ترخيص جديد، تعديل، نقل، أو استيفاء.", "هذه الخطوة تحدد مستوى التفصيل المطلوب في الرسم."] },
					{ Title: "رفع المقاسات أو مراجعة الأبعاد", Items: ["نرفع أبعاد المكان فعليًا أو نراجع الأبعاد المرسلة إذا كان العمل يتم عن بعد.", "يتم التركيز على الفراغات والخدمات والفتحات والعناصر الثابتة المؤثرة."] },
					{ Title: "إعداد المسقط وتسمية الفراغات", Items: ["يتم تحويل القياسات إلى مسقط واضح، مع كتابة أسماء الفراغات وتحديد العلاقات بينها.", "نراجع توزيع غرفة الكشف والانتظار والخدمات بطريقة مناسبة لطبيعة العيادة."] },
					{ Title: "مراجعة الملاحظات قبل التسليم", Items: ["نفحص الرسم للتأكد من وضوح الأبعاد والبيانات وعدم وجود تعارض بين النص والرسم.", "إذا كان المكان يحتاج تعديلًا قبل المعاينة نوضح ذلك قبل استخدام الرسم في الملف."] },
					{ Title: "تسليم الرسم للطباعة أو الإرفاق", Items: ["يتم تسليم الرسم بصيغة مناسبة للطباعة أو المراجعة أو الإرسال ضمن مستندات ملف الترخيص.", "يمكن تعديل الرسم عند ظهور ملاحظة رسمية محددة من جهة الفحص."] }
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أخطاء شائعة في رسومات العيادات"
			pDesc="هذه الأخطاء لا تظهر دائمًا عند الرسم على الورق، لكنها تظهر سريعًا عند مراجعة الملف أو مطابقة الرسم على الطبيعة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H4.Centered.OfText("رسم غير مطابق للواقع")}
					pText={Text.Body.Centered.OfText("اختلاف أبعاد الغرف أو مواقع الأبواب أو الخدمات بين الرسم والحالة الفعلية داخل العيادة.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("فراغات غير مسماة")}
					pText={Text.Body.Centered.OfText("وجود غرف أو مناطق داخل الرسم دون توضيح وظيفتها، مما يصعب قراءة النشاط الفعلي للمكان.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("إغفال الخدمات")}
					pText={Text.Body.Centered.OfText("عدم توضيح دورة المياه أو مصادر المياه والصرف أو عناصر التهوية أو التجهيزات الأساسية.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.OfText("غياب بيانات الرسم")}
					pText={Text.Body.Centered.OfText("عدم كتابة العنوان أو المقياس أو اسم صاحب الطلب أو الملاحظات اللازمة لفهم الرسم.")}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="ما الذي يميز رسم العيادة الجيد؟"
			pDesc="الرسم الجيد لا يبالغ في التفاصيل غير المطلوبة، ولا يختصر العناصر التي تحتاجها المعاينة لفهم المقر"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.OfText("واضح للجهة الإدارية")}
					pText={Text.Body.OfText("نستخدم تسمية مباشرة للفراغات، وأبعادًا مقروءة، وتوزيعًا مفهومًا، حتى لا يحتاج الموظف أو المعاين إلى تفسير طويل لفهم الرسم.")}
					pSize={new Size(new NumPer(400, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.OfText("مطابق للواقع")}
					pText={Text.Body.OfText("لا يتم رسم توزيع مثالي منفصل عن حالة المكان. إذا كان الواقع يحتاج تعديلًا، يتم توضيح ذلك قبل تقديم الرسم بدل رسم حالة لن تقبلها المعاينة.")}
					pSize={new Size(new NumPer(400, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.OfText("مناسب لطبيعة العيادة")}
					pText={Text.Body.OfText("عيادة الأسنان أو الجلدية أو الباطنة أو النساء قد تختلف في احتياجها للتجهيز والخدمات. لذلك لا يتم نسخ رسم ثابت لكل الحالات.")}
					pSize={new Size(new NumPer(400, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="cta"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="اطلب إعداد رسم هندسي لعيادتك"
			pDesc="أرسل موقع العيادة وصور المكان وأي أبعاد متاحة، وسنوضح لك المطلوب لإعداد الرسم المناسب لملف الترخيص أو المعاينة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.OfText("البيانات المطلوبة لبدء الرسم")}
					pText={Text.Body.OfText("يفضل إرسال عنوان العيادة، صور واضحة من الداخل، صورة أو وصف لتوزيع الغرف الحالي، وأي مقاسات متاحة إن وجدت. إذا كانت العيادة ما زالت تحت التجهيز، يمكن مراجعة التوزيع المقترح قبل تنفيذ التشطيبات.")}
					pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
				/>

				<VrStack
					pWidth={new Pixel(360, 320)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 20)}
					pBgColor={new ElemBg(Colors.Creamy)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("تواصل مباشر")}
						pText={Text.Body.Centered.OfText("المراجعة الأولى تساعد على تحديد هل المطلوب رسم فقط، أم مراجعة توزيع وتجهيزات قبل المعاينة.")}
						pSize={new Size(new NumPer(320, "100%"), new NumPer("auto", "auto"))}
					/>

					<EmoCall BlackSky pText="اتصل الآن" />

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل الرسم الهندسي للعيادة هو نفسه رسم ترخيص الصيدلية؟"
			pAnswer="لا. رسم العيادة يركز على توزيع الفراغات الطبية والخدمات والتجهيزات المرتبطة بالعيادة، بينما رسم الصيدلية له عناصر وشروط مختلفة مثل المساحة والارتفاع والمسافة حسب طبيعة ترخيص الصيدليات."
		/>

		<FaqItem
			pQuestion="هل يمكن إعداد الرسم من صور فقط؟"
			pAnswer="يمكن عمل مراجعة مبدئية من الصور، لكن الرسم الدقيق يحتاج أبعادًا واضحة. إذا لم تكن المقاسات متاحة، يكون رفع المقاسات من الموقع هو الحل الأفضل لتقليل أخطاء المعاينة."
		/>

		<FaqItem
			pQuestion="هل الرسم يحدد إن كانت العيادة صالحة للترخيص؟"
			pAnswer="الرسم يساعد على قراءة المكان وتوضيح حالته، لكنه لا يغني عن فحص الملف كاملًا أو قرار الجهة المختصة. عند وجود مشكلة ظاهرة في التوزيع أو الخدمات يتم التنبيه إليها قبل التقديم."
		/>

		<FaqItem
			pQuestion="هل أحتاج رسمًا قبل تشطيب العيادة؟"
			pAnswer="نعم، في كثير من الحالات يكون الرسم قبل التشطيب مفيدًا لأنه يوضح التوزيع الصحيح قبل تنفيذ أعمال يصعب تعديلها بعد ذلك، خصوصًا في أماكن الكشف والانتظار والخدمات."
		/>

		<FaqItem
			pQuestion="هل يمكن تعديل الرسم بعد ملاحظات العلاج الحر؟"
			pAnswer="يمكن تعديل الرسم إذا كانت الملاحظة واضحة ومحددة، سواء كانت تخص تسمية فراغ أو توضيح خدمة أو مطابقة أبعاد أو إعادة تنظيم بعض البيانات داخل اللوحة."
		/>

		<FaqItem
			pQuestion="هل خدمة الرسم تشمل استخراج الترخيص؟"
			pAnswer="خدمة الرسم تركز على إعداد المخطط المطلوب للملف. متابعة استخراج ترخيص العيادة خدمة منفصلة يمكن طلبها إذا كنت تريد تجهيز الملف ومتابعته أمام الجهة المختصة."
		/>

	</EmoFaq>







