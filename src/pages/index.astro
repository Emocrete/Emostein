---
import BLayout from "@/Layout.astro";
import { EmoBtn, Emograph } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, NumPer, Pixel, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Organization"
	pTitle="المجموعة الهندسية"
	pDescr="المجموعة الهندسية"
>







	<Hero
		pImgF="/Media/Home"
		pTitle="المجموعة الهندسية"
		pPosL="35% 60% 30% 10%"
		pPosP="15% 5% 50% 5%"
		pBlurP="off"
	>

		<RespImg pImg={new EmoMediaData("Img","/Media/","Emostein.svg",false,"",new Size(new NumPer(700, 280), new NumPer(200, 100)))} />

		<p class = " HeroSlogan ">
			فكرة خلَّاقة .. تنفيذ احترافي
		</p>

	</Hero>







	<EmoSec id="Sections">

		<EmoStr pBg={new ElemBg(Colors.BistageLite)} pSize={new Size(new NumPer("100%", "100%"), new NumPer(300, 600))}>

			<Emograph
				pTitle={Text.Body.WithSize(new Pixel(40)).Centered.OfText("تجد هنا ..")}
				pText={Text.Body.WithSize(new Pixel(30,12)).Centered.OfText("خدمات هندسية تغطي العديد من المجالات المطلوبة في جمهورية مصر العربية ، من خلال اقسام متخصصة تتولى تقديم الخدمات ذات العلاقة في سياق واحد")}
				pSize={new Size(new NumPer(1400, "95%"), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph
					pTitle={Text.H2.Centered.White.OfText("خدمات التصميم الهندسي لكافة التخصصات ، وخدمات المكتب الفني وإدارة المشروعات")}
					pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))}
				/>

			</EmoStr>

			<EmoBtn
				pText="تصميم هندسي"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("مقاولات")} pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))} />

			</EmoStr>

			<EmoBtn
				pText="مقاولات"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("رخام")} pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))} />

			</EmoStr>

			<EmoBtn
				pText="رخام"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("توريدات")} pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))} />

			</EmoStr>

			<EmoBtn
				pText="توريدات"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("تراخيص")} pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))} />

			</EmoStr>

			<EmoBtn
				pText="تراخيص"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("تراخيص طبية")} pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))} />

			</EmoStr>

			<EmoBtn
				pText="تراخيص طبية"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("خدمات استشارية")} pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))} />

			</EmoStr>

			<EmoBtn
				pText="خدمات استشارية"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<EmoStr pHzAlign={Align.LeftCenter} pVrAlign={Align.LeftCenter}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("تسويق عقاري")} pSize={new Size(new NumPer(400, "auto"), new NumPer(200, "auto"))} />

			</EmoStr>

			<EmoBtn
				pText="تسويق عقاري"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStr>

	</EmoSec>







</BLayout>




















<style>



	.HeroSlogan {
		margin: 5;
		font-size: clamp(14px, 2.6vw, 50px);
		line-height: 1;
		font-weight: 500;
		text-align: center;
	}



</style>




















<style>



	@media (orientation: portrait) {
		.HeroSlogan {
			font-size: clamp(20px, 3.2vw, 25px);
		}
	}



</style>
