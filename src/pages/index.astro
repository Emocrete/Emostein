---
import BLayout from "@/Layout.astro";
import { EmoMediaData,Size ,Text, Pixel, ElemBg,Colors, Align} from "@/TypesLib";
import { Hero, IndexSec, ESec, EmoStrip, IncLineSep, BottTriSep, EmoBtn, RespImg, YTPlayer, DataCard, CardsGr, EmoList, Tree, Emograph } from "@/Widgets";
---




















<BLayout pSchemaType="Organization" pTitle="المجموعة الهندسية" pDescr="المجموعة الهندسية">

	<Hero
		pImgF="/Media/Home"
		pTitle="المجموعة الهندسية"
		pPosL="35% 60% 30% 10%"
		pPosP="15% 5% 50% 5%"
		pBlurP="off"
	>

		<RespImg pImg={new EmoMediaData("Img","/Media/","Emostein.svg",false,"",new Size(700,200,280,100))} />

		<p class = " HeroSlogan ">
			فكرة خلَّاقة .. تنفيذ احترافي
		</p>

	</Hero>

	<ESec id="Sections">

		<EmoStrip pBg={new ElemBg(Colors.BistageLite)} pSize={new Size("100%",300,"100%",600)}>

			<Emograph
				pTitle={Text.Body.WithSize(new Pixel(40)).Centered.OfText("تجد هنا ..")}
				pText={Text.Body.WithSize(new Pixel(30,12)).Centered.OfText("خدمات هندسية تغطي العديد من المجالات المطلوبة في جمهورية مصر العربية ، من خلال اقسام متخصصة تتولى تقديم الخدمات ذات العلاقة في سياق واحد")}
				pSize={new Size(1400,"auto","95%","auto")}
			/>

		</EmoStrip>

		<EmoStrip

			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(1920,900,"100%","680px")}
>

	<EmoStrip
		pAlign={Align.LeftCenter}
	>

		<Emograph
			pTitle={Text.H2.Centered.White.OfText("خدمات التصميم الهندسي لكافة التخصصات ، وخدمات المكتب الفني وإدارة المشروعات")}
			pSize={new Size(400,200)}
		/>

	</EmoStrip>

			<EmoBtn
				pText="تصميم هندسي"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStrip>

		<EmoStrip

			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(1920,900,"100%","680px")}
>

	<EmoStrip
		pAlign={Align.LeftCenter}
	>

		<Emograph
			pTitle={Text.H2.Centered.White.OfText("مقاولات")}
			pSize={new Size(400,200)}
		/>

	</EmoStrip>

			<EmoBtn
				pText="مقاولات"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStrip>

		<EmoStrip

			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(1920,900,"100%","680px")}
>

	<EmoStrip
		pAlign={Align.LeftCenter}
	>

		<Emograph
			pTitle={Text.H2.Centered.White.OfText("رخام")}
