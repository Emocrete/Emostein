			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(1920,900,"100%","680px")}
>

	<EmoStrip
		pAlign={Align.LeftCenter}
	>

		<Emograph
			pTitle={Text.H2.Centered.White.OfText("تراخيص طبية")}
			pSize={new Size(400,200)}
		/>

	</EmoStrip>

			<EmoBtn
				pText="تراخيص طبية"
				pHeight="50px"
				pFontSize="25px"
				pWidth="300px"
			/>

		</EmoStrip>

		<EmoStrip

			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(1920,900,"100%","680px")}
>

	<EmoStrip
		pAlign={Align.LeftCenter}
	>

		<Emograph
			pTitle={Text.H2.Centered.White.OfText("خدمات استشارية")}
			pSize={new Size(400,200)}
