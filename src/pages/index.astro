<style>



	.HeroSlogan {
		margin: 5;
		font-size: clamp(14px, 2.6vw, 50px);
		line-height: 1;
		font-weight: 500;
		text-align: center;
	}

	@media (orientation: portrait) {
		.HeroSlogan {
			font-size: clamp(20px, 3.2vw, 25px);
		}
	}



</style>
