---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="Organization" pTitle="المجموعة الهندسية" pDescr="المجموعة الهندسية">







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.OfText("المجموعة الهندسية")} />

			<RespImg pImg={new EmoMediaData("Img","/Media/","Emostein.svg",false,"",new Size(new NumPer(700, 280), new NumPer(200, 100)))} />

			<Emograph
				pTitle={Text.Body.Bold.Centered.OfSize(50,25).OfText("فكرة خلَّاقة .. تنفيذ احترافي")}
				pText={Text.Body.Centered.OfText("خدمات هندسية تغطي العديد من المجالات المطلوبة في جمهورية مصر العربية ، من خلال اقسام متخصصة تتولى تقديم الخدمات ذات العلاقة في سياق واحد")}
			/>

			<HzStack pGap={new Pixel(30,10)} pForceHz>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec id="Sections">

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/./_M/","Emodsign.webp",true))}
			pHzAlign={Align.LeftCenter}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("المكتب الهندسي")} />

				<EmoDet WhiteBlack pHref="/emodsign" />

			</VrStack>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("المقاولات")} />

				<EmoDet WhiteBlack pHref="/emocrete" />

			</VrStack>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("توريد وتركيب الرخام والجرانيت والأحجار الطبيعية")} />

				<EmoDet WhiteBlack pHref="/emostone" />

			</VrStack>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("التوريدات العمومية")} />

				<EmoDet WhiteBlack pHref="/emochain" />

			</VrStack>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("التراخيص الإدارية")} />

				<EmoDet WhiteBlack pHref="/emoperm" />

			</VrStack>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("التراخيص الطبية")} />

				<EmoDet WhiteBlack pHref="/emomed" />

			</VrStack>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("الخدمات الاستشارية الهندسية")} />

				<EmoDet WhiteBlack pHref="/emonsult" />

			</VrStack>

		</EmoStr>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff,new EmoMediaData("Img","/Media/Home/","Emodsign.webp",true))}
			pSize={new Size(new NumPer(1920, "100%"), new NumPer(900, "680px"))}
		>

			<VrStack pSize={new Size(new NumPer(1000, "auto"))} pLoc={new Loc(new NumPer(100, "auto"),new NumPer(100, 50))} pHzAlign={"Center"}>

				<Emograph pTitle={Text.H2.Centered.White.OfText("التسويق العقاري")} />

				<EmoDet WhiteBlack pHref="/emostate" />

			</VrStack>

		</EmoStr>

	</EmoSec>







</BLayout>
