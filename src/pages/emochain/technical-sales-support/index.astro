---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, SplitPane, SplitScene } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="دعم المبيعات الفنية للمنتجات الهندسية"
	pDescr="دعم المبيعات الفنية للمنتجات الهندسية — خدمة مساندة لدورة المشتريات والتوريد تربط المستندات والموردين واللوجستيات والمتابعة باحتياجات المشروع الفعلية. وفي هذه الصفحة يكون التركيز الخاص على تجهيز معلومات الأصل والتحقق من نقاط القوة الفنية التي تؤثر في قرار المشتري. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="دعم المبيعات الفنية للمنتجات الهندسية">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("دعم المبيعات الفنية للمنتجات الهندسية")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("خدمة مساندة لدورة المشتريات والتوريد تربط المستندات والموردين واللوجستيات والمتابعة باحتياجات المشروع الفعلية. وفي هذه الصفحة يكون التركيز الخاص على تجهيز معلومات الأصل والتحقق من نقاط القوة الفنية التي تؤثر في قرار المشتري.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<SplitScene pBg={Colors.Gray1} pColumns={new RespString("1fr 1fr","1fr")} pGap={new RespString("12px","10px")} pPad={new RespString("42px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pEdge="Chevron" pEdgeP="None" pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("نطاق الخدمة")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("تحديد المطلوب ومسؤوليات الأطراف مع مراعاة تجهيز معلومات الأصل والتحقق من نقاط القوة الفنية التي تؤثر في قرار المشتري، تنسيق المستندات والموردين والخطوات، متابعة المخرجات حتى نقطة التسليم المتفق عليها.")} />
		</SplitPane>
		<SplitPane pBg={Colors.SkyLite} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("الفائدة قبل الخطوة التالية")} pText={Text.Body.WithColor(Colors.Black).OfText("تقلل الوقت الضائع بين جهات متعددة وتوفر سجلًا أوضح للعرض المعتمد والمستندات وحالة التوريد. ويُراجع القرار هنا تحديدًا في ضوء تجهيز معلومات الأصل والتحقق من نقاط القوة الفنية التي تؤثر في قرار المشتري.")} />
		</SplitPane>
	</SplitScene>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 5,000 ج.م للمهمة المحددة، ويزيد حسب عدد الموردين والبنود والزيارات.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
