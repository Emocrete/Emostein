					pDesc={Text.Body.OfText("هذه الأسئلة تساعد على تحويل العنوان العام إلى خطة توريد قابلة للتنفيذ.")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.Creamy)}
					pItemFnt={Text.Body}
					pNumbered={false}
