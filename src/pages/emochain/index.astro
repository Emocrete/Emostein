				pSize={new Size(new NumPer(620, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("الخدمة واسعة لكنها ليست بلا شروط")}
				pText={Text.Body.OfText(`الصفحة الجيدة لا تكتفي بذكر ما تستطيع الخدمة فعله، بل تذكر أيضًا حدودها. فالعميل الجاد يقدر الوضوح، ومقدم الخدمة الجاد لا يريد أن يبني توقعات غير قابلة للتنفيذ. التوريدات العمومية مجال واسع، وإذا لم يتم وضع حدود واضحة فقد تتحول الصفحة إلى باب لطلبات غير مناسبة أو غير قانونية أو غير مجدية اقتصاديًا.

أول حد أساسي أن الخدمة لا تتعامل مع الأصناف المخالفة للقانون أو التي لا يجوز تداولها أو التي تحتاج تصاريح خاصة لا تتوفر في نطاق الطلب. ثانيًا، بعض الطلبات تحتاج حدًا أدنى للكمية. قد يكون الصنف متوفرًا، لكن توريده بكمية صغيرة إلى منطقة معينة يجعل تكلفة النقل أعلى من قيمة الطلب. في هذه الحالة يمكن إبلاغ العميل بالبدائل: زيادة الكمية، تجميع الطلب مع أصناف أخرى، استلامه من نقطة محددة، أو البحث عن مورد أقرب.

ثالثًا، لا يكون السعر نهائيًا قبل تحديد الكمية ومكان التسليم وشروط المستندات. يمكن إعطاء نطاق سعري أو تقدير مبدئي في بعض الحالات، لكن الاعتماد النهائي يحتاج بيانات أوضح. هذا يمنع سوء الفهم عندما يتغير السعر بعد ظهور معلومة جديدة.`)}
			/>

			<EmoList
				pWidth={new RespString("620px", "320px")}
				pTitle={Text.H3.OfText("تنبيهات مهمة قبل الاعتماد")}
				pDesc={Text.Body.OfText("هذه الحدود يجب أن تظهر في الصفحة حتى لا تتحول كلمة عمومية إلى وعد مفتوح لا يمكن تنفيذه.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Creamy)}
				pItemFnt={Text.Body}
				pNumbered={false}
				pItems={[
					`الصور تساعد في البحث لكنها لا تضمن التطابق الكامل دون مقاسات أو كود أو عينة أو بيانات إضافية.`,
					`التوريد العاجل يعتمد على التوفر الفعلي ولا يمكن ضمانه لكل صنف أو منطقة أو كمية.`,
					`الفاتورة أو المستندات أو الضريبة يجب توضيحها قبل الاتفاق لأنها تؤثر على طريقة التعامل.`,
					`الاستبدال والإرجاع يخضعان لطبيعة الصنف وشروط المورد وحالة المنتج وسبب الاستبدال.`,
					`بعض الأصناف الخاصة أو المطلوبة بمقاس أو لون أو كمية محددة قد تكون غير قابلة للإرجاع بسهولة.`,
					`يمكن رفض الطلب غير المناسب إذا كان لا يحتوي على بيانات كافية أو يتطلب تخصصًا لا يمكن تنفيذه بصورة مهنية.`
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
