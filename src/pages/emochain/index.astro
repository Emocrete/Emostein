				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(25, 20)}
				pPad={new Pixel(35, 20)}
			>

				<Emograph
					pSize={new Size(new NumPer(1100, 320), new NumPer("auto", "auto"))}
					pTitle={Text.H3.Centered.OfText("لكل شكل طلب طريقة تعامل مختلفة")}
					pText={Text.Body.OfText(`ليست كل طلبات التوريد متشابهة. بعض الطلبات يبدأ بصنف واحد واضح، وبعضها يبدأ بقائمة طويلة، وبعضها يبدأ بصورة، وبعضها يبدأ بعرض سعر يحتاج إلى مراجعة، وبعضها عاجل لدرجة أن معيار الوقت يصبح أهم من البحث الطويل عن أقل سعر. فهم نوع الطلب يساعد على تحديد طريقة التعامل معه، ويمنع استخدام نفس المسار لكل الحالات.

في قوائم المشروعات المتكاملة، قد يتعامل العميل مع كشف مشتريات يتضمن أصنافًا من أكثر من قطاع، مثل مستلزمات كهرباء وسباكة ومهمات أمن صناعي وتجهيزات مكتبية وخامات تشطيب. هذه الحالة لا تصلح للتسعير العشوائي بندًا بندًا فقط، بل تحتاج إلى تصنيف القائمة، فصل البنود الواضحة عن البنود الناقصة، وتحديد ما يمكن تجميعه في توريد واحد وما يحتاج موردًا متخصصًا.`)}
				/>

				<CardsGr
					pWidth={new RespString("1300px", "340px")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pStackDir="Row"
					pSpacing={20}
					pTopic1={new Topic("طلب صنف واحد", `مناسب عندما يعرف العميل الصنف أو يملك صورة أو رابطًا أو عينة. يتم التركيز على الكمية، المقاس، مكان التسليم، وهل المطلوب مطابق تمامًا أم يقبل بديلًا.`)}
					pTopic2={new Topic("قائمة مشتريات كاملة", `تصلح للشركات والمواقع والمحلات قبل الافتتاح. يتم ترتيب القائمة وتصنيف البنود وتحديد الناقص قبل التسعير حتى لا تضيع الأصناف بين أكثر من مورد.`)}
					pTopic3={new Topic("توريد دوري", `مناسب لمستهلكات التشغيل والصيانة والأصناف المتكررة. يمكن بناء قائمة ثابتة نسبيًا ومعدل احتياج شهري أو أسبوعي لتقليل الشراء الطارئ.`)}
					pTopic4={new Topic("توريد عاجل", `يخدم نقصًا مؤثرًا في موقع أو تشغيل. يتم التركيز على المتاح الفعلي، أقرب موعد، تكلفة النقل، وهل يمكن قبول بديل قريب.`)}
					pTopic5={new Topic("مقارنة أسعار", `تساعد العميل على مقارنة عروض الموردين على أساس مواصفة موحدة، لا على أساس أرقام تبدو متشابهة بينما تختلف في النقل أو الجودة أو الفاتورة.`)}
					pTopic6={new Topic("بحث عن بدائل", `يستخدم عندما يكون الصنف غير متوفر أو مكلفًا أو غير واضح الاسم. البديل لا يقاس بالسعر فقط، بل بملاءمته للاستخدام المطلوب.`)}
					pTopic7={new Topic("مراجعة عرض مورد", `مناسبة قبل اعتماد عرض قائم. يتم النظر في وضوح البنود، الكمية، مدة التوريد، النقل، الضريبة، الفاتورة، وشروط الاستبدال.`)}
					pTopic8={new Topic("توريد مع نقل أو تركيب", `بعض الأصناف تحتاج تسليمًا خاصًا أو تركيبًا أو تنزيلًا. يجب إعلان ذلك من البداية لأن المسؤولية والسعر والمدة تختلف عن التوريد فقط.`)}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="كيف ندير طلب التوريد من أول رسالة حتى التسليم؟"
			pDesc="الاحترافية في التوريدات لا تعتمد على الاجتهاد الشخصي وحده، بل على مسار عمل واضح يمنع ترك التفاصيل للصدفة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("630px", "320px")}
				pTitle={Text.H3.OfText("المسار العملي للطلب")}
				pDesc={Text.Body.OfText("يمكن أن يبدأ الطلب بصورة أو قائمة أو وصف مختصر، ثم يتم تحويله تدريجيًا إلى بيانات قابلة للتسعير والتنفيذ.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Creamy)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					`إرسال الطلب بصورة، قائمة، رابط، ملف، عرض سعر سابق، أو وصف استخدام.`,
					`فهم الغرض من الصنف: تشغيل، تجهيز، تنفيذ، صيانة، بيع، أو استخدام داخلي.`,
					`تحديد البيانات الناقصة مثل الكمية، الوحدة، المقاس، اللون، الموديل، مكان التسليم، والفاتورة.`,
					`ضبط المواصفة حتى لا تكون المقارنة بين الموردين مبنية على أسماء عامة أو افتراضات غير مكتوبة.`,
					`البحث عن المتاح أو البدائل المناسبة حسب حجم الطلب ودرجة وضوحه والموعد المطلوب.`,
					`تجهيز عرض يوضح الوصف والكمية والسعر والنقل ومدة التوريد وطريقة الدفع والملاحظات.`,
					`اعتماد العميل للعرض والشروط قبل البدء في التوريد أو الحجز أو الشراء.`,
					`تنسيق التسليم والاستلام، ثم متابعة أي ملاحظة ظاهرة حسب الشروط المتفق عليها.`
				]}
			/>

			<Emograph
				pSize={new Size(new NumPer(630, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("لماذا لا نبدأ بالسعر مباشرة؟")}
				pText={Text.Body.OfText(`تنفيذ طلب التوريد الجيد يحتاج إلى مسار واضح. العميل الذي يزور الصفحة يجب أن يعرف ماذا سيحدث بعد أن يرسل رسالته. الوضوح في هذه المرحلة يقلل القلق ويزيد احتمالات التواصل، لأن كثيرًا من العملاء يترددون عندما لا يعرفون هل طلبهم مكتمل أم لا، أو هل سيتم تجاهله لأنه غير منظم. لذلك يجب شرح رحلة الطلب بلغة بسيطة ومهنية.

لا نقوم بتمرير الطلب للتسعير مباشرة إذا كان ناقصًا. يتم أولًا فهم الاستخدام والتحقق من البيانات المؤثرة؛ لأن نفس الصنف قد يختلف حسب الغرض. منتج للاستخدام الداخلي ليس مثل منتج سيظهر أمام العملاء، وصنف مؤقت ليس مثل صنف سيستخدم لفترة طويلة، وخامة لموقع تنفيذ ليست مثل خامة لمحل مفتوح للجمهور. فهم الاستخدام يساعد على اقتراح بدائل مناسبة وعدم الاكتفاء بتوفير أي منتج يحمل الاسم نفسه.

بعد وضوح المواصفة يبدأ البحث والتسعير. لا يعني ذلك دائمًا الاتصال بعشرات الموردين، بل يعني البحث بطريقة مناسبة لحجم الطلب ودرجة وضوحه. بعض الأصناف متداولة وسهلة التسعير، وبعضها يحتاج إلى بدائل أو مورد متخصص أو وقت أطول للتحقق. المهم أن يعرف العميل هل السعر نهائي أم مبدئي، وهل يعتمد على توفر لحظي أم يمكن تثبيته لمدة محددة.`)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

