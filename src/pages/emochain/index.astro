				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("تنظيف القائمة", `مراجعة التكرار، فصل البنود غير الواضحة، وتوحيد طريقة كتابة الوحدات والكميات قبل إرسالها للتسعير.`)}
				pTopic2={new Topic("تصنيف البنود", `تجميع الأصناف حسب المجال أو المورد أو درجة الوضوح حتى لا تصبح القائمة خليطًا يصعب تسعيره أو متابعته.`)}
				pTopic3={new Topic("تحديد الأولويات", `فصل الأصناف الحرجة التي توقف العمل عن الأصناف التي يمكن توريدها لاحقًا أو استبدالها ببدائل مقبولة.`)}
				pTopic4={new Topic("تنظيم التسليم", `تحديد هل التوريد دفعة واحدة أم على مراحل، وهل يحتاج موقع التسليم تجهيزًا للاستلام أو تخزينًا أو مسؤولًا محددًا.`)}
			/>

		</VrStack>

	</EmoSec>







	<EmoSec
