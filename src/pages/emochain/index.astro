		<VrStack
			pWidth={new Pixel(1300, 340)}
			pGap={new Pixel(25, 20)}
			pPad={new Pixel(35, 20)}
		>

			<Emograph
				pSize={new Size(new NumPer(1100, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.Centered.OfText("الاختلاف ليس في السلعة فقط، بل في سبب الشراء")}
				pText={Text.Body.OfText(`تخدم التوريدات العمومية أكثر من نوع من العملاء، لكن كل عميل يدخل إلى الصفحة بدافع مختلف. لذلك لا يكفي أن تقول الصفحة إن الخدمة مناسبة للشركات والأفراد، بل يجب أن تشرح كيف يستفيد كل نوع عميل وما المشكلة التي يحاول حلها. فالشركة لا تفكر مثل صاحب محل قبل الافتتاح، والمقاول لا يقلقه ما يقلق إدارة مكتب، والعميل الفردي قد يحتاج إلى مساعدة في فهم اسم الصنف قبل أن يحتاج إلى سعر.

الشركات الصغيرة والمتوسطة تحتاج هذه الخدمة عندما تكون لديها مشتريات غير كافية لتأسيس إدارة مشتريات كاملة، لكنها في الوقت نفسه متكررة أو متنوعة بما يكفي لإضاعة وقت الموظفين. قد تحتاج الشركة إلى أدوات، مستهلكات، تجهيزات، أصناف صيانة، أو منتجات إدارية. المشكلة هنا ليست في شراء صنف واحد، بل في تكرار العملية مع أكثر من مورد وغياب آلية منظمة للطلب والتوثيق والمتابعة.`)}
			/>

			<CardsGr
				pWidth={new RespString("1300px", "340px")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("أصحاب الشركات والمشروعات", `يحتاجون إلى تقليل التشتت بين الموردين، توحيد المستندات قدر الإمكان، وضبط ميزانية المشتريات دون استنزاف الإدارة في متابعة كل صنف صغير.`)}
				pTopic2={new Topic("المكاتب والأنشطة الإدارية", `تستفيد عندما تحتاج إلى مستلزمات تشغيل أو تجهيز أو صيانة دون الدخول في تفاصيل السوق أو إهدار وقت الفريق في مشتريات متفرقة.`)}
				pTopic3={new Topic("المحلات والأنشطة التجارية", `تحتاج الخدمة قبل الافتتاح أو عند التجديد أو عند نقص صنف مؤثر، لأن التأخير قد يعني خسارة يوم تشغيل أو تعطيل خدمة أمام العملاء.`)}
				pTopic4={new Topic("المقاولون ومشرفو المواقع", `يريدون صنفًا مناسبًا يصل في توقيت مرتبط بمرحلة التنفيذ، لأن الخطأ في المقاس أو الكمية أو نوع الخامة قد يوقف العمال أو يسبب هالكًا.`)}
				pTopic5={new Topic("ملاك المشروعات والأفراد", `قد لا يعرفون اسم المنتج أو مصدره، لكنهم يملكون صورة أو وصفًا أو استخدامًا مطلوبًا. هنا تبدأ الخدمة من المتاح لدى العميل لا من كتالوج جاهز.`)}
				pTopic6={new Topic("إدارات المشتريات غير المتخصصة", `تحتاج دعمًا عند ظهور طلبات خارج نطاق خبرتها المعتاد، أو عند مراجعة عرض مورد يحتاج إلى تدقيق في البنود والشروط.`)}
			/>

			<Emograph
				pSize={new Size(new NumPer(1100, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.Centered.OfText("القاسم المشترك بين هذه الحالات")}
				pText={Text.Body.OfText(`القاسم المشترك بين هؤلاء العملاء ليس نوع السلعة، بل الحاجة إلى جهة تساعد في تحويل الطلب إلى عملية شراء أكثر تنظيمًا. لذلك تظل الصفحة عامة في نطاقها، لكنها دقيقة في شرح آلية الخدمة وحدودها. لا يتم إغراق الزائر بقائمة منتجات متنافرة، ولا يتم تقديم وعود مفتوحة. يتم توجيهه إلى طريقة إرسال الطلب، والبيانات التي تساعد على التسعير، والمخاطر التي يمكن تقليلها، وحدود ما يمكن الالتزام به.`)}
			/>

		</VrStack>

	</EmoSec>







	<EmoSec hidden>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
