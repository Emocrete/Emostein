---
import BLayout from "@/Layout.astro";
import { EmoCall, EmoDet, Emograph, EmoWhats, Grid, SecTitle, VrStack } from "@/Widgets/Comp";
import { MosaicGrid, MosaicItem, StoryRail, StoryStep } from "@/Widgets/Layouts";
import { DivCol, DivStr, EmoSec, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Align, ElemBg, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريدات هندسية للمشروعات | إدارة شراء ومقارنة ومتابعة"
	pDescr="خدمة إدارة وتنسيق التوريدات الهندسية للمشروعات في القاهرة والجيزة، تشمل ترتيب قوائم الشراء، البحث عن الموردين، جمع الأسعار، المقارنة الفنية والتجارية، المعاينة، ومتابعة التسليم."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("48%", "94%"), new NumPer("auto", "auto"))}
			pGap={new Pixel(24, 16)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.Bold.OfText("توريدات هندسية")}
				pText={Text.Body.Centered.OfSize(23, 18).OfText("إدارة شراء وتنسيق توريد للمشروعات التي تجمع عدة بنود وموردين وأسواق")}
			/>

			<Emograph
				pText={Text.Body.Centered.OfText("أستلم قائمة البنود والمواصفات، أرتبها حسب طبيعة السوق، أجمع عروض الموردين، أراجع الفروق الفنية والتجارية، وأتابع التجهيز والتسليم حسب نطاق المهمة.")}
			/>

			<Emograph
				pText={Text.Body.Centered.OfText("الشراء والفاتورة يصدران من المورد المختار، ودوري هو إدارة البحث والمقارنة والتنسيق والمتابعة نيابة عن العميل.")}
			/>

			<EmoCall BlackOrange />

			<EmoWhats />

			<EmoDet />

		</VrStack>

	</Hero>







	<EmoSec>

		<DivStr
			pContentSize={new Size(new NumPer("88%", "96%"), new NumPer("auto", "auto"))}
			pGap={new Pixel(34, 20)}
			pPad={new Pixel(55, 28)}
			pHzAlign={new Align("Center", "Center")}
			pVrAlign={new Align("Center", "Center")}
		>

			<DivCol pBg={new ElemBg("#172126")} pPad={new Pixel(34, 22)} pGap={new Pixel(18, 14)}>

				<Emograph
					pTitle={Text.H2.White.OfText("مهمة واحدة بدل جولات شراء متفرقة")}
					pText={Text.Body.White.OfText("تظهر قيمة الخدمة عندما تضم قائمة المشروع بنودًا من أكثر من تخصص أو أكثر من سوق. بدل توزيع البحث والمتابعة بين عدة أشخاص، تتجمع القائمة في مسار واحد يبدأ من تعريف المطلوب وينتهي بوصول البنود التي تم اعتمادها.")}
				/>

				<Emograph
					pTitle={Text.H4.WithColor("#D6A45D").OfText("أقرب استخدام للخدمة")}
					pText={Text.Body.White.OfText("مقايسة، قائمة مشتريات مشروع، حزمة MEP، توريدات صيانة لمنشأة، أو مجموعة خامات ومعدات يحتاج كل جزء منها إلى مصدر مختلف.")}
				/>

			</DivCol>

			<DivCol pBg={new ElemBg("#F2E7D3")} pPad={new Pixel(34, 22)} pGap={new Pixel(18, 14)}>

				<Emograph
					pTitle={Text.H2.WithColor("#172126").OfText("الخدمة يقدمها مهندس مستقل")}
					pText={Text.Body.WithColor("#3C484B").OfText("العمل مناسب للمقاول أو صاحب المشروع أو مدير المنشأة الذي يحتاج شخصًا يفهم بنود المشروع ويتواصل مع الموردين ويتابع التفاصيل اليومية للشراء. نطاق المهمة يتحدد من القائمة المتاحة ومستوى المراجعة والزيارات والمتابعة المطلوبة.")}
				/>

				<Emograph
					pTitle={Text.H4.WithColor("#A76F35").OfText("البند المنفرد معروف المصدر")}
					pText={Text.Body.WithColor("#3C484B").OfText("التعامل المباشر مع المورد المتخصص يكون عادة أسرع في البند الواحد الواضح. قيمة التنسيق تزيد مع تعدد البنود والموردين والأسواق ومواعيد التسليم.")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<SecTitle
		Creamy
		pTitle="نطاق العمل داخل فرع التوريدات الهندسية"
		pDesc="كل صفحة فرعية تغطي جزءًا محددًا من دورة الشراء، ويمكن جمع أكثر من جزء داخل مهمة واحدة حسب احتياج المشروع."
	/>







	<MosaicGrid pColumns={12} pColumnsP={4} pBg="#ECE8DF">

		<MosaicItem
			pColSpan={5}
			pColSpanP={4}
			pRowSpan={3}
			pRowSpanP={2}
			pBg="#172126"
			pColor="#FFFFFF"
		>

			<Emograph
				pTitle={Text.H2.White.OfText("من قائمة البنود إلى خطة شراء")}
				pText={Text.Body.White.OfText("تجميع الكميات والمواصفات والصور والرسومات، ثم تقسيم البنود إلى مجموعات يمكن تسعيرها ومتابعتها مع الجهات المناسبة لكل مجموعة.")}
			/>

		</MosaicItem>

		<MosaicItem
			pColSpan={3}
			pColSpanP={2}
			pRowSpan={2}
			pRowSpanP={2}
			pBg="#D9B47B"
			pColor="#172126"
		>

			<Emograph
				pTitle={Text.H3.WithColor("#172126").OfText("أسعار وموردون")}
				pText={Text.Body.WithColor("#172126").OfText("بحث في أكثر من سوق وتجميع ردود قابلة للمقارنة.")}
			/>

		</MosaicItem>

		<MosaicItem
			pColSpan={4}
			pColSpanP={2}
			pRowSpan={2}
			pRowSpanP={2}
			pBg="#DCE7E2"
			pColor="#172126"
		>

			<Emograph
				pTitle={Text.H3.WithColor("#172126").OfText("فني وتجاري")}
				pText={Text.Body.WithColor("#344347").OfText("قراءة السعر مع المواصفة والمدة والنقل والدفع ونطاق التوريد.")}
			/>

		</MosaicItem>

		<MosaicItem
			pColSpan={4}
			pColSpanP={2}
			pRowSpan={2}
			pRowSpanP={2}
			pBg="#F8F2E8"
			pColor="#172126"
		>

			<Emograph
				pTitle={Text.H3.WithColor("#172126").OfText("معاينة عند الحاجة")}
				pText={Text.Body.WithColor("#344347").OfText("زيارة المورد وتوثيق البند والكمية والحالة الظاهرة والمستندات المرتبطة به.")}
			/>

		</MosaicItem>

		<MosaicItem
			pColSpan={3}
			pColSpanP={2}
			pRowSpan={2}
			pRowSpanP={2}
			pBg="#9BB5AA"
			pColor="#172126"
		>

			<Emograph
				pTitle={Text.H3.WithColor("#172126").OfText("متابعة التسليم")}
				pText={Text.Body.WithColor("#172126").OfText("تحديث التجهيز والشحن والكميات المستلمة والمتبقية.")}
			/>

		</MosaicItem>

	</MosaicGrid>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("تجهيز الطلب والوصول إلى الموردين")}
		pDesc={Text.Body.Centered.White.OfText("صفحات البداية عندما تكون لديك مقايسة أو قائمة بنود وتحتاج ترتيبها وتسعيرها من أكثر من مصدر.")}
		pHeadBg={new ElemBg("#172126")}
		pBodyBg={new ElemBg("#F1ECE3")}
		pCardBg={new ElemBg("#FFFDF8")}
		pMax={3}
		pMaxP={1}
	>

		<RelServiceItem
			pTitle="تسعير بنود المقايسات"
			pDesc="تحويل الـ BOQ إلى مجموعات شراء، وتجهيز طلبات الأسعار، وربط البنود بردود الموردين."
			pHref="/emochain/boq-procurement/"
			pBtnText="تسعير بنود المقايسات"
		/>

		<RelServiceItem
			pTitle="تسعير عدة بنود"
			pDesc="تنسيق قائمة مشتريات تجمع خامات ومعدات ومستلزمات من أسواق مختلفة."
			pHref="/emochain/multi-item-sourcing/"
			pBtnText="تسعير عدة بنود"
		/>

		<RelServiceItem
			pTitle="البحث عن موردين"
			pDesc="تحديد نوع المصدر المناسب لكل بند وجمع جهات يمكن طلب السعر والبيانات منها."
			pHref="/emochain/supplier-sourcing/"
			pBtnText="البحث عن موردين"
		/>

	</RelServices>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("مراجعة عروض الموردين")}
		pDesc={Text.Body.Centered.White.OfText("مرحلة ترتيب العروض بعد وصول الأسعار والبيانات الفنية من أكثر من جهة.")}
		pHeadBg={new ElemBg("#31525A")}
		pBodyBg={new ElemBg("#E6EEEA")}
		pCardBg={new ElemBg("#FFFFFF")}
		pMax={3}
		pMaxP={1}
	>

		<RelServiceItem
			pTitle="مقارنة عروض الأسعار"
			pDesc="توحيد الأسعار والضريبة والنقل والدفع ومدة التوريد ونطاق كل عرض في جدول واحد."
			pHref="/emochain/quotations-comparison/"
			pBtnText="مقارنة عروض الأسعار"
		/>

		<RelServiceItem
			pTitle="المقارنة الفنية"
			pDesc="ترتيب الموديلات والمواصفات والسعات والخامات والملحقات بجانب متطلبات المشروع."
			pHref="/emochain/technical-comparison/"
			pBtnText="المقارنة الفنية"
		/>

		<RelServiceItem
			pTitle="معاينة قبل التوريد"
			pDesc="توثيق البند المتاح لدى المورد قبل الشحن أو الاستلام حسب نقاط المراجعة المطلوبة."
			pHref="/emochain/inspection/"
			pBtnText="معاينة قبل التوريد"
		/>

	</RelServices>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("إدارة الشراء ومتابعة التنفيذ")}
		pDesc={Text.Body.Centered.White.OfText("مرحلة متابعة البنود بعد اختيار المورد، أو إسناد دورة المشتريات كاملة ضمن نطاق واحد.")}
		pHeadBg={new ElemBg("#7B5935")}
		pBodyBg={new ElemBg("#F2E6D5")}
		pCardBg={new ElemBg("#FFFDF9")}
		pMax={2}
		pMaxP={1}
	>

		<RelServiceItem
			pTitle="متابعة أوامر التوريد"
			pDesc="متابعة التجهيز والجاهزية والشحن والتسليم الجزئي والكميات المستلمة والمتبقية."
			pHref="/emochain/procurement-follow-up/"
			pBtnText="متابعة أوامر التوريد"
		/>

		<RelServiceItem
			pTitle="إدارة مشتريات المشروع"
			pDesc="جمع ترتيب البنود وطلب الأسعار والمقارنة والمتابعة والتسليم داخل مهمة واحدة."
			pHref="/emochain/project-procurement/"
			pBtnText="إدارة مشتريات المشروع"
		/>

	</RelServices>







	<SecTitle Black pTitle="دورة العمل من بداية الطلب حتى التسليم" pDesc="عدد المراحل الفعلية يتغير حسب حجم القائمة وما تم إنجازه قبل بدء المهمة." />







	<StoryRail pBg="#101820" pAccent="#D9B47B" pTrackColor="rgba(255,255,255,.24)">

		<StoryStep
			pNumber="01"
			pKicker="الطلب"
			pTitle="استلام القائمة"
			pText="تجميع أسماء البنود والكميات والمواصفات والصور والرسومات ومكان التسليم والموعد المطلوب."
			pBg="#FFF9F0"
			pColor="#172126"
			pAccent="#D9B47B"
		/>

		<StoryStep
			pNumber="02"
			pKicker="التقسيم"
			pTitle="مجموعات الشراء"
			pText="فرز البنود حسب السوق والتخصص وطريقة التسعير حتى يذهب كل طلب إلى الجهات الأقرب له."
			pBg="#DDE8E2"
			pColor="#172126"
			pAccent="#7FA091"
		/>

		<StoryStep
			pNumber="03"
			pKicker="السوق"
			pTitle="الموردون والأسعار"
			pText="التواصل مع مصادر مناسبة وتجميع السعر ومدة التجهيز ومكان الاستلام والبيانات المتاحة عن المنتج."
			pBg="#F2D9B7"
			pColor="#172126"
			pAccent="#D9B47B"
		/>

		<StoryStep
			pNumber="04"
			pKicker="المراجعة"
			pTitle="المقارنة الفنية والتجارية"
			pText="ترتيب فروق المواصفات والسعر والدفع والنقل والمدة والملحقات في صورة تسهل اختيار العرض المناسب."
			pBg="#DCE7EC"
			pColor="#172126"
			pAccent="#7391A0"
		/>

		<StoryStep
			pNumber="05"
			pKicker="الاعتماد"
			pTitle="المعاينة والتأكيد"
			pText="تنفيذ المعاينة عندما تدخل ضمن المهمة، وتسجيل ما يلزم قبل إصدار أمر الشراء أو بدء الشحن."
			pBg="#FFF9F0"
			pColor="#172126"
			pAccent="#D9B47B"
		/>

		<StoryStep
			pNumber="06"
			pKicker="التنفيذ"
			pTitle="متابعة التوريد"
			pText="متابعة حالة التجهيز ومواعيد التحرك والاستلام والكميات المتبقية حتى إقفال البنود الداخلة في المهمة."
			pBg="#DDE8E2"
			pColor="#172126"
			pAccent="#7FA091"
		/>

	</StoryRail>







	<EmoSec>

		<DivStr
			pBg={new ElemBg("#F3E8D2")}
			pContentSize={new Size(new NumPer("86%", "95%"), new NumPer("auto", "auto"))}
			pGap={new Pixel(28, 18)}
			pPad={new Pixel(55, 30)}
			pHzAlign={new Align("Center", "Center")}
			pVrAlign={new Align("Center", "Center")}
		>

			<DivCol pGap={new Pixel(16, 12)}>

				<Emograph
					pTitle={Text.H2.WithColor("#172126").OfText("ابدأ بما هو متاح لديك")}
					pText={Text.Body.WithColor("#3A464A").OfText("أرسل BOQ أو قائمة مشتريات أو صور البنود أو عروض الأسعار الموجودة. المراجعة الأولى تحدد حجم المهمة، البنود التي تحتاج بحثًا، البنود التي تحتاج مقارنة، والجزء الذي يستحق متابعة ميدانية أو تنسيق تسليم.")}
				/>

			</DivCol>

			<Grid pMax={3} pMaxP={1} pGap={new Pixel(12, 10)}>

				<EmoCall BlackOrange />

				<EmoWhats />

				<EmoDet />

			</Grid>

		</DivStr>

	</EmoSec>







</BLayout>
