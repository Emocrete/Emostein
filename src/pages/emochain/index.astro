---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, Grid, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { PriceCard } from "@/Widgets/Prices";
import { DivCol, DivStr, EmoFaq, EmoSec, FaqItem, Hero } from "@/Widgets/Sections";
import { BadgeFrame, BlurBlob, CircleGlow, FloatingPanel, GlassCard, SvgDots, TiltCard } from "@/Widgets/Shapes";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Angle, Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريدات عمومية في القاهرة والجيزة"
	pDescr="خدمة توريدات عمومية للشركات والمواقع والمحلات والأنشطة التجارية في القاهرة والجيزة، تشمل تنظيم طلب الشراء، تحديد المواصفة، مقارنة البدائل، تنسيق النقل، ومتابعة التسليم."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("10%","2.5%"),new NumPer("30%","12%"))}
			pGap={new Pixel(50, 20)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.Bold.OfText("توريدات عمومية")}
				pText={Text.Body.Centered.OfSize(24,18).OfText("للمصالح الحكومية والشركات والمواقع الهندسية والأنشطة التجارية")}
			/>

			<Emograph
				pText={Text.Body.Centered.OfText("إدارة طلبات الشراء والتوريد من البحث عن الصنف وتحديد المواصفة حتى عرض السعر وتنسيق التسليم داخل القاهرة والجيزة.")}
			/>

			<EmoCall
				data-own-size
				BlackOrange
				pText="التفاصيل"
			/>

		</VrStack>

	</Hero>







	<EmoSec id="secOffser">

		<DivStr
			id="strOffser"
			pBg={new ElemBg("#101820")}
			pGap={new Pixel(50, 20)}
			pPad={new Pixel(50, 20)}
			pHzAlign={new Align("Center", "Center")}
			pVrAlign={new Align("Center", "Center")}
		>

			<CircleGlow
				pLoc={new Loc(new NumPer("7%", "-18%"), new NumPer("8%", "2%"))}
				pSize={new Size(new NumPer(420, 260), new NumPer(300, 240))}
				pOpacity={new Percent(34, 38)}
				pColor="rgba(167,196,92,.72)"
				pColor2="rgba(255,255,255,.20)"
			/>

			<BlurBlob
				pLoc={new Loc(new NumPer("calc(100% - 440px)", "50%"), new NumPer("calc(100% - 320px)", "66%"))}
				pSize={new Size(new NumPer(360, 260), new NumPer(260, 220))}
				pRotate={new Angle(-12, -8)}
				pOpacity={new Percent(38, 32)}
				pColor="rgba(50,143,232,.58)"
				pColor2="rgba(167,196,92,.42)"
				pBlur={18}
			/>

			<SvgDots
				pLoc={new Loc(new NumPer("calc(100% - 380px)", "calc(100% - 220px)"), new NumPer(70, 90))}
				pSize={new Size(new NumPer(300, 210), new NumPer(170, 160))}
				pOpacity={new Percent(34, 30)}
				pColor="rgba(255,255,255,.30)"
				pGap={24}
				pDot={2}
			/>

			<DivCol
				id="colOrderToDilever"
				Readable
				pBg={new ElemBg("transparent")}
				pPad={new Pixel(0)}
				pGap={new Pixel(20, 16)}
			>

				<GlassCard
					pBg="rgba(255,255,255,.10)"
					pBorder="rgba(255,255,255,.20)"
					pRadius={20}
					pBlur={14}
				>

					<Emograph
						id="txtOrderToDileverTitle"
						pTitle={Text.H2.White.OfText("من الطلب حتى التسليم")}
						pText={Text.Body.White.OfText("نخدم الشركات والمواقع والمحلات والأنشطة التجارية داخل القاهرة والجيزة في طلبات التوريد العامة: صنف واحد، قائمة مشتريات، طلب عاجل، أو مراجعة عرض مورد. دورنا أن نحول الطلب غير الواضح إلى مواصفة وسعر وشروط تسليم مفهومة قبل اعتماد الشراء.")}
						pSize={new Size(new NumPer("100%"), new NumPer("auto"))}
					/>

					<Grid
						pMax={3}
						pMaxP={1}
						pGap={new Pixel(16, 12)}
						pSize={new Size(new NumPer("100%"), new NumPer("auto"))}
					>

						<BadgeFrame
							pBadge="01"
							pBg="#D7F58C"
							pBadgeBg="#101820"
						>

							<Emograph
								id="txtOrderToDileverStep1"
								pTitle={Text.H4.Centered.WithColor("#101820").OfText("نستقبل الطلب")}
								pText={Text.Body.Centered.WithColor("#101820").OfText("صورة، قائمة، رابط، وصف استخدام، أو عرض سعر سابق.")}
							/>

						</BadgeFrame>

						<BadgeFrame
							pBadge="02"
							pBg="#D7F58C"
							pBadgeBg="#101820"
						>

							<Emograph
								id="txtOrderToDileverStep2"
								pTitle={Text.H4.Centered.WithColor("#101820").OfText("نراجع المواصفة")}
								pText={Text.Body.Centered.WithColor("#101820").OfText("نحدد الكمية، المقاس، الجودة، النقل، الفاتورة، والبدائل.")}
							/>

						</BadgeFrame>

						<BadgeFrame
							pBadge="03"
							pBg="#D7F58C"
							pBadgeBg="#101820"
						>

							<Emograph
								id="txtOrderToDileverStep3"
								pTitle={Text.H4.Centered.WithColor("#101820").OfText("ننسق التوريد")}
								pText={Text.Body.Centered.WithColor("#101820").OfText("عرض واضح ثم اعتماد ثم متابعة شراء وتسليم حسب الاتفاق.")}
							/>

						</BadgeFrame>

					</Grid>

				</GlassCard>

			</DivCol>

			<DivCol
				id="colPricePercent"
				pBg={new ElemBg("transparent")}
				pPad={new Pixel(20,10)}
				pGap={new Pixel(50, 20)}
				Centered
			>

				<PriceCard
					id="crdPrice"
					pCaption={Text.H6.OfSize(17, 12).White.Bold.OfText("نظام العمولة")}
					pStart={Text.H3.OfSize(27, 20).Bold.OfText("عمولة إدارة")}
					pPrice="10%"
					pPriceFnt={Text.H3.OfSize(36, 26).Bold.WithColor("#3797F5")}
					pCurrency={Text.H3.OfSize(20, 16).Bold.OfText("من قيمة التوريد")}
					pSize={new Size(new NumPer(430, 320), new NumPer(125, 110))}
				/>

				<FloatingPanel
					pBg="rgba(215,245,140,.95)"
					pBorder="rgba(215,245,140,1)"
					pAccent="#FFFFFF"
				>

					<Emograph
						id="txtWhatPayingFor"
						pTitle={Text.H2.WithColor("#101820").OfText("ما الذي تدفع مقابله؟")}
						pText={Text.Body.WithColor("#101820").OfText("العمولة مقابل إدارة طلب الشراء: فهم المطلوب، ضبط البيانات الناقصة، البحث عن المورد أو البديل، مقارنة السعر بالمواصفة، وتجهيز شروط واضحة للنقل والتسليم قبل الدفع.")}
					/>

				</FloatingPanel>

				<TiltCard
					pBg="#FFFFFF"
					pColor="#101820"
					pTilt={-2}
				>

					<Emograph
						id="txtPriceHint"
						pTitle={Text.H3.Centered.WithColor("#101820").OfText("لا نعد بأرخص سعر مطلق")}
						pText={Text.Body.Centered.WithColor("#101820").OfText("نعد بعرض أوضح: صنف، كمية، سعر، نقل، مدة، وفاتورة أو مستندات عند الحاجة.")}
					/>

				</TiltCard>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec id="secOrder">

		<DivStr
			id="strOrder"
			pBg={new ElemBg("#F3E8D2")}
			pContentSize={new Size(new NumPer("80%","95%"), new NumPer("auto"))}
			pGap={new Pixel(26, 18)}
			pPad={new Pixel(50, 5)}
			pHzAlign={new Align("Center", "Center")}
			pVrAlign={new Align("Center", "Center")}
		>

			<BlurBlob
				pLoc={new Loc(new NumPer("4%", "-20%"), new NumPer("calc(100% - 260px)", "calc(100% - 220px)"))}
				pSize={new Size(new NumPer(340, 240), new NumPer(240, 200))}
				pOpacity={new Percent(24, 26)}
				pColor="rgba(16,24,32,.35)"
				pColor2="rgba(50,143,232,.30)"
				pBlur={18}
			/>

			<DivCol
				Readable
				pBg={new ElemBg("#101820")}
				pPad={new Pixel(44, 24)}
				pGap={new Pixel(22, 16)}
				Centered
			>

				<Emograph
					pTitle={Text.H2.White.OfText("اطلب التوريد برسالة واحدة")}
					pText={Text.Body.White.OfText("أرسل صورة الصنف أو قائمة المشتريات أو عرض المورد الذي تريد مراجعته. سنطلب البيانات الناقصة فقط، ثم نوضح إمكانية التنفيذ والسعر والمدة والنقل والعمولة قبل اعتماد الطلب.")}
					pSize={new Size(new NumPer("100%"), new NumPer("auto"))}
				/>

				<Grid
					pMax={2}
					pMaxP={1}
					pGap={new Pixel(14, 12)}
					pSize={new Size(new NumPer("100%"), new NumPer("auto"))}
				>

					<BadgeFrame
						pBadge="أرسل"
						pBg="#FFFFFF"
						pBadgeBg="#D7F58C"
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("بيانات الطلب")}
							pText={Text.Body.Centered.OfText("الصورة أو القائمة، الكمية، مكان التسليم، الموعد، وهل المطلوب فاتورة أو نقل.")}
						/>

					</BadgeFrame>

					<BadgeFrame
						pBadge="اعتمد"
						pBg="#FFFFFF"
						pBadgeBg="#D7F58C"
					>

						<Emograph
							pTitle={Text.H4.Centered.WithColor("#101820").OfText("عرض واضح")}
							pText={Text.Body.Centered.WithColor("#101820").OfText("لا يبدأ التنفيذ إلا بعد وضوح الصنف والسعر والعمولة وشروط التسليم.")}
						/>

					</BadgeFrame>

				</Grid>

			</DivCol>

			<DivCol
				pBg={new ElemBg("transparent")}
				pPad={new Pixel(0)}
				pGap={new Pixel(20, 16)}
			>

				<GlassCard
					pBg="rgba(255,255,255,.88)"
					pBorder="rgba(255,255,255,1)"
					pRadius={34}
					pBlur={10}
				>

					<Emograph
						pText={Text.Body.WithColor("#101820").OfText("نقوم بتنفيذ وإدارة طلبات التوريد العمومية لصالح الشركات والمواقع والمحلات داخل القاهرة والجيزة، بداية من فهم المطلوب وضبط المواصفة وحتى عرض السعر وتنسيق التسليم، مقابل عمولة إدارة 10% من قيمة التوريد بعد اعتماد العرض.")}
						pSize={new Size(new NumPer("100%"), new NumPer("auto"))}
					/>

					<FloatingPanel
						pBg="rgba(16,24,32,.95)"
						pBorder="rgba(16,24,32,1)"
						pAccent="#D7F58C"
					>

						<Emograph
							pTitle={Text.H3.WithColor("#D7F58C").OfText("للطلب والتفاصيل")}
							pText={Text.Body.White.OfText("اتصل بنا أو أرسل طلبك على واتساب: صورة الصنف، الكمية، مكان التسليم، والموعد المطلوب. سنراجع الطلب ونرد بإمكانية التنفيذ والتكلفة قبل أي اعتماد.")}
						/>

						<EmoCall
							BlackSky
							pText="اتصل لطلب توريد"
							pWidth="260px"
							pHeight="54px"
							pRadius="12px"
						/>

					</FloatingPanel>

				</GlassCard>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="خدمة التوريدات العمومية تبدأ من تنظيم الطلب قبل البحث عن السعر"
			pDesc="هذه الصفحة موجهة للعميل الذي يحتاج إلى جهة تساعده في تحويل احتياج شراء غير مكتمل أو قائمة مشتريات متفرقة إلى طلب توريد واضح المواصفة والسعر وطريقة التسليم."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(620, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("ما الذي يشتريه العميل فعليًا؟")}
				pText={Text.Body.OfText(`عندما تحتاج شركة أو موقع تنفيذ أو محل تجاري أو مكتب إداري إلى شراء أصناف متفرقة، فإن المشكلة لا تكون دائمًا في وجود الصنف داخل السوق. المشكلة الأكبر غالبًا تكون في تحديد الصنف الصحيح، والوصول إلى مورد مناسب، ومقارنة السعر بالمواصفة، وترتيب النقل، والتأكد من أن ما يصل إلى العميل هو ما تم طلبه بالفعل. من هنا تأتي خدمة التوريدات العمومية باعتبارها خدمة عملية لإدارة طلبات الشراء والتوريد، وليست مجرد وسيط يبيع منتجًا ثم ينتهي دوره.

نقدم خدمة توريدات عمومية في مصر، مع تركيز مبدئي على نطاق القاهرة والجيزة، لخدمة الشركات الصغيرة والمتوسطة، والمكاتب، والمحلات، والمواقع، والمشروعات، وإدارات التشغيل التي تحتاج إلى توفير أصناف أو قوائم مشتريات دون إهدار الوقت في البحث العشوائي بين الموردين. يمكن أن يبدأ الطلب بصورة لصنف، أو قائمة مكتوبة، أو وصف استخدام، أو عرض سعر حصل عليه العميل من مورد آخر، ثم يتم تحويل هذا الطلب إلى مواصفة أوضح تساعد على التسعير والمقارنة واتخاذ قرار شراء أكثر أمانًا.

القيمة الأساسية في خدمة التوريدات العمومية ليست في تكرار عبارة نوفر كل شيء، لأن هذه العبارة لا تعني شيئًا عمليًا للعميل. القيمة الحقيقية في وجود جهة تساعده على ترتيب طلبه، وتوضيح ما ينقصه من بيانات، والتمييز بين السعر الظاهري والسعر القابل للتنفيذ، ثم تنسيق خطوات الشراء والتسليم بطريقة تقلل المفاجآت. لذلك فإن هذه الصفحة موجهة للعميل الذي يريد عملية توريد أكثر وضوحًا، لا مجرد رقم سريع لا يعرف ما الذي يشمله.`)}
			/>

			<CardsGr
				pWidth={new RespString("620px", "320px")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4.Centered}
				pCardBodyFnt={Text.Body.Centered}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("ليس كتالوج منتجات", `الصفحة لا تعرض قائمة أصناف بلا حدود، بل تشرح خدمة إدارة طلب الشراء عندما يكون الصنف أو القائمة أو المورد غير واضحين للعميل.`)}
				pTopic2={new Topic("قرار شراء أوضح", `المطلوب أن يعرف العميل ماذا سيشتري، وما الذي يشمله السعر، وما البيانات الناقصة قبل الاعتماد، وما شروط النقل والتسليم والفاتورة.`)}
				pTopic3={new Topic("نطاق مبدئي واضح", `الخدمة تعمل مبدئيًا داخل القاهرة والجيزة، مع دراسة الطلبات الأخرى حسب نوع الصنف والكمية وجدوى النقل وطبيعة المورد.`)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec hidden>

		<EmoStr
			hidden
			pBg={new ElemBg("#111820")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

				<Emograph
					pSize={new Size(new NumPer(600, 320), new NumPer("auto", "auto"))}
					pTitle={Text.H3.WithColor(Colors.GreenLite).OfText("المشكلة لا تبدأ عند التسليم")}
					pText={Text.Body.White.OfText(`تبدو طلبات التوريد في ظاهرها بسيطة: صنف مطلوب، كمية محددة، وسعر يتم الاتفاق عليه. لكن الواقع العملي مختلف. كثير من الخلافات في الشراء لا تنتج عن سوء نية بقدر ما تنتج عن طلب غير محدد، أو مواصفة ناقصة، أو افتراضات لم تُكتب بوضوح. قد يطلب العميل مستلزمات مكتب، فيفهم المورد نوعًا معينًا من الجودة بينما يتوقع العميل درجة أخرى. وقد يطلب خامة تشطيب دون تحديد المقاس أو اللون أو طريقة الاستخدام، فتصل خامة صالحة في ذاتها لكنها غير مناسبة للمكان. وقد يحصل العميل على سعر جيد ظاهريًا، ثم يكتشف أن النقل أو الضريبة أو التحميل أو التركيب غير مشمول.

في القاهرة والجيزة تحديدًا، تتضاعف أهمية تنظيم الطلب بسبب كثافة السوق وكثرة الموردين وتفاوت الأسعار بين منطقة وأخرى. وجود اختيارات كثيرة لا يعني أن القرار صار أسهل. كثرة الاختيارات قد تجعل العميل أكثر عرضة للمقارنة الخاطئة، خصوصًا عندما يقارن بين أسعار لأصناف تحمل الاسم نفسه لكنها تختلف في الجودة أو الكمية أو بلد المنشأ أو وحدة القياس أو شروط التسليم. لذلك فإن أول خطوة في التوريدات العمومية ليست الاتصال بالمورد، بل فهم ما الذي يجب توريده بالضبط.`)}
				/>

				<EmoList
					pWidth={new RespString("600px", "320px")}
					pTitle={Text.H3.WithColor(Colors.GreenLite).OfText("أوجه التكلفة الخفية")}
					pDesc={Text.Body.White.OfText("تتحول المشتريات العشوائية إلى عبء عندما يتم التعامل مع كل صنف كحالة منفصلة بلا مواصفة موحدة أو جهة متابعة أو مستندات واضحة.")}
					pHeadBg={new ElemBg("transparent")}
					pItemsBg={new ElemBg("transparent")}
					pItemFnt={Text.Body.White}
					pNumbered={false}
					pItems={[
					`ساعات عمل مهدرة في البحث والاتصال بالموردين بدل توجيه الفريق إلى مهامه الأساسية.`,
					`مقارنات أسعار غير عادلة لأن كل مورد يسعر مواصفة مختلفة أو يستبعد بندًا من العرض.`,
					`تعدد فواتير وسياسات دفع واستبدال ومواعيد تسليم، مما يرهق الإدارة المالية ويصعب تتبع المصروفات.`,
					`احتمال استلام أصناف غير مطابقة أو أقل جودة أو غير مناسبة للاستخدام الفعلي داخل الموقع أو النشاط.`,
					`تكلفة نقل أو تحميل أو تنزيل تظهر بعد الاتفاق لأنها لم تكن جزءًا واضحًا من العرض الأول.`,
					`تعطيل موقع أو افتتاح أو عملية تشغيل بسبب نقص صنف بسيط كان يمكن تحديده مبكرًا.`
				]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="ما الذي تعنيه خدمة التوريدات العمومية؟"
			pDesc="الخدمة لا تبيع صنفًا مخزنًا فقط، ولا تدعي توفير أي شيء بلا شروط. هي إدارة عملية شراء تبدأ من فهم الاحتياج وتنتهي بتوريد أوضح وأقل عرضة للمفاجآت."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(620, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("إدارة طلب شراء لا بيع صنف فقط")}
				pText={Text.Body.OfText(`التوريدات العمومية هي خدمة توفير أصناف ومنتجات ومستلزمات يحتاجها العميل لأغراض التشغيل أو التجهيز أو التنفيذ أو الصيانة أو الإدارة، مع إدارة جزء من عملية البحث والمقارنة والتنسيق بدل أن يتحملها العميل بالكامل. كلمة عمومية هنا لا تعني أن الخدمة بلا حدود أو أنها تتعهد بتوفير أي سلعة تحت أي شرط، لكنها تعني أن نطاق الطلبات واسع ولا يقتصر على فئة واحدة من المنتجات.

قد تشمل الخدمة توريد مستلزمات مكتبية، أدوات تشغيل، خامات تشطيب، أدوات صيانة، مستهلكات موقع، تجهيزات محل، أصناف كهرباء أو سباكة، مستلزمات مخزن، أو منتجات متفرقة تحتاجها شركة أو نشاط تجاري. لكن القيمة الحقيقية ليست في ذكر كل هذه الأصناف، بل في طريقة التعامل مع الطلب. فكل صنف يحتاج إلى أسئلة مختلفة قبل التسعير. صنف يقاس بالقطعة، وآخر بالمتر، وثالث بالكرتونة، ورابع يحتاج إلى موديل، وخامس لا يمكن تأكيده دون صورة أو عينة.

في نموذج العمل المهني، لا يتم تمرير الطلب مباشرة إلى التسعير قبل مراجعته. يتم استقبال الاحتياج كما أرسله العميل، ثم تحليل ما ينقصه من بيانات، ثم تحديد هل المطلوب صنف معروف أم بديل، وهل الطلب يصلح للتوريد من مورد واحد أم يحتاج أكثر من مصدر، وهل يحتاج نقلًا أو فاتورة أو تركيبًا أو تسليمًا في موعد محدد. هذه المرحلة هي التي تحمي العميل من رقم سعر سريع يبدو جيدًا ثم يتغير عند التنفيذ.`)}
			/>

			<VrStack
				pWidth={new Pixel(620, 320)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(0, 0)}
			>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.OfText("تشمل الخدمة")}
					pDesc={Text.Body.OfText("هذه البنود تمثل صلب الخدمة عند التعامل مع طلب توريد واضح أو قابل للتوضيح.")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.Creamy)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						`استقبال طلب صنف واحد أو قائمة أصناف أو صورة أو رابط أو عرض سعر سابق.`,
						`تحديد البيانات الناقصة مثل الكمية والمقاس والوحدة ومكان التسليم وموعد التوريد.`,
						`البحث عن المورد المناسب أو البديل المقبول عندما لا يكون الصنف واضحًا أو متاحًا.`,
						`تجهيز عرض سعر يوضح المواصفة والكمية والنقل والمدة والمستندات قدر الإمكان.`,
						`تنسيق التسليم داخل القاهرة والجيزة حسب طبيعة الطلب وحجم الأصناف وشروط المورد.`
					]}
				/>

				<EmoList
					pWidth={new RespString("620px", "320px")}
					pTitle={Text.H3.OfText("لا تعني الخدمة")}
					pDesc={Text.Body.OfText("وضوح الحدود جزء من الثقة التجارية، لأنه يمنع الوعود المفتوحة التي لا يمكن تنفيذها بصورة مهنية.")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.Creamy)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						`وعدًا مطلقًا بتوفير أي سلعة في أي وقت وبأي كمية.`,
						`ضمان أقل سعر في السوق دون مقارنة مواصفات وشروط تسليم متكافئة.`,
						`اعتماد سعر نهائي لطلب ناقص البيانات أو غير واضح المواصفة.`,
						`تحمل عيوب تصنيع أو استخدام لم يتم الاتفاق على فحصها أو توثيقها قبل الشراء.`,
						`توريد أصناف مخالفة للقانون أو غير قابلة للتداول التجاري السليم.`
					]}
				/>

			</VrStack>

		</HzStack>

	</EmoSec>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.Gray1)}
