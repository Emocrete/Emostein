				pTopic2={new Topic("لديك قائمة مشتريات", `أرسل القائمة ليتم ترتيبها ومراجعة البيانات المطلوبة للتسعير بدل التعامل معها كأسماء متناثرة.`)}
				pTopic3={new Topic("لديك عرض مورد", `أرسل العرض لمراجعته من حيث المواصفة والكمية والنقل والفاتورة ومدة التوريد وشروط الاستبدال.`)}
				pTopic4={new Topic("طلبك عاجل", `اكتب الصنف والكمية والمنطقة وآخر موعد مقبول، وحدد هل تقبل بديلًا أم لا.`)}
