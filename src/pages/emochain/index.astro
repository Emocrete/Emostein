				pTopic2={new Topic("التوريدات العمومية", `تتعامل مع طلبات غير مكتملة أو متعددة أو متكررة، وتساعد في تنظيم المعلومات ومقارنة الموردين وتنسيق شروط الشراء والتسليم.`)}
				pTopic3={new Topic("قيمة الإدارة", `القيمة ليست في إضافة وسيط جديد، بل في تقليل وقت البحث، وتقليل احتمال الخطأ، وتوحيد التواصل، وتحويل الطلب إلى بيانات قابلة للمراجعة.`)}
			/>

		</HzStack>

	</EmoSec>







