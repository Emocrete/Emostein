---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, ScrollShelf, ShelfItem, SideRail } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="الخدمات اللوجستية للمشروعات"
	pDescr="الخدمات اللوجستية للمشروعات — خدمة مساندة لدورة المشتريات والتوريد تربط المستندات والموردين واللوجستيات والمتابعة باحتياجات المشروع الفعلية. ويُبنى نطاق الخدمات اللوجستية للمشروعات على حالة المشروع الفعلية لا على وصف عام للخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="الخدمات اللوجستية للمشروعات">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("الخدمات اللوجستية للمشروعات")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("خدمة مساندة لدورة المشتريات والتوريد تربط المستندات والموردين واللوجستيات والمتابعة باحتياجات المشروع الفعلية. ويُبنى نطاق الخدمات اللوجستية للمشروعات على حالة المشروع الفعلية لا على وصف عام للخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<SideRail pRailWidth={new RespString("290px","100%")} pGap={new RespString("24px","12px")} pPad={new RespString("42px","12px")} pBg={Colors.Gray1} pRailBg={Colors.BrownDark} pRailColor={Colors.WhiteOff}>
		<Emograph slot="rail" pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("الخدمات اللوجستية للمشروعات")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("تقلل الوقت الضائع بين جهات متعددة وتوفر سجلًا أوضح للعرض المعتمد والمستندات وحالة التوريد. ويظل القرار النهائي مرتبطًا ببيانات الخدمات اللوجستية للمشروعات نفسها قبل إصدار العرض.")} />
		<ScrollShelf pItemWidth={new RespString("330px","82vw")} pGap={new RespString("14px","10px")} pPad={new RespString("10px","8px")} pBg={Colors.Gray1}>
			<ShelfItem pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("مدخلات")} pText={Text.Body.WithColor(Colors.Black).OfText("تحديد المطلوب ومسؤوليات الأطراف")} /></ShelfItem>
			<ShelfItem pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("تنسيق")} pText={Text.Body.WithColor(Colors.Black).OfText("تنسيق المستندات والموردين والخطوات")} /></ShelfItem>
			<ShelfItem pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("تسليم")} pText={Text.Body.WithColor(Colors.Black).OfText("متابعة المخرجات حتى نقطة التسليم المتفق عليها")} /></ShelfItem>
		</ScrollShelf>
	</SideRail>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 5,000 ج.م للمهمة المحددة، ويزيد حسب عدد الموردين والبنود والزيارات.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
