---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, ScrollShelf, ShelfItem, SideRail } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="توريد حديد التسليح"
	pDescr="توريد حديد التسليح — توريد هندسي يعتمد على تعريف المواصفة والكمية والمصدر المناسب ثم مقارنة العروض ومتابعة التجهيز والتسليم للمشروع. وفي هذه الصفحة يكون التركيز الخاص على الأقطار والأطوال والوصلات والهالك والجداول وقابلية التنفيذ. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="توريد حديد التسليح">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("توريد حديد التسليح")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("توريد هندسي يعتمد على تعريف المواصفة والكمية والمصدر المناسب ثم مقارنة العروض ومتابعة التجهيز والتسليم للمشروع. وفي هذه الصفحة يكون التركيز الخاص على الأقطار والأطوال والوصلات والهالك والجداول وقابلية التنفيذ.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<SideRail pRailWidth={new RespString("290px","100%")} pGap={new RespString("24px","12px")} pPad={new RespString("42px","12px")} pBg={Colors.Gray1} pRailBg={Colors.BrownDark} pRailColor={Colors.WhiteOff}>
		<Emograph slot="rail" pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("توريد حديد التسليح")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("يقلل اختيار المنتج بالسعر وحده ويجمع المواصفة والبدائل ومدة التوريد وشروط الدفع والنقل في قرار شراء واحد. ويُراجع القرار هنا تحديدًا في ضوء الأقطار والأطوال والوصلات والهالك والجداول وقابلية التنفيذ.")} />
		<ScrollShelf pItemWidth={new RespString("330px","82vw")} pGap={new RespString("14px","10px")} pPad={new RespString("10px","8px")} pBg={Colors.Gray1}>
			<ShelfItem pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("مدخلات")} pText={Text.Body.WithColor(Colors.Black).OfText("تثبيت المواصفات والكميات المطلوبة مع مراعاة الأقطار والأطوال والوصلات والهالك والجداول وقابلية التنفيذ")} /></ShelfItem>
			<ShelfItem pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("تنسيق")} pText={Text.Body.WithColor(Colors.Black).OfText("جمع ومقارنة عروض الموردين")} /></ShelfItem>
			<ShelfItem pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("تسليم")} pText={Text.Body.WithColor(Colors.Black).OfText("متابعة التجهيز والنقل والتسليم حسب النطاق")} /></ShelfItem>
		</ScrollShelf>
	</SideRail>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("أتعاب إدارة التوريد تبدأ من 5,000 ج.م؛ قيمة المواد والمعدات حسب عروض الموردين وقت الطلب.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
