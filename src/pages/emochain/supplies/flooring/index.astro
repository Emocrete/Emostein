---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { SplitPane, SplitScene, StoryRail, StoryStep } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="توريد الأرضيات ومواد التشطيب"
	pDescr="توريد الأرضيات ومواد التشطيب — توريد هندسي يعتمد على تعريف المواصفة والكمية والمصدر المناسب ثم مقارنة العروض ومتابعة التجهيز والتسليم للمشروع. ويُبنى نطاق توريد الأرضيات ومواد التشطيب على حالة المشروع الفعلية لا على وصف عام للخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="توريد الأرضيات ومواد التشطيب">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("توريد الأرضيات ومواد التشطيب")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("توريد هندسي يعتمد على تعريف المواصفة والكمية والمصدر المناسب ثم مقارنة العروض ومتابعة التجهيز والتسليم للمشروع. ويُبنى نطاق توريد الأرضيات ومواد التشطيب على حالة المشروع الفعلية لا على وصف عام للخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<StoryRail pBg={Colors.Black} pTrackColor={Colors.Gray4} pAccent={Colors.Bistage} pGap={new RespString("24px","14px")} pPad={new RespString("44px","12px")}>
		<StoryStep pNumber="01" pKicker="البداية" pTitle="تعريف المطلوب" pText="تثبيت المواصفات والكميات المطلوبة." pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<StoryStep pNumber="02" pKicker="المعالجة" pTitle="Sourcing & Compare" pText="جمع ومقارنة عروض الموردين." pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<StoryStep pNumber="03" pKicker="المخرج" pTitle="Supply & Follow-up" pText="متابعة التجهيز والنقل والتسليم حسب النطاق." pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
	</StoryRail>

	<SplitScene id="secSrvCost" pBg={Colors.Gray1} pColumns={new RespString("5fr 7fr","1fr")} pGap={new RespString("12px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("القيمة العملية")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("يقلل اختيار المنتج بالسعر وحده ويجمع المواصفة والبدائل ومدة التوريد وشروط الدفع والنقل في قرار شراء واحد. ويظل القرار النهائي مرتبطًا ببيانات توريد الأرضيات ومواد التشطيب نفسها قبل إصدار العرض.")} />
		</SplitPane>
		<SplitPane pBg={Colors.WhiteOff} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("السعر المبدئي")} pText={Text.Body.WithColor(Colors.Black).OfText("أتعاب إدارة التوريد تبدأ من 5,000 ج.م؛ قيمة المواد والمعدات حسب عروض الموردين وقت الطلب.")} />
		</SplitPane>
	</SplitScene>

</BLayout>
