---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoBtn, EmoCall, Emograph, EmoList, HzStack, SecTitle } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, IndexSec, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شوب دروينج إنشائي"
	pDescr="خدمة إعداد شوب دروينج إنشائي للعناصر الخرسانية والمعدنية، تشمل تفاصيل التسليح، القطاعات التنفيذية، الجداول، Bar Bending Schedule، الفتحات، السليفات، تفاصيل القواعد والأعمدة والكمرات والبلاطات والسلالم، مع تنسيق الرسومات مع المعماري والميكانيكا والكهرباء قبل التنفيذ."
	pSchemaImages={[
		"/Media/Emodsign/Tech/Shopdwg/Struc/HeroL.webp",
		"/Media/Emodsign/Tech/Shopdwg/HeroL.webp",
		"https://images.unsplash.com/photo-1768677903496-becc4be07258?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1560596205-8fb48c7ef200?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&fm=jpg&q=70&w=1600"
	]}
>







	<Hero
		pImgF="/Media/Emodsign/Tech/Shopdwg/Struc/"
		pTitle="شوب دروينج إنشائي"
		pDesc="رسومات تنفيذية إنشائية تترجم التصميم إلى تفاصيل قابلة للحدادة والنجارة والصب: تسليح، قطاعات، Bar Marks، جداول حديد، سليفات، فتحات، منسوب، وتنسيق قبل دخول الموقع في مرحلة الأخطاء المكلفة."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="18% 50% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب شوب دروينج إنشائي" />

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Img", "/Media/Emodsign/Tech/Shopdwg/Struc/", "HeroL.webp")}
		pTitleClr="#FFFFFF"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="فجوة التنفيذ"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#execution-gap'"
		/>

		<EmoBtn
			pText="نطاق اللوحات"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#drawing-scope'"
		/>

		<EmoBtn
			pText="تفريد الحديد"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#rebar-detailing'"
		/>

		<EmoBtn
			pText="تنسيق الفتحات"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#coordination'"
		/>

		<EmoBtn
			pText="المخرجات"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#deliverables'"
		/>

		<EmoBtn
			pText="الأسئلة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#faq'"
		/>

	</IndexSec>







	<EmoSec
		id="execution-gap"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="الشوب دروينج الإنشائي يسد الفجوة بين التصميم والموقع"
			pDesc="التصميم الإنشائي يحدد النظام والحسابات والعناصر، لكن الموقع يحتاج رسومات تفصيلية تقرأها فرق الحدادة والنجارة والمراجعة والمقاول قبل الصب. هنا تظهر قيمة الشوب دروينج: تحويل اللوحات التصميمية إلى تعليمات تنفيذ ومراجعة وتوريد واضحة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("من لوحة تصميم إلى قرار تنفيذ")}
				pText={Text.Body.WithColor("#333333").OfText("لوحة التصميم قد تذكر قطر التسليح والمسافات العامة، لكنها لا تكفي دائمًا لتحديد أطوال الأسياخ، أماكن الوصلات، ترتيب الحديد السفلي والعلوي، مناطق التكثيف، تفاصيل الفتحات، أو علاقة التسليح بالسليفات والميكانيكا والكهرباء. الشوب دروينج الإنشائي يجعل هذه القرارات مرئية قبل أن تصبح مشكلة داخل الشدة.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1768677903496-becc4be07258?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"مهندس يراجع شبكة تسليح داخل موقع إنشائي",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="drawing-scope"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="نطاق شوب دروينج الإنشاءات"
			pDesc="نطاق الخدمة لا يقتصر على إعادة رسم اللوحات. الهدف هو تجهيز ملف تنفيذي يوضح العنصر الإنشائي كما سيظهر في الموقع، مع جداول وملاحظات وقطاعات تحقق قابلية التنفيذ."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نطاق شوب دروينج الإنشاءات")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("القواعد والأساسات", "تفاصيل القواعد المنفصلة والمشتركة واللبشة والسملات والميدات والشدادات، مع أبعاد ومنسوب وتفاصيل تسليح وتداخلات وملاحظات صب ومعالجة.")}
			pTopic2={new Topic("الأعمدة والحوائط", "تفاصيل تسليح الأعمدة والحوائط الخرسانية وحوائط القص، أماكن الوصلات، الكانات، التكثيف، الأشاير، ومناطق التداخل مع الكمرات والبلاطات.")}
			pTopic3={new Topic("الكمرات والبلاطات", "توضيح الحديد السفلي والعلوي والإضافي، الأطوال، التكسيح إن وجد، التسليح الحراري، السلالم، الفتحات، والتسليح حول الهبوط أو الدروب.")}
			pTopic4={new Topic("السلالم والعناصر الخاصة", "تفاصيل السلالم والرامبات والبلكونات والكابولي والفتحات الكبيرة والعناصر ذات السلوك الخاص التي تحتاج قطاعات واضحة قبل التنفيذ.")}
			pTopic5={new Topic("الجداول والكودات", "إعداد Bar Marks وجداول حديد أو جداول قص وثني حسب الاتفاق، مع ملاحظات تساعد على التوريد والمراجعة.")}
			pTopic6={new Topic("الفتحات والسليفات", "إظهار الفتحات اللازمة للميكانيكا والكهرباء والمصاعد والسلالم والخدمات قبل صب العنصر، حتى لا تتحول إلى تكسير أو كور بعد التنفيذ.")}
		/>

	</EmoSec>







	<EmoStr
		id="why-not-design-only"
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("لماذا لا يكفي التصميم الإنشائي وحده أحيانًا؟")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("في المشروعات الصغيرة قد يحاول المقاول التنفيذ مباشرة من لوحات التصميم. هذا قد ينجح في عناصر بسيطة، لكنه يصبح خطرًا عند وجود تفاصيل كثيرة أو تعديلات معمارية أو خدمات ميكانيكية أو كثافة حديد عالية. الشوب دروينج يقلل القرارات الشفهية ويجعل المراجعة موثقة.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("لماذا لا يكفي التصميم الإنشائي وحده أحيانًا؟")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("التصميم يحدد النية", "لوحات التصميم توضح النظام والقيم الرئيسية والقطاعات والتسليح المطلوب كحل هندسي، لكنها ليست دائمًا مرتبة بطريقة تناسب تسلسل التنفيذ اليومي.")}
			pTopic2={new Topic("الشوب يحدد طريقة القراءة", "الشوب دروينج يترجم كل عنصر إلى لوحة تنفيذية وجداول وملاحظات، بحيث يعرف الحداد والنجار ومهندس الموقع ما يجب مراجعته قبل الصب.")}
			pTopic3={new Topic("الموقع يحتاج تسلسل", "القواعد ثم الأعمدة ثم السقف ثم السلم ليست مجرد لوحات؛ كل مرحلة لها تحضيرات وسليفات وأشاير ومراجعات يجب أن تظهر مبكرًا.")}
			pTopic4={new Topic("التعديل يحتاج تتبع", "عند حدوث تغيير معماري أو تعديل فتحة أو مسار خدمة، يجب أن يظهر أثره على العنصر الإنشائي داخل إصدار واضح بدل الاعتماد على صور ورسائل.")}
			pTopic5={new Topic("الحديد يحتاج إدارة", "الكمية وحدها لا تكفي. يحتاج الموقع أطوالًا وأشكالًا وتسميات وأماكن استخدام تسمح بالقص والثني والتركيب والمراجعة.")}
			pTopic6={new Topic("المراجعة تحتاج مرجع", "أي ملاحظة من الاستشاري أو المالك أو المقاول يجب أن تعود إلى لوحة وإصدار وليس إلى تفسير شفهي متغير.")}
		/>

	</EmoStr>







	<EmoSec
		id="rebar-detailing"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="تفريد الحديد هو قلب الشوب دروينج الإنشائي"
			pDesc="أكثر أخطاء التنفيذ تكلفة تظهر في تفاصيل الحديد: وصلات في أماكن غير مناسبة، أطوال غير واضحة، كانات ناقصة، تداخلات كثيفة، أو صعوبة تركيب حول فتحة أو شفت. لذلك يتم التعامل مع التسليح كملف تصنيع وتركيب وليس كرموز عامة على اللوحة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("ما الذي يظهر في تفريد الحديد؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("المطلوب أن يعرف كل طرف ماذا يقطع وماذا يركب وأين يراجع.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={false}
				pItems={[
				"قطر السيخ وعدده والمسافة بين الأسياخ ومكانه داخل العنصر.",
				"شكل السيخ وأطوال الأجزاء المستقيمة والثنيات والهوكات عند الحاجة.",
				"Bar Mark أو رقم تعريفي لكل مجموعة حديد متكررة.",
				"مكان الوصلات والتراكب ومناطق منع الوصل إن كانت محددة في التصميم أو الملاحظات.",
				"تسليح الفتحات والحواف ومناطق العزم السالب والتكثيف حول الأعمدة والكمرات.",
				"علاقة الحديد بالسليفات والفتحات والمواسير قبل تركيبها داخل الشدة."
]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1560596205-8fb48c7ef200?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"تفاصيل تسليح خرسانة قبل الصب",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="bbs"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="Bar Bending Schedule وقيمة جداول الحديد"
			pDesc="جدول القص والثني لا يكون مجرد مرفق شكلي. عند استخدامه بشكل صحيح يساعد في التوريد، تقليل الهالك، مراجعة الكميات، وتنظيم تركيب الحديد في الموقع."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("Bar Bending Schedule وقيمة جداول الحديد")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("رقم السيخ", "كل مجموعة حديد تحصل على رقم واضح يرتبط باللوحة والعنصر والمكان حتى لا يختلط حديد القواعد بالكمرات أو السلالم.")}
			pTopic2={new Topic("الشكل والأطوال", "الجداول توضح الشكل والطول الكلي وأبعاد الثني، مما يساعد على القص والثني قبل الوصول إلى منطقة التركيب.")}
			pTopic3={new Topic("الكمية والوزن", "عند الاتفاق، يمكن تحويل الجداول إلى تقدير كميات أو دعم حصر حديد التنفيذ، مع ملاحظة أن الحصر التفصيلي خدمة مستقلة عند الحاجة.")}
			pTopic4={new Topic("المرحلة والموقع", "الجدول المنظم يربط الحديد بالمرحلة: أساسات، أعمدة، سقف، سلم، حوائط، حتى يسهل توريده على دفعات.")}
			pTopic5={new Topic("مراجعة التكرار", "العناصر المتكررة مثل كمرات أو أعمدة نموذجية يمكن تنظيمها لتقليل التكرار غير الضروري ومراجعة الاختلافات المهمة فقط.")}
			pTopic6={new Topic("تقليل التفسير الفردي", "كلما كان الجدول واضحًا قل اعتماد الحداد على خبرته وحدها أو على اجتهادات مختلفة بين طاقم وآخر.")}
		/>

	</EmoSec>







	<EmoSec
		id="foundation-details"
		pBg={new ElemBg("#111318")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="شوب دروينج القواعد والأساسات"
			pDesc="مرحلة الأساسات لا تحتمل الغموض؛ لأن أي خطأ فيها يصعب إصلاحه بعد الردم أو بدء الأعمدة. لذلك يتم توضيح الأبعاد والمناسيب والأشاير والتسليح والفتحات قبل التنفيذ."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("شوب دروينج القواعد والأساسات")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("القواعد المنفصلة", "توضيح شبكة الحديد السفلي والعلوي إن وجدت، اتجاه الفرش والغطاء، الأشاير، الكراسي، علاقة القاعدة بالعمود، والمنسوب النهائي.")}
			pTopic2={new Topic("القواعد المشتركة والشدادات", "تحديد تفاصيل التداخل بين قاعدة وشداد أو قاعدة مشتركة، مع مراجعة أماكن الأعمدة والحدود الجانبية للجار أو الشارع.")}
			pTopic3={new Topic("اللبشة", "تقسيم اللبشة إلى مناطق تسليح، تفاصيل التكثيف أسفل الأعمدة والحوائط، الفتحات، البلوك أو الدروب، ومناسيب الصب.")}
			pTopic4={new Topic("السملات والميدات", "توضيح تسليح السملات أو الميدات، أماكن الوصلات، الكانات، فرق المناسيب، وعلاقتها بالمباني أو الردم.")}
			pTopic5={new Topic("أشاير الأعمدة والحوائط", "إظهار الأشاير بدقة قبل الصب، لأن تعديلها بعد الخرسانة يفتح باب تخريم أو تزريع أو حلول غير مرغوبة.")}
			pTopic6={new Topic("تنسيق الخدمات", "إظهار سليفات الصرف أو الكهرباء أو التأريض أو فتحات غرف التفتيش عندما تؤثر على الأساسات أو الميدات.")}
		/>

	</EmoSec>







	<EmoSec
		id="columns-walls"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
