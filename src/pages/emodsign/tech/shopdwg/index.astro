---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoSec, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="رسومات تنفيذية للمشروعات الهندسية"
	pDescr="خدمات شوب دروينج متكاملة للمشروعات الهندسية، تشمل الشوب دروينج المعماري والإنشائي والكهرباء والميكانيكا، مع تحويل التصميم إلى رسومات تنفيذية منسقة قابلة للمراجعة والتوريد والتنفيذ داخل الموقع."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("50%","95%"))} pLoc={new Loc(new NumPer("2%","2.5%"),new NumPer("35%","10%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("رسومات تنفيذية للمشروعات الهندسية")}
				pText={Text.Body.Centered.OfText("خدمات شوب دروينج متكاملة للمشروعات الهندسية، تشمل الشوب دروينج المعماري والإنشائي والكهرباء والميكانيكا، مع تحويل التصميم إلى رسومات تنفيذية منسقة قابلة للمراجعة والتوريد والتنفيذ داخل الموقع.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			pTitle="لماذا لا تكفي رسومات التصميم وحدها؟"
			pDesc="التصميم يحدد ما يجب تنفيذه، لكن الشوب دروينج يحدد كيف سيتم تنفيذه فعليًا في الموقع أو الورشة أو مرحلة التوريد. لذلك هو حلقة وسيطة بين المصمم والمقاول والفني والمورد والمشرف."
		/>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("وظيفة الشوب دروينج في المشروع")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تفسير التصميم", "إظهار التفاصيل التي لا تظهر بوضوح في لوحة التصميم، وربطها بأبعاد ومناسيب وملاحظات تنفيذية قابلة للقراءة في الموقع.")}
			pTopic2={new Topic("تنسيق التخصصات", "تجميع المعماري والإنشائي والكهرباء والميكانيكا داخل مساحة واحدة حتى لا يكتشف المقاول التعارض بعد بدء التنفيذ.")}
			pTopic3={new Topic("ضبط التوريد", "تحديد المقاسات والكميات التقريبية والأنواع والجداول التي يحتاجها المورد قبل التصنيع أو الشراء أو التركيب.")}
			pTopic4={new Topic("تقليل التعديلات", "كل ملاحظة يتم حلها على الورق أرخص وأسرع من حلها بعد التكسير أو القص أو إعادة التركيب أو إيقاف فريق التنفيذ.")}
		/>

	</EmoSec>







	<EmoStr
		id="disciplines"
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<CardsGr
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("شوب دروينج معماري", "للمساقط التنفيذية، القطاعات، الواجهات الداخلية، جداول الفتحات، الأرضيات، الأسقف، التكسيات، تفاصيل الحمامات، المطابخ، السلالم، والواجهات.")}
			pTopic2={new Topic("شوب دروينج إنشائي", "للقواعد، اللبشة، الأعمدة، الكمرات، البلاطات، الحوائط، السلالم، تفريد الحديد، جداول القص والثني، السليفات، والفتحات قبل الصب.")}
			pTopic3={new Topic("شوب دروينج كهرباء", "للإنارة، القوى، اللوحات، جداول الدوائر، مسارات الكابلات، الكابل تراي، التيار الخفيف، الكاميرات، الداتا، التحكم، والتأريض.")}
			pTopic4={new Topic("شوب دروينج ميكانيكا", "للصرف، المياه، الحريق، التكييف، التهوية، الدكت، المواسير، المضخات، السليفات، الرايزرات، غرف المعدات، وفتحات الصيانة.")}
		/>

	</EmoStr>







	<EmoSec
		id="architectural-shopdrawing"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="الشوب دروينج المعماري"
			pDesc="الفرع المعماري هو أكثر الفروع ارتباطًا بالشكل النهائي الذي يراه العميل. قيمته في ضبط التفاصيل التي تظهر في التشطيب: الأرضيات، الأسقف، الحوائط، التكسيات، الفواصل، الفتحات، المقاسات النهائية، وتعارضات الديكور مع الخدمات."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emodsign/Tech/Shopdwg/Arch/",
					"HeroL.webp",
					false,
					"شوب دروينج معماري للفراغات والتفاصيل",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("متى تحتاجه؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("عند وجود تصميم داخلي أو معماري وتحتاج تحويله إلى تفاصيل تنفيذية يستطيع المقاول والمورد تنفيذها دون تفسير شخصي.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					{ Title: "عند تنفيذ التشطيبات", Items: ["أرضيات، حوائط، أسقف، أبواب، شبابيك، تفاصيل حمامات ومطابخ، وفواصل خامات."] },
					{ Title: "عند وجود تصميم ديكور", Items: ["تحويل الصور والمود بورد والرندر إلى لوحات مقاسات وخامات ومناسيب."] },
					{ Title: "عند تعدد الموردين", Items: ["تنسيق أعمال الرخام والخشب والزجاج والألومنيوم والجبس بورد والإضاءة المخفية."] },
					{ Title: "عند مراجعة المقاول", Items: ["إخراج لوحة مفهومة تمنع جملة اتفهمت غلط أو اتنفذت حسب خبرة الصنايعي."] }
				]}
			/>

		</HzStack>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نماذج مخرجات المعماري")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مساقط تنفيذية", "تثبيت المقاسات النهائية، اتجاهات الفتح، مستويات الأرضيات، فرش مبدئي، ورموز تفاصيل واضحة.")}
			pTopic2={new Topic("قطاعات وواجهات داخلية", "توضيح مناسيب الأسقف والحوائط والتكسيات والمقابلات بين المواد والعناصر البارزة.")}
			pTopic3={new Topic("جداول وخامات", "أبواب، شبابيك، تشطيبات، دهانات، بلاطات، رخام، خشب، زجاج، وكل بند يحتاج وصفًا قبل التوريد.")}
			pTopic4={new Topic("تفاصيل تركيب", "تفاصيل السلالم والدرابزين والكسوة والحمامات والمطابخ والفواصل والحليات وعلاقات الخامات.")}
		/>

	</EmoSec>







	<EmoSec
		id="structural-shopdrawing"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			pTitle="الشوب دروينج الإنشائي"
			pDesc="الفرع الإنشائي يحول التصميم إلى تفاصيل تركيب للحديد والنجارة والصب. أهميته تظهر قبل صب القواعد والأعمدة والبلاطات، لأن الخطأ الإنشائي يصعب علاجه بعد التنفيذ ويؤثر في باقي التخصصات."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("الأسئلة التي يجيب عنها")}
				pDesc={Text.Body.WithColor("#333333").OfText("الغرض من الشوب الإنشائي أن يرى فريق الموقع تفاصيل الحديد والفتحات والتداخلات قبل يوم الصب.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "أين يبدأ وينتهي السيخ؟", Items: ["تحديد أطوال التسليح، الوصلات، التكسيح، مناطق التكثيف، وملاحظات التراكب."] },
					{ Title: "كيف تتعامل السليفات مع التسليح؟", Items: ["توقيع الفتحات ومسارات الخدمات قبل الصب، ومراجعة تأثيرها على الكمرات والبلاطات والحواط."] },
					{ Title: "ما الذي يحتاج جدول قص وثني؟", Items: ["تحويل تفاصيل الحديد إلى Bar Marks وكميات وأشكال تساعد الحدادة والتوريد والمراجعة."] },
					{ Title: "ما الذي يحتاج مراجعة قبل الصب؟", Items: ["أماكن الأعمدة، السلالم، الأشاير، المناسيب، الفتحات، المدفونات، والقطاعات الحرجة."] }
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emodsign/Tech/Shopdwg/Struc/",
					"HeroL.webp",
					false,
					"شوب دروينج إنشائي وتفاصيل تسليح",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نماذج مخرجات الإنشائي")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تفريد حديد", "تفاصيل تسليح القواعد واللبشة والأعمدة والكمرات والبلاطات والسلالم والحواط حسب الرسومات المعتمدة.")}
			pTopic2={new Topic("جداول حديد", "Bar Bending Schedule لتسهيل القص والثني والتوريد والمراجعة وتقليل الهالك وسوء الفهم.")}
			pTopic3={new Topic("فتحات وسليفات", "مراجعة فتحات الخدمات والمدفونات وعلاقتها بالتسليح قبل الصب بدل تكسير العنصر بعد تنفيذه.")}
			pTopic4={new Topic("لوحات مراجعة", "إصدارات واضحة يمكن إرسالها للاستشاري أو المشرف أو المقاول مع سجل ملاحظات وتعديلات.")}
		/>

	</EmoSec>







	<EmoSec
		id="electrical-shopdrawing"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="الشوب دروينج الكهربائي"
			pDesc="الكهرباء في الموقع ليست نقاطًا على مسقط فقط. الشوب الكهربائي يضبط مسارات الكابلات والمواسير واللوحات والدوائر والأحمال ونقاط التيار الخفيف، ويربطها بالسقف والحوائط والأثاث والأجهزة وباقي الخدمات."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emodsign/Tech/Shopdwg/Elec/",
					"HeroL.webp",
					false,
					"شوب دروينج كهرباء ومسارات كابلات ولوحات",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("نطاقات الكهرباء")}
				pDesc={Text.Body.WithColor("#333333").OfText("الشوب الكهربائي الجيد يوازن بين التصميم، سهولة التنفيذ، سلامة التشغيل، وإمكانية الصيانة بعد التسليم.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					{ Title: "الإنارة", Items: ["تثبيت مواقع وحدات الإنارة والمفاتيح وربطها بالسقف والجبس بورد والديكور والأثاث."] },
					{ Title: "القوى واللوحات", Items: ["توزيع البرايز، مخارج الأجهزة، دوائر القوى، اللوحات الفرعية، ومسارات الكابلات."] },
					{ Title: "التيار الخفيف", Items: ["داتا، كاميرات، إنتركوم، أكسس كنترول، صوتيات، تليفون، نقاط راوتر، ومسارات شبكات."] },
					{ Title: "التنسيق", Items: ["تنسيق الكابل تراي والكوندويت مع الدكت والمواسير والكمرات والأسقف المعلقة والفتحات."] }
				]}
			/>

		</HzStack>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نماذج مخرجات الكهرباء")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("Layouts تنفيذية", "إنارة، قوى، لوحات، مخارج أجهزة، مفتاح، برايز، داتا، كاميرات، وسيناريوهات تشغيل.")}
			pTopic2={new Topic("مسارات", "كوندويت، كابل تراي، كابلات رئيسية وفرعية، فتحات، ومرور داخل السقف أو الأرض أو الحوائط.")}
			pTopic3={new Topic("جداول", "جداول لوحات ودوائر وأحمال وكابلات وملاحظات تشغيل ومراجعة عند الحاجة.")}
			pTopic4={new Topic("تنسيق", "مراجعة علاقات الكهرباء بالتكييف والسباكة والإنشائي والديكور قبل التنفيذ.")}
		/>

	</EmoSec>







	<EmoSec
		id="mechanical-shopdrawing"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			pTitle="الشوب دروينج الميكانيكي"
			pDesc="الميكانيكا أكثر تخصص يحتاج تنسيق مكاني؛ لأن المواسير والدكت والرايزرات والمعدات تتحرك داخل الأسقف والحوائط والأرضيات وغرف الخدمات. صفحة الميكانيكا المتخصصة تفصل الصرف والمياه والحريق والتكييف والتهوية."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("فروع الميكانيكا")}
				pDesc={Text.Body.WithColor("#333333").OfText("يتم التعامل مع كل نظام كشبكة لها مسارات ومناسيب وقطاعات ومعدات وفتحات صيانة، ثم يتم تنسيقها مع باقي الأنظمة.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الصرف", Items: ["ميول، أقطار، رايزرات، غرف تفتيش، تهوية، صرف تكثيف، وصرف معدات عند الحاجة."] },
					{ Title: "المياه", Items: ["تغذية، محابس، مضخات، خزانات، سخانات، نقاط صحية، مسارات، وعزل عند الحاجة."] },
					{ Title: "الحريق", Items: ["شبكات رش أو خراطيم أو أنظمة مناسبة حسب المشروع، مع تنسيق المواسير والمضخات والوصلات."] },
					{ Title: "التكييف والتهوية", Items: ["دكت، فليكس، Diffusers، Grilles، وحدات، صرف تكثيف، فتحات صيانة، وارتفاعات سقف ساقط."] }
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emodsign/Tech/Shopdwg/Mech/",
					"HeroL.webp",
					false,
					"شوب دروينج ميكانيكا وصرف ومياه وتكييف وحريق",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نماذج مخرجات الميكانيكا")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("Plumbing Shop Drawings", "صرف ومياه ورايزرات وميول وأقطار ومحابس ونقاط صحية وغرف تفتيش وسخانات وخزانات.")}
			pTopic2={new Topic("Firefighting Shop Drawings", "مسارات مواسير الحريق، الرشاشات أو الخراطيم أو المعدات، وربطها بالمعماري والكهرباء والمضخات.")}
			pTopic3={new Topic("HVAC Shop Drawings", "دكت، فتحات هواء، وحدات داخلية وخارجية، صرف تكثيف، عزل، ومسارات داخل السقف المستعار.")}
			pTopic4={new Topic("Coordination Sections", "قطاعات تنسيق توضح المناسيب والتقاطعات بين الدكت والمواسير والكابل تراي والكمرات والأسقف.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="مقارنة سريعة بين أنواع الرسومات"
			pDesc="هذا التمييز مهم قبل طلب الخدمة، لأن كل نوع من الرسومات له توقيت ومسؤولية ومخرجات مختلفة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
