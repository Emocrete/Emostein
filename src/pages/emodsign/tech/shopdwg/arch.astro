---
import BLayout from "@/Layout.astro";
import { Text, Topic, ElemBg, EmoMediaData, RespString, Pixel, Size, Align } from "@/TypesLib";
import { Hero, IndexSec, ESec, EmoStrip, Emograph, CardsGr, EmoList, RespImg, EmoCall, EmoBtn, EmoFaq, ReadAlso, RelServices, SecTitle, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شوب دروينج معماري"
	pDescr="خدمة إعداد شوب دروينج معماري للمباني والفراغات الداخلية والواجهات، تشمل تحويل التصميم المعماري إلى رسومات تنفيذية منسقة، تفاصيل حوائط وفتحات وأبواب وشبابيك وتشطيبات وأسقف ومناسيب وجداول، مع مراجعة التعارضات قبل التنفيذ."
	pSchemaImages={[
		"/Media/Emodsign/Tech/Shopdwg/Arch/HeroL.webp",
		"/Media/Emodsign/Tech/Shopdwg/HeroL.webp",
		"https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&fm=jpg&q=70&w=1600"
	]}
>







	<Hero
		pImgF="/Media/Emodsign/Tech/Shopdwg/Arch/"
		pTitle="شوب دروينج معماري"
		pDesc="رسومات تنفيذية معمارية تربط التصميم بالموقع: أبعاد، مناسيب، تفاصيل، خامات، جداول، فتحتات، أسقف، تشطيبات، ومراجعة تعارضات قبل أن تتحول الأخطاء إلى تكسير وتعديل أثناء التنفيذ."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pAlign="right"
		pPosL="18% 50% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب شوب دروينج معماري" />

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Img", "/Media/Emodsign/Tech/Shopdwg/Arch/", "HeroL.webp")}
		pTitleClr="#FFFFFF"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="مشكلة التنفيذ"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#execution-gap'"
		/>

		<EmoBtn
			pText="نطاق اللوحات"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#drawing-scope'"
		/>

		<EmoBtn
			pText="مراحل الخدمة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#workflow'"
		/>

		<EmoBtn
			pText="مخرجات التسليم"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#deliverables'"
		/>

	</IndexSec>







	<ESec
		id="execution-gap"
		pBg={new ElemBg("#F7F1E6")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="الشوب دروينج المعماري هو الحلقة بين التصميم والتنفيذ"
			pDesc="التصميم المعماري يشرح الفكرة والفراغ والواجهة. الشوب دروينج المعماري يترجم هذه الفكرة إلى قرارات تنفيذية قابلة للقياس والتركيب والمراجعة: أين يبدأ الحائط؟ أين ينتهي التشطيب؟ ما منسوب الأرضية؟ ما تفاصيل الباب؟ كيف يلتقي السقف بالحائط؟ وما الذي يجب أن يعرفه المقاول قبل النزول للموقع؟"
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(560, "auto", 320, "auto")}
				pTitle={Text.H3.WithColor("#111318").OfText("ما المشكلة التي تحلها الخدمة؟")}
				pText={Text.Body.WithColor("#333333").OfText("في مشاريع كثيرة تكون الرسومات المعمارية كافية لفهم الشكل العام، لكنها لا تكفي لتوجيه فرق التنفيذ اليومية. العامل يحتاج مقاسًا واضحًا، والمقاول يحتاج تفصيلة، والمورد يحتاج جدولًا، والمالك يحتاج أن يرى القرار قبل دفع ثمن الخامة. الشوب دروينج المعماري يقلل مساحة الاجتهاد داخل الموقع ويحول التصميم إلى لغة تنفيذ مفهومة بين المكتب والمقاول والمورد والمالك.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&fm=jpg&q=70&w=1400",
					false,
					"مراجعة رسومات تنفيذية معمارية قبل بدء التنفيذ",
					new Size(560, 360, 320, 230)
				)}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#111318")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تطلب شوب دروينج معماري؟"
			pDesc="الطلب لا يرتبط بحجم المشروع فقط. قد تحتاجه في فيلا كبيرة، أو محل صغير، أو شقة فاخرة، أو واجهة قائمة. المعيار الحقيقي هو مقدار التفاصيل التي سيحتاجها التنفيذ ومقدار الخطأ المحتمل إذا تركت القرارات للموقع."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("حالات عملية تستدعي رسومات تنفيذية معمارية")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("قبل بدء التشطيب", "عندما يكون لديك تصميم معماري أو تصميم داخلي وتحتاج تحويله إلى أبعاد ومناسيب وتفاصيل قابلة للتنفيذ بدل الاعتماد على صور أو رسومات عامة.")}
			pTopic2={new Topic("عند وجود أكثر من مقاول", "الشوب دروينج يجعل الجميع يعملون على نفس المعلومات: مقاول محارة، جبس بورد، رخام، نجارة، ألوميتال، دهانات، زجاج، أو كلادينج.")}
			pTopic3={new Topic("عند اعتماد خامات خاصة", "الرخام، الخشب، الزجاج، الشرائح، التكسيات، والواجهات تحتاج تفاصيل التقاء وفواصل ومقاسات تصنيع لا تظهر عادة في رسومات التصميم المبدئية.")}
			pTopic4={new Topic("عند تعديل مبنى قائم", "المبنى القائم يحتاج رفعًا ومطابقة للأبعاد الفعلية قبل إخراج تفاصيل تنفيذية حتى لا تتصادم الرسومات مع واقع الموقع.")}
			pTopic5={new Topic("عند تجهيز عرض سعر دقيق", "كلما زادت التفاصيل والجداول، أصبح تسعير المقاول أقرب للواقع وأقل اعتمادًا على تحفظات عامة أو بنود مفتوحة.")}
			pTopic6={new Topic("عند وجود خلافات تنفيذية", "إذا بدأ الموقع في طرح أسئلة متكررة حول الأبعاد أو المناسيب أو التفاصيل، فغالبًا الملف يحتاج شوب دروينج لا مجرد شرح شفهي.")}
		/>

	</ESec>







	<EmoStrip
		id="drawing-scope"
		pBg={new ElemBg("#0E1118")}
		pSize={new Size("100%", "auto", "100%", "auto")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(1200, "auto", "calc(100% - 20px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("الفرق العملي بين رسومات التصميم والشوب دروينج")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("كلاهما رسومات هندسية، لكن وظيفة كل منهما مختلفة. رسومات التصميم تشرح القرار المعماري، أما الشوب دروينج فيختبر هذا القرار على مستوى التنفيذ والتصنيع والتركيب والتنسيق مع الموقع.")}
				pSize={new Size(1000, "auto", 320, "auto")}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("رسومات التصميم")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("تشرح الفكرة", "تعرض التوزيع العام والواجهات والقطاعات والمناسيب الأساسية، وتحدد شخصية المشروع واتجاه التصميم.")}
				pTopic2={new Topic("تخاطب المالك والجهات", "تفيد في الاعتماد والتصور والترخيص والتواصل العام بين المصمم وصاحب المشروع.")}
				pTopic3={new Topic("تفاصيلها انتقائية", "قد تحتوي تفاصيل رئيسية، لكنها لا تغطي كل عقدة تنفيذ أو كل مقاس تصنيع أو كل نقطة التقاء بين الخامات.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("الشوب دروينج المعماري")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("يوجه التنفيذ", "يركز على المقاسات والمناسيب والفتحات والجداول والتفاصيل التي سيستخدمها المقاول والمورد مباشرة.")}
				pTopic2={new Topic("يختبر قابلية التركيب", "يبحث عن التعارضات بين الحوائط والأبواب والأسقف والكسوات والأثاث والخدمات قبل التنفيذ.")}
				pTopic3={new Topic("يربط الخامة بالتفصيلة", "يوضح طريقة انتهاء الخامة، الفواصل، الاتجاهات، العتبات، الكرانيش، الحليات، وفتحات الصيانة.")}
			/>

		</HzStack>

	</EmoStrip>







	<ESec pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="نطاق لوحات الشوب دروينج المعماري"
			pDesc="النطاق يتحدد حسب المشروع، لكن الخدمة قد تشمل مساقط تنفيذية، قطاعات، واجهات داخلية، جداول فتحات، تفاصيل حوائط، أسقف، أرضيات، تشطيبات، تكسيات، رخام، خشب، زجاج، وأجزاء مرتبطة بالواجهات أو الفراغات الداخلية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("لوحات أساسية يمكن إعدادها")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مساقط تنفيذية", "تحديد الأبعاد النهائية، سمك الحوائط، الفتحات، مناسيب الأرضيات، أماكن التشطيبات، وعلاقات الفراغات بعد مراجعة الواقع.")}
			pTopic2={new Topic("قطاعات معمارية", "شرح العلاقات الرأسية، ارتفاعات الأسقف، العتب، الدرج، اختلافات المناسيب، تفاصيل الحوائط، ومناطق التقاء الخامات.")}
			pTopic3={new Topic("واجهات داخلية", "تفصيل حوائط مهمة داخل الفراغات: خلفية سرير، شاشة، ريسبشن، كاونتر، حمام، مطبخ، أو واجهة عرض تجاري.")}
			pTopic4={new Topic("جداول أبواب وشبابيك", "تجميع المقاسات والأنواع والاتجاهات والخامات والملاحظات المرتبطة بالتصنيع والتركيب.")}
			pTopic5={new Topic("خطط أرضيات وتشطيبات", "تحديد أنواع الأرضيات، اتجاه التركيب، الفواصل، الوزرات، العتبات، مناطق تغيير الخامة، وبداية التبليط أو الرخام.")}
			pTopic6={new Topic("خطط أسقف وإضاءة معمارية", "توضيح الجبس بورد والكرانيش وفتحات الصيانة وتنسيق الإضاءة والفتحات مع الكهرباء والتكييف.")}
			pTopic7={new Topic("تفاصيل تكسيات", "رخام، خشب، بدائل خشب، حجر، كلادينج، زجاج، مرايا، أو حوائط ديكورية تحتاج مقاسات وفواصل ونهايات.")}
			pTopic8={new Topic("لوحات تنسيق", "مراجعة مع الإنشائي والكهرباء والميكانيكا حتى لا تصطدم التفاصيل المعمارية بمسارات أو فتحات أو معدات قائمة.")}
		/>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#0E1118")}
		pSize={new Size("100%", "auto", "100%", "auto")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(1200, "auto", "calc(100% - 20px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("الشوب دروينج المعماري داخل الموقع")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("قيمة اللوحة تظهر عندما يستخدمها الفني في التنفيذ. لذلك يتم إخراج الرسومات بطريقة تشرح القرار لمن سيقيس ويقص ويركب، لا لمن يشاهد التصميم فقط.")}
				pSize={new Size(1000, "auto", 320, "auto")}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1400",
					false,
					"موقع تنفيذ يحتاج رسومات معمارية دقيقة",
					new Size(560, 360, 320, 230)
				)}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("من أسئلة الموقع التي يجيب عنها الشوب دروينج")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("هذه الأسئلة تتكرر في التنفيذ، وإذا لم تكن إجاباتها داخل الرسومات ستتحول إلى قرارات عشوائية أو اتصالات يومية.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={false}
				pItems={[
					"أين يبدأ محور الحائط وأين ينتهي سمك التشطيب؟",
					"ما منسوب الأرضية النهائية في كل فراغ؟",
					"ما عرض فتحة الباب بعد الحلوق والتشطيب؟",
					"أين يبدأ تركيب الرخام أو السيراميك وما اتجاهه؟",
					"كيف ينتهي السقف المعلق عند الحائط أو الكورنيشة؟",
					"ما مقاس فتحة الصيانة وما علاقتها بالإضاءة والتكييف؟",
					"هل مقاس النافذة مناسب للحلق والزجاج والكسوة الخارجية؟",
					"ما الفاصل بين خامتين مختلفتين ومن المسؤول عن تنفيذه؟",
				]}
			/>

		</HzStack>

	</EmoStrip>







	<ESec pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="أنواع المشروعات التي نخدمها في الشوب دروينج المعماري"
			pDesc="تختلف أولويات اللوحات من مشروع لآخر. الفيلا تحتاج تفاصيل سكنية وواجهات ومناسيب، والمحل يحتاج عرضًا وتجهيزات، والعيادة تحتاج فراغات دقيقة، والمكتب يحتاج تنسيقًا بين الحركة والتجهيزات."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("تطبيقات عملية للخدمة")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("فلل ومنازل", "توضيح السلالم، المداخل، الواجهات، الأرضيات، الأسقف، الحمامات، المطابخ، فتحات الشبابيك، ومناطق الضيافة والمعيشة.")}
			pTopic2={new Topic("شقق وتشطيبات داخلية", "تفاصيل حوائط مميزة، أرضيات، أسقف، مطابخ، حمامات، غرف نوم، وحدات تخزين، ومناسيب نهائية قبل التنفيذ.")}
			pTopic3={new Topic("محلات ومعارض", "واجهات عرض، كاونترات، وحدات عرض، لافتات، إضاءة، أرضيات مقاومة، ومسارات حركة العملاء والموظفين.")}
			pTopic4={new Topic("مطاعم وكافيهات", "كاونتر، مناطق خدمة، قاعات، حمامات، أسقف، واجهات داخلية، أرضيات، وتنسيق معماري مع الميكانيكا والكهرباء.")}
			pTopic5={new Topic("عيادات ومراكز طبية", "غرف كشف، استقبال، حمامات، أبواب، مواد سهلة التنظيف، تفاصيل خصوصية، ومسارات حركة واضحة.")}
			pTopic6={new Topic("مكاتب وشركات", "تقسيمات زجاج، مكاتب، غرف اجتماعات، ريسبشن، أسقف، أرضيات، تفاصيل وحدات ثابتة، وتنسيق مع الكهرباء والبيانات.")}
		/>

	</ESec>







	<ESec pBg={new ElemBg("#F7F1E6")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="المدخلات المطلوبة قبل إعداد الشوب دروينج"
