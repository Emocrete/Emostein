---
import { Align, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoBtn, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, IndexSec, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شوب دروينج ميكانيكا"
	pDescr="خدمة إعداد شوب دروينج ميكانيكا للمشروعات السكنية والتجارية والإدارية والطبية، تشمل الصرف والتغذية بالمياه ومكافحة الحريق والتكييف والتهوية، مع تحويل التصميم إلى رسومات تنفيذية منسقة تحدد المسارات والمناسيب والفتحات والتفاصيل قبل التنفيذ."
	pSchemaImages={[
		"/Media/Emodsign/Tech/Shopdwg/Mech/HeroL.webp",
		"/Media/Emodsign/Tech/Shopdwg/HeroL.webp",
		"https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1620893282749-344e30ed377f?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1615309662243-70f6df917b59?auto=format&fit=crop&fm=jpg&q=70&w=1600"
	]}
>







	<Hero
		pImgF="/Media/Emodsign/Tech/Shopdwg/Mech/"
		pTitle="شوب دروينج ميكانيكا"
		pDesc="رسومات تنفيذية ميكانيكية لفروع الصرف والمياه والحريق والتكييف والتهوية، تضبط المسارات والمناسيب والفتحات والتفاصيل قبل دخول فرق التنفيذ إلى الموقع."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="18% 50% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب شوب دروينج ميكانيكا" />

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Img", "/Media/Emodsign/Tech/Shopdwg/Mech/", "HeroL.webp")}
		pTitleClr="#FFFFFF"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="فجوة التنفيذ"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#execution-gap'"
		/>

		<EmoBtn
			pText="فروع الميكانيكا"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#mechanical-branches'"
		/>

		<EmoBtn
			pText="الصرف والمياه"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#plumbing-drainage'"
		/>

		<EmoBtn
			pText="الحريق والتكييف"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#fire-hvac'"
		/>

		<EmoBtn
			pText="التنسيق"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#coordination'"
		/>

		<EmoBtn
			pText="المخرجات"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#deliverables'"
		/>

	</IndexSec>







	<ESec
		id="execution-gap"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="الشوب دروينج الميكانيكي يحول التصميم إلى مسار تنفيذ واضح"
			pDesc="لوحات التصميم الميكانيكي تحدد الفكرة والحسابات والمبادئ العامة، لكن الموقع يحتاج رسومات تنفيذية تعرف كل فريق أين يمر الماسور أو الدكت، بأي منسوب، داخل أي سقف أو حائط أو شفت، وكيف يتجنب الكمرات والكابلات والفتحات المعمارية."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("ما المشكلة التي تحلها الخدمة؟")}
				pText={Text.Body.WithColor("#333333").OfText("الميكانيكا أكثر تخصص يتورط في التعارضات لأن مواسير الصرف والمياه والحريق والدكتات ووحدات التكييف تحتاج مساحات فعلية ومناسيب وميول وفتحات وصيانة. عند ترك هذه التفاصيل للموقع تظهر حلول مرتجلة: ماسورة تمر أمام فتحة، دكت يهبط بالسقف، مصرف بلا ميل كاف، نقطة حريق تصطدم بالإضاءة، أو مسار تكييف يقطع ديكور السقف. الشوب دروينج الميكانيكي يحول كل ذلك إلى قرار مرسوم قبل التنفيذ.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1542274368-443d694d79aa?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"مواسير صناعية ومسارات ميكانيكية تحتاج تنسيقًا قبل التنفيذ",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</ESec>







	<ESec
		id="mechanical-branches"
		pBg={new ElemBg("#111318")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="فروع شوب دروينج الميكانيكا داخل الخدمة"
			pDesc="نقسم الشوب دروينج الميكانيكي إلى فروع واضحة حتى يعرف العميل أو المقاول ما الذي يطلبه بالضبط، لأن كلمة ميكانيكا وحدها قد تعني صرفًا ومياه أو حريقًا أو تكييفًا أو كل هذه الأعمال معًا."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("الصرف والمياه والحريق والتكييف")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("صرف صحي وصرف تكثيف", "مسارات الصرف، الميول، أقطار المواسير، أماكن الجاليترابات والبيارات والنقط الأرضية، الرايزرات، غرف التفتيش، فتحات الصيانة، وصرف وحدات التكييف.")}
			pTopic2={new Topic("تغذية مياه", "مسارات المياه الباردة والساخنة، المحابس، العدادات، الطلمبات، الخزانات، السخانات، نقاط التغذية، العزل، وطرق المرور داخل الحوائط والأسقف والأرضيات.")}
			pTopic3={new Topic("مكافحة الحريق", "مسارات الشبكة، الخراطيم، الرشاشات، المحابس، غرف الطلمبات، خطوط التغذية، التفاصيل والفتحات والتنسيق مع الأسقف والإضاءة والإنذار.")}
			pTopic4={new Topic("تكييف وتهوية", "مسارات الدكت، وحدات التكييف، مخارج الهواء، الراجع، الفريش إير، الإكزوست، صرف التكثيف، فتحات الصيانة، والتنسيق مع السقف المعلق والإنارة.")}
		/>

	</ESec>







	<ESec
		id="service-cases"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تحتاج شوب دروينج ميكانيكا؟"
			pDesc="هذه الخدمة تظهر أهميتها كلما زاد ضغط الخدمات داخل السقف أو الشفت أو غرفة المعدات. قد تكون مطلوبة في مشروع كبير، وقد تكون أكثر أهمية في مطعم صغير أو عيادة لأن المساحات المحدودة لا تتحمل الارتجال."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("متى تحتاج شوب دروينج ميكانيكا؟")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تصميم عام يحتاج تنفيذ", "عند وجود تصميم ميكانيكي يوضح الفكرة فقط دون مسارات تفصيلية أو مناسيب أو قطاعات أو تفاصيل تثبيت.")}
			pTopic2={new Topic("مقاول قبل الاعتماد", "عندما يحتاج المقاول إلى رسومات اعتماد يراجعها المالك أو الاستشاري قبل شراء الخامات وتركيب المواسير والدكتات.")}
			pTopic3={new Topic("سقف مزدحم بالخدمات", "عند وجود دكتات، مواسير حريق، صرف تكييف، إنارة، سماعات، كاميرات، سبوتات، ورشاشات داخل سقف واحد.")}
			pTopic4={new Topic("مطعم أو كافيه", "لأن التهوية والصرف والمياه والغاز والحريق تؤثر مباشرة على التشغيل والرائحة والصيانة والتراخيص.")}
			pTopic5={new Topic("عيادة أو مركز طبي", "لأن نقاط المياه والصرف والتهوية والتكييف يجب أن تخدم الحركة والخصوصية والتشغيل المستمر.")}
			pTopic6={new Topic("مراجعة موقع قائم", "عند ظهور تعارضات في التنفيذ أو الحاجة إلى تعديل مسار قائم دون إيقاف المشروع أو إعادة تكسير كبيرة.")}
		/>

	</ESec>







	<EmoStrip
		id="design-vs-shop"
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("الفرق بين التصميم الميكانيكي والشوب دروينج")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("التصميم يحدد الحل الهندسي، أما الشوب دروينج فيحوّل الحل إلى تعليمات تركيب. الخلط بين الاثنين يجعل المقاول يتوقع تفاصيل غير موجودة، أو يجعل العميل يظن أن اللوحات العامة كافية للتنفيذ المباشر.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("الفرق بين التصميم الميكانيكي والشوب دروينج")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("التصميم الميكانيكي", "يركز على الحسابات والمبادئ والأنظمة: أحمال التكييف، اختيار الأنظمة، توزيع نقاط الصرف والمياه، شبكات الحريق، والاشتراطات العامة.")}
			pTopic2={new Topic("الشوب دروينج", "يركز على المسار والمقاس والمنسوب والقطاع والتفصيلة والاعتماد، ويستخدمه فريق التنفيذ في الموقع والورشة والتوريد.")}
			pTopic3={new Topic("التنسيق", "يراجع العلاقة بين الميكانيكا والمعماري والإنشائي والكهرباء حتى لا تتداخل الخدمات داخل السقف أو الشفت أو غرفة المعدات.")}
			pTopic4={new Topic("الأس بيلت", "يسجل ما تم تنفيذه فعليًا بعد التعديلات الميدانية، ولا يغني عن الشوب دروينج قبل بدء التنفيذ.")}
		/>

	</EmoStrip>







	<ESec
		id="inputs"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="المستندات المطلوبة قبل إعداد الشوب دروينج"
			pDesc="الشوب دروينج لا يبدأ من صفحة بيضاء. هو قراءة تنفيذية للتصميم والموقع والمواصفات والقيود المتاحة، لذلك دقة المدخلات تؤثر مباشرة في جودة الرسومات."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("ملفات نطلبها من العميل أو المقاول")}
				pDesc={Text.Body.WithColor("#333333").OfText("كل ملف من هذه الملفات يقلل التخمين ويجعل الرسومات أقرب للتنفيذ الفعلي.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={true}
				pItems={[
				{
								"Title": "لوحات التصميم",
								"Items": [
												"مخططات الصرف والمياه والحريق والتكييف والتهوية، الحسابات، التفاصيل، الرموز، وجداول المعدات إن وجدت."
								]
				},
				{
								"Title": "لوحات المعماري",
								"Items": [
												"المساقط، القطاعات، المناسيب، الأسقف المعلقة، الفتحات، الشفتات، الحمامات، المطابخ، وغرف الخدمات."
								]
				},
				{
								"Title": "اللوحات الإنشائية",
								"Items": [
												"الكمرات، البلاطات، الأعمدة، فتحات الكور، السلالم، مناطق المنع من التكسير، وعناصر التحميل الخاصة بالمعدات."
								]
				},
				{
								"Title": "لوحات الكهرباء",
								"Items": [
												"الإنارة، الكابلات، التريهات، اللوحات، تغذية المعدات، الإنذار، وأنظمة التيار الخفيف المؤثرة على الأسقف."
								]
				},
				{
								"Title": "المواصفات والكود",
								"Items": [
												"نوع المواسير والدكتات والعزل والتعليق والمحابس والمعدات، وأي اشتراطات اعتماد أو جهة مراجعة."
								]
				}
]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1581092160607-ee22621dd758?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"مراجعة رسومات ومعلومات فنية قبل إعداد الشوب دروينج الميكانيكي",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</ESec>







	<ESec
		id="workflow"
		pBg={new ElemBg("#111318")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="مسار العمل في شوب دروينج الميكانيكا"
			pDesc="ترتيب العمل يمنع إعادة الرسم أكثر من مرة. نبدأ بقراءة التصميم والقيود، ثم ننسق المسارات، ثم نخرج اللوحات والتفاصيل، ثم ندير المراجعات والإصدارات."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("مسار العمل في شوب دروينج الميكانيكا")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("فهم النطاق", "تحديد الفروع المطلوبة: صرف، مياه، حريق، تكييف، أو حزمة ميكانيكا كاملة.")}
			pTopic2={new Topic("تجميع الملفات", "استلام المعماري والإنشائي والكهرباء والتصميم الميكانيكي والمواصفات وأي ملاحظات من الاستشاري.")}
			pTopic3={new Topic("تحليل التعارضات", "رصد مناطق الزحام: الأسقف، الشفتات، غرف المعدات، البدروم، المطابخ، الحمامات، والممرات.")}
			pTopic4={new Topic("تثبيت المسارات", "اختيار مسارات قابلة للتنفيذ والصيانة مع مراعاة المناسيب والميول وارتفاعات السقف.")}
			pTopic5={new Topic("إخراج اللوحات", "إنتاج المخططات والقطاعات والتفاصيل والجداول والرموز والنوتات التنفيذية حسب النطاق.")}
			pTopic6={new Topic("المراجعة الداخلية", "مراجعة المقاسات والارتفاعات والربط بين الفروع قبل تسليم الإصدار للعميل أو الاستشاري.")}
			pTopic7={new Topic("ملاحظات الاعتماد", "استقبال تعليقات الاستشاري أو المقاول وتعديل اللوحات بإصدار واضح ومؤرخ.")}
			pTopic8={new Topic("دعم التنفيذ", "الرد على الاستفسارات الفنية وتوضيح التفاصيل المؤثرة عند بدء التركيب أو عند ظهور قيد موقعي.")}
		/>

	</ESec>







	<ESec
		id="plumbing-drainage"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="شوب دروينج الصرف الصحي وصرف التكثيف"
			pDesc="الصرف أكثر الفروع حساسية للمناسيب والميول، وأي خطأ فيه يظهر بعد غلق الأرضيات أو الأسقف في صورة ارتداد أو رائحة أو تكسير. لذلك لا يكفي تحديد نقطة صرف؛ يجب تحديد المسار والمنسوب والميل وفتحات الصيانة وطريقة الخروج."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
