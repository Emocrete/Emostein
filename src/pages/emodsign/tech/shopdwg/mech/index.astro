---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="شوب دروينج ميكانيكا"
	pDescr="خدمة إعداد شوب دروينج ميكانيكا للمشروعات السكنية والتجارية والإدارية والطبية، تشمل الصرف والتغذية بالمياه ومكافحة الحريق والتكييف والتهوية، مع تحويل التصميم إلى رسومات تنفيذية منسقة تحدد المسارات والمناسيب والفتحات والتفاصيل قبل التنفيذ."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("50%","95%"))} pLoc={new Loc(new NumPer("2%","2.5%"),new NumPer("35%","10%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("شوب دروينج ميكانيكا")}
				pText={Text.Body.Centered.OfText("خدمة إعداد شوب دروينج ميكانيكا للمشروعات السكنية والتجارية والإدارية والطبية، تشمل الصرف والتغذية بالمياه ومكافحة الحريق والتكييف والتهوية، مع تحويل التصميم إلى رسومات تنفيذية منسقة تحدد المسارات والمناسيب والفتحات والتفاصيل قبل التنفيذ.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
