---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="شوب دروينج معماري"
	pDescr="خدمة إعداد شوب دروينج معماري للمباني والفراغات الداخلية والواجهات، تشمل تحويل التصميم المعماري إلى رسومات تنفيذية منسقة، تفاصيل حوائط وفتحات وأبواب وشبابيك وتشطيبات وأسقف ومناسيب وجداول، مع مراجعة التعارضات قبل التنفيذ."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("شوب دروينج معماري")}
				pText={Text.Body.Centered.OfText("خدمة إعداد شوب دروينج معماري للمباني والفراغات الداخلية والواجهات، تشمل تحويل التصميم المعماري إلى رسومات تنفيذية منسقة، تفاصيل حوائط وفتحات وأبواب وشبابيك وتشطيبات وأسقف ومناسيب وجداول، مع مراجعة التعارضات قبل التنفيذ.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<RelServices>

		<RelServiceItem pTitle="تصميم داخلي" pDesc="تحديد توزيع الفراغات والخامات والإضاءة والأثاث قبل إنتاج تفاصيل تنفيذية للتشطيب." pHref="/emodsign/des/cr/int" />

		<RelServiceItem
			pTitle="تصميم واجهات"
			pDesc="تصميم الواجهات والخامات والنسب قبل إخراج تفاصيل تنفيذية للتكسيات والفتحات."
			pHref="/emodsign/des/cr/ext/facade"
		/>

		<RelServiceItem
			pTitle="حصر كميات التشطيبات"
			pDesc="حصر بنود التشطيب بعد وضوح اللوحات التنفيذية والخامات والتفاصيل."
			pHref="/emodsign/tech/takeoff/finishing"
		/>

		<RelServiceItem
			pTitle="إدارة المشروعات الهندسية"
			pDesc="تنظيم النطاق والوقت والتكلفة والتغييرات والتقارير خلال مرحلة التنفيذ."
			pHref="/emodsign/tech/manage"
		/>

	</RelServices>







</BLayout>
