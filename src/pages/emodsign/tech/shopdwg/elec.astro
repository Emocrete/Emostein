---
import { Align, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoBtn, EmoCall, EmoFaq, Emograph, EmoList, EmoRatingStrip, EmoStrip, ESec, FaqItem, Hero, HzStack, IndexSec, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شوب دروينج كهرباء"
	pDescr="خدمة إعداد شوب دروينج كهرباء للمشروعات السكنية والتجارية والإدارية، تشمل تحويل التصميم الكهربائي إلى رسومات تنفيذية للإنارة والقوى واللوحات والكابلات والتيار الخفيف والتأريض ومسارات التغذية، مع تنسيق المسارات مع المعماري والإنشائي والميكانيكا قبل التنفيذ."
	pSchemaImages={[
		"/Media/Emodsign/Tech/Shopdwg/Elec/HeroL.webp",
		"/Media/Emodsign/Tech/Shopdwg/HeroL.webp",
		"https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&fm=jpg&q=70&w=1600"
	]}
>







	<Hero
		pImgF="/Media/Emodsign/Tech/Shopdwg/Elec/"
		pTitle="شوب دروينج كهرباء"
		pDesc="رسومات تنفيذية كهربائية تقلل الارتجال في الموقع: إنارة، قوى، لوحات، كابلات، مسارات، تيار خفيف، تأريض، جداول، تفاصيل تركيب، وتنسيق مع باقي التخصصات قبل بدء التنفيذ."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="18% 50% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب شوب دروينج كهرباء" />

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Img", "/Media/Emodsign/Tech/Shopdwg/Elec/", "HeroL.webp")}
		pTitleClr="#FFFFFF"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="فجوة التنفيذ"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#execution-gap'"
		/>

		<EmoBtn
			pText="نطاق اللوحات"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#drawing-scope'"
		/>

		<EmoBtn
			pText="تنسيق المسارات"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#coordination'"
		/>

		<EmoBtn
			pText="مراحل الخدمة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#workflow'"
		/>

		<EmoBtn
			pText="مخرجات التسليم"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#deliverables'"
		/>

	</IndexSec>







	<ESec
		id="execution-gap"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="الشوب دروينج الكهربائي يترجم التصميم إلى تعليمات تنفيذ"
			pDesc="التصميم الكهربائي يحدد الفكرة والأحمال والتوزيع العام، لكن فرق التنفيذ تحتاج ما هو أكثر تحديدًا: مسارات الكابلات، أرقام الدوائر، مواقع العلب، تفاصيل اللوحات، علاقات الإنارة بالمفاتيح، تنسيق مخارج القوى مع الأجهزة، ومسارات التيار الخفيف. هنا تبدأ قيمة الشوب دروينج الكهربائي كوثيقة تشغيل للموقع وليست مجرد إعادة رسم للتصميم."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("ما المشكلة التي تحلها الخدمة؟")}
				pText={Text.Body.WithColor("#333333").OfText("في الموقع لا يكفي أن يعرف الفني أن هناك نقطة إنارة أو بريزة في مكان ما. يجب أن يعرف الدائرة التي تغذيها، مسار السلك أو الكابل، رقم اللوحة، وسيلة الحماية، ارتفاع التركيب، علاقة النقطة بالأثاث أو السقف أو الجهاز، وهل تمر التغذية داخل حائط أم سقف أم أرضية أم تريه. كل نقطة غير محسومة تتحول إلى سؤال في الموقع، وكل سؤال غير موثق يتحول إلى اجتهاد قد يسبب تكسيرًا أو إعادة تمديد أو تعارضًا مع السباكة والتكييف والديكور.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1621905252507-b35492cc74b4?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"فني كهرباء يراجع لوحة توزيع ومسارات كهرباء",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#111318")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تحتاج شوب دروينج كهرباء؟"
			pDesc="هذه الخدمة ليست مطلوبة فقط في الأبراج أو المشروعات الكبيرة. أي مشروع فيه أسقف معلقة، إنارة متعددة السيناريوهات، تكييف، مضخات، مطعم، عيادة، مكتب، أو نظام تيار خفيف يحتاج ضبطًا قبل التنفيذ."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("حالات عملية تستدعي الخدمة")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تصميم موجود لكنه عام", "عند وجود لوحات تصميم كهرباء لا توضح مسارات الكابلات أو أرقام الدوائر أو تفاصيل اللوحات أو الارتفاعات التنفيذية لكل نقطة.")}
			pTopic2={new Topic("مقاول يحتاج اعتمادًا", "عندما يطلب المالك أو الاستشاري شوب دروينج قبل التنفيذ حتى تصبح اللوحات المعتمدة مرجعًا للتوريد والتركيب والاستلام.")}
			pTopic3={new Topic("سقف معلق أو ديكور معقد", "عند وجود جبس بورد أو إنارة مخفية أو سبوتات أو تكييف كونسيلد أو سماعات أو كاميرات تحتاج تنسيقًا قبل غلق السقف.")}
			pTopic4={new Topic("مشروع تجاري أو إداري", "المكاتب والمحلات والمطاعم والعيادات تحتاج أحمالًا ومسارات ولوحات وأنظمة تشغيل أكثر تعقيدًا من الاستخدام السكني البسيط.")}
			pTopic5={new Topic("تيار خفيف وأنظمة أمن", "عند وجود كاميرات، إنترنت، سنترال، إنتركم، أكسس كنترول، ساوند سيستم، داتا راك، أو نقاط شاشة وتحكم.")}
			pTopic6={new Topic("مراجعة قبل التنفيذ", "عندما تريد التأكد أن الرسومات الحالية قابلة للتنفيذ قبل شراء الكابلات أو فتح الحوائط أو تركيب السقف المعلق.")}
		/>

	</ESec>







	<EmoStrip
		id="drawing-scope"
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("نطاق لوحات الشوب دروينج الكهربائي")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("الملف الكهربائي التنفيذي يجب أن يجيب على أسئلة الموقع: أين النقطة؟ من أي لوحة تتغذى؟ ما رقم الدائرة؟ ما المسار؟ ما نوع الكابل أو السلك؟ هل يوجد تعارض مع السقف أو التكييف أو السباكة؟ وما الذي سيتم توريده وتركيبه فعلًا؟")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("مكونات الملف التنفيذي")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مخططات الإنارة", "توزيع وحدات الإنارة، ربطها بالمفاتيح، الدوائر، السيناريوهات، الإنارة المخفية، الطوارئ عند الحاجة، وملاحظات التركيب.")}
			pTopic2={new Topic("مخططات القوى والبرايز", "مواقع البرايز ونقاط الأجهزة، ارتفاعات التركيب، دوائر مخصصة، تغذية الأحمال الخاصة، ومراعاة الأثاث والمعدات.")}
			pTopic3={new Topic("مسارات الكابلات والمواسير", "تحديد المسارات الأفقية والرأسية داخل السقف أو الحائط أو الأرضية أو التريهات أو الشفتات مع مراعاة التعارضات.")}
			pTopic4={new Topic("لوحات التوزيع", "توزيع الدوائر، جداول اللوحات، وسائل الحماية، ترقيم القواطع، الملاحظات، وربط اللوحات الرئيسية والفرعية.")}
			pTopic5={new Topic("التيار الخفيف", "داتا، تليفون، كاميرات، إنتركم، أكسس كنترول، واي فاي، ساوند سيستم، نقاط شاشة، وأنظمة تحكم حسب نوع المشروع.")}
			pTopic6={new Topic("التأريض والحماية", "ملاحظات التأريض، الحماية من التسرب، فصل الدوائر، متطلبات السلامة، وتحديد النقاط الحساسة التي تحتاج عناية أثناء التنفيذ.")}
			pTopic7={new Topic("تغذية المعدات", "تغذية وحدات التكييف والمضخات والسخانات والمطابخ والمعدات الطبية أو التجارية، وربطها بالميكانيكا والتشغيل.")}
			pTopic8={new Topic("تفاصيل التركيب", "تفاصيل العلب، الارتفاعات، مسارات التثبيت، رموز اللوحات، ملاحظات الموقع، والتفاصيل التي تقلل اختلاف التنفيذ بين الفرق.")}
		/>

	</EmoStrip>







	<ESec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="الفرق بين تصميم الكهرباء وشوب دروينج الكهرباء"
			pDesc="الخلط بين التصميم والشوب دروينج يسبب خلافات كثيرة في الموقع. التصميم يحدد الحل الكهربائي، أما الشوب دروينج فيشرح كيف يتم تنفيذه وترقيمه وتنسيقه واعتماده موقعيًا."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("تصميم الكهرباء")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("حساب وتنظيم", "يتعامل مع الأحمال، توزيع اللوحات، القدرة المطلوبة، الحماية، نوع الاستخدام، وتقسيم الدوائر بصورة هندسية عامة.")}
				pTopic2={new Topic("اعتماد فني", "يحدد فكرة النظام ومواصفات الأداء ويكون أساسًا للمراجعة والتسعير وربط المشروع بالمصدر الرئيسي.")}
				pTopic3={new Topic("مستوى أقل في التفاصيل", "قد لا يدخل في كل مسار ماسورة أو ارتفاع علبة أو طريقة عبور كابل داخل سقف معلق أو تفاصيل تنسيق مع الديكور.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("شوب دروينج الكهرباء")}
				pCardBg={new ElemBg("#111318")}
				pCardTitleFnt={Text.H4.WithColor("#D9B86C")}
				pCardBodyFnt={Text.Body.WithColor("#F8F4EA")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("ترجمة ميدانية", "يحول التصميم إلى رسومات تركيب واضحة للفني والمقاول، مع ترقيم ودوائر ومسارات وملاحظات تنفيذية.")}
				pTopic2={new Topic("تنسيق قبل الغلق", "يراجع المسارات مع السقف والميكانيكا والإنشائي قبل تركيب الأسقف أو إغلاق الحوائط أو شراء كميات كبيرة.")}
				pTopic3={new Topic("مرجع استلام", "بعد الاعتماد يصبح ملفًا يمكن الاستلام عليه، ومقارنة التنفيذ به، وتحديثه لاحقًا إلى رسومات As Built عند الحاجة.")}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="قراءة مستندات المشروع قبل الرسم"
			pDesc="أول خطأ في الشوب دروينج الكهربائي أن يبدأ الرسام بنقل النقاط من لوحة التصميم دون قراءة باقي المستندات. الكهرباء تتأثر بالمعماري والإنشائي والميكانيكا والديكور والمواصفات والموردين."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("ما الذي تتم مراجعته؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("قبل إعداد اللوحات التنفيذية يتم جمع المستندات المؤثرة في القرار الكهربائي.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={true}
				pItems={[
					{ Title: "لوحات التصميم الكهربائي", Items: ["المخططات، الأحمال، الجداول، السنجل لاين، التفاصيل، الرموز، والملاحظات العامة."] },					{ Title: "المعماري والديكور", Items: ["توزيع الفرش، الأسقف المعلقة، الحوائط، المناسيب، الأبواب، الواجهات، ومواقع الأجهزة المرئية."] },					{ Title: "الميكانيكا", Items: ["مواقع وحدات التكييف، المضخات، السخانات، مراوح التهوية، أنظمة الحريق، ولوحات التحكم الخاصة بها."] },					{ Title: "الإنشائي", Items: ["الكمرات، البلاطات، الفتحات، الشفتات، أماكن المنع من التكسير، وحدود عبور المواسير أو التريهات."] },					{ Title: "المواصفات", Items: ["نوع الكابلات، المواسير، اللوحات، القواطع، العلب، وحدات الإنارة، معايير التركيب، ومتطلبات الاعتماد."] }
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1518770660439-4636190af475?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"مكونات كهربائية ولوحات إلكترونية مرتبطة بتنسيق أنظمة الكهرباء",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</ESec>







	<EmoStrip
		id="coordination"
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#111318")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#F4E5C4").OfText("تنسيق المسارات الكهربائية مع باقي التخصصات")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("أكبر قيمة في شوب دروينج الكهرباء ليست في رسم الرموز فقط، بل في منع التصادم مع التكييف والسباكة والإنشائي والديكور قبل التنفيذ. المسارات الكهربائية تشغل فراغات حقيقية داخل الأسقف والحوائط والأرضيات، ويجب أن تترك مساحة للصيانة والتركيب الآمن.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نقاط التنسيق الحرجة")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مع المعماري", "مواضع المفاتيح والبرايز واللوحات يجب أن تتوافق مع الأبواب والفرش والواجهات والحوائط النهائية وليس مع مسقط إنشائي مجرد.")}
			pTopic2={new Topic("مع الديكور", "سبوتات الإنارة والإنارة المخفية والسماعات وكاميرات السقف يجب أن تتوافق مع تقسيمات الجبس ووحدات التكييف وفتحات الصيانة.")}
