---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="شوب دروينج كهرباء"
	pDescr="خدمة إعداد شوب دروينج كهرباء للمشروعات السكنية والتجارية والإدارية، تشمل تحويل التصميم الكهربائي إلى رسومات تنفيذية للإنارة والقوى واللوحات والكابلات والتيار الخفيف والتأريض ومسارات التغذية، مع تنسيق المسارات مع المعماري والإنشائي والميكانيكا قبل التنفيذ."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("شوب دروينج كهرباء")}
				pText={Text.Body.Centered.OfText("خدمة إعداد شوب دروينج كهرباء للمشروعات السكنية والتجارية والإدارية، تشمل تحويل التصميم الكهربائي إلى رسومات تنفيذية للإنارة والقوى واللوحات والكابلات والتيار الخفيف والتأريض ومسارات التغذية، مع تنسيق المسارات مع المعماري والإنشائي والميكانيكا قبل التنفيذ.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec
		id="drawing-scope"
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("نطاق لوحات الشوب دروينج الكهربائي")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("الملف الكهربائي التنفيذي يجب أن يجيب على أسئلة الموقع: أين النقطة؟ من أي لوحة تتغذى؟ ما رقم الدائرة؟ ما المسار؟ ما نوع الكابل أو السلك؟ هل يوجد تعارض مع السقف أو التكييف أو السباكة؟ وما الذي سيتم توريده وتركيبه فعلًا؟")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("مكونات الملف التنفيذي")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مخططات الإنارة", "توزيع وحدات الإنارة، ربطها بالمفاتيح، الدوائر، السيناريوهات، الإنارة المخفية، الطوارئ عند الحاجة، وملاحظات التركيب.")}
			pTopic2={new Topic("مخططات القوى والبرايز", "مواقع البرايز ونقاط الأجهزة، ارتفاعات التركيب، دوائر مخصصة، تغذية الأحمال الخاصة، ومراعاة الأثاث والمعدات.")}
			pTopic3={new Topic("مسارات الكابلات والمواسير", "تحديد المسارات الأفقية والرأسية داخل السقف أو الحائط أو الأرضية أو التريهات أو الشفتات مع مراعاة التعارضات.")}
			pTopic4={new Topic("لوحات التوزيع", "توزيع الدوائر، جداول اللوحات، وسائل الحماية، ترقيم القواطع، الملاحظات، وربط اللوحات الرئيسية والفرعية.")}
			pTopic5={new Topic("التيار الخفيف", "داتا، تليفون، كاميرات، إنتركم، أكسس كنترول، واي فاي، ساوند سيستم، نقاط شاشة، وأنظمة تحكم حسب نوع المشروع.")}
			pTopic6={new Topic("التأريض والحماية", "ملاحظات التأريض، الحماية من التسرب، فصل الدوائر، متطلبات السلامة، وتحديد النقاط الحساسة التي تحتاج عناية أثناء التنفيذ.")}
			pTopic7={new Topic("تغذية المعدات", "تغذية وحدات التكييف والمضخات والسخانات والمطابخ والمعدات الطبية أو التجارية، وربطها بالميكانيكا والتشغيل.")}
			pTopic8={new Topic("تفاصيل التركيب", "تفاصيل العلب، الارتفاعات، مسارات التثبيت، رموز اللوحات، ملاحظات الموقع، والتفاصيل التي تقلل اختلاف التنفيذ بين الفرق.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="الفرق بين تصميم الكهرباء وشوب دروينج الكهرباء"
			pDesc="الخلط بين التصميم والشوب دروينج يسبب خلافات كثيرة في الموقع. التصميم يحدد الحل الكهربائي، أما الشوب دروينج فيشرح كيف يتم تنفيذه وترقيمه وتنسيقه واعتماده موقعيًا."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("تصميم الكهرباء")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("حساب وتنظيم", "يتعامل مع الأحمال، توزيع اللوحات، القدرة المطلوبة، الحماية، نوع الاستخدام، وتقسيم الدوائر بصورة هندسية عامة.")}
				pTopic2={new Topic("اعتماد فني", "يحدد فكرة النظام ومواصفات الأداء ويكون أساسًا للمراجعة والتسعير وربط المشروع بالمصدر الرئيسي.")}
				pTopic3={new Topic("مستوى أقل في التفاصيل", "قد لا يدخل في كل مسار ماسورة أو ارتفاع علبة أو طريقة عبور كابل داخل سقف معلق أو تفاصيل تنسيق مع الديكور.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("شوب دروينج الكهرباء")}
				pCardBg={new ElemBg("#111318")}
				pCardTitleFnt={Text.H4.WithColor("#D9B86C")}
				pCardBodyFnt={Text.Body.WithColor("#F8F4EA")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("ترجمة ميدانية", "يحول التصميم إلى رسومات تركيب واضحة للفني والمقاول، مع ترقيم ودوائر ومسارات وملاحظات تنفيذية.")}
				pTopic2={new Topic("تنسيق قبل الغلق", "يراجع المسارات مع السقف والميكانيكا والإنشائي قبل تركيب الأسقف أو إغلاق الحوائط أو شراء كميات كبيرة.")}
				pTopic3={new Topic("مرجع استلام", "بعد الاعتماد يصبح ملفًا يمكن الاستلام عليه، ومقارنة التنفيذ به، وتحديثه لاحقًا إلى رسومات As Built عند الحاجة.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			pTitle="شوب دروينج القوى والبرايز والأجهزة"
			pDesc="القوى ليست مجرد عدد برايز. كل جهاز يحتاج مكانًا، قدرة، حماية، ارتفاعًا، مسار تغذية، وربطًا مع الاستخدام الحقيقي للفراغ. الخطأ هنا قد يظهر بعد التشطيب عند تركيب الأجهزة أو الأثاث."
		/>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نطاق نقاط القوى")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("البرايز العامة", "توزيع مخارج الكهرباء اليومية حسب الفرش ومسارات الحركة والحوائط النهائية، مع تجنب نقاط خلف أبواب أو أثاث ثابت.")}
			pTopic2={new Topic("الأجهزة المنزلية", "غسالة، ثلاجة، فرن، ميكروويف، شفاط، سخان، غسالة أطباق، ومعدات مطبخ تحتاج دوائر ومواقع واضحة.")}
			pTopic3={new Topic("التكييف", "تغذية وحدات داخلية وخارجية، مفاتيح عزل، مسارات صرف وتوصيل، وتنسيق مع الميكانيكا والواجهات.")}
			pTopic4={new Topic("المعدات التجارية", "معدات مطاعم، أجهزة عيادات، ماكينات، ثلاجات عرض، كاشير، شاشات، ومعدات لها أحمال خاصة أو دوائر منفصلة.")}
			pTopic5={new Topic("نقاط الأرضية", "Floor boxes أو نقاط داخل جزر مطابخ أو مكاتب اجتماعات تحتاج تحديدًا قبل صب أو تركيب الأرضية النهائية.")}
			pTopic6={new Topic("الاحتياطي والتوسعات", "في بعض المشاريع يفضل ترك دوائر احتياطية ومسارات قابلة للتطوير بدل إعادة التكسير بعد التشغيل.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="لوحات التوزيع وجداول الدوائر"
			pDesc="لوحة التوزيع هي المكان الذي تتحول فيه النقاط المتفرقة إلى نظام كهربائي قابل للفصل والصيانة والتتبع. لذلك يجب أن تكون جداول اللوحات مقروءة للمقاول والمالك وفني الصيانة بعد التشغيل."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1581092160607-ee22621dd758?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"مراجعة مخططات كهرباء وجداول لوحات",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("ما الذي يجب توضيحه في اللوحات؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("جداول اللوحات ليست ملحقًا شكليًا؛ هي مرجع مهم للتنفيذ والصيانة.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={true}
				pItems={[
					{ Title: "ترقيم الدوائر", Items: ["كل دائرة تحمل رقمًا واضحًا يظهر في المخططات وفي جدول اللوحة."] },					{ Title: "نوع الحمل", Items: ["إنارة، برايز، تكييف، سخان، معدات، مضخة، نظام تيار خفيف، أو حمل خاص."] },					{ Title: "وسيلة الحماية", Items: ["القواطع والحماية المناسبة حسب التصميم والمواصفات ونوع الحمل."] },					{ Title: "موقع اللوحة", Items: ["مكان مناسب للوصول والصيانة ولا يفسد الفراغ أو يختفي خلف عنصر ثابت."] },					{ Title: "الاحتياطي", Items: ["دوائر أو مساحات احتياطية عند الحاجة للتوسع المستقبلي."] }
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			pTitle="التيار الخفيف والأنظمة المساعدة"
			pDesc="مشروعات اليوم لا تعمل بالكهرباء الثقيلة فقط. الإنترنت والكاميرات والتحكم والداتا والصوتيات أصبحت جزءًا من الاستخدام اليومي للمنازل والمكاتب والمحلات والعيادات. الشوب دروينج يجعل هذه الأنظمة منظمة بدل تمديدات عشوائية بعد التشطيب."
		/>

		<CardsGr
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("Data & Network", "نقاط الإنترنت، الراوترات، السويتشات، كابلات الشبكة، الداتا راك، ونقاط الواي فاي حسب توزيع المستخدمين.")}
			pTopic2={new Topic("CCTV", "كاميرات داخلية وخارجية، زوايا تغطية، مسارات الكابلات، أماكن التسجيل، ومتطلبات التغذية.")}
			pTopic3={new Topic("Access Control", "أبواب تحكم، قارئات كروت، أقفال كهربائية، أزرار خروج، وربطها بمواقع الأمن والاستقبال.")}
			pTopic4={new Topic("Intercom", "إنتركم وحدات أو بوابات أو مداخل رئيسية، مع تحديد الكابلات ونقاط التغذية والتشغيل.")}
			pTopic5={new Topic("Sound System", "سماعات سقفية أو جدارية، مناطق صوت، تحكم، مسارات، وربطها بالديكور والأسقف.")}
			pTopic6={new Topic("Screens & AV", "نقاط شاشات، HDMI أو Data أو تغذية، مسارات مخفية، وتنسيق مع الأثاث والحوائط النهائية.")}
			pTopic7={new Topic("Fire Alarm", "عند دخوله في النطاق، يتم تنسيق الكواشف، نقاط النداء، السراين، والمسارات مع السقف والخدمات.")}
			pTopic8={new Topic("Smart Control", "دوائر تحكم وإضاءة ذكية أو ستائر أو سيناريوهات تشغيل تحتاج مسارات ولوحات وتنسيقًا خاصًا.")}
		/>

	</EmoSec>







	<EmoStr
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#111318")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#F4E5C4").OfText("شوب دروينج الكهرباء وعلاقته بالحصر والتوريد")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("كلما كانت اللوحات التنفيذية أوضح، أصبح تقدير الكابلات والمواسير والعلب واللوحات والمهمات أكثر منطقية. لذلك تساعد الخدمة في تحسين قرار الشراء ومقارنة عروض المقاولين، بشرط أن تكون المدخلات كافية.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("كيف يخدم الملف قرار الشراء؟")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("كابلات وأسلاك", "عندما تكون المسارات والدوائر واضحة يمكن تقدير الأطوال والقطاعات بصورة أفضل من الاعتماد على عدد نقاط فقط.")}
			pTopic2={new Topic("مواسير وتريهات", "تحديد المسارات يساعد في اختيار نظام التمديد والقطاعات والاكسسوارات المطلوبة.")}
			pTopic3={new Topic("لوحات وقواطع", "جداول اللوحات تجعل طلب التوريد أكثر وضوحًا وتقلل اختلافات عروض الموردين.")}
			pTopic4={new Topic("علب ومفاتيح وبرايز", "وجود ارتفاعات ونوعيات ومواقع يربط التوريد بالفراغ النهائي وليس بكمية عامة.")}
			pTopic5={new Topic("تيار خفيف", "الكاميرات والداتا والصوتيات تحتاج كابلات وراكات ومخارج وإكسسوارات تختلف حسب النظام.")}
			pTopic6={new Topic("احتياطي الهالك", "يساعد وضوح المسارات في تقدير احتياطي منطقي بدل شراء زائد أو توقف التنفيذ لنقص خامات.")}
		/>

	</EmoStr>







</BLayout>
