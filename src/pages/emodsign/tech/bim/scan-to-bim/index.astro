---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, RadialItem, RadialLayout } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="Scan to BIM"
	pDescr="Scan to BIM — خدمة BIM لتحويل المعلومات والرسومات إلى نموذج منسق يمكن استخدامه في المراجعة والتنسيق واستخراج الكميات وربطه بالوقت أو التكلفة حسب النطاق. وفي هذه الصفحة يكون التركيز الخاص على مستوى التفاصيل ونظام الإحداثيات وقواعد التسمية والتنسيق بين التخصصات. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="Scan to BIM">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("Scan to BIM")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("خدمة BIM لتحويل المعلومات والرسومات إلى نموذج منسق يمكن استخدامه في المراجعة والتنسيق واستخراج الكميات وربطه بالوقت أو التكلفة حسب النطاق. وفي هذه الصفحة يكون التركيز الخاص على مستوى التفاصيل ونظام الإحداثيات وقواعد التسمية والتنسيق بين التخصصات.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<RadialLayout pCount={4} pDiameter={new RespString("820px","96%")} pOrbit={new RespString("38%","36%")} pCenterSize={new RespString("30%","36%")} pBg={Colors.Gray1} pCenterBg={Colors.BrownDark} pCenterColor={Colors.WhiteOff} pRingColor={Colors.Gray3} pAccent={Colors.Bistage} pCenterTitle="Scan to BIM" pCenterText="مسار الخدمة" pStackPortrait={true}>
		<RadialItem pTitle="المدخلات" pText="تحديد مستوى التفاصيل ومتطلبات النموذج مع مراعاة مستوى التفاصيل ونظام الإحداثيات وقواعد التسمية والتنسيق بين التخصصات" pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<RadialItem pTitle="المعالجة" pText="نمذجة وتنسيق العناصر والبيانات" pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<RadialItem pTitle="المخرج" pText="تسليم النموذج والتقارير أو المخرجات المتفق عليها" pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
		<RadialItem pTitle="الفائدة" pText="يجمع التخصصات في بيئة واحدة ويكشف التعارضات قبل الموقع، ويجعل التعديلات والكميات والوثائق أسهل في التتبع. ويُراجع القرار هنا تحديدًا في ضوء مستوى التفاصيل ونظام الإحداثيات وقواعد التسمية والتنسيق بين التخصصات." pBg={Colors.BistageLite} pColor={Colors.Black} pAccent={Colors.BistageDark} />
	</RadialLayout>

	<AngleBand id="secSrvCost" pBg={Colors.Black} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 7,500 ج.م للمهمة الصغيرة، ويحدد حسب LOD والمساحة والتخصصات.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
