---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, MosaicGrid, MosaicItem } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="حصر الأعمال الكهربائية"
	pDescr="حصر الأعمال الكهربائية — حصر منظم للكميات من الرسومات المتاحة مع فصل البنود والوحدات والملاحظات بما يصلح للتسعير أو المراجعة أو تجهيز المقايسة. وفي هذه الصفحة يكون التركيز الخاص على الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="حصر الأعمال الكهربائية">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("حصر الأعمال الكهربائية")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("حصر منظم للكميات من الرسومات المتاحة مع فصل البنود والوحدات والملاحظات بما يصلح للتسعير أو المراجعة أو تجهيز المقايسة. وفي هذه الصفحة يكون التركيز الخاص على الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<MosaicGrid pColumns={12} pColumnsP={4} pAutoRows={new RespString("82px","70px")} pGap={new RespString("10px","8px")} pPad={new RespString("42px","10px")} pBg={Colors.Gray1}>
		<MosaicItem pColSpan={5} pColSpanP={4} pRowSpan={3} pRowSpanP={2} pBg={Colors.BrownDark} pColor={Colors.WhiteOff}>
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("المخرج الرئيسي")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("تسليم جداول قابلة للتسعير والمراجعة.")} />
		</MosaicItem>
		<MosaicItem pColSpan={3} pColSpanP={2} pRowSpan={2} pRowSpanP={2} pBg={Colors.SkyLite} pColor={Colors.Black}>
			<Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("01")} pText={Text.Body.WithColor(Colors.Black).OfText("مراجعة الرسومات وحدود الحصر مع مراعاة الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة")} />
		</MosaicItem>
		<MosaicItem pColSpan={4} pColSpanP={2} pRowSpan={2} pRowSpanP={2} pBg={Colors.BistageLite} pColor={Colors.Black}>
			<Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("02")} pText={Text.Body.WithColor(Colors.Black).OfText("استخراج وتصنيف الكميات")} />
		</MosaicItem>
		<MosaicItem pColSpan={7} pColSpanP={4} pRowSpan={2} pRowSpanP={2} pBg={Colors.Creamy} pColor={Colors.Black}>
			<Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("لماذا الآن؟")} pText={Text.Body.WithColor(Colors.Black).OfText("يعطي صاحب المشروع أو المقاول قاعدة كمية مستقلة قبل طلب الأسعار ويكشف البنود التي تحتاج تعريفًا أو رسومات إضافية. ويُراجع القرار هنا تحديدًا في ضوء الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة.")} />
		</MosaicItem>
	</MosaicGrid>

	<AngleBand id="secSrvCost" pBg={Colors.Black} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 3,500 ج.م للحزمة الصغيرة، أو يسعر حسب عدد اللوحات والتخصص.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
