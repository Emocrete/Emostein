---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, ScrollShelf, ShelfItem, SideRail } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="حصر أعمال الحريق"
	pDescr="حصر أعمال الحريق — حصر منظم للكميات من الرسومات المتاحة مع فصل البنود والوحدات والملاحظات بما يصلح للتسعير أو المراجعة أو تجهيز المقايسة. وفي هذه الصفحة يكون التركيز الخاص على تصنيف الخطورة ومصدر المياه ومسارات الهروب والتنسيق مع الحماية المدنية. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="حصر أعمال الحريق">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("حصر أعمال الحريق")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("حصر منظم للكميات من الرسومات المتاحة مع فصل البنود والوحدات والملاحظات بما يصلح للتسعير أو المراجعة أو تجهيز المقايسة. وفي هذه الصفحة يكون التركيز الخاص على تصنيف الخطورة ومصدر المياه ومسارات الهروب والتنسيق مع الحماية المدنية.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<SideRail pRailWidth={new RespString("290px","100%")} pGap={new RespString("24px","12px")} pPad={new RespString("42px","12px")} pBg={Colors.Gray1} pRailBg={Colors.BrownDark} pRailColor={Colors.WhiteOff}>
		<Emograph slot="rail" pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("حصر أعمال الحريق")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("يعطي صاحب المشروع أو المقاول قاعدة كمية مستقلة قبل طلب الأسعار ويكشف البنود التي تحتاج تعريفًا أو رسومات إضافية. ويُراجع القرار هنا تحديدًا في ضوء تصنيف الخطورة ومصدر المياه ومسارات الهروب والتنسيق مع الحماية المدنية.")} />
		<ScrollShelf pItemWidth={new RespString("330px","82vw")} pGap={new RespString("14px","10px")} pPad={new RespString("10px","8px")} pBg={Colors.Gray1}>
			<ShelfItem pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("مدخلات")} pText={Text.Body.WithColor(Colors.Black).OfText("مراجعة الرسومات وحدود الحصر مع مراعاة تصنيف الخطورة ومصدر المياه ومسارات الهروب والتنسيق مع الحماية المدنية")} /></ShelfItem>
			<ShelfItem pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("تنسيق")} pText={Text.Body.WithColor(Colors.Black).OfText("استخراج وتصنيف الكميات")} /></ShelfItem>
			<ShelfItem pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark}><Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("تسليم")} pText={Text.Body.WithColor(Colors.Black).OfText("تسليم جداول قابلة للتسعير والمراجعة")} /></ShelfItem>
		</ScrollShelf>
	</SideRail>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 3,500 ج.م للحزمة الصغيرة، أو يسعر حسب عدد اللوحات والتخصص.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
