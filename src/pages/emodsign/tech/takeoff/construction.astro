---
import BLayout from "@/Layout.astro";
import { Text, Topic, ElemBg, EmoMediaData, RespString, Pixel, Size, Align } from "@/TypesLib";
import { Hero, IndexSec, ESec, EmoStrip, Emograph, CardsGr, EmoList, RespImg, EmoCall, EmoBtn, EmoFaq, ReadAlso, RelServices, SecTitle, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="حصر كميات أعمال البناء"
	pDescr="خدمة حصر كميات أعمال البناء والهيكل الخرساني من الرسومات المعمارية والإنشائية، تشمل الحفر والخرسانة العادية والمسلحة والشدات والحديد والمباني والبنود المرتبطة، مع إعداد جداول كميات واضحة للتسعير والمقايسة ومقارنة عروض المقاولين."
	pSchemaImages={[
		"/Media/Emodsign/Tech/Takeoff/Construction/HeroL.webp",
		"https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&fm=jpg&q=70&w=1600"
	]}
>







	<Hero
		pImgF="/Media/Emodsign/Tech/Takeoff/Construction/"
		pTitle="حصر كميات أعمال البناء"
		pDesc="تحويل رسومات المشروع إلى جداول كميات مفهومة: حفر، خرسانة، شدات، حديد، مباني، وبنود بناء قابلة للتسعير والمراجعة قبل التعاقد مع المقاول."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pAlign="right"
		pPosL="18% 50% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب حصر كميات البناء" />

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Img", "/Media/Emodsign/Tech/Takeoff/Construction/", "HeroL.webp")}
		pTitleClr="#ffffff"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="فكرة الحصر"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#ffffff"
			pTextColorHover="#111318"
			pWidth="260px"
			pHeight="44px"
			onclick="location.href='#takeoff-meaning'"
		/>

		<EmoBtn
			pText="بنود البناء"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#ffffff"
			pTextColorHover="#111318"
			pWidth="260px"
			pHeight="44px"
			onclick="location.href='#construction-items'"
		/>

		<EmoBtn
			pText="طريقة العمل"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#ffffff"
			pTextColorHover="#111318"
			pWidth="260px"
			pHeight="44px"
			onclick="location.href='#workflow'"
		/>

		<EmoBtn
			pText="مخرجات الخدمة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#ffffff"
			pTextColorHover="#111318"
			pWidth="260px"
			pHeight="44px"
			onclick="location.href='#deliverables'"
		/>

		<EmoBtn
			pText="أخطاء الحصر"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#ffffff"
			pTextColorHover="#111318"
			pWidth="260px"
			pHeight="44px"
			onclick="location.href='#risk-control'"
		/>

		<EmoBtn
			pText="الأسئلة الشائعة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#ffffff"
			pTextColorHover="#111318"
			pWidth="260px"
			pHeight="44px"
			onclick="location.href='#faq'"
		/>

	</IndexSec>







	<ESec
		id="takeoff-meaning"
		pBg={new ElemBg("#F7F1E6")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="حصر الكميات هو ترجمة الرسومات إلى أرقام قابلة للتعاقد"
			pDesc="الرسومات وحدها لا تكفي لمقارنة عروض المقاولين. المقاول قد يرى في نفس اللوحة بنودًا مختلفة أو يهمل بندًا أو يضع تحفظات واسعة. حصر كميات أعمال البناء يحول الرسومات إلى جداول محددة الوحدات والكميات والملاحظات، بحيث يصبح التسعير مبنيًا على نطاق معروف بدل الانطباع العام عن مساحة المشروع."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(560, "auto", 320, "auto")}
				pTitle={Text.H3.WithColor("#111318").OfText("مشكلة العميل ليست معرفة كمية الخرسانة فقط")}
				pText={Text.Body.WithColor("#333333").OfText("صاحب المشروع يحتاج أن يعرف أين ستذهب أمواله قبل التعاقد. الحصر الجيد لا يكتفي بعدّ الخرسانة والحديد، بل يربط كل كمية بمصدرها في الرسومات، وبندها في جدول الكميات، ووحدتها، وملاحظات القياس، وما إذا كانت الكمية صالحة للتسعير أو تحتاج رسومات أكثر تفصيلًا. لذلك تصبح خدمة الحصر أداة قرار مالي وفني وليست عملية حسابية معزولة.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"مكتب هندسي يراجع رسومات ومخططات قبل إعداد حصر كميات البناء",
					new Size(560, "auto", 320, "auto")
				)}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#0E1118")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تحتاج حصر كميات أعمال البناء؟"
			pDesc="حصر الكميات مفيد قبل التنفيذ، قبل التعاقد، قبل شراء الخامات، وعند مراجعة عرض مقاول. كل مرحلة تستخدم الحصر بطريقة مختلفة، لكن الهدف المشترك هو تقليل الغموض المالي والفني."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("أسباب طلب حصر البناء")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("قبل طلب عروض المقاولين", "تجهيز جدول كميات موحد يرسل لأكثر من مقاول، حتى تصبح المقارنة على نفس البنود والكميات بدل أن يضع كل مقاول نطاقًا مختلفًا.")}
			pTopic2={new Topic("قبل شراء الخامات", "تحديد كميات تقريبية أو تفصيلية للحديد والأسمنت والسن والرمل والطوب حسب مستوى الرسومات، مع فصل كميات التنفيذ عن الهالك أو الاحتياطي التجاري.")}
			pTopic3={new Topic("عند مراجعة عرض مقاول", "فحص بنود العرض والكميات والأسعار لمعرفة هل المقاول أهمل بندًا، بالغ في كمية، جمع بنودًا غير متجانسة، أو وضع سعرًا منخفضًا مع نطاق ناقص.")}
			pTopic4={new Topic("عند ضبط ميزانية المشروع", "ربط الرسومات بتقدير مالي أوضح، خصوصًا في الهيكل الخرساني حيث تظهر فروق كبيرة بسبب النظام الإنشائي والبحور وكمية الحديد والشدات.")}
		/>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#0E1118")}
		pSize={new Size("100%", "auto", "100%", "auto")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(1200, "auto", "calc(100% - 20px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("محتوى الصفحة مبني حول وظيفة الحصر في السوق الفعلي")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("خدمات الحصر العالمية تعرض القيمة عادة في تحويل الرسومات والمواصفات إلى كميات قابلة للتسعير، وإعداد جداول تفصيلية تساعد في المناقصات والميزانية وشراء الخامات وإدارة التكلفة. لذلك تم بناء الصفحة على هذه الوظائف لا على تعريف قصير للخدمة.")}
				pSize={new Size(1000, "auto", 320, "auto")}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("ماذا يفعل الحصر في القرار التجاري؟")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("الحصر لا يمنع التفاوض، لكنه يجعل التفاوض مبنيًا على كمية وبند ووحدة وملاحظة بدل رقم إجمالي غامض.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={false}
				pItems={[
					"يفصل بين سعر المتر العام وسعر البنود الفعلية داخل المشروع.",
					"يكشف البنود التي لا تظهر في المساحة مثل الشدات والنجارة والردم والنقل والهالك.",
					"يجعل عروض المقاولين قابلة للمقارنة لأن كل عرض يرد على نفس الجدول.",
					"يساعد في التخطيط لشراء الخامات على مراحل بدل شراء كميات عشوائية.",
					"يفصل بين كمية التصميم وكمية التنفيذ وما يحتاج مراجعة أو اعتمادًا إضافيًا.",
					"يعطي المالك أساسًا للتفاوض مع المقاول دون الدخول في تفاصيل لا يملك أدوات مراجعتها."
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1541888946425-d81bb19240f5?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"موقع بناء ورافعات كمثال على ارتباط الحصر بالتنفيذ والتكلفة",
					new Size(560, "auto", 320, "auto")
				)}
			/>

		</HzStack>

	</EmoStrip>







	<ESec
		id="construction-items"
		pBg={new ElemBg("#FFFFFF")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="ما الذي يدخل في حصر أعمال البناء؟"
			pDesc="نطاق أعمال البناء يختلف من مشروع لآخر، لكنه غالبًا يدور حول الهيكل الخرساني والبنود التي تسبقه وتتبعه مباشرة. يتم تحديد النطاق قبل بدء الحصر حتى لا تختلط بنود البناء ببنود التشطيب أو الأعمال الكهروميكانيكية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("بنود رئيسية في حصر البناء")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("الحفر والردم والإحلال", "حصر كميات الحفر والردم والإحلال والرفع والنقل حسب المناسيب والقطاعات، مع توضيح الافتراضات عندما لا تكون بيانات الجسات أو المناسيب كاملة.")}
			pTopic2={new Topic("الخرسانة العادية", "حصر فرشة النظافة أو الخرسانة العادية أسفل القواعد والميدات والعناصر التمهيدية، مع وحدات القياس المناسبة وسمك الطبقات.")}
			pTopic3={new Topic("الخرسانة المسلحة", "حصر القواعد والميدات والرقاب والأعمدة والكمرات والبلاطات والسلالم والخزانات والعناصر الخاصة حسب الرسومات الإنشائية.")}
			pTopic4={new Topic("حديد التسليح", "حصر أوزان الحديد أو أطواله حسب مستوى التفصيل المتاح، مع فصل الأقطار والعناصر وملاحظات الوصلات والتراكبات والهالك عند الحاجة.")}
			pTopic5={new Topic("الشدات والنجارة", "حصر مساحات الشدات للعناصر الخرسانية عند الحاجة، لأن تكلفة الشدة قد تؤثر بقوة في المشاريع ذات الأسقف المتكررة أو العناصر الخاصة.")}
			pTopic6={new Topic("المباني والطوب", "حصر الحوائط الخارجية والداخلية والبارابيت والمناور والفتحات حسب المساقط والقطاعات، مع فصل السماكات وأنواع الطوب إن وجدت.")}
		/>

	</ESec>







	<ESec pBg={new ElemBg("#F7F1E6")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="وحدات القياس التي تظهر في جدول الكميات"
			pDesc="قيمة الحصر لا تكتمل إلا بوحدة صحيحة. تغيير الوحدة يغير طريقة التسعير بالكامل؛ فالمتر المكعب ليس مترًا مسطحًا، والطن ليس عددًا، والبند المقطوعية لا يراجع مثل البنود المقاسة."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("575px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("وحدات بنود الحجم والمساحة")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("متر مكعب", "يستخدم عادة في الحفر والردم والإحلال والخرسانة، لأن البند يعتمد على طول وعرض وعمق أو سمك.")}
				pTopic2={new Topic("متر مسطح", "يستخدم في الشدات وبعض أعمال العزل أو الطبقات، لأن البند يعتمد على مساحة سطح ظاهرة أو منفذة.")}
				pTopic3={new Topic("متر طولي", "يستخدم في بعض البنود الخطية مثل الميدات الصغيرة أو الكوابيل أو فواصل معينة أو عناصر محصورة بطول.")}
			/>

			<CardsGr
				pWidth={new RespString("575px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("وحدات بنود العدد والوزن")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("طن أو كيلوجرام", "يستخدم في حصر حديد التسليح عند تحويل الأطوال والأقطار إلى أوزان، وقد يفصل حسب قطر السيخ أو العنصر.")}
				pTopic2={new Topic("عدد", "يستخدم في العناصر المتكررة المحددة مثل قواعد معدنية أو أبواب مؤقتة أو عناصر تركيب منفصلة إن دخلت ضمن نطاق الحصر.")}
				pTopic3={new Topic("بند مقطوعية", "يستخدم عند وجود أعمال عامة أو تحضيرية لا يمكن قياسها بدقة من الرسومات وحدها، ويجب وصفه بوضوح شديد.")}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="حصر الهيكل الخرساني خطوة بخطوة"
			pDesc="أعمال الخرسانة المسلحة هي قلب خدمة حصر البناء، لأنها تجمع كميات خرسانة وحديد وشدات، وتتأثر بالنظام الإنشائي وارتفاعات الأدوار والبحور وعدد النماذج المتكررة وتفاصيل السلم والبدروم والسطح."
		/>

		<EmoList
			pWidth={new RespString("1200px", "340px")}
			pTitle={Text.H3.WithColor("#111318").OfText("مراحل حصر الخرسانة والحديد")}
			pDesc={Text.Body.WithColor("#333333").OfText("يتم التعامل مع كل عنصر إنشائي كحالة قياس مستقلة، ثم تجمع النتائج في ملخصات قابلة للمراجعة.")}
			pHeadBg={new ElemBg("#F7F1E6")}
			pItemsBg={new ElemBg("#FFFFFF")}
			pNumbered={true}
			pItems={[
				{ Title: "مراجعة اللوحات", Items: ["تجميع اللوحات المعمارية والإنشائية، التأكد من أحدث إصدار، ومراجعة المحاور والمناسيب والجداول والقطاعات قبل بدء القياس."] },
				{ Title: "فصل العناصر", Items: ["تقسيم المشروع إلى حفر، قواعد، ميدات، رقاب أعمدة، أعمدة، كمرات، بلاطات، سلالم، خزانات، وحوائط إن وجدت."] },
				{ Title: "حساب الخرسانة", Items: ["استخراج أحجام العناصر بالمتر المكعب مع توضيح طريقة التعامل مع التداخلات والفتحات والتكرارات."] },
				{ Title: "حساب الشدات", Items: ["حصر الأسطح التي تحتاج نجارة وشدة عند إدراج هذا البند ضمن الخدمة، مع فصل الأسطح الرأسية والأفقية إذا احتاج التسعير ذلك."] },
				{ Title: "حساب الحديد", Items: ["استخراج الحديد من الجداول أو الرسومات أو النسب التقديرية حسب مستوى البيانات، مع توضيح درجة الدقة والافتراضات."] },
				{ Title: "تجميع الملخص", Items: ["إعداد ملخص عام للكميات حسب الدور أو العنصر أو البند، ثم تجهيز جدول قابل للتسعير والمراجعة."] }
			]}
		/>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size("100%", "auto", "100%", "auto")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#111318")}
			pSize={new Size(1200, "auto", "calc(100% - 20px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#F4E5C4").OfText("حصر الحديد يحتاج وضوحًا في مستوى الدقة")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("حديد التسليح من أكثر البنود حساسية لأن الفارق بين الحصر التقديري والحصر التفصيلي قد يظهر بقوة في الشراء والتعاقد. لذلك لا يتم تقديم كمية الحديد كرقم مطلق دون شرح مصدرها: جداول تسليح، لوحات تفصيلية، نسب تقريبية، أو مراجعة تنفيذية.")}
				pSize={new Size(1000, "auto", 320, "auto")}
			/>

		</EmoStrip>

