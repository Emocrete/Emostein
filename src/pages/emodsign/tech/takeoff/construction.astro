---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Align, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";

const cInk = "#111318";
const cCream = "#F7F1E6";
const cPaper = "#FFF9ED";
---





<BLayout
	pSchemaType="Service"
	pTitle="حصر كميات أعمال البناء"
	pDescr="خدمة حصر كميات أعمال البناء والهيكل الخرساني من الرسومات المعمارية والإنشائية، تشمل الحفر والخرسانة العادية والمسلحة والشدات والحديد والمباني والبنود المرتبطة، مع إعداد جداول كميات واضحة للتسعير والمقايسة ومقارنة عروض المقاولين."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("57%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("حصر كميات أعمال البناء")}
				pText={Text.Body.Centered.OfText("خدمة حصر كميات أعمال البناء والهيكل الخرساني من الرسومات المعمارية والإنشائية، تشمل الحفر والخرسانة العادية والمسلحة والشدات والحديد والمباني والبنود المرتبطة، مع إعداد جداول كميات واضحة للتسعير والمقايسة ومقارنة عروض المقاولين.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec
		id="scope-map"
		pBg={new ElemBg(cCream)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle pTitle="بنود الحصر" />

		<CardsGr
			pCardBg={new ElemBg(cPaper)}
			pCardRadius={new Pixel(22, 18)}
			pCardTitleFnt={Text.H4.WithColor(cInk)}
			pCardBodyFnt={Text.Body.WithColor("#333842")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("الحفر والردم", "حساب كميات الحفر، الإحلال، الردم، التسوية، والفرق بين منسوب الأرض الطبيعية ومنسوب التأسيس حسب اللوحات المتاحة.")}
			pTopic2={new Topic("الخرسانة العادية", "حصر فرشة النظافة والخرسانة العادية أسفل القواعد والسملات واللبشات وأي طبقات تأسيس مرتبطة.")}
			pTopic3={new Topic("الخرسانة المسلحة", "حصر القواعد، اللبشة، الأعمدة، الكمرات، البلاطات، السلالم، الحوائط الخرسانية، والسدادات بوحدة المتر المكعب.")}
			pTopic4={new Topic("حديد التسليح", "تفريغ عدد الأسياخ وأقطارها وأطوالها، وتحويل الطول إلى وزن إجمالي لكل عنصر أو بند حسب جداول الأوزان.")}
			pTopic5={new Topic("الشدات والنجارة", "تقدير مسطحات الشدات للأعمدة والكمرات والبلاطات والحواف والعناصر الخاصة إذا كانت ضمن نطاق الخدمة.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#0E1118")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تحتاج حصر كميات أعمال البناء؟"
			pDesc="حصر الكميات مفيد قبل التنفيذ، قبل التعاقد، قبل شراء الخامات، وعند مراجعة عرض مقاول. كل مرحلة تستخدم الحصر بطريقة مختلفة، لكن الهدف المشترك هو تقليل الغموض المالي والفني."
		/>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("أسباب طلب حصر البناء")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("قبل طلب عروض المقاولين", "تجهيز جدول كميات موحد يرسل لأكثر من مقاول، حتى تصبح المقارنة على نفس البنود والكميات بدل أن يضع كل مقاول نطاقًا مختلفًا.")}
			pTopic2={new Topic("قبل شراء الخامات", "تحديد كميات تقريبية أو تفصيلية للحديد والأسمنت والسن والرمل والطوب حسب مستوى الرسومات، مع فصل كميات التنفيذ عن الهالك أو الاحتياطي التجاري.")}
			pTopic3={new Topic("عند مراجعة عرض مقاول", "فحص بنود العرض والكميات والأسعار لمعرفة هل المقاول أهمل بندًا، بالغ في كمية، جمع بنودًا غير متجانسة، أو وضع سعرًا منخفضًا مع نطاق ناقص.")}
			pTopic4={new Topic("عند ضبط ميزانية المشروع", "ربط الرسومات بتقدير مالي أوضح، خصوصًا في الهيكل الخرساني حيث تظهر فروق كبيرة بسبب النظام الإنشائي والبحور وكمية الحديد والشدات.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="كيف يساعد الحصر في مقارنة عروض المقاولين؟"
			pDesc="عند إرسال الرسومات فقط، قد يعود كل مقاول بعرض مختلف في البنود والشروط والتحفظات. أما عند إرسال جدول كميات موحد، يصبح الفرق الحقيقي أوضح: سعر وحدة، طريقة تنفيذ، خامة، مدة، أو نطاق خدمة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("بدون جدول كميات")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("عروض غير متجانسة", "كل مقاول يضع بنودًا مختلفة ويقارن نفسه بغيره على أساس غير ثابت.")}
				pTopic2={new Topic("تحفظات كثيرة", "المقاول قد يستبعد بنودًا غير واضحة ثم تظهر لاحقًا كتغير سعر أو مطالبة إضافية.")}
				pTopic3={new Topic("صعوبة التفاوض", "صاحب المشروع يتفاوض على رقم إجمالي دون معرفة أين توجد الزيادة أو النقص.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("مع جدول كميات")}
				pCardBg={new ElemBg("#111318")}
				pCardTitleFnt={Text.H4.WithColor("#D9B86C")}
				pCardBodyFnt={Text.Body.WithColor("#F8F4EA")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("نطاق موحد", "كل مقاول يضع سعره على نفس البنود والكميات، فتظهر فروق الأسعار لا فروق الفهم.")}
				pTopic2={new Topic("كشف البنود الناقصة", "أي بند لم يسعر أو تحفظ عليه المقاول يظهر بوضوح قبل التعاقد.")}
				pTopic3={new Topic("قرار أقوى", "المالك يستطيع معرفة هل العرض الأرخص أرخص فعلًا أم ناقص بنودًا مؤثرة.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل الحصر يشمل الخرسانة والحديد فقط؟"
			pAnswer="يمكن تنفيذ الحصر كخرسانة وحديد فقط، أو كحصر بناء أوسع يشمل الحفر والردم والشدات والمباني والبنود المرتبطة. يتم تحديد النطاق قبل البدء حتى لا تختلط البنود."
		/>

		<FaqItem
			pQuestion="هل يمكن عمل حصر مبدئي قبل اكتمال كل الرسومات؟"
			pAnswer="نعم، لكن يتم تمييزه كتقديري مع توضيح الافتراضات والنواقص. الحصر التفصيلي يحتاج رسومات تنفيذية ومواصفات أوضح حتى تكون الكمية صالحة للتسعير والمراجعة النهائية."
		/>

		<FaqItem
			pQuestion="هل يتم خصم الفتحات والفراغات من كميات الخرسانة؟"
			pAnswer="يتم التعامل مع الخصومات حسب قواعد القياس وحجم الفتحة وتأثيرها على البند. المهم أن يوضح التقرير ما تم خصمه وما لم يتم خصمه حتى لا يحدث خلاف أثناء المراجعة."
		/>

		<FaqItem
			pQuestion="ما فائدة الحصر عند مقارنة عروض المقاولين؟"
			pAnswer="عندما يرسل المالك جدول كميات موحدًا لأكثر من مقاول، تصبح المقارنة على نفس البنود والكميات. هذا يقلل فروق العروض الناتجة عن إهمال بند أو تغيير نطاق العمل أو إدخال تحفظات غير واضحة."
		/>

		<FaqItem
			pQuestion="هل يمكن ربط الكميات بتحليل أسعار؟"
			pAnswer="نعم، بعد تجهيز الكميات يمكن ربطها بتحليل أسعار البنود للوصول إلى تقدير تكلفة أقرب للواقع، أو استخدامها لمراجعة أسعار المقاولين ومعرفة البنود ذات التأثير الأكبر على الميزانية."
		/>

		<FaqItem
			pQuestion="هل حصر كميات البناء يشمل الأسعار؟"
			pAnswer="الحصر في أساسه يحدد الكميات والوحدات والبنود. يمكن إضافة التسعير أو تجهيز مقايسة مسعرة كخدمة إضافية إذا كان المطلوب معرفة التكلفة التقريبية أو مقارنة عروض المقاولين."
		/>

		<FaqItem
			pQuestion="هل يمكن الحصر من PDF فقط؟"
			pAnswer="يمكن الحصر من PDF إذا كان واضحًا ومضبوط المقاس ويحتوي الأبعاد والقطاعات والجداول اللازمة. وجود ملف CAD يساعد في القياس، لكنه لا يعوض نقص التفاصيل الفنية."
		/>

		<FaqItem
			pQuestion="هل الحصر يصلح لشراء الحديد مباشرة؟"
			pAnswer="يتوقف ذلك على مستوى الرسومات وطريقة الحصر. إذا كان الحصر تفصيليًا من جداول تسليح ورسومات واضحة يمكن استخدامه كأساس شراء مع إضافة الهالك والاحتياطي حسب الاتفاق. أما الحصر المبدئي فلا يستخدم كأمر شراء نهائي."
		/>

		<FaqItem
			pQuestion="ما الفرق بين حصر الخرسانة وحصر الحديد؟"
			pAnswer="حصر الخرسانة يعتمد غالبًا على أحجام العناصر بالمتر المكعب. حصر الحديد يحتاج أقطارًا وأطوالًا وتفاصيل تسليح وتراكبات وتشكيلًا، لذلك تكون درجة دقته مرتبطة بجودة اللوحات الإنشائية."
		/>

		<FaqItem
			pQuestion="هل يتم حصر الشدات والنجارة؟"
			pAnswer="يمكن إدراج الشدات ضمن نطاق الخدمة عند الحاجة. لا يتم افتراضها تلقائيًا داخل حصر الخرسانة والحديد إلا إذا تم الاتفاق على ذلك."
		/>

		<FaqItem
			pQuestion="هل يشمل الحصر أعمال الطوب والمباني؟"
			pAnswer="يمكن أن يشمل حصر المباني والطوب ضمن أعمال البناء عند وجود مساقط وقطاعات وفتحات واضحة. يتم فصل السماكات والأنواع إذا كانت الرسومات تحددها."
		/>

		<FaqItem
			pQuestion="هل يصلح الحصر لمقارنة المقاولين؟"
			pAnswer="نعم، وهذه من أهم وظائفه. يتم تجهيز جدول موحد يرسل للمقاولين لإضافة أسعارهم، وبذلك تصبح المقارنة بين أسعار الوحدات والتحفظات لا بين عروض مختلفة النطاق."
		/>

		<FaqItem
			pQuestion="هل يمكن مراجعة عرض مقاول موجود بالفعل؟"
			pAnswer="نعم. تتم مراجعة البنود والكميات والوحدات والتحفظات ومقارنتها بالرسومات، ثم توضيح البنود الناقصة أو غير الواضحة أو المجمعة بطريقة قد تسبب خلافًا لاحقًا."
		/>

		<FaqItem
			pQuestion="هل الحصر يغني عن التصميم الإنشائي؟"
			pAnswer="لا. الحصر يعتمد على التصميم ولا يحل محله. إذا كانت الرسومات الإنشائية ناقصة أو غير واضحة، فالحل هو استكمال التصميم أو الشوب دروينج قبل طلب كمية تنفيذية دقيقة."
		/>

		<FaqItem
			pQuestion="ما الملفات التي أرسلها لبدء الخدمة؟"
			pAnswer="أرسل المساقط المعمارية واللوحات الإنشائية والقطاعات والجداول وأحدث نسخة من الرسومات، ووضح هل الغرض ميزانية أو تسعير أو شراء خامات أو مراجعة عرض مقاول."
		/>

		<FaqItem
			pQuestion="هل يتم تسليم ملف Excel؟"
			pAnswer="يمكن تسليم جدول الكميات بصيغة Excel أو PDF حسب الاتفاق. غالبًا يكون Excel أنسب إذا كان المطلوب إضافة أسعار المقاولين أو تعديل البنود لاحقًا."
		/>

		<FaqItem
			pQuestion="هل يمكن تحديث الحصر بعد تعديل الرسومات؟"
			pAnswer="نعم، بشرط تحديد التعديلات والإصدار الجديد. إذا كان الجدول الأصلي منظمًا حسب البنود والعناصر، يكون تحديثه أسرع من إعادة العمل من البداية."
		/>

		<FaqItem
			pQuestion="ما مدة إعداد حصر كميات البناء؟"
			pAnswer="المدة تعتمد على مساحة المشروع وعدد الأدوار ومستوى التفصيل وحالة الرسومات. في المشاريع الصغيرة قد يكون الحصر أسرع، بينما المشاريع متعددة الأدوار أو ذات التفاصيل الإنشائية الكثيفة تحتاج وقت مراجعة أطول."
		/>

		<FaqItem
			pQuestion="هل يتم احتساب الهالك؟"
			pAnswer="الهالك ليس جزءًا واحدًا ثابتًا لكل البنود. يمكن إضافة هالك أو احتياطي عند تجهيز كميات شراء، أما جدول الحصر الصافي فيعرض الكمية المستخرجة من الرسومات غالبًا."
		/>

		<FaqItem
			pQuestion="هل يمكن حصر مبنى قائم بدون رسومات؟"
			pAnswer="يمكن عمل رفع ومعاينة ثم حصر تقريبي أو تفصيلي حسب إمكانية الوصول للعناصر. لكن حصر الهيكل المخفي في مبنى قائم بدون رسومات إنشائية يكون محدود الدقة ويحتاج تحفظات واضحة."
		/>

		<FaqItem
			pQuestion="هل يتم اعتماد الحصر من جهة رسمية؟"
			pAnswer="الحصر خدمة فنية لإعداد أو مراجعة الكميات. أي اعتماد رسمي أو ختم أو استخدام تعاقدي خاص يجب الاتفاق عليه صراحة حسب الجهة والغرض والمسؤولية المطلوبة."
		/>

	</EmoFaq>







	<RelServices>

		<RelServiceItem
			pTitle="حصر كميات التشطيبات"
			pDesc="عند الانتقال من الهيكل إلى الخامات النهائية: أرضيات، حوائط، أسقف، دهانات، أبواب، وكهرباء نهائية."
			pHref="/emodsign/tech/takeoff/finishing"
		/>

		<RelServiceItem
			pTitle="الشوب دروينج الإنشائي"
			pDesc="تفاصيل تنفيذية تساعد على وضوح التسليح والعناصر قبل الحصر أو التنفيذ."
			pHref="/emodsign/tech/shopdwg/struc"
		/>

	</RelServices>







</BLayout>
