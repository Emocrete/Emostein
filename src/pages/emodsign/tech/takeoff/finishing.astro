				<ListItem pText="يمكن تسليم المسطحات فقط أو حصر مكونات النظام بالكامل للتوريد والتنفيذ." />

			</EmoList>

		</ZigzagItem>

		<ZigzagItem
			pMediaShare={49}
			pBg="#FFFDF8"
			pMediaBg="#DDD5C7"
			pRadius={new RespString("42px", "24px")}
			pMediaRadius={new RespString("42px", "20px")}
			pMinHeight={new RespString("600px", "820px")}
			pMediaMinHeight={new RespString("450px", "350px")}
		>

			<MosaicGrid
				slot="media"
				pColumns={6}
				pColumnsP={4}
				pAutoRows={new RespString("72px", "62px")}
				pGap={new RespString("10px", "8px")}
				pPad={new RespString("14px", "10px")}
				pMinHeight={new RespString("430px", "330px")}
				pMaxWidth={new RespString("100%", "100%")}
				pBg="#D8D0C3"
				pRadius={new RespString("32px", "18px")}
			>

				<MosaicItem
					pColSpan={4}
					pColSpanP={4}
					pRowSpan={3}
					pRowSpanP={2}
					pBg="linear-gradient(145deg, #F1EEE8, #C9C4BB)"
				>

					<Emograph
						pTitle={Text.H3.Centered.WithColor("#2F3334").OfText("أرضيات وكسوات")}
						pText={Text.Body.Centered.WithColor("#555A5A").OfText("ألواح · قطع · اتجاه عروق")}
					/>

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={2}
					pRowSpan={2}
					pRowSpanP={2}
					pBg="#AFA89C"
				>

					<Emograph pTitle={Text.H4.Centered.WithColor("#FFFFFF").OfText("درج")} pText={Text.Body.Centered.WithColor("#F0EDE7").OfText("قوائم · نوايم")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={2}
					pRowSpan={2}
					pRowSpanP={2}
					pBg="#575A58"
				>

					<Emograph pTitle={Text.H4.Centered.WithColor("#FFFFFF").OfText("وزرات")} pText={Text.Body.Centered.WithColor("#E5E4DE").OfText("مقاس · سمك")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={3}
					pColSpanP={2}
					pRowSpan={2}
					pRowSpanP={2}
					pBg="#E7DED0"
				>

					<Emograph pTitle={Text.H4.Centered.WithColor("#343838").OfText("عتب وجلسات")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={3}
					pColSpanP={2}
					pRowSpan={2}
					pRowSpanP={2}
					pBg="#C5B69F"
				>

					<Emograph pTitle={Text.H4.Centered.WithColor("#343838").OfText("كاونترات")} />

				</MosaicItem>

			</MosaicGrid>

			<Emograph
				pTitle={Text.H2.WithColor("#111820").OfText("حصر الرخام والجرانيت والحجر الطبيعي")}
				pText={Text.Body.WithColor("#465157").OfText("هنا المساحة وحدها لا تكفي. السعر يتأثر بنوع الخامة والسمك والمقاسات وعدد القطع واتجاه العروق والحليات والتلميع وطريقة التقطيع، لذلك الحصر يُجهز بصورة تصلح للتسعير والتوريد الفعلي.")}
			/>

			<EmoList
				pWidth={new RespString("100%", "100%")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#283238")}
				pNumbered={false}
			>

				<ListItem pText="أرضيات، كسوات حوائط، وزرات، عتب، جلسات، أكتاف، برور، حليات، مداخل وترابيع مصاعد." />

				<ListItem pText="درج: قوائم، نوايم، بسطات، صدور وحواف، مع فصل المقاسات والسمك لكل قطعة." />

				<ListItem pText="كاونترات مطابخ وحمامات، أحواض، قطع خاصة، بانوهات وترابيع زخرفية." />

				<ListItem pText="فصل النوع واللون والسمك والتشطيب السطحي والمقاس ومكان التركيب والهالك المتوقع." />

			</EmoList>

		</ZigzagItem>

	</ZigzagStory>







	<SideRail
		id="full-finishing-map"
		pRailWidth={new RespString("270px", "100%")}
		pGap={new RespString("28px", "14px")}
		pPad={new RespString("42px", "14px")}
		pBg="#E9ECE8"
		pRailBg="linear-gradient(180deg, #172229, #354840)"
		pRailColor="#F7F4ED"
		pSticky={true}
	>

		<Emograph
			slot="rail"
			pTitle={Text.H2.WithColor("#F7F4ED").OfText("الخريطة الكاملة لبنود حصر التشطيبات")}
			pText={Text.Body.WithColor("#D5DDD8").OfText("أي بند له وحدة قياس وكمية ومواصفة ويمكن تسعيره أو توريده أو تنفيذه يدخل ضمن نطاق حصر التشطيبات. القائمة التالية تجمع الفئات الرئيسية بدون اختزالها في نوعين أو ثلاثة.")}
		/>

