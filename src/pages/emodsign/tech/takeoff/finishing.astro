---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoSec, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="حصر كميات أعمال التشطيبات"
	pDescr="خدمة حصر كميات التشطيبات من الرسومات وجداول التشطيب والموقع، تشمل المحارة والجبس بورد والكرانيش والسيراميك والبورسلين والرخام والدهانات والأبواب والشبابيك والأعمال الصحية والكهربائية النهائية، مع إعداد جداول كميات واضحة للتسعير وشراء الخامات ومقارنة عروض المقاولين."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("57%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("حصر كميات أعمال التشطيبات")}
				pText={Text.Body.Centered.OfText("خدمة حصر كميات التشطيبات من الرسومات وجداول التشطيب والموقع، تشمل المحارة والجبس بورد والكرانيش والسيراميك والبورسلين والرخام والدهانات والأبواب والشبابيك والأعمال الصحية والكهربائية النهائية، مع إعداد جداول كميات واضحة للتسعير وشراء الخامات ومقارنة عروض المقاولين.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec
		id="takeoff-meaning"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			pTitle="حصر التشطيبات يبدأ من تفاصيل السطح النهائي"
			pDesc="أعمال التشطيبات لا تقاس مثل الهيكل الخرساني. هنا تتحول اختلافات الخامات والألوان والمقاسات وطريقة التركيب إلى كميات وبنود وملاحظات. نفس الغرفة قد تحتوي أرضية مختلفة، وزرة، وزخرفة جبس، ودهانين مختلفين، وبانوهات، ووحدات إنارة، وباب خاص، وكل ذلك يحتاج قراءة منفصلة حتى لا يتحول عرض المقاول إلى رقم إجمالي غامض."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("ما الذي يختلف في حصر التشطيبات؟")}
				pText={Text.Body.WithColor("#333333").OfText("حصر التشطيبات يتعامل مع بنود كثيرة صغيرة التأثير منفردة وكبيرة التأثير عند جمعها. متر السيراميك ليس رقم مساحة فقط، بل نوع مقاس، اتجاه تركيب، وزرة، هالك، قطع، خامات لاصقة، منطقة رطبة أو جافة، وتداخل مع الأبواب والعتبات. متر الدهانات يرتبط بتحضير السطح والمعجون والبرايمر وعدد الأوجه ونوع الدهان. لذلك قيمة الحصر تظهر عندما يفصل البنود بدل جمعها تحت بند تشطيب عام.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com",
					"photo-1586023492125-27b2c045efd7?auto=format&fit=crop&fm=jpg&q=70&w=1200",
					false,
					"حصر كميات التشطيبات داخل مشروع تصميم داخلي",
					new Size(new NumPer(560, 320), new NumPer(360, 220))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="finishing-items"
		pBg={new ElemBg("#111318")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="بنود التشطيبات التي تدخل في الحصر"
			pDesc="تصنيف البنود هو بداية الحصر الصحيح. كل مجموعة لها وحدة قياس وطريقة قراءة مختلفة، لذلك يتم تقسيم التشطيبات إلى أرضيات وحوائط وأسقف وفتحات وأعمال نهائية بدل رقم إجمالي واحد."
		/>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("خريطة بنود التشطيبات")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("أرضيات", "سيراميك، بورسلين، رخام، جرانيت، باركيه، فينيل، إيبوكسي، وزرات، عتبات، فواصل تمدد، ونهايات عند الأبواب والمناسيب.")}
			pTopic2={new Topic("حوائط", "محارة، معجون، دهانات، تكسيات حجر أو خشب أو بدائل، سيراميك حمامات ومطابخ، بانوهات، ورق حائط، وحوائط رطبة.")}
			pTopic3={new Topic("أسقف", "جبس بورد، جبس بلدي، كرانيش، بيت نور، أسقف معدنية أو مودرن، فتحات سبوتات، فتحات تكييف، ومناطق صيانة.")}
			pTopic4={new Topic("فتحات", "أبواب، شبابيك، حلوق، إكسسوارات، زجاج، قطاعات ألومنيوم، عتب، وشنايش أو فتحات مرتبطة بالتشطيب.")}
			pTopic5={new Topic("تشطيبات صحية", "أطقم صحية، خلاطات، إكسسوارات، مرايات، كبائن شاور، صرف أرضيات، تغليف مواسير، ومراجعة عدد النقاط مع اللوحات.")}
			pTopic6={new Topic("تشطيبات كهرباء", "مفاتيح وبرايز، سبوتات، بروفيلات إضاءة، نجف، شرائط ليد، مخارج إنترنت وتلفزيون، ولوحات ديكورية إن وجدت.")}
			pTopic7={new Topic("نجارة ومعادن", "أبواب خشب، وحدات ثابتة، درابزين، كسوات، تجاليد، قطاعات معدنية، هاندريل، وإكسسوارات نهائية.")}
			pTopic8={new Topic("بنود حماية وتسليم", "حماية أرضيات، تنظيف نهائي، تحميل مخلفات، تغطيات، اختبارات، وملاحظات استلام قبل تسليم المساحة.")}
		/>

	</EmoSec>







	<EmoSec
		id="measurement-units"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="وحدات القياس في حصر التشطيبات"
			pDesc="نفس خامة التشطيب قد تقاس بمتر مسطح أو متر طولي أو عدد أو مقطوعية حسب موضعها وطريقة تركيبها. لذلك تعتمد جودة الحصر على اختيار الوحدة المناسبة قبل إدخال الكمية."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("كيف نختار وحدة القياس؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("القياس ليس خطوة حسابية فقط، بل قرار تعاقدي يحدد طريقة التسعير والمراجعة لاحقًا.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={true}
				pItems={[
					{ Title: "المتر المسطح", Items: [
						"الأرضيات، الدهانات، المحارة، التكسيات، السيراميك، البورسلين، الرخام، الجبس بورد المسطح، وورق الحائط.",
						"يحتاج تحديد طريقة الخصم: فتحات الأبواب والشبابيك، المناطق الصغيرة، البروزات، والحوائط ذات الارتفاعات المختلفة.",
					] },
					{ Title: "المتر الطولي", Items: [
						"الوزرات، الكرانيش، البروفيلات، حليات الجبس، درابزينات، كوابيل، حواف السلالم، وشرائط الإضاءة.",
						"يحتاج فصل النوع والمقاس لأن متر وزرة رخام يختلف عن متر وزرة سيراميك أو خشب أو ألمنيوم.",
					] },
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("بنود لا تكفيها المساحة")}
				pDesc={Text.Body.WithColor("#333333").OfText("الكثير من تكلفة التشطيبات تظهر في الأطراف والنهايات والإكسسوارات، لا في المساحات الكبيرة وحدها.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={true}
				pItems={[
					{ Title: "العدد", Items: [
						"الأبواب، الشبابيك، الخلاطات، الأحواض، المراحيض، السخانات، السبوتات، وحدات الإضاءة، الإكسسوارات، والمفاتيح.",
						"العدد وحده غير كافٍ عند اختلاف المقاس أو النوع أو الموديل أو طريقة التركيب.",
					] },
					{ Title: "البند أو المقطوعية", Items: [
						"التنظيف النهائي، حماية الأرضيات، نقل المخلفات، فتحات صيانة خاصة، أعمال صغيرة متفرقة، وتجهيزات لا تقاس بسهولة.",
						"يجب وصف البند جيدًا حتى لا يتحول إلى باب خلاف بين العميل والمقاول.",
					] },
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			pTitle="ماذا نحتاج منك قبل بدء الحصر؟"
			pDesc="حصر التشطيبات يعتمد على الرسومات والمواصفات والصور والقرار التجاري المطلوب من الحصر. الملف الذي يصلح للشراء قد يختلف في تفصيله عن الملف المستخدم لمراجعة عرض مقاول."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("ملفات فنية")}
				pDesc={Text.Body.WithColor("#333333").OfText("كلما زادت تفاصيل الملفات زادت دقة فصل البنود والكميات.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={false}
				pItems={[
					"المساقط المعمارية النهائية أو شبه النهائية بصيغة واضحة.",
					"واجهات داخلية أو Elevations للحوائط المهمة عند وجود تكسيات أو بانوهات.",
					"جدول تشطيبات يحدد نوع الأرضية والحوائط والسقف لكل فراغ.",
					"تفاصيل الحمامات والمطابخ ومناطق السيراميك والرخام والبورسلين.",
					"مخططات الجبس بورد أو الأسقف الساقطة ومواقع فتحات الإضاءة والتكييف.",
					"مخططات الكهرباء النهائية للنقاط والسبوتات والبرايز والمفاتيح.",
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("معلومات تنفيذية وتجارية")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه المعلومات تحدد شكل جدول الحصر وطريقة عرضه على العميل أو المقاول.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pItemFnt={Text.Body.WithColor("#333333")}
				pNumbered={false}
				pItems={[
					"صور الموقع إذا كان المشروع قائمًا أو تحت التشطيب.",
					"رفع مقاسات فعلي عند وجود اختلاف بين الواقع والرسومات.",
					"مود بورد أو قائمة خامات أو صور مرجعية للخامات المطلوبة.",
					"تحديد هل الحصر للشراء أم للمقايسة أم لمراجعة عرض مقاول.",
					"تحديد البنود التي سيتولاها العميل بنفسه والبنود الداخلة في المقاولة.",
					"تحديد صيغة التسليم المطلوبة: جدول كميات، مقايسة، مقارنة عروض، أو تقرير ملاحظات.",
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#111318")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			pTitle="تفصيل حصر الأرضيات والحوائط"
			pDesc="أكبر جزء من تكلفة التشطيبات غالبًا يظهر في الأرضيات والحوائط. لذلك يتم فصل الخامات والمناطق بدقة بدل جمع كل المساحات في بند واحد."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("أرضيات")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("السيراميك والبورسلين", "يتم فصل الأرضيات عن الحوائط والوزرات، وتحديد المقاس والنوع والاتجاه والمنطقة، مع ملاحظات الهالك والقطع عند الأركان والمداخل.")}
				pTopic2={new Topic("الرخام والجرانيت", "الحصر يحتاج فصل الألواح أو القطع والأعتاب والنوايم والقوايم والوزرات والحواف والتخانات والتلميع والنقل والتركيب.")}
				pTopic3={new Topic("الباركيه والفينيل", "يتم قياس المساحات الصافية وفصل الوزرات والفواصل وطبقات التحضير وعتبات الانتقال بين الخامات المختلفة.")}
				pTopic4={new Topic("الإيبوكسي والأرضيات الخاصة", "يحتاج وصفًا لطبقات التحضير والبرايمر والسماكة والدهان النهائي والفواصل ومناطق الحركة أو الرطوبة.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("حوائط")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("المحارة والمعجون", "تفصل الأسطح الداخلية والخارجية والمناطق الرطبة والأسقف والحوائط حسب طبقات التحضير ومستوى الاستواء المطلوب.")}
				pTopic2={new Topic("الدهانات", "يتم فصل البرايمر والمعجون والأوجه النهائية وأنواع الدهان والحوائط والأسقف والأبواب والمعادن عند دخولها في نطاق الخدمة.")}
				pTopic3={new Topic("التكسيات", "الحجر والخشب وبدائل الخشب وورق الحائط والبانوهات تحتاج فصلًا حسب المساحة والحدود والإكسسوارات وطريقة التثبيت.")}
				pTopic4={new Topic("الحوائط الرطبة", "حمامات ومطابخ وغسيل وشرفات تحتاج فصل ارتفاعات السيراميك والعزل والنهايات والتقاء الحائط بالأرضية والسقف.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="تفصيل حصر الأسقف والفتحات والتجهيزات"
			pDesc="بنود الأسقف والفتحات كثيرة التفاصيل، وتؤثر في السعر النهائي رغم أن مساحاتها قد تبدو أصغر من الأرضيات. الفصل الدقيق يحمي العميل من الإضافات المتكررة أثناء التنفيذ."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("أسقف وجبس")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("جبس بورد مسطح", "يقاس بالمتر المسطح مع فصل المناسيب والقطاعات ومناطق الرطوبة، وتحديد فتحات السبوتات والتكييف والصيانة عند الحاجة.")}
				pTopic2={new Topic("بيوت نور وبروفيلات", "غالبًا تقاس بالمتر الطولي أو البند حسب التفصيل، وتحتاج وصفًا لقطاع الجبس والإضاءة المخفية وطريقة النهاية.")}
				pTopic3={new Topic("كرانيش وحليات", "يتم فصل الأطوال والمقاسات والأنواع، لأن اختلاف قطاع الكورنيشة يغير السعر ولو كان الطول واحدًا.")}
				pTopic4={new Topic("فتحات وتقاطعات", "فتحات التكييف والسبوتات والسماعات والرشاشات وفتحات الصيانة يجب تسجيلها حتى لا تظهر كمطالبات إضافية.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "340px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("فتحات وتجهيزات")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("الأبواب", "عدد ومقاس ونوع الباب والحلق والضلفة والكوالين والمفصلات والدهان أو القشرة أو اللاكيه ونطاق التركيب.")}
				pTopic2={new Topic("الشبابيك والزجاج", "الألومنيوم أو الخشب أو الحديد، نوع الزجاج، الشبك، الإكسسوارات، المقاسات، وطريقة التركيب.")}
				pTopic3={new Topic("الأدوات الصحية", "الحوض والقاعدة والخلاط والشاور والصرف والإكسسوارات، مع فصل التوريد عن التركيب إذا كان ذلك مطلوبًا.")}
