	<EmoFaq id="faq">

		<FaqItem
			pQuestion="هل يمكن حصر التشطيبات من مسقط معماري فقط؟"
			pAnswer="يمكن إعداد حصر مبدئي لبعض البنود، لكن الحصر التفصيلي يحتاج جدول تشطيبات وتفاصيل حوائط وأسقف ومواصفات خامات. المسقط وحده لا يوضح كل الارتفاعات والتكسيات والنهايات."
		/>

		<FaqItem
			pQuestion="هل الحصر يشمل الأسعار؟"
			pAnswer="يمكن تسليم جدول كميات بدون أسعار، أو إضافة أسعار تقديرية عند طلب دراسة تكلفة. الأسعار النهائية تعتمد على عروض الموردين والمقاولين وقت التنفيذ."
		/>

		<FaqItem
			pQuestion="هل الحصر يصلح لإرسال المقاولين؟"
			pAnswer="نعم، عند تجهيزه كمقايسة بدون أسعار يمكن إرساله لأكثر من مقاول حتى تكون المقارنة على نفس البنود والكميات."
		/>

		<FaqItem
			pQuestion="هل يتم حساب الهالك؟"
			pAnswer="يمكن إضافة الهالك أو ملاحظات الهالك حسب نوع الخامة وطريقة التركيب، لكن النسبة النهائية يجب ربطها بمقاس البلاطة أو اللوح واتجاه التركيب وسياسة المورد."
		/>

		<FaqItem
			pQuestion="هل يشمل الحصر الأدوات الصحية والكهرباء النهائية؟"
			pAnswer="يمكن أن يشملها إذا كانت ضمن نطاق الخدمة، مثل الأطقم الصحية والخلاطات والسبوتات والمفاتيح والبرايز ووحدات الإضاءة."
		/>

		<FaqItem
			pQuestion="هل يكفي الحصر لشراء السيراميك؟"
			pAnswer="يساعد الحصر في تحديد الكميات، لكن الشراء يحتاج تأكيد الموديل والمقاس والفرز واللون والهالك واحتياطي الكسر والتوريد من نفس التشغيلة قدر الإمكان."
		/>

		<FaqItem
			pQuestion="هل يمكن مراجعة عرض مقاول تشطيبات؟"
			pAnswer="نعم، يمكن تفريغ عرض المقاول ومقارنته بالحصر لإظهار البنود الناقصة أو المدمجة أو غير المسعرة أو ذات الوصف غير الواضح."
		/>

		<FaqItem
			pQuestion="هل حصر التشطيبات مختلف عن حصر أعمال البناء؟"
			pAnswer="نعم. حصر البناء يركز على الهيكل والبنود الثقيلة، بينما حصر التشطيبات يركز على الخامات والأسطح والنهايات والإكسسوارات وكثرة التفاصيل الصغيرة."
		/>

		<FaqItem
			pQuestion="هل يمكن حصر شقة قائمة بدون رسومات؟"
			pAnswer="يمكن ذلك بعد رفع مقاسات ومعاينة أو صور واضحة، لكن دقة الحصر تعتمد على إمكانية الوصول للموقع وحالة الأسطح ووضوح المطلوب."
		/>

		<FaqItem
			pQuestion="هل الحصر يشمل النجارة والمطبخ؟"
			pAnswer="يمكن إدخال النجارة الثابتة أو المطابخ ضمن نطاق خاص، لكن المطابخ التفصيلية غالبًا تحتاج رسومات تنفيذية وموديلات وإكسسوارات يتم تسعيرها مع متخصص النجارة."
		/>

		<FaqItem
			pQuestion="هل يمكن تحديث الحصر بعد تغيير الخامات؟"
			pAnswer="نعم، لكن تغيير المقاسات أو طرق التركيب أو تفاصيل الأسقف والحوائط قد يحتاج مراجعة كميات وليس مجرد تعديل اسم الخامة."
		/>

		<FaqItem
			pQuestion="ما أسرع طريقة للحصول على عرض سعر للخدمة؟"
			pAnswer="أرسل الرسومات أو صور الموقع، جدول التشطيبات إن وجد، نوع المشروع، الهدف من الحصر، وهل المطلوب كميات فقط أم كميات مع أسعار تقديرية أو مقارنة عروض."
		/>

	</EmoFaq>







