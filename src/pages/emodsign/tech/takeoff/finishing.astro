---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, ListItem, SecTitle, VrStack } from "@/Widgets/Comp";
import { AngleBand, LayerDeck, LayerItem, MosaicGrid, MosaicItem, RadialItem, RadialLayout, SideRail, SplitPane, SplitScene, StoryRail, StoryStep, ZigzagItem, ZigzagStory } from "@/Widgets/Layouts";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { Align, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="حصر كميات أعمال التشطيبات"
	pDescr="خدمة حصر كميات التشطيبات من الرسومات وجداول التشطيب والموقع، تشمل المحارة والجبس بورد والكرانيش والسيراميك والبورسلين والرخام والدهانات والأبواب والشبابيك والأعمال الصحية والكهربائية النهائية، مع إعداد جداول كميات واضحة للتسعير وشراء الخامات ومقارنة عروض المقاولين."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("57%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("حصر كميات أعمال التشطيبات")}
				pText={Text.Body.Centered.OfText("خدمة حصر كميات التشطيبات من الرسومات وجداول التشطيب والموقع، تشمل المحارة والجبس بورد والكرانيش والسيراميك والبورسلين والرخام والدهانات والأبواب والشبابيك والأعمال الصحية والكهربائية النهائية، مع إعداد جداول كميات واضحة للتسعير وشراء الخامات ومقارنة عروض المقاولين.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<AngleBand
		id="takeoff-scope"
		pBg="linear-gradient(118deg, #101820 0%, #243640 62%, #6F7D67 100%)"
		pColor="#F8F4EC"
		pDirection="Rise"
		pCut={new RespString("7%", "3%")}
		pMinHeight={new RespString("310px", "280px")}
	>

		<Emograph
			pSize={new Size(new NumPer("930px", "100%"), new NumPer("auto", "auto"))}
			pTitle={Text.H2.WithColor("#F8F4EC").OfText("الحصر يتغير بتغيّر نظام التشطيب نفسه")}
			pText={Text.Body.WithColor("#DDE4E1").OfText("المحارة والنقاشة والسيراميك يمكن حصرها كمساحات وأطوال وأعداد واضحة، بينما الجبسيوم بورد يحتاج تفكيك النظام إلى ألواح وقطاعات وتعليقات وإكسسوارات، والرخام يحتاج قراءة القطع والمقاسات والسمك والحليات والدرج والهالك. لذلك نقسم حصر التشطيبات حسب طبيعة البند، لا تحت رقم إجمالي واحد.")}
		/>

	</AngleBand>







	<ZigzagStory
		id="main-takeoff-types"
		pBg="#EEE9E0"
		pGap={new RespString("54px", "22px")}
		pPad={new RespString("64px", "14px")}
	>

		<ZigzagItem
			pMediaShare={48}
			pBg="#FFFDF8"
			pMediaBg="#18232A"
			pRadius={new RespString("42px", "24px")}
			pMediaRadius={new RespString("42px", "20px")}
			pMinHeight={new RespString("560px", "760px")}
			pMediaMinHeight={new RespString("430px", "330px")}
		>

			<RadialLayout
				slot="media"
				pCount={6}
				pDiameter={new RespString("94%", "94%")}
				pOrbit={new RespString("37%", "36%")}
				pCenterSize={new RespString("34%", "34%")}
				pBg="radial-gradient(circle, #23323A 0 43%, #18232A 44% 100%)"
				pCenterBg="#E4835F"
				pCenterColor="#111820"
				pRingColor="rgba(255,255,255,.18)"
				pAccent="#E4835F"
				pCenterTitle="01"
				pCenterText="الأعمال الاعتيادية"
				pStackPortrait={false}
			>

				<RadialItem
					pTitle="محارة"
					pText="م²"
					pWidth={new RespString("126px", "88px")}
					pBg="#FFF8EE"
					pAccent="#E4835F"
				/>

				<RadialItem
					pTitle="نقاشة"
					pText="م²"
					pWidth={new RespString("126px", "88px")}
					pBg="#FFF8EE"
					pAccent="#E4835F"
				/>

				<RadialItem
					pTitle="سيراميك"
					pText="م²"
					pWidth={new RespString("126px", "88px")}
					pBg="#FFF8EE"
					pAccent="#E4835F"
				/>

				<RadialItem
					pTitle="بورسلين"
					pText="م²"
					pWidth={new RespString("126px", "88px")}
					pBg="#FFF8EE"
					pAccent="#E4835F"
				/>

				<RadialItem
					pTitle="وزرات"
					pText="م ط"
					pWidth={new RespString("126px", "88px")}
					pBg="#FFF8EE"
					pAccent="#E4835F"
				/>

				<RadialItem
					pTitle="عتبات"
					pText="م ط / عدد"
					pWidth={new RespString("126px", "88px")}
					pBg="#FFF8EE"
					pAccent="#E4835F"
				/>

			</RadialLayout>

			<Emograph
				pTitle={Text.H2.WithColor("#111820").OfText("حصر الأعمال الاعتيادية")}
				pText={Text.Body.WithColor("#465157").OfText("يشمل البنود المتكررة في أغلب المشروعات والتي يمكن ردّها إلى مساحات وأطوال وأعداد مباشرة، مع فصل كل خامة ومكان استعمالها بدل جمعها في بند تشطيب واحد.")}
			/>

			<EmoList
				pWidth={new RespString("100%", "100%")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#283238")}
				pNumbered={false}
			>

				<ListItem pText="المحارة: حوائط، أسقف، أكتاف، أعمدة ظاهرة، جوانب فتحات، ومناطق تختلف في السمك أو المواصفة." />

				<ListItem pText="النقاشة: حوائط وأسقف وأخشاب ومعادن، مع فصل أنظمة المعجون والبطانات والأوجه النهائية عند الحصر التفصيلي." />

				<ListItem pText="السيراميك والبورسلين: أرضيات، حوائط، حمامات، مطابخ، بلكونات، وزرات، اختلاف المقاسات واتجاهات التركيب." />

				<ListItem pText="يمكن إخراج الحصر كمسطحات تنفيذ أو تحويله إلى احتياجات شراء وخامات حسب الغرض من الملف." />

			</EmoList>

		</ZigzagItem>

		<ZigzagItem
			pMediaShare={46}
			pBg="#F5F7F5"
