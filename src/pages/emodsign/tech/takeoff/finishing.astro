						pText={Text.Body.Centered.WithColor("#31383B").OfText("Stud · Track · Channel · تعليق")}
					/>

				</LayerItem>

				<LayerItem
					pWidth={new RespString("54%", "62%")}
					pHeight={new RespString("38%", "34%")}
					pOffsetX={new RespString("0%", "0%")}
					pOffsetY={new RespString("29%", "28%")}
					pBg="#F9F7F0"
					pColor="#111820"
					pRadius={new RespString("20px", "16px")}
				>

					<Emograph
						pTitle={Text.H4.Centered.WithColor("#111820").OfText("إكسسوارات + عزل")}
						pText={Text.Body.Centered.WithColor("#4A555A").OfText("وصلات · مسامير · شريط · معجون · صوف عازل")}
					/>

				</LayerItem>

			</LayerDeck>

			<Emograph
				pTitle={Text.H2.WithColor("#111820").OfText("حصر الجبسيوم بورد")}
				pText={Text.Body.WithColor("#465157").OfText("الجبسيوم بورد لا يُختصر في مساحة السقف. الحصر الصحيح يفكك النظام إلى أسطح وتشكيلات وقطاعات وإكسسوارات وفتحات، ويحدد اختلاف نوع اللوح ومكان استخدامه.")}
