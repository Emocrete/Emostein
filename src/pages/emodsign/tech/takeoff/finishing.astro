					pOffsetX={new RespString("-16%", "-12%")}
					pOffsetY={new RespString("-10%", "-12%")}
					pBg="#26363D"
					pColor="#F8F6EF"
					pRadius={new RespString("24px", "18px")}
				>

					<Emograph
						pTitle={Text.H3.Centered.WithColor("#F8F6EF").OfText("ألواح")}
						pText={Text.Body.Centered.WithColor("#CAD5CF").OfText("عادي · مقاوم للرطوبة · مقاوم للحريق")}
					/>

				</LayerItem>

				<LayerItem
					pWidth={new RespString("62%", "68%")}
					pHeight={new RespString("54%", "50%")}
					pOffsetX={new RespString("16%", "13%")}
