				/>

			</MosaicItem>

			<MosaicItem
				pColSpan={4}
				pColSpanP={4}
				pRowSpan={3}
				pRowSpanP={3}
				pBg="#D7A84A"
			>

				<Emograph
					pTitle={Text.H3.WithColor("#171E22").OfText("الأسقف")}
					pText={Text.Body.WithColor("#353A39").OfText("جبس بلدي · جبسيوم بورد · Mineral Fiber · Acoustic Tiles · أسقف معدنية · ألمنيوم · Linear Ceiling · Open Cell · Clip-in · Lay-in · Hook-on · خشب · MDF · HPL · PVC · Stretch Ceiling · Baffles · كرانيش · بيوت نور · تجاويف")}
