					pTitle={Text.H3.WithColor("#171E22").OfText("الأرضيات والكسوات الأرضية")}
					pText={Text.Body.WithColor("#525B5D").OfText("سيراميك · بورسلين · رخام · جرانيت · حجر · موزايكو · تيرازو · إنترلوك · إيبوكسي · Self Leveling · فينيل · PVC · SPC · LVT · HDF · باركيه · خشب · مطاط · موكيت · Raised Floor · ترتان · Decking · WPC")}
				/>

