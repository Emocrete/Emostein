---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="حصر كميات"
	pDescr="صفحة توزيع خدمات حصر الكميات داخل المكتب، تربط بين حصر كميات أعمال البناء والهيكل الخرساني وحصر كميات التشطيبات، مع شرح الفرق بينهما ومتى يحتاج العميل كل خدمة وكيف تتحول الرسومات إلى جداول كميات قابلة للتسعير والمراجعة ومقارنة عروض المقاولين."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("57%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("حصر كميات")}
				pText={Text.Body.Centered.OfText("صفحة توزيع خدمات حصر الكميات داخل المكتب، تربط بين حصر كميات أعمال البناء والهيكل الخرساني وحصر كميات التشطيبات، مع شرح الفرق بينهما ومتى يحتاج العميل كل خدمة وكيف تتحول الرسومات إلى جداول كميات قابلة للتسعير والمراجعة ومقارنة عروض المقاولين.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec
		id="choose-takeoff"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="صفحة توزيع حصر الكميات"
			pDesc="هذه الصفحة ليست بديلًا عن الصفحتين المتخصصتين، لكنها مدخل يحدد للعميل أي نوع حصر يناسب مرحلة مشروعه: هل يحتاج حصر أعمال البناء والخرسانات والمباني، أم حصر التشطيبات والخامات النهائية، أم يحتاج ملفًا يربط الاثنين قبل طلب أسعار المقاولين."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("الحصر يسبق السعر الحقيقي")}
				pText={Text.Body.WithColor("#333333").OfText("الرسومات توضح ما سيُنفذ، لكنها لا تكفي وحدها لمعرفة حجم المال المطلوب. الحصر يحول الرسومات إلى كميات ووحدات وبنود يمكن تسعيرها، ويكشف هل المشروع جاهز للمقايسة أم يحتاج استكمال رسومات أو توضيح مواصفات. لذلك يعتبر الحصر مرحلة وسيطة بين التصميم والعرض المالي والتعاقد مع المقاول.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"رسومات ومخططات مشروع قبل إعداد حصر الكميات",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#0E1118")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="الخدمتان الأساسيتان داخل فرع الحصر"
			pDesc="الفصل بين حصر البناء وحصر التشطيبات مهم لأن كل مرحلة لها رسوماتها ووحداتها ومخاطرها وطريقة تسعيرها. جمعهما في عرض واحد ممكن، لكن يجب أن يكون بنطاق واضح لا يخلط الهيكل الخرساني بالاختيارات النهائية للخامات."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("حصر أعمال البناء")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("مرحلة الهيكل", "حصر الحفر والردم والخرسانة العادية والمسلحة والشدات وحديد التسليح والمباني والبنود المرتبطة بالإنشاء.")}
				pTopic2={new Topic("الهدف", "تجهيز كميات قابلة للتسعير قبل التعاقد مع مقاول الهيكل أو مراجعة عرض منفذ قائم.")}
				pTopic3={new Topic("رابط الخدمة", "افتح صفحة حصر كميات أعمال البناء للحصول على تفاصيل البنود والمخرجات وطريقة العمل.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("حصر أعمال التشطيبات")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("مرحلة الخامات", "حصر الأرضيات والحوائط والأسقف والدهانات والجبس بورد والأبواب والشبابيك والأدوات الصحية والكهرباء النهائية.")}
				pTopic2={new Topic("الهدف", "تجهيز قوائم شراء ومقايسة تشطيبات ومراجعة عروض المقاولين على أساس كميات واضحة ومواصفات مفهومة.")}
				pTopic3={new Topic("رابط الخدمة", "افتح صفحة حصر كميات التشطيبات عند تجهيز تشطيب شقة أو فيلا أو محل أو مكتب أو عيادة.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoStr
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("لماذا لا يكفي أن يقول المقاول السعر بالمتر؟")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("سعر المتر قد يصلح كمؤشر سريع، لكنه لا يوضح كمية الخرسانة، ولا نوع البلاط، ولا أطوال الوزرات، ولا عدد الأبواب، ولا درجة الدهان، ولا الفرق بين بند داخل السعر وبند خارج السعر. الحصر يفكك المشروع إلى عناصر قابلة للقياس حتى تصبح المقارنة بين العروض أعدل وأوضح.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("ما الذي يكشفه الحصر؟")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("حجم الأعمال", "يعطي صورة رقمية عن كميات البنود بدل الاكتفاء بتقدير إجمالي مبني على المساحة أو الخبرة العامة.")}
			pTopic2={new Topic("نواقص الرسومات", "يكشف البنود التي لا يمكن قياسها بدقة بسبب غياب قطاع أو تفصيلة أو جدول أو مواصفة.")}
			pTopic3={new Topic("تحفظات المقاولين", "يساعد في معرفة هل اختلاف الأسعار بسبب كمية مختلفة أم مواصفة مختلفة أم بند غير داخل العرض.")}
			pTopic4={new Topic("احتياجات الشراء", "يوضح الكميات التقريبية للخامات الأساسية قبل فتح باب الشراء أو التوريد أو جدولة الدفعات.")}
		/>

	</EmoStr>







	<EmoSec
		id="construction-takeoff"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="حصر أعمال البناء والخرسانات"
			pDesc="هذا المسار يناسب مرحلة ما قبل تنفيذ الهيكل أو عند مراجعة عرض مقاول هيكل. التركيز فيه على العناصر التي تُقاس من الرسومات المعمارية والإنشائية، مع فصل البنود بطريقة تساعد في التسعير والمقارنة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emodsign/Tech/Takeoff/Construction/",
					"HeroL.webp",
					false,
					"حصر كميات أعمال البناء والهيكل الخرساني",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("متى تختار هذا المسار؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("اختيار حصر البناء يكون منطقيًا عندما يكون القرار متعلقًا بالهيكل أو الأعمال التي تسبق التشطيب.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					"قبل التعاقد مع مقاول الهيكل أو أعمال البناء.",
					"عند مقارنة أسعار الخرسانة والحديد والشدات والمباني بين أكثر من مقاول.",
					"عند مراجعة مقايسة مقدمة من مقاول أو شركة تنفيذ.",
					"عند تجهيز ميزانية أولية للبناء قبل الانتقال إلى مرحلة التشطيبات.",
					"عند وجود رسومات إنشائية ومعمارية وتحتاج تحويلها إلى كميات.",
					"عند حدوث خلاف حول كمية منفذة أو بند محسوب بطريقة غير واضحة."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="بنود شائعة في حصر أعمال البناء"
			pDesc="كل مشروع له نطاقه، لكن هذه المجموعات تتكرر كثيرًا في ملفات الحصر الخاصة بالبناء والخرسانات والمباني. فصل هذه البنود يساعد المقاول على التسعير ويقلل الخلط بين المواد والمصنعية والهالك."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("بنود تحت الأرض")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه البنود ترتبط بتجهيز الموقع والأساسات وبداية الهيكل، ويجب فصلها لأن وحداتها ومخاطرها مختلفة.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الحفر", Items: ["حساب حجم الحفر حسب منسوب التأسيس، ومساحة القواعد أو اللبشة، وأي زيادات تشغيلية متفق عليها."] },
					{ Title: "الإحلال والردم", Items: ["فصل الإحلال عن الردم العادي أو الردم حول الأساسات، وتحديد الوحدة وطريقة القياس."] },
					{ Title: "الخرسانة العادية", Items: ["حصر خرسانة النظافة أسفل القواعد أو اللبشة أو الميدات حسب أبعاد الرسومات."] },
					{ Title: "العزل والحماية", Items: ["تقدير مساحات العزل حول العناصر المدفونة عند وجود مواصفة واضحة أو تفصيلة معتمدة."] }
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("بنود الهيكل فوق الأرض")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه البنود تحدد جزءًا كبيرًا من تكلفة البناء، ويجب أن تكون قابلة للمراجعة من الرسومات.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الخرسانة المسلحة", Items: ["قواعد، ميدات، أعمدة، كمرات، بلاطات، سلالم، حوائط، خزانات، أو عناصر خاصة حسب المشروع."] },
					{ Title: "حديد التسليح", Items: ["تقدير الأوزان من جداول أو تفريد أو نسب تقريبية حسب مستوى الرسومات والاتفاق."] },
					{ Title: "الشدات", Items: ["فصل شدات القواعد والأعمدة والكمرات والبلاطات عند الحاجة إلى تسعير واضح للمصنعية."] },
					{ Title: "المباني", Items: ["حصر مباني الطوب والبلوك حسب السمك والارتفاع والفتحات والتقسيمات المعمارية."] }
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="finishing-takeoff"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="حصر كميات التشطيبات"
			pDesc="هذا المسار يناسب مرحلة تجهيز التشطيب أو مقارنة عروض التشطيب أو إعداد قوائم شراء الخامات. فيه لا تكفي المساحة الإجمالية، لأن كل خامة لها وحدة قياس وهالك وتفصيلة تنفيذ ومواصفة تؤثر في السعر النهائي."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("متى تختار هذا المسار؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("حصر التشطيبات يصبح مهمًا عندما تتحول اختيارات العميل إلى تكلفة شراء وتنفيذ.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					"قبل شراء السيراميك أو البورسلين أو الرخام أو الدهانات أو الجبس بورد.",
					"عند مقارنة عرض تشطيب كامل بين أكثر من مقاول أو شركة.",
					"عند تجهيز مقايسة تفصيلية لشقة أو فيلا أو محل أو مكتب.",
					"عند وجود تصميم داخلي وتحتاج تحويله إلى كميات خامات وبنود تنفيذ.",
					"عند ضبط دفعات التشطيب وربطها بكميات أو مراحل قابلة للمراجعة.",
					"عند مراجعة هالك الخامات أو فرق الكمية بين الشراء والتنفيذ."
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emodsign/Tech/Takeoff/Finishing/",
					"HeroL.webp",
					false,
					"حصر كميات التشطيبات والخامات النهائية",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="بنود شائعة في حصر التشطيبات"
			pDesc="حصر التشطيبات لا يقيس المسطح فقط، بل يفصل الخام والمكان والوحدة والهالك والملاحظات التي تؤثر في السعر، حتى لا تتحول التشطيبات إلى بند مفتوح بلا حدود واضحة."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("تشطيبات الأرضيات والحوائط")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه البنود غالبًا تقود جزءًا كبيرًا من ميزانية التشطيب، وتحتاج فصل المساحات والمقاسات والهالك.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الأرضيات", Items: ["سيراميك، بورسلين، رخام، باركيه، فينيل، أو أي خامة أخرى مع فصل الأماكن والمناسيب والوزرات."] },
					{ Title: "الحوائط", Items: ["دهانات، تجاليد، سيراميك حمامات ومطابخ، رخام، خشب، أو ورق حائط حسب التصميم."] },
					{ Title: "الأحزمة والوزرات", Items: ["قياس الأطوال والارتفاعات والفواصل، وفصلها عن المسطح عند اختلاف السعر أو طريقة التنفيذ."] },
					{ Title: "الهالك", Items: ["تقدير الهالك حسب نوع الخام والمقاس وطريقة التركيب ودرجة تقطيع التصميم."] }
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("تشطيبات الأسقف والفتحات")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه البنود تحتاج قراءة تصميمية لأن التفاصيل الصغيرة قد تضيف تكلفة كبيرة إذا لم تُحصر بوضوح.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الأسقف", Items: ["جبس بورد، كرانيش، بيت نور، بلاطات معلقة، فتحات تكييف، ومستويات مختلفة حسب التصميم."] },
					{ Title: "الأبواب والشبابيك", Items: ["عدد، مقاسات، أنواع، إكسسوارات، حلق، ضلف، زجاج، وأعمال تركيب أو تشطيب حول الفتحات."] },
					{ Title: "الكهرباء النهائية", Items: ["وشوش، سبوتات، نجف، شرائط إضاءة، مفاتيح، برايز، ولوحات نهائية حسب نطاق الاتفاق."] },
					{ Title: "الأدوات الصحية", Items: ["الأطقم، الخلاطات، الإكسسوارات، وحدات الحوض، الشاور، ومستلزمات التركيب عند إضافتها إلى الحصر."] }
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoStr
