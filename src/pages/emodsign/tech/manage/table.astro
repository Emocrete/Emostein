---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoBtn, EmoCall, Emograph, EmoList, HzStack, SecTitle } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, IndexSec, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="إعداد الجداول الزمنية للمشروعات الهندسية"
	pDescr="خدمة إعداد جدول زمني هندسي للمشروع تشمل تقسيم نطاق العمل، ترتيب الأنشطة، العلاقات المنطقية، المدد، المسار الحرج، خط الأساس، خطة التوريدات، تحديثات التقدم، وتقارير المتابعة للمشروعات السكنية والتجارية وأعمال البناء والتشطيبات."
	pSchemaImages={[
		"/Media/Emodsign/Tech/Manage/Table/HeroL.webp",
		"/Media/Emodsign/Tech/Manage/HeroL.webp",
		"https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&fm=jpg&q=70&w=1600"
	]}
>







	<Hero
		pImgF="/Media/Emodsign/Tech/Manage/Table/"
		pTitle="إعداد الجداول الزمنية"
		pDesc="جدول زمني هندسي يترجم الرسومات والبنود والتوريدات إلى خطة تنفيذ قابلة للمتابعة: أنشطة، علاقات، مدد، مراحل، مسار حرج، تحديثات، ومؤشرات تأخير مبكرة."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="18% 50% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب جدولًا زمنيًا" />

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Img", "/Media/Emodsign/Tech/Manage/Table/", "HeroL.webp")}
		pTitleClr="#FFFFFF"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="مشكلة الوقت"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#schedule-problem'"
		/>

		<EmoBtn
			pText="مكونات الجدول"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#schedule-components'"
		/>

		<EmoBtn
			pText="المسار الحرج"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#critical-path'"
		/>

		<EmoBtn
			pText="مخرجات الخدمة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#deliverables'"
		/>

	</IndexSec>







	<EmoSec
		id="schedule-problem"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="الجدول الزمني ليس شكلًا على ورقة"
			pDesc="المشكلة في كثير من المشروعات أن الوقت يدار بالكلام: هنبدأ بعد يومين، التشطيب بعد السقف، الكهرباء مع السباكة، الخامات لما تيجي. هذا الأسلوب يصلح للمحادثة، لكنه لا يصلح لإدارة مشروع فيه مالك ومقاول ومورد ومهندس ودفعات وتوريدات واعتمادات. الجدول الزمني يحول التوقعات إلى خطة يمكن اختبارها ومتابعتها."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("ما الذي تشتريه فعليًا عند طلب جدول زمني؟")}
				pText={Text.Body.WithColor("#333333").OfText("أنت لا تشتري ملفًا مرسومًا على برنامج فقط. أنت تشتري طريقة تفكير منظمة: تقسيم المشروع إلى أنشطة قابلة للمتابعة، ترتيب العلاقات بينها، تقدير مدد منطقية، كشف الأعمال التي تتحكم في تاريخ التسليم، وربط التوريدات والاعتمادات والدفعات بنقاط واضحة. الجدول الجيد يجعل التأخير ظاهرًا مبكرًا، بدل أن يكتشف المالك المشكلة عندما يتوقف الموقع فعلًا.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&fm=jpg&q=70&w=1400",
					false,
					"إعداد خطة زمنية ومتابعة مؤشرات المشروع",
					new Size(new NumPer(560, 320), new NumPer(360, 230))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#111318")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تحتاج إلى إعداد جدول زمني هندسي؟"
			pDesc="كل مشروع له تاريخ بداية ونهاية، لكن ليس كل مشروع لديه جدول يمكن الاعتماد عليه. الخدمة تكون مهمة عندما يتحول المشروع من فكرة عامة إلى تنفيذ يحتاج التزامًا ومتابعة وقرارات مالية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("حالات عملية تستدعي جدولًا واضحًا")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("قبل التعاقد", "عندما يريد المالك معرفة مدة المشروع الواقعية قبل اختيار المقاول أو الموافقة على عرض السعر. الجدول هنا يكشف هل مدة المقاول منطقية أم مجرد وعد تجاري.")}
			pTopic2={new Topic("بعد استلام عرض المقاول", "عندما يقدم المقاول مدة إجمالية دون تفاصيل كافية. يتم تحويل المدة إلى أنشطة وعلاقات ومراحل حتى يمكن متابعة التزامه.")}
			pTopic3={new Topic("قبل بدء التشطيبات", "التشطيبات أكثر حساسية للتداخل بين الخامات والنجارة والجبس والدهانات والكهرباء النهائية. الجدول يمنع ازدحام الفرق داخل الموقع دون ترتيب.")}
			pTopic4={new Topic("عند وجود تأخير", "عندما يبدأ الموقع في الانحراف عن الخطة، يصبح مطلوبًا تحديث البرنامج وتحليل سبب التأخير واقتراح خطة تعويض أو إعادة ترتيب الأعمال.")}
		/>

	</EmoSec>







	<EmoStr
		id="schedule-components"
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("مكونات الجدول الزمني القابل للاستخدام")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("الجدول الجيد لا يبدأ من التاريخ النهائي. يبدأ من نطاق العمل، ثم تقسيمه إلى أنشطة، ثم ترتيب العلاقات، ثم حساب المدد، ثم تثبيت خط أساس يمكن المقارنة به أثناء التنفيذ.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("البناء الداخلي للجدول")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("تقسيم العمل", "تحويل المشروع إلى مراحل وأنشطة: تصميم، اعتمادات، مشتريات، أعمال موقع، تشطيبات، اختبارات، وتسليم.")}
				pTopic2={new Topic("العلاقات المنطقية", "ربط كل نشاط بما قبله وما بعده، حتى لا تظهر أعمال متزامنة على الورق وهي غير قابلة للتزامن في الموقع.")}
				pTopic3={new Topic("المدد والموارد", "تقدير مدة كل نشاط بناءً على حجم العمل وطبيعة البند وعدد الفرق وإمكانات المورد أو المقاول.")}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("ملفات يعتمد عليها الجدول")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("الجدول لا ينفصل عن باقي مستندات المشروع. كل ملف ناقص يتحول إلى افتراض داخل الخطة.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={false}
				pItems={[
					"رسومات التصميم أو الشوب دروينج المعتمدة أو المتاحة.",
					"حصر الكميات أو المقايسة أو عرض المقاول التفصيلي.",
					"تاريخ بداية متوقع وتاريخ تسليم مستهدف.",
					"عدد فرق التنفيذ المتاحة أو المتوقع توفيرها.",
					"الخامات طويلة التوريد والمعدات الخاصة والأعمال التي تحتاج اعتمادًا مسبقًا.",
					"قيود الموقع: أوقات العمل، الجيران، التصاريح، التشوين، الرافعات، والمداخل."
				]}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="مستويات الجداول الزمنية التي يمكن إعدادها"
			pDesc="ليس كل عميل يحتاج نفس مستوى التفصيل. جدول فيلا صغيرة يختلف عن جدول مبنى متعدد الأدوار، وجدول تشطيبات شقة يختلف عن برنامج مشروع تجاري له توريدات وموافقات وتشغيل."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("اختيار مستوى الجدول حسب الاستخدام")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("جدول مبدئي", "يناسب مرحلة دراسة المشروع قبل التعاقد. يوضح المدة العامة والمراحل الرئيسية ويكشف مدى واقعية تاريخ التسليم المطلوب.")}
			pTopic2={new Topic("جدول تعاقدي", "يستخدم قبل أو مع التعاقد مع المقاول. يحدد مراحل العمل ونقاط التسليم والاعتمادات والقيود الأساسية التي يجب الالتزام بها.")}
			pTopic3={new Topic("جدول تفصيلي", "يقسم الأعمال إلى أنشطة أكثر دقة، ويصلح لمتابعة الموقع أسبوعيًا أو كل أسبوعين حسب حجم المشروع.")}
			pTopic4={new Topic("جدول تحديثات", "يبدأ من جدول أساس ثم يتم إدخال التقدم الفعلي، والانحرافات، والتأخيرات، والأنشطة المتبقية، وخطة التعويض.")}
			pTopic5={new Topic("جدول توريدات", "يركز على الخامات والمعدات التي تتحكم في سير الموقع، مثل المصاعد، الأبواب، الرخام، وحدات التكييف، الزجاج، والمعدات الخاصة.")}
			pTopic6={new Topic("برنامج استرداد", "يستخدم عند تأخر المشروع، ويعيد ترتيب الأعمال والموارد والتداخلات للوصول إلى أقرب تاريخ تسليم ممكن دون إفساد الجودة.")}
		/>

	</EmoSec>







	<EmoSec
		id="critical-path"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="المسار الحرج: الأنشطة التي تتحكم في تاريخ التسليم"
			pDesc="داخل أي مشروع توجد أنشطة يمكن تأخيرها قليلًا دون أثر مباشر، وأنشطة أخرى يؤدي تأخيرها إلى تأخير المشروع كله. وظيفة التحليل الزمني أن يميز بين الاثنين، حتى لا ينشغل الفريق ببند عادي ويترك بندًا يتحكم في التسليم."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1400",
					false,
					"موقع تنفيذ يحتاج برنامجًا زمنيًا واضحًا",
					new Size(new NumPer(560, 320), new NumPer(380, 230))
				)}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("كيف نقرأ المسار الحرج عمليًا؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("القراءة العملية أهم من لون النشاط على الشاشة. المطلوب فهم سبب خطورة النشاط وتأثيره على باقي الأعمال.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "تحديد أطول مسار منطقي", Items: ["ليس بالضرورة أن يكون أطول بند منفرد، بل أطول سلسلة أنشطة مترابطة تنتهي بتاريخ التسليم."] },
					{ Title: "تمييز الأنشطة ذات السماحية", Items: ["بعض البنود لديها مساحة تأخير محدودة دون أثر مباشر، وهذه المساحة يجب استخدامها بحذر."] },
					{ Title: "متابعة التغير بعد التحديث", Items: ["المسار الحرج قد يتغير بعد إدخال التقدم الفعلي أو تأخر التوريدات أو تغيير طريقة التنفيذ."] },
					{ Title: "ربط التحليل بالقرار", Items: ["النشاط الحرج يحتاج قرارًا أسرع وموارد أكثر وضبطًا أعلى من النشاط غير المؤثر على تاريخ التسليم."] }
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoStr
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#111318")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#F4E5C4").OfText("الفرق بين مدة المشروع وجدول المشروع")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("مدة المشروع رقم واحد: ٤ أشهر، ٦ أشهر، سنة. أما جدول المشروع فهو تفسير هذا الرقم: ماذا سيحدث؟ بأي ترتيب؟ من المسؤول؟ ما الأنشطة التي يمكن أن تتداخل؟ وما الأنشطة التي لا يمكن ضغطها؟")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("المدة العامة")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("رقم لا يكشف التفاصيل", "قول المقاول إن المشروع يحتاج ٥ أشهر لا يوضح هل الأساسات ستستغرق شهرًا أم شهرين، ولا يوضح أين ستدخل التوريدات.")}
				pTopic2={new Topic("يصعب محاسبته", "إذا تأخر الموقع أسبوعًا، لا توجد طريقة واضحة لمعرفة هل التأخير مؤثر على النهاية أم يمكن تعويضه من نشاط آخر.")}
				pTopic3={new Topic("يعتمد على الثقة فقط", "المدة العامة تصلح كبداية تفاوض، لكنها لا تصلح وحدها كأداة إدارة ومتابعة.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("الجدول الزمني")}
				pCardBg={new ElemBg("#111318")}
				pCardTitleFnt={Text.H4.WithColor("#D9B86C")}
				pCardBodyFnt={Text.Body.WithColor("#F8F4EA")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("خطة قابلة للفحص", "كل مرحلة لها بداية ونهاية وعلاقات ومسؤوليات، فيمكن اختبار منطق الخطة قبل التنفيذ.")}
				pTopic2={new Topic("أداة متابعة", "يتم إدخال التقدم الفعلي ومقارنة الموقع بخط الأساس لمعرفة الانحراف مبكرًا.")}
				pTopic3={new Topic("مرجع للقرارات", "عند ظهور تأخير أو تغيير، يساعد الجدول على اختيار القرار الأقل ضررًا على تاريخ التسليم.")}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="جدول البناء وجدول التشطيبات"
