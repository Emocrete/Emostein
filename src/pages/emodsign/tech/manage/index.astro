---
import { Align, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoBtn, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, IndexSec, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="إدارة المشروعات الهندسية"
	pDescr="خدمة إدارة مشروعات هندسية للمالك أو المطور، تشمل تنظيم نطاق العمل، متابعة التصميم، الجدول الزمني، التكلفة، المشتريات، التنسيق بين الأطراف، التقارير، إدارة المخاطر، ومتابعة قرارات المشروع حتى التسليم."
	pSchemaImages={[
		"/Media/Emodsign/Tech/Manage/HeroL.webp",
		"/Media/Emodsign/Tech/Manage/Table/HeroL.webp",
		"https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&fm=jpg&q=70&w=1600",
		"https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&fm=jpg&q=70&w=1600"
	]}
>







	<Hero
		pImgF="/Media/Emodsign/Tech/Manage/"
		pTitle="إدارة المشروعات الهندسية"
		pDesc="تنظيم المشروع من الفكرة والتصميم والتسعير إلى التعاقد والتنفيذ والمتابعة، مع خطة واضحة للوقت والتكلفة والجودة والقرارات المطلوبة من كل طرف."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="18% 50% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب إدارة مشروعك" />

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Img", "/Media/Emodsign/Tech/Manage/", "HeroL.webp")}
		pTitleClr="#FFFFFF"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoBtn
			pText="خريطة الإدارة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#manage-map'"
		/>

		<EmoBtn
			pText="مراحل المشروع"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#project-stages'"
		/>

		<EmoBtn
			pText="الجدول والتكلفة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#time-cost'"
		/>

		<EmoBtn
			pText="اطلب الخدمة"
			pBgImg="/Media/IndexBtn.webp"
			pTextColor="#FFFFFF"
			pTextColorHover="#111318"
			pWidth="250px"
			pHeight="44px"
			onclick="location.href='#related-services'"
		/>

	</IndexSec>







	<ESec
		id="manage-map"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="ما المقصود بإدارة المشروعات الهندسية؟"
			pDesc="إدارة المشروع الهندسي هي تحويل رغبة المالك إلى مسار عمل منظم: نطاق واضح، قرارات مرتبة، وقت قابل للمتابعة، تكلفة قابلة للمراجعة، ومسؤوليات معروفة بين المصمم والمقاول والمورد والمالك. الصفحة هنا لا تبيع إشرافًا فقط ولا جدولًا فقط، بل تعرض خدمة إدارة تربط بين التصميم والتسعير والتعاقد والتنفيذ."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("المشكلة ليست في وجود مقاول فقط")}
				pText={Text.Body.WithColor("#333333").OfText("كثير من المشاريع تبدأ بعرض سعر من مقاول، ثم تظهر الأسئلة الصعبة: ما نطاق العمل الحقيقي؟ من يراجع التصميم؟ هل الكميات صحيحة؟ هل جدول التنفيذ منطقي؟ متى تُدفع المستخلصات؟ كيف يتم قبول الخامات؟ من يسجل التغييرات؟ إدارة المشروعات الهندسية تضع هذه الأسئلة في نظام واضح قبل أن تتحول إلى خلافات أثناء التنفيذ.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1503387762-592deb58ef4e?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"مخططات مشروع هندسي قبل تنظيم مراحل الإدارة",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#0E1118")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="الخدمة مناسبة لمَن؟"
			pDesc="إدارة المشروع لا تخص الشركات الكبيرة فقط. أي مالك عنده تصميم أو تشطيب أو بناء أو مشروع تجاري يحتاج شخصًا ينظم العلاقة بين الأطراف ويحمي القرار والوقت والمال."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("حالات عملية تحتاج إدارة مشروعات")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مالك يبدأ من التصميم", "لديه فكرة أو أرض أو وحدة ويريد تنظيم التصميم والحصر والتسعير قبل اختيار المقاول، بدل الدخول في عروض غير قابلة للمقارنة.")}
			pTopic2={new Topic("مالك عنده مقاول", "لديه مقاول منفذ لكنه يحتاج متابعة القرارات والتكلفة والبرنامج الزمني والمستخلصات وتسجيل الملاحظات.")}
			pTopic3={new Topic("مشروع متعثر", "توقفت الأعمال أو زادت التعديلات أو تضاربت المسؤوليات، فيحتاج المشروع إلى إعادة ترتيب نطاقه وجدوله وموقفه المالي والفني.")}
			pTopic4={new Topic("مشروع تشطيب أو تجاري", "محل أو مطعم أو عيادة أو مكتب يحتاج سرعة في القرار وتنسيقًا بين التصميم والخامات والموردين والتنفيذ والتسليم.")}
		/>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("إدارة المشروع تبدأ قبل التنفيذ")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("أغلى أخطاء المشاريع لا تظهر دائمًا في الموقع؛ كثير منها يبدأ قبل التعاقد: تصميم ناقص، مقايسة غير واضحة، جدول غير منطقي، عقد مفتوح، أو مستخلصات غير مربوطة بتقدم فعلي. لذلك تبدأ إدارة المشروع من ترتيب النطاق قبل أول بند تنفيذ.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("قبل التعاقد")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("المرحلة التي تحدد هل المشروع سيدخل التنفيذ بوضوح أم بمجموعة وعود عامة.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={true}
				pItems={[
					{ Title: "مراجعة التصميم", Items: ["تحديد ما هو جاهز للتنفيذ وما يحتاج استكمالًا أو تنسيقًا أو حصرًا قبل التسعير."] },
					{ Title: "تحديد نطاق المقاول", Items: ["فصل الأعمال الداخلة والخارجة من العرض، وتوضيح مسؤولية الخامات والمصنعيات والنقل والهالك."] },
					{ Title: "مقارنة العروض", Items: ["توحيد أساس المقارنة حتى لا يتم اختيار الأرخص لأنه ناقص بنودًا أو محمل بمواصفات أقل."] },
					{ Title: "الجدول الابتدائي", Items: ["ترتيب المراحل الرئيسية وتحديد نقاط اعتماد المالك والمشتريات طويلة التوريد."] }
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("أثناء التنفيذ")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("المرحلة التي تتحول فيها القرارات اليومية إلى وقت وتكلفة وجودة.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={true}
				pItems={[
					{ Title: "متابعة التقدم", Items: ["قياس ما تم فعليًا مقارنة بالخطة، ومعرفة سبب الانحراف قبل أن يصبح التأخير كبيرًا."] },
					{ Title: "إدارة التغييرات", Items: ["تسجيل طلبات التعديل وأثرها على الوقت والتكلفة قبل تنفيذها أو اعتمادها."] },
					{ Title: "مراجعة المستخلصات", Items: ["ربط الدفعات بالأعمال المقبولة وبنطاق التعاقد بدل الدفع على أساس تقديري غير موثق."] },
					{ Title: "تقارير دورية", Items: ["تقرير واضح للمالك عن الوضع الفني والمالي والزمني والمخاطر والقرارات المنتظرة."] }
				]}
			/>

		</HzStack>

	</EmoStrip>







	<ESec
		id="project-stages"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="مراحل إدارة المشروع الهندسي"
			pDesc="نعامل المشروع كمسار متصل. كل مرحلة لها مخرجات، وكل مخرج يتحول إلى قرار في المرحلة التالية. هذا يمنع القفز من فكرة عامة إلى تنفيذ مكلف دون بيانات كافية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("من الفكرة إلى الإغلاق")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("01 — تعريف المشروع", "تحديد الهدف، نوع المشروع، الأطراف، حدود الخدمة، المستندات المتاحة، والقرار المطلوب من الإدارة الهندسية.")}
			pTopic2={new Topic("02 — التخطيط", "بناء نطاق العمل، تسلسل المراحل، مسؤوليات الأطراف، خطة المشتريات، مؤشرات التكلفة، ونقاط الاعتماد.")}
			pTopic3={new Topic("03 — التعاقد", "تجهيز أساس فني لمقارنة عروض المقاولين والموردين، وتوضيح بنود التعاقد الحرجة قبل الالتزام المالي.")}
			pTopic4={new Topic("04 — التنفيذ", "متابعة التقدم، مراجعة المستخلصات، إدارة الملاحظات، ضبط الخامات، وإصدار تقارير دورية للمالك.")}
			pTopic5={new Topic("05 — التحكم", "متابعة الانحرافات الزمنية والمالية، تسجيل أوامر التغيير، إدارة المخاطر، وتعديل الخطة حسب الواقع.")}
			pTopic6={new Topic("06 — التسليم", "تجميع الملاحظات، متابعة الإغلاق، مراجعة المستندات النهائية، وتحديد الأعمال المتبقية قبل الاستلام النهائي.")}
		/>

	</ESec>







	<ESec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="الأطراف التي تنسق معها إدارة المشروع"
			pDesc="كلما زاد عدد الأطراف زادت فرص سوء الفهم. وظيفة الإدارة ليست إصدار أوامر فقط، بل تحويل التواصل إلى قرارات موثقة يعرف كل طرف ما عليه بعدها."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1517048676732-d65bc937f952?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"اجتماع تنسيق بين أطراف مشروع هندسي",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("من يدخل في دائرة الإدارة؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("نطاق الأطراف يختلف حسب حجم المشروع، لكن الفكرة واحدة: لا قرار بلا صاحب مسؤولية ولا تغيير بلا أثر معروف.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					"المالك أو ممثل المالك وصاحب القرار المالي.",
					"المصمم المعماري والإنشائي ومصممو الكهرباء والميكانيكا.",
					"المقاول العام أو مقاولو الباطن حسب طريقة التنفيذ.",
					"الموردون الرئيسيون للخامات أو المعدات طويلة التوريد.",
					"الاستشاري أو المشرف الفني عند وجود إشراف منفصل.",
					"الجهات المرتبطة بالترخيص أو الاعتماد أو إدارة المنشأة عند الحاجة."
				]}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="ما الذي نراجعه في بداية المشروع؟"
			pDesc="بداية الإدارة الجيدة ليست اجتماعًا عامًا. البداية الصحيحة هي فحص المستندات والقرارات المؤثرة، ثم تحويلها إلى قائمة نواقص وخطة عمل."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("ملف التصميم")}
				pDesc={Text.Body.WithColor("#333333").OfText("لا يمكن إدارة تنفيذ على تصميم غير مفهوم أو غير منسق.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "اكتمال الرسومات", Items: ["هل توجد مساقط وقطاعات وواجهات وتفاصيل كافية للتنفيذ أو التسعير؟"] },
					{ Title: "تنسيق التخصصات", Items: ["هل المعماري والإنشائي والكهرباء والميكانيكا متطابقون في المناسيب والفتحات والمسارات؟"] },
					{ Title: "المواصفات", Items: ["هل الخامات والمستويات واضحة، أم أن المقاول سيملأ الفراغات من عنده؟"] },
					{ Title: "نقاط الغموض", Items: ["ما البنود التي تحتاج قرارًا سريعًا قبل بدء التعاقد أو التنفيذ؟"] }
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("ملف التعاقد")}
				pDesc={Text.Body.WithColor("#333333").OfText("العقد غير الواضح هو بداية أغلب الخلافات المالية والزمنية.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "نطاق البنود", Items: ["ما الأعمال الداخلة والخارجة؟ وهل يشمل السعر توريدًا ومصنعية ونقلًا وهالكًا؟"] },
					{ Title: "طريقة القياس", Items: ["كيف سيتم قياس المستخلصات؟ بالمتر؟ بالقطعة؟ بالنسبة؟ أم على مراحل مكتملة؟"] },
					{ Title: "الدفعات", Items: ["هل الدفعات مربوطة بزمن فقط أم بإنجاز فعلي مقبول؟"] },
					{ Title: "التغييرات", Items: ["كيف يتم اعتماد أي تغيير في السعر أو الوقت قبل تنفيذه؟"] }
				]}
			/>

		</HzStack>

	</ESec>







	<EmoStrip
		id="time-cost"
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#111318")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#F4E5C4").OfText("الوقت والتكلفة والجودة ليست ملفات منفصلة")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("أي ضغط على الوقت يؤثر في التكلفة والجودة. وأي تغيير في الخامة قد يؤثر في المدة والتوريد. وأي تأخير في قرار المالك قد يضغط التنفيذ. الإدارة الهندسية تقرأ هذه العلاقات كمنظومة واحدة بدل متابعة كل بند في عزلة.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("ثلاثية التحكم في المشروع")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
