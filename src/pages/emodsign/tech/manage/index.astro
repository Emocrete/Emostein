---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="إدارة المشروعات الهندسية"
	pDescr="خدمة إدارة مشروعات هندسية للمالك أو المطور، تشمل تنظيم نطاق العمل، متابعة التصميم، الجدول الزمني، التكلفة، المشتريات، التنسيق بين الأطراف، التقارير، إدارة المخاطر، ومتابعة قرارات المشروع حتى التسليم."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("إدارة المشروعات الهندسية")}
				pText={Text.Body.Centered.OfText("خدمة إدارة مشروعات هندسية للمالك أو المطور، تشمل تنظيم نطاق العمل، متابعة التصميم، الجدول الزمني، التكلفة، المشتريات، التنسيق بين الأطراف، التقارير، إدارة المخاطر، ومتابعة قرارات المشروع حتى التسليم.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
