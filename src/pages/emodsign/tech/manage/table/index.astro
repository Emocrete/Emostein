---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="إعداد الجداول الزمنية للمشروعات الهندسية"
	pDescr="خدمة إعداد جدول زمني هندسي للمشروع تشمل تقسيم نطاق العمل، ترتيب الأنشطة، العلاقات المنطقية، المدد، المسار الحرج، خط الأساس، خطة التوريدات، تحديثات التقدم، وتقارير المتابعة للمشروعات السكنية والتجارية وأعمال البناء والتشطيبات."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("إعداد الجداول الزمنية للمشروعات الهندسية")}
				pText={Text.Body.Centered.OfText("خدمة إعداد جدول زمني هندسي للمشروع تشمل تقسيم نطاق العمل، ترتيب الأنشطة، العلاقات المنطقية، المدد، المسار الحرج، خط الأساس، خطة التوريدات، تحديثات التقدم، وتقارير المتابعة للمشروعات السكنية والتجارية وأعمال البناء والتشطيبات.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
