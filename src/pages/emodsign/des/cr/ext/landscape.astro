	<EmoFaq>

		<FaqItem
			pQuestion="هل تصميم اللاندسكيب يشمل التنفيذ؟"
			pAnswer="هذه الصفحة لخدمة التصميم. التنفيذ أو الإشراف أو توريد الخامات يمكن أن يكون خدمة منفصلة حسب نطاق المشروع والاتفاق."
		/>

		<FaqItem pQuestion="هل يمكن تصميم حديقة صغيرة؟" pAnswer="نعم. المساحات الصغيرة تحتاج تصميمًا أدق لأن كل متر فيها مؤثر في الحركة والجلوس والخصوصية والري." />

		<FaqItem
			pQuestion="هل الروف جاردن يحتاج حسابات خاصة؟"
			pAnswer="نعم، لأن الوزن والعزل والصرف والرياح عوامل مؤثرة. لا يتم التعامل مع الروف مثل حديقة أرضية عادية."
		/>

		<FaqItem
			pQuestion="هل تختارون أنواع النباتات؟"
			pAnswer="يمكن تحديد اتجاه النبات وأنواعه أو بدائله حسب الشمس والري والصيانة والصورة المطلوبة، مع ترك هامش للتوفر في السوق وقت التنفيذ."
		/>

		<FaqItem
			pQuestion="هل يمكن تصميم لاندسكيب حول مسبح؟"
			pAnswer="نعم، ويتم مراعاة الأمان والأرضيات المقاومة للانزلاق والإضاءة والخصوصية والنباتات التي لا تلوث المياه بأوراق كثيرة."
		/>

		<FaqItem
			pQuestion="هل يمكن العمل من الصور فقط؟"
			pAnswer="يمكن بدء تصور أولي من الصور والمخططات، لكن التصميم الأدق يحتاج أبعادًا واضحة أو رفعًا أو معاينة حسب مستوى المخرجات المطلوب."
		/>

		<FaqItem
			pQuestion="هل التصميم يشمل شبكة الري؟"
			pAnswer="يمكن أن يشمل تصورًا أو مخططًا عامًا لمناطق الري ونقاط التحكم، أما التصميم التنفيذي التفصيلي لشبكة الري فيحدد حسب نطاق الخدمة."
		/>

		<FaqItem
			pQuestion="هل الإضاءة الخارجية جزء من اللاندسكيب؟"
			pAnswer="نعم، الإضاءة عنصر أساسي لأنها تغير استخدام الحديقة ليلًا وتؤثر على الأمان والمظهر والراحة البصرية."
		/>

		<FaqItem
			pQuestion="ما الفرق بين الهاردسكيب والسوفت سكيب؟"
			pAnswer="الهاردسكيب هو العناصر الصلبة مثل الأرضيات والمشايات والبرجولات والجدران، والسوفت سكيب هو النباتات والمسطحات الخضراء والأشجار والشجيرات."
		/>

		<FaqItem
			pQuestion="هل يمكن تجديد حديقة موجودة بدل تصميم جديد؟"
			pAnswer="نعم، يمكن تقييم الحديقة الحالية وتحديد ما يمكن الاحتفاظ به وما يجب تغييره في الحركة والري والإضاءة والنباتات والخامات."
		/>

		<FaqItem
			pQuestion="هل العشب الصناعي أفضل من الطبيعي؟"
			pAnswer="لا يوجد اختيار أفضل دائمًا. الطبيعي أفضل عندما تتوفر مياه وصيانة واستخدام مناسب، والصناعي مناسب في بعض الرووف والمناطق التي تحتاج صيانة أقل."
		/>

		<FaqItem
			pQuestion="هل يتم تسليم ملف ثلاثي الأبعاد؟"
			pAnswer="يمكن الاتفاق على تصور ثلاثي الأبعاد ضمن نطاق الخدمة، خصوصًا إذا كان العميل يحتاج رؤية واضحة للخامات والجلسات والإضاءة قبل التنفيذ."
		/>

		<FaqItem
			pQuestion="هل التصميم يساعد في مقارنة عروض المقاولين؟"
			pAnswer="نعم، كلما كانت الرسومات والخامات والنطاق أوضح، أصبحت مقارنة عروض التنفيذ أكثر عدلًا وأقل اعتمادًا على كلام عام."
		/>

		<FaqItem
			pQuestion="ما أسرع طريقة لطلب عرض سعر؟"
			pAnswer="أرسل صور الموقع، المساحة أو المخطط، نوع المشروع، استخدام المساحة، وهل المطلوب تصور فقط أم ملف تصميم قابل للتنفيذ أو التسعير."
		/>

	</EmoFaq>







