---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تصميم لاندسكيب"
	pDescr="خدمات تصميم لاندسكيب للفلل والحدائق والروف والمساحات الخارجية، تشمل توزيع الجلسات والمشايات والهاردسكيب والسوفت سكيب والري والإضاءة الخارجية والمسطحات الخضراء ومخرجات التصميم المناسبة للتنفيذ والتسعير."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("35%","10%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم لاندسكيب")}
				pText={Text.Body.Centered.OfText("تصميم خارجي متكامل للحديقة والروف ومدخل الفيلا والجلسات والمشايات والزراعة والري والإضاءة، حتى تتحول المساحة المفتوحة إلى جزء مستخدم من المشروع لا مجرد فراغ أخضر حول المبنى.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec
		id="landscape-meaning"
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="تصميم اللاندسكيب ليس زراعة عشب حول المبنى"
			pDesc="الصفحة مبنية لخدمة تصميم خارجية كاملة: حركة، جلسات، هاردسكيب، زراعة، ري، إضاءة، خصوصية، صيانة، وتكلفة تنفيذ. العميل هنا لا يشتري صورة حديقة، بل يشتري قرارًا هندسيًا يجعل المساحة المفتوحة قابلة للاستخدام على مدار اليوم."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("المساحة الخارجية جزء من تشغيل المشروع")}
				pText={Text.Body.WithColor("#333333").OfText("حديقة الفيلا أو الروف أو المدخل التجاري لا تنجح بمجرد إضافة نباتات كثيرة. النجاح يبدأ من سؤال الاستخدام: أين يجلس أصحاب المكان، أين تمر حركة الضيوف، أين تتحرك الخدمة، أين تظهر الخصوصية، كيف يتم الري، كيف تعمل الإضاءة ليلًا، وما الخامات التي تتحمل الشمس والمياه والصيانة. التصميم الجيد يرتب هذه الأسئلة في مخطط واحد قبل شراء النباتات أو الأحجار أو وحدات الإضاءة.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1681465766418-6474cfdcbb3c?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"جلسة خارجية وممشى حجري داخل تصميم لاندسكيب حديث",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#0E1118")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #D9C89B "
			pTitle="ماذا نعني بخدمة تصميم لاندسكيب؟"
			pDesc="الخدمة تجمع التصميم الخارجي والتنسيق النباتي والقرارات التنفيذية التي تجعل الحديقة قابلة للبناء والتشغيل والصيانة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("نطاق التصميم الخارجي")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تخطيط الفراغ", "تحديد مناطق الجلوس والحركة والظل والخصوصية والمساحات المفتوحة، وربطها بمداخل المبنى والواجهة والمسبح والجراج والخدمات.")}
			pTopic2={new Topic("الهاردسكيب", "الأرضيات والمشايات والبردورات والسلالم والبرجولات والجدران القصيرة والأحواض المبنية ومناطق النار أو الشواء وأعمال الحجر والخشب والخرسانة.")}
			pTopic3={new Topic("السوفت سكيب", "اختيار الأشجار والشجيرات والمسطحات الخضراء والنباتات الموسمية والمتسلقة بما يناسب الشمس والري والصيانة وشكل المكان على مدار السنة.")}
			pTopic4={new Topic("الري والإضاءة", "تحديد شبكات الري ومناطق التحكم ومسارات التغذية، مع توزيع إضاءة وظيفية وجمالية للمشايات والجلسات والنباتات والواجهات.")}
		/>

	</EmoSec>







	<EmoStr
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#B9D6A5").OfText("تجميع محتوى الصفحة من واقع السوق لا من قالب جاهز")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("مواقع اللاندسكيب القوية في السوق تعرض الخدمة كمنظومة تشمل التصميم، الزراعة، الهاردسكيب، الري الذكي، الإضاءة الخارجية، وتجديد الحدائق القائمة. لذلك تم بناء الصفحة حول هذه المحاور بدل الاكتفاء بكلام عام عن الجمال والرفاهية.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("ما الذي يطلبه العميل فعليًا؟")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("كلمة لاندسكيب عند العميل قد تعني أكثر من خدمة، ولذلك تفصل الصفحة بين النوايا التجارية بدل جمعها في عنوان واحد.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={false}
				pItems={[
					"تصميم حديقة فيلا من الصفر مع جلسات ومشايات ومسطح أخضر.",
					"تجديد حديقة قائمة لأن توزيعها أو نباتاتها أو ريها لم يعد مناسبًا.",
					"تصميم روف جاردن خفيف الوزن مع جلسة وبرجولة وزراعة مناسبة.",
					"تحويل مدخل مشروع تجاري أو إداري إلى واجهة خارجية جاذبة.",
					"تجهيز مخطط تنفيذ يساعد المقاول على تسعير الخامات والري والإضاءة.",
					"اختيار نباتات وخامات تتحمل الجو والاستخدام بدل اختيارات شكلية قصيرة العمر."
				]}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("روح الصفحة الجديدة")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("صور داعمة", "تم إدخال صور خارجية مناسبة للمشايات والحدائق والإضاءة حتى لا تكون الصفحة كلامًا متراكمًا دون مشهد بصري.")}
				pTopic2={new Topic("تقسيمات عملية", "تم تقسيم الخدمة إلى فيلا، روف، تجاري، ري، إضاءة، خامات، نباتات، تنفيذ، صيانة، ومخرجات.")}
				pTopic3={new Topic("نص يخدم البيع", "كل قسم يشرح مشكلة واقعية وحلًا واضحًا، وليس مجرد عبارات عن الذوق والفخامة.")}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		id="landscape-axes"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="محاور تصميم اللاندسكيب"
			pDesc="أي تصميم خارجي ناجح يتكون من طبقات متداخلة: طبقة الحركة، طبقة الخامات، طبقة النبات، طبقة المياه، طبقة الإضاءة، وطبقة الصيانة."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("محاور وظيفية")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه المحاور تحدد كيف سيستخدم الناس الحديقة قبل التفكير في خامة البلاطة أو لون النبات.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الحركة والمداخل", Items: ["مسار الضيف من البوابة إلى الباب", "حركة السيارة والجراج", "مسارات الخدمة والصيانة", "المشايات اليومية التي لا تفسد المسطح الأخضر"] },
					{ Title: "الجلوس والاستخدام", Items: ["جلسة صباحية ظليلة", "جلسة ليلية قرب الإضاءة أو النار", "منطقة طعام أو شواء", "أماكن انتظار أو استقبال عند المدخل"] },
					{ Title: "الخصوصية", Items: ["حجب الرؤية من الجيران أو الشارع", "اختيار نباتات أو حوائط تحقق الخصوصية", "توجيه الجلسات بعيدًا عن نقاط الكشف", "حماية المسبح أو مناطق العائلة"] },
					{ Title: "الربط بالمبنى", Items: ["تناسق الواجهة مع الحديقة", "ربط الأبواب الخارجية بالمشايات", "استثمار التراسات والبلكونات", "مراعاة الشبابيك والإطلالات الداخلية"] }
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("محاور تنفيذية")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه المحاور تحول المشهد الجميل إلى تصميم يمكن تنفيذه وصيانته دون مفاجآت كبيرة.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الخامات والأرضيات", Items: ["حجر أو بورسلين خارجي أو خرسانة مطبوعة", "مقاومة الانزلاق", "تحمل المياه والشمس", "تفاصيل صرف حول الأرضيات"] },
					{ Title: "النباتات", Items: ["اختيار حسب الشمس والظل", "جذور لا تضر المنشأ", "احتياج ري مناسب", "تدرج في الارتفاع واللون والكثافة"] },
					{ Title: "الري والصرف", Items: ["تقسيم مناطق الري", "مسارات المواسير", "تجميع المياه الزائدة", "إتاحة الصيانة دون تكسير"] },
					{ Title: "الإضاءة الخارجية", Items: ["إضاءة مشايات", "إضاءة نباتات", "إضاءة جلسات", "تغذية وتحكم وحماية للمصابيح الخارجية"] }
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="الصورة قبل النص: الحديقة لها مزاج بصري"
			pDesc="استخدام الصور داخل الصفحة ليس للزينة فقط؛ كل صورة تربط العميل بفكرة محددة: ممشى، جلسة، ظل، إضاءة، خامة، نباتات، أو علاقة بين المبنى والحديقة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://images.unsplash.com/",
					"photo-1752646011500-0a5b82275415?auto=format&fit=crop&fm=jpg&q=70&w=1600",
					false,
					"ممشى حجري وحديقة فيلا",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("الممشى يصنع تجربة الدخول")}
				pText={Text.Body.WithColor("#333333").OfText("مسار الدخول ليس خطًا يصل البوابة بالباب. هو أول تجربة يراها الزائر في المشروع: عرض المسار، خامته، طريقة الإضاءة، النباتات حوله، إحساس الخصوصية، ونقطة ظهور الواجهة. لذلك يتم تصميم المشايات كجزء من المشهد الكامل، مع مراعاة الاستخدام اليومي، سهولة التنظيف، صرف المياه، ومقاومة الانزلاق.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="villa-landscape"
		pBg={new ElemBg("#0E1118")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #D9C89B "
			pTitle="تصميم لاندسكيب فلل"
			pDesc="لاندسكيب الفيلا يربط الحياة الداخلية بالخارج: مدخل، حديقة، مسبح، جلسات، جراج، سور، إضاءة، ومناطق خدمة. تصميمه يجب أن يقرأ أسلوب حياة الأسرة قبل توزيع النباتات."
		/>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("ما الذي نهتم به في فيلا خاصة؟")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مدخل الفيلا", "تحديد مسار الدخول، نقطة استقبال الضيف، علاقة الباب الرئيسي بالمشايات، ومشهد الواجهة من أول لحظة.")}
			pTopic2={new Topic("جلسات العائلة", "تحديد جلسة يومية مريحة لها ظل وخصوصية وقرب من الخدمات دون أن تكون مكشوفة أو معزولة عن البيت.")}
			pTopic3={new Topic("المسبح والسطح المائي", "تنظيم العلاقة بين المسبح والجلسات والأرضيات والإضاءة والصرف والسلامة حول الحواف.")}
			pTopic4={new Topic("الحدود والسور", "استخدام نباتات أو حوائط أو شاشات لتقليل الكشف البصري وتحسين المشهد حول حدود الأرض.")}
			pTopic5={new Topic("الحركة والخدمة", "مسارات واضحة للسيارات والخدمة والصيانة دون تقطيع الجلسات أو إفساد المسطح الأخضر.")}
			pTopic6={new Topic("الليل والنهار", "الحديقة يجب أن تعمل نهارًا بالظل والراحة، وليلًا بالإضاءة الآمنة والمريحة والموزعة بذكاء.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="أنواع حدائق الفلل التي يمكن تصميمها"
			pDesc="النمط لا يختار من صورة فقط. يتم اختياره حسب مساحة الأرض، شكل المبنى، مستوى الصيانة، الميزانية، والذوق المطلوب."
		/>

		<CardsGr
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نماذج تصميم مناسبة")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("حديقة مودرن", "خطوط مستقيمة، أحواض واضحة، نباتات مختارة بكثافة محسوبة، أرضيات واسعة، إضاءة بسيطة، ومساحات جلوس مرتبطة بالواجهة.")}
			pTopic2={new Topic("حديقة طبيعية", "كتل نباتية أكثر حرية، مسارات ناعمة، تدرج في الظل، خامات حجرية أو خشبية، وإحساس أقل رسمية وأكثر قربًا للطبيعة.")}
			pTopic3={new Topic("حديقة عائلية", "تركز على الأمان، مساحة لعب، جلسة قريبة من الداخل، رؤية واضحة للأطفال، نباتات غير مؤذية، ومناطق خدمة سهلة الوصول.")}
			pTopic4={new Topic("حديقة ضيافة", "تخصص للانطباع الأول، جلسات استقبال، إضاءة قوية، مسارات واضحة، وحجب مدروس للمناطق الخاصة داخل الفيلا.")}
			pTopic5={new Topic("حديقة منخفضة الصيانة", "توازن بين نباتات قليلة الاحتياج للمياه، مسطحات غير مزروعة، أحواض منظمة، وري مقسم يقلل الهدر والصيانة اليومية.")}
			pTopic6={new Topic("حديقة مسبح", "تجمع بين الأمان، الخصوصية، الأرضيات المقاومة للانزلاق، الظل، الإضاءة المحيطية، والنباتات المناسبة للرطوبة والرذاذ.")}
		/>

	</EmoSec>







	<EmoStr
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#111318")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#B9D6A5").OfText("اللاندسكيب التجاري يحتاج منطقًا مختلفًا")}
