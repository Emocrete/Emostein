---
import { Align, ElemBg, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoCall, EmoContactStrip, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, SecTitle } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تصميم واجهات"
	pDescr="خدمة تصميم واجهات فلل ومنازل وعمارات ومحلات ومباني تجارية، تشمل دراسة شكل الواجهة والخامات والألوان والإضاءة الخارجية والتفاصيل التنفيذية والتنسيق مع المعماري والإنشائي والتشطيب."
>







	<Hero
		pImgF="/Media/Emodsign/Des/Cr/Ext/Facade/"
		pTitle="تصميم واجهات"
		pDesc="واجهة المبنى هي أول رسالة يراها العميل أو الزائر أو الساكن؛ لذلك نصممها كقرار معماري وتجاري وتنفيذي، لا كزخرفة خارجية منفصلة عن المبنى."
		pTitleClr="#F6E7C6"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="16% 52% 12% 8%"
		pPosP="12% 8% 45% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب تصميم الواجهة" />

	</Hero>







	<ESec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="تصميم واجهة يرفع قيمة المبنى قبل التشطيب"
			pDesc="تصميم الواجهة لا يبدأ من اختيار حجر أو لون دهان. يبدأ من قراءة كتلة المبنى، أماكن الفتحات، علاقة الداخل بالخارج، اتجاهات الشمس، مستوى الخصوصية، طبيعة الشارع، وطريقة تنفيذ التفاصيل على أرض الواقع."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("الواجهة ليست صورة جميلة فقط")}
				pText={Text.Body.WithColor("#333333").OfText("الواجهة الناجحة تربط بين الجمال والوظيفة. تحدد أين تظهر الفتحات، كيف تدخل الإضاءة الطبيعية، كيف تُقرأ كتلة المبنى من الشارع، كيف تحافظ على الخصوصية، وكيف يمكن تنفيذ الخامات بدون تفاصيل تسبب تسريبًا أو تشققات أو تكلفة غير مبررة. لذلك نتعامل مع تصميم الواجهات كجزء من التصميم المعماري والتشطيب الخارجي في نفس الوقت.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("ما الذي نضبطه؟")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.Centered.WithColor("#111318")}
				pCardBodyFnt={Text.Body.Centered.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("الكتلة", "توازن البروزات والارتدادات والارتفاعات ونِسب الفتحات حتى تبدو الواجهة منضبطة لا عشوائية.")}
				pTopic2={new Topic("الخامات", "اختيار خامات مناسبة للمناخ والصيانة والميزانية، وليس مجرد خامة منتشرة في صور الإنترنت.")}
				pTopic3={new Topic("التنفيذ", "تحويل الفكرة إلى تفاصيل قابلة للتنفيذ والتسعير، مع مراعاة الفواصل والتثبيت والحماية من المياه.")}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#111318")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تحتاج تصميم واجهة؟"
			pDesc="احتياج تصميم الواجهة لا يرتبط بالمباني الجديدة فقط. أحيانًا يكون المبنى قائمًا، لكن الواجهة تحتاج إعادة صياغة كاملة حتى تناسب الاستخدام الجديد أو ترفع قيمته السوقية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F6E7C6").OfText("حالات مناسبة لخدمة تصميم الواجهات")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("واجهة فيلا جديدة", "عند تصميم فيلا من البداية وتحتاج واجهة متناسقة مع التوزيع الداخلي والحديقة والسور والمدخل الرئيسي والجراج.")}
			pTopic2={new Topic("تطوير واجهة قائمة", "عند وجود مبنى قائم أو هيكل منفذ وتريد تحسين شكله دون هدم أو تعديلات إنشائية كبيرة.")}
			pTopic3={new Topic("واجهة عمارة", "عند الحاجة إلى معالجة واجهة متعددة الأدوار بحيث لا تصبح مجرد تكرار شبابيك وبلكونات بلا إيقاع معماري.")}
			pTopic4={new Topic("واجهة نشاط تجاري", "عند تصميم محل أو مطعم أو عيادة أو معرض يحتاج واجهة تبيع الخدمة وتوضح الهوية من أول نظرة.")}
			pTopic5={new Topic("تغيير طراز", "عند الرغبة في تحويل واجهة تقليدية إلى مودرن أو نيو كلاسيك أو طراز أكثر هدوءًا دون فقدان التناسب.")}
			pTopic6={new Topic("تجهيز للتنفيذ", "عند وجود صورة أو فكرة عامة وتحتاج تحويلها إلى رسومات وخامات ومقاسات قابلة للتسعير والتنفيذ.")}
		/>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("من أين يبدأ تصميم الواجهة؟")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("الواجهة الجيدة لا تُرسم على كتلة مجهولة. نبدأ بقراءة المبنى ثم نصمم طبقات الواجهة: النسب، الفتحات، الخامات، الظلال، الإضاءة، التفاصيل، والتكلفة التقريبية.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F6E7C6").OfText("مدخلات التصميم")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("هذه البيانات تجعل التصميم قريبًا من واقع المبنى بدل أن يكون شكلًا عامًا يصلح لأي مكان.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pNumbered={false}
				pItems={[
					"صور واضحة للواجهة الحالية أو الأرض أو الهيكل المنفذ.",
					"المساقط والقطاعات والواجهات إن وجدت بصيغة PDF أو CAD.",
					"أبعاد الأرض والارتدادات وعدد الأدوار وارتفاعات الأدوار.",
					"طراز الواجهة المفضل: مودرن، نيو كلاسيك، كلاسيك، بسيط، فاخر، أو تجاري.",
					"مستوى الميزانية المتوقع للخامات والتنفيذ.",
					"أي قيود من جهاز المدينة أو اتحاد الملاك أو نشاط المحل."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F6E7C6").OfText("قرارات التصميم")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("كل قرار في الواجهة له أثر على الشكل والتكلفة والصيانة وطريقة التنفيذ.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pNumbered={false}
				pItems={[
					"إيقاع الفتحات وتوزيع الشبابيك والبلكونات والبروزات.",
					"تحديد خامة أو أكثر للواجهة دون تضارب بصري أو مبالغة.",
					"اختيار أماكن الإضاءة الخارجية وتأثيرها ليلًا.",
					"تحديد معالجة المداخل والسور والجراج والتراس عند وجودها.",
					"مراعاة الخصوصية وتظليل الشمس وراحة المستخدم الداخلي.",
					"تجهيز تصور يمكن تطويره إلى رسومات تنفيذ وتفاصيل تشطيب."
				]}
			/>

		</HzStack>

	</EmoStrip>







	<ESec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="أنماط تصميم الواجهات"
			pDesc="الطراز ليس اسمًا نختاره من قائمة. الطراز يجب أن يناسب كتلة المبنى، مساحة الواجهة، طبيعة المنطقة، الميزانية، وطريقة التنفيذ المتاحة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("اختيار الطراز المناسب")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("واجهة مودرن", "تعتمد على بساطة الكتلة، الخطوط الواضحة، الزجاج، الإضاءة الخفية، خامات محدودة، وتفاصيل نظيفة لا تحتاج زخارف كثيرة.")}
			pTopic2={new Topic("واجهة نيو كلاسيك", "تجمع بين الفخامة الهادئة والتماثل والنسب الرأسية وبعض التفاصيل الكلاسيكية الخفيفة دون ازدحام في الكرانيش والزخارف.")}
			pTopic3={new Topic("واجهة كلاسيك", "تناسب بعض الفلل والقصور عندما تسمح المساحة والميزانية والارتفاعات بإظهار الأعمدة والكرانيش والزخارف بتناسب صحيح.")}
			pTopic4={new Topic("واجهة تجارية", "تركز على وضوح النشاط، اللافتة، مساحة العرض، الإضاءة، المدخل، والرؤية من الشارع أكثر من الزخرفة السكنية.")}
			pTopic5={new Topic("واجهة بسيطة اقتصادية", "تعتمد على دهانات خارجية أو خامات محدودة مع توزيع جيد للكتلة والألوان، وتناسب أصحاب الميزانيات المحددة.")}
			pTopic6={new Topic("واجهة مختلطة", "تستخدم الحجر أو الخشب الصناعي أو الشرائح المعدنية أو الزجاج بنسب محسوبة حتى لا تتحول الواجهة إلى خليط خامات غير منضبط.")}
		/>

	</ESec>







	<ESec pBg={new ElemBg("#F7F1E6")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="الخامات في تصميم الواجهات"
			pDesc="اختيار خامة الواجهة قرار جمالي وتنفيذي ومالي. الخامة التي تبدو ممتازة في الرندر قد تكون مكلفة في التركيب، أو تحتاج صيانة عالية، أو لا تناسب موقع المبنى."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("خامات شائعة")}
				pDesc={Text.Body.WithColor("#333333").OfText("لا نختار الخامة لأنها مشهورة فقط، بل حسب مكانها في الواجهة وطريقة تثبيتها وصيانتها.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "دهانات خارجية", Items: ["حل اقتصادي ومرن في الألوان، لكنه يحتاج معالجة جيدة للسطح وتفاصيل تمنع اتساخ مناطق معينة بسرعة."] },
					{ Title: "حجر طبيعي أو صناعي", Items: ["يعطي ثقلًا وفخامة، لكنه يحتاج تحديد سماكات وفواصل وتثبيت ومناطق استخدام محسوبة."] },
					{ Title: "رخام أو جرانيت", Items: ["مناسب لمداخل ومناطق مختارة، ولا يفضل استخدامه بلا دراسة بسبب الوزن والتكلفة والفواصل."] },
					{ Title: "شرائح معدنية أو كلادينج", Items: ["تعطي طابعًا حديثًا خصوصًا في الواجهات التجارية، وتحتاج تفاصيل حواف وتثبيت دقيقة."] },
					{ Title: "زجاج وفتحات كبيرة", Items: ["يضيف شفافية وحداثة، لكنه يتطلب دراسة للخصوصية والشمس والأمان والتنظيف."] }
				]}
			/>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("الخلطة الصحيحة أهم من سعر الخامة")}
				pText={Text.Body.WithColor("#333333").OfText("واجهة مليئة بخامات غالية قد تبدو أضعف من واجهة بسيطة إذا كانت النسب غير صحيحة. القيمة في توزيع الخامات لا في عددها. نحدد أين يجب أن تكون الخامة الرئيسية، أين تظهر خامة مساعدة، أين نستخدم اللون فقط، وأين يكون الظل أو الإضاءة كافيًا لصناعة العمق دون زيادة تكلفة التنفيذ.")}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="تصميم واجهات الفلل"
			pDesc="واجهة الفيلا تحتاج قراءة مختلفة عن العمارة أو المحل. الفيلا لها مدخل، سور، جراج، حديقة، تراسات، خصوصية، وعلاقة مباشرة بين الداخل والخارج."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("575px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("فيلا جديدة")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("تنسيق مع المسقط", "لا نغلق فتحة مهمة ولا نغير مكان شباك فقط لتجميل الواجهة؛ بل نعيد ضبط العلاقة بين الداخل والخارج.")}
				pTopic2={new Topic("مدخل واضح", "مدخل الفيلا يجب أن يكون مفهومًا من البوابة، مميزًا دون مبالغة، ومتصلاً بالحركة الداخلية بشكل مريح.")}
				pTopic3={new Topic("سور وحديقة", "السور والبوابة واللاندسكيب جزء من صورة الفيلا، وليس عناصر تضاف في نهاية التصميم.")}
			/>

			<CardsGr
				pWidth={new RespString("575px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("فيلا قائمة")}
				pCardBg={new ElemBg("#111318")}
				pCardTitleFnt={Text.H4.WithColor("#D9B86C")}
				pCardBodyFnt={Text.Body.WithColor("#F8F4EA")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("استثمار الموجود", "نستغل الفتحات والبروزات القائمة بدل اقتراح حلول مكلفة تحتاج تكسيرًا أو تعديلًا إنشائيًا كبيرًا.")}
				pTopic2={new Topic("تحسين الواجهة", "يمكن تغيير شخصية الفيلا عبر خامات وألوان وإضاءة وتفاصيل مداخل دون إعادة بناء الشكل بالكامل.")}
				pTopic3={new Topic("حصر تكلفة أوضح", "عند التصميم على واقع منفذ يمكن تقدير مناطق التشطيب والدهانات والحجر والإضاءة بصورة أقرب للتنفيذ.")}
			/>

		</HzStack>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#111318")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#F6E7C6").OfText("تصميم واجهات العمارات والمباني المتعددة")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("واجهة العمارة لا يجب أن تتحول إلى شبكة مملة من الشبابيك والبلكونات. المطلوب إيقاع واضح يعالج التكرار، ويحافظ على تكلفة مناسبة، ويراعي الصيانة وسهولة التنفيذ على ارتفاعات متعددة.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("محاور واجهة العمارة")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("إيقاع رأسي وأفقي", "تنظيم الشرفات والفتحات والكتل بحيث يظهر المبنى كواجهة واحدة لا كأدوار منفصلة.")}
			pTopic2={new Topic("حل البلكونات", "معالجة البلكونات كجزء من التصميم عبر درابزين أو إطار أو خامة أو ظل، لا كعنصر ملحق بالواجهة.")}
			pTopic3={new Topic("الدور الأرضي", "تصميم المدخل والمحلات أو الجراجات أو الخدمات بطريقة لا تضعف صورة العمارة من مستوى الشارع.")}
