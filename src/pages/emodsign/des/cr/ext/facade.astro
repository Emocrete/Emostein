---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Align, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تصميم واجهات"
	pDescr="خدمة تصميم واجهات فلل ومنازل وعمارات ومحلات ومباني تجارية، تشمل دراسة شكل الواجهة والخامات والألوان والإضاءة الخارجية والتفاصيل التنفيذية والتنسيق مع المعماري والإنشائي والتشطيب."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم وتنفيذ واجهات")}
				pText={Text.Body.Centered.OfText("خدمة تصميم واجهات فلل ومنازل وعمارات ومحلات ومباني تجارية، تشمل دراسة شكل الواجهة والخامات والألوان والإضاءة الخارجية والتفاصيل التنفيذية والتنسيق مع المعماري والإنشائي والتشطيب.")}
			/>

			<EmoCall BlackSky pText="تواصل معنا" />

		</VrStack>

	</Hero>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			pTitle="أنماط تصميم الواجهات"
			pDesc="الطراز ليس اسمًا نختاره من قائمة. الطراز يجب أن يناسب كتلة المبنى، مساحة الواجهة، طبيعة المنطقة، الميزانية، وطريقة التنفيذ المتاحة."
		/>

		<CardsGr
			pSize={new Size(new NumPer("80%", "95%"))}
			pWidth={new Pixel(1600,320)}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مودرن", "تعتمد على بساطة الكتلة، الخطوط الواضحة، الزجاج، الإضاءة الخفية، خامات محدودة، وتفاصيل نظيفة لا تحتاج زخارف كثيرة.")}
			pTopic2={new Topic("نيو كلاسيك", "تجمع بين الفخامة الهادئة والتماثل والنسب الرأسية وبعض التفاصيل الكلاسيكية الخفيفة دون ازدحام في الكرانيش والزخارف.")}
			pTopic3={new Topic("كلاسيك", "تناسب بعض الفلل والقصور عندما تسمح المساحة والميزانية والارتفاعات بإظهار الأعمدة والكرانيش والزخارف بتناسب صحيح.")}
			pTopic4={new Topic("تجارية", "تركز على وضوح النشاط، اللافتة، مساحة العرض، الإضاءة، المدخل، والرؤية من الشارع أكثر من الزخرفة السكنية.")}
		/>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle Sky pTitle="مراحل خدمة تصميم الواجهة" />

		<CardsGr
			pWidth={new RespString("1700px", "320px")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("01 - فهم الحالة", "استلام الصور والرسومات والقياسات، وفهم هل الواجهة لمبنى جديد أم مبنى قائم أم نشاط تجاري.")}
			pTopic2={new Topic("02 - اتجاه الطراز", "اختيار اتجاه تصميم مناسب للعميل والموقع والميزانية: مودرن، نيو كلاسيك، تجاري، بسيط، أو مزيج محسوب.")}
			pTopic3={new Topic("03 - التصميم ثلاثي الأبعاد", "إظهار الواجهة بصريًا مع توزيع الخامات والألوان والإضاءة والعناصر الرئيسية بصورة مفهومة للعميل.")}
			pTopic4={new Topic("04 - مراجعة وتعديل", "مراجعة الملاحظات المهمة وتثبيت القرار قبل تحويل الفكرة إلى ملف أكثر قابلية للتنفيذ والتسعير.")}
			pTopic5={new Topic("05 - مخرجات التسليم", "تسليم الصور أو الرسومات أو توصيف الخامات أو التفاصيل حسب مستوى الخدمة المتفق عليه.")}
		/>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#111318")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle style = " --StripBg : #E7D3A1 " pTitle="ماذا تستلم" />

		<CardsGr
			pWidth={new RespString("1700px", "320px")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تصميم ثلاثي الأبعاد", "إظهار الواجهة بشكل بصري أوضح مع توزيع الخامات والألوان والإنارة والعناصر الرئيسية.")}
			pTopic2={new Topic("لوحات تنفيذية", "واجهات بأبعاد ومناسيب أساسية تساعد في فهم العلاقات ونقاط التنفيذ الرئيسية.")}
			pTopic3={new Topic("توصيف خامات", "قائمة خامات مقترحة ومناطق استخدامها وألوانها واتجاهاتها، بما يساعد في التسعير والشراء.")}
		/>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن تصميم الواجهة من صورة فقط؟"
			pAnswer="يمكن البدء من الصور لفهم الحالة، لكن كلما توفرت أبعاد ورسومات وقطاعات كانت النتيجة أدق وأكثر قابلية للتنفيذ والتسعير."
		/>

		<FaqItem
			pQuestion="هل تصميم الواجهة يشمل الخامات؟"
			pAnswer="يمكن أن يشمل التصميم توزيع الخامات والألوان وتوصيفًا عامًا لها. أما تحديد ماركات ومقاسات وتفاصيل توريد دقيقة فيتم الاتفاق عليه حسب مستوى الخدمة."
		/>

		<FaqItem
			pQuestion="هل يمكن تصميم واجهة لمبنى قائم؟"
			pAnswer="نعم، وهذه حالة شائعة. يتم التعامل مع الفتحات والبروزات القائمة وتحسين الشكل بأقل تعديلات ممكنة حسب الميزانية والحالة الإنشائية."
		/>

		<FaqItem
			pQuestion="هل التصميم يشمل الإضاءة الخارجية؟"
			pAnswer="يمكن إدخال الإضاءة الخارجية ضمن التصميم، خصوصًا في الفلل والمداخل والواجهات التجارية، مع تحديد أماكنها وتأثيرها العام ومسارات التغذية عند الحاجة."
		/>

		<FaqItem
			pQuestion="هل أحتاج تصميم معماري كامل قبل تصميم الواجهة؟"
			pAnswer="إذا كان المبنى جديدًا ولم تعتمد المساقط والفتحات، فالأفضل ضبط التصميم المعماري أولًا. أما إذا كان المبنى قائمًا أو الفتحات ثابتة، فيمكن العمل على الواجهة مباشرة."
		/>

		<FaqItem
			pQuestion="هل يمكن تنفيذ الواجهة من الرندر مباشرة؟"
			pAnswer="الرندر يوضح الشكل، لكنه لا يكفي وحده في الحالات التي تحتاج تفاصيل فواصل وتثبيت وخامات وإضاءة ومقاسات. مستوى التفاصيل المطلوب يتحدد حسب المقاول وطريقة التنفيذ."
		/>

		<FaqItem
			pQuestion="ما الفرق بين واجهة مودرن ونيو كلاسيك؟"
			pAnswer="المودرن يعتمد على البساطة والخطوط الواضحة والخامات المحدودة، بينما النيو كلاسيك يستخدم تناسبًا أكثر رسمية وتفاصيل كلاسيكية هادئة دون ازدحام زخرفي."
		/>

		<FaqItem
			pQuestion="هل يمكن تصميم واجهة محل أو مطعم؟"
			pAnswer="نعم، والواجهة التجارية تحتاج قراءة مختلفة لأنها مرتبطة بالهوية والبيع ووضوح النشاط وتجربة العميل من الشارع."
		/>

	</EmoFaq>







	<RelServices
		pTitle={Text.H2.Centered.WithColor("#F6E7C6").OfText("خدمات أخرى")}
		pHeadBg={new ElemBg("#0E1118")}
		pBodyBg={new ElemBg("#F7F1E6")}
		pCardBg={new ElemBg("#FFFFFF")}
	>

		<RelServiceItem
			pTitle="تصميم لاندسكيب"
			pDesc="تنسيق الحديقة والممرات والجلسات والسور والإنارة الخارجية مع واجهة الفيلا أو المبنى."
			pHref="/emodsign/des/cr/ext/landscape"
		/>

		<RelServiceItem
			pTitle="تشطيب فيلا"
			pDesc="تنفيذ التشطيبات الداخلية والخارجية والواجهات والمداخل والحدائق ضمن مشروع فيلا كامل."
			pHref="/emocrete/finishing/villa"
		/>

		<RelServiceItem
			pTitle="تشطيب محلات تجارية"
			pDesc="تنفيذ واجهة النشاط التجاري واللافتة والديكور والتشطيب بما يخدم البيع والتشغيل."
			pHref="/emocrete/finishing/retail"
		/>

	</RelServices>







</BLayout>
