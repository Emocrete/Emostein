---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تصميم لاندسكيب"
	pDescr="خدمات تصميم لاندسكيب للفلل والحدائق والروف والمساحات الخارجية، تشمل توزيع الجلسات والمشايات والهاردسكيب والسوفت سكيب والري والإضاءة الخارجية والمسطحات الخضراء ومخرجات التصميم المناسبة للتنفيذ والتسعير."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("35%","10%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.OfText("تصميم لاندسكيب")} />

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon />

				<EmoWhatsIcon />

				<EmoDet Gold pHref="#secSrvCost" pHeight="58px" />

			</HzStack>

		</VrStack>

	</Hero>







	<RelServices>

		<RelServiceItem pTitle="تصميم واجهات" pDesc="ربط شكل المبنى بالخامات والإضاءة والمشايات والنباتات الخارجية." pHref="/emodsign/des/cr/ext/facade" />

		<RelServiceItem pTitle="تصميم داخلي" pDesc="تنسيق الداخل مع التراسات والإطلالات والجلسات الخارجية والحديقة." pHref="/emodsign/des/cr/int" />

		<RelServiceItem pTitle="حصر كميات" pDesc="تحويل رسومات التصميم إلى بنود وكميات تساعد في تسعير التنفيذ ومقارنة العروض." pHref="/emodsign/tech/takeoff" />

		<RelServiceItem pTitle="تشطيب فلل" pDesc="تنفيذ وتشطيب الفلل مع ربط الداخل والواجهة والحديقة والمداخل الخارجية." pHref="/emocrete/finishing/villa" />

	</RelServices>







</BLayout>
