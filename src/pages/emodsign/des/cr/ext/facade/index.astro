---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoSec, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Align, ElemBg, Loc, NumPer, Pixel, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تصميم واجهات"
	pDescr="خدمة تصميم واجهات فلل ومنازل وعمارات ومحلات ومباني تجارية، تشمل دراسة شكل الواجهة والخامات والألوان والإضاءة الخارجية والتفاصيل التنفيذية والتنسيق مع المعماري والإنشائي والتشطيب."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم وتنفيذ واجهات")}
				pText={Text.Body.Centered.OfText("خدمة تصميم واجهات فلل ومنازل وعمارات ومحلات ومباني تجارية، تشمل دراسة شكل الواجهة والخامات والألوان والإضاءة الخارجية والتفاصيل التنفيذية والتنسيق مع المعماري والإنشائي والتشطيب.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon />

				<EmoWhatsIcon />

				<EmoDet Gold pHref="#secSrvCost" pHeight="58px" />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg("#FFFFFF")} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle pTitle="أنماط تصميم الواجهات" />

		<CardsGr
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H3}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مودرن", "تعتمد على بساطة الكتلة، الخطوط الواضحة، الزجاج، الإضاءة الخفية، خامات محدودة، وتفاصيل نظيفة لا تحتاج زخارف كثيرة.")}
			pTopic2={new Topic("نيو كلاسيك", "تجمع بين الفخامة الهادئة والتماثل والنسب الرأسية وبعض التفاصيل الكلاسيكية الخفيفة دون ازدحام في الكرانيش والزخارف.")}
			pTopic3={new Topic("كلاسيك", "تناسب بعض الفلل والقصور عندما تسمح المساحة والميزانية والارتفاعات بإظهار الأعمدة والكرانيش والزخارف بتناسب صحيح.")}
			pTopic4={new Topic("تجارية", "تركز على وضوح النشاط، اللافتة، مساحة العرض، الإضاءة، المدخل، والرؤية من الشارع أكثر من الزخرفة السكنية.")}
		/>

	</EmoSec>







	<RelServices>

		<RelServiceItem
			pTitle="تصميم لاندسكيب"
			pDesc="تنسيق الحديقة والممرات والجلسات والسور والإنارة الخارجية مع واجهة الفيلا أو المبنى."
			pHref="/emodsign/des/cr/ext/landscape"
		/>

		<RelServiceItem
			pTitle="تشطيب فيلا"
			pDesc="تنفيذ التشطيبات الداخلية والخارجية والواجهات والمداخل والحدائق ضمن مشروع فيلا كامل."
			pHref="/emocrete/finishing/villa"
		/>

		<RelServiceItem
			pTitle="تشطيب محلات تجارية"
			pDesc="تنفيذ واجهة النشاط التجاري واللافتة والديكور والتشطيب بما يخدم البيع والتشغيل."
			pHref="/emocrete/finishing/retail"
		/>

	</RelServices>







</BLayout>
