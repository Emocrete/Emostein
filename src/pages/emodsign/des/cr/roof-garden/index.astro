---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, MosaicGrid, MosaicItem } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="تصميم Roof Garden"
	pDescr="تصميم Roof Garden — تصميم داخلي يترجم استخدام المكان والهوية والميزانية إلى توزيع وفراغات وخامات وإضاءة وتفاصيل قابلة للتنفيذ والتسعير. ويُبنى نطاق تصميم Roof Garden على حالة المشروع الفعلية لا على وصف عام للخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="تصميم Roof Garden">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("تصميم Roof Garden")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("تصميم داخلي يترجم استخدام المكان والهوية والميزانية إلى توزيع وفراغات وخامات وإضاءة وتفاصيل قابلة للتنفيذ والتسعير. ويُبنى نطاق تصميم Roof Garden على حالة المشروع الفعلية لا على وصف عام للخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<MosaicGrid pColumns={12} pColumnsP={4} pAutoRows={new RespString("82px","70px")} pGap={new RespString("10px","8px")} pPad={new RespString("42px","10px")} pBg={Colors.Gray1}>
		<MosaicItem pColSpan={5} pColSpanP={4} pRowSpan={3} pRowSpanP={2} pBg={Colors.BrownDark} pColor={Colors.WhiteOff}>
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("المخرج الرئيسي")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("رسومات تنفيذية وتفاصيل حسب نطاق الخدمة.")} />
		</MosaicItem>
		<MosaicItem pColSpan={3} pColSpanP={2} pRowSpan={2} pRowSpanP={2} pBg={Colors.SkyLite} pColor={Colors.Black}>
			<Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("01")} pText={Text.Body.WithColor(Colors.Black).OfText("توزيع وظيفي واتجاه بصري")} />
		</MosaicItem>
		<MosaicItem pColSpan={4} pColSpanP={2} pRowSpan={2} pRowSpanP={2} pBg={Colors.BistageLite} pColor={Colors.Black}>
			<Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("02")} pText={Text.Body.WithColor(Colors.Black).OfText("اختيار الخامات والإضاءة والعناصر الثابتة")} />
		</MosaicItem>
		<MosaicItem pColSpan={7} pColSpanP={4} pRowSpan={2} pRowSpanP={2} pBg={Colors.Creamy} pColor={Colors.Black}>
			<Emograph pTitle={Text.H3.WithColor(Colors.Black).OfText("لماذا الآن؟")} pText={Text.Body.WithColor(Colors.Black).OfText("يقلل قرارات الموقع العشوائية ويعطي المقاولين أساسًا واضحًا للحصر والتسعير قبل شراء الخامات أو بدء التشطيب. ويظل القرار النهائي مرتبطًا ببيانات تصميم Roof Garden نفسها قبل إصدار العرض.")} />
		</MosaicItem>
	</MosaicGrid>

	<AngleBand id="secSrvCost" pBg={Colors.Black} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("استرشاديًا يبدأ من 200 ج.م/م² للتصميم التفصيلي، حسب مستوى الإظهار والرسومات المطلوبة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
