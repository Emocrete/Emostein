---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تصميم داخلي"
	pDescr="خدمة تصميم داخلي للشقق والفلل والمكاتب والمحلات والمطاعم والعيادات، تشمل توزيع الفراغات، اختيار الطراز والخامات والألوان والإضاءة والأثاث، وتجهيز رسومات ومخرجات تساعد على التنفيذ والتسعير بدون ارتجال."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم داخلي")}
				pText={Text.Body.Centered.OfText("نحوّل المساحة إلى تجربة استخدام مريحة ومنظمة: توزيع ذكي، ألوان محسوبة، إضاءة مدروسة، خامات مناسبة، وأثاث يخدم الحياة اليومية أو التشغيل التجاري.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon />

				<EmoWhatsIcon />

				<EmoDet Gold pHref="#secSrvCost" pHeight="58px" />

			</HzStack>

		</VrStack>

	</Hero>







	<RelServices>

		<RelServiceItem
			pTitle="تشطيب شقق"
			pDesc="تنفيذ وتشطيب الشقق السكنية وفق مستوى خامات وتفاصيل مناسب للميزانية والتصميم."
			pHref="/emocrete/finishing/apartment"
		/>

		<RelServiceItem pTitle="تشطيب فلل" pDesc="تشطيب فلل ومنازل خاصة مع تنسيق الفراغات الداخلية والخارجية ومستوى الخامات." pHref="/emocrete/finishing/villa" />

		<RelServiceItem pTitle="تشطيب محلات" pDesc="تنفيذ وتشطيب محلات وأنشطة تجارية مع مراعاة الهوية والإضاءة وحركة العملاء." pHref="/emocrete/finishing/retail" />

		<RelServiceItem
			pTitle="شوب دروينج معماري"
			pDesc="إخراج تفاصيل تنفيذية للحوائط والأسقف والأرضيات والنجارة بما يساعد المقاول على التنفيذ."
			pHref="/emodsign/tech/shopdwg/arch"
		/>

		<RelServiceItem
			pTitle="إشراف هندسي على التشطيبات"
			pDesc="متابعة الخامات والبنود والعمال والدفعات لضمان توافق التنفيذ مع التصميم والمواصفات."
			pHref="/emocrete/supervision/finishing"
		/>

	</RelServices>







</BLayout>
