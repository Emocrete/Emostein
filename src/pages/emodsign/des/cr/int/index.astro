---
import BLayout from "@/Layout.astro";
import { Text, Topic, ElemBg, Colors, RespString, Pixel, Size, Align } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, CardsGr, EmoList, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تصميم داخلي"
	pDescr="خدمة تصميم داخلي للشقق والفلل والمكاتب والمحلات والمطاعم والعيادات، تشمل توزيع الفراغات، اختيار الطراز والخامات والألوان والإضاءة والأثاث، وتجهيز رسومات ومخرجات تساعد على التنفيذ والتسعير بدون ارتجال."
>







	<Hero
		pImgF="/Media/Emodsign/Des/Cr/Int/"
		pTitle="تصميم داخلي"
		pDesc="نحوّل المساحة إلى تجربة استخدام مريحة ومنظمة: توزيع ذكي، ألوان محسوبة، إضاءة مدروسة، خامات مناسبة، وأثاث يخدم الحياة اليومية أو التشغيل التجاري."
		pTitleClr="#FFF2C8"
		pDescClr={Colors.WhiteOff}
		pAlign="right"
		pPosL="14% 52% 12% 7%"
		pPosP="12% 8% 46% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب تصميم داخلي" />

	</Hero>







	<ESec pBg={new ElemBg("#F7F1E6")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #111318 "
			pTitle="التصميم الداخلي يبدأ من طريقة استخدام المكان"
			pDesc="المساحة الداخلية تجمع الدهانات والأثاث والصورة النهائية داخل نظام استخدام واضح. القرار الصحيح يبدأ من فهم من يستخدم المكان، كيف يتحرك داخله، أين يحتاج تخزينًا، كيف يدخل الضوء الطبيعي، أين توضع الكهرباء والتكييف، وما مستوى الخامات المناسب للميزانية وطبيعة الاستخدام."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(560, "auto", 320, "auto")}
				pTitle={Text.H3.WithColor("#111318").OfText("الديكور نتيجة، أما التصميم فهو قرار")}
				pText={Text.Body.WithColor("#333333").OfText("عند تصميم شقة أو فيلا أو مكتب أو محل، يتجاوز القرار اختيار لون حائط أو شكل كنبة. التصميم الداخلي يربط المسقط بالأثاث، السقف بالإضاءة، الخامات بطريقة التنظيف والصيانة، الألوان بمساحة المكان، ومسارات الحركة باحتياج المستخدم. لذلك تكون قيمة الخدمة في تحويل المساحة إلى نظام واضح قابل للتنفيذ والتسعير، مع طابع بصري يناسب صاحب المكان أو هوية النشاط.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("نضبط 4 طبقات معًا")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.Centered.WithColor("#111318")}
				pCardBodyFnt={Text.Body.Centered.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("الاستخدام", "توزيع الفراغات حسب الحركة، الخصوصية، التخزين، الأنشطة اليومية، وطريقة التشغيل.")}
				pTopic2={new Topic("الشكل", "اختيار الطراز والألوان والإيقاع البصري والنسب بين الجدران والأسقف والأثاث.")}
				pTopic3={new Topic("التنفيذ", "تحويل الفكرة إلى رسومات ومقاسات وخامات وتفاصيل يمكن للمقاول قراءتها.")}
				pTopic4={new Topic("الميزانية", "تحديد الأولويات بين خامات ثابتة، أثاث، إضاءة، نجارة، وستائر بدل توزيع المال بعشوائية.")}
			/>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#111318")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="متى تحتاج خدمة تصميم داخلي؟"
			pDesc="الخدمة مناسبة للمشروعات الجديدة، والتجديد، وتغيير الاستخدام، والمساحات التجارية التي تحتاج هوية واضحة وتجربة عميل منظمة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#FFF2C8").OfText("حالات عملية نعمل عليها")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("شقة جديدة", "توزيع الأثاث، اختيار الطراز، تحديد أعمال الكهرباء والجبس والإضاءة، وتجهيز رؤية واضحة قبل بداية التشطيب.")}
			pTopic2={new Topic("فيلا أو دوبلكس", "ربط المدخل والمعيشة والسلم والغرف والحديقة الداخلية أو الخارجية بطابع واحد، مع إدارة مساحات كبيرة وتفاصيل أكثر.")}
			pTopic3={new Topic("تجديد مساحة قائمة", "إعادة قراءة المكان الحالي، تحديد ما يُحافظ عليه وما يُغيّر، وتقديم حلول واقعية لا تتطلب هدمًا غير مبرر.")}
			pTopic4={new Topic("مكتب أو شركة", "تنظيم استقبال، مكاتب، غرف اجتماع، تخزين، حركة موظفين، صوتيات، إضاءة عمل، وطابع يعبر عن هوية الشركة.")}
			pTopic5={new Topic("محل أو معرض", "تصميم مسار العميل، مناطق العرض، الكاشير، التخزين، الإضاءة التجارية، وواجهة داخلية تدعم البيع.")}
			pTopic6={new Topic("مطعم أو عيادة", "تنسيق مناطق العملاء والخدمة، مسارات التشغيل، الخامات سهلة التنظيف، الإضاءة، والارتباط بالكهرباء والميكانيكا.")}
		/>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#0E1118")}
		pSize={new Size("100%", "auto", "100%", "auto")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#151923")}
			pSize={new Size(1200, "auto", "calc(100% - 20px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("تصميم داخلي يربط الجمال بالتنفيذ")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("الصور المرجعية تعطي اتجاهًا بصريًا، لكنها لا تكفي لتنفيذ مكان ناجح. التنفيذ يحتاج مساقط أثاث، مخططات كهرباء، أماكن الإضاءة، خامات محددة، مقاسات نجارة، تفاصيل أسقف، ومراجعة العلاقة بين التصميم والتشطيب والميزانية.")}
				pSize={new Size(1000, "auto", 320, "auto")}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#FFF2C8").OfText("أخطاء تظهر عند غياب التصميم")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("أكثر مشاكل التشطيب الداخلي تبدأ من قرار غير محسوب قبل التنفيذ.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={false}
				pItems={[
					"برايز ومفاتيح في أماكن لا تخدم الأثاث الفعلي.",
					"سقف جبس جميل لكنه يخفض ارتفاع المكان أو يضرب مسار التكييف.",
					"ألوان وخامات تبدو جيدة منفردة لكنها لا تعمل معًا داخل نفس الفراغ.",
					"نجارة مخصصة بمقاسات غير مريحة أو تخزين لا يكفي الاستخدام اليومي.",
					"إضاءة قوية أو ضعيفة بسبب عدم فصل الإضاءة العامة عن الوظيفية والمزاجية.",
					"مشتريات عشوائية للأثاث قبل تثبيت المقاسات ومسارات الحركة."
				]}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#FFF2C8").OfText("ما الذي يمنعه التصميم؟")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("قرارات متأخرة", "بدل اختيار كل بند وقت حضور العامل، يتم تثبيت الاتجاه والمقاسات والتفاصيل قبل بدء التشطيب.")}
				pTopic2={new Topic("هدر في الخامات", "تحديد المقاسات والتوزيعات يقلل شراء كميات خاطئة أو تغيير بند بعد تنفيذه.")}
				pTopic3={new Topic("خلاف مع المقاول", "كلما كانت الرسومات أوضح، أصبح تقييم السعر والتنفيذ والاستلام أسهل على الطرفين.")}
			/>

		</HzStack>

	</EmoStrip>







	<ESec pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="مستويات خدمة التصميم الداخلي"
			pDesc="يمكن طلب الخدمة بمستوى بسيط للاستشارة والاتجاه العام، أو بمستوى تفصيلي كامل يساعد على التنفيذ والتسعير. تحديد المستوى من البداية يحميك من توقعات غير واضحة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("اختر مستوى المخرجات حسب مرحلة مشروعك")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("استشارة تصميم", "مناسبة لمن يحتاج توجيهًا سريعًا في توزيع أو ألوان أو خامات أو مشكلة في غرفة محددة قبل اتخاذ قرار.")}
			pTopic2={new Topic("Concept ومود بورد", "تحديد الطراز، لوحة الألوان، الخامات، الإحساس العام، صور مرجعية منظمة، واتجاه مبدئي للمكان.")}
			pTopic3={new Topic("مساقط توزيع", "توزيع أثاث ومسارات حركة وتخزين ووظائف الفراغات قبل شراء الأثاث أو تنفيذ الكهرباء والجبس.")}
			pTopic4={new Topic("تصميم ثلاثي الأبعاد", "رؤية بصرية تساعد العميل على فهم النتيجة المقترحة قبل التنفيذ، خصوصًا في الفراغات الرئيسية.")}
			pTopic5={new Topic("رسومات تنفيذية", "تفاصيل أسقف، أرضيات، حوائط، كهرباء، نجارة، مقاسات، قطاعات، وملاحظات تساعد المقاول على التنفيذ.")}
			pTopic6={new Topic("متابعة اختيار الخامات", "مساعدة في ضبط الخامات والألوان والبدائل ضمن الميزانية، وربطها بالرسومات قبل الشراء.")}
		/>

	</ESec>







	<ESec pBg={new ElemBg("#F7F1E6")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #111318 "
			pTitle="الفرق بين التصميم الداخلي والتشطيب والتأثيث"
			pDesc="كثير من العملاء يخلطون بين هذه المراحل. الفصل بينها يساعد في اختيار الخدمة الصحيحة وتحديد المسؤوليات قبل التعاقد."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("ثلاث مراحل متصلة")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("التصميم الداخلي", "يحدد توزيع الفراغات، الطراز، الألوان، الخامات، الإضاءة، الأثاث، الرسومات، ومبدأ التنفيذ.")}
				pTopic2={new Topic("التشطيب", "ينفذ البنود الثابتة مثل الكهرباء والسباكة والجبس والأرضيات والدهانات والنجارة الثابتة.")}
				pTopic3={new Topic("التأثيث", "يختار أو يصمم القطع المتحركة مثل الأرائك، الطاولات، الكراسي، الستائر، السجاد، والإكسسوارات.")}
			/>

			<Emograph
				pSize={new Size(560, "auto", 320, "auto")}
				pTitle={Text.H3.WithColor("#111318").OfText("الأفضل أن يسبق التصميم مرحلة التشطيب")}
				pText={Text.Body.WithColor("#333333").OfText("عندما يبدأ التشطيب قبل التصميم، تظهر قرارات مكلفة لاحقًا: نقل كهرباء، إعادة دهان، تعديل جبس، تغيير مقاسات نجارة، أو شراء أثاث لا يناسب المساحة. لذلك نفضل تثبيت التصميم الداخلي قبل البنود التي يصعب تغييرها مثل نقاط الكهرباء، أماكن الإضاءة، توزيع التكييف، تفاصيل الأسقف، ومقاسات النجارة الثابتة.")}
			/>

		</HzStack>

	</ESec>







	<EmoStrip
		pBg={new ElemBg("#F7F1E6")}
		pSize={new Size("100%", "auto", "100%", "auto")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#111318")}
			pSize={new Size(1200, "auto", "calc(100% - 20px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#FFF2C8").OfText("خدماتنا حسب نوع المساحة")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("التصميم الداخلي السكني يختلف عن التجاري. المنزل يحتاج راحة وخصوصية وتخزينًا، بينما النشاط التجاري يحتاج هوية واضحة وحركة عملاء وتشغيلًا منظمًا وعائدًا من كل متر.")}
				pSize={new Size(1000, "auto", 320, "auto")}
			/>

		</EmoStrip>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("كل استخدام له أولويات مختلفة")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("غرف المعيشة والاستقبال", "توازن بين الجلوس، الحركة، التلفاز، التخزين، الإضاءة، الضيافة، والارتباط بباقي الشقة أو الفيلا.")}
			pTopic2={new Topic("غرف النوم والدريسنج", "راحة بصرية، تخزين كافٍ، إضاءة هادئة، مقاسات عملية، ومسار حركة واضح بين السرير والدولاب والحمام.")}
			pTopic3={new Topic("المطابخ", "مثلث حركة عملي، تخزين، تهوية، مقاومة رطوبة، أماكن أجهزة، وإضاءة عمل واضحة فوق مناطق التحضير.")}
			pTopic4={new Topic("المكاتب", "إنتاجية، صوتيات، إضاءة عمل، مساحات اجتماع، استقبال، تخزين، هوية بصرية، وراحة للموظفين والزوار.")}
			pTopic5={new Topic("المحلات والمعارض", "رحلة عميل، مناطق عرض، إضاءة منتجات، كاشير، تخزين، لافتات داخلية، وتحفيز قرار الشراء.")}
			pTopic6={new Topic("المطاعم والكافيهات", "توزيع جلسات، مسارات خدمة، خامات تتحمل الاستخدام، إضاءة مزاجية، وارتباط التصميم بالتهوية والكهرباء والصرف.")}
		/>

	</EmoStrip>







	<ESec pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="محاور التصميم الداخلي التي نراجعها"
			pDesc="هذه المحاور تتحول داخل المشروع إلى رسومات، اختيارات، ملاحظات تنفيذ، أو توصيات حسب مستوى الخدمة المطلوب."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("قرارات وظيفية")}
				pDesc={Text.Body.WithColor("#333333").OfText("تحدد كيف يعمل المكان يوميًا قبل التفكير في الشكل النهائي.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "توزيع الأثاث", Items: ["اختيار أماكن القطع الرئيسية والمسارات حولها ومسافة الاستخدام المريحة."] },
					{ Title: "الحركة والخصوصية", Items: ["فصل مناطق الضيوف عن الخاص، وتسهيل الوصول للفراغات المهمة دون ازدحام."] },
					{ Title: "التخزين", Items: ["تحديد وحدات التخزين المفتوحة والمغلقة والدريسنج والمكتبات والمخازن الصغيرة."] },
					{ Title: "التشغيل والصيانة", Items: ["مراعاة التنظيف، الوصول للخدمات، تحمل الخامات، ومواقع الأجهزة والمعدات."] }
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("قرارات بصرية وتنفيذية")}
				pDesc={Text.Body.WithColor("#333333").OfText("تترجم الهوية المطلوبة إلى خامات وتفاصيل قابلة للتنفيذ.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "الطراز والألوان", Items: ["تحديد اتجاه مودرن أو كلاسيك أو نيو كلاسيك أو بسيط، مع لوحة ألوان متماسكة."] },
					{ Title: "الإضاءة", Items: ["فصل الإضاءة العامة والوظيفية والمزاجية، وربطها بالسقف والأثاث والاستخدام."] },
					{ Title: "الخامات", Items: ["اختيار أرضيات ودهانات وكسوات ونجارة وأقمشة تناسب الميزانية والاستخدام والصيانة."] },
