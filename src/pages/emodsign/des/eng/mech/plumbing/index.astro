---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { SplitPane, SplitScene, StoryRail, StoryStep } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="تصميم أعمال السباكة والصرف"
	pDescr="تصميم أعمال السباكة والصرف — تصميم ميكانيكي يربط الأحمال والاستخدام ومسارات الخدمات بالمعدات والشبكات المطلوبة، مع التنسيق المبكر مع العمارة والإنشاء والكهرباء. وفي هذه الصفحة يكون التركيز الخاص على الميول والتصرف والتهوية ومنع الرجوع وربط الشبكات بنقاط التجميع. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="تصميم أعمال السباكة والصرف">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("تصميم أعمال السباكة والصرف")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("تصميم ميكانيكي يربط الأحمال والاستخدام ومسارات الخدمات بالمعدات والشبكات المطلوبة، مع التنسيق المبكر مع العمارة والإنشاء والكهرباء. وفي هذه الصفحة يكون التركيز الخاص على الميول والتصرف والتهوية ومنع الرجوع وربط الشبكات بنقاط التجميع.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<StoryRail pBg={Colors.Black} pTrackColor={Colors.Gray4} pAccent={Colors.Bistage} pGap={new RespString("24px","14px")} pPad={new RespString("44px","12px")}>
		<StoryStep pNumber="01" pKicker="البداية" pTitle="حساب الطلب" pText="حساب الأحمال والاحتياجات التصميمية مع مراعاة الميول والتصرف والتهوية ومنع الرجوع وربط الشبكات بنقاط التجميع." pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<StoryStep pNumber="02" pKicker="المعالجة" pTitle="اختيار النظام" pText="اختيار النظام والمعدات والمسارات." pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<StoryStep pNumber="03" pKicker="المخرج" pTitle="إصدار التصميم" pText="مخططات وحسابات وجداول ومواصفات." pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
	</StoryRail>

	<SplitScene id="secSrvCost" pBg={Colors.Gray1} pColumns={new RespString("5fr 7fr","1fr")} pGap={new RespString("12px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("القيمة العملية")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("يقلل التعارضات أثناء التنفيذ ويمنع اختيار معدات أو أقطار أو مسارات قبل معرفة الطلب الحقيقي للمشروع. ويُراجع القرار هنا تحديدًا في ضوء الميول والتصرف والتهوية ومنع الرجوع وربط الشبكات بنقاط التجميع.")} />
		</SplitPane>
		<SplitPane pBg={Colors.WhiteOff} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("السعر المبدئي")} pText={Text.Body.WithColor(Colors.Black).OfText("يبدأ من 10,000 ج.م للمهمة الصغيرة أو حسب المساحة وتعقيد النظام.")} />
		</SplitPane>
	</SplitScene>

</BLayout>
