---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تصميم هندسي ميكانيكا MEP"
	pDescr="خدمة تصميم ميكانيكا للمباني والمنشآت تشمل رسومات السباكة والصحي وتغذية المياه والصرف الصحي، ورسومات التكييف والتهوية HVAC، ورسومات مكافحة الحريق Fire Fighting، مع حسابات الأحمال، اختيار المعدات، المخططات، الجداول، والتنسيق مع باقي التخصصات."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم هندسي ميكانيكا MEP")}
				pText={Text.Body.Centered.OfText("خدمة تصميم ميكانيكا للمباني والمنشآت تشمل رسومات السباكة والصحي وتغذية المياه والصرف الصحي، ورسومات التكييف والتهوية HVAC، ورسومات مكافحة الحريق Fire Fighting، مع حسابات الأحمال، اختيار المعدات، المخططات، الجداول، والتنسيق مع باقي التخصصات.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			pTitle="التصميم الميكانيكي هو البنية الخفية لراحة المبنى وتشغيله"
			pDesc="المبنى قد يبدو مكتملًا من الخارج، لكن جودة استخدامه اليومية تعتمد على أنظمة لا يراها العميل غالبًا: مياه تصل بضغط مناسب، صرف يعمل دون روائح أو ارتجاع، تكييف وتهوية مريحان، ونظام مكافحة حريق واضح في مساراته ومعداته. لذلك يتم تصميم الميكانيكا كمنظومة تشغيل كاملة لا كرسومات منفصلة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#101820").OfText("تصميم ميكانيكا قبل التنفيذ")}
				pText={Text.Body.WithColor("#333333").OfText("نبدأ من طبيعة المبنى واستخدامه، ثم نحدد الأنظمة المطلوبة، ومسارات المواسير والدكت، ومواقع المعدات، وغرف الخدمات، ونقاط الربط مع المعماري والإنشائي والكهرباء. النتيجة تكون ملفًا ميكانيكيًا واضحًا يساعد في التسعير والتنفيذ والمراجعة وتقليل التعارضات داخل الموقع.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"",
					"HeroL.webp",
					false,
					"تصميم ميكانيكا للمباني",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#101820")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="فروع التصميم الميكانيكي داخل الصفحة"
			pDesc="هذه الصفحة تجمع الفروع الأساسية مؤقتًا في صفحة واحدة، بحيث تكون كل خدمة واضحة بذاتها إلى أن يتم لاحقًا فصل كل مجال في صفحة مستقلة متخصصة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#EED7A1").OfText("نطاقات الخدمة الحالية")}
			pCardBg={new ElemBg("#F7F1E8")}
			pCardTitleFnt={Text.H4.WithColor("#101820")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("رسومات السباكة والصحي", "تصميم تغذية المياه الباردة والساخنة، الصرف الصحي، صرف الأمطار، غرف التفتيش، المناور، الرايزرات، الخزانات، المضخات، ومسارات المواسير داخل المبنى.")}
			pTopic2={new Topic("رسومات تكييف و HVAC", "حساب الأحمال الحرارية، اختيار نوع النظام، توزيع مخارج الهواء، تصميم الدكت، مسارات مواسير الفريون أو المياه المبردة، والتهوية وسحب الهواء.")}
			pTopic3={new Topic("رسومات مكافحة الحريق", "تصميم شبكات الرشاشات وخراطيم الحريق وغرف المضخات ومسارات المواسير ونقاط الربط، مع مراعاة طبيعة الإشغال ومتطلبات الحماية.")}
			pTopic4={new Topic("تنسيق MEP", "مراجعة التعارضات بين الميكانيكا والمعماري والإنشائي والكهرباء، وتحديد الفتحات والشفتات ومسارات الخدمات قبل التنفيذ.")}
		/>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#101820")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#172430")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#C6A15B").OfText("من الرسم إلى نظام قابل للتشغيل")}
				pText={Text.Body.Centered.WithColor("#F7F1E8").OfText("رسومات الميكانيكا الجيدة لا تكتفي بوضع خطوط على المسقط، بل توضح المسار، المنسوب، القطر، المعدة، نقطة الصيانة، ومساحة الحركة حول كل عنصر مهم.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#EED7A1").OfText("مدخلات التصميم")}
				pDesc={Text.Body.WithColor("#F7F1E8").OfText("هذه البيانات تجعل التصميم أدق وتقلل التعديلات بعد بدء العمل.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pNumbered={false}
				pItems={[
					"المخططات المعمارية النهائية أو شبه النهائية.",
					"نوع المبنى: سكني، تجاري، إداري، طبي، صناعي، مطعم، أو منشأة خدمية.",
					"عدد الأدوار والبدروم والسطح وغرف الخدمات.",
					"اشتراطات الجهة المالكة أو الاستشاري أو جهة الترخيص إن وجدت.",
					"أماكن الشفتات والمناور وغرف المضخات والخزانات ووحدات التكييف.",
					"مستوى المخرجات المطلوب: Design، Shop Drawing، BOQ، أو As Built."
				]}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#EED7A1").OfText("مخرجات عامة")}
				pCardBg={new ElemBg("#F7F1E8")}
				pCardTitleFnt={Text.H4.WithColor("#101820")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("مخططات تصميم", "توزيع الأنظمة ومساراتها الأساسية على المساقط والقطاعات حسب احتياج المشروع.")}
				pTopic2={new Topic("جداول ومواصفات", "جداول معدات ومخارج ومواسير ودكت وقواطع حريق حسب نطاق الخدمة المتفق عليه.")}
				pTopic3={new Topic("ملفات قابلة للتطوير", "يمكن تحويل التصميم لاحقًا إلى شوب دروينج، حصر كميات، أو نموذج Revit MEP عند الحاجة.")}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="أولًا: رسومات السباكة والصحي وتغذية المياه والصرف"
			pDesc="تصميم أعمال السباكة والصحي يضمن وصول المياه للمستخدمين بطريقة مستقرة، وخروج الصرف من المبنى بأمان، وتنظيم الرايزرات والمناور والخزانات والمضخات وغرف التفتيش دون إرباك معماري أو إنشائي."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("نصمم في أعمال السباكة")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#101820")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("تغذية المياه", "مسارات المياه الباردة والساخنة، الرايزرات، الخزانات، المضخات، السخانات، ومواقع المحابس ونقاط الفصل.")}
				pTopic2={new Topic("الصرف الصحي", "صرف الحمامات والمطابخ والمغاسل والأجهزة، مع تنظيم المسارات والميول والرايزرات ونقاط التنظيف.")}
				pTopic3={new Topic("صرف الأمطار", "تجميع مياه الأسطح والبلكونات والمناطق المكشوفة وتوجيهها بمسارات آمنة لا تضر الواجهة أو التشطيب.")}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#101820").OfText("تفاصيل مهمة في رسومات الصحي")}
				pDesc={Text.Body.WithColor("#333333").OfText("الرسمة الناجحة تجعل السباك يعرف المسار والقطر والمنسوب ونقطة الصيانة قبل التنفيذ.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					"تحديد أماكن الرايزرات داخل المناور أو الشفتات المناسبة.",
					"توضيح أقطار مواسير التغذية والصرف حسب طبيعة الاستخدام.",
					"تنظيم مواسير التهوية Vent الخاصة بالصرف عند الحاجة.",
					"توزيع المحابس الرئيسية والفرعية لتسهيل العزل والصيانة.",
					"تحديد مسارات صرف التكييف والمطابخ والحمامات وغرف الخدمات.",
					"مراعاة عدم تعارض المواسير مع الكمرات أو الفتحات أو التشطيبات."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")}>

		<SecTitle
			style = " --StripBg : #101820 "
			pTitle="مخرجات رسومات السباكة والصحي"
			pDesc="يمكن تنفيذ مخرجات السباكة والصحي حسب مرحلة المشروع: تصميم مبدئي، تصميم تفصيلي، شوب دروينج، أو حصر كميات."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("ملف السباكة قد يشمل")}
			pCardBg={new ElemBg("#F7F1E8")}
			pCardTitleFnt={Text.H4.WithColor("#101820")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("Water Supply Layout", "مخططات تغذية المياه وتوزيع النقاط والمسارات والرايزرات والخزانات والمضخات.")}
			pTopic2={new Topic("Drainage Layout", "مخططات الصرف الصحي ومسارات المواسير وغرف التفتيش ونقاط التنظيف والتهوية.")}
			pTopic3={new Topic("Riser Diagram", "رسم رأسي يوضح صعود وهبوط المواسير والعلاقات بين الأدوار والمصادر والمخارج.")}
			pTopic4={new Topic("Pump Room Layout", "تنظيم غرفة المضخات والخزانات والمحابس والعدادات ومناطق الصيانة.")}
			pTopic5={new Topic("Plumbing BOQ", "حصر مبدئي أو تفصيلي للمواسير والمحابس والإكسسوارات والمعدات حسب نطاق العمل.")}
			pTopic6={new Topic("Coordination Notes", "ملاحظات تنسيق مع المعماري والإنشائي والكهرباء لتفادي التعارضات في التنفيذ.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="ثانيًا: رسومات التكييف والتهوية HVAC"
			pDesc="تصميم HVAC الجيد يوازن بين الراحة الحرارية، جودة الهواء، استهلاك الطاقة، المسارات المعمارية، وضوضاء التشغيل. اختيار النظام لا يتم بالاسم التجاري فقط، بل حسب طبيعة المساحة، عدد المستخدمين، اتجاهات الشمس، الاستخدام، ومكان المعدات."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#101820").OfText("ما الذي يتم تصميمه في HVAC؟")}
				pDesc={Text.Body.WithColor("#333333").OfText("نحدد النظام المناسب ثم نحول الفكرة إلى مخططات ومسارات ومعدات واضحة.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					"حساب الأحمال الحرارية Cooling Load وHeating Load حسب طبيعة المشروع.",
					"اختيار نوع النظام: Split، Concealed، Package، VRF، Chilled Water، أو نظام تهوية فقط.",
					"تصميم مسارات الدكت وتوزيع مخارج الهواء Grilles وDiffusers.",
					"تصميم مسارات مواسير الفريون أو المياه المبردة حسب نوع النظام.",
					"حساب وتوزيع الهواء النقي Fresh Air وسحب الهواء Exhaust.",
					"اختيار مواقع المعدات الخارجية والداخلية مع مراعاة الصيانة والضوضاء والتصريف."
				]}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("أنظمة نخدمها")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#101820")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("منازل وفيلات", "تكييف غرف ومعيشة وريسبشن ومطابخ وخدمات، مع حلول مخفية أو ظاهرة حسب التصميم الداخلي.")}
				pTopic2={new Topic("محلات ومطاعم", "تهوية وسحب روائح ومخارج هواء وتكييف مناسب للكثافة الحرارية وطبيعة التشغيل.")}
				pTopic3={new Topic("مكاتب ومباني إدارية", "توزيع مناطق التكييف والتهوية بما يناسب ساعات التشغيل وعدد المستخدمين وتقسيم الفراغات.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#101820")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#172430")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#C6A15B").OfText("مخرجات رسومات HVAC")}
				pText={Text.Body.Centered.WithColor("#F7F1E8").OfText("يتم إعداد رسومات التكييف والتهوية بطريقة تسمح بالمراجعة الفنية، والتنسيق مع الديكور والسقف المستعار والكهرباء، ثم التطوير إلى تنفيذ أو حصر كميات.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#EED7A1").OfText("ملف HVAC قد يشمل")}
			pCardBg={new ElemBg("#F7F1E8")}
			pCardTitleFnt={Text.H4.WithColor("#101820")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("Load Calculation", "حساب الأحمال الحرارية لتحديد السعات المطلوبة بدل اختيار أجهزة أكبر أو أصغر من الاحتياج.")}
			pTopic2={new Topic("Duct Layout", "مسارات الدكت ومقاساته ومخارج الهواء والراجع والفريش إير والإكزوست حسب النظام.")}
			pTopic3={new Topic("Piping Layout", "مسارات مواسير الفريون أو المياه المبردة أو التكثيف حسب نوع التكييف المستخدم.")}
			pTopic4={new Topic("Equipment Schedule", "جدول معدات يوضح السعات والأنواع والمواقع والملاحظات الفنية المهمة.")}
			pTopic5={new Topic("Ventilation Drawings", "تهوية الحمامات والمطابخ والمخازن والمناطق المغلقة وسحب الهواء حسب طبيعة الاستخدام.")}
			pTopic6={new Topic("BOQ وتنسيق", "حصر كميات وملاحظات تنسيق مع الكهرباء والسقف المستعار والفتحات المعمارية والإنشائية.")}
		/>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="ثالثًا: رسومات مكافحة الحريق Fire Fighting"
			pDesc="نظام مكافحة الحريق يجب أن يكون واضحًا في التغطية والمسارات والمضخات والمحابس ونقاط الاختبار والصيانة. التصميم يعتمد على طبيعة الإشغال، مساحة المناطق، ارتفاعات السقف، غرف الخدمات، ومسارات الهروب والتنسيق مع المعماري والكهرباء."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("أنظمة مكافحة الحريق")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#101820")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
