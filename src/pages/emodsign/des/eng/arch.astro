---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="خدمات تصميم هندسي معماري"
	pDescr="خدمات تصميم معماري للمنازل والفلل والعمارات والمباني التجارية والإدارية، تشمل توزيع المساحات، الواجهات، المناسيب، القطاعات، الرسومات التنفيذية، والتنسيق مع التصميم الإنشائي والتراخيص."
>







	<Hero
		pImgF="/Media/Emodsign/Des/Eng/Arch/"
		pTitle="تصميم معماري فاخر"
		pDesc="رسم هندسي معماري للمباني السكنية والتجارية والإدارية والخدمية، من الفكرة الأولى حتى مخطط قابل للتنفيذ والترخيص."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="18% 52% 12% 8%"
		pPosP="14% 8% 42% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="ابدأ تصميم مشروعك" />

	</Hero>







	<EmoSec pBg={new ElemBg("#F7F1E6")}>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="تصميم معماري يصنع قيمة قبل أن يرسم واجهة"
			pDesc="التصميم الجيد يقرأ الأرض، والاحتياج، والميزانية، والاشتراطات، ثم يحولها إلى مبنى مريح وواضح وقابل للتنفيذ. الفخامة هنا ليست زخرفة، بل قرار محسوب في كل مساحة وفتحة وحركة ومنسوب."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("رسم هندسي معماري للمباني")}
				pText={Text.Body.WithColor("#333333").OfText("يحدد التصميم المعماري طريقة تنسيق الواجهات بالشكل الذي يتلائم مع أماكن وأحجام المنافذ المطلة عليها للحصول على إطلالة خارجية جذابة متناسقة مع الوسط المحيط به. كما يحدد المناسيب وارتفاعات الأدوار المناسبة وأماكن الأبواب والشبابيك واتساع منافذ التهوية والإضاءة الطبيعية المناسب لطبيعة واستخدام المبنى.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_c6b1f8ad95ae43778cb89210d298f82e~mv2.webp/v1/fill/w_1905,h_800,al_c,q_85,enc_avif,quality_auto/308dfd_c6b1f8ad95ae43778cb89210d298f82e~mv2.webp",
					false,
					"رسم هندسي معماري للمباني",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#111318")}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="ما الذي يضبطه التصميم المعماري؟"
			pDesc="قبل أي تنفيذ ناجح يجب أن تكون العلاقات المعمارية مفهومة على الورق: أين يدخل المستخدم، كيف يتحرك، أين يجلس، أين يرى الضوء، وكيف تظهر الواجهة من الشارع."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("محاور التصميم الأساسية")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تقسيم المساحات", "توزيع الغرف والخدمات والممرات والفراغات المفتوحة بما يحقق استخدامًا عمليًا للمساحة دون مناطق مهدرة أو علاقات مزعجة بين الأنشطة.")}
			pTopic2={new Topic("مسارات الحركة", "تنظيم المداخل والسلالم والممرات وحركة الضيوف والخدمات بحيث يشعر المستخدم بالوضوح والراحة من أول خطوة داخل المبنى.")}
			pTopic3={new Topic("الإضاءة والتهوية", "تحديد مواضع الفتحات ومساحاتها واتجاهاتها بما يدعم الإضاءة الطبيعية والتهوية المناسبة مع الحفاظ على الخصوصية والاتزان البصري.")}
			pTopic4={new Topic("الواجهات والهوية", "تحويل كتلة المبنى إلى واجهة راقية لها إيقاع واضح في الفتحات، وخامات مناسبة، ونسب معمارية متزنة مع طبيعة المكان.")}
		/>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#0E1118")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("خدمات الرسم الهندسي المعماري")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("نقدم خدمة رسم هندسي معماري متكاملة للمنزل أو الفيلا أو العمارة السكنية، بدءًا من الفكرة الأولية إلى المخططات التنفيذية الجاهزة. الهدف أن يكون التصميم واضحًا للعميل، مفهومًا للمقاول، وقابلًا للمراجعة مع التخصصات الأخرى.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("الخدمة تشمل")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("كل بند في الرسومات له وظيفة واضحة في الترخيص أو التنفيذ أو تقدير التكلفة.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pNumbered={false}
				pItems={[
					"رسم معماري لمنزل أو فيلا: مخططات الطوابق، الفتحات، المناسيب، والخدمات.",
					"رسومات معمارية للمنازل: توزيع المساحات وتنظيم الحركة الداخلية.",
					"تصميم واجهات ثلاثية الأبعاد: عرض شكل الواجهة مع التفاصيل الجمالية والخامات المقترحة.",
					"رسومات تنفيذية تفصيلية: قطاعات، واجهات، تفاصيل معمارية، وجداول أبواب ونوافذ.",
					"تنسيق مبدئي مع التصميم الإنشائي والكهرباء والميكانيكا لتقليل التعارضات قبل التنفيذ."
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_e415edfe1c7b45708e2bf54045b08840~mv2.jpg/v1/fill/w_592,h_333,q_90,enc_avif,quality_auto/308dfd_e415edfe1c7b45708e2bf54045b08840~mv2.jpg",
					false,
					"تصميم واجهة فيلا",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#FFFFFF")}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="رسم معماري لفيلا"
			pDesc="امتلاك فيلا مشروع طويل الأثر، وتصميمها يحتاج قراءة دقيقة لطبيعة الأسرة، أسلوب الضيافة، الخصوصية، علاقة الداخل بالحديقة، حركة السيارات، ومستوى الفخامة المطلوب في الواجهة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("تصميم الفيلا يبدأ من أسلوب الحياة")}
				pText={Text.Body.WithColor("#333333").OfText("الفيلا الجيدة لا تُقاس بجمال واجهتها فقط، بل بقدرتها على تنظيم الحياة اليومية داخلها. ندرس عدد أفراد الأسرة، الخصوصية المطلوبة، العلاقة بين غرف النوم والمعيشة والضيافة، أماكن الخدمات، الحديقة، المسبح، الجراج، ومناطق الجلوس الخارجية، ثم يتحول ذلك إلى مخطط واضح ومريح.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_487980f7e6d74679acdd3f8b45c750a3~mv2.jpg/v1/fill/w_291,h_164,q_90,enc_avif,quality_auto/308dfd_487980f7e6d74679acdd3f8b45c750a3~mv2.jpg",
					false,
					"تصميم واجهة فيلا مودرن",
					new Size(new NumPer(500, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#111318")}>

		<SecTitle
			style = " --StripBg : #111318 "
			pTitle="أهمية التصميم المعماري للفلل"
			pDesc="كل قرار معماري في الفيلا يؤثر على الراحة، التكلفة، التنفيذ، وإحساس الفخامة النهائي. لذلك يتم التعامل مع التصميم كمنظومة واحدة لا كواجهة منفصلة عن التخطيط الداخلي."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#D9B86C").OfText("قيمة التصميم قبل التنفيذ")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("استغلال أمثل للمساحات", "التخطيط الدقيق يمنع الفراغات الميتة، ويجعل الغرف والممرات والخدمات والحدائق تعمل كمنظومة واحدة متماسكة.")}
			pTopic2={new Topic("هوية معمارية واضحة", "اختيار الطراز الحديث أو الكلاسيكي أو النيو كلاسيك أو الأندلسي يظهر من الكتلة والفتحات والنسب قبل اختيار الخامات النهائية.")}
			pTopic3={new Topic("تكامل الداخل والخارج", "نجاح الفيلا يظهر في العلاقة بين غرف المعيشة والنوم والمطبخ وبين الحديقة والمسبح والجراج ومداخل الضيوف والخدمات.")}
			pTopic4={new Topic("جاهزية للتراخيص والتنفيذ", "المخططات المعمارية الدقيقة تسهل مراجعة الاشتراطات وتنسيق الملفات مع باقي التخصصات وتقليل التعديلات المكلفة أثناء التنفيذ.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F7F1E6")}>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="مراحل خدمة تصميم معماري لفيلا"
			pDesc="المراحل مرتبة بحيث ينتقل المشروع من رغبة عامة إلى مخطط دقيق، ثم إلى رسومات قابلة للتسليم والمراجعة والتنفيذ."
		/>

		<EmoList
			pWidth={new RespString("1000px", "320px")}
			pTitle={Text.H3.Centered.WithColor("#111318").OfText("تسلسل العمل")}
			pDesc={Text.Body.Centered.WithColor("#333333").OfText("كل مرحلة لها مخرجات واضحة، ولا يتم الانتقال للمرحلة التالية قبل تثبيت الفكرة الأساسية مع العميل.")}
			pHeadBg={new ElemBg("transparent")}
			pItemsBg={new ElemBg("#FFFFFF")}
			pNumbered={true}
			pItems={[
				{
					Title: "دراسة المتطلبات",
					Items: [
						"عدد الغرف المطلوبة وطبيعة استخدام كل فراغ.",
						"الأنشطة اليومية للأسرة ومستوى الخصوصية المطلوب.",
						"العناصر الخاصة مثل مكتب منزلي، غرفة ألعاب، قبو، حمام سباحة، أو جناح ضيافة.",
						"الطراز المفضل للواجهة ومستوى التشطيب المتوقع."
					]
				},
				{
					Title: "دراسة الموقع والأرض",
					Items: [
						"تحديد اتجاهات الشمال والشمس والرياح.",
						"قراءة أبعاد الأرض ومداخلها وعلاقتها بالشوارع والجيران.",
						"مراجعة اشتراطات المنطقة أو جهاز المدينة قبل تثبيت التصميم."
					]
				},
				{
					Title: "المخطط الأولي",
					Items: [
						"توزيع أولي للغرف والأدوار.",
						"تحديد مسارات الحركة داخل الفيلا.",
						"تصور مبدئي للحديقة والمداخل الرئيسية والفرعية."
					]
				},
				{
					Title: "التصميم التفصيلي",
					Items: [
						"إعداد مخططات الطوابق بمقاييس دقيقة.",
						"إعداد القطاعات الرأسية لتوضيح ارتفاعات الغرف والمناسيب.",
						"تصميم الواجهات مع تصور ثلاثي الأبعاد للرؤية المستقبلية."
					]
				},
				{
					Title: "الرسومات التنفيذية",
					Items: [
						"رسومات تفصيلية تستخدم أثناء التنفيذ.",
						"جداول أبواب ونوافذ.",
						"تفاصيل التشطيبات الداخلية والخارجية."
					]
				},
				{
					Title: "المراجعة والتعديلات",
					Items: [
						"جلسات مراجعة مع العميل لتثبيت المخطط النهائي.",
						"ضبط الحلول المعمارية مع القيود الإنشائية والتشغيلية.",
						"تجهيز النسخة النهائية للتنسيق مع باقي التخصصات."
					]
				}
			]}
		/>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#0E1118")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#0E1118")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("نماذج رسم معماري لفيلا ومنزل وعمارة")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("الصور القديمة من الصفحة محفوظة داخل التكوين الجديد كمرجع بصري، مع ترتيب أهدأ يناسب صفحة تصميم معماري فاخرة.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_5820282ea9a245e7b61b4ce20590ee67~mv2.jpg/v1/fill/w_557,h_313,q_90,enc_avif,quality_auto/308dfd_5820282ea9a245e7b61b4ce20590ee67~mv2.jpg",
					false,
					"تصميم واجهة منزل",
					new Size(new NumPer(360, 320), new NumPer("auto", "auto"))
				)}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_b0ef5ffffd31433ead5a705e9fd0830c~mv2.jpg/v1/fill/w_273,h_154,q_90,enc_avif,quality_auto/308dfd_b0ef5ffffd31433ead5a705e9fd0830c~mv2.jpg",
					false,
					"تصميم منزل",
					new Size(new NumPer(360, 320), new NumPer("auto", "auto"))
				)}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/",
					"308dfd_b362875e71f74fb380531bc6cf46e75f~mv2.jpg/v1/fill/w_422,h_675,q_90,enc_avif,quality_auto/308dfd_b362875e71f74fb380531bc6cf46e75f~mv2.jpg",
					false,
					"تصميم واجهة عمارة سكنية",
					new Size(new NumPer(260, 260), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#FFFFFF")}>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="مخرجات التصميم المعماري"
			pDesc="التسليم لا يكون مجرد صورة واجهة، بل ملف معماري واضح يمكن الرجوع إليه في الترخيص، التسعير، التنفيذ، والمراجعة مع باقي التخصصات."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("ما الذي تحصل عليه؟")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مخططات الأدوار", "توزيع الفراغات، الأبعاد، الفتحات، المناسيب، السلالم، الخدمات، ومسارات الحركة الأساسية.")}
			pTopic2={new Topic("الواجهات والقطاعات", "إظهار الكتلة المعمارية، ارتفاعات الأدوار، النسب، العلاقات الرأسية، وملامح الخامات المقترحة.")}
			pTopic3={new Topic("جداول وتفاصيل", "جداول الأبواب والشبابيك والتفاصيل المعمارية المهمة التي تساعد في التسعير والتنفيذ والمراجعة.")}
			pTopic4={new Topic("تصور ثلاثي الأبعاد", "منظور خارجي أو واجهة ثلاثية الأبعاد حسب نطاق الاتفاق لتوضيح الشكل النهائي قبل بدء التنفيذ.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#111318")}>

		<SecTitle
			style = " --StripBg : #111318 "
			pTitle="تكلفة تصميم فيلا"
			pDesc="التكلفة النهائية تتحدد بعد معرفة مساحة الأرض، نسبة البناء، عدد الأدوار، مستوى التفاصيل، ونطاق الرسومات المطلوبة. الرقم التالي بداية استرشادية لخدمة التصميم المعماري، وليس عرضًا نهائيًا لكل الحالات."
		/>

