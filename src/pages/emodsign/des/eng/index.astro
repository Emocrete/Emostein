---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="تصميم هندسي"
	pDescr="خدمات تصميم هندسي متكاملة تشمل التصميم المعماري والإنشائي والكهرباء والميكانيكا للمباني السكنية والتجارية والإدارية، مع تنسيق الرسومات بين التخصصات وتجهيز مخرجات مناسبة للترخيص أو التنفيذ أو التسعير أو المراجعة."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم هندسي متكامل")}
				pText={Text.Body.Centered.OfText("خدمات تصميم هندسي متكاملة تشمل التصميم المعماري والإنشائي والكهرباء والميكانيكا للمباني السكنية والتجارية والإدارية، مع تنسيق الرسومات بين التخصصات وتجهيز مخرجات مناسبة للترخيص أو التنفيذ أو التسعير أو المراجعة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
