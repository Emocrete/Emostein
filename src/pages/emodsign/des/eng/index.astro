---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoContactStrip, EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="CollectionPage"
	pTitle="تصميم هندسي"
	pDescr="خدمات تصميم هندسي متكاملة تشمل التصميم المعماري والإنشائي والكهرباء والميكانيكا للمباني السكنية والتجارية والإدارية، مع تنسيق الرسومات بين التخصصات وتجهيز مخرجات مناسبة للترخيص أو التنفيذ أو التسعير أو المراجعة."
>







	<Hero
		pImgF="/Media/Emodsign/Des/Eng/"
		pTitle="تصميم هندسي متكامل"
		pDesc="من الفكرة الأولى إلى ملف رسومات منسق بين المعماري والإنشائي والكهرباء والميكانيكا، يصلح للمراجعة والتسعير والترخيص والتنفيذ حسب نطاق مشروعك."
		pTitleClr="#F4E5C4"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="16% 52% 12% 8%"
		pPosP="12% 8% 44% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب تصميم مشروعك" />

	</Hero>







	<EmoSec
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="خريطة خدمات التصميم الهندسي داخل المكتب"
			pDesc="هذه ليست صفحة فرعية لخدمة واحدة، بل مدخل منظم لكل خدمات التصميم الهندسي. منها ينتقل العميل إلى التصميم المعماري أو الإنشائي أو الكهربائي أو الميكانيكي، مع فهم العلاقة العملية بين هذه التخصصات قبل اختيار الخدمة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("التصميم الهندسي ملف قرار قبل أن يكون ملف رسومات")}
				pText={Text.Body.WithColor("#333333").OfText("العميل غالبًا يبدأ بسؤال بسيط: أريد تصميم منزل، فيلا، عمارة، محل، مطعم، عيادة، أو مبنى إداري. لكن القرار الهندسي لا يقف عند شكل المسقط أو الواجهة. كل فتحة معمارية تؤثر في الإنشائي، وكل عمود يؤثر في الفراغ، وكل حمام ومطبخ يحتاج مسارات صرف وتغذية وتهوية، وكل استخدام له أحمال كهربائية وتشغيلية. لذلك يتم التعامل مع التصميم كمنظومة مترابطة، لا كلوحات منفصلة يجمعها المقاول وقت التنفيذ.")}
			/>

			<VrStack
				pWidth={new Pixel(560, 320)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(0, 0)}
			>

				<CardsGr
					pWidth={new RespString("560px", "320px")}
					pCardBg={new ElemBg("#FFFFFF")}
					pCardTitleFnt={Text.H3.Centered.WithColor("#111318")}
					pCardBodyFnt={Text.Body.Centered.WithColor("#333333")}
					pStackDir="Row"
					pSpacing={20}
					pTopic1={new Topic("01", "تحديد نوع المشروع والاستخدام والمساحة ومرحلة الاحتياج.")}
					pTopic2={new Topic("02", "اختيار التخصصات المطلوبة بدل طلب رسومات ناقصة.")}
				/>

				<CardsGr
					pWidth={new RespString("560px", "320px")}
					pCardBg={new ElemBg("#FFFFFF")}
					pCardTitleFnt={Text.H3.Centered.WithColor("#111318")}
					pCardBodyFnt={Text.Body.Centered.WithColor("#333333")}
					pStackDir="Row"
					pSpacing={20}
					pTopic1={new Topic("03", "تنسيق القرارات بين المعماري والإنشائي والكهرباء والميكانيكا.")}
					pTopic2={new Topic("04", "تسليم ملف واضح للمراجعة أو الترخيص أو التسعير أو التنفيذ.")}
				/>

			</VrStack>

		</HzStack>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#111318")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="اختر الخدمة حسب احتياجك الفعلي"
			pDesc="الفرق بين صفحة توزيع قوية وصفحة عادية أن العميل لا يرى أسماء خدمات فقط، بل يعرف أي فرع يناسب موقفه الحالي."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("فروع التصميم الهندسي الأساسية")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تصميم معماري", "يناسبك عند بدء مشروع من الصفر، أو إعادة توزيع مساحة، أو تصميم فيلا أو عمارة أو محل أو واجهة. يحدد المساقط والواجهات والقطاعات والمناسيب والعلاقات الوظيفية بين الفراغات.")}
			pTopic2={new Topic("تصميم إنشائي", "يناسبك عندما تحتاج نظامًا إنشائيًا آمنًا وقابلًا للتنفيذ، أو مراجعة أعمدة وبلاطات وقواعد، أو تجهيز رسومات تسليح ونوتة حسابية حسب نطاق المشروع.")}
			pTopic3={new Topic("تصميم كهرباء", "يناسبك عند تجهيز توزيع إنارة وقوى ولوحات وأحمال وكابلات وأنظمة تيار خفيف، أو عند وجود مشروع يحتاج تشغيلًا كهربائيًا واضحًا من البداية.")}
			pTopic4={new Topic("تصميم ميكانيكا", "يناسبك عند الحاجة إلى سباكة وصرف وتكييف وتهوية ومكافحة حريق، خصوصًا في المطاعم والعيادات والمباني التجارية والمشروعات التي تعتمد على التشغيل.")}
		/>

	</EmoSec>







	<EmoStr
		pBg={new ElemBg("#0E1118")}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg("#151923")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#D9B86C").OfText("التصميم المتكامل يمنع أخطاء لا تظهر في اللوحة الواحدة")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("المشكلة في كثير من الملفات أن كل تخصص يخرج لوحاته بمعزل عن الآخر. النتيجة تظهر في الموقع: عمود في مكان باب، ماسورة تمر داخل كمرة، سقف ساقط يقتل ارتفاع غرفة، لوحة كهرباء في مكان غير مناسب، أو مسار تكييف يصطدم بالإنشائي. لذلك قيمة التصميم الهندسي لا تقاس بعدد اللوحات فقط، بل بقدرة الملف على تجميع القرارات قبل التنفيذ.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F4E5C4").OfText("أمثلة تعارضات تظهر عند ضعف التنسيق")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("هذه الحالات لا تحتاج مبنى ضخمًا لتظهر؛ قد تظهر في فيلا أو شقة دوبلكس أو محل تجاري صغير.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pItemFnt={Text.Body.WithColor("#F8F4EA")}
				pNumbered={false}
				pItems={[
					"عمود أو حائط قص يضغط على فراغ معماري مهم بعد اعتماد التوزيع.",
					"حمام أو مطبخ بعيد عن مسار الصرف الطبيعي، فيحتاج تكسيرًا أو رفع منسوب الأرضية.",
					"مسار تكييف أو تهوية يهبط بالسقف في منطقة استقبال أو صالة رئيسية.",
					"لوحات كهرباء أو غرف خدمات تظهر في أماكن غير مناسبة بصريًا أو تشغيليًا.",
					"فتحات معمارية كبيرة تتطلب حلًا إنشائيًا لم يكن محسوبًا في الميزانية.",
					"توزيع إنارة جميل على الورق، لكنه لا يراعي الأثاث أو استخدامات الفراغ."
				]}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#F4E5C4").OfText("ماذا يضيف التنسيق؟")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("وضوح قبل المقايسة", "الرسومات المنسقة تجعل بنود المقاول أقرب للواقع، لأن المسارات والفتحات والخدمات ليست افتراضات عامة.")}
				pTopic2={new Topic("قرارات أقل في الموقع", "كل قرار يترك للموقع يتحول إلى تكلفة أو تأخير أو تنفيذ مختلف عن توقع العميل.")}
				pTopic3={new Topic("ملف قابل للتطوير", "يمكن تطوير التصميم لاحقًا إلى شوب دروينج أو حصر كميات أو جدول زمني دون إعادة فهم المشروع من الصفر.")}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F7F1E6 "
			pTitle="كيف تختار بين فرع واحد وباقة تصميم كاملة؟"
			pDesc="ليس كل مشروع يحتاج كل التخصصات بنفس العمق. الاختيار الصحيح يعتمد على مرحلة المشروع ونوع الاستخدام ودرجة المخاطرة في التنفيذ."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("اطلب فرعًا واحدًا عندما")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("لديك ملف قائم", "عند وجود تصميم معماري كامل وتحتاج فقط تصميمًا إنشائيًا، أو لديك تصميمات وتحتاج مراجعة كهرباء أو ميكانيكا.")}
				pTopic2={new Topic("المشروع محدود النطاق", "مثل تعديل واجهة، رسم معماري لمحل، مراجعة قطاع إنشائي، أو إعداد لوحة كهرباء محددة.")}
				pTopic3={new Topic("تحتاج رأيًا فنيًا محددًا", "عند وجود مشكلة في توزيع، عمود، فتحة، حمل كهربائي، مسار صرف، أو قرار واحد يحتاج مراجعة قبل التنفيذ.")}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("اطلب باقة متكاملة عندما")}
				pCardBg={new ElemBg("#111318")}
				pCardTitleFnt={Text.H4.WithColor("#D9B86C")}
				pCardBodyFnt={Text.Body.WithColor("#F8F4EA")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("تبدأ مبنى من الصفر", "فيلا، منزل، عمارة، مبنى إداري، أو مشروع تجاري يحتاج قرارات معمارية وإنشائية وتشغيلية مترابطة.")}
				pTopic2={new Topic("تستعد للتسعير أو التعاقد", "عند الحاجة إلى ملف واضح يستطيع المقاول قراءته وتقدير كمياته وبنوده دون افتراضات واسعة.")}
				pTopic3={new Topic("الاستخدام حساس", "مطعم، عيادة، معمل، مخزن، ورشة، أو نشاط يعتمد على التهوية والكهرباء والصرف والحريق والتشغيل اليومي.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#F7F1E6")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #0E1118 "
			pTitle="الفرق بين مستويات مخرجات التصميم"
			pDesc="كلمة تصميم هندسي قد تعني فكرة مبدئية، أو رسومات ترخيص، أو رسومات تنفيذ، أو ملف مراجعة. تحديد المستوى من البداية يمنع اختلاف التوقعات بين العميل والمكتب والمقاول."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("مستويات الخدمة الممكنة")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تصور مبدئي", "يناسب مرحلة اتخاذ القرار. يوضح التوزيع العام والفكرة الرئيسية واتجاهات الحركة والمناطق المهمة، دون الدخول في كل تفاصيل التنفيذ.")}
			pTopic2={new Topic("رسومات ترخيص", "تركز على ما تطلبه الجهة المختصة من مساقط وواجهات وقطاعات وبيانات أساسية ومطابقة عامة للاشتراطات حسب نوع المشروع وموقعه.")}
			pTopic3={new Topic("رسومات تصميم تفصيلي", "توضح العناصر والتخصصات بدرجة أكبر، وتصلح كأساس للتسعير والتنسيق الفني قبل الدخول في تفاصيل الشوب دروينج.")}
			pTopic4={new Topic("رسومات تنفيذية", "تدخل في تفاصيل أوضح للقطاعات والمناسيب والتسليح والمسارات والجداول، وتحتاج تنسيقًا أدق مع ظروف الموقع والمقاول.")}
			pTopic5={new Topic("مراجعة تصميم", "تستخدم عندما يكون لديك ملف من مكتب آخر وتحتاج رأيًا هندسيًا في التعارضات والنواقص وقابلية التنفيذ.")}
			pTopic6={new Topic("ملف تسعير ومقايسة", "يركز على تحويل التصميم إلى نطاق مفهوم للمقاولين، مع تحديد البنود المؤثرة التي تمنع المقارنات العشوائية بين العروض.")}
		/>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #E7D3A1 "
			pTitle="مصفوفة العلاقة بين التخصصات"
			pDesc="كل تخصص له قراراته الخاصة، لكنه لا يعمل وحده. المصفوفة التالية توضح كيف تؤثر قرارات كل فرع على باقي الفروع داخل التصميم الهندسي."
		/>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("قرارات التصميم المعماري")}
				pDesc={Text.Body.WithColor("#333333").OfText("المعماري هو نقطة البداية في أغلب المباني، لأنه يحدد الاستخدام والحركة والفتحات والكتلة.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "يؤثر على الإنشائي", Items: ["البحور، أماكن الأعمدة، فتحات السلالم والمصاعد، البروزات، الواجهات المفتوحة، والأدوار ذات الارتفاعات الخاصة."] },
					{ Title: "يؤثر على الكهرباء", Items: ["مواقع الأثاث، الإنارة، البرايز، اللوحات، نقاط التكييف، أنظمة التيار الخفيف، ومسارات الخدمة المخفية."] },
					{ Title: "يؤثر على الميكانيكا", Items: ["أماكن الحمامات والمطابخ والرايزرات وغرف الخدمات ومسارات التكييف والتهوية والمدخنة إن وجدت."] },
					{ Title: "يؤثر على التكلفة", Items: ["تعقيد الواجهة، نسب الفتحات، ارتفاعات الأسقف، البروزات، المساحات المهدرة، وحلول الخدمات."] }
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("قرارات التصميم الإنشائي")}
				pDesc={Text.Body.WithColor("#333333").OfText("الإنشائي يحول الشكل المعماري إلى نظام مقاوم للأحمال وقابل للتنفيذ دون إفساد الوظيفة.")}
				pHeadBg={new ElemBg("#F7F1E6")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={true}
				pItems={[
					{ Title: "يؤثر على المعماري", Items: ["أماكن الأعمدة والكمرات وسمك البلاطات ومواقع الحوائط الإنشائية وارتفاعات السقف الصافي."] },
					{ Title: "يؤثر على الكهرباء", Items: ["أماكن الفتحات في البلاطات، إمكان تمرير المواسير، مواقع اللوحات الثقيلة، وتثبيت المعدات."] },
					{ Title: "يؤثر على الميكانيكا", Items: ["فتحات الدكتات، مسارات مواسير الصرف، أماكن خزانات أو معدات ثقيلة، وإمكان تمرير الخدمات دون كسر إنشائي."] },
					{ Title: "يؤثر على التنفيذ", Items: ["نوع الشدة، كثافة التسليح، سهولة الصب، تسلسل التنفيذ، وقابلية المقاول لتنفيذ التفاصيل بدقة."] }
				]}
			/>

		</HzStack>

		<HzStack pGap={new Pixel(25, 20)} pPad={new Pixel(0, 20)}>

			<EmoList
				pWidth={new RespString("575px", "320px")}
				pTitle={Text.H3.WithColor("#111318").OfText("قرارات تصميم الكهرباء")}
