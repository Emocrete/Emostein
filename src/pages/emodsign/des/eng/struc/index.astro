---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="خدمات تصميم إنشائي"
	pDescr="خدمة تصميم إنشائي للفلل والعمارات والمباني التجارية والإدارية والمنشآت المختلفة، تشمل اختيار النظام الإنشائي، تحليل الأحمال، تصميم البلاطات والكمرات والأعمدة والأساسات، إعداد اللوحات الإنشائية، النوتة الحسابية، والتنسيق مع المعماري والكهرباء والميكانيكا."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("50%","2.5%"),new NumPer("35%","10%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم إنشائي")}
				pText={Text.Body.Centered.OfText("خدمات تصميم إنشائي للمباني السكنية والتجارية والإدارية والصناعية بمستوى عالٍ من الدقة والالتزام بمعايير الأمان القصوى ، مع المحافظة على تكلفة مناسبة واقتصادية")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<RelServices>

		<RelServiceItem
			pTitle="شوب دروينج إنشائي"
			pDesc="تفصيل لوحات التسليح والقطاعات والبار بندنج للتنفيذ الدقيق في الموقع."
			pHref="/emodsign/tech/shopdwg/struc"
		/>

		<RelServiceItem
			pTitle="حصر كميات إنشائي"
			pDesc="حصر الخرسانة وحديد التسليح والعناصر الإنشائية للتسعير ومقارنة عروض المقاولين."
			pHref="/emodsign/tech/takeoff/construction"
		/>

		<RelServiceItem
			pTitle="الإشراف الهندسي على البناء"
			pDesc="متابعة تنفيذ الأعمال الإنشائية طبقًا للرسومات والمواصفات."
			pHref="/emocrete/supervision/construction"
		/>

	</RelServices>







</BLayout>
