---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تصميم إنشائي للمباني والمنشآت"
	pDescr="خدمة تصميم إنشائي للفلل والعمارات والمباني التجارية والإدارية والمنشآت المختلفة، تشمل اختيار النظام الإنشائي، تحليل الأحمال، تصميم البلاطات والكمرات والأعمدة والأساسات، إعداد اللوحات الإنشائية، النوتة الحسابية، والتنسيق مع المعماري والكهرباء والميكانيكا."
>







	<Hero
		pImgF="/Media/Emodsign/Des/Eng/Struc/"
		pTitle="تصميم إنشائي"
		pDesc="تحويل التصميم المعماري إلى هيكل آمن واقتصادي وقابل للتنفيذ، من اختيار النظام الإنشائي حتى اللوحات والنوتة الحسابية."
		pTitleClr="#EED7A1"
		pDescClr="#FFFFFF"
		pHzAlign="right"
		pVrAlign="right"
		pPosL="15% 52% 12% 8%"
		pPosP="12% 8% 46% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب تصميم إنشائي" />

	</Hero>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			style = " --StripBg : #101820 "
			pTitle="التصميم الإنشائي هو قرار الأمان والتكلفة في المشروع"
			pDesc="كل مبنى يحتاج نظامًا إنشائيًا يترجم الفكرة المعمارية إلى مسار واضح للأحمال، من البلاطات والكمرات إلى الأعمدة والحوائط والأساسات. التصميم الجيد لا يبالغ في القطاعات ولا يغامر بالسلامة، بل يوازن بين الأمان، الاقتصاد، سهولة التنفيذ، ومتطلبات الترخيص."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#101820").OfText("من المعماري إلى الهيكل")}
				pText={Text.Body.WithColor("#333333").OfText("نبدأ من المخططات المعمارية، ثم نقرأ البحور، أماكن الأعمدة، الفتحات، السلالم، المناور، البدروم، والاشتراطات. بعدها يتم اختيار النظام الإنشائي المناسب، إعداد الموديل التحليلي، تصميم العناصر، ثم إخراج لوحات واضحة يستطيع المقاول تنفيذها ومراجعتها في الموقع.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"/Media/Emodsign/Des/Eng/Struc/",
					"HeroL.webp",
					false,
					"تصميم إنشائي للمباني",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#101820")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="نطاق خدمة التصميم الإنشائي"
			pDesc="الخدمة مناسبة للمباني السكنية والتجارية والإدارية والخدمية، ويمكن ضبطها حسب مرحلة المشروع: تصميم أولي، تصميم تفصيلي، رسومات ترخيص، أو ملف إنشائي قابل للتنفيذ."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#EED7A1").OfText("ما الذي يتم تصميمه؟")}
			pCardBg={new ElemBg("#F7F1E8")}
			pCardTitleFnt={Text.H4.WithColor("#101820")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("البلاطات والأسقف", "تصميم أنظمة Solid Slab وFlat Slab وHollow Block وغيرها حسب البحور والاستخدام والارتفاعات والتكلفة وسهولة التنفيذ.")}
			pTopic2={new Topic("الكمرات والأعمدة", "تحديد القطاعات والتسليح ومسارات نقل الأحمال، مع مراعاة المعماري والفتحات ومسارات الخدمات.")}
			pTopic3={new Topic("الأساسات", "اختيار وتصميم القواعد المنفصلة والمشتركة واللبشة والخازوق عند الحاجة، طبقًا لبيانات التربة والأحمال.")}
			pTopic4={new Topic("السلالم والعناصر الخاصة", "تصميم السلالم والحوائط الساندة والخزانات والقواعد الخاصة والعناصر التي تحتاج معالجة مستقلة.")}
			pTopic5={new Topic("الأحمال الجانبية", "مراعاة الرياح والزلازل والحوائط القصية أو النوى عند الحاجة، خصوصًا في المباني العالية أو غير المنتظمة.")}
			pTopic6={new Topic("اللوحات والنوتة", "إخراج لوحات إنشائية واضحة ونوتة حسابية منظمة حسب نطاق المشروع ومتطلبات المراجعة.")}
		/>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#101820")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#172430")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#C6A15B").OfText("تصميم واضح قبل الحديد والخرسانة")}
				pText={Text.Body.Centered.WithColor("#F7F1E8").OfText("كل قرار في التصميم الإنشائي يظهر لاحقًا في كمية الحديد والخرسانة وسرعة التنفيذ ومشاكل الموقع. لذلك يتم ضبط النظام والقطاعات والتفاصيل قبل بدء التنفيذ، وليس أثناء صب الخرسانة.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#EED7A1").OfText("مدخلات التصميم")}
				pDesc={Text.Body.WithColor("#F7F1E8").OfText("كلما كانت بيانات المشروع أوضح، خرج التصميم أدق وأسهل في المراجعة والتنفيذ.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pNumbered={false}
				pItems={[
					"المخططات المعمارية النهائية أو شبه النهائية.",
					"تقرير التربة إن وجد، أو بيانات أولية عن طبيعة الأرض ومكان المشروع.",
					"عدد الأدوار والبدروم والسطح والخزانات وغرف الخدمات.",
					"نوع الاستخدام: سكني، تجاري، إداري، طبي، صناعي، أو مختلط.",
					"اشتراطات الترخيص أو الجهة المالكة أو الاستشاري إن وجدت.",
					"نطاق التسليم المطلوب: تصميم فقط، لوحات، نوتة حسابية، حصر، أو شوب دروينج."
				]}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#EED7A1").OfText("مخرجات عامة")}
				pCardBg={new ElemBg("#F7F1E8")}
				pCardTitleFnt={Text.H4.WithColor("#101820")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("لوحات إنشائية", "محاور، أعمدة، قواعد، أسقف، كمرات، قطاعات، تفاصيل تسليح، وملاحظات تنفيذية.")}
				pTopic2={new Topic("نوتة حسابية", "حسابات أحمال وتحليل وتصميم للعناصر الرئيسية حسب نطاق العمل ومتطلبات المراجعة.")}
				pTopic3={new Topic("ملف قابل للتطوير", "يمكن تحويل التصميم لاحقًا إلى شوب دروينج، حصر كميات، أو نموذج BIM إنشائي.")}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="اختيار النظام الإنشائي"
			pDesc="اختيار النظام ليس خطوة شكلية، بل قرار يحدد أماكن الأعمدة، سمك البلاطات، عمق الكمرات، كمية الحديد، ارتفاعات الأدوار، شكل السقف المستعار، ومسارات الميكانيكا والكهرباء."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("أنظمة إنشائية شائعة")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#101820")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("Solid Slab", "نظام مناسب لكثير من المباني السكنية الصغيرة والمتوسطة، واضح في التنفيذ ومألوف للمقاولين.")}
			pTopic2={new Topic("Flat Slab", "حل مفيد عند الحاجة لسقف مستوٍ وتقليل الكمرات، مع اهتمام خاص بالقص الثاقب والهبوط والتفاصيل حول الأعمدة.")}
			pTopic3={new Topic("Hollow Block", "يستخدم عند وجود بحور أكبر نسبيًا أو رغبة في تقليل الوزن الذاتي، مع ضبط اتجاهات الأعصاب والتفاصيل.")}
			pTopic4={new Topic("Frames", "نظام مناسب لبعض المنشآت والقاعات والتغطيات والمخازن، وقد يكون خرسانيًا أو معدنيًا حسب الاستخدام والبحور.")}
			pTopic5={new Topic("Shear Walls / Core", "تستخدم عند الحاجة لمقاومة الأحمال الجانبية في المباني الأعلى أو غير المنتظمة، خاصة حول المصاعد والسلالم.")}
			pTopic6={new Topic("Raft / Pile Foundation", "حلول للأساسات عندما تفرض الأحمال أو التربة أو عدد الأدوار نظامًا أعمق أو أكثر ترابطًا من القواعد العادية.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")}>

		<SecTitle
			style = " --StripBg : #101820 "
			pTitle="تصميم العناصر الخرسانية المسلحة"
			pDesc="الخرسانة المسلحة هي أكثر نظم التنفيذ شيوعًا في المباني السكنية والتجارية في مصر. لذلك يتم التعامل مع كل عنصر باعتباره جزءًا من مسار أحمال متكامل، وليس قطاعًا منفصلًا."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("العناصر الرئيسية")}
				pCardBg={new ElemBg("#F7F1E8")}
				pCardTitleFnt={Text.H4.WithColor("#101820")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("البلاطات", "تحديد السمك والتسليح والاتجاهات والفتحات ومناطق العزوم والقص والهبوط حسب النظام المختار.")}
				pTopic2={new Topic("الكمرات", "تصميم القطاعات والتسليح العلوي والسفلي والكانات ومناطق الارتكاز والبحور والفتحات.")}
				pTopic3={new Topic("الأعمدة", "تحديد الأبعاد والتسليح الطولي والكانات، ومراعاة انتقال الأحمال بين الأدوار وتداخلها مع المعماري.")}
			/>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#101820").OfText("Checks مهمة")}
				pDesc={Text.Body.WithColor("#333333").OfText("هذه المراجعات تمنع تحويل التصميم إلى أبعاد شكلية بلا تحقق حقيقي.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("#F7F1E8")}
				pNumbered={false}
				pItems={[
					"مراجعة الأحمال الميتة والحية وأحمال الحوائط والتشطيبات.",
					"مراجعة القص والعزم والهبوط للبلاطات والكمرات.",
					"مراجعة القص الثاقب حول الأعمدة في الفلات سلاب واللبشات.",
					"مراجعة نسب التسليح الدنيا والعظمى والتفاصيل التنفيذية.",
					"مراجعة انتظام الأعمدة وتجنب تحميلات غير منطقية على عناصر ضعيفة.",
					"مراعاة الفتحات والمناور والسلالم والكوابيل والبحور الخاصة."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="تصميم الأساسات"
			pDesc="الأساس هو العنصر الذي يربط المبنى بالتربة. اختيار نوع الأساس يعتمد على الأحمال، تقرير التربة، منسوب المياه، حدود الجار، وجود بدروم، وطبيعة المنشآت المجاورة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("أنواع الأساسات ضمن الخدمة")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#101820")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("قواعد منفصلة", "حل اقتصادي ومباشر عندما تسمح قدرة تحمل التربة وتباعد الأعمدة بذلك.")}
			pTopic2={new Topic("قواعد مشتركة", "تستخدم عند تقارب الأعمدة أو وجود أعمدة حدودية تحتاج ربطًا إنشائيًا مناسبًا.")}
			pTopic3={new Topic("لبشة مسلحة", "مناسبة عند زيادة الأحمال أو ضعف التربة أو الحاجة لتوزيع الأحمال على مساحة أكبر.")}
			pTopic4={new Topic("خوازيق", "تستخدم عند الحاجة لنقل الأحمال إلى طبقات أعمق أو عند عدم كفاية حلول التأسيس السطحي.")}
			pTopic5={new Topic("حوائط ساندة", "تصميم حوائط البدرومات والردم والمنحدرات مع مراعاة ضغط التربة والمياه والتصريف.")}
			pTopic6={new Topic("خزانات وقواعد معدات", "تصميم قواعد خاصة للمعدات والخزانات والمولدات والمضخات والأحمال المركزة.")}
		/>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#101820")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#172430")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#C6A15B").OfText("اللوحات الإنشائية التي يستلمها العميل")}
				pText={Text.Body.Centered.WithColor("#F7F1E8").OfText("اللوحة الإنشائية الجيدة تختصر وقت التنفيذ والمراجعة. المطلوب أن يعرف المنفذ مكان كل عنصر، أبعاده، تسليحه، منسوبه، وملاحظاته دون الرجوع المستمر إلى قرارات شفوية.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#EED7A1").OfText("ملف اللوحات قد يشمل")}
			pCardBg={new ElemBg("#F7F1E8")}
			pCardTitleFnt={Text.H4.WithColor("#101820")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("لوحة محاور وأعمدة", "تحديد المحاور وأماكن الأعمدة والحوائط الإنشائية والعناصر الرأسية.")}
			pTopic2={new Topic("لوحات الأساسات", "مخططات القواعد أو اللبشة أو الخوازيق، مع القطاعات والتسليح والملاحظات.")}
			pTopic3={new Topic("لوحات الأسقف", "تسليح البلاطات والكمرات والفتحات والكوابيل واتجاهات التسليح والتفاصيل.")}
			pTopic4={new Topic("قطاعات وتفاصيل", "تفاصيل الكمرات والسلالم والحوائط والعناصر الخاصة والربط بين العناصر.")}
			pTopic5={new Topic("جداول أعمدة وتسليح", "جداول توضح أبعاد الأعمدة وتغيراتها وتسليحها وتفاصيلها بين الأدوار.")}
			pTopic6={new Topic("ملاحظات تنفيذية", "ملاحظات الخرسانة والحديد والغطاء الخرساني والوصلات والكانات والاشتراطات العامة.")}
		/>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#F7F1E8")}>

		<SecTitle
			style = " --StripBg : #E6D1A0 "
			pTitle="النوتة الحسابية والتحليل الإنشائي"
			pDesc="النوتة الحسابية تثبت منطق التصميم وتوضح الأحمال والافتراضات والنماذج والنتائج. حجمها وتفاصيلها يختلفان حسب المشروع والجهة التي ستراجع الملف."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#101820").OfText("محتويات النوتة")}
				pDesc={Text.Body.WithColor("#333333").OfText("يتم ضبط المحتوى حسب نطاق التصميم ومتطلبات المراجعة.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					"بيانات المشروع والنظام الإنشائي المختار.",
					"افتراضات المواد والأكواد والأحمال المستخدمة.",
					"حساب الأحمال الرأسية والحية والميتة وأحمال الحوائط.",
					"نتائج التحليل والتصميم للعناصر الرئيسية.",
					"مراجعات الهبوط والقص والعزوم والقص الثاقب عند الحاجة.",
					"ملخص قطاعات وتسليح وربط باللوحات النهائية."
				]}
			/>

			<CardsGr
				pWidth={new RespString("560px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#101820").OfText("أدوات العمل")}
				pCardBg={new ElemBg("#FFFFFF")}
				pCardTitleFnt={Text.H4.WithColor("#101820")}
