---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, SplitPane, SplitScene } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="تصميم معماري لمستشفى"
	pDescr="تصميم معماري لمستشفى — تصميم معماري يبدأ من البرنامج الوظيفي وقيود الموقع وينتهي بمخططات قابلة للتنسيق مع الإنشائي وMEP والترخيص والتنفيذ. وفي هذه الصفحة يكون التركيز الخاص على فصل حركة المرضى والزوار والطاقم والخدمات ومتطلبات العدوى والطوارئ. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="تصميم معماري لمستشفى">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("تصميم معماري لمستشفى")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("تصميم معماري يبدأ من البرنامج الوظيفي وقيود الموقع وينتهي بمخططات قابلة للتنسيق مع الإنشائي وMEP والترخيص والتنفيذ. وفي هذه الصفحة يكون التركيز الخاص على فصل حركة المرضى والزوار والطاقم والخدمات ومتطلبات العدوى والطوارئ.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<SplitScene pBg={Colors.Gray1} pColumns={new RespString("1fr 1fr","1fr")} pGap={new RespString("12px","10px")} pPad={new RespString("42px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pEdge="Chevron" pEdgeP="None" pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("نطاق الخدمة")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("تحليل الموقع والبرنامج والمساحات مع مراعاة فصل حركة المرضى والزوار والطاقم والخدمات ومتطلبات العدوى والطوارئ، بدائل تخطيطية واختيار الحل المناسب، مخططات معمارية منسقة وقابلة للتطوير التنفيذي.")} />
		</SplitPane>
		<SplitPane pBg={Colors.SkyLite} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("الفائدة قبل الخطوة التالية")} pText={Text.Body.WithColor(Colors.Black).OfText("يحسن استغلال المساحة والحركة والواجهات من البداية ويقلل التعديلات المكلفة عندما تبدأ باقي التخصصات في العمل. ويُراجع القرار هنا تحديدًا في ضوء فصل حركة المرضى والزوار والطاقم والخدمات ومتطلبات العدوى والطوارئ.")} />
		</SplitPane>
	</SplitScene>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("استرشاديًا يبدأ من 100 ج.م/م² وبحد أدنى 10,000 ج.م للمشروع البسيط.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
