---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تصميم هندسي كهرباء"
	pDescr="تصميم هندسي منظم للوحات التوزيع والتحكم للمصانع والمنازل والمنشآت المختلفة، من حساب الأحمال حتى مخططات التنفيذ والتجميع."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تصميم هندسي كهرباء")}
				pText={Text.Body.Centered.OfText("تصميم هندسي منظم للوحات التوزيع والتحكم للمصانع والمنازل والمنشآت المختلفة، من حساب الأحمال حتى مخططات التنفيذ والتجميع.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg("#F6F1E8")}>

		<SecTitle
			style = " --StripBg : #0B1017 "
			pTitle="لوحة الكهرباء هي مركز التحكم الحقيقي في المبنى"
			pDesc="التصميم الجيد للوحة الكهرباء يحول الأحمال المتفرقة إلى منظومة واضحة: مصدر تغذية، حماية، فصل، توزيع، تحكم، قياس، وتوسعات مستقبلية محسوبة. لذلك يتم التعامل مع اللوحة كجزء هندسي مؤثر في الأمان واستمرارية التشغيل وسهولة الصيانة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.WithColor("#111318").OfText("تصميم لوحة قبل التصنيع أو التنفيذ")}
				pText={Text.Body.WithColor("#333333").OfText("نبدأ من طبيعة الأحمال ومصادر التغذية وسيناريوهات التشغيل، ثم نحدد نوع اللوحة ومكوناتها ومسارات الكابلات وأسلوب الحماية والفصل. النتيجة تكون مخططًا واضحًا يصلح للمراجعة والتصنيع والتنفيذ، ويقلل أخطاء التجميع العشوائي داخل الموقع.")}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://commons.wikimedia.org/wiki/Special:Redirect/file/",
					"Main_switchboard_in_large_commercial_building%2C_Brisbane.jpg",
					false,
					"لوحات توزيع رئيسية داخل مبنى تجاري",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#0B1017")}>

		<SecTitle
			style = " --StripBg : #E8D7AA "
			pTitle="ما الذي نقدمه في تصميم لوحات الكهرباء؟"
			pDesc="الخدمة مناسبة للمنزل والفيلا والعمارة والمحل والمكتب والمصنع وخط الإنتاج ومحطات الضخ والتكييف والأنظمة التي تحتاج توزيعًا وتحكمًا وحماية دقيقة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F2DCA2").OfText("أنواع اللوحات التي يشملها التصميم")}
			pCardBg={new ElemBg("#F6F1E8")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("لوحات التوزيع", "تصميم لوحات MDB وSMDB وDB لتغذية الأحمال الرئيسية والفرعية، مع تحديد القواطع والبسبار ومداخل ومخارج الكابلات وجداول الدوائر.")}
			pTopic2={new Topic("لوحات التحكم", "تصميم لوحات تحكم للمضخات والمراوح والكمبروسرات وخطوط الإنتاج، مع دوائر تشغيل وتحكم وحماية مناسبة لطبيعة الحمل.")}
			pTopic3={new Topic("لوحات MCC", "تصميم مراكز التحكم في المحركات للمصانع، مع تنظيم دوائر التشغيل والحماية والفصل والقياس لكل موتور أو مجموعة أحمال.")}
			pTopic4={new Topic("لوحات ATS وAMF", "تصميم لوحات التحويل بين المصدر العمومي والمولد أو المصدر الاحتياطي، مع منطق تشغيل واضح يحافظ على استمرارية التغذية للأحمال المهمة.")}
			pTopic5={new Topic("لوحات تحسين معامل القدرة", "تصميم لوحات PFC وبنوك المكثفات طبقًا لطبيعة الأحمال الحثية، لتحسين كفاءة التغذية وتقليل الهدر ومشكلات معامل القدرة.")}
			pTopic6={new Topic("لوحات المنازل والفيلات", "تصميم لوحات منزلية منظمة للإنارة والبرايز والتكييف والسخانات والمطبخ والأجهزة الخاصة، مع تقسيم واضح يسهل الصيانة والفصل الآمن.")}
		/>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#0B1017")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#151B25")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#C9A75B").OfText("تصميم مرتب من الحمل حتى القاطع")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("القيمة الحقيقية للتصميم تظهر عندما يعرف كل قاطع وظيفته، وكل كابل مساره، وكل دائرة حملها، وكل مستخدم يستطيع عزل الجزء المطلوب دون ارتباك أو مخاطرة.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "320px")}
				pTitle={Text.H3.WithColor("#F2DCA2").OfText("مدخلات التصميم")}
				pDesc={Text.Body.WithColor("#F8F4EA").OfText("كلما كانت بيانات المشروع أوضح، خرج تصميم اللوحة أدق وأسهل في التصنيع والتنفيذ.")}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pNumbered={false}
				pItems={[
					"قائمة الأحمال وقدراتها وطريقة تشغيلها.",
					"مصادر التغذية: عمومي، مولد، UPS، طاقة شمسية، أو أكثر من مصدر.",
					"طبيعة الاستخدام: سكني، تجاري، إداري، طبي، صناعي، أو خدمي.",
					"جهد التشغيل وعدد الفازات وتيار القصر المتوقع إن توفر.",
					"مكان تركيب اللوحة ودرجة الحماية المطلوبة وظروف الحرارة والتهوية.",
					"احتياج التوسع المستقبلي ونسبة الاحتياطي المطلوبة."
				]}
			/>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://commons.wikimedia.org/wiki/Special:Redirect/file/",
					"Armoire_electrique_domotique.JPG",
					false,
					"لوحة كهرباء مع أنظمة تحكم وتشغيل ذكي",
					new Size(new NumPer(560, 320), new NumPer("auto", "auto"))
				)}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#F6F1E8")}>

		<SecTitle
			style = " --StripBg : #E8D7AA "
			pTitle="مراحل تصميم لوحة كهرباء"
			pDesc="نرتب التصميم في مراحل واضحة حتى لا تتحول اللوحة إلى تجميع مكونات منفصل عن واقع الأحمال والموقع."
		/>

		<EmoList
			pWidth={new RespString("1000px", "320px")}
			pTitle={Text.H3.Centered.WithColor("#111318").OfText("منهج العمل")}
			pDesc={Text.Body.Centered.WithColor("#333333").OfText("كل مرحلة لها مخرجات قابلة للمراجعة قبل الانتقال لما بعدها.")}
			pHeadBg={new ElemBg("transparent")}
			pItemsBg={new ElemBg("#FFFFFF")}
			pNumbered={true}
			pItems={[
				{
					Title: "تحليل الأحمال",
					Items: [
						"حصر الأحمال الكهربائية وقدراتها.",
						"تصنيف الأحمال حسب الأهمية وطريقة التشغيل.",
						"تحديد الحمل التشغيلي والاحتياطي والتوسعات المستقبلية."
					]
				},
				{
					Title: "اختيار نوع اللوحة",
					Items: [
						"تحديد هل المطلوب لوحة توزيع أم تحكم أم ATS أم MCC أم PFC.",
						"اختيار شكل اللوحة: حائطية، أرضية، داخلية، خارجية، أو مدمجة مع منظومة أخرى.",
						"تحديد درجة الحماية والتهوية ومساحة التركيب."
					]
				},
				{
					Title: "تصميم المخطط الأحادي",
					Items: [
						"إعداد Single Line Diagram واضح للمصدر والقواطع والمخارج.",
						"تحديد القاطع الرئيسي والقواطع الفرعية.",
						"تنظيم دوائر القياس والحماية والفصل."
					]
				},
				{
					Title: "تنسيق الحماية",
					Items: [
						"مراجعة تيارات التشغيل والتحميل.",
						"اختيار القواطع والسعات المناسبة.",
						"مراعاة التنسيق بين القاطع الرئيسي والفرعي لتقليل فصل غير مطلوب."
					]
				},
				{
					Title: "تجهيز رسومات التجميع",
					Items: [
						"توزيع المكونات داخل اللوحة.",
						"تحديد مسارات الكابلات والبسبارات والترامل.",
						"تجهيز الجداول والبيانات التي يحتاجها المصنع أو فني التجميع."
					]
				},
				{
					Title: "مراجعة التسليم",
					Items: [
						"مراجعة مخطط اللوحة مع بيانات المشروع.",
						"ضبط أسماء الدوائر والترقيم والملصقات.",
						"تجهيز نسخة نهائية للتصنيع أو التنفيذ أو التسعير."
					]
				}
			]}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")}>

		<SecTitle
			style = " --StripBg : #0B1017 "
			pTitle="تصميم لوحات كهرباء للمصانع"
			pDesc="المصنع يحتاج لوحة تحافظ على التشغيل، تفصل الأعطال بدقة، وتخدم الصيانة دون تعطيل واسع. لذلك يتم التركيز على الأحمال الحركية، خطوط الإنتاج، المحركات، المضخات، أنظمة الهواء، ومناطق التشغيل الحساسة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<RespImg
				pImg={new EmoMediaData(
					"Img",
					"https://commons.wikimedia.org/wiki/Special:Redirect/file/",
					"Main_distribution_board_under_construction.JPG",
					false,
					"لوحة توزيع كهرباء أثناء التجميع",
					new Size(new NumPer(520, 300), new NumPer("auto", "auto"))
				)}
			/>

			<CardsGr
				pWidth={new RespString("620px", "320px")}
				pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("اعتبارات اللوحات الصناعية")}
				pCardBg={new ElemBg("#F6F1E8")}
				pCardTitleFnt={Text.H4.WithColor("#111318")}
				pCardBodyFnt={Text.Body.WithColor("#333333")}
				pStackDir="Col"
				pSpacing={20}
				pTopic1={new Topic("استمرارية التشغيل", "توزيع الأحمال بطريقة تمنع تحول عطل محدود إلى توقف كامل في خط الإنتاج أو منطقة تشغيل كبيرة.")}
				pTopic2={new Topic("حماية المحركات", "اختيار دوائر تشغيل وحماية مناسبة للموتورات والمضخات والمراوح مع مراعاة تيارات البدء وطريقة التشغيل.")}
				pTopic3={new Topic("سهولة الصيانة", "تنظيم الدوائر والتسمية والترقيم ومسارات الكابلات بحيث يستطيع فريق الصيانة تتبع الأعطال بسرعة.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#F6F1E8")}>

		<SecTitle
			style = " --StripBg : #E8D7AA "
			pTitle="تصميم لوحات كهرباء للمنازل والفيلات"
			pDesc="في المباني السكنية، التصميم الجيد للوحة ينعكس على الأمان وسهولة الاستخدام اليومي. يتم تقسيم الدوائر بطريقة عملية بين الإنارة والبرايز والتكييف والمطبخ والسخانات والأجهزة الخاصة، مع مراعاة قدرة كل دائرة وسهولة فصلها عند الحاجة."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("لوحة منزلية منظمة")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("تقسيم حسب الاستخدام", "دوائر منفصلة للإنارة والبرايز والتكييف والمطبخ والأحمال الكبيرة لتسهيل العزل والصيانة.")}
			pTopic2={new Topic("حماية الأشخاص", "تحديد احتياجات الحماية المناسبة للأماكن الحساسة والأجهزة ذات الاستخدام المستمر أو الرطوبة أو الأحمال العالية.")}
			pTopic3={new Topic("تسمية واضحة", "إعداد جدول دوائر مفهوم يجعل المستخدم يعرف كل قاطع يتبع أي منطقة أو جهاز.")}
			pTopic4={new Topic("قابلية التوسع", "ترك احتياطي محسوب لأجهزة مستقبلية مثل شاحن سيارة، تكييف إضافي، منظومة ذكية، أو تطوير لاحق.")}
		/>

	</EmoSec>







	<EmoStr pBg={new ElemBg("#0B1017")} pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}>

		<EmoStr
			pBg={new ElemBg("#151B25")}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#C9A75B").OfText("مخرجات تصميم لوحة الكهرباء")}
				pText={Text.Body.Centered.WithColor("#F8F4EA").OfText("التسليم يكون ملفًا هندسيًا يساعدك في التسعير والتوريد والتصنيع والتنفيذ والمراجعة، بدل الاعتماد على وصف شفهي أو قرار فني لحظي داخل الموقع.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#F2DCA2").OfText("ما الذي تستلمه؟")}
			pCardBg={new ElemBg("#F6F1E8")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("Single Line Diagram", "مخطط أحادي يوضح مصدر التغذية والقواطع والمخارج وتوزيع الأحمال.")}
			pTopic2={new Topic("Panel Schedule", "جدول دوائر اللوحة شامل أسماء الأحمال وسعات القواطع والبيانات الأساسية لكل دائرة.")}
			pTopic3={new Topic("Wiring Diagram", "مخططات توصيل وتحكم عند الحاجة، خاصة في لوحات التشغيل والتحكم والمضخات والموتورات.")}
			pTopic4={new Topic("Layout داخلي", "توزيع مبدئي للمكونات داخل اللوحة بما يوضح التنظيم ومسارات الدخول والخروج.")}
			pTopic5={new Topic("Cable Schedule", "جدول للكابلات والمغذيات والمخارج يساعد في الحصر والتسعير والتنفيذ.")}
			pTopic6={new Topic("مواصفات فنية", "تحديد مستوى المكونات ودرجة الحماية والبيانات الفنية اللازمة للتصنيع أو التوريد.")}
		/>

	</EmoStr>







	<EmoSec pBg={new ElemBg("#F6F1E8")}>

		<SecTitle style = " --StripBg : #E8D7AA " pTitle="الاستخدامات المختلفة" pDesc="نطاق الخدمة مرن حسب نوع المشروع وحجم الأحمال وطبيعة التشغيل." />

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.WithColor("#111318").OfText("أين تحتاج تصميم لوحة كهرباء؟")}
			pCardBg={new ElemBg("#FFFFFF")}
			pCardTitleFnt={Text.H4.WithColor("#111318")}
			pCardBodyFnt={Text.Body.WithColor("#333333")}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("المصانع وخطوط الإنتاج", "لوحات توزيع وتحكم للمحركات والماكينات ومناطق التشغيل والأحمال المستمرة.")}
			pTopic2={new Topic("الفيلات والمنازل", "لوحات رئيسية وفرعية منظمة للإنارة والبرايز والتكييف والأجهزة الخاصة.")}
			pTopic3={new Topic("المطاعم والمحلات", "لوحات تخدم الإنارة والتكييف والمطبخ والثلاجات والشفاطات والأجهزة التجارية.")}
			pTopic4={new Topic("المباني الطبية", "توزيع أحمال حساس يحتاج وضوحًا في الفصل والحماية واستمرارية التغذية.")}
			pTopic5={new Topic("المكاتب والمباني الإدارية", "لوحات للأدوار والمناطق وأنظمة التكييف والإنارة والبرايز وأنظمة التشغيل.")}
			pTopic6={new Topic("المضخات والخدمات", "لوحات تحكم وتشغيل للمضخات والبوسترات والخزانات وأنظمة الخدمات الكهروميكانيكية.")}
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg("#FFFFFF")}>

		<SecTitle
			style = " --StripBg : #0B1017 "
			pTitle="لماذا تحتاج تصميمًا هندسيًا قبل تصنيع اللوحة؟"
