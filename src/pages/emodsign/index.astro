import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="HomeAndConstructionBusiness" pTitle="المكتب الهندسي" pDescr="المكتب الهندسي">







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.White.OfText("المكتب الهندسي")} />

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
