---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoWhatsIcon, HzStack, ListItem, VrStack } from "@/Widgets/Comp";
import { AngleBand, MosaicGrid, MosaicItem, SplitPane, SplitScene, StoryRail, StoryStep, ZigzagItem, ZigzagStory } from "@/Widgets/Layouts";
import { Hero, RelatedServices, RelServiceItem } from "@/Widgets/Sections";
import { EmoContactStrip } from "@/Widgets/Strips";
import { ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="مقاولات وتنفيذ أنظمة مكافحة الحريق"
	pDescr="تنفيذ وتركيب واختبار وتسليم أنظمة مكافحة الحريق والإنذار للمباني والمنشآت، من مراجعة التصميم واعتماد الخامات إلى الشبكات والطلمبات والإنذار والاختبارات وملف التسليم."
>







	<Hero pBg={new ElemBg("#111820")}>

		<VrStack pSize={new Size(new NumPer("54%", "95%"))} pLoc={new Loc(new NumPer("5%", "2.5%"), new NumPer("16%", "12%"))} pHzAlign="Center">

			<Emograph
				pTitle={Text.H1.Centered.WithColor("#FCFCFA").OfText("مقاولات وتنفيذ أنظمة مكافحة الحريق")}
				pText={Text.Body.Centered.WithColor("#D7DFE3").OfText("تنفيذ منضبط يبدأ قبل نزول المواسير للموقع: مراجعة النطاق، اعتماد المواد، تنسيق المسارات، ضبط نقاط الفحص، ثم اختبارات موثقة وتسليم يمكن تشغيله وصيانته.")}
			/>

			<HzStack pGap={new Pixel(22, 10)} pForceHz>

				<EmoCallIcon BlackRed />

				<EmoWhatsIcon BlackRed />

			</HzStack>

		</VrStack>

	</Hero>







	<StoryRail
		id="ContractingLifecycle"
		pAxis="Horizontal"
		pAxisP="Vertical"
		pBg="#F5F2EC"
		pAccent="#B8322A"
		pTrackColor="#D4D0CA"
		pPad={new RespString("58px", "16px")}
		pMaxWidth={new RespString("1360px", "100%")}
	>

		<StoryStep
			pNumber="01"
			pKicker="قبل الموقع"
			pTitle="مراجعة التصميم والنطاق"
			pText="مراجعة الرسومات والمقايسة والمواصفات ونقاط الربط والأنظمة الداخلة في العقد، وتحديد ما يحتاج Shop Drawings أو حسابات أو اعتماد قبل التنفيذ."
			pBg="#FFFDF8"
			pAccent="#B8322A"
		/>

		<StoryStep
			pNumber="02"
			pKicker="التوريد"
			pTitle="اعتماد الخامات والمعدات"
			pText="مطابقة الموديلات والشهادات وبيانات المصنع وتصنيفات الضغط والأقطار والمقاسات، ثم ضبط بدائل الخامات قبل دخولها إلى الشراء والموقع."
			pBg="#F1EEE7"
			pAccent="#B88535"
		/>

		<StoryStep
			pNumber="03"
			pKicker="التنسيق"
			pTitle="المسارات والمناسيب"
			pText="تثبيت الرايزرات والخطوط الرئيسية والفروع ومواقع المعدات والكواشف مع المعماري والإنشاء والتكييف والكهرباء والصحي قبل غلق الأسقف أو تنفيذ الفتحات."
			pBg="#EDF2F4"
			pAccent="#4B7185"
		/>

		<StoryStep
			pNumber="04"
			pKicker="التنفيذ"
			pTitle="تركيب الشبكات والأنظمة"
			pText="مواسير وحوامل وصمامات ورشاشات وصناديق وهيدرنت وطلمبات وخزانات وأنظمة إطفاء متخصصة وكابلات وكواشف ولوحات حسب نطاق المشروع."
			pBg="#EEF2EE"
			pAccent="#315D4F"
		/>

		<StoryStep
			pNumber="05"
			pKicker="القبول"
			pTitle="اختبار وتشغيل وتسليم"
			pText="اختبارات الضغط والتدفق والطلمبات والإنذار والبرمجة والتشغيل التجريبي، ثم As-Built وتقارير الاختبار والضمانات وكتيبات التشغيل والتدريب."
			pBg="#F7EDEE"
			pAccent="#8C3138"
		/>

	</StoryRail>







	<SplitScene
		id="ExecutionControl"
		pColumns={new RespString("1.08fr .92fr", "1fr")}
		pGap={new RespString("0px", "0px")}
		pMinHeight={new RespString("580px", "760px")}
		pBg="#FCFCFA"
	>

		<SplitPane
			pBg="#B8322A"
			pColor="#FCFCFA"
			pPad={new RespString("58px", "24px")}
			pEdge="DiagonalEnd"
			pEdgeP="None"
			pHzAlign="Right"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H2.WithColor("#FCFCFA").OfText("إدارة التنفيذ ليست تركيب خامات فقط")}
				pText={Text.Body.WithColor("#FFF0EC").OfText("الفرق بين شبكة تبدو مكتملة ونظام صالح للاختبار هو إدارة نقاط الضبط أثناء التنفيذ. كل مرحلة يجب أن تترك وراءها معلومة يمكن مراجعتها: موديل معتمد، مسار واضح، منسوب مثبت، لحام أو وصلة مفحوصة، صمام في اتجاه صحيح، كابل معرف، أو نتيجة اختبار مسجلة.")}
			/>

		</SplitPane>

		<SplitPane
			pBg="#F4F1EB"
			pPad={new RespString("54px", "22px")}
			pHzAlign="Right"
			pVrAlign="Center"
		>

			<EmoList pItemsBg={new ElemBg("transparent")} pItemFnt={Text.Body.WithColor("#1A252B")} pNumbered={false}>

				<ListItem pText="استلام الخامات ومطابقة الموديلات والشهادات والكميات قبل التركيب." />

				<ListItem pText="تحديد المسارات والمناسيب والفتحات والتعارضات ومساحات الوصول والصيانة." />

				<ListItem pText="فحص اللحام والقلاووظ والفلانشات والحوامل والمسافات والتثبيت." />

				<ListItem pText="مراجعة اتجاهات الصمامات وأجهزة القياس ونقاط الاختبار والتصريف." />

				<ListItem pText="اختبار دوائر الإنذار والكابلات والعناوين والبرمجة وربط Cause & Effect." />

				<ListItem pText="تسجيل أي تعديل موقعي فورًا ليظهر في إصدار As-Built النهائي." />

			</EmoList>

		</SplitPane>

	</SplitScene>







	<ZigzagStory
		id="ExecutionScopes"
		pBg="#E9ECE8"
		pGap={new RespString("34px", "18px")}
		pPad={new RespString("56px", "14px")}
		pAlternate={true}
	>

		<ZigzagItem
			pMediaShare={44}
			pBg="#FFFDF8"
			pMediaBg="#17222D"
			pRadius={new RespString("34px", "20px")}
			pMediaRadius={new RespString("34px", "18px")}
			pMinHeight={new RespString("480px", "680px")}
		>

			<MosaicGrid
				slot="media"
				pColumns={4}
				pColumnsP={2}
				pAutoRows={new RespString("78px", "68px")}
				pGap={new RespString("8px", "7px")}
				pPad={new RespString("16px", "12px")}
				pBg="#17222D"
			>

				<MosaicItem
					pColSpan={4}
					pColSpanP={2}
					pRowSpan={2}
					pBg="#DCEEF4"
				>

					<Emograph pTitle={Text.H3.Centered.OfText("شبكات المياه")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={2}
					pBg="#B8322A"
					pColor="#FCFCFA"
				>

					<Emograph pTitle={Text.H4.Centered.WithColor("#FCFCFA").OfText("رشاشات")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={2}
					pBg="#E7D4B2"
				>

					<Emograph pTitle={Text.H4.Centered.OfText("هيدرنت وصناديق")} />

				</MosaicItem>

			</MosaicGrid>

			<Emograph
				pTitle={Text.H2.OfText("تنفيذ الشبكات المائية")}
				pText={Text.Body.OfText("يشمل الخطوط المدفونة والرايزرات والخطوط الرئيسية والفروع والرشاشات وصناديق الحريق والهيدرنت والصمامات ونقاط الاختبار والتصريف والحوامل والدهانات والتعريف. التنفيذ يراجع باستمرار مع الحسابات ومناسيب المشروع حتى لا تتحول التعديلات الميدانية إلى فقد ضغط أو نقاط صيانة مغلقة.")}
			/>

			<EmoDet BlackSky pText="الأنظمة المائية" pHref="/emofire/water-systems" />

		</ZigzagItem>

		<ZigzagItem
			pMediaShare={42}
			pBg="#F5F1E8"
			pMediaBg="#4A3824"
			pRadius={new RespString("34px", "20px")}
			pMediaRadius={new RespString("34px", "18px")}
			pMinHeight={new RespString("480px", "680px")}
		>

			<MosaicGrid
				slot="media"
				pColumns={4}
				pColumnsP={2}
				pAutoRows={new RespString("78px", "68px")}
				pGap={new RespString("8px", "7px")}
				pPad={new RespString("16px", "12px")}
				pBg="#4A3824"
			>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={3}
					pBg="#E7D4B2"
				>

					<Emograph pTitle={Text.H3.Centered.OfText("Duty")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={2}
					pBg="#B88535"
					pColor="#FCFCFA"
				>

					<Emograph pTitle={Text.H4.Centered.WithColor("#FCFCFA").OfText("Standby")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={1}
					pBg="#F4F0E8"
				>

					<Emograph pTitle={Text.H4.Centered.OfText("Jockey")} />

				</MosaicItem>

			</MosaicGrid>

			<Emograph
				pTitle={Text.H2.OfText("غرف الطلمبات والخزانات")}
				pText={Text.Body.OfText("تحتاج غرف الطلمبات إلى ترتيب يسمح بالسحب والطرد والاختبار والصيانة، ومسافات تشغيل حول المعدات، ولوحات تحكم ومحابس وأجهزة قياس وتصريف وتهوية وإنارة. التنفيذ يرتبط بمنحنيات الطلمبات وسعة الخزان ونقاط التحكم، وليس بتثبيت معدات منفصلة عن التصميم.")}
			/>

			<EmoDet BlackOrange pText="غرف الطلمبات" pHref="/emofire/pumps" />

		</ZigzagItem>

		<ZigzagItem
			pMediaShare={46}
			pBg="#F8F3F2"
			pMediaBg="#491B1D"
			pRadius={new RespString("34px", "20px")}
			pMediaRadius={new RespString("34px", "18px")}
			pMinHeight={new RespString("480px", "680px")}
		>

			<MosaicGrid
				slot="media"
				pColumns={4}
				pColumnsP={2}
				pAutoRows={new RespString("76px", "66px")}
				pGap={new RespString("8px", "7px")}
				pPad={new RespString("16px", "12px")}
				pBg="#491B1D"
			>

				<MosaicItem
					pColSpan={4}
					pColSpanP={2}
					pRowSpan={2}
					pBg="#B8322A"
					pColor="#FCFCFA"
				>

					<Emograph pTitle={Text.H3.Centered.WithColor("#FCFCFA").OfText("Fire Alarm Panel")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={2}
					pBg="#F7EDEE"
				>

					<Emograph pTitle={Text.H4.Centered.OfText("Detection")} />

				</MosaicItem>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={2}
					pBg="#E7D4B2"
				>

					<Emograph pTitle={Text.H4.Centered.OfText("Notification")} />

				</MosaicItem>

			</MosaicGrid>

			<Emograph
				pTitle={Text.H2.OfText("تركيب الإنذار والإطفاء المتخصص")}
				pText={Text.Body.OfText("تثبيت اللوحات والكواشف والموديولات وأجهزة التنبيه والإخلاء الصوتي، وبرمجة العناوين ومنطق التشغيل، وربط أنظمة الإطلاق بالتهوية والأبواب والطاقة والغاز أو الوقود حسب المشروع. الأنظمة المتخصصة تضيف متطلبات للأسطوانات والفوهات وخطوط الإطلاق وإحكام الحيز والتأمين قبل التصريف.")}
			/>

			<HzStack pGap={new Pixel(12, 8)} pForceHz>

				<EmoDet BlackRed pText="الإنذار" pHref="/emofire/alarm" />

				<EmoDet BlackGreen pText="الإطفاء المتخصص" pHref="/emofire/suppression" />

			</HzStack>

		</ZigzagItem>

	</ZigzagStory>







	<MosaicGrid
		id="QualityCheckpoints"
		pColumns={12}
		pColumnsP={4}
		pAutoRows={new RespString("76px", "68px")}
		pGap={new RespString("10px", "8px")}
		pPad={new RespString("50px", "12px")}
		pMaxWidth={new RespString("1320px", "100%")}
		pBg="#101820"
		pRadius={new RespString("30px", "16px")}
	>

		<MosaicItem
			pColSpan={4}
			pColSpanP={4}
			pRowSpan={3}
			pBg="#B8322A"
			pColor="#FCFCFA"
		>

			<Emograph
				pTitle={Text.H2.WithColor("#FCFCFA").OfText("ضبط الجودة بالموقع")}
				pText={Text.Body.WithColor("#FFF0EC").OfText("نقاط الفحص تُحدد قبل التنفيذ، وليس بعد ظهور العيوب.")}
			/>

		</MosaicItem>

		<MosaicItem
			pColSpan={4}
			pColSpanP={2}
			pRowSpan={2}
			pBg="#F6F2EA"
		>

			<Emograph pTitle={Text.H3.OfText("WIR / Inspection")} pText={Text.Body.OfText("مراجعة مرحلة التنفيذ قبل الإغلاق أو الانتقال للمرحلة التالية.")} />

		</MosaicItem>

		<MosaicItem
			pColSpan={4}
			pColSpanP={2}
			pRowSpan={2}
			pBg="#DCEEF4"
		>

			<Emograph pTitle={Text.H3.OfText("Pressure Test")} pText={Text.Body.OfText("اختبار الشبكات وتوثيق الضغط ومدة الثبات والملاحظات.")} />

		</MosaicItem>

		<MosaicItem
			pColSpan={4}
			pColSpanP={2}
			pRowSpan={2}
			pBg="#E7D4B2"
		>

			<Emograph pTitle={Text.H3.OfText("Pump Test")} pText={Text.Body.OfText("مراجعة التشغيل والضغط والتصرف والمنحنى ونقاط Churn وRated و150% Flow.")} />

		</MosaicItem>

		<MosaicItem
			pColSpan={4}
			pColSpanP={2}
			pRowSpan={2}
			pBg="#EEF2EE"
		>

			<Emograph pTitle={Text.H3.OfText("Alarm Test")} pText={Text.Body.OfText("اختبار الأجهزة والعناوين والإشراف والتنبيه والتكامل ووظائف Cause & Effect.")} />

		</MosaicItem>

	</MosaicGrid>







	<AngleBand
		id="Handover"
		pBg="linear-gradient(115deg, #17222D, #263A45)"
		pColor="#FCFCFA"
		pDirection="Fall"
		pCut={new RespString("6%", "3%") }
		pMinHeight={new RespString("390px", "360px") }
	>

		<Emograph
			pSize={new Size(new NumPer("980px", "100%"), new NumPer("auto", "auto"))}
			pTitle={Text.H2.WithColor("#FCFCFA").OfText("التسليم يبدأ أثناء التنفيذ") }
			pText={Text.Body.WithColor("#D7E0E4").OfText("نهاية المشروع لا يجب أن تتحول إلى مطاردة مستندات. ملف التسليم يُبنى بالتوازي مع الموقع: اعتمادات وموديلات، نتائج الاختبارات، تحديثات As-Built، أرقام تشغيل وضمانات، كتيبات التشغيل والصيانة، قوائم قطع الغيار ومحاضر التدريب. عند اكتمال التنفيذ تكون البيانات قد اكتملت معه تقريبًا.") }
		/>

	</AngleBand>







	<RelatedServices pTitle={Text.H2.Centered.WithColor("#FCFCFA").OfText("خدمات مرتبطة بالتنفيذ") } pMax={4} pMaxP={1}>

		<RelServiceItem pTitle="تصميم أنظمة الحريق" pDesc="للمشروعات التي تحتاج تأسيس النطاق والحسابات والمخططات قبل التنفيذ." pHref="/emofire/design" />

		<RelServiceItem pTitle="توريد معدات الحريق" pDesc="اعتماد وتوفير المعدات والمكونات وقطع الغيار." pHref="/emofire/supply" />

		<RelServiceItem pTitle="أنظمة إنذار الحريق" pDesc="تفاصيل اللوحات والكشف والتنبيه والبرمجة والتكامل." pHref="/emofire/alarm" />

		<RelServiceItem pTitle="الحماية المدنية" pDesc="تجهيز الملف الفني والمنشأة للمعاينة والمتابعة." pHref="/emofire/civil-defense" />

	</RelatedServices>







	<EmoContactStrip
		pTitle="اطلب معاينة أو تسعير تنفيذ"
		pDesc="أرسل الرسومات والمقايسة والمواصفات إن وجدت، وحدد حالة الموقع والمرحلة الزمنية ونطاق التوريد المطلوب حتى تبدأ المراجعة من أساس قابل للتسعير والتنفيذ."
		pSourceName="EmoFire Contracting"
	/>







</BLayout>
