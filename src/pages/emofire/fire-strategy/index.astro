---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, RadialItem, RadialLayout } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="إعداد Fire Strategy"
	pDescr="إعداد Fire Strategy — خدمة هندسية متخصصة في الحماية من الحريق تربط تصنيف الخطر والحسابات والأنظمة والرسومات بمتطلبات التشغيل والاعتماد. ويُبنى نطاق إعداد Fire Strategy على حالة المشروع الفعلية لا على وصف عام للخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="إعداد Fire Strategy">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("إعداد Fire Strategy")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("خدمة هندسية متخصصة في الحماية من الحريق تربط تصنيف الخطر والحسابات والأنظمة والرسومات بمتطلبات التشغيل والاعتماد. ويُبنى نطاق إعداد Fire Strategy على حالة المشروع الفعلية لا على وصف عام للخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<RadialLayout pCount={4} pDiameter={new RespString("820px","96%")} pOrbit={new RespString("38%","36%")} pCenterSize={new RespString("30%","36%")} pBg={Colors.Gray1} pCenterBg={Colors.BrownDark} pCenterColor={Colors.WhiteOff} pRingColor={Colors.Gray3} pAccent={Colors.Bistage} pCenterTitle="إعداد Fire Strategy" pCenterText="مسار الخدمة" pStackPortrait={true}>
		<RadialItem pTitle="المدخلات" pText="تحديد الخطر وأساس التصميم" pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<RadialItem pTitle="المعالجة" pText="الحسابات واختيار النظام والمكونات" pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<RadialItem pTitle="المخرج" pText="إصدار الرسومات أو التقرير أو ملف الاعتماد" pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
		<RadialItem pTitle="الفائدة" pText="تمنع اختيار مكونات منفصلة بلا أساس تصميم، وتساعد على اكتشاف النقص والتعارض قبل التنفيذ أو المراجعة الرسمية. ويظل القرار النهائي مرتبطًا ببيانات إعداد Fire Strategy نفسها قبل إصدار العرض." pBg={Colors.BistageLite} pColor={Colors.Black} pAccent={Colors.BistageDark} />
	</RadialLayout>

	<AngleBand id="secSrvCost" pBg={Colors.Black} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 7,500 ج.م للمهمة التصميمية أو المراجعة الصغيرة، ويزيد حسب مساحة وخطورة المنشأة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
