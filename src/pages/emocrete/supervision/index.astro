---
import BLayout from "@/Layout.astro";
import Hero from "@/Widgets/Sections/Hero.astro";
---




















<BLayout
	pSchemaType="CollectionPage"
	pTitle="خدمات الإشراف الهندسي"
	pDescr="​خدمة احترافية للإشراف الهندسي على أعمال البناء والتشطيبات ، بخبرة 14 عاما في المشاريع الهندسية المختلفة"
>

	<div style = " position : relative ; display : block ">

		<Hero
			pImgL="/Media/Emocrete/Supervision/HeroL.webp"
			pImgP="/Media/Emocrete/Supervision/HeroP.webp"
			pTitle="خدمات الإشراف الهندسي"
			pDesc="خدمات الإشراف الهندسي"
			pPosL="1300px"
			pPosP="600px"
		>

			<a class = " cta " href="#cta">
				تواصل معنا
			</a>

		</Hero>

		<p class = " OverlayTitle ">

			عندما تستخدم العقول ..

			<br />

			لتوفير تكلفة الأخطاء :)

		</p>

	</div>

	<section style = " position : relative ">

		<div class = " Strip " style = " background-color : #ECECEC ">

			<div class = " StripInner ">

				<h2 class = " TitleStripTitle ">
					خدمات الإشراف الهندسي على التنفيذ
				</h2>

				<p class = " TitleStripBody ">
					الإشراف الهندسي على التنفيذ هو متابعة ميدانية ومنهجية لضبط جودة أعمال البناء أو التشطيبات عبر استلامات قبل / أثناء / بعد التنفيذ ، والتأكد من مطابقة الرسومات والمواصفات ، وتوثيق الملاحظات والتصحيحات ، بهدف تقليل أخطاء التنفيذ والهدر ورفع جودة الاستلام النهائي
				</p>

			</div>

		</div>

		<div class = " Strip ">

			<div class = " StripInner ">

				<h3 class = " BodyTitle ">
					لماذا تحتاج مهندساً للإشراف على التنفيذ ؟
				</h3>

				<ul class = " BodyList ">

					<li>

						ضمان عدم التلاعب في الخامات باستخدام فئات أقل في السعر أو الجودة من المتفق عليها

					</li>

					<li>

						تجنب الأخطاء الكارثية التي قد تؤدي لتوقف الأعمال لصعوبة العلاج هندسيا بدون إزالتها تماما وإعادة الأعمال

					</li>

					<li>

						تجنب هدر المال والوقت بسبب العمل العشوائي غير المراقب أو غير المنظم

					</li>

				</ul>

				<h3 class = " BodyTitle ">
					تكلفة الإشراف الهندسي على التنفيذ في مصر
				</h3>

				<p style = " margin-bottom : 30px ">
					تختلف طرق تقدير سعر الإشراف الهندسي ( نسبة إشراف - أتعاب ثابتة للزيارة - أتعاب شهرية ثابتة ) ، وحسب حالة كل مشروع يتم الاتفاق على الطريقة والقيمة التي تحقق التوازن بين المالك والمهندس المشرف حسب عدة عوامل منها :
				</p>

				<ul class = " BodyList ">

					<li>

						طبيعة الأعمال : يختلف نطاق أسعار الإشراف الهندسي حسب طبيعة المشروع بناء أو تشطيبات

					</li>

					<li>

						حجم وتكلفة الأعمال : كلما زادت تكلفة الأعمال والبنود المسؤول عنها المهندس المشرف زادت تكلفة الإشراف الهندسي

					</li>

					<li>

						مدة التنفيذ المتوقعة : تؤثر استدامة الأعمال وتواصلها على تقدير أتعاب الإشراف الهندسي ، فكلما كانت الأعمال متصلة بدون
						فترات توقف طويلة زادت فرص انخفاض تكاليف الإشراف الهندسي لتوفر إمكانية متابعة بنود متعددة في الزيارة الواحدة

					</li>

					<li>

						مراحل التنفيذ وعدد الزيارات : كلما زادت المراحل المطلوب استلامها قبل متابعة التنفيذ للمرحلة التالية كلما زادت تكلفة
						الإشراف الهندسي

					</li>

				</ul>

			</div>

		</div>

	</section>

</BLayout>




















<style>



	.OverlayTitle {
		position: absolute;
		right: 80px;
		top: 80px;
		z-index: 3;
		color: white;
		font-size: 30px;
		font-weight: 600;
		line-height: 2;
		text-align: right;
	}


	.Strip {
		display: flex;
		justify-content: center;
		align-items: center;
	}


	.StripInner {
		width: clamp(300px, 80%, 80%);
		margin-inline: auto;
	}


	.TitleStripTitle {
		font-size: 30px;
		text-align: center;
		color: #3899ec;
		font-weight: 700;
	}


	.BodyTitle {
		font-size: 20px;
		text-align: right;
		font-weight: 700;
	}


	.TitleStripBody {
		font-size: 20px;
		align-items: center;
		text-align: justify;
	}


	.BodyList {
		list-style: disc;
		list-style-position: inside;
		padding: 0;
		margin: 0;
		text-align: right;
		line-height: 2;
		font-size: 18px;
	}



</style>
