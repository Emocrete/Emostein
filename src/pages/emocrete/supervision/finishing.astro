---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, EmoMediaData, Colors, Pixel, Topic, Size, Align, RespString } from "@/TypesLib";
import { Hero, ESec, EmoStrip, EmoCall, CardsGr, EmoList, Emograph, RespImg, ReadAlso, RelServices, EmoFaq, EmoContactStrip, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="إشراف هندسي على التشطيبات"
	pDescr="خدمة إشراف هندسي على التشطيبات الداخلية والخارجية، تشمل وضع خطة التنفيذ، متابعة العمال والمقاولين، استلام البنود، مراجعة الخامات، ضبط معدلات الاستهلاك، واعتماد الدفعات حسب جودة وكمية الأعمال المنفذة."
	pSchemaImages={["/Media/Emocrete/Supervision/Finishing/HeroL.webp"]}
>







	<Hero
		pImgF="/Media/Emocrete/Supervision/Finishing/"
		pTitle="إشراف هندسي على التشطيبات"
		pDesc="متابعة هندسية منظمة لأعمال التشطيب الداخلي والخارجي، من خطة الخامات ومواعيد التوريد إلى استلام البنود واعتماد دفعات المقاولين حسب جودة وكمية التنفيذ."
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="right"
		pPosL="18% 48% 12% 6%"
		pPosP="48% 8% 8% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب إشراف تشطيبات" />

	</Hero>







	<ESec
		id="Intro"
		pBg={new ElemBg("#F7F1E6")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #15233A "
			pTitle="التشطيبات أكثر مرحلة تستهلك مال المالك بدون أن يشعر"
			pDesc="في التشطيب لا تظهر الخسارة دائمًا كخطأ ضخم، بل تظهر في خامة أقل من المتفق عليها، بند يتكرر بلا داع، مقاس يتغير بعد التركيب، دفعة تُصرف قبل اكتمال العمل، أو قرار صغير يفتح سلسلة تعديلات مكلفة. دور الإشراف الهندسي أن يحول التشطيب من تنفيذ عشوائي إلى عملية منظمة قابلة للاستلام والمراجعة."
		/>

		<EmoStrip pBg={new ElemBg("#F7F1E6")} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 18)} pPad={new Pixel(0, 0)}>

				<VrStack
					pWidth={new Pixel(700, 340)}
					pGap={new Pixel(20, 14)}
					pPad={new Pixel(0, 0)}
				>

					<Emograph
						pTitle={Text.H3.WithColor("#15233A").OfText("المهندس المشرف لا يختار اللون بدل المالك")}
						pText={Text.Body.OfText("الإشراف على التشطيبات لا يعني أن المهندس يفرض ذوقه في الألوان أو الخامات. القرار الجمالي النهائي للمالك، أما دور المهندس فهو مراجعة قابلية التنفيذ، ترتيب البنود، منع تعارض السباكة والكهرباء والجبس والأرضيات، واستلام جودة التنفيذ قبل أن تتحول الملاحظة إلى إصلاح مكلف بعد السكن أو التشغيل.")}
						pSize={new Size(700, "auto", "100%", "auto")}
					/>

					<CardsGr
						pWidth={new RespString("700px", "100%")}
						pCardBg={new ElemBg("#FFFFFF")}
						pCardTitleFnt={Text.H4.Centered.WithColor("#15233A")}
						pCardBodyFnt={Text.Body.Centered}
						pTopic1={new Topic("خطة", "تحديد ترتيب البنود والخامات ومواعيد التوريد قبل دخول العمال في تضارب أو انتظار.")}
						pTopic2={new Topic("استلام", "فحص الأعمال مرحلة بمرحلة قبل الإغلاق أو الدهان أو التركيب النهائي.")}
						pTopic3={new Topic("دفعات", "ربط صرف مستحقات المقاولين بما تم تنفيذه فعليًا وبالمستوى المتفق عليه.")}
					/>

				</VrStack>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emocrete/Supervision/Finishing/", "HeroL.webp", false, "إشراف هندسي على التشطيبات", new Size(460, "auto", 320, "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		id="OriginalTasks"
		pBg={new ElemBg("#FFFFFF")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F2C14E "
			pTitle="المحاور الأساسية لخدمة الإشراف على التشطيبات"
			pDesc="هذه المحاور محفوظة من مضمون صفحة الخدمة الأصلية، وتم ترتيبها هنا كمنظومة متابعة تنفيذية يفهمها المالك قبل بدء التعاقد مع المقاولين."
		/>

		<EmoStrip pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1200px", "100%")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#15233A")}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("وضع خطة العمل", "وضع خطة العمل وتحديد كميات الخامات المطلوبة ومواعيد توريدها، والتنسيق بين الأنشطة المختلفة لأعمال التشطيبات وفق جدول زمني مناسب.")}
				pTopic2={new Topic("تفسير الرسومات", "تفسير الرسومات الهندسية وتقديم المشورة الهندسية للعمالة المنفذة، ومتابعة سير الأعمال للتحقق من صحة التنفيذ وفق الرسومات.")}
				pTopic3={new Topic("متابعة الخامات والدفعات", "متابعة معدلات استهلاك الخامات حسب تقدم الأعمال، واعتماد الدفعات المالية للمقاولين حسب جودة وكمية الأعمال المنفذة خلال فترات دورية.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec
		id="Fees"
		pBg={new ElemBg("#F7F1E6")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #15233A "
			pTitle="أتعاب الإشراف الهندسي على التشطيبات"
			pDesc="الصفحة القديمة كانت تعرض أتعاب الإشراف كنسبة من إجمالي تكلفة الأعمال، مع اختلاف النسبة حسب حجم التكلفة. يتم تثبيت الرقم النهائي بعد معرفة مدة التنفيذ وعدد الزيارات ونطاق مسؤولية المهندس المشرف."
		/>

		<EmoStrip pBg={new ElemBg("#F7F1E6")} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 16)} pPad={new Pixel(0, 0)}>

				<CardsGr
					pWidth={new RespString("640px", "100%")}
					pGrTitle={Text.H3.Centered.WithColor("#15233A").OfText("النسب المعروضة في الصفحة الأصلية")}
					pCardBg={new ElemBg("#FFFFFF")}
					pCardTitleFnt={Text.H3.Centered.WithColor("#15233A")}
					pCardBodyFnt={Text.H4.Centered}
					pTopic1={new Topic("7 %", "أعمال بتكلفة حتى 1 مليون")}
					pTopic2={new Topic("10 %", "أعمال بتكلفة حتى 500 ألف")}
					pTopic3={new Topic("15 %", "أعمال بتكلفة حتى 250 ألف")}
				/>

				<EmoList
					pWidth={new RespString("520px", "100%")}
					pTitle={Text.H3.WithColor("#15233A").OfText("متى تتغير طريقة احتساب الأتعاب؟")}
					pDesc={Text.Body.OfText("يمكن الاتفاق على نسبة، أو أتعاب زيارة، أو أتعاب شهرية، حسب طبيعة المشروع ومسؤولية المهندس وعدد مرات النزول للموقع.")}
					pHeadBg={new ElemBg("#FFFFFF")}
					pItemsBg={new ElemBg("#FFFFFF")}
					pNumbered={false}
					pItems={[
						"وجود مقاول واحد شامل يختلف عن التعامل مع عدة صنايعية وموردي خامات.",
						"الشقة الصغيرة ذات البنود المحدودة لا تشبه فيلا بها واجهات ولاندسكيب وأنظمة متعددة.",
						"عدد الزيارات الأسبوعية والاستلامات المطلوبة يؤثر مباشرة في تكلفة الإشراف.",
						"إدارة شراء الخامات أو مراجعة المستخلصات التفصيلية قد تحتاج اتفاقًا أوسع من الزيارة الفنية.",
						"المشروع المتوقف أو المتقطع زمنيًا يحتاج ترتيبًا مختلفًا عن مشروع مستمر يوميًا."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<EmoStrip
		id="WorkFlow"
		pBg={new ElemBg("#FFFFFF")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#15233A")}
			pSize={new Size(1200, "auto", "calc(100% - 24px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.White.OfText("مسار الإشراف من أول معاينة إلى التسليم")}
				pText={Text.Body.Centered.White.OfText("الإشراف على التشطيبات لا يبدأ عند دهان آخر حائط. يبدأ قبل دخول أول عامل، لأن ترتيب الأعمال هو الذي يمنع إعادة التكسير وإعادة الشراء وإعادة التركيب.")}
				pSize={new Size(1000, "auto", "100%", "auto")}
			/>

		</EmoStrip>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardBg={new ElemBg("#F7F1E6")}
			pCardTitleFnt={Text.H4.WithColor("#15233A")}
			pCardBodyFnt={Text.Body}
			pTopic1={new Topic("1. معاينة البداية", "مراجعة حالة الوحدة أو المبنى، مستوى التشطيب الحالي، الرسومات أو التصور المطلوب، ونقاط الخطر قبل دخول المقاولين.")}
			pTopic2={new Topic("2. ترتيب البنود", "تحديد تتابع الكهرباء والسباكة والمحارة والعزل والجبس والأرضيات والدهانات والنجارة حتى لا يفسد بند ما قبله.")}
			pTopic3={new Topic("3. خطة خامات وتوريد", "تحديد المواد التي يجب توفيرها قبل كل مرحلة، ومراجعة بدائل الخامات قبل شرائها عندما تؤثر في الجودة أو المقاس أو التركيب.")}
			pTopic4={new Topic("4. استلام قبل الإغلاق", "استلام مواسير السباكة والكهرباء والعزل ومسارات التكييف قبل الإغلاق بالمحارة أو الجبس أو الأرضيات.")}
			pTopic5={new Topic("5. متابعة التنفيذ", "متابعة جودة شغل الصنايعية، نسب الهالك، الالتزام بالمقاسات، ومعالجة الملاحظات في وقتها.")}
			pTopic6={new Topic("6. استلام نهائي وملاحظات", "تجميع الملاحظات النهائية، تحديد الأعمال المطلوب علاجها، ومراجعة التسليم قبل صرف الدفعة الأخيرة.")}
		/>

	</EmoStrip>







	<ESec
		id="FinishItems"
		pBg={new ElemBg("#F7F1E6")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F2C14E "
			pTitle="بنود التشطيبات التي تحتاج استلامًا هندسيًا"
			pDesc="كل بند تشطيب له لحظة استلام حرجة. بعد هذه اللحظة يصبح العلاج أصعب أو أغلى أو ظاهرًا في الشكل النهائي."
		/>

		<EmoStrip pBg={new ElemBg("#F7F1E6")} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 16)} pPad={new Pixel(0, 0)}>

				<EmoList
					pWidth={new RespString("575px", "100%")}
					pTitle={Text.H3.WithColor("#15233A").OfText("أعمال داخلية")}
					pDesc={Text.Body.OfText("مراحل تظهر داخل الشقق والفيلات والمحلات، وتؤثر مباشرة في الراحة والشكل والاستعمال اليومي.")}
					pHeadBg={new ElemBg("#FFFFFF")}
					pItemsBg={new ElemBg("#FFFFFF")}
					pNumbered={true}
					pItems={[
						{ Title: "الكهرباء", Items: ["مراجعة مسارات المواسير، أماكن المفاتيح والبرايز، اللوحات، نقاط الإنارة، الأحمال، وعلاقة الكهرباء بالأثاث والجبس والتكييف."] },
						{ Title: "السباكة والصرف", Items: ["مراجعة الميول، مسارات التغذية والصرف، العزل حول مناطق المياه، أماكن الخلاطات، ومطابقة الأجهزة الصحية للمقاسات الفعلية."] },
						{ Title: "المحارة والجبس", Items: ["فحص استقامة الأسطح، الزوايا، المناسيب، الفتحات، أماكن الاسبوتات، ومسارات التكييف والستائر قبل الدهان."] },
						{ Title: "الأرضيات والحوائط", Items: ["مراجعة منسوب البلاط، الميول، الحلوق، تقطيع السيراميك، استقامة الفواصل، ومناطق التقاء الخامات المختلفة."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("575px", "100%")}
					pTitle={Text.H3.WithColor("#15233A").OfText("أعمال نهائية وخارجية")}
					pDesc={Text.Body.OfText("هذه البنود تشكل الصورة النهائية، وأخطاؤها تكون مرئية للمالك والزائر والمستخدم كل يوم.")}
					pHeadBg={new ElemBg("#FFFFFF")}
					pItemsBg={new ElemBg("#FFFFFF")}
					pNumbered={true}
					pItems={[
						{ Title: "الدهانات", Items: ["مراجعة تجهيز السطح، المعجون، السنفرة، التغطية، انتظام اللون، مناطق الرطوبة، وتعارض الدهان مع الأعمال غير المنتهية."] },
						{ Title: "النجارة والألوميتال", Items: ["مراجعة المقاسات، الفتح والغلق، الخلوص، مستوى التركيب، العتب، الزجاج، الإكسسوارات، وحماية القطع أثناء باقي الأعمال."] },
						{ Title: "الحجر والتجاليد", Items: ["متابعة تنفيذ الحجر والتجاليد والكرانيش والواجهات، واستلام التثبيت والفواصل والمناسيب قبل ظهور عيوب شكلية أو تسريب."] },
						{ Title: "الديكورات والتفاصيل", Items: ["متابعة أعمال الديكورات الداخلية، الأعمال الجبسية، وحدات الإضاءة، التجميعات النهائية، والتأكد من مطابقتها لرغبة المالك والتصور المتوقع."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		id="Quality"
		pBg={new ElemBg("#FFFFFF")}
		pAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #15233A "
			pTitle="لماذا تحتاج إشرافًا مستقلًا في التشطيبات؟"
			pDesc="التشطيب يعتمد على عشرات القرارات الصغيرة. عند تركها للموقع وحده، يصبح الحكم النهائي للسرعة أو العادة أو مصلحة المقاول، لا لما اتفق عليه المالك في الجودة والشكل والتكلفة."
		/>

		<EmoStrip pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1200px", "100%")}
				pCardBg={new ElemBg("#F7F1E6")}
				pCardTitleFnt={Text.H4.WithColor("#15233A")}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("منع إخفاء العيوب", "كثير من عيوب السباكة والكهرباء والعزل تختفي بعد المحارة أو الجبس أو البلاط، ولا تظهر إلا عند التسريب أو العطل أو سوء الاستخدام.")}
				pTopic2={new Topic("ضبط الخامات", "المهندس يراجع أن الخامة المستخدمة من نفس النوع أو الفئة المتفق عليها، وأن التركيب مناسب لطبيعة المكان وليس للشكل فقط.")}
				pTopic3={new Topic("تقليل الهالك", "التقطيع العشوائي، سوء التخزين، إعادة العمل، وشراء خامات قبل أوانها كلها بنود ترفع التكلفة دون إضافة قيمة.")}
				pTopic4={new Topic("حماية الدفعة الأخيرة", "صرف الدفعات قبل اكتمال الملاحظات يضعف موقف المالك. الإشراف يربط الدفع بحالة التنفيذ الفعلية.")}
				pTopic5={new Topic("تنظيم الصنايعية", "التشطيبات تحتاج ترتيبًا بين السباك والكهربائي والنقاش والنجار والجباس والمبلط حتى لا يفسد كل طرف عمل الآخر.")}
				pTopic6={new Topic("مراجعة الذوق فنيًا", "رغبة المالك تُترجم إلى تنفيذ قابل للضبط: مقاس، منسوب، خط، إضاءة، تفصيلة، خامة، وطريقة تركيب.")}
			/>

		</EmoStrip>

	</ESec>







	<EmoStrip
		id="Payments"
		pBg={new ElemBg("#F7F1E6")}
		pAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg("#F2C14E")}
			pSize={new Size(1200, "auto", "calc(100% - 24px)", "auto")}
			pAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#15233A").OfText("متابعة الخامات والدفعات المالية")}
				pText={Text.Body.Centered.OfText("أكبر مساحة نزاع في التشطيبات ليست دائمًا جودة التنفيذ، بل: من اشترى؟ ماذا استُهلك؟ هل البند انتهى؟ وهل يستحق المقاول الدفعة المطلوبة؟")}
				pSize={new Size(1000, "auto", "100%", "auto")}
			/>

		</EmoStrip>

		<HzStack pGap={new Pixel(25, 16)} pPad={new Pixel(0, 0)}>

			<EmoList
				pWidth={new RespString("575px", "100%")}
				pTitle={Text.H3.WithColor("#15233A").OfText("متابعة الخامات")}
				pDesc={Text.Body.OfText("لا يكفي أن تكون الخامة غالية؛ المهم أن تكون مناسبة للبند ومخزنة ومستخدمة بطريقة صحيحة.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
					"مراجعة نوع الخامة قبل الشراء عندما تؤثر في جودة البند أو طريقة التنفيذ.",
					"تنبيه المالك إلى الخامات التي يجب توريدها مبكرًا حتى لا يتوقف العمل.",
					"متابعة معدلات الاستهلاك مقارنة بتقدم الأعمال لتقليل الهالك والشراء الزائد.",
					"رفض استخدام خامة غير مناسبة حتى لو كانت متاحة في الموقع أو أرخص للمقاول.",
					"التمييز بين التوفير المقبول والتخفيض الذي يضر العمر الافتراضي أو الشكل النهائي."
				]}
			/>

			<EmoList
				pWidth={new RespString("575px", "100%")}
				pTitle={Text.H3.WithColor("#15233A").OfText("اعتماد الدفعات")}
				pDesc={Text.Body.OfText("الدفع يجب أن يرتبط بالكمية المقبولة فنيًا، وليس بمجرد حضور العمال أو شراء خامات أو وعد بالانتهاء لاحقًا.")}
				pHeadBg={new ElemBg("#FFFFFF")}
				pItemsBg={new ElemBg("#FFFFFF")}
				pNumbered={false}
				pItems={[
