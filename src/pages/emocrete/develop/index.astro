---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoBtn, EmoCall, Emograph, EmoList, HzStack, SecTitle, Tree, VrStack } from "@/Widgets/Comp";
import { YTPlayer } from "@/Widgets/Media";
import { ESec, Hero, IndexSec } from "@/Widgets/Sections";
import { BottTriSep, IncLineSep } from "@/Widgets/Separators";
import { EmoStrip } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="CollectionPage"
	pTitle="تطوير عقاري"
	pDescr="نقدم حلولاً متكاملة في مجال التطوير العقاري، بداية من الفكرة والتخطيط وصولاً إلى التنفيذ والتسليم. نركز على الجودة، الجدوى الاقتصادية، والاستدامة في كل مشروع نتبناه"
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تطوير عقاري")}
				pText={Text.Body.Centered.OfText("نقدم حلولاً متكاملة في مجال التطوير العقاري، بداية من الفكرة والتخطيط وصولاً إلى التنفيذ والتسليم. نركز على الجودة، الجدوى الاقتصادية، والاستدامة في كل مشروع نتبناه")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<ESec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F6F1E8 "
			pTitle="ما المقصود بخدمات التطوير العقاري هنا؟"
			pDesc="صفحة تعريفية عامة قبل الانتقال إلى الصفحات المتخصصة"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H3.WithColor("#17345C").OfText("التطوير العقاري هنا ليس مقاولة بناء فقط")}
				pText={Text.Body.WithColor("#333333").OfText("المقصود هو إدارة مشروع عقاري كامل يبدأ من دراسة الأرض أو دراسة موقف الملاك، ثم تحويل الفكرة إلى تصميمات، وترخيص، ومقايسة، وجدول تمويل، وتعاقدات، وتنفيذ، ومتابعة جودة، وحسابات واضحة. هذه الصفحة تجمع النظامين الأساسيين في هذا المجال: نظام البناء على أراضي المشاركات، ونظام البناء لصالح اتحاد ملاك بتمويل من السكان أنفسهم.")}
				pSize={new Size(new NumPer(920, "100%"), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="ما الفرق العملي بين النظامين؟"
			pDesc="الاختلاف ليس في شكل المبنى فقط، بل في من يمول، ومن يقرر، ومن يتحمل المخاطر، وكيف يتم توزيع الحقوق"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("في نظام المشاركات")}
					pText={Text.Body.WithColor("#333333").OfText("الأرض نفسها تكون جزءا أساسيا من هيكل المشروع. صاحب الأرض يدخل بقيمة الأرض، والطرف المطور أو مجموعة التمويل يدخل بخبرة الإدارة أو التمويل أو التنفيذ، ثم يتم الاتفاق على نسب عادلة بناء على الدراسة والتكلفة والقيمة المتوقعة للمشروع.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("في نظام اتحاد الملاك")}
					pText={Text.Body.WithColor("#333333").OfText("التمويل يأتي من السكان أو الملاك أنفسهم. الاحتياج الأساسي هنا هو ضبط القرار الجماعي، وتوزيع الالتزامات، وإدارة التعاقدات، ومتابعة الصرف والتنفيذ بطريقة شفافة تمنع الخلافات وتحافظ على حقوق كل مالك.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #B78A25 "
			pTitle="دورنا في إدارة مشروع التطوير"
			pDesc="نحول الفكرة من اتفاق شفهي أو رغبة عامة إلى مشروع قابل للحساب والتنفيذ والمتابعة"
		/>

		<EmoStrip
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("دراسة قبل القرار")}
					pText={Text.Body.WithColor("#333333").OfText("نراجع الموقع، والمساحة، والاشتراطات، وإمكانية البناء، والتكلفة المتوقعة، وطريقة التمويل، ونموذج العائد أو التوفير قبل الدخول في التزام تنفيذي.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("إدارة هندسية وقانونية")}
					pText={Text.Body.WithColor("#333333").OfText("ندير التصميمات، والترخيص، والمقايسات، والتعاقدات، والمستخلصات، ومتابعة الجودة، وربط كل قرار هندسي بأثره المالي والقانوني على المشروع.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("شفافية في التمويل والتنفيذ")}
					pText={Text.Body.WithColor("#333333").OfText("سواء كان التمويل من قيمة الأرض في المشاركات أو من مساهمات السكان في اتحاد الملاك، يتم ضبط الحسابات والمراحل والتقارير بحيث يعرف كل طرف أين تذهب التكلفة.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #17345C "
			pTitle="مسار العمل قبل اختيار الصفحة المتخصصة"
			pDesc="نبدأ بفهم الحالة، ثم نحدد هل الأنسب هو نظام مشاركات أم اتحاد ملاك"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("1 — فحص الحالة الحالية")}
					pText={Text.Body.WithColor("#333333").OfText("نراجع مستندات الأرض أو العقار، وموقف الملكية، والاشتراطات البنائية، والقيود القانونية أو التخطيطية التي قد تؤثر على المشروع.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("2 — تصور هندسي ومالي")}
					pText={Text.Body.WithColor("#333333").OfText("نجهز تصورا مبدئيا للمساحات، والتكلفة، ومراحل التنفيذ، وطريقة التمويل، ونموذج توزيع الحقوق أو الوحدات أو نسب المشاركة.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("3 — تحديد النظام المناسب")}
					pText={Text.Body.WithColor("#333333").OfText("إذا كانت الأرض هي محور الاتفاق فالغالب أن صفحة المشاركات هي البداية الصحيحة. أما إذا كان التمويل من مجموعة سكان أو ملاك فصفحة اتحاد الملاك هي الأقرب للحالة.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>







</BLayout>
