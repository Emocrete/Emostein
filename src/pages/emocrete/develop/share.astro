---
import BLayout from "@/Layout.astro";
import { FullCard } from "@/Widgets/Cards";
import { EmoCall, Emograph, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="البناء على أراضي المشاركات"
	pDescr="خدمات إدارة مشروعات البناء على أراضي المشاركات في مصر، بداية من دراسة الأرض وتقدير الجدوى ونسب المشاركة، حتى التصميم والترخيص والتعاقد والتنفيذ والمتابعة والتسليم."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("البناء على أراضي المشاركات")}
				pText={Text.Body.Centered.OfText("نحول الأرض إلى مشروع عقاري قابل للتنفيذ من خلال دراسة هندسية ومالية واضحة تحفظ حقوق صاحب الأرض وباقي أطراف المشاركة")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F6F1E8 "
			pTitle="ما هي مشاركات البناء؟"
			pDesc="نظام تطوير عقاري تكون فيه الأرض هي نقطة البداية، ويتم تحويلها إلى مشروع بناء منظم بدل بيعها أو تركها بدون استغلال"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H3.WithColor("#17345C").OfText("الفكرة الأساسية")}
				pText={Text.Body.WithColor("#333333").OfText("مشاركة البناء هي اتفاق بين صاحب أرض وطرف أو أكثر لديهم قدرة على التمويل أو الإدارة أو التطوير، بهدف إنشاء مشروع عقاري على الأرض ثم توزيع الناتج أو العائد طبقا لاتفاق واضح. قيمة الأرض لا تضيع في صورة بيع مباشر، والتمويل لا يدخل في مشروع غير محسوب، لأن القرار يبدأ بدراسة هندسية ومالية وقانونية قبل التعاقد والتنفيذ.")}
				pSize={new Size(new NumPer(920, "100%"), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #17345C "
			pTitle="لمن يناسب نظام المشاركات؟"
			pDesc="النظام لا يناسب كل أرض ولا كل مالك، لكنه يكون فعالا عندما تكون قيمة الأرض كبيرة والتطوير أفضل من البيع المباشر"
		/>

		<EmoStr
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("صاحب أرض لا يريد البيع")}
					pText={Text.Body.WithColor("#333333").OfText("لو لديك أرض صالحة للبناء وتريد الاستفادة من قيمتها على هيئة وحدات أو عائد من مشروع بدلا من بيعها بسعر لحظي، فالمشاركة قد تكون خيارا مناسبا بشرط دراسة التكلفة والمخاطر ونسب التوزيع بدقة.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("ممول أو مطور يبحث عن أرض")}
					pText={Text.Body.WithColor("#333333").OfText("لو لديك قدرة على تمويل أو إدارة مشروع بناء ولا تريد شراء الأرض بالكامل في البداية، فقد يكون نظام المشاركة مدخلا مناسبا للدخول في مشروع عقاري بشرط وجود أرض واضحة الملكية وجدوى قابلة للتحقق.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="ما الذي ندرسه قبل قبول مشروع مشاركة؟"
			pDesc="القرار لا يبدأ من نسبة المشاركة، بل من صلاحية الأرض وقدرة المشروع على تغطية تكلفته وتحقيق قيمة عادلة للأطراف"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("موقف الأرض")}
					pText={Text.Body.WithColor("#333333").OfText("نراجع موقع الأرض، ومساحتها، وواجهاتها، وموقف الملكية، وحدودها، ومدى وضوح المستندات، وأي قيود قد تؤثر على البناء أو الترخيص أو البيع لاحقا.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("الاشتراطات البنائية")}
					pText={Text.Body.WithColor("#333333").OfText("نحدد ما يمكن بناؤه فعليا من حيث عدد الأدوار، ونسبة البناء، والارتدادات، والجراجات، والاستخدامات المتاحة، لأن هذه العناصر هي التي تحكم حجم المشروع وقيمته.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("الجدوى والتكلفة")}
					pText={Text.Body.WithColor("#333333").OfText("نقارن بين قيمة الأرض، وتكلفة التصميم والترخيص والتنفيذ، والقيمة المتوقعة للوحدات، حتى لا يتحول الاتفاق إلى نسبة شكلية غير قابلة للتحقيق ماليا.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #B78A25 "
			pTitle="نماذج شائعة لاتفاق المشاركة"
			pDesc="صيغة الاتفاق تختلف حسب قيمة الأرض وحجم التمويل ودور كل طرف، ولا توجد نسبة عادلة قبل دراسة المشروع"
		/>

		<EmoStr
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("الأرض مقابل نسبة من الوحدات")}
					pText={Text.Body.WithColor("#333333").OfText("صاحب الأرض يدخل بقيمة الأرض، والطرف الآخر يتحمل التمويل والإدارة والتنفيذ، ثم يتم توزيع الوحدات أو العائد طبقا لنسبة يتم تحديدها بعد حساب قيمة الأرض والتكلفة والمخاطر وقيمة البيع المتوقعة.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("الأرض مع مساهمة جزئية من المالك")}
					pText={Text.Body.WithColor("#333333").OfText("في بعض الحالات يشارك صاحب الأرض بجزء من التمويل بجانب قيمة الأرض، بهدف تحسين حصته النهائية أو تقليل الاعتماد على ممول خارجي، ويحتاج هذا النموذج إلى ضبط واضح لمواعيد السداد ومسؤوليات كل طرف.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("إدارة تطوير مقابل أجر أو نسبة")}
					pText={Text.Body.WithColor("#333333").OfText("قد يكون دورنا إدارة المشروع لصالح الأطراف بدون الدخول كطرف مالك في المشاركة، بحيث تشمل الخدمة الدراسة والتصميم والترخيص والتعاقدات ومتابعة التنفيذ والحسابات مقابل أتعاب أو نسبة إدارة يتم الاتفاق عليها.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #17345C "
			pTitle="مراحل خدمة إدارة المشاركة"
			pDesc="نقسم المشروع إلى مراحل واضحة حتى لا يتحول الاتفاق إلى وعود عامة غير قابلة للقياس"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("1 — فحص الأرض والمستندات")}
					pText={Text.Body.WithColor("#333333").OfText("نبدأ بفهم الأرض على الطبيعة ومراجعة المستندات المتاحة ومقارنة الوضع الفعلي بما يمكن ترخيصه وتنفيذه، لأن أي غموض في هذه المرحلة سينتقل مباشرة إلى التعاقد والتكلفة.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("2 — تصور مبدئي للمشروع")}
					pText={Text.Body.WithColor("#333333").OfText("نجهز تصورا مبدئيا للمساحات والاستخدامات وعدد الوحدات والتكلفة المتوقعة، بحيث يفهم كل طرف حجم المشروع قبل مناقشة نسبة المشاركة أو طريقة التوزيع.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("3 — تقدير نسب المشاركة")}
					pText={Text.Body.WithColor("#333333").OfText("نربط نسبة كل طرف بقيمة مساهمته الفعلية، سواء كانت أرضا أو تمويلا أو إدارة أو تنفيذ، مع توضيح أثر تغير التكلفة أو الأسعار على الاتفاق قبل تثبيته.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("4 — التصميم والترخيص والتعاقد")}
					pText={Text.Body.WithColor("#333333").OfText("بعد الاتفاق على الإطار العام، ننتقل إلى التصميمات والمقايسات والترخيص وتجهيز عقود التنفيذ والتوريد والإشراف، بحيث تكون القرارات التنفيذية مرتبطة بخطة مالية واضحة.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("5 — متابعة التنفيذ والحسابات")}
					pText={Text.Body.WithColor("#333333").OfText("أثناء التنفيذ تتم متابعة الجودة والمستخلصات والتكاليف والبرنامج الزمني، مع تقارير دورية تساعد الأطراف على معرفة موقف المشروع بدقة وتقلل فرص الخلافات.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="متى تكون المشاركة خطرة؟"
			pDesc="ليست كل أرض مناسبة للمشاركة، وليست كل نسبة مرتفعة لصاحب الأرض تعني اتفاقا أفضل"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("مستندات غير واضحة")}
					pText={Text.Body.WithColor("#333333").OfText("أي غموض في الملكية أو الحدود أو حق التصرف أو موقف الترخيص قد يجعل المشروع متوقفا قبل أن يبدأ، لذلك لا نعامل المستندات كإجراء شكلي.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("نسبة غير مرتبطة بالجدوى")}
					pText={Text.Body.WithColor("#333333").OfText("النسبة العالية على الورق قد تكون غير واقعية إذا كانت تكلفة البناء والتمويل والمخاطر لا تسمح بها، لذلك يتم تقييم النسبة من داخل نموذج مالي وليس بالمقارنة العشوائية.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("تداخل القرارات بين الأطراف")}
					pText={Text.Body.WithColor("#333333").OfText("المشاركة تحتاج صلاحيات واضحة: من يقرر، ومن يعتمد المصروفات، ومن يراجع المستخلصات، ومن يملك حق التعديل، لأن غياب الإدارة يحول المشروع إلى نزاع مستمر.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#17345C")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #102744 "
			pTitle="ما الذي نقدمه في مشروع المشاركة؟"
			pDesc="الخدمة يمكن أن تبدأ بدراسة أولية فقط، أو تمتد إلى إدارة المشروع بالكامل حتى التسليم"
		/>

		<EmoStr
			pBg={new ElemBg("#17345C")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<FullCard
					pTitle={Text.H3.OfText("دراسة مشاركة أرض")}
					pText={Text.Body.OfText("فحص الأرض والمستندات والاشتراطات وتقدير أولي للتكلفة وقيمة المشروع ونسبة المشاركة الممكنة قبل الدخول في تفاوض تفصيلي.")}
				/>

				<FullCard
					pTitle={Text.H3.OfText("إدارة مشروع المشاركة")}
					pText={Text.Body.OfText("إدارة التصميم والترخيص والتعاقدات والمقايسات ومتابعة التنفيذ والحسابات والتقارير حتى يتحول الاتفاق إلى مشروع قابل للتسليم.")}
				/>

				<FullCard
					pTitle={Text.H3.OfText("بديل اتحاد الملاك")}
					pText={Text.Body.OfText("إذا كان المشروع ممولا من السكان أو الملاك أنفسهم وليس من خلال صاحب أرض وممول، فالأقرب لحالتك هو نظام البناء لاتحاد ملاك.")}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







</BLayout>
