---
import BLayout from "@/Layout.astro";
import { FullCard } from "@/Widgets/Cards";
import { EmoCall, Emograph, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="البناء لاتحاد ملاك"
	pDescr="خدمات إدارة مشروعات البناء لاتحاد ملاك في مصر بتمويل من السكان أو الملاك أنفسهم، بداية من دراسة الأرض أو العقار وتنظيم الالتزامات، حتى التصميم والترخيص والتعاقد والتنفيذ والمتابعة والتسليم."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("البناء لاتحاد ملاك")}
				pText={Text.Body.Centered.OfText("نحول اتفاق الملاك أو السكان إلى مشروع بناء منظم بتمويل ذاتي، وحسابات واضحة، وإدارة هندسية تحفظ حقوق كل طرف")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #F6F1E8 "
			pTitle="ما المقصود بالبناء لاتحاد ملاك؟"
			pDesc="نظام يعتمد على تمويل الملاك أو السكان للمشروع بأنفسهم بدل انتظار مطور خارجي أو الدخول في اتفاق مشاركة"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H3.WithColor("#17345C").OfText("الفكرة الأساسية")}
				pText={Text.Body.WithColor("#333333").OfText("البناء لاتحاد ملاك يعني أن مجموعة ملاك أو سكان تتفق على تمويل بناء عقار أو مشروع سكني من مواردهم هم، مع وجود إدارة هندسية ومالية واضحة تنظم التصميمات، والترخيص، والتعاقدات، والمستخلصات، ومتابعة التنفيذ. الفكرة هنا ليست أن كل مالك يدفع فقط، بل أن يتحول التمويل الجماعي إلى مشروع قابل للحساب والمتابعة والتسليم بدون ارتجال أو تضارب قرارات.")}
				pSize={new Size(new NumPer(920, "100%"), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #17345C "
			pTitle="متى يكون نظام اتحاد الملاك مناسبًا؟"
			pDesc="النظام يناسب الحالات التي يملك فيها الأطراف الأرض أو الحق في البناء، لكنهم يحتاجون إلى تنظيم التمويل والإدارة والتنفيذ"
		/>

		<EmoStr
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("مجموعة ملاك لأرض واحدة")}
					pText={Text.Body.WithColor("#333333").OfText("عندما يمتلك عدة أشخاص أرضا ويريدون بناءها بدلا من بيعها أو تركها معطلة، يكون الاحتياج الأساسي هو تحويل الملكية المشتركة إلى خطة تصميم وتمويل وتنفيذ وتوزيع وحدات واضحة لكل مالك.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("سكان يريدون بناء عقارهم")}
					pText={Text.Body.WithColor("#333333").OfText("عندما يتفق السكان أو الملاك على تمويل بناء عقار بأنفسهم، تكون المشكلة الأكبر ليست في المقاولة فقط، بل في ضبط الأقساط، والقرارات، والمواصفات، والتعاقدات، ومتابعة الصرف والتنفيذ.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="ما الفرق بين اتحاد الملاك والمشاركات؟"
			pDesc="الاتحاد يعتمد على تمويل داخلي من الملاك، بينما المشاركة تعتمد غالبا على دخول طرف آخر بقيمة تمويل أو إدارة أو تطوير مقابل حصة"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("في اتحاد الملاك")}
					pText={Text.Body.WithColor("#333333").OfText("مصدر التمويل يكون من الملاك أو السكان أنفسهم. لذلك تصبح الإدارة المالية والشفافية في المصروفات ومواعيد السداد واعتماد القرارات عناصر حاسمة، لأن أي خلل في الالتزام أو التواصل قد يوقف المشروع حتى لو كانت الفكرة ناجحة.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("في نظام المشاركات")}
					pText={Text.Body.WithColor("#333333").OfText("الأرض تدخل كقيمة رئيسية في المشروع، وقد يدخل طرف آخر بالتمويل أو التطوير أو الإدارة مقابل نسبة من الوحدات أو العائد. لذلك تكون نقطة التركيز هي تقدير قيمة الأرض ونسبة المشاركة وجدوى المشروع بالنسبة لكل طرف.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #B78A25 "
			pTitle="ما الذي يجب ضبطه قبل جمع التمويل؟"
			pDesc="أكبر خطأ في مشروعات اتحاد الملاك هو البدء في تحصيل الأموال قبل وجود تصور هندسي ومالي وإداري واضح"
		/>

		<EmoStr
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("حدود المشروع")}
					pText={Text.Body.WithColor("#333333").OfText("يجب تحديد الأرض أو العقار، والموقف المستندي، والمساحات المتوقعة، والاشتراطات، ونطاق الأعمال المطلوب، حتى لا يدفع الملاك على فكرة غير محددة أو تتغير كل أسبوع.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("نظام السداد")}
					pText={Text.Body.WithColor("#333333").OfText("يجب تحديد قيمة المساهمة، ومواعيد السداد، وطريقة التعامل مع التأخير، وحدود الزيادة المحتملة في التكلفة، حتى لا يتعطل المشروع بسبب تفاوت قدرة الملاك على الدفع.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("صلاحيات القرار")}
					pText={Text.Body.WithColor("#333333").OfText("يجب تحديد من يعتمد الرسومات، ومن يوافق على التعاقدات، ومن يراجع المستخلصات، ومن يقرر التعديلات، حتى لا يتحول كل بند صغير إلى خلاف جماعي يعطل التنفيذ.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #17345C "
			pTitle="مراحل إدارة مشروع اتحاد الملاك"
			pDesc="نقسم المشروع إلى خطوات واضحة تربط القرار الهندسي بالتمويل والحسابات والتنفيذ"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("1 — فحص الأرض أو العقار")}
					pText={Text.Body.WithColor("#333333").OfText("نراجع موقف الأرض أو العقار، وحدود الملكية، والاشتراطات البنائية، والقيود المؤثرة على الترخيص أو التنفيذ، حتى تكون بداية المشروع قائمة على واقع قابل للبناء.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("2 — تصور هندسي مبدئي")}
					pText={Text.Body.WithColor("#333333").OfText("نجهز تصورًا مبدئيًا للمساحات وعدد الوحدات والاستخدامات والمداخل والجراجات ومستوى التشطيب المستهدف، حتى يعرف الملاك ما الذي يمولونه فعلا.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("3 — تقدير تكلفة وجدول مساهمات")}
					pText={Text.Body.WithColor("#333333").OfText("نقسم التكلفة إلى مراحل تصميم وترخيص وتنفيذ وتوريدات وإشراف واحتياطي مخاطر، ثم نربطها بجدول مساهمات واضح يساعد الملاك على معرفة التزاماتهم قبل البدء.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("4 — التصميم والترخيص والتعاقد")}
					pText={Text.Body.WithColor("#333333").OfText("بعد اعتماد الإطار العام، يتم تجهيز التصميمات والمستندات والمقايسات، ثم اختيار طريقة التعاقد المناسبة مع المقاولين والموردين بما يضمن وضوح الأسعار ونطاق الأعمال.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("5 — متابعة التنفيذ والحسابات")}
					pText={Text.Body.WithColor("#333333").OfText("أثناء التنفيذ تتم متابعة الجودة والبرنامج الزمني والمستخلصات والمصروفات والتغييرات، مع تقارير دورية توضح للملاك ما تم صرفه وما تم إنجازه وما هو مطلوب في المرحلة التالية.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="أخطاء شائعة في مشروعات اتحاد الملاك"
			pDesc="هذه الأخطاء قد تجعل مشروعًا قابلًا للنجاح يتحول إلى خلاف طويل أو توقف في منتصف الطريق"
		/>

		<EmoStr
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("البدء بدون مقايسة واضحة")}
					pText={Text.Body.WithColor("#333333").OfText("عندما يبدأ التحصيل أو التنفيذ بدون مقايسة ونطاق أعمال واضح، تظهر زيادات مفاجئة ويبدأ الخلاف حول من المسؤول عن فرق التكلفة ومن وافق على البنود الجديدة.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("تغيير المواصفات أثناء التنفيذ")}
					pText={Text.Body.WithColor("#333333").OfText("تغيير مستوى التشطيب أو النظام الإنشائي أو تفاصيل الواجهات أثناء التنفيذ يرفع التكلفة ويؤثر على الجدول الزمني، لذلك يجب ضبط المواصفات قبل التعاقد قدر الإمكان.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("غياب ممثل فني للملاك")}
					pText={Text.Body.WithColor("#333333").OfText("الاعتماد على المقاول وحده في الشرح والقرار والمستخلصات يضع الملاك في موقف ضعيف، لذلك يحتاج الاتحاد إلى جهة فنية تراجع الأعمال والتكلفة قبل الاعتماد.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg("#17345C")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #102744 "
			pTitle="ما الذي نقدمه لاتحاد الملاك؟"
			pDesc="يمكن أن نبدأ بدراسة أولية فقط، أو نتولى الإدارة الهندسية والتنفيذية الكاملة للمشروع حتى التسليم"
		/>

		<EmoStr
			pBg={new ElemBg("#17345C")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<FullCard
					pTitle={Text.H3.OfText("دراسة مبدئية للمشروع")}
					pText={Text.Body.OfText("فحص الأرض أو العقار، وتقدير المساحات والتكلفة والمخاطر، وتجهيز تصور يساعد الملاك على اتخاذ قرار واضح قبل جمع التمويل أو بدء التعاقد.")}
				/>

				<FullCard
					pTitle={Text.H3.OfText("إدارة هندسية لاتحاد الملاك")}
					pText={Text.Body.OfText("تنظيم التصميمات والترخيص والمقايسات والتعاقدات ومتابعة التنفيذ والمستخلصات والتقارير، بحيث يعرف كل مالك موقف المشروع والتكلفة بوضوح.")}
				/>

				<FullCard
					pTitle={Text.H3.OfText("مقارنة مع نظام المشاركات")}
					pText={Text.Body.OfText("إذا كان المشروع مبنيا على دخول صاحب الأرض بحصة ودخول طرف آخر بالتمويل أو الإدارة مقابل نسبة، فالأقرب لحالتك هو نظام البناء على أراضي المشاركات.")}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







</BLayout>
