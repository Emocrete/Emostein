---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تشطيب وتجهيز محلات تجارية"
	pDescr="خدمة تشطيب وتجهيز محلات تجارية حسب نمط التشغيل: محلات عرض كثيف، محلات تجربة واختيار، محلات خدمة وكاونتر، أنشطة طعام ومشروبات، ومعارض كبيرة، مع تصميم الواجهة والفرش والكهرباء والإضاءة والتكييف والتجهيزات حتى التسليم."
>







	<Hero>

		<VrStack
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("55%","55%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تشطيب وتجهيز المحلات التجارية")}
				pText={Text.Body.Centered.OfText("خدمة تشطيب وتجهيز محلات تجارية حسب نمط التشغيل: محلات عرض كثيف، محلات تجربة واختيار، محلات خدمة وكاونتر، أنشطة طعام ومشروبات، ومعارض كبيرة، مع تصميم الواجهة والفرش والكهرباء والإضاءة والتكييف والتجهيزات حتى التسليم.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
