---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Align, ElemBg, Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تشطيب وتجهيز الصيدليات"
	pDescr="تشطيب صيدلية يبدأ من توزيع المدخل والكاونتر والرفوف والمخزن ونقاط الكهرباء والتكييف والإضاءة، ثم تنفيذ أعمال التشطيب والواجهة والتجهيزات الداخلية حتى تصبح الصيدلية جاهزة للتشغيل."
>







	<Hero>

		<VrStack
			pLoc={new Loc(new NumPer("50%","2.5%"),new NumPer("55%","65%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تشطيب وتجهيز الصيدليات")}
				pText={Text.Body.Centered.OfText("تشطيب صيدلية يبدأ من توزيع المدخل والكاونتر والرفوف والمخزن ونقاط الكهرباء والتكييف والإضاءة، ثم تنفيذ أعمال التشطيب والواجهة والتجهيزات الداخلية حتى تصبح الصيدلية جاهزة للتشغيل.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
