---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="CollectionPage"
	pTitle="خدمات التشطيبات"
	pDescr="خدمات تشطيب الشقق والفلل والمحلات والصيدليات من خلال إدارة هندسية منظمة تبدأ من المعاينة والمقايسة واختيار مستوى التشطيب وتنتهي بالتسليم النهائي."
>







	<Hero>

		<VrStack
			pLoc={new Loc(new NumPer("0%","2.5%"),new NumPer("35%","20%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pHzAlign={"Center"}
		>

			<Emograph pTitle={Text.H1.Centered.White.OfText("خدمات تشطيبات متكاملة")} />

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
