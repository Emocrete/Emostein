---
import BLayout from "@/Layout.astro";
import { FinishCostGame } from "@/Widgets/Calc";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoSec, Hero, RelatedServices, RelServiceItem } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="تكلفة تشطيب فيلا"
	pDescr="متوسط تكلفة تشطيب فيلا في مصر من حالة نصف التشطيب، مع تفصيل بنود الكهرباء والسباكة والسيراميك والدهانات والنجارة والألوميتال والجبس بورد والنثريات."
>







	<Hero>

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(80)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("60%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20, 10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تكلفة تشطيب فيلا")}
				pText={Text.Body.Centered.OfText("متوسط تكلفة تشطيب فيلا في مصر من حالة نصف التشطيب، مع تفصيل بنود الكهرباء والسباكة والسيراميك والدهانات والنجارة والألوميتال والجبس بورد والنثريات.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon />

				<EmoWhatsIcon />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec id="secIntro">

		<SecTitle
			Gray2
			pTitle="الطريقة الصحيحة لحساب تكلفة التشطيب"
			pDesc="الحساب بتكلفة المتر لا يعبر بدقة عن حجم التكلفة نظرا لعوامل الاختلاف في البنود التي قد تختلف بشكل كبير من حالة إلى أخرى ، لنفس المساحة يوجد دائما عدد لا نهائي من سعر متر التشطيب طبقا للكميات الجزئية للبنود وانواع الخامات المستخدمة ومستوى التشطيب ، لهذا فالطريقة الصحيحة تكون بتصنيف البنود وحساب كمياتها بشكل منفصل وحساب سعر تكلفة الوحدة من هذه البنود ، لهذا لا يصلح السؤال عن سعر متر التشطيب بدون معرفة تفاصيل البنود من واقع طلبات العميل ومن واقع الرسومات الهندسية"
		/>

	</EmoSec>







	<FinishCostGame />







	<RelatedServices>

		<RelServiceItem
			pTitle="خدمات تشطيب الفلل والقصور"
			pDesc="خدمة تشطيب فلل وقصور تشمل التصميم والتنفيذ والإشراف الهندسي على جميع مراحل التشطيب"
			pHref="/emocrete/finishing/villa"
		/>

	</RelatedServices>







</BLayout>
