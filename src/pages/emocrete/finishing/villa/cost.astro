	>

		<Emograph
			pTitle={Text.H3.OfText("2. التعديلات المدنية والتجهيز قبل التأسيس")}
			pText={Text.Body.OfText("بعد الاستلام تظهر غالبا أعمال تكسير وفتح مسارات وتعديل حوائط وسد فتحات وتظبيط عتب أو عمل مباني إضافية أو معالجة شروخ أو تسوية منسوب أرضيات. هذا البند لا يصح دفنه داخل سعر المتر، لأنه يتغير جدا حسب حالة الفيلا. فيلا مستلمة من مطور جيد قد تحتاج أعمالا محدودة، بينما فيلا منفذة منذ سنوات أو بدون متابعة هندسية قد تحتاج ميزانية واضحة للتصحيح قبل التشطيب.")}
