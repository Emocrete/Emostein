				pTitle={Text.H3.DarkSky.OfText("الفكرة الأساسية")}
				pText={Text.Body.OfText("الطريقة الصحيحة لفهم تكلفة تشطيب فيلا تبدأ بتقسيم المشروع إلى بنود قابلة للقياس. لا نقول إن الفيلا مساحتها 450 متر إذن نضربها في رقم واحد وينتهي الأمر. هذا الأسلوب يطمس فروق مهمة جدا بين فيلا وأخرى. فيلا واجهتها بسيطة وحديقتها صغيرة لا تشبه فيلا لها واجهات حجر أو رخام وسلالم داخلية كبيرة وسطح مستخدم وبرجولات ومسبح أو شلال أو غرف خدمات منفصلة. لذلك الحساب المنظم يبدأ من حصر المساحات والفراغات، ثم حساب البنود التأسيسية، ثم حساب الخامات الظاهرة، ثم إضافة بنود الفيلا الخاصة، ثم وضع احتياطي محسوب للتغيرات والاختيارات التي تظهر أثناء التنفيذ.")}
				pSize={new Size(new NumPer("1200px", "100%"), new NumPer("auto", "auto"))}
			/>

			<CardsGr
				pWidth={new RespString("1300px", "100%")}
				pCardBg={new ElemBg("white")}
				pGrTitle={Text.H3.Centered.OrangeDark.OfText("ما الذي يجعل تكلفة الفيلا مختلفة؟")}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("مساحات غير داخلية", "الواجهات والسطح والحديقة والسور لا تدخل بنفس طريقة حساب متر التشطيب الداخلي، لكنها قد تستهلك جزءا كبيرا من الميزانية.")}
				pTopic2={new Topic("عدد حمامات أكبر", "كل حمام يعني شبكة تغذية وصرف وعزل وسيراميك وأدوات صحية وإكسسوارات، لذلك عدد الحمامات أهم من المساحة وحدها.")}
				pTopic3={new Topic("أنظمة أكثر", "الفيلا غالبا تحتاج تأسيس تكييف مركزي أو مخفي، إنتركم، كاميرات، إنترنت، بوابة، إنذار، وربما نظام ري أو مضخات.")}
				pTopic4={new Topic("درجات تشطيب متباينة", "قد يكون الدور الأرضي فاخر، وغرف النوم متوسطة، والسطح عملي. لذلك يتم التسعير حسب مناطق ومستويات وليس حسب رقم متر واحد.")}
			/>

