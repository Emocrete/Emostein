---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EGall } from "@/Widgets/Media";
import { ESec, Hero } from "@/Widgets/Sections";
import { EmoContactStrip, EmoStrip } from "@/Widgets/Strips";
import { Align, ElemBg, Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تشطيب فيلا"
	pDescr="خدمة تشطيب فلل وقصور تشمل التصميم والتنفيذ والإشراف الهندسي على جميع مراحل التشطيب، مع إعداد مقايسة مبدئية بعد المعاينة ورفع المقاسات، ونسبة إشراف تبدأ من 15% من إجمالي تكلفة المقايسة."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("تشطيب فيلا")}
				pText={Text.Body.Centered.White.OfText("تصميم وتنفيذ وتشطيب الفلل والقصور بجودة عالية وتكلفة متوازنة، مع إشراف هندسي خلال جميع مراحل التنفيذ حتى الاستلام النهائي")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<ESec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			Gray1
			pTitle="تشطيب فلل وقصور بخطة واضحة من البداية"
			pDesc="الخدمة لا تبدأ من اختيار خامة أو لون، بل من معاينة ورفع مقاسات وحصر بنود وتحويل الرؤية إلى مقايسة قابلة للتنفيذ"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H3.WithColor("#17345C").OfText("خدمة متكاملة للتصميم والتنفيذ")}
				pText={Text.Body.WithColor("#333333").OfText("نقدم خدمة متخصصة في تشطيب الفيلات والقصور، تشمل التصميم، وحصر البنود، واختيار الخامات المناسبة، وتنفيذ أعمال التشطيب الكلاسيكية والحديثة بجودة عالية وتكلفة مناسبة. الهدف ليس تنفيذ بنود متفرقة فقط، بل إدارة عملية التشطيب كمنظومة مترابطة تبدأ من الفكرة وتنتهي باستلام نهائي واضح ومطابق لما تم الاتفاق عليه.")}
				pSize={new Size(new NumPer(920, "100%"), new NumPer("auto", "auto"))}
			/>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cSkyDarkBlack
			pTitle="كيف نبدأ حساب تكلفة تشطيب الفيلا؟"
			pDesc="بعد المعاينة أو استلام الرسومات الهندسية، يتم حصر أنواع وكميات وخامات البنود قبل إعداد التكلفة التقريبية"
		/>

		<EmoStrip
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("معاينة ورفع مقاسات")}
					pText={Text.Body.WithColor("#333333").OfText("نبدأ بمعاينة الفيلا على الطبيعة ورفع المقاسات، أو مراجعة الرسومات الهندسية المتوفرة إذا كانت جاهزة، حتى يتم تحديد المساحات الفعلية، وحالة المبنى، ونقاط القوة والضعف التي تؤثر على خطة التشطيب.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("حصر بنود وخامات")}
					pText={Text.Body.WithColor("#333333").OfText("يتم حصر أنواع الأعمال وكمياتها وخاماتها بالاتفاق مع المالك، ثم إعداد مقايسة مبدئية للتكلفة التقريبية للخامات والمصنعيات حسب أحدث أسعار معروفة وقت الدراسة.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="نسبة الإشراف وأتعاب إدارة التشطيب"
			pDesc="الأتعاب لا يتم حسابها كرقم عشوائي، بل كنسبة من التكلفة الفعلية للأعمال حتى تبقى مرتبطة بحجم المشروع الحقيقي"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("15% من التكلفة الفعلية")}
					pText={Text.Body.WithColor("#333333").OfText("يتم تقدير الأتعاب بنسبة تبدأ من 15% من التكلفة الفعلية الإجمالية للأعمال، حسب حجم المشروع ونطاق الخدمة ومستوى المتابعة المطلوب في التصميم والتنفيذ والإشراف.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("معاينة وتصميم عند التعاقد")}
					pText={Text.Body.WithColor("#333333").OfText("تدخل المعاينة والتصميم ضمن منظومة الخدمة عند التعاقد، بحيث لا يكون القرار مبنيا على رقم عام، بل على تصور واضح للأعمال والخامات والمستوى المطلوب.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("إشراف حتى الاستلام")}
					pText={Text.Body.WithColor("#333333").OfText("الإشراف لا يقتصر على زيارة عابرة للموقع، بل يمتد خلال مراحل التنفيذ، ومراجعة جودة الأعمال، ومتابعة البنود، وضبط التسليم النهائي مع المالك.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #B78A25 "
			pTitle="تشطيبات متكاملة للفلل والقصور"
			pDesc="ننفذ جميع أعمال التشطيبات الكلاسيكية والحديثة بجودة عالية وتكلفة متوازنة"
		/>

		<EmoStrip
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("تشطيب كلاسيك وحديث")}
					pText={Text.Body.WithColor("#333333").OfText("نتعامل مع الفيلات والقصور باعتبارها مشروعات ذات تفاصيل كثيرة ومستويات تشطيب مختلفة، لذلك يمكن تنفيذ الطابع الكلاسيكي أو الحديث أو المزج بينهما، مع ضبط الخامات، والتفاصيل المعمارية، وتناسق الأرضيات والحوائط والأسقف والإضاءة.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("جودة تنفيذ وتكلفة متوازنة")}
					pText={Text.Body.WithColor("#333333").OfText("هدفنا الوصول إلى جودة عالية بدون تضخيم غير مبرر للتكلفة. لذلك يتم اختيار الخامات والمصنعيات بناء على مستوى التشطيب المطلوب، وطبيعة الاستخدام، والأماكن الأكثر تعرضا للاستهلاك داخل الفيلا.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #17345C "
			pTitle="خدمات التشطيبات للفيلات والقصور"
			pDesc="الخدمة تغطي أعمال التأسيس والتشطيب النهائي، بداية من البنية الداخلية حتى الشكل الظاهر للفراغات"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("أعمال التأسيس")}
					pText={Text.Body.WithColor("#333333").OfText("تشمل أعمال المباني، والكهرباء، والسباكة، والعزل، والتكييف، والنجارة التأسيسية، والمحارة، والمصيص، والكرانيش، والجبسيوم بورد، وكل ما يؤثر على كفاءة التشغيل قبل الوصول للشكل النهائي.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("أعمال التشطيب")}
					pText={Text.Body.WithColor("#333333").OfText("تشمل تكسيات الأرضيات والحوائط، والدهانات، والأبواب والشبابيك، والألوميتال، والرخام، والديكورات، والأسقف، والتفاصيل النهائية التي تحدد الشكل العام وتجربة الاستخدام داخل الفيلا.")}
					pSize={new Size(new NumPer(520, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="أعمال التأسيس الأساسية"
			pDesc="مرحلة التأسيس هي التي تحدد جودة التشغيل لاحقا، وأي ضعف فيها يظهر بعد السكن بتكلفة إصلاح أعلى"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("كهرباء وتكييف")}
					pText={Text.Body.WithColor("#333333").OfText("يتم توزيع دوائر الكهرباء ومخارج القوى والإنارة ونقاط التكييف بما يناسب طبيعة الفيلا، لأن الأحمال والمساحات في الفلل أكبر من الشقق وتحتاج تخطيطا أدق من البداية.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("سباكة وعزل")}
					pText={Text.Body.WithColor("#333333").OfText("تحتاج الحمامات والمطابخ وغرف الخدمات والأسطح والتراسات إلى تأسيس سباكة وعزل محكم، خصوصا في الفلل متعددة الأدوار أو التي تحتوي على مساحات خارجية ومناطق رطبة كثيرة.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("مباني ومحارة ومصيص")}
					pText={Text.Body.WithColor("#333333").OfText("يتم ضبط أعمال المباني والمحارة والمصيص قبل البدء في الدهانات أو التكسيات، لأن استواء الحوائط والأسقف وجودة الزوايا يؤثران مباشرة على الشكل النهائي للتشطيب.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#F6F1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #B78A25 "
			pTitle="أعمال التشطيب النهائي"
			pDesc="المرحلة التي يظهر فيها طابع الفيلا، لكنها تعتمد على دقة التأسيس وجودة الاختيارات السابقة"
		/>

		<EmoStrip
			pBg={new ElemBg("#F6F1E8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("تكسيات الأرضيات والحوائط")}
					pText={Text.Body.WithColor("#333333").OfText("تشمل الأرضيات والحوائط باستخدام الرخام أو البورسلين أو السيراميك أو الأحجار حسب التصميم، مع مراعاة الفواصل، والمناسيب، واستمرارية الشكل بين الفراغات الداخلية والخارجية.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("دهانات وأبواب وشبابيك")}
					pText={Text.Body.WithColor("#333333").OfText("تشمل الدهانات النهائية، والأبواب، والشبابيك، والألوميتال، والزجاج، مع تنسيق الألوان والخامات بحيث تخدم الطابع العام للفيلا ولا تظهر كبنود منفصلة عن التصميم.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("جبسيوم بورد وكرانيش")}
					pText={Text.Body.WithColor("#333333").OfText("تشمل الأسقف المعلقة، والكرانيش، وبيوت الإضاءة، والنوازل، والتفاصيل الديكورية التي تربط الإضاءة بالتصميم الداخلي وتمنح الفراغات شكلها النهائي.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #FFFDF8 "
			pTitle="لماذا تشطيب الفيلا يحتاج إدارة مختلفة عن الشقة؟"
			pDesc="الفيلا مشروع أكبر في التفاصيل والمساحات والتداخل بين الأعمال، ولا يصلح التعامل معها كبنود صغيرة منفصلة"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFFFF")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("مساحات وأدوار أكثر")}
					pText={Text.Body.WithColor("#333333").OfText("الفيلا غالبا تحتوي على أكثر من دور، وسلالم، وتراسات، وحديقة، ومداخل متعددة، لذلك تحتاج تنسيقا بين المناسيب والحركة والواجهات والفراغات الداخلية والخارجية.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("تفاصيل خامات أعلى")}
					pText={Text.Body.WithColor("#333333").OfText("اختيارات الرخام، والأخشاب، والزجاج، والدهانات، والإضاءة، والأسقف تكون أكثر تأثيرا على التكلفة والشكل، لذلك يجب ضبطها داخل مقايسة واضحة قبل التنفيذ.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("تداخل بين التصميم والتنفيذ")}
					pText={Text.Body.WithColor("#333333").OfText("قرارات التصميم الداخلي، والتكييف، والكهرباء، والجبسيوم بورد، والدهانات، والتكسيات تتداخل مع بعضها، وأي تغيير في بند واحد قد يؤثر على أكثر من مرحلة تنفيذية.")}
					pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = " --StripBg : #17345C "
			pTitle="مراحل العمل في تشطيب الفيلا"
			pDesc="نقسم المشروع إلى مراحل واضحة حتى لا يتحول التشطيب إلى قرارات عشوائية ومصاريف متفرقة"
		/>

		<EmoStrip
			pBg={new ElemBg("#FFFDF8")}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("1 — معاينة ورفع مقاسات")}
					pText={Text.Body.WithColor("#333333").OfText("نبدأ بمعاينة الفيلا وتسجيل الحالة الحالية ورفع المقاسات أو مراجعة الرسومات المتاحة، مع تحديد البنود المطلوب تنفيذها والمستوى المتوقع للتشطيب.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("2 — حصر ومقايسة مبدئية")}
					pText={Text.Body.WithColor("#333333").OfText("يتم حصر الكميات والخامات والمصنعيات المطلوبة وإعداد مقايسة مبدئية توضح التكلفة التقريبية، وتساعد المالك على ترتيب الأولويات قبل بدء التنفيذ.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("3 — اعتماد التصميم والخامات")}
					pText={Text.Body.WithColor("#333333").OfText("يتم الاتفاق على الاتجاه التصميمي والخامات الرئيسية مثل الأرضيات والدهانات والأبواب والأسقف والإضاءة، حتى لا تبدأ الأعمال ثم تتغير الاختيارات أثناء التنفيذ بتكلفة إضافية.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("4 — تنفيذ ومتابعة جودة")}
					pText={Text.Body.WithColor("#333333").OfText("تتم متابعة البنود على مراحل، ومراجعة جودة التنفيذ قبل الانتقال للبند التالي، خصوصا في الأعمال التي يتم تغطيتها لاحقا مثل الكهرباء والسباكة والعزل والتكييف.")}
					pSize={new Size(new NumPer(900, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.WithColor("#17345C").OfText("5 — استلام نهائي")}
