---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align } from "@/TypesLib";
import { Hero, ESec, EmoStrip, IncLineSep, BottTriSep, EmoBtn, EmoContactStrip, Emograph, SecTitle, VrStack, HzStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تشطيب صيدليات"
	pDescr="تشطيب صيدلية يبدأ من توزيع المدخل والكاونتر والرفوف والمخزن ونقاط الكهرباء والتكييف والإضاءة، ثم تنفيذ أعمال التشطيب والواجهة والتجهيزات الداخلية حتى تصبح الصيدلية جاهزة للتشغيل."
>

	<Hero
		pTitle="تشطيب صيدلية تشتغل صح من أول يوم"
		pDesc="مش مجرد دهانات ورفوف. الصيدلية محتاجة توزيع مريح، كاونتر محسوب، إضاءة واضحة، تخزين منظم، وتنفيذ ما يبوظش التشغيل بعد الافتتاح."
		pTitleClr="#ffffff"
		pDescClr="#ffffff"
		pAlign="right"
		pPosL="30% 48% 12% 6%"
		pPosP="45% 8% 8% 8%"
		pBlurL="on"
		pBlurP="on"
	>

		<HzStack>

			<EmoBtn
				pText="أفهم الخدمة"
				pWidth="210px"
				pHeight="50px"
				pRadius="8px"
				pBgColor="#ffffff"
				pBgColorHover="#B9E4D0"
				pTextColor="#163B34"
				pFontSize="17px"
				onclick="location.href='#meaning'"
			/>

			<EmoBtn
				pText="اطلب معاينة"
				pWidth="210px"
				pHeight="50px"
				pRadius="8px"
				pBgColor="#163B34"
				pBgColorHover="#ffffff"
				pTextColor="#ffffff"
				pTextColorHover="#163B34"
				pFontSize="17px"
				onclick="window.open('https://wa.me/201014490054','_blank')"
			/>

		</HzStack>

	</Hero>

	<ESec
		id="meaning"
		pBg={new ElemBg("#FFFFFF")}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="تشطيب الصيدلية يبدأ من سؤال بسيط"
			pDesc="هل المكان بعد التشطيب هيكون مريح في البيع والتعامل اليومي، ولا مجرد محل شكله لطيف في الصور؟"
			style="--StripBg:#F1F7F4;"
		/>

		<EmoStrip pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

			<Emograph
				pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("الفرق بين محل متشطب وصيدلية جاهزة للتشغيل")}
				pText={Text.Body.WithAlign("right").WithColor("#283C38").OfText("في الصيدلية، كل متر له وظيفة. المدخل لازم يوضح للعميل هو داخل على إيه. الكاونتر لازم يبقى ظاهر ومريح، لكن من غير ما يخنق الحركة. الرفوف لازم تعرض المنتجات بوضوح، لكن من غير فوضى أو ممرات ضيقة. المخزن لازم يخدم العاملين من غير ما يتحول إلى ركن مهمل. والكهرباء والتكييف والإضاءة لازم يتأسسوا قبل السقف والدهانات، لأن علاجهم بعد الافتتاح معناه تكسير وتعطيل وخسارة شكل وتكلفة.")}
				pSize={new Size(980, "auto", "100%", "auto")}
			/>

		</EmoStrip>

	</ESec>

	<IncLineSep
		pTopColor="#FFFFFF"
		pBottomColor="#163B34"
		pHeight={520}
		pBottomLeft={180}
		pBottomRight={390}
		pContentWidth={1120}
		pPadInline={24}
	>

		<HzStack>

			<Emograph
				pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("من الباب")}
				pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("أول قرار في التشطيب هو شكل استقبال العميل. هل الواجهة واضحة؟ هل الباب في مكان منطقي؟ هل الواجهة تسمح برؤية منظمة للداخل؟ وهل اللافتة والإضاءة الخارجية تخدم اسم الصيدلية بدل ما تكون مجرد إضافة مكلفة؟")}
				pSize={new Size(330, "auto", "100%", "auto")}
			/>

			<Emograph
				pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("عند الكاونتر")}
				pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("الكاونتر هو نقطة التعامل الأساسية. مكانه يحدد الزحام، ومساحة الوقوف، وطريقة الدفع، ومكان الكمبيوتر والطابعة والكاشير. لو اتعمل بعد تأسيس الكهرباء، غالبًا هتظهر أسلاك وتمديدات وحلول مؤقتة تبوظ الشكل والتشغيل.")}
				pSize={new Size(330, "auto", "100%", "auto")}
			/>

			<Emograph
				pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("خلف منطقة البيع")}
				pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("الجزء الخلفي ليس بواقي مساحة. هنا تظهر قيمة التخزين، وسهولة الوصول للدواء، وترتيب المنتجات، ومكان الأجهزة، ومسار العاملين بعيدًا عن مسار العميل. سوء التخطيط هنا يفضل مزعجًا كل يوم بعد الافتتاح.")}
				pSize={new Size(330, "auto", "100%", "auto")}
			/>

		</HzStack>

	</IncLineSep>

	<ESec
		pBg={new ElemBg("#F1F7F4")}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="ما الذي نراجعه قبل أول يوم تنفيذ؟"
			pDesc="الوقت الذي يُصرف في المراجعة قبل التكسير أو التأسيس أرخص بكثير من تعديل خطأ بعد تركيب السقف والرفوف والكاونتر"
			style="--StripBg:#163B34;"
		/>

		<EmoStrip pBg={new ElemBg("#F1F7F4")} pAlign={Align.Center}>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("نبدأ برفع المقاسات كما هي، لا كما تبدو في الرسم")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("نقيس الواجهة، المدخل، العمق، الأعمدة، المناسيب، أماكن الحمام أو مصدر المياه إن وجد، نقاط الكهرباء الحالية، وأي قيود في السقف أو الأرضية. الهدف هنا ليس عمل رسم جميل، لكن معرفة ما الذي يسمح به المكان فعلًا وما الذي سيكلف تعديلًا قبل التشطيب.")}
					pSize={new Size(1000, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("بعدها نثبت أماكن الكاونتر والرفوف قبل تمديد الكهرباء")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("لا يصح تنفيذ الكهرباء أولًا ثم البحث عن مكان للكاونتر. مكان الكاونتر يحدد نقاط الكمبيوتر والكاشير والطابعة والإنترنت والكاميرات، ومكان الرفوف يحدد الإضاءة والمخارج، ومكان اللافتة يحدد تغذية خارجية مبكرة. أي عكس في الترتيب ينتج تشطيبًا مرقعًا حتى لو الخامات غالية.")}
					pSize={new Size(1000, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("ثم نحول الكلام إلى مقايسة مفهومة")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("المقايسة الجيدة لا تقول للعميل رقمًا إجماليًا وخلاص. لازم تبين تكلفة التأسيسات، الأرضيات، السقف، الدهانات، الواجهة، الكاونتر، الرفوف، الإضاءة، التكييف، وأي تجهيز خاص. بهذه الطريقة يعرف صاحب الصيدلية أين تذهب الميزانية، وما الذي يمكن تأجيله، وما الذي لا يصح التوفير فيه.")}
					pSize={new Size(1000, "auto", "100%", "auto")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>

	<BottTriSep
		pTopColor="#F1F7F4"
		pBottomColor="#FFFFFF"
		pHeight={560}
		pTipX={410}
		pTipY={260}
		pContentWidth={1080}
		pPadInline={24}
	>

		<VrStack>

			<Emograph
				pTitle={Text.H2.Centered.WithColor("#163B34").OfText("التشطيب هنا مش استعراض خامات")}
				pText={Text.Body.Centered.WithColor("#2E4742").OfText("ممكن صيدلية بخامات متوسطة تطلع عملية ومريحة، وممكن صيدلية بخامات مرتفعة تطلع مزعجة في البيع والحركة. لذلك التقييم الحقيقي ليس في اسم الخامة وحده، لكن في مكان استخدامها، وطريقة تركيبها، وهل تخدم التشغيل اليومي أم تضيف شكلًا مؤقتًا فقط.")}
				pSize={new Size(980, "auto", "100%", "auto")}
			/>

			<HzStack>

				<Emograph
					pTitle={Text.H4.WithAlign("right").WithColor("#163B34").OfText("الأرضيات")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("نختار خامة تتحمل الحركة والتنظيف ولا تتحول إلى سطح مزعج أو زلق مع الاستخدام اليومي.")}
					pSize={new Size(310, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H4.WithAlign("right").WithColor("#163B34").OfText("السقف")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("السقف لا ينفصل عن التكييف والإضاءة والكاميرات وفتحات الصيانة. أي تعارض فيه يظهر واضحًا بعد التشطيب.")}
					pSize={new Size(310, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H4.WithAlign("right").WithColor("#163B34").OfText("الدهانات")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("الألوان الهادئة والنظيفة أهم من المبالغة. الصيدلية تحتاج إحساسًا بالوضوح والثقة لا زحمة بصرية.")}
					pSize={new Size(310, "auto", "100%", "auto")}
				/>

			</HzStack>

		</VrStack>

	</BottTriSep>

	<ESec
		pBg={new ElemBg("#F8FBFA")}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="أعمال التنفيذ التي لا ينفع علاجها متأخرًا"
			pDesc="دي البنود التي تظهر قيمتها بعد التشغيل، لأن خطأها لا يُصلح بلمسة دهان أو تعديل بسيط"
			style="--StripBg:#FFFFFF;"
		/>

		<EmoStrip pBg={new ElemBg("#F8FBFA")} pAlign={Align.Center}>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("الكهرباء والداتا والكاميرات")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("نحدد أماكن الأجهزة قبل التأسيس: كمبيوتر، كاشير، طابعة، قارئ باركود، شاشات، كاميرات، راوتر، إضاءة الواجهة، وإضاءة الرفوف. الهدف أن تختفي التمديدات داخل التشطيب، لا أن تظهر كحلول إضافية بعد تركيب الكاونتر.")}
					pSize={new Size(520, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("التكييف والتهوية")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("اختيار مكان التكييف لا يكون على أساس أقرب حائط فقط. لازم نراجع مسار المواسير، الصرف، تأثير الوحدة على شكل السقف والواجهة، واتجاه الهواء داخل مساحة فيها عميل واقف وموظف شغال ومنتجات محتاجة بيئة مستقرة.")}
					pSize={new Size(520, "auto", "100%", "auto")}
				/>

			</HzStack>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("الواجهة واللافتة")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("الواجهة الجيدة لا تعني مبالغة في الزجاج والإضاءة. المطلوب أن يظهر اسم الصيدلية بوضوح، وأن يقرأ العميل المدخل بسهولة، وأن تكون الواجهة قابلة للصيانة والتنظيف، وأن تكون التغذية الكهربائية مجهزة قبل الإغلاق النهائي.")}
					pSize={new Size(520, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("الرفوف والكاونتر")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("الرفوف ليست مجرد وحدات عرض. عمقها وارتفاعها ومكانها يحدد رؤية المنتجات وسهولة الحركة. والكاونتر ليس قطعة ديكور؛ هو مكان خدمة ودفع وتنظيم يومي، لذلك لازم يتصمم على استخدامه الحقيقي لا على صورة شكلية فقط.")}
					pSize={new Size(520, "auto", "100%", "auto")}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg("#EEF5F2")}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="تكلفة تشطيب الصيدلية"
			pDesc="السعر يتغير حسب حالة المكان، مساحة الواجهة، حجم الرفوف والكاونتر، ومستوى الخامات والتجهيزات المطلوبة"
			style="--StripBg:#163B34;"
		/>

		<EmoStrip pBg={new ElemBg("#EEF5F2")} pAlign={Align.Center}>

			<VrStack>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("لو المكان على الطوب الأحمر")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("هنا التكلفة تشمل تأسيسات كاملة تقريبًا: كهرباء، داتا، تكييف، معالجة حوائط، أرضيات، سقف، دهانات، واجهة، كاونتر، رفوف، وربما تجهيزات تخزين. ميزة هذه الحالة أن التأسيس يتم صح من البداية، لكن لازم تكون المقايسة مفصلة حتى لا تظهر مصروفات غير محسوبة أثناء التنفيذ.")}
					pSize={new Size(980, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("لو المكان متشطب قديم")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("في التجديد لا نحسب التشطيب الجديد فقط، لأن هناك تكلفة فك وتكسير ونقل مخلفات وتعديل مسارات وقد نكتشف عيوبًا مخفية بعد إزالة القديم. لذلك تبدأ المعاينة هنا بسؤال: ما الذي يستحق الحفاظ عليه، وما الذي سيكلف أكثر لو حاولنا ترقيعه؟")}
					pSize={new Size(980, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("لو المساحة صغيرة")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("المساحة الصغيرة لا تعني تشطيبًا أسهل. بالعكس، كل قرار فيها مؤثر: عرض الممر، عمق الرف، مكان الكاونتر، فتح الباب، وحركة العاملين. الخطأ في مساحة صغيرة يظهر فورًا، لذلك نركز على الاستغلال العملي قبل أي تفاصيل شكلية.")}
					pSize={new Size(980, "auto", "100%", "auto")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg("#FFFFFF")}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="طريقة العمل مع العميل"
			pDesc="واضحة ومباشرة: معاينة، تصور، مقايسة، تنفيذ، ثم تسليم قابل للتشغيل"
			style="--StripBg:#FFFFFF;"
		/>

		<EmoStrip pBg={new ElemBg("#FFFFFF")} pAlign={Align.Center}>

			<HzStack>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("المعاينة")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("نعاين الموقع ونفهم حالة الاستلام والهدف من الصيدلية والميزانية التقريبية. المعاينة والتصميم يتم احتسابهما ضمن الخدمة، ويمكن التعامل معهما مجانًا عند التعاقد حسب نطاق المشروع.")}
					pSize={new Size(330, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("المقايسة")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("نقسم الأعمال إلى بنود واضحة بدل رقم إجمالي غامض. ويظهر في المقايسة ما سيتم تنفيذه فعلاً، وما يحتاج اختيار خامة أو اعتماد سعر قبل الشراء.")}
					pSize={new Size(330, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.WithAlign("right").WithColor("#163B34").OfText("الإشراف أو التنفيذ")}
					pText={Text.Body.WithAlign("right").WithColor("#2E4742").OfText("يمكن تنفيذ الخدمة كتسليم كامل، أو إشراف هندسي على التنفيذ. نسبة الإشراف تبدأ من 15% من إجمالي تكلفة المقايسة حسب حجم العمل ودرجة المتابعة المطلوبة.")}
					pSize={new Size(330, "auto", "100%", "auto")}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg("#F1F7F4")}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="ابدأ بصورة واضحة قبل ما تبدأ مصاريف التنفيذ"
			pDesc="أرسل مساحة الصيدلية، حالة الاستلام، وصور الواجهة من الداخل والخارج، ونحدد لك هل الأفضل تصميم ومقايسة فقط أم تنفيذ كامل أم إشراف على مقاولين"
			style="--StripBg:#163B34;"
		/>

		<HzStack>

			<EmoBtn
				pText="طلب معاينة تشطيب صيدلية"
				pWidth="310px"
				pHeight="54px"
				pRadius="8px"
				pBgColor="#163B34"
				pBgColorHover="#2E6B5D"
				pTextColor="#ffffff"
				pFontSize="17px"
				onclick="window.open('https://wa.me/201014490054','_blank')"
			/>

			<EmoBtn
				pText="الرجوع لخدمات التشطيبات"
				pWidth="310px"
				pHeight="54px"
				pRadius="8px"
				pBgColor="#ffffff"
				pBgColorHover="#B9E4D0"
				pTextColor="#163B34"
				pFontSize="17px"
				onclick="location.href='/emocrete/finishing'"
			/>

		</HzStack>

	</ESec>

</BLayout>
