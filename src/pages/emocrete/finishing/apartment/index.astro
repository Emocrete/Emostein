			pHeight="50px"
			pRadius="5px"
			pBgColor="#87c3f5"
			pBgColorHover="#008cff"
			pBgColorActive="#ff6f6f"
			pTextColor="#2e056c"
			pFontSize="18px"
		/>

		<EmoBtn
			style = " margin-bottom : 10px "
			pText="التصميم مجانا عند التعاقد"
			pIcon="/Media/Emocrete/Finishing/Apartment/HeroButton2N.webp"
			pIconHover="/Media/Emocrete/Finishing/Apartment/HeroButton2H.webp"
			pIconActive="/Media/Emocrete/Finishing/Apartment/HeroButton2C.webp"
