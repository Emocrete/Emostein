	pTitle="تشطيب شقق"
	pDescr="مهندس متخصص لأعمال التصميم والتنفيذ لتشطيب الشقق السكنية بجودة عالية وتكلفة مناسبة ، نسبة إشراف تبدأ من 15 % من إجمالي تكلفة المقايسة ، المعاينة والتصميم مجانا عند التعاقد ، إشراف هندسي خلال جميع مراحل التنفيذ حتى الاستلام النهائي"
>







	<Hero
		pTitle="تشطيب شقق"
		pDesc="مهندس متخصص لتشطيب الشقق السكنية بجودة عالية وتكلفة مناسبة"
		pTitleClr="#424242"
		pDescClr="#424242"
		pPosL="40% 15% 40% 50%"
		pPosP="55% 10% 10% 10%"
	>

		<EmoBtn
			style = " margin-bottom : 10px "
			pText="معاينة مجانية عند التعاقد"
			pIcon="/Media/Emocrete/Finishing/Apartment/HeroButton1N.webp"
			pIconHover="/Media/Emocrete/Finishing/Apartment/HeroButton1H.webp"
			pIconActive="/Media/Emocrete/Finishing/Apartment/HeroButton1C.webp"
