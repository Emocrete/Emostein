---
import BLayout from "@/Layout.astro";
import { EmoBtn, EmoCall, Emograph, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تشطيب شقق"
	pDescr="مهندس متخصص لأعمال التصميم والتنفيذ لتشطيب الشقق السكنية بجودة عالية وتكلفة مناسبة ، نسبة إشراف تبدأ من 15 % من إجمالي تكلفة المقايسة ، المعاينة والتصميم مجانا عند التعاقد ، إشراف هندسي خلال جميع مراحل التنفيذ حتى الاستلام النهائي"
>







	<Hero>

		<HzStack pLoc={new Loc(new NumPer("35%","2.5%"),new NumPer("30%","45%"))} pSize={new Size(new NumPer("60%","95%"))} pHzAlign={"Center"}>

			<VrStack>

				<Emograph pTitle={Text.H1.Centered.OfText("تشطيب شقق")} pText={Text.Body.Centered.OfText("مهندس متخصص لتشطيب الشقق السكنية بجودة عالية وتكلفة مناسبة")} />

				<EmoCall BlackSky />

			</VrStack>

			<VrStack pGap={new Pixel(20,5)} pVrAlign={"Center"}>

				<EmoBtn
					pText="معاينة مجانية عند التعاقد"
					pIcon="/Media/Emocrete/Finishing/Apartment/HeroButton1N.webp"
					pIconHover="/Media/Emocrete/Finishing/Apartment/HeroButton1H.webp"
					pIconActive="/Media/Emocrete/Finishing/Apartment/HeroButton1C.webp"
					pWidth="300px"
					pHeight="50px"
					pRadius="5px"
					pBgColor="#87c3f5"
					pBgColorHover="#008cff"
					pBgColorActive="#ff6f6f"
					pTextColor="#2e056c"
					pFontSize="18px"
				/>

				<EmoBtn
					pText="التصميم مجانا عند التعاقد"
					pIcon="/Media/Emocrete/Finishing/Apartment/HeroButton2N.webp"
					pIconHover="/Media/Emocrete/Finishing/Apartment/HeroButton2H.webp"
					pIconActive="/Media/Emocrete/Finishing/Apartment/HeroButton2C.webp"
					pWidth="300px"
					pHeight="50px"
					pRadius="5px"
					pBgColor="#87c3f5"
					pBgColorHover="#008cff"
					pBgColorActive="#ff6f6f"
					pTextColor="#2e056c"
					pFontSize="18px"
				/>

				<EmoBtn
					pText="إشراف هندسي كامل"
					pIcon="/Media/Emocrete/Finishing/Apartment/HeroButton3N.webp"
					pIconHover="/Media/Emocrete/Finishing/Apartment/HeroButton3H.webp"
					pIconActive="/Media/Emocrete/Finishing/Apartment/HeroButton3C.webp"
					pWidth="300px"
					pHeight="50px"
					pRadius="5px"
					pBgColor="#87c3f5"
					pBgColorHover="#008cff"
					pBgColorActive="#ff6f6f"
					pTextColor="#2e056c"
					pFontSize="18px"
				/>

			</VrStack>

		</HzStack>

	</Hero>







</BLayout>
