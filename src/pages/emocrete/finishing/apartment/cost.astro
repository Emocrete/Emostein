---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, Emograph, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Colors, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="تكلفة تشطيب شقة"
	pDescr="متوسط تكلفة تشطيب شقة 100 متر في مصر من حالة نصف التشطيب، مع تفصيل بنود الكهرباء والسباكة والسيراميك والدهانات والنجارة والألوميتال والجبس بورد والنثريات."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("50%","2.5%"),new NumPer("25%","60%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تكلفة تشطيب شقة")}
				pText={Text.Body.Centered.OfText("متوسط تكلفة البنود الأساسية لتشطيب شقة سكنية مساحة 100 متر من حالة النصف تشطيب")}
			/>

			<HzStack pGap={new Pixel(30,10)} pForceHz>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

			<Badge
				pLandOnly
				pScopeText="القاهرة والجيزة"
				pYears={15}
				pWorks={6}
			/>

		</VrStack>

	</Hero>







	<EmoTable>

		<EmoTableRow pBg={Colors.Sky}>

			<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

			<EmoTableCell pText={Text.Body.Bold.OfText("القيمة")} />

		</EmoTableRow>

		<EmoTableRow pBg="#ffffff">

			<EmoTableCell pText={Text.Body.OfText("التشطيب")} />

			<EmoTableCell pBg={Colors.Yellow} pText={Text.Body.Bold.WithColor("#111111").OfText("250,000 جنيه")} />

		</EmoTableCell>

	</EmoTable>







</BLayout>
