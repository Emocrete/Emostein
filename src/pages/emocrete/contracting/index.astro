---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="Service" pTitle="مقاولات عامة" pDescr="عمارات سكنية - فيلات - هناجر معدنية - خزانات مباني - خزانات خرسانة - حمامات سباحة">







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.OfText("مقاولات عامة")} pText={Text.Body.Centered.OfText("مهندس متخصص لتنفيذ المنشآت الخرسانية والمعدنية")} />

			<Emograph pText={Text.Body.Centered.OfText("عمارات سكنية - فيلات - هناجر معدنية - خزانات مباني - خزانات خرسانة - حمامات سباحة")} />

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<section class = " Hero ">

		<div class = " Wrap ">

			<div class = " HeroBox ">

				<p class = " Lead ">
					تنفيذ مشروعات البناء والتشييد بإدارة هندسية منضبطة، من أول خطوة في الموقع حتى التسليم.
				</p>

				<p class = " Desc ">
					في أعمال المقاولات العامة لا يكفي وجود عمالة أو موردين فقط، لأن نجاح المشروع يعتمد على وجود إدارة تنفيذ حقيقية تضبط التسلسل بين البنود، وتراجع الجودة، وتراقب التكلفة، وتمنع القرارات العشوائية التي تؤخر التنفيذ أو ترفع المصروفات بلا داعٍ.
				</p>

				<p class = " Desc ">
					نقدم خدمات مقاولات عامة للمشروعات السكنية والخدمية والإنشائية، مع متابعة دقيقة لمراحل التنفيذ، ومراجعة الأعمال بندًا بندًا، والتأكد من أن ما يتم على الطبيعة يسير وفق تصور واضح يمكن متابعته وقياسه، وليس مجرد شغل متراكم داخل الموقع.
				</p>

			</div>

		</div>

	</section>







	<section class = " Section ">

		<div class = " Wrap Narrow ">

			<h2>
				شركة مقاولات عامة تدير التنفيذ بعقلية هندسية
			</h2>

			<p>
				المشروع الناجح لا يقاس فقط بسرعة البدء، بل بمدى انضباط التنفيذ من البداية. لذلك نعتمد على تنظيم الأعمال بصورة متسلسلة، مع وضوح في نطاق كل مرحلة، ومتابعة دقيقة للبنود الإنشائية والمعمارية، والتنسيق بين العمالة والخامات والتوريدات، حتى لا يتحول الموقع إلى مجموعة أعمال منفصلة بلا إدارة موحدة.
			</p>

			<p>
				هذا الأسلوب يساعد على تقليل الأخطاء التنفيذية، وتقليل الهدر، ورفع مستوى السيطرة على المشروع، سواء كان المطلوب تنفيذ عمارة سكنية، أو فيلا، أو هنجر معدني، أو خزان، أو حمام سباحة، أو أي مشروع يحتاج إلى جهة تنفيذ مسؤولة وقادرة على إدارة التفاصيل.
			</p>

		</div>

	</section>







	<section class = " Section Alt " id="scope">

		<div class = " Wrap ">

			<h2 class = " Center ">
				نطاق خدمات المقاولات العامة
			</h2>

			<div class = " Grid Cards3 ">

				<article class = " Card ">

					<h3>
						تنفيذ العمارات السكنية
					</h3>

					<p>
						تنفيذ العمارات السكنية بمراحلها المختلفة بداية من الأعمال التمهيدية وحتى الهيكل الخرساني والبنود اللاحقة، مع ضبط مسار التنفيذ بما يتناسب مع الرسومات وطبيعة الموقع ومتطلبات المشروع.
					</p>

				</article>

				<article class = " Card ">

					<h3>
						تنفيذ الفيلات الخاصة
					</h3>

					<p>
						تنفيذ الفيلات يحتاج إلى عناية أكبر بالتفاصيل المعمارية والدقة في المناسيب والفتحات والعلاقات بين البنود. لذلك نهتم بتحويل الرسومات إلى واقع منضبط يقلل التعديلات المتأخرة والمفاجآت أثناء التنفيذ.
					</p>

				</article>

				<article class = " Card ">

					<h3>
						المنشآت والهناجر المعدنية
					</h3>

					<p>
						تنفيذ المنشآت المعدنية يحتاج إلى تنسيق دقيق بين التصميم والتصنيع والتركيب. نتابع هذه المراحل بصورة متكاملة لضمان سلامة التجميع، وسرعة الإنجاز، ودقة التنفيذ على الطبيعة.
					</p>

				</article>

				<article class = " Card ">

					<h3>
						الخزانات الخرسانية
					</h3>

					<p>
						الخزانات من البنود الحساسة التي تحتاج إلى عناية خاصة في التسليح والصب والعزل ومعالجة الخرسانة. لذلك يتم التعامل معها بمنهج تنفيذي يركز على الجودة الوظيفية وليس مجرد الانتهاء الشكلي من العمل.
					</p>

				</article>

				<article class = " Card ">

					<h3>
						خزانات المباني
					</h3>

					<p>
						تنفيذ خزانات المباني يتطلب متابعة دقيقة لكل مرحلة، بداية من التجهيز وحتى العزل والاختبارات، بما يضمن سلامة التشغيل ويقلل احتمالات المشكلات المستقبلية.
					</p>

				</article>

				<article class = " Card ">

					<h3>
						حمامات السباحة
					</h3>

					<p>
						تنفيذ حمامات السباحة يحتاج إلى دقة في التفاصيل والمناسيب والعزل والتجهيزات. لذلك نهتم بترابط البنود المدنية مع متطلبات التشغيل حتى يكون الناتج سليمًا عمليًا وليس مقبولًا شكليًا فقط.
					</p>

				</article>

			</div>

		</div>

	</section>







	<section class = " Section ">

		<div class = " Wrap ">

			<h2 class = " Center ">
				كيف ندير المشروع أثناء التنفيذ؟
			</h2>

			<div class = " Grid Steps ">

				<div class = " Step ">

					<span class = " No ">
						01
					</span>

					<h3>
						دراسة المشروع قبل البدء
					</h3>

					<p>
						مراجعة المتاح من الرسومات والمستندات وفهم طبيعة الموقع والبنود الرئيسية ونقاط الحساسية المتوقعة قبل الدخول في التنفيذ.
					</p>

				</div>

				<div class = " Step ">

					<span class = " No ">
						02
					</span>

					<h3>
						تخطيط مراحل التنفيذ
					</h3>

					<p>
						تنظيم تسلسل الأعمال بصورة تقلل التعارض بين البنود المختلفة، وتمنع القرارات الارتجالية التي تربك الموقع وترفع التكلفة.
					</p>

				</div>

				<div class = " Step ">

					<span class = " No ">
						03
					</span>

					<h3>
						متابعة الجودة والاستلام المرحلي
					</h3>

					<p>
						كل مرحلة يتم التعامل معها باعتبارها نقطة مراجعة مستقلة، حتى لا تنتقل الأخطاء إلى المراحل التالية ويصبح علاجها أصعب وأعلى تكلفة.
					</p>

				</div>

				<div class = " Step ">

					<span class = " No ">
						04
					</span>

					<h3>
						وضوح الموقف التنفيذي
					</h3>

					<p>
						إعطاء صورة أوضح عن ما تم تنفيذه، وما هو تحت التنفيذ، وما يحتاج إلى قرار، حتى يبقى المالك على اطلاع حقيقي بحالة المشروع.
					</p>

				</div>

			</div>

		</div>

	</section>







	<section class = " Section Dark ">

		<div class = " Wrap ">

			<div class = " TwoCols ">

				<div>

					<h2>
						ما الذي يميز أسلوب العمل لدينا؟
					</h2>

					<p>
						نحن لا نقدم مقاولات عامة بمعنى التنفيذ العشوائي أو الاعتماد على رد الفعل داخل الموقع، بل نعتمد على إدارة هندسية ترى المشروع كمنظومة مترابطة: توقيت، وجودة، وتكلفة، وتسلسل أعمال، واستلامات، وقرارات مدروسة.
					</p>

					<p>
						هذا الأسلوب مناسب لصاحب المشروع الذي يريد تنفيذًا منضبطًا، ويريد جهة قادرة على التعامل مع الموقع بعقلية فنية واضحة، بدلًا من ترك الأمور للاجتهادات اليومية والحلول المؤقتة.
					</p>

				</div>

				<div class = " CheckList ">

					<div class = " CheckItem ">

						إدارة تنفيذ واضحة من البداية للنهاية

					</div>

					<div class = " CheckItem ">

						تنسيق أفضل بين البنود والفرق المختلفة

					</div>

					<div class = " CheckItem ">

						متابعة مرحلية تقلل الأخطاء المتراكمة

					</div>

					<div class = " CheckItem ">

						ضبط أعلى للجودة في الأعمال التنفيذية

					</div>

					<div class = " CheckItem ">

						تقليل الهدر والتعديلات غير الضرورية

					</div>

					<div class = " CheckItem ">

						رؤية أوضح لحالة المشروع أثناء التنفيذ

					</div>

				</div>

			</div>

		</div>

	</section>







	<section class = " Section Alt ">

		<div class = " Wrap Narrow ">

			<h2>
				نظام التعاقد المناسب حسب طبيعة المشروع
			</h2>

			<p>
				ليس كل مشروع يناسبه نفس شكل التعاقد. في بعض الحالات يكون المطلوب تنفيذًا كاملًا بنطاق واضح، وفي حالات أخرى قد يكون الأنسب نظام يعتمد على التكلفة الفعلية مع إدارة منظمة للتنفيذ، خاصة عندما تكون هناك درجة من المرونة أو التطوير أثناء سير المشروع.
			</p>

			<p>
				لذلك يتم تحديد الصيغة الأنسب بعد فهم طبيعة المشروع، ومدى اكتمال الرسومات، وحجم الأعمال، وأسلوب الإدارة المطلوب، حتى يكون التعاقد مناسبًا للحالة الفعلية وليس مجرد قالب ثابت يتكرر مع كل المشروعات.
			</p>

		</div>

	</section>







	<section class = " Section ">

		<div class = " Wrap ">

			<div class = " CTA ">

				<h2>
					هل لديك مشروع يحتاج إلى شركة مقاولات عامة تديره بصورة منضبطة؟
				</h2>

				<p>
					ابدأ من الرسومات المتاحة أو حتى من وصف مبدئي للمشروع، وسيتم تحديد نطاق الخدمة الأنسب وحجم الأعمال المتوقع وطريقة التنفيذ المناسبة، حتى تبدأ على أساس أوضح وأكثر تنظيمًا.
				</p>

			</div>

		</div>

	</section>







</BLayout>





<style>



	.Wrap {
		width: min(1180px, calc(100% - 32px));
		margin-inline: auto;
	}


	.Narrow {
		max-width: 900px;
	}


	.Section {
		padding: 72px 0;
	}


	.Hero {
		padding: 88px 0 72px;
		background: linear-gradient(135deg, rgba(17, 24, 39, 0.95), rgba(31, 41, 55, 0.9)),
			radial-gradient(circle at top left, rgba(255, 255, 255, 0.08), transparent 24%);
		color: #fff;
	}


	.HeroBox {
		max-width: 920px;
	}


	.Kicker {
		display: inline-block;
		margin-bottom: 14px;
		padding: 8px 14px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		font-size: 14px;
		line-height: 1;
		background: rgba(255, 255, 255, 0.06);
	}


	.Lead {
		font-size: clamp(20px, 2.4vw, 28px);
		line-height: 1.7;
		font-weight: 600;
		margin-bottom: 18px;
	}


	.Desc + .Desc {
		margin-top: 14px;
	}


	.Actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}


	.Btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 0 22px;
		border-radius: 14px;
		text-decoration: none;
		font-size: 16px;
		font-weight: 700;
		transition: transform 0.2s ease,
			opacity 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.Btn:hover {
		transform: translateY(-2px);
	}


	.BtnPrimary {
		background: #f59e0b;
		color: #111827;
	}


	.BtnGhost {
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.06);
		color: #fff;
	}


	.Center {
		text-align: center;
		margin-bottom: 28px;
	}


	.Grid {
		display: grid;
		gap: 22px;
	}


	.Cards3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}


	.Card {
		padding: 26px;
		border: 1px solid #e5e7eb;
		border-radius: 24px;
		background: #fff;
		box-shadow: 0 14px 40px rgba(15, 23, 42, 0.05);
	}


	.Steps {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}


	.Step {
		padding: 24px;
		border-radius: 24px;
		background: #fff;
		border: 1px solid #e5e7eb;
		box-shadow: 0 14px 40px rgba(15, 23, 42, 0.05);
	}


	.No {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		margin-bottom: 18px;
		border-radius: 16px;
		background: #111827;
		color: #fff;
		font-weight: 800;
		font-size: 18px;
	}


	.TwoCols {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 28px;
		align-items: start;
	}


	.CheckList {
		display: grid;
		gap: 14px;
	}


	.CheckItem {
		padding: 18px 20px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 17px;
		line-height: 1.8;
	}


	.CTA {
		padding: 34px;
		border-radius: 28px;
		background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
		border: 1px solid #e5e7eb;
		box-shadow: 0 14px 40px rgba(15, 23, 42, 0.05);
	}


	.CenterActions {
		justify-content: center;
	}



	.Section.Alt {
		background: #f6f7f8;
	}


	.Section.Dark {
		background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.08), transparent 28%),
			linear-gradient(135deg, #111827 0%, #1f2937 100%);
		color: #fff;
	}



	h1 {
		margin: 0 0 18px;
		font-size: clamp(36px, 6vw, 60px);
		line-height: 1.1;
	}


	h2 {
		margin: 0 0 18px;
		font-size: clamp(28px, 4vw, 40px);
		line-height: 1.2;
		color: inherit;
	}


	h3 {
		margin: 0 0 12px;
		font-size: 22px;
		line-height: 1.35;
		color: inherit;
	}


	p {
		margin: 0;
		font-size: 18px;
		line-height: 1.95;
		color: inherit;
	}


	p + p {
		margin-top: 14px;
	}



	:global(html) {
		scroll-behavior: smooth;
	}



</style>





<style>



	@media (max-width: 980px) {
		.Cards3,
		.Steps,
		.TwoCols
		{
			grid-template-columns: 1fr 1fr;
		}
	}


	@media (max-width: 720px) {
		.Section,
		.Hero
		{
			padding: 56px 0;
		}

		.Cards3,
		.Steps,
		.TwoCols
		{
			grid-template-columns: 1fr;
		}

		.Card,
		.Step,
		.CTA
		{
			padding: 22px;
		}

		p {
			font-size: 17px;
		}
	}



</style>
