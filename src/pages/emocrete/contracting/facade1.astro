---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle } from "@/Widgets/Comp";
import { EmoFaq, ESec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoContactStrip, EmoStrip } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import { EmoGallery } from "../../../site/Widgets/Media";
import { DuoCol, DuoStr, VrStack } from "../../../site/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تنفيذ مقاولات واجهات"
	pDescr="كلادينج - ستركشر"
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("60%","70%"))}
			pHzAlign={"Center"}
			pBg={new ElemBg(Colors.WhiteOff)}
			pBgOpacity={new Percent(80)}
		>

			<Emograph pTitle={Text.H1.Centered.OfText("تنفيذ مقاولات واجهات")} pText={Text.Body.Centered.OfText("كلادينج - ستركشر")} />

			<EmoCall BlackSky pText="تواصل معنا" />

		</VrStack>

	</Hero>







	<ESec
		id="secMarbleEgImp"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle GreenLite pTitle="أعمالنا السابقة" />

		<DuoStr>

			<DuoCol>

				<Emograph
					id="txtEgMarple"
					pTitle={Text.H3.Centered.OfText("مشروع 1")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DuoCol>

			<DuoCol>

				<EmoGallery pFolder="/Media/Emocrete/Contracting/Facade/Projects/1" />

			</DuoCol>

		</DuoStr>

		<DuoStr>

			<DuoCol>

				<Emograph
					pTitle={Text.H3.Centered.OfText("مشروع 2")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DuoCol>

			<DuoCol>

				<EmoGallery pFolder="/Media/Emocrete/Contracting/Facade/Projects/2" />

			</DuoCol>

		</DuoStr>

		<DuoStr>

			<DuoCol>

				<Emograph
					pTitle={Text.H3.Centered.OfText("مشروع 3")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DuoCol>

			<DuoCol>

				<EmoGallery pFolder="/Media/Emocrete/Contracting/Facade/Projects/3" />

			</DuoCol>

		</DuoStr>

		<DuoStr>

			<DuoCol>

				<Emograph
					pTitle={Text.H3.Centered.OfText("مشروع 4")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DuoCol>

			<DuoCol>

				<EmoGallery pFolder="/Media/Emocrete/Contracting/Facade/Projects/4" />

			</DuoCol>

		</DuoStr>

		<DuoStr>

			<DuoCol>

				<Emograph
					pTitle={Text.H3.Centered.OfText("مشروع 5")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DuoCol>

			<DuoCol>

				<EmoGallery pFolder="/Media/Emocrete/Contracting/Facade/Projects/5" />

			</DuoCol>

		</DuoStr>

	</ESec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن تنفيذ الواجهة من الرندر مباشرة؟"
			pAnswer="الرندر يوضح الشكل، لكنه لا يكفي وحده في الحالات التي تحتاج تفاصيل فواصل وتثبيت وخامات وإضاءة ومقاسات. مستوى التفاصيل المطلوب يتحدد حسب المقاول وطريقة التنفيذ."
		/>

		<FaqItem
			pQuestion="هل يمكن تصميم واجهة محل أو مطعم؟"
			pAnswer="نعم، والواجهة التجارية تحتاج قراءة مختلفة لأنها مرتبطة بالهوية والبيع ووضوح النشاط وتجربة العميل من الشارع."
		/>

		<FaqItem
			pQuestion="هل السعر يتحدد بالمتر؟"
			pAnswer="ليس دائمًا. سعر التصميم يرتبط بعدد الواجهات ومستوى التفاصيل وحالة الرسومات وعدد البدائل ونوع المبنى. أما تنفيذ الواجهة فقد يحتاج حساب مسطحات وخامات وبنود منفصلة."
		/>

	</EmoFaq>







	<RelServices
		pTitle={Text.H2.Centered.WithColor("#F6E7C6").OfText("خدمات اخرى")}
		pHeadBg={new ElemBg("#0E1118")}
		pBodyBg={new ElemBg("#F7F1E6")}
		pCardBg={new ElemBg("#FFFFFF")}
	>

		<RelServiceItem
			pTitle="تصميم واجهات"
			pDesc="تصميم واجهة فيلا أو عمارة أو محل مع تحديد الطراز والخامات والألوان والإضاءة الخارجية."
			pHref="/emodsign/des/cr/ext/facade"
			pImg="/Media/Emodsign/Des/Cr/Ext/Facade/HeroL.webp"
			pBtnText="اطلب الخدمة"
		/>

		<RelServiceItem
			pTitle="تصميم لاندسكيب"
			pDesc="تنسيق الحديقة والممرات والجلسات والسور والإنارة الخارجية مع واجهة الفيلا أو المبنى."
			pHref="/emodsign/des/cr/ext/landscape"
			pImg="/Media/Emodsign/Des/Cr/Ext/Landscape/HeroL.webp"
			pBtnText="اطلب الخدمة"
		/>

	</RelServices>







</BLayout>
