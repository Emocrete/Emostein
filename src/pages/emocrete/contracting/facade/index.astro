---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { DivCol, DivStr, EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, Loc, NumPer, Percent, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="Service" pTitle="تنفيذ مقاولات واجهات" pDescr="كلادينج - ستركشر">







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("60%","70%"))}
			pHzAlign={"Center"}
			pBg={new ElemBg(Colors.WhiteOff)}
			pBgOpacity={new Percent(80)}
		>

			<Emograph pTitle={Text.H1.Centered.OfText("تنفيذ مقاولات واجهات")} pText={Text.Body.Centered.OfText("كلادينج - ستركشر")} />

			<EmoCall BlackSky pText="تواصل معنا" />

		</VrStack>

	</Hero>







	<EmoSec
		id="secMarbleEgImp"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle GreenLite pTitle="أعمالنا السابقة" />

		<DivStr>

			<DivCol>

				<Emograph
					id="txtEgMarple"
					pTitle={Text.H3.Centered.OfText("مشروع 1")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="Projects/1" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("مشروع 2")} pSize={new Size(new NumPer(200),new NumPer(30))} data-own-size />

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="Projects/2" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("مشروع 3")} pSize={new Size(new NumPer(200),new NumPer(30))} data-own-size />

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="Projects/3" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("مشروع 4")} pSize={new Size(new NumPer(200),new NumPer(30))} data-own-size />

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="Projects/4" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("مشروع 5")} pSize={new Size(new NumPer(200),new NumPer(30))} data-own-size />

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="Projects/5" />

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن تنفيذ الواجهة من الرندر مباشرة؟"
			pAnswer="الرندر يوضح الشكل، لكنه لا يكفي وحده في الحالات التي تحتاج تفاصيل فواصل وتثبيت وخامات وإضاءة ومقاسات. مستوى التفاصيل المطلوب يتحدد حسب المقاول وطريقة التنفيذ."
		/>

		<FaqItem
			pQuestion="هل يمكن تصميم واجهة محل أو مطعم؟"
			pAnswer="نعم، والواجهة التجارية تحتاج قراءة مختلفة لأنها مرتبطة بالهوية والبيع ووضوح النشاط وتجربة العميل من الشارع."
		/>

		<FaqItem
			pQuestion="هل السعر يتحدد بالمتر؟"
			pAnswer="ليس دائمًا. سعر التصميم يرتبط بعدد الواجهات ومستوى التفاصيل وحالة الرسومات وعدد البدائل ونوع المبنى. أما تنفيذ الواجهة فقد يحتاج حساب مسطحات وخامات وبنود منفصلة."
		/>

	</EmoFaq>







	<RelServices
		pTitle={Text.H2.Centered.WithColor("#F6E7C6").OfText("خدمات اخرى")}
		pHeadBg={new ElemBg("#0E1118")}
		pBodyBg={new ElemBg("#F7F1E6")}
		pCardBg={new ElemBg("#FFFFFF")}
	>

		<RelServiceItem
			pTitle="تصميم واجهات"
			pDesc="تصميم واجهة فيلا أو عمارة أو محل مع تحديد الطراز والخامات والألوان والإضاءة الخارجية."
			pHref="/emodsign/des/cr/ext/facade"
		/>

		<RelServiceItem
			pTitle="تصميم لاندسكيب"
			pDesc="تنسيق الحديقة والممرات والجلسات والسور والإنارة الخارجية مع واجهة الفيلا أو المبنى."
			pHref="/emodsign/des/cr/ext/landscape"
		/>

	</RelServices>







</BLayout>
