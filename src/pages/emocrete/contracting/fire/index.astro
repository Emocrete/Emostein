---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="Service" pTitle="مقاولات مكافحة الحريق" pDescr="تنفيذ مقاولات أعمال مكافحة الحريق">







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","45%"))} pSize={new Size(new NumPer("40%","95%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.OfText("مقاولات مكافحة الحريق")} pText={Text.Body.Centered.OfText("تنفيذ مشروعات أعمال مكافحة الحريق")} />

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







</BLayout>
