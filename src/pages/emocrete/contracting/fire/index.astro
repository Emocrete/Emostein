---
import BLayout from "@/Layout.astro";
import { Hero } from "@/Widgets/Sections";
import { GlassCard } from "../../../../site/Widgets/Shapes";
import { EmoCall, Emograph, EmoWhats, HzStack, VrStack } from "../../../../site/Widgets";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="مقاولات عامة"
	pDescr="عمارات سكنية - فيلات - هناجر معدنية - خزانات مباني - خزانات خرسانة - حمامات سباحة"
>







	<Hero>

		<GlassCard
			pMove="SlideInLeft"
			pMoveLoc={new Loc(new NumPer("10%", "2.5%"), new NumPer("25%", "45%"))}
			pMoveBox={new Size(new NumPer("50%", "95%"), new NumPer("auto", "auto"))}
			pMoveDuration={1000}
			pMoveViewTarget="self"
			pZ={4}
			pBg="rgba(17,24,32,.74)"
			pBorder="rgba(255,255,255,.22)"
			pRadius={20}
			pBlur={5}
		>

			<VrStack
				pGap={new Pixel(20, 10)}
				pPad={new Pixel(10,5)}
				pHzAlign="Center"
				pVrAlign="Center"
			>

				<Emograph
					pTitle={Text.H1.Centered.White.OfText("كبير رحيمية قبلي")}
					pText={Text.Body.Centered.White.OfText("الحاج سيد مناع وأولاده اللي منيم الحرايق م المغرب")}
				/>

				<HzStack pGap={new Pixel(20, 10)} pPad={new Pixel(20,10)}>

					<EmoCall BlackSky pText="عايزين نملا الصفحة" />

					<EmoWhats BistageBlack pText="عشان تجيب شغل" />

				</HzStack>

			</VrStack>

		</GlassCard>

	</Hero>







</BLayout>




















<style>



	.Wrap {
		width: min(1180px, calc(100% - 32px));
		margin-inline: auto;
	}


	.Narrow {
		max-width: 900px;
	}


	.Section {
		padding: 72px 0;
	}


	.Hero {
		padding: 88px 0 72px;
		background: linear-gradient(135deg, rgba(17, 24, 39, 0.95), rgba(31, 41, 55, 0.9)),
			radial-gradient(circle at top left, rgba(255, 255, 255, 0.08), transparent 24%);
		color: #fff;
	}


	.HeroBox {
		max-width: 920px;
	}


	.Kicker {
		display: inline-block;
		margin-bottom: 14px;
		padding: 8px 14px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		font-size: 14px;
		line-height: 1;
		background: rgba(255, 255, 255, 0.06);
	}


	.Lead {
		font-size: clamp(20px, 2.4vw, 28px);
		line-height: 1.7;
		font-weight: 600;
		margin-bottom: 18px;
	}


	.Desc + .Desc {
		margin-top: 14px;
	}


	.Actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}


	.Btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 0 22px;
		border-radius: 14px;
		text-decoration: none;
		font-size: 16px;
		font-weight: 700;
		transition: transform 0.2s ease,
			opacity 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.Btn:hover {
		transform: translateY(-2px);
	}


	.BtnPrimary {
		background: #f59e0b;
		color: #111827;
	}


	.BtnGhost {
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(255, 255, 255, 0.06);
		color: #fff;
	}


	.Center {
		text-align: center;
		margin-bottom: 28px;
	}


	.Grid {
		display: grid;
		gap: 22px;
	}


	.Cards3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}


	.Card {
		padding: 26px;
		border: 1px solid #e5e7eb;
		border-radius: 24px;
		background: #fff;
		box-shadow: 0 14px 40px rgba(15, 23, 42, 0.05);
	}


	.Steps {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}


	.Step {
		padding: 24px;
		border-radius: 24px;
		background: #fff;
		border: 1px solid #e5e7eb;
		box-shadow: 0 14px 40px rgba(15, 23, 42, 0.05);
	}


	.No {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		margin-bottom: 18px;
		border-radius: 16px;
		background: #111827;
		color: #fff;
		font-weight: 800;
		font-size: 18px;
	}


	.TwoCols {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 28px;
		align-items: start;
	}


	.CheckList {
		display: grid;
		gap: 14px;
	}


	.CheckItem {
		padding: 18px 20px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 17px;
		line-height: 1.8;
	}


	.CTA {
		padding: 34px;
		border-radius: 28px;
		background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
		border: 1px solid #e5e7eb;
		box-shadow: 0 14px 40px rgba(15, 23, 42, 0.05);
	}


	.CenterActions {
		justify-content: center;
	}



	.Section.Alt {
		background: #f6f7f8;
	}


	.Section.Dark {
		background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.08), transparent 28%),
			linear-gradient(135deg, #111827 0%, #1f2937 100%);
		color: #fff;
	}



	h1 {
		margin: 0 0 18px;
		font-size: clamp(36px, 6vw, 60px);
		line-height: 1.1;
	}


	h2 {
		margin: 0 0 18px;
		font-size: clamp(28px, 4vw, 40px);
		line-height: 1.2;
		color: inherit;
	}


	h3 {
		margin: 0 0 12px;
		font-size: 22px;
		line-height: 1.35;
		color: inherit;
	}


	p {
		margin: 0;
		font-size: 18px;
		line-height: 1.95;
		color: inherit;
	}


	p + p {
		margin-top: 14px;
	}



	:global(html) {
		scroll-behavior: smooth;
	}



</style>




















<style>



	@media (max-width: 980px) {
		.Cards3,
		.Steps,
		.TwoCols
		{
			grid-template-columns: 1fr 1fr;
		}
	}


	@media (max-width: 720px) {
		.Section,
		.Hero
		{
			padding: 56px 0;
		}

		.Cards3,
		.Steps,
		.TwoCols
		{
			grid-template-columns: 1fr;
		}

		.Card,
		.Step,
		.CTA
		{
			padding: 22px;
		}

		p {
			font-size: 17px;
		}
	}



</style>
