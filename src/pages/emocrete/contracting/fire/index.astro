---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, EmoWhats, Grid, ListItem, SecTitle, Stack, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="مقاولات أنظمة مكافحة الحريق"
	pDescr="معاينة وتصميم وتوريد وتركيب واختبار أنظمة مكافحة الحريق للمباني والمنشآت، وتشمل شبكات المياه ومجموعات الضخ والرش الآلي والأنظمة المتخصصة والإنذار وفق طبيعة الإشغال ومتطلبات المشروع."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%", "2.5%"), new NumPer("30%", "45%"))} pSize={new Size(new NumPer("50%", "95%"))} pHzAlign="Center">

			<Emograph
				pTitle={Text.H1.Centered.OfText("مقاولات أنظمة مكافحة الحريق")}
				pText={Text.Body.Centered.OfText("معاينة وتصميم وتوريد وتركيب واختبار أنظمة مكافحة الحريق للمباني والمنشآت، وتشمل شبكات المياه ومجموعات الضخ والرش الآلي والأنظمة المتخصصة والإنذار وفق طبيعة الإشغال ومتطلبات المشروع.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec
		id="FireContractor"
		Service
		pBg={new ElemBg("#F5F2EC")}
		pGap={new Pixel(0)}
		pHzAlign={Align.Center}
	>

		<SecTitle cBlackOffWhiteOff pTitle="شركة مقاولات أنظمة الحريق" />

		<EmoStr id="FireContractorProfile" pBg={new ElemBg("#FCFCFA")} pSize={new Size(new NumPer(1320, "calc(100% - 24px)"), new NumPer("auto", "auto"))}>

			<DivStr
				pContentSize={new Size(new NumPer(1220, "100%"), new NumPer("auto", "auto"))}
				pGap={new Pixel(38, 18)}
				pPad={new Pixel(48, 22)}
				pVrAlign="Center"
			>

				<DivCol
					pSize={new Size(new NumPer("62%", "100%"))}
					pHzAlign="Right"
					pVrAlign="Center"
					pPad={new Pixel(8)}
				>

					<Emograph
						pTitle={Text.H3.AtRight.OfSize(28, 21).WithColor("#0B1118").OfText("نطاق الشركة الهندسي")}
						pText={Text.Body.AtRight.OfSize(19, 16)
              .WithColor("#0B1118")
              .OfText(
                "تقدم Emocrete خدمات تصميم وتنفيذ أنظمة مكافحة الحريق للمشروعات الجديدة والمباني القائمة. يبدأ التكليف بفهم النشاط ومساحات الإشغال ومصادر الخطورة، ثم ينتقل إلى المعاينة والحسابات والمخططات والمواصفات والمقايسة واعتماد الخامات. يشمل نطاق العمل شبكات الرش الآلي وصناديق الحريق والهيدرنت والطلمبات والخزانات وأنظمة الإنذار والإخلاء الصوتي والإطفاء المتخصص، ويمتد إلى التوريد والتركيب والبرمجة والاختبارات وإعداد مستندات التسليم ضمن بنود فنية قابلة للمراجعة.",
              )}
						pSize={new Size(new NumPer(760, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#0B1118").OfText("منهج العمل وفريق المشروع")}
						pText={Text.Body.AtRight.OfSize(19, 16)
              .WithColor("#263442")
              .OfText(
                "يعتمد كل مشروع على مرجعية كودية محددة وإصدار معتمد من الجهة المختصة. تتوزع المسؤوليات بين التصميم والحصر والمشتريات والإشراف والتنفيذ والاختبارات مع مرجعية فنية موحدة تحفظ تطابق الرسومات وأعمال الموقع وملف التسليم. تثبت الحسابات سعة مصدر المياه وقدرة الطلمبات وأقطار الشبكات وكميات عوامل الإطفاء، وتوثق مراحل العمل بتقارير الفحص والاختبار ومخططات As-Built وكتيبات التشغيل والصيانة.",
              )}
						pSize={new Size(new NumPer(760, "100%"), new NumPer("auto", "auto"))}
					/>

				</DivCol>

				<DivCol
					pSize={new Size(new NumPer("38%", "100%"))}
					pBg={new ElemBg("#17222D")}
					pPad={new Pixel(18, 12)}
					pVrAlign="Center"
				>

					<RespImg
						pImg={new EmoMediaData(
              "Img",
              "https://sos-fire.com/assets/img/",
              "homepage-hero-fire-protection-engineers-egypt.webp",
              false,
              "مهندسو أنظمة الحماية من الحريق أثناء فحص شبكة رش آلي",
              new Size(new NumPer(560, "100%"), new NumPer("auto", "auto")),
            )}
					/>

				</DivCol>

			</DivStr>

		</EmoStr>

		<EmoStr id="FireContractorPrinciples" pBg={new ElemBg("#17222D")} pSize={new Size(new NumPer(1320, "calc(100% - 24px)"), new NumPer("auto", "auto"))}>

			<Grid
				pMax={3}
				pMaxP={1}
				pSize={new Size(new NumPer(1220, "100%"), new NumPer("auto", "auto"))}
				pGap={new Pixel(44, 24)}
				pPad={new Pixel(48, 22)}
				pVrAlign="Start"
			>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("الرؤية")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "تكوين منظومة حماية مترابطة تبدأ بفهم الخطر وطبيعة الإشغال، وتمتد إلى تصميم قابل للتنفيذ ونظام موثق للفحص والتشغيل والصيانة.",
            )}
				/>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("الرسالة")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "تقديم المعاينة والتصميم والمقايسة والتوريد والتنفيذ والاختبار من خلال فريق واحد يحتفظ بمرجعية فنية واضحة وحدود مسؤولية محددة طوال مدة المشروع.",
            )}
				/>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("سياسة الجودة")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "ربط التصميم والخامة والتركيب والاختبار داخل سجل هندسي واحد يضم المراجعات الفنية واعتمادات المواد ونتائج الاختبارات والتعديلات الميدانية ومخططات التنفيذ الفعلي.",
            )}
				/>

			</Grid>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="FireProjectStudy"
		Service
		pBg={new ElemBg("#FCFCFA")}
		pGap={new Pixel(0)}
		pHzAlign={Align.Center}
	>

		<SecTitle cWhiteOffBlack pTitle="دراسة المشروع" />

		<EmoStr id="FireProjectSurvey" pBg={new ElemBg("#DCEEF4")} pSize={new Size(new NumPer(1320, "calc(100% - 24px)"), new NumPer("auto", "auto"))}>

			<DivStr
				pContentSize={new Size(new NumPer(1220, "100%"), new NumPer("auto", "auto"))}
				pGap={new Pixel(38, 18)}
				pPad={new Pixel(48, 22)}
				pVrAlign="Start"
			>

				<DivCol pSize={new Size(new NumPer("60%", "100%"))} pHzAlign="Right">

					<Emograph
						pTitle={Text.H3.AtRight.OfSize(28, 21).WithColor("#0B1118").OfText("بيانات النشاط والمعاينة")}
						pText={Text.Body.AtRight.OfSize(19, 16)
              .WithColor("#0B1118")
              .OfText(
                "تبدأ الدراسة بتعريف الإشغال ومساحات الأدوار والارتفاعات وأعداد الشاغلين وطبيعة التشغيل والمواد الموجودة بالموقع. توثق المعاينة الأبعاد الفعلية ومناسيب الأسقف ومسارات الحركة وغرف الخدمات ومصادر الطاقة والمياه، وتغطي مناطق التخزين وخطوط الإنتاج والسوائل القابلة للاشتعال وغرف الكهرباء والمطابخ ومناطق التجمع. تسجل كذلك العوائق المعمارية والإنشائية ومساحات الصيانة وطرق إدخال المعدات، فتتحول البيانات إلى أساس تصميم مرتبط بالواقع التنفيذي للمبنى.",
              )}
						pSize={new Size(new NumPer(760, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#0B1118").OfText("تصنيف الخطورة")}
						pText={Text.Body.AtRight.OfSize(19, 16)
              .WithColor("#0B1118")
              .OfText(
                "يحدد التصنيف مقدار الوقود الحريقي ومعدل إطلاق الحرارة وطبيعة المواد وارتفاع التخزين وترتيب الرص. تؤثر النتيجة في كثافة تصرف الرشاشات ومساحة التصميم ومدة الإمداد المائي ونوع الكواشف وعامل الإطفاء ومسافات الوصول إلى معدات المكافحة.",
              )}
						pSize={new Size(new NumPer(760, "100%"), new NumPer("auto", "auto"))}
					/>

				</DivCol>

				<DivCol
					pSize={new Size(new NumPer("40%", "100%"))}
					pBg={new ElemBg("#FCFCFA")}
					pPad={new Pixel(34, 18)}
					pHzAlign="Right"
				>

					<EmoList
						pWidth={new RespString("100%", "100%")}
						pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#0B1118").OfText("بيانات الدراسة")}
						pItemFnt={Text.Body.AtRight.OfSize(18, 16).WithColor("#0B1118")}
						pNumbered
					>

						<ListItem pText="طبيعة الإشغال ومساحات الاستخدام وأعداد الشاغلين." />

						<ListItem pText="أنواع المواد وكمياتها وطرق التخزين والتداول." />

						<ListItem pText="مصدر مياه الحريق والضغط والتصرف المتاحان." />

						<ListItem pText="مناطق الحريق ومسالك الهروب ووسائل الإخلاء." />

						<ListItem pText="متطلبات الحماية المدنية ومستندات الاعتماد." />

						<ListItem pText="حدود التوريد والتنفيذ ونقاط الربط بالموقع." />

					</EmoList>

				</DivCol>

			</DivStr>

		</EmoStr>

		<EmoStr id="FireProtectionStrategy" pBg={new ElemBg("#0B1118")} pSize={new Size(new NumPer(1320, "calc(100% - 24px)"), new NumPer("auto", "auto"))}>

			<Stack
				pDir="Row"
				pWidth={new NumPer(1220, "100%")}
				pGap={new Pixel(48, 24)}
				pPad={new Pixel(48, 22)}
				pHzAlign="Stretch"
				pVrAlign="Start"
			>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("استراتيجية الحماية")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "تجمع الاستراتيجية بين الاكتشاف المبكر والتنبيه والإخلاء والسيطرة على الحريق وتوفير مياه الإطفاء ووصول فرق الطوارئ. ترتبط مناطق الحريق ومسالك الهروب ومقاومة العناصر بنظم الرش والصناديق والإنذار والتحكم في الدخان، وتدخل اشتراطات الحماية المدنية ضمن الرسومات والحسابات والمستندات التي تخضع للفحص والاعتماد.",
            )}
				/>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("نطاق المشروع")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "تثبت وثيقة النطاق الأنظمة المطلوبة وعدد المناطق وحدود الشبكات ومصدر التغذية ونقاط الربط والاختبارات ومستندات التسليم. يمنح هذا التحديد الحصر والتسعير والمشتريات والتنفيذ مرجعًا واحدًا قابلًا للمراجعة.",
            )}
				/>

			</Stack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="FireEngineeringDesign"
		Service
		pBg={new ElemBg("#F5F2EC")}
		pGap={new Pixel(0)}
		pHzAlign={Align.Center}
	>

		<SecTitle cBlackOffWhiteOff pTitle="التصميم الهندسي" />

		<EmoStr id="FireHydraulicDesign" pBg={new ElemBg("#FCFCFA")} pSize={new Size(new NumPer(1320, "calc(100% - 24px)"), new NumPer("auto", "auto"))}>

			<Grid
				pMax={2}
				pMaxP={1}
				pSize={new Size(new NumPer(1220, "100%"), new NumPer("auto", "auto"))}
				pGap={new Pixel(54, 28)}
				pPad={new Pixel(48, 22)}
				pVrAlign="Start"
			>

				<Emograph
					pTitle={Text.H3.AtRight.OfSize(28, 21).WithColor("#0B1118").OfText("أسس التصميم")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#0B1118")
            .OfText(
              "تثبت أسس التصميم نوع الإشغال وتصنيف الخطورة وإصدار الكود واشتراطات الجهة المختصة وخصائص مصدر المياه والظروف البيئية. تشمل الوثيقة درجات الحرارة وبيانات المعدات وفرضيات التشغيل ومعايير اختيار النظام، وتصبح مرجعًا للحسابات والمراجعات اللاحقة.",
            )}
				/>

				<Emograph
					pTitle={Text.H3.AtRight.OfSize(28, 21).WithColor("#0B1118").OfText("الحسابات الهيدروليكية")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#0B1118")
            .OfText(
              "تحسب الشبكة عند المنطقة الأشد تأثيرًا هيدروليكيًا باستخدام التصرف المطلوب وفواقد الاحتكاك وفروق المناسيب وضغط التشغيل. تحدد النتائج أقطار المواسير والضغط والتصرف عند نقطة التغذية وقدرة الطلمبات، وتعرض المخرجات على مخطط الشبكة وملخص العقد ومسار التدفق.",
            )}
				/>

				<Emograph
					pTitle={Text.H3.AtRight.OfSize(28, 21).WithColor("#0B1118").OfText("خزان الحريق")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#0B1118")
            .OfText(
              "تحسب السعة الصافية من الطلب المتزامن ومدة الإمداد المقررة لنوع الخطورة. يراعي التصميم الحجم القابل للاستخدام ومنسوب السحب ومعدل إعادة الملء وتقسيم الخزان وفتحات الفحص ومؤشرات المنسوب وترتيب خطوط السحب والتصريف والـOverflow.",
            )}
				/>

				<Emograph
					pTitle={Text.H3.AtRight.OfSize(28, 21).WithColor("#0B1118").OfText("اختيار الطلمبات")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#0B1118")
            .OfText(
              "تنتقل نقطة الطلب الهيدروليكي إلى منحنى الطلمبة لمراجعة التصرف والضغط وقدرة المحرك وظروف السحب. يشمل الاختيار حدود Shutoff و150% Flow ولوحة التحكم وطلمبة المحافظة على الضغط وملحقات القياس والاختبار وتكوين المصدر الكهربائي أو الديزل.",
            )}
				/>

			</Grid>

		</EmoStr>

		<EmoStr id="FireDesignDocuments" pBg={new ElemBg("#B8322A")} pSize={new Size(new NumPer(1320, "calc(100% - 24px)"), new NumPer("auto", "auto"))}>

			<Stack
				pDir="Row"
				pWidth={new NumPer(1220, "100%")}
				pGap={new Pixel(42, 22)}
				pPad={new Pixel(48, 22)}
				pHzAlign="Stretch"
				pVrAlign="Start"
			>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("المخططات التصميمية والتنفيذية")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "توضح المخططات التصميمية مناطق الحريق ومواقع الطلمبات والخزانات والرايزرات ونقاط التحكم ومعدات الإنذار والإطفاء ومساحات التغطية والربط بين الأنظمة. تضيف المخططات التنفيذية الأقطار والمناسيب والحوامل والصمامات والفتحات وأبعاد غرف المعدات وبيانات الموردين ونقاط العبور والتعارض، فتصل المعلومة إلى فريق الموقع بصيغة قابلة للتنفيذ والفحص.",
            )}
				/>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("تنسيق الخدمات")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "تراجع مسارات الحريق مع الإنشاء والمعماري والتكييف والكهرباء والصحي والأسقف المستعارة. يثبت التنسيق مناسيب العبور وفتحات الكور والدعامات المشتركة ومساحات الصيانة ومواقع الأجهزة والمعدات قبل بدء التركيبات، وتنتقل النتائج إلى إصدار تنفيذي موحد للموقع.",
            )}
				/>

				<Emograph
					pTitle={Text.H4.AtRight.OfSize(23, 19).WithColor("#FCFCFA").OfText("المواصفات والمقايسة")}
					pText={Text.Body.AtRight.OfSize(19, 16)
            .WithColor("#FCFCFA")
            .OfText(
              "تحدد المواصفات مواد المواسير وتصنيفات الضغط وأنواع الصمامات والرشاشات والكواشف والكابلات واشتراطات الطلاء والعزل والتثبيت وشهادات المنتج ومعايير القبول. تربط المقايسة رقم كل بند بوصفه الفني ووحدته وكميته، وتشمل الشبكات والحوامل والمعدات والكابلات والبرمجة والاختبارات ومستندات التسليم.",
            )}
				/>

			</Stack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="WaterFireSystems"
		Service
		pBg={new ElemBg("#FCFCFA")}
		pGap={new Pixel(0)}
		pHzAlign={Align.Center}
	>

		<SecTitle cSkyLiteBlack pTitle="أنظمة الإطفاء بالماء" />

		<EmoStr id="AutomaticSprinklers" pBg={new ElemBg("#DCEEF4")} pSize={new Size(new NumPer(1320, "calc(100% - 24px)"), new NumPer("auto", "auto"))}>

			<DivStr
				pContentSize={new Size(new NumPer(1220, "100%"), new NumPer("auto", "auto"))}
				pGap={new Pixel(38, 18)}
				pPad={new Pixel(48, 22)}
				pVrAlign="Center"
			>

				<DivCol pSize={new Size(new NumPer("43%", "100%"))} pPad={new Pixel(8)} pVrAlign="Center">

					<RespImg
						pImg={new EmoMediaData(
              "Img",
              "https://sos-fire.com/assets/services/",
              "fire-fighting.webp",
              false,
              "شبكة مواسير ورشاشات لمكافحة الحريق بالماء",
              new Size(new NumPer(560, "100%"), new NumPer("auto", "auto")),
            )}
					/>

				</DivCol>

				<DivCol pSize={new Size(new NumPer("57%", "100%"))} pHzAlign="Right" pVrAlign="Center">

					<Emograph
						pTitle={Text.H3.AtRight.OfSize(28, 21).WithColor("#0B1118").OfText("شبكات الرش الآلي")}
						pText={Text.Body.AtRight.OfSize(19, 16)
              .WithColor("#0B1118")
              .OfText(
