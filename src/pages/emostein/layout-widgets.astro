---
import BLayout from "@/Layout.astro";
import { Emograph, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { AngleBand, LayerDeck, LayerItem, MosaicGrid, MosaicItem, RadialItem, RadialLayout, ScrollShelf, ShelfItem, SideRail, SplitPane, SplitScene, StickyStory, StickyStoryItem, StoryRail, StoryStep, ZigzagItem, ZigzagStory } from "../../site/Widgets/Layouts";
import { Pixel, RespString, Text } from "@/TypesLib";

const cSectionPad = new Pixel(72, 28);
const cExampleGap = new Pixel(44, 24);
const cWhiteTitle = (pText: string) => Text.H3.Centered.White.OfText(pText);
const cWhiteBody = (pText: string) => Text.Body.Centered.White.OfText(pText);
const cDarkTitle = (pText: string) => Text.H3.Centered.OfText(pText);
const cDarkBody = (pText: string) => Text.Body.Centered.OfText(pText);
---





<BLayout
	pTitle="مكتبة ودجات اللايوت الحديثة"
	pDescr="ثلاثة أمثلة عملية لكل ودجت لايوت جديد داخل Emostein"
	pSchemaType="CollectionPage"
	pIntro={false}
>







	<Hero pImgF="/Media/Home/" />







	<EmoSec pPad={cSectionPad} pGap={new Pixel(30, 20)}>

		<SecTitle pTitle="Modern Layout Widgets" pDesc="عشرة أنظمة تكوين حديثة، كلها تعمل بقيم افتراضية وتدعم خصائص Place للحركة والتموضع." cBlackWhiteOff={true} />

	</EmoSec>

	<!-- MosaicGrid + MosaicItem: three uses for the parent and repeated child variants. -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="01 — MosaicGrid / MosaicItem" pDesc="بنتو، موزاييك، شبكات تحريرية غير متساوية." cWhiteOffBlack={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<MosaicGrid />

			<MosaicGrid pBg="linear-gradient(135deg, #111a24, #263846)" pAutoRows={new RespString("78px", "70px")}>

				<MosaicItem
					pColSpan={7}
					pColSpanP={4}
					pRowSpan={3}
					pBg="#caff3d"
					pColor="#101820"
				/>

				<MosaicItem />

				<MosaicItem
					pColSpan={5}
					pColSpanP={2}
					pRowSpan={1}
					pBg="#f26a3d"
					pColor="#ffffff"
				/>

				<MosaicItem
					pColSpan={5}
					pColSpanP={2}
					pRowSpan={2}
					pBg="#f8fafb"
				/>

			</MosaicGrid>

			<MosaicGrid
				pColumns={6}
				pColumnsP={2}
				pBg="#f0e8dc"
				pGap={new RespString("14px", "10px")}
			>

				<MosaicItem
					pColSpan={2}
					pColSpanP={2}
					pRowSpan={4}
					pBg="#16222d"
					pColor="#ffffff"
					pClip="polygon(0 0, 100% 7%, 100% 100%, 0 93%)"
				/>

				<MosaicItem
					pColSpan={4}
					pColSpanP={2}
					pRowSpan={2}
					pBg="#ffffff"
				/>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={2}
					pBg="#84d7e8"
				/>

				<MosaicItem
					pColSpan={2}
					pColSpanP={1}
					pRowSpan={2}
					pBg="#ffd84a"
				/>

			</MosaicGrid>

		</VrStack>

	</EmoSec>

	<!-- SplitScene + SplitPane -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="02 — SplitScene / SplitPane" pDesc="مشاهد ثنائية غير متماثلة مع حواف قابلة للقص والعكس." cBlackWhiteOff={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<SplitScene />

			<SplitScene pColumns={new RespString("minmax(0, 7fr) minmax(0, 5fr)", "minmax(0, 1fr)")}>

				<SplitPane />

				<SplitPane pBg="#caff3d" pColor="#111820" pEdge="DiagonalStart">

					<Emograph pTitle={cDarkTitle("لوحة المحتوى")} pText={cDarkBody("تقسيم 7/5 مع حد قطري من داخل الودجت نفسه.")} />

				</SplitPane>

			</SplitScene>

			<SplitScene pReverse={true} pGap={new RespString("18px", "12px")} pBg="#f5eee5">

				<SplitPane pBg="#f36f45" pEdge="Chevron" pEdgeP="None">

					<Emograph pTitle={cWhiteTitle("اتجاه معكوس")} pText={cWhiteBody("يمكن تبديل ترتيب الجزأين من الأب فقط.")} />

				</SplitPane>

				<SplitPane pBg="#14212c" pRadius={new RespString("30px", "18px")} />

			</SplitScene>

		</VrStack>

	</EmoSec>

	<!-- LayerDeck + LayerItem -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="03 — LayerDeck / LayerItem" pDesc="كولاج وواجهات متراكبة من طبقات مستقلة." cWhiteOffBlack={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<LayerDeck />

			<LayerDeck pBg="linear-gradient(135deg, #101a25, #273d4c)" pOverflow="visible">

				<LayerItem
					pWidth={new RespString("72%", "90%")}
					pHeight="72%"
					pHzAlign="Start"
					pVrAlign="Start"
					pBg="#83d6e8"
				/>

				<LayerItem />

				<LayerItem
					pWidth={new RespString("44%", "72%")}
					pHeight="34%"
					pHzAlign="End"
					pVrAlign="End"
					pBg="#caff3d"
					pOffsetX="-3%"
					pOffsetY="-4%"
					pMove="FloatY"
				/>

			</LayerDeck>

			<LayerDeck pAspect={new RespString("21 / 9", "4 / 5")} pBg="#f2e9dc">

				<LayerItem
					pWidth="58%"
					pHeight="82%"
					pHzAlign="End"
					pVrAlign="Center"
					pBg="#f06740"
					pColor="#ffffff"
					pRadius="999px"
				/>

				<LayerItem
					pWidth={new RespString("48%", "80%")}
					pHeight="46%"
					pHzAlign="Start"
					pVrAlign="End"
					pBg="rgba(19,31,42,.94)"
				>

					<Emograph pTitle={cWhiteTitle("طبقات حرة")} pText={cWhiteBody("كل طبقة تحتفظ بخصائص Place الخاصة بها.")} />

				</LayerItem>

				<LayerItem
					pWidth="28%"
					pHeight="24%"
					pHzAlign="Center"
					pVrAlign="Start"
					pBg="#ffffff"
					pOffsetY="5%"
				/>

			</LayerDeck>

		</VrStack>

	</EmoSec>

	<!-- AngleBand -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="04 — AngleBand" pDesc="قطاعات مائلة أو شيفرون من غير تدوير المحتوى." cBlackWhiteOff={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<AngleBand />

			<AngleBand
				pDirection="Fall"
				pCut={new RespString("14%", "5%")}
				pBg="linear-gradient(120deg, #f26942, #ffb34d)"
				pColor="#18212a"
			>

				<Emograph pTitle={cDarkTitle("قطاع هابط")} pText={cDarkBody("درجة القص تتغير بين العرض الأفقي والرأسي.")} />

			</AngleBand>

			<AngleBand
				pDirection="Chevron"
				pCut="11%"
				pBg="#caff3d"
				pColor="#101820"
				pMinHeight="280px"
				pMove="FadeIn"
			>

				<Emograph pTitle={cDarkTitle("شيفرون كامل")} pText={cDarkBody("مناسب للفواصل القوية وشرائط الدعوة إلى الإجراء.")} />

			</AngleBand>

		</VrStack>

	</EmoSec>

	<!-- ZigzagStory + ZigzagItem -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="05 — ZigzagStory / ZigzagItem" pDesc="سرد متعاقب بين الصورة والنص مع تناوب تلقائي." cWhiteOffBlack={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<ZigzagStory />

			<ZigzagStory pBg="#111a24" pGap="28px">

				<ZigzagItem />

				<ZigzagItem pMediaBg="#caff3d" pBg="#f8fafb" pClip="Diagonal" />

				<ZigzagItem pMediaBg="#f36d45" pBg="#83d6e8" pClip="Arch" />

			</ZigzagStory>

			<ZigzagStory pAlternate={false} pOverlap={new RespString("24px", "0px")} pBg="#efe7db">

				<ZigzagItem
					pSide="Start"
					pMediaShare={64}
					pMediaBg="#17232d"
					pClip="Inset"
				>

					<Emograph pTitle={cDarkTitle("مشهد أول")} pText={cDarkBody("نسبة الصورة واتجاهها يحددان من نفس العنصر.")} />

				</ZigzagItem>

				<ZigzagItem pSide="Start" pMediaShare={42} pMediaBg="#f36d45">

					<Emograph pTitle={cDarkTitle("مشهد ثانٍ")} pText={cDarkBody("يمكن إيقاف التناوب وبناء إيقاع ثابت.")} />

				</ZigzagItem>

			</ZigzagStory>

		</VrStack>

	</EmoSec>

	<!-- SideRail -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="06 — SideRail" pDesc="شريط جانبي ثابت أو عادي مع جسم محتوى مستقل." cBlackWhiteOff={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<SideRail />

			<SideRail pRailBg="#caff3d" pRailColor="#101820" pRailWidth="280px">

				<Emograph slot="rail" pTitle={cDarkTitle("فهرس ثابت")} pText={cDarkBody("الشريط يظل مرئيًا أثناء مرور المحتوى.")} />

				<StickyStoryItem pKicker="قسم 01" pTitle="المحتوى الرئيسي" pText="يمكن أن يكون الجسم مكوّنًا من أي ودجات موجودة بالفعل." />

				<StickyStoryItem />

			</SideRail>

			<SideRail
				pSide="End"
				pSticky={false}
				pBg="#14212c"
				pRailBg="#f36d45"
				pRailWidth="210px"
			>

				<Emograph slot="rail" pTitle={cWhiteTitle("Rail End")} pText={cWhiteBody("شريط في الجهة المقابلة من غير Sticky.")} />

				<StickyStoryItem pBg="#83d6e8" pTitle="بطاقة سماوية" pText="نسخة مناسبة لصفحات الأخبار والخدمات." />

				<StickyStoryItem pBg="#f5eee5" pTitle="بطاقة محايدة" pText="التكوين ينهار تلقائيًا إلى عمود على الموبايل." />

			</SideRail>

		</VrStack>

	</EmoSec>

	<!-- StoryRail + StoryStep -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="07 — StoryRail / StoryStep" pDesc="تايملاين رأسي أو أفقي بخط موحد ونقاط مرقمة." cWhiteOffBlack={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<StoryRail />

			<StoryRail pAccent="#f36d45" pBg="#172531">

				<StoryStep />

				<StoryStep
					pNumber="02"
					pKicker="بحث"
					pTitle="جمع المدخلات"
					pText="الخطوة تحمل النصوص والألوان والترقيم الخاص بها."
				/>

				<StoryStep
					pNumber="03"
					pKicker="بناء"
					pTitle="تكوين النظام"
					pText="الأب مسؤول عن المسار والتناوب فقط."
				/>

				<StoryStep
					pNumber="04"
					pKicker="تسليم"
					pTitle="إطلاق النتيجة"
					pText="ويبقى كل عنصر صالحًا للحركة والتموضع."
				/>

			</StoryRail>

			<StoryRail
				pAxis="Horizontal"
				pAxisP="Vertical"
				pAlternate={false}
				pBg="#f0e8dc"
				pTrackColor="rgba(20,31,42,.24)"
				pAccent="#14212c"
			>

				<StoryStep
					pNumber="A"
					pTitle="اكتشاف"
					pText="مسار أفقي في اللاندسكيب."
					pBg="#ffffff"
					pColor="#14212c"
					pAccent="#f36d45"
				/>

				<StoryStep
					pNumber="B"
					pTitle="اختبار"
					pText="ثم يتحول رأسيًا في البورتريت."
					pBg="#83d6e8"
					pColor="#14212c"
					pAccent="#f36d45"
				/>

				<StoryStep
					pNumber="C"
					pTitle="تحسين"
					pText="من غير تكرار منطق اللايوت."
					pBg="#caff3d"
					pColor="#14212c"
					pAccent="#f36d45"
				/>

			</StoryRail>

		</VrStack>

	</EmoSec>

	<!-- ScrollShelf + ShelfItem -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="08 — ScrollShelf / ShelfItem" pDesc="رف أفقي طبيعي بتمرير وSnap ومن غير Carousel خارجي." cBlackWhiteOff={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<ScrollShelf />

			<ScrollShelf pBg="#15212c" pItemWidth={new RespString("300px", "78vw")} pSnap="mandatory">

				<ShelfItem />

				<ShelfItem pBg="#caff3d" pAccent="#f36d45" />

				<ShelfItem pBg="#83d6e8" pAccent="#14212c" />

				<ShelfItem pBg="#f36d45" pColor="#ffffff" pAccent="#caff3d" />

			</ScrollShelf>

			<ScrollShelf
				pEdgeFade={false}
				pBg="#f0e8dc"
				pItemWidth="410px"
				pGap="30px"
			>

				<ShelfItem pMediaHeight="190px" pRadius="8px">

					<Emograph slot="media" pTitle={cWhiteTitle("01")} />

					<Emograph pTitle={cDarkTitle("بطاقة تحريرية")} pText={cDarkBody("مقاس أعرض وحواف حادة.")} />

				</ShelfItem>

				<ShelfItem pMediaHeight="190px" pRadius="36px" pAccent="#83d6e8">

					<Emograph slot="media" pTitle={cWhiteTitle("02")} />

					<Emograph pTitle={cDarkTitle("بطاقة ناعمة")} pText={cDarkBody("نفس الأب مع شخصية بصرية مختلفة.")} />

				</ShelfItem>

				<ShelfItem
					pMediaHeight="190px"
					pBg="#14212c"
					pColor="#ffffff"
					pAccent="#f36d45"
				/>

			</ScrollShelf>

		</VrStack>

	</EmoSec>

	<!-- RadialLayout + RadialItem -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="09 — RadialLayout / RadialItem" pDesc="مركز محاط بعناصر شرح، ثم يتحول لقائمة واضحة على الشاشات الضيقة." cWhiteOffBlack={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<RadialLayout />

			<RadialLayout
				pCount={4}
				pCenterTitle="المنتج"
				pCenterText="نظام واحد"
				pCenterBg="#f36d45"
				pAccent="#14212c"
			>

				<RadialItem />

				<RadialItem pTitle="سرعة" pText="تنفيذ أسرع" pBg="#caff3d" />

				<RadialItem pTitle="وضوح" pText="بنية مقروءة" pBg="#83d6e8" />

				<RadialItem
					pTitle="مرونة"
					pText="تركيب حر"
					pBg="#14212c"
					pColor="#ffffff"
				/>

			</RadialLayout>

			<RadialLayout
				pCount={5}
				pDiameter="680px"
				pCenterTitle="الخدمة"
				pCenterText="رحلة العميل"
				pBg="#14212c"
				pCenterBg="#caff3d"
				pCenterColor="#14212c"
				pRingColor="rgba(255,255,255,.28)"
				pAccent="#f36d45"
			>

				<RadialItem pTitle="01" pText="اكتشاف" pAccent="#f36d45" />

				<RadialItem pTitle="02" pText="تخطيط" pAccent="#f36d45" />

				<RadialItem pTitle="03" pText="تصميم" pAccent="#f36d45" />

				<RadialItem pTitle="04" pText="تنفيذ" pAccent="#f36d45" />

				<RadialItem pTitle="05" pText="قياس" pAccent="#f36d45" />

			</RadialLayout>

		</VrStack>

	</EmoSec>

	<!-- StickyStory + StickyStoryItem -->

	<EmoSec pPad={cSectionPad} pGap={new Pixel(26, 18)}>

		<SecTitle pTitle="10 — StickyStory / StickyStoryItem" pDesc="مشهد بصري ثابت بجوار فصول محتوى متتابعة." cBlackWhiteOff={true} />

		<VrStack pGap={cExampleGap} pPad={new Pixel(0)}>

			<StickyStory />

			<StickyStory pVisualShare={42} pVisualBg="#f36d45" pBg="#14212c">

				<Emograph slot="visual" pTitle={cWhiteTitle("مشهد ثابت")} pText={cWhiteBody("ينتظر القارئ عند كل فصل من فصول القصة.")} />

				<StickyStoryItem />

				<StickyStoryItem
					pKicker="الفصل 02"
					pTitle="توضيح القيمة"
					pText="كل فصل مستقل وله ألوانه ومقاساته وخصائص حركته."
					pBg="#83d6e8"
				/>

				<StickyStoryItem
					pKicker="الفصل 03"
					pTitle="الدعوة للفعل"
					pText="المشهد الثابت لا يحتاج JavaScript إضافيًا."
					pBg="#caff3d"
				/>

			</StickyStory>

			<StickyStory
				pSide="End"
				pVisualShare={56}
				pVisualBg="#172531"
				pBg="#efe7dc"
			>

				<Emograph slot="visual" pTitle={cWhiteTitle("Visual End")} pText={cWhiteBody("تبديل الجهة مسؤولية الأب.")} />

				<StickyStoryItem
					pKicker="01"
					pTitle="منتج"
					pText="لقطة واحدة تشرح عدة مزايا."
					pAccent="#f36d45"
				/>

				<StickyStoryItem
					pKicker="02"
					pTitle="تفاصيل"
					pText="فصول طويلة من غير فقدان السياق البصري."
					pBg="#f36d45"
					pColor="#ffffff"
					pAccent="#caff3d"
				/>

				<StickyStoryItem
					pKicker="03"
					pTitle="قرار"
					pText="وفي البورتريت يتحول التكوين إلى تدفق طبيعي."
					pBg="#14212c"
					pColor="#ffffff"
					pAccent="#83d6e8"
				/>

			</StickyStory>

		</VrStack>

	</EmoSec>







</BLayout>
