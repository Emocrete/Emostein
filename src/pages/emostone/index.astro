---
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { Badge, CardsGr, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack } from "@/Widgets";
import EmoGallery from "@/Widgets/Media/EmoGallery.astro";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام وجرانيت"
	pDescr="توريد وتركيب رخام وجرانيت للمشاريع السكنية والتجارية والصناعية، مع اختيار خامات عالية الجودة، قص وتشكيل، تركيب أرضيات وواجهات ومطابخ وحمامات ومصاعد وسلالم، تشطيب نهائي وصيانة."
>







	<Hero
		pTitle="توريد وتركيب رخام وجرانيت"
		pDesc="حلول تناسب مختلف المشاريع السكنية والتجارية والصناعية، من اختيار الخامات عالية الجودة حتى التشطيب النهائي"
		pHzAlign="center"
		pVrAlign="center"
		pBlurP="on"
		pPosL="55% 13% 10% 35%"
		pPosP="50% 2% 5% 2%"
	>

		<Badge
			pYears={15}
			pYearsText="سنوات الخبرة"
			pQualityText="فرز أول"
			pWorks={7}
			pWorksText="سابقة الأعمال"
		/>

		<EmoCall BlackSky pText="اطلب عرض سعر" />

	</Hero>







	<ESec
		hidden
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="المحجر لخدمات الرخام والجرانيت"
			pDesc="خبرة في اختيار الخامات، فرز الألواح، التوريد، التركيب، التشطيب، والصيانة داخل القاهرة والجيزة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(350, 340)}
					pGap={new Pixel(15, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/308dfd_a8f97366f71b4e85a042201b00c3ea78~mv2.webp/v1/fill/w_88,h_88,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/",
							"Experience%20Icon.webp",
							false,
							"خبرة",
							new Size(new NumPer(80, "80px"), new NumPer("auto", "auto"))
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("+ 15 عام")}
						pText={Text.Body.Centered.OfText("خبرة في توريد وتركيب الرخام والجرانيت للأرضيات والواجهات والسلالم والمطابخ والحمامات.")}
						pSize={new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(350, 340)}
					pGap={new Pixel(15, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/308dfd_7ba36b9723a6436e86a1ca0cef82bf6e~mv2.webp/v1/fill/w_88,h_88,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/",
							"Diamond%20Icon.webp",
							false,
							"فرز أول",
							new Size(new NumPer(80, "80px"), new NumPer("auto", "auto"))
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("فرز أول")}
						pText={Text.Body.Centered.OfText("مراجعة الخامة قبل التوريد من حيث اللون والعروق والشروخ والكسور وجودة التلميع.")}
						pSize={new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(350, 340)}
					pGap={new Pixel(15, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.OrangeLite)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/308dfd_50c25a6580834545bec5af2ebf36503b~mv2.webp/v1/fill/w_88,h_88,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/",
							"Loc%20Icon.webp",
							false,
							"القاهرة والجيزة",
							new Size(new NumPer(80, "80px"), new NumPer("auto", "auto"))
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("القاهرة والجيزة")}
						pText={Text.Body.Centered.OfText("تنفيذ للمشاريع السكنية والتجارية والصناعية داخل القاهرة والجيزة وما حولهما.")}
						pSize={new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		id="secCompare"
		pBg={new ElemBg(Colors.WhiteOff,new EmoMediaData("Img","/Media/Emostone/","MarbleVsGranite.webp",true,"قطعة رخام بألوان براقة ومبهجة مع قطعة جرانيت أبيض بنقاط سوداء"))}
		pHzAlign={Align.LeftCenter}
		pVrAlign={Align.LeftCenter}
	>

		<SecTitle style = {`--StripBg:${Colors.Gray5};`} pTitle="أيهما أفضل ؟ الرخام أم الجرانيت ؟" />

		<EmoStrip pBg={new ElemBg("transparent")}>

			<EmoStrip pSize={new Size(new NumPer(1000, "calc(100% - 30px)"), new NumPer("auto", "auto"))}>

				<HzStack>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/498793_754af6ab89ab4baaa0544461a2502aa3~mv2.jpg/v1/crop/x_163%2Cy_0%2Cw_699%2Ch_683/fill/w_220%2Ch_215%2Cal_c%2Cq_90%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/",
					"151014152582533.jpg",
					false,
					"رخام أبيض مستورد",
					new Size(new NumPer(420, "100%"), new NumPer("auto", "auto"))
				)}
					/>

					<Emograph
						pTitle={Text.H3.OfText("الرخام للأناقة والنعومة البصرية")}
						pText={Text.Body.OfText("يتميز الرخام بمظهره الأنيق وسطحه الناعم، ويستخدم في التصميم الداخلي والخارجي عند اختيار النوع المناسب. نوفر رخامًا مصريًا أصليًا، ورخامًا مستوردًا، وخيارات متعددة تناسب الأرضيات والحوائط والمداخل والحمامات والديكورات.")}
						pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

		<EmoStrip pBg={new ElemBg("transparent")}>

			<EmoStrip pSize={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}>

				<HzStack>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("الجرانيت للتحمل والاستخدام الخارجي")}
						pText={Text.Body.WithAlign("right").OfText("يشتهر الجرانيت بتحمله للصدمات والخدوش وملائمته للاستخدام الخارجي والواجهات. يستخدم أيضًا في المطابخ والسلالم والأرضيات عالية الحركة، مع تنوع كبير في الألوان مثل الأسود والبني والنجراني والروزا والجلاكسي.")}
						pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
					/>

					<RespImg
						pImg={new EmoMediaData(
					"Img",
					"https://static.wixstatic.com/media/498793_2891cf9afb27469eb388cd04da704e30~mv2.webp/v1/fill/w_220%2Ch_215%2Cal_c%2Cq_90%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/",
					"new%20halayeb.webp",
					false,
					"جرانيت نيو حلايب",
					new Size(new NumPer(420, "100%"), new NumPer("auto", "auto"))
				)}
					/>

				</HzStack>

			</EmoStrip>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="الرخام المصري والمستورد"
			pDesc="نقدم أنواع الرخام المتعارف عليها في السوق المصري والعالمي، مع ترشيح النوع حسب الاستخدام والميزانية"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)}>

			<VrStack>

				<Emograph
					pText={Text.Body.Centered.OfText("لكل نوع ميزاته واستخداماته. الرخام الطبيعي يعطي شعورًا بالفخامة ومتانة طويلة الأمد عند العناية به، والرخام الصناعي يقدم مرونة في التصميم وسعرًا أقل، مع إمكانية تقليد شكل الرخام الطبيعي بجودة مناسبة حسب نوع الخامة.")}
					pSize={new Size(new NumPer(1100, "100%"), new NumPer("auto", "auto"))}
				/>

				<HzStack>

					<Emograph
						pTitle={Text.H3.Centered.OfText("رخام مصري")}
						pSize={new Size(new NumPer(100, "auto"), new NumPer(30, "auto"))}
						data-own-size
					/>

					<EmoGallery pFolder="/Media/Emostone/Marble/Eg/Samples" pSize={new Size(new NumPer(1700, "auto"), new NumPer(600, "auto"))} />

				</HzStack>

				<HzStack>

					<Emograph
						pTitle={Text.H3.Centered.OfText("رخام مستورد")}
						pSize={new Size(new NumPer(100, "auto"), new NumPer(30, "auto"))}
						data-own-size
					/>

					<EmoGallery pFolder="/Media/Emostone/Marble/Imp/Samples" pSize={new Size(new NumPer(1700, 300), new NumPer(600, "auto"))} />

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec
		id="secGraniteTypes"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أنواع الجرانيت وأفضل استخداماتها"
			pDesc="الجرانيت اختيار مناسب للأرضيات والواجهات الخارجية والمطابخ بسبب مقاومة الحرارة والصدمات وسهولة الصيانة"
		/>

		<EmoStrip id="strGraniteTypes" pBg={new ElemBg(Colors.Gray1)}>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"https://static.wixstatic.com/media/498793_2891cf9afb27469eb388cd04da704e30~mv2.webp/v1/fill/w_220%2Ch_215%2Cal_c%2Cq_90%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/",
						"new%20halayeb.webp",
						false,
						"جرانيت نيو حلايب",
						new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))
					)}
				/>

				<EmoList
					pWidth={new RespString("850px", "100%")}
					pTitle={Text.H3.Centered.OfText("مميزات الجرانيت")}
					pDesc={Text.Body.Centered.OfText("خامة عملية تناسب الاستخدام اليومي والحركة العالية")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"مقاومة عالية للحرارة والصدمات.",
						"تنوع في الألوان والأشكال مثل البني والأسود والنجراني والروزا.",
						"سهولة في الصيانة وعمر افتراضي طويل.",
						"استخدام واسع في الأرضيات والواجهات الخارجية والمطابخ والسلالم.",
						"اختيارات مصرية ومستوردة مثل أحمر أسواني، روزي بينك، جندولا، نجران براون، وجالاكسي الهندي."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="خدمات توريد وتركيب الرخام والجرانيت"
			pDesc="الخدمة تشمل التوريد والتركيب والتشطيب والتلميع والتقطيع حسب المقاسات والتصاميم المطلوبة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("خدمات التوريد")}
					pDesc={Text.Body.Centered.OfText("نوفر النوع المطلوب مع مراجعة الجودة ومطابقة المقاسات")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "توريد الرخام والجرانيت", Items: ["توفير النوع المختار حسب الاستخدام والميزانية.", "مراجعة جودة الخامة وفرز الألواح قبل التوريد.", "مطابقة المقاسات المطلوبة قدر الإمكان."] },
						{ Title: "استشارات اختيار الخامة", Items: ["تحديد النوع المناسب للمكان.", "اختيار اللون والنقشة بما يتناسب مع التصميم.", "مراعاة الميزانية والاستخدام النهائي."] },
						{ Title: "خدمات التقطيع والتشكيل", Items: ["تقطيع الرخام والجرانيت حسب المقاسات.", "تجهيز القطع المنحنية والزخرفية.", "قص فتحات المطابخ والحمامات والمصاعد والسلالم."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("خدمات التركيب")}
					pDesc={Text.Body.Centered.OfText("تنفيذ أعمال التركيب بدقة في الأرضيات والواجهات والمطابخ والحمامات")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "تركيب الأرضيات", Items: ["أرضيات داخلية وخارجية.", "ضبط المناسيب والفواصل.", "تجهيز السطح قبل التركيب."] },
						{ Title: "تركيب الواجهات", Items: ["واجهات خارجية للمنازل والفيلات والمباني التجارية.", "تنفيذ بمقاسات دقيقة.", "مراعاة مقاومة الماء والعوامل الجوية."] },
						{ Title: "تركيب المطابخ والحمامات", Items: ["تركيب أسطح مطابخ.", "تجهيز فتحات الأحواض والبوتاجازات.", "مراعاة مقاومة الماء والبقع."] },
						{ Title: "تركيب المصاعد والسلالم", Items: ["تنفيذ الدرج والوزرات والعتب.", "كسوة المصاعد.", "تفاصيل دقيقة تعطي مظهرًا متناسقًا."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="تشطيبات الرخام والجرانيت"
			pDesc="التشطيب الجيد يبرز اللون واللمعان ويؤثر على عمر الخامة ومقاومتها للبقع والخدوش"
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.WithAlign("right").White.OfText("التشطيب النهائي والتلميع")}
					pText={Text.Body.WithAlign("right").White.OfText("بعد التركيب، يتم تلميع السطح وإزالة الشوائب وبقايا التنفيذ لإظهار ألوان الرخام أو الجرانيت بأفضل صورة. تلميع الرخام يكشف اللون الطبيعي ويزيد اللمعان، وتشطيب الجرانيت يعزز مقاومته للخدوش والحرارة، خاصة في المطابخ والأرضيات الخارجية.")}
					pSize={new Size(new NumPer(650, "100%"), new NumPer("auto", "auto"))}
				/>

				<EmoList
					pWidth={new RespString("500px", "100%")}
					pTitle={Text.H3.Centered.OfText("بنود التشطيب")}
					pDesc={Text.Body.Centered.OfText("مرحلة تسليم السطح بالشكل النهائي")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						"تلميع الرخام لإبراز اللون واللمعان الطبيعي.",
						"قص الرخام بأشكال مخصصة للتصميم الداخلي والخارجي.",
						"تشطيب الواجهات الرخامية والجرانيتية.",
						"إعادة تلميع الأسطح بشكل دوري للحفاظ على اللمعان.",
						"تنظيف الأرضيات باستخدام منظفات مناسبة للرخام أو الجرانيت."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="الفرق بين الرخام الطبيعي والصناعي"
			pDesc="معرفة الفرق تساعد في اختيار المادة المناسبة للتصميم والميزانية والاستخدام"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("600px", "100%")}
					pTitle={Text.H3.Centered.OfText("الرخام الطبيعي")}
					pDesc={Text.Body.Centered.OfText("خامة أصلية بعروق طبيعية وعمر افتراضي طويل")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"متين وأصلي ومناسب للمشروعات التي تحتاج فخامة وملمسًا طبيعيًا.",
						"يعطي مظهرًا طبيعيًا وفخمًا في الأرضيات والحوائط والمداخل.",
						"يحتاج صيانة دورية وتلميعًا للحفاظ على لمعانه.",
						"سعره أعلى نسبيًا من الصناعي حسب النوع والمنشأ والفرز."
					]}
				/>

				<EmoList
					pWidth={new RespString("600px", "100%")}
					pTitle={Text.H3.Centered.OfText("الرخام الصناعي")}
					pDesc={Text.Body.Centered.OfText("خامة اقتصادية بألوان وتصميمات متعددة")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
