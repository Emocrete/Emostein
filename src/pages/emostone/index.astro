---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { Badge, EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery, RespImg } from "@/Widgets/Media";
import { DivCol, DivStr, EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام وجرانيت"
	pDescr="توريد وتركيب رخام وجرانيت للمشاريع السكنية والتجارية والصناعية، مع اختيار خامات عالية الجودة، قص وتشكيل، تركيب أرضيات وواجهات ومطابخ وحمامات ومصاعد وسلالم، تشطيب نهائي وصيانة."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("50%","95%"))} pLoc={new Loc(new NumPer("40%","2.5%"),new NumPer("45%","40%"))}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب رخام وجرانيت")}
				pText={Text.Body.Centered.OfText("حلول تناسب مختلف المشاريع السكنية والتجارية والصناعية، من اختيار الخامات عالية الجودة حتى التشطيب النهائي")}
			/>

			<Badge
				pYears={15}
				pYearsText="سنوات الخبرة"
				pQualityText="فرز أول"
				pWorks={7}
				pWorksText="سابقة الأعمال"
				pMobMaxCols={2}
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<EmoSec
		id="secCompare"
		pBg={new ElemBg(Colors.WhiteOff,new EmoMediaData("Img","/Media/Emostone/","MarbleVsGranite.webp",true,"قطعة رخام بألوان براقة ومبهجة مع قطعة جرانيت أبيض بنقاط سوداء"))}
		pHzAlign={Align.LeftCenter}
		pVrAlign={Align.LeftCenter}
	>

		<SecTitle
			id="sectCompare"
			WhiteOff
			pTitle="أيهما أفضل ؟ الرخام أم الجرانيت ؟"
		/>

		<DivStr id="strCompare">

			<DivCol />

			<DivCol>

				<DivStr>

					<DivCol>

						<RespImg pImg={new EmoMediaData("Img","/Media/Emostone","MarbleCompare.webp",false,"رخام أبيض مستورد")} />

					</DivCol>

					<DivCol>

						<Emograph
							pTitle={Text.H3.OfText("الرخام للأناقة والنعومة البصرية")}
							pText={Text.Body.OfText("يتميز الرخام بمظهره الأنيق وسطحه الناعم، ويستخدم في التصميم الداخلي والخارجي عند اختيار النوع المناسب. نوفر رخامًا مصريًا أصليًا، ورخامًا مستوردًا، وخيارات متعددة تناسب الأرضيات والحوائط والمداخل والحمامات والديكورات.")}
						/>

					</DivCol>

				</DivStr>

				<DivStr>

					<DivCol>

						<Emograph
							pTitle={Text.H3.WithAlign("right").OfText("الجرانيت للتحمل والاستخدام الخارجي")}
							pText={Text.Body.WithAlign("right").OfText("يشتهر الجرانيت بتحمله للصدمات والخدوش وملائمته للاستخدام الخارجي والواجهات. يستخدم أيضًا في المطابخ والسلالم والأرضيات عالية الحركة، مع تنوع كبير في الألوان مثل الأسود والبني والنجراني والروزا والجلاكسي.")}
						/>

					</DivCol>

					<DivCol>

						<RespImg pImg={new EmoMediaData("Img","/Media/Emostone","GranitCompare.webp",false,"جرانيت نيو حلايب")} />

					</DivCol>

				</DivStr>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		id="secMarble"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			id="sectMarble"
			GreenLite
			pTitle="الرخام المصري والمستورد"
			pDesc="نقدم أنواع الرخام المتعارف عليها في السوق المصري والعالمي، مع ترشيح النوع حسب الاستخدام والميزانية"
		/>

		<DivStr id="strEgMarble">

			<DivCol>

				<Emograph
					id="txtEgMarple"
					pTitle={Text.H3.Centered.OfText("رخام مصري")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DivCol>

			<DivCol>

				<EmoGallery id="galEgMarble" pFolder="/Media/Emostone/Marble/Eg/Samples" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph
					id="txtImpMarple"
					pTitle={Text.H3.Centered.OfText("رخام مستورد")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DivCol>

			<DivCol>

				<EmoGallery id="galImpMarble" pFolder="/Media/Emostone/Marble/Imp/Samples" />

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		hidden
		id="secGraniteTypes"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			Gray2
			pTitle="أنواع الجرانيت وأفضل استخداماتها"
			pDesc="الجرانيت اختيار مناسب للأرضيات والواجهات الخارجية والمطابخ بسبب مقاومة الحرارة والصدمات وسهولة الصيانة"
		/>

		<EmoStr id="strGraniteTypes" pBg={new ElemBg(Colors.Gray1)}>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"/Media/Emostone",
						"GranitCompare.webp",
						false,
						"جرانيت نيو حلايب",
						new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))
					)}
				/>

				<EmoList
					pWidth={new RespString("850px", "100%")}
					pTitle={Text.H3.Centered.OfText("مميزات الجرانيت")}
					pDesc={Text.Body.Centered.OfText("خامة عملية تناسب الاستخدام اليومي والحركة العالية")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"مقاومة عالية للحرارة والصدمات.",
						"تنوع في الألوان والأشكال مثل البني والأسود والنجراني والروزا.",
						"سهولة في الصيانة وعمر افتراضي طويل.",
						"استخدام واسع في الأرضيات والواجهات الخارجية والمطابخ والسلالم.",
						"اختيارات مصرية ومستوردة مثل أحمر أسواني، روزي بينك، جندولا، نجران براون، وجالاكسي الهندي."
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		hidden
		id="secUses"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle GreenLite pTitle="استخدامات الرخام والجرانيت" />

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<CardsGr
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pSpacing={20}
				pTopic1={new Topic("الأرضيات", "تضيف فخامة لأي مساحة داخلية، ويمكن استخدام الرخام الطبيعي أو الصناعي حسب الميزانية، مع اختيار الجرانيت في المناطق عالية الحركة.")}
				pTopic2={new Topic("واجهات المباني", "الرخام الطبيعي أو الجرانيت المقاوم للعوامل الجوية يحافظ على شكل الواجهة لفترات طويلة عند التركيب الصحيح.")}
				pTopic3={new Topic("المطابخ والحمامات", "تستخدم الخامات المناسبة لمقاومة البقع والرطوبة، مع إمكانية التشكيل حسب التصميم والفتحات المطلوبة.")}
				pTopic4={new Topic("المصاعد والدرج", "يعطي الرخام والجرانيت مظهرًا أنيقًا ويزيد من قيمة العقار عند اختيار نوع يتحمل الحركة اليومية.")}
				pTopic5={new Topic("المساحات الخارجية", "تستخدم الخامات المناسبة للواجهات والأسوار والمداخل الخارجية مع مراعاة مقاومة الشمس والمطر.")}
				pTopic6={new Topic("الديكورات الداخلية", "ألواح كبيرة، خلفيات، أعمدة، حليات، ورسومات هندسية حسب التصميم المطلوب.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		hidden
		id="secChoose"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			id="sectChoose"
			Gray2
			pTitle="اختيار الرخام المناسب"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("عوامل الاختيار")}
					pDesc={Text.Body.Centered.OfText("هذه العوامل تحدد النوع المناسب قبل الشراء")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "المساحة والاستخدام", Items: ["تحديد الداخل أو الخارج.", "تحديد الأرضيات أو الواجهات أو المطابخ أو الديكور.", "اختيار خامة تتحمل طبيعة المكان."] },
						{ Title: "اللون والتصميم", Items: ["الألوان الفاتحة تضيف اتساعًا وإشراقًا.", "الألوان الداكنة تعطي فخامة وأناقة.", "اختيار العروق بما يتناسب مع التصميم العام."] },
						{ Title: "الميزانية", Items: ["الرخام المصري أكثر توفيرًا.", "الرخام المستورد يقدم تصميمات ونقشات عالمية.", "الجرانيت مناسب عند أولوية التحمل."] },
						{ Title: "الفحص قبل الشراء", Items: ["التأكد من عدم وجود كسور أو شقوق.", "مراجعة السمك واللمعة والفرز.", "مطابقة العينة للكمية قدر الإمكان."] }
					]}
				/>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"https://static.wixstatic.com/media/498793_c6c5812bd532499bb3e8aecf1abcf687~mv2.jpg/v1/crop/x_107%2Cy_0%2Cw_626%2Ch_612/fill/w_220%2Ch_215%2Cal_c%2Cq_90%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/",
						"Galala.jpg",
						false,
						"رخام جلالة",
						new Size(new NumPer(420, "100%"), new NumPer("auto", "auto"))
					)}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن تركيب الرخام في المطابخ؟"
			pAnswer="نعم، يمكن استخدام الرخام الطبيعي أو الصناعي في المطابخ مع مراعاة مقاومة الماء والخدوش وطريقة الصيانة. في الاستخدام اليومي الشاق يمكن ترشيح الجرانيت أو الكوارتز حسب طبيعة المطبخ."
		/>

		<FaqItem
			pQuestion="ما الفرق بين الرخام والجرانيت للأرضيات؟"
			pAnswer="الرخام يعطي لمعانًا وأناقة وإحساسًا بالفخامة، والجرانيت أكثر مقاومة للتحمل والحركة، لذلك يناسب الأماكن عالية الاستخدام."
		/>

		<FaqItem
			pQuestion="هل تحتاج الأرضيات إلى صيانة مستمرة؟"
			pAnswer="الرخام الطبيعي يحتاج تلميعًا دوريًا للحفاظ على لمعانه، والجرانيت يحتاج تنظيفًا مناسبًا ومتابعة للفواصل والسطح حسب الاستخدام."
		/>

		<FaqItem
			pQuestion="هل توفرون تركيب الواجهات الخارجية؟"
			pAnswer="نعم، يتم تركيب الرخام والجرانيت للواجهات الخارجية مع مراعاة الخامة وطريقة التثبيت والمقاسات ومقاومة العوامل الجوية."
		/>

		<FaqItem
			pQuestion="هل توفرون تقطيع وتشكيل حسب الطلب؟"
			pAnswer="نعم، نقدم تقطيعًا حسب المقاسات والتصاميم المطلوبة، مع تشكيل الألواح والقطع المنحنية والزخرفية حسب طبيعة المشروع."
		/>

		<FaqItem
			pQuestion="ما البيانات المطلوبة لعرض السعر؟"
			pAnswer="نحتاج نوع الاستخدام، صور المكان، المقاسات التقريبية، المدينة أو المنطقة، نوع الخامة المفضل، وهل المطلوب توريد فقط أم توريد وتركيب وتشطيب."
		/>

	</EmoFaq>







	<ReadAlso>

		<ReadAlsoItem
			pTitle="توريد وتركيب رخام"
			pDesc="رخام مصري ومستورد للأرضيات والسلالم والمداخل والحوائط والديكور الداخلي."
			pHref="/emostone/marble"
		/>

		<ReadAlsoItem
			pTitle="توريد وتركيب جرانيت"
			pDesc="جرانيت مصري ومستورد للمطابخ والسلالم والواجهات والأرضيات عالية الحركة."
			pHref="/emostone/granit"
		/>

		<ReadAlsoItem
			pTitle="توريد وتركيب كوارتز"
			pDesc="كوارتز للمطابخ والحمامات والجزيرات والأسطح الحديثة."
			pHref="/emostone/quartz"
		/>

		<ReadAlsoItem
			pTitle="توريد وتركيب حجر طبيعي"
			pDesc="حجر طبيعي للواجهات والأسوار والديكورات الخارجية والداخلية."
			pHref="/emostone/stone"
		/>

	</ReadAlso>







	<RelServices>

		<RelServiceItem
			pTitle="تشطيب شقق وفلل"
			pDesc="تنسيق خامات الأرضيات والحوائط والسلالم والمطابخ ضمن خطة التشطيب الكاملة."
			pHref="/emocrete/finishing"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="اختيار خامة واجهة وأرضيات تناسب هوية المحل وحركة العملاء والتنظيف اليومي."
			pHref="/emocrete/finishing/retail"
		/>

		<RelServiceItem
			pTitle="إشراف على التشطيب"
			pDesc="مراجعة المقاسات والاستلام وجودة التركيب قبل ضياع قيمة الخامة."
			pHref="/emocrete/supervision/finishing"
		/>

	</RelServices>







</BLayout>
