---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery, RespImg } from "@/Widgets/Media";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Percent, Pixel, Size, Text } from "@/TypesLib";
import { StoneRequestBuilder } from "../../site/Widgets/Stone/StoneRequest";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام وجرانيت"
	pDescr="توريد وتركيب رخام وجرانيت للمشاريع السكنية والتجارية والصناعية، مع اختيار خامات عالية الجودة، قص وتشكيل، تركيب أرضيات وواجهات ومطابخ وحمامات ومصاعد وسلالم، تشطيب نهائي وصيانة."
>







	<Hero>

		<HzStack
			pSize={new Size(new NumPer("90%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("65%","50%"))}
			pHzAlign={"Center"}
			pBg={new ElemBg(Colors.Black)}
			pBgOpacity={new Percent(60)}
			pVrAlign={"Center"}
			pGap={new Pixel(50,20)}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("توريد وتركيب رخام وجرانيت وحجر طبيعي")}
				pText={Text.Body.Centered.White.OfText("حلول تناسب مختلف المشاريع السكنية والتجارية والصناعية، من اختيار الخامات عالية الجودة حتى التشطيب النهائي")}
			/>

			<VrStack
				pLandOnly
				pHzAlign={"Center"}
				pGap={new Pixel(30,10)}
				pSize={new Size(new NumPer("40%","95%"))}
				data-own-size
			>

				<Badge
					pLandOnly
					pQualityText="فرز أول"
					pMobMaxCols={2}
					pScopeText="القاهرة والجيزة"
					pColor="white"
				/>

			</VrStack>

			<VrStack
				pHzAlign={"Center"}
				pGap={new Pixel(30,10)}
				pSize={new Size(new NumPer("20%","95%"))}
				data-own-size
			>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</VrStack>

		</HzStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="فرز أول"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100,100))}
		/>

	</EmoSec>







	<EmoSec
		hidden
		id="secCompare"
		pBg={new ElemBg(Colors.WhiteOff,new EmoMediaData("Img","/Media/Emostone/","MarbleVsGranite.webp",true,"قطعة رخام بألوان براقة ومبهجة مع قطعة جرانيت أبيض بنقاط سوداء"))}
		pHzAlign={Align.LeftCenter}
		pVrAlign={Align.LeftCenter}
	>

		<SecTitle id="sectCompare" WhiteOff pTitle="أيهما أفضل ؟ الرخام أم الجرانيت ؟" />

		<DivStr id="strCompare">

			<DivCol />

			<DivCol>

				<DivStr>

					<DivCol>

						<RespImg pImg={new EmoMediaData("Img","/Media/Emostone","MarbleCompare.webp",false,"رخام أبيض مستورد")} />

					</DivCol>

					<DivCol>

						<Emograph
							pTitle={Text.H3.OfText("الرخام للأناقة والنعومة البصرية")}
							pText={Text.Body.OfText("يتميز الرخام بمظهره الأنيق وسطحه الناعم، ويستخدم في التصميم الداخلي والخارجي عند اختيار النوع المناسب. نوفر رخامًا مصريًا أصليًا، ورخامًا مستوردًا، وخيارات متعددة تناسب الأرضيات والحوائط والمداخل والحمامات والديكورات.")}
						/>

					</DivCol>

				</DivStr>

				<DivStr>

					<DivCol>

						<Emograph
							pTitle={Text.H3.WithAlign("right").OfText("الجرانيت للتحمل والاستخدام الخارجي")}
							pText={Text.Body.WithAlign("right").OfText("يشتهر الجرانيت بتحمله للصدمات والخدوش وملائمته للاستخدام الخارجي والواجهات. يستخدم أيضًا في المطابخ والسلالم والأرضيات عالية الحركة، مع تنوع كبير في الألوان مثل الأسود والبني والنجراني والروزا والجلاكسي.")}
						/>

					</DivCol>

					<DivCol>

						<RespImg pImg={new EmoMediaData("Img","/Media/Emostone","GranitCompare.webp",false,"جرانيت نيو حلايب")} />

					</DivCol>

				</DivStr>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		id="secMarble"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle id="sectMarble" GreenLite pTitle="أنواع الرخام المصري والمستورد" />

		<VrStack>

			<Emograph id="txtEgMarple" pTitle={Text.H3.Centered.AtRight.OfText("رخام مصري")} />

			<EmoDet pHref="/emostone/marble/eg" />

			<EmoGallery pFolder="/Media/Emostone/Marble/Eg/Samples/Raw" pSize={new Size(new NumPer("100%","100%"),new NumPer(550,600))} data-own-size />

			<Emograph id="txtImpMarple" pTitle={Text.H3.Centered.AtRight.OfText("رخام مستورد")} />

			<EmoDet pHref="/emostone/marble/imp" />

			<EmoGallery pFolder="/Media/Emostone/Marble/Imp/Samples/Raw" pSize={new Size(new NumPer("100%","100%"),new NumPer(550,600))} data-own-size />

		</VrStack>

	</EmoSec>







	<EmoSec
		id="secGranit"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle id="sectGranit" GreenLite pTitle="أنواع الجرانيت المصري والمستورد" />

		<VrStack>

			<Emograph id="txtEgMarple" pTitle={Text.H3.Centered.AtRight.OfText("جرانيت مصري")} />

			<EmoDet pHref="/emostone/granit/eg" />

			<EmoGallery pFolder="/Media/Emostone/Granit/Eg/Samples/Raw" pSize={new Size(new NumPer("100%","100%"),new NumPer(550,600))} data-own-size />

			<Emograph id="txtImpMarple" pTitle={Text.H3.Centered.AtRight.OfText("جرانيت مستورد")} />

			<EmoDet pHref="/emostone/granit/imp" />

			<EmoGallery pFolder="/Media/Emostone/Granit/Imp/Samples/Raw" pSize={new Size(new NumPer("100%","100%"),new NumPer(550,600))} data-own-size />

		</VrStack>

	</EmoSec>







</BLayout>
