---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
import { Badge, StoneProductStrip } from "../../../site/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام مصري"
	pDescr="معرض وخدمة توريد وتركيب رخام مصري، يشمل أنواع جلالة وصني وسيلفيا وسماحة وتريستا وملي جراي وغيرها، مع صور واستخدامات للأرضيات والسلالم والواجهات والحوائط والمداخل والمدافئ والمشايات وعتبات الأبواب."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب رخام مصري")}
				pText={Text.Body.Centered.OfText("رخام طبيعي للمداخل والسلالم والحوائط والأرضيات والديكورات الفاخرة")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pYearsText="سنوات الخبرة"
				pQualityText="فرز أول"
				pWorks={7}
				pWorksText="سابقة الأعمال"
				pMobMaxCols={2}
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<StoneProductStrip
		pFolder="/Media/Emostone/ProductStripSample"
		pStoneType="Marble"
		pName="جلالة روزا"
		pKind="رخام مصري طبيعي"
		pColor="وردي مائل للبيج"
		pCountry="مصر"
		pUses={["أرضيات", "حوائط", "درج", "سلالم"]}
		pSizes={["40", "60", "80", "ترابيع"]}
	/>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أنواع رخام مصري بالصور"
			pDesc="كل صورة مرتبطة باسم نوع مصري محدد من صفحات مورّدين تعرضه ضمن الرخام المصري"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/9289d4_9e45b985cf8748b5a589e2d0869fccab~mv2.png/v1/fill/w_980%2Ch_452%2Cal_c%2Cq_90%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/",
								"9289d4_9e45b985cf8748b5a589e2d0869fccab~mv2.png",
