---
import BLayout from "@/Layout.astro";
import { Badge, EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام مصري"
	pDescr="معرض وخدمة توريد وتركيب رخام مصري، يشمل أنواع جلالة وصني وسيلفيا وسماحة وتريستا وملي جراي وغيرها، مع صور واستخدامات للأرضيات والسلالم والواجهات والحوائط والمداخل والمدافئ والمشايات وعتبات الأبواب."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب رخام مصري")}
				pText={Text.Body.Centered.OfText("رخام طبيعي للمداخل والسلالم والحوائط والأرضيات والديكورات الفاخرة")}
			/>

			<Badge
				pLandOnly
				pQualityText="فرز أول"
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="فرز أول"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100,100))}
		/>

	</EmoSec>







	<EmoGallery pFolder="/Media/Emostone/Marble/Eg/Samples/Raw" />







</BLayout>
