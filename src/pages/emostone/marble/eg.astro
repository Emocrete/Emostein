							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جلالة إكسترا")}
							pText={Text.Body.Centered.OfText("لون فاتح هادئ، مناسب للأرضيات الداخلية والحوائط والمداخل الواسعة.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
