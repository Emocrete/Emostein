								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("سماحة")}
							pText={Text.Body.Centered.OfText("لون فاتح ناعم، مناسب للأرضيات الهادئة والحوائط وبعض أعمال المداخل.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

