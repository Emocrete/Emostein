							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("سيلفيا مينيا")}
							pText={Text.Body.Centered.OfText("عروق طولية هادئة، مناسب للحوائط والأرضيات التجارية والسلالم.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
