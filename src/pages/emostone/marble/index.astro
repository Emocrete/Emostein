						<Emograph
							pTitle={Text.H4.Centered.OfText("المشايات")}
							pText={Text.Body.Centered.OfText("المشايات تحتاج تشطيبًا آمنًا أقل انزلاقًا. جلالة وصني وتريستا تناسب المشايات عند اختيار سطح مطفي أو خشن حسب الموقع.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("عتبات الأبواب")}
							pText={Text.Body.Centered.OfText("العتبات تحتاج قطعًا مضبوطًا وسمكًا مناسبًا. الأسود الإسباني والإمبرادور وصني دارك يصلحون للفواصل والعتبات الواضحة.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("الحمامات")}
							pText={Text.Body.Centered.OfText("الحمامات تحتاج عزلًا وتنظيفًا مناسبًا. بيانكو وستتواريو وأونكس وسماحة وجلالة تعطي درجات فاتحة هادئة.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







