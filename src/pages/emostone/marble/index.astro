---
import BLayout from "@/Layout.astro";
import { Badge, EmoCall, Emograph, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام"
	pDescr="خدمة توريد وتركيب رخام مصري ومستورد في القاهرة والجيزة، تشمل اختيار الخامة، فرز الألواح، التقطيع، التركيب، الجلي والتلميع، وتنفيذ الأرضيات والسلالم والمداخل والحوائط والواجهات والمطابخ والحمامات والمدافئ والعتبات."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("10%","2.5%"),new NumPer("25%","13%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.OfText("توريد وتركيب رخام")} pText={Text.Body.Centered.OfText("رخام مصري ومستورد لكافة الاستخدامات والديكورات")} />

			<Badge
				pLandOnly
				pQualityText="فرز أول"
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="فرز أول"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100,100))}
		/>

	</EmoSec>







	<EmoSec
		id="secMarble"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle id="sectMarble" cBrownWhite pTitle="أنواع الرخام المصري والمستورد" />

		<DivStr>

			<DivCol>

				<Emograph
					id="txtEgMarple"
					pTitle={Text.H3.Centered.OfText("رخام مصري")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="/Media/Emostone/Marble/Eg/Samples/Raw" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("رخام مستورد")} pSize={new Size(new NumPer(200),new NumPer(30))} data-own-size />

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="/Media/Emostone/Marble/Imp/Samples/Raw" />

			</DivCol>

		</DivStr>

	</EmoSec>







</BLayout>
