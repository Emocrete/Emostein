								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جلالة إكسترا")}
							pText={Text.Body.Centered.OfText("رخام مصري فاتح للأرضيات والحوائط والمداخل الهادئة.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/9289d4_69819d592de54bd7bec159b3e00c08ea~mv2.jpg/v1/fill/w_980%2Ch_551%2Cal_c%2Cq_85%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/",
								"9289d4_69819d592de54bd7bec159b3e00c08ea~mv2.jpg",
								false,
								"صني منيا رخام مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("صني منيا")}
							pText={Text.Body.Centered.OfText("رخام مصري بيج دافئ للأرضيات والسلالم والمشايات.")}
