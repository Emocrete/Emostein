								"9289d4_b2e72d4ee1dc4356981a813806240f87~mv2.jpg",
								false,
								"ملي جراي دارك رخام مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("ملي جراي")}
							pText={Text.Body.Centered.OfText("رخام مصري رمادي للحوائط والحمامات والأرضيات ذات الطابع الحديث.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
