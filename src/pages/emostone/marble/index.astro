---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Topic, Pixel, EmoMediaData } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, CardsGr, EmoList, RespImg, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام"
	pDescr="خدمة توريد وتركيب رخام مصري ومستورد في القاهرة والجيزة، تشمل اختيار الخامة، فرز الألواح، التقطيع، التركيب، الجلي والتلميع، وتنفيذ الأرضيات والسلالم والمداخل والحوائط والواجهات والمطابخ والحمامات والمدافئ والعتبات."
>







	<Hero
		pTitle="توريد وتركيب رخام"
		pDesc="رخام مصري ومستورد لكافة الاستخدامات والديكورات"
		pAlign="center"
		pPosL="40% 50% 10% 5%"
		pPosP="10% 3% 58% 3%"
	>

		<EmoCall BlackSky pText="اطلب ترشيح خامة" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="صفحة الرخام الرئيسية"
			pDesc="اختيار الرخام يبدأ من نوع المساحة، درجة الحركة، اللون المطلوب، الميزانية، وطريقة التركيب والتشطيب"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(600, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/9289d4_44b1d60cf5f3434e83aac2def80703a3~mv2.jpg/v1/fill/w_958%2Ch_709%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/",
							"9289d4_44b1d60cf5f3434e83aac2def80703a3~mv2.jpg",
							false,
							"رخام مصري صني لايت",
							new Size(520, "auto", "100%", "auto")
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("رخام مصري")}
						pText={Text.Body.Centered.OfText("اختيار عملي ومتوفر للأرضيات والسلالم والمداخل والحوائط. من أشهر عائلاته جلالة وصني وسيلفيا وسماحة وتريستا وملي جراي، مع درجات متعددة في اللون والعروق والفرز.")}
						pSize={new Size(520, "auto", "100%", "auto")}
					/>

					<EmoCall BlackSky pText="افتح الرخام المصري" />

				</VrStack>

				<VrStack
					pWidth={new Pixel(600, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://nasar-stone.com/wp-content/uploads/2023/01/",
							"%D8%A8%D9%86%D8%AF%D8%A7-%D9%88%D8%A7%D9%8A%D8%AA.png",
							false,
							"رخام مستورد باندا وايت",
							new Size(520, "auto", "100%", "auto")
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("رخام مستورد")}
						pText={Text.Body.Centered.OfText("اختيار مناسب للحوائط الفاخرة والمداخل والحمامات والديكورات الخاصة. من أنواعه باندا وايت، أربسكاتو، ستتواريو، نيرو ماركينا، إمبرادور، أونكس، ووود فين.")}
						pSize={new Size(520, "auto", "100%", "auto")}
					/>

					<EmoCall BlackSky pText="افتح الرخام المستورد" />

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







