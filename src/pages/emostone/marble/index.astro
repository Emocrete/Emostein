		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("الأرضيات")}
							pText={Text.Body.Centered.OfText("جلالة وصني وسماحة للأرضيات الهادئة، وستتواريو وأربسكاتو للمساحات الفاخرة التي تعتمد على ألواح كبيرة وعروق واضحة.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("السلالم")}
							pText={Text.Body.Centered.OfText("صني دارك وسيلفيا وتريستا للسلالم العملية، وإمبرادور وكريما مارفيل للسلالم الداخلية ذات الطابع الدافئ.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("المداخل")}
							pText={Text.Body.Centered.OfText("المداخل تحتاج لونًا واضحًا وسطحًا سهل التنظيف. صني وجلالة للمداخل الهادئة، وباندا وايت أو نيرو ماركينا للتصميمات القوية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.GreenLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("الحوائط")}
							pText={Text.Body.Centered.OfText("الألواح ذات العروق المنتظمة تناسب الحوائط. أربسكاتو وستتواريو وباندا وايت تظهر قيمتها في البانوهات والحوائط الكبيرة.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.OrangeLite)}
					>

						<Emograph
							pTitle={Text.H4.Centered.OfText("المدافئ والدفايات")}
							pText={Text.Body.Centered.OfText("إمبرادور ونيرو ماركينا وأربسكاتو وأحمر أليكانتي تناسب إطارات المدافئ والدفايات والتفاصيل الكلاسيكية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(20, 15)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
