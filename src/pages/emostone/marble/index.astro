						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.GreenLite)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/9289d4_e9e90f3f28b447da9453f1d1d6ad5074~mv2.jpg/v1/fill/w_980%2Ch_551%2Cal_c%2Cq_85%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/",
								"9289d4_e9e90f3f28b447da9453f1d1d6ad5074~mv2.jpg",
								false,
								"سيلفيا مينيا رخام مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("سيلفيا مينيا")}
							pText={Text.Body.Centered.OfText("رخام مصري بعروق طولية للحوائط والسلالم والأرضيات التجارية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
