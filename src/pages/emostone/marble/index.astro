	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="خدمة توريد وتركيب الرخام"
			pDesc="الخدمة تجمع اختيار النوع، فرز الألواح، التقطيع، التركيب، التشطيب، والاستلام النهائي"
		/>

