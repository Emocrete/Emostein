						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://nasar-stone.com/wp-content/uploads/2023/01/",
								"%D8%A7%D8%B3%D9%88%D8%AF-%D8%A7%D8%B3%D8%A8%D8%A7%D9%86%D9%8A.png",
								false,
								"رخام مستورد أسود إسباني",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("أسود إسباني")}
							pText={Text.Body.Centered.OfText("رخام مستورد أسود بعروق بيضاء للمدافئ والعتبات والتطعيمات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
