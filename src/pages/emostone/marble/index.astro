---
import BLayout from "@/Layout.astro";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import { CardsGr, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack } from "@/Widgets";
import { Badge, DuoCol, DuoStr, StoneProductStrip } from "../../../site/Widgets";
import { EmoGallery } from "../../../site/Widgets/Media";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام"
	pDescr="خدمة توريد وتركيب رخام مصري ومستورد في القاهرة والجيزة، تشمل اختيار الخامة، فرز الألواح، التقطيع، التركيب، الجلي والتلميع، وتنفيذ الأرضيات والسلالم والمداخل والحوائط والواجهات والمطابخ والحمامات والمدافئ والعتبات."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("10%","2.5%"),new NumPer("25%","13%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب رخام")}
				pText={Text.Body.Centered.OfText("رخام مصري ومستورد لكافة الاستخدامات والديكورات")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pYearsText="سنوات الخبرة"
				pQualityText="فرز أول"
				pWorks={7}
				pWorksText="سابقة الأعمال"
				pMobMaxCols={2}
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<ESec
		id="secMarbleEgImp"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle OrangeDark pTitle="الرخام المصري والمستورد" />

		<DuoStr>

			<DuoCol>

				<Emograph
					id="txtEgMarple"
					pTitle={Text.H3.Centered.OfText("رخام مصري")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DuoCol>

			<DuoCol>

				<EmoGallery pFolder="/Media/Emostone/Marble/Eg/Samples" />

			</DuoCol>

		</DuoStr>

		<DuoStr>

			<DuoCol>

				<Emograph
					pTitle={Text.H3.Centered.OfText("رخام مستورد")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DuoCol>

			<DuoCol>

				<EmoGallery pFolder="/Media/Emostone/Marble/Imp/Samples" />

			</DuoCol>

		</DuoStr>

	</ESec>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("خدمات أخرى")}
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.Gray1)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
		pWidth={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}
		pGap={new Pixel(20, 15)}
	>

		<RelServiceItem
			pTitle="تشطيب شقق وفلل"
			pDesc="تنسيق الرخام مع الأرضيات والحوائط والسلالم والمداخل ضمن خطة التشطيب."
			pHref="/emocrete/finishing"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="اختيار خامة واجهة وأرضيات تناسب هوية المحل وحركة العملاء والتنظيف اليومي."
			pHref="/emocrete/finishing/retail"
		/>

	</RelServices>







</BLayout>
