---
import BLayout from "@/Layout.astro";
import { Badge, EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب رخام مستورد"
	pDescr="معرض وخدمة توريد وتركيب رخام مستورد في القاهرة والجيزة، يشمل أنواع باندا وايت، بيانكو، مقدوني، كلكتا، أربسكاتو، ستتواريو، نيرو ماركينا، كريما مارفيل، إمبرادور، أونيكس، وود فين، وأحمر فرنساوي، مع استخدامات للأرضيات والحوائط والمداخل والسلالم والمدافئ والديكورات."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("15%","25%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب رخام مستورد")}
				pText={Text.Body.Centered.OfText("رخام طبيعي مستورد للمداخل والسلالم والحوائط والأرضيات والديكورات الفاخرة")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pYearsText="سنوات الخبرة"
				pQualityText="فرز أول"
				pWorks={7}
				pWorksText="سابقة الأعمال"
				pMobMaxCols={2}
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<EmoGallery pFolder="/Media/Emostone/Marble/Imp/Samples/Raw" />

	<!--
	
				<StoneProductStrip
					pFolder="/Media/Emostone/ProductStripSample"
					pStoneType="Marble"
					pName="جلالة روزا"
					pKind="رخام مصري طبيعي"
					pColor="وردي مائل للبيج"
					pCountry="مصر"
					pUses={["أرضيات", "حوائط", "درج", "سلالم"]}
					pSizes={["40", "60", "80", "ترابيع"]}
				/> -->

</BLayout>
