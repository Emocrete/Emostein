---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { StoneGallery } from "@/Widgets/Stone";
import { Colors, ElemBg, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="جرانيت مصري | الأنواع والألوان والاستخدامات والتشطيبات"
	pDescr="دليل مهني للجرانيت المصري يشمل الأنواع والألوان والاستخدامات والتشطيبات والمقاسات ومعايير الفرز والتوريد والتصنيع والتركيب، مع صفحات مستقلة لخامات الجرانيت المصري."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("44%", "95%"))} pLoc={new Loc(new NumPer("53%", "2.5%"), new NumPer("18%", "9%"))} pHzAlign="Center">

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("جرانيت مصري")}
				pText={Text.Body.Centered.White.OfText("أنواع وألوان وتشطيبات الجرانيت المصري مع دليل اختيار مهني وخدمة توريد وتصنيع وتركيب للمشروعات السكنية والتجارية")}
			/>

			<Badge
				pLandOnly
				pQualityText="معاينة وفرز الخامة"
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
			/>

			<HzStack pGap={new Pixel(30, 10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="معاينة وفرز الخامة"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100, 100))}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(54, 28)} pGap={new Pixel(18, 14)}>

		<Emograph
			pTitle={Text.H2.OfText("الجرانيت المصري في المشروعات المعمارية")}
			pText={Text.Body.OfText("يمثل الجرانيت المصري مجموعة واسعة من الصخور الطبيعية المستخرجة من المحاجر المصرية، وتتنوع خاماته بين الأسود والرمادي والأحمر والوردي والأخضر والدرجات الفاتحة. يختلف كل نوع في حجم الحبيبات وتوزيع المعادن ودرجة التجانس واستجابة السطح للتشطيبات، ويرتبط الاختيار بالاستخدام والمقاس والتفاصيل المعمارية وطبيعة الحركة فوق السطح.")}
		/>

		<Emograph
			pText={Text.Body.OfText("تخدم الخامات المصرية الأرضيات والسلالم والمطابخ والكونترات والواجهات والمداخل والممرات واللاندسكيب. يرفع توافق اللون مع التصميم واستمرار شكل الحبيبات بين القطع المتجاورة واختيار التشطيب الملائم وتحديد السمك والمقاسات قبل التقطيع من كفاءة التصنيع ويضبط نسبة الهالك.")}
		/>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("اختيار الجرانيت المصري يعتمد على الاستخدام والفرز والتشطيب")}
			pText={Text.Body.White.OfText("الخامة المناسبة تجمع بين الأداء المطلوب والقراءة البصرية للمساحة. المشاريع ذات الحركة المرتفعة تستفيد من الخامات المتجانسة والتشطيبات الملائمة للاحتكاك، والمطابخ تستفيد من ألواح متقاربة مع تخطيط دقيق للفتحات والحواف، والواجهات والأعمال الخارجية ترتبط بسماكة القطع وطريقة التثبيت وملمس السطح.")}
		/>

		<EmoList
			pNumbered={false}
			pItemFnt={Text.Body.White}
			pItems={[
			"درجة اللون وتجانس الدفعة المخصصة للمشروع",
			"حجم الحبيبات واتجاه الحركة الطبيعية داخل اللوح",
			"التشطيب المصقول أو المطفي أو الملتهب أو المخشن",
			"السماكة والمقاس ونظام التثبيت وتفاصيل الحواف",
			"شكل التوريد بين الألواح والترابيع والدرج والقطع المصنعة",
		]}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(46, 24)}>

		<SecTitle pTitle="أنواع الجرانيت المصري بالصور" />

		<Emograph
			pText={Text.Body.Centered.OfText("المعرض يجمع خامات الجرانيت المصري مع البحث والفلترة والمقارنة وفحص الصور وبيانات الاستخدام والتشطيب والتوافر.")}
		/>

	</EmoSec>







	<StoneGallery pFolder="/Media/Emostone/Granit/Eg/Samples/Raw" pExcel="stones.xlsx" pRequestBuilderId="StoneOrder" />







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="اختيار الجرانيت المصري حسب الاستخدام" />

		<HzStack pGap={new Pixel(42, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("المطابخ والكونترات")}
				pNumbered={false}
				pItems={[
				"أسود أسوان وسفاجا الأبيض ونفرتاري وفيردي غزال من الخامات المناسبة للأسطح ذات الحضور البصري الواضح.",
				"اختيار اللوح يسبق تحديد أماكن الفتحات والحوض والبوتاجاز والحواف لضبط اتجاه الحبيبات واستمرارية الشكل.",
				"التشطيب المصقول يبرز اللون والبلورات ويخدم التنظيف اليومي مع معالجة حماية مناسبة للحجر الطبيعي.",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("السلالم والأرضيات")}
				pNumbered={false}
				pItems={[
				"رمادي الشركة وحلايب وجندولا وروزا النصر والخامات الحمراء تلائم المساحات المتكررة والسلالم.",
				"تجانس الدفعة وترتيب القطع قبل التركيب يحافظان على اتصال اللون والنقشة عبر البسطات والقلبات والممرات.",
				"درجة الاحتكاك المطلوبة تحدد التشطيب في المداخل والمناطق المعرضة للرطوبة والحركة الكثيفة.",
			]}
			/>

		</HzStack>

		<HzStack pGap={new Pixel(42, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الواجهات والمداخل")}
				pNumbered={false}
				pItems={[
				"رمادي الشركة وحلايب وأحمر أسوان وأحمر فرسان وأحمر سفاجا تقدم درجات مناسبة للتكوينات الخارجية.",
				"المقاسات والسماكات وطريقة التثبيت تتحدد مع تفاصيل الواجهة وحجم القطعة ومناسيب الفواصل.",
				"التشطيبات الملتهبة والمخشنة تمنح السطح قراءة حجرية واضحة وتناسب تطبيقات خارجية متعددة.",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("الممرات واللاندسكيب")}
				pNumbered={false}
				pItems={[
				"الخامات الرمادية والحمراء وفيردي الأخضر وفيردي غزال تعمل ضمن مسارات الحركة والعناصر الخارجية.",
				"تكرار المقاس وشبكة الفواصل يؤثران مباشرة في كمية التقطيع ونسبة الهالك ومظهر المسار بعد التنفيذ.",
				"السطح الخشن يضيف ملمسًا معماريًا مناسبًا للمشهد الخارجي ويرتبط بدرجة الاحتكاك المطلوبة للموقع.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="تشطيبات الجرانيت المصري" />

		<Emograph
			pText={Text.Body.Centered.OfText("التشطيب يغير اللون والملمس والانعكاس وطريقة قراءة الحبيبات، ويحدد جزءًا مهمًا من أداء السطح في الداخل والخارج.")}
		/>

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيب")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("الطابع البصري")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("الاستخدامات الشائعة")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("مصقول")} />

				<EmoTableCell pText={Text.Body.OfText("لون أعمق ولمعة أوضح وإظهار أعلى للبلورات والحبيبات")} />

				<EmoTableCell pText={Text.Body.OfText("المطابخ والكونترات والأرضيات والحوائط والسلالم الداخلية")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("مطفي")} />

				<EmoTableCell pText={Text.Body.OfText("انعكاس هادئ وقراءة متزنة للون الطبيعي")} />

				<EmoTableCell pText={Text.Body.OfText("الأرضيات والحوائط والتصميمات المعاصرة ذات اللمعة المحدودة")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("ملتهب")} />

				<EmoTableCell pText={Text.Body.OfText("ملمس خشن وحضور حجري قوي مع تدرج أكثر هدوءًا للون")} />

				<EmoTableCell pText={Text.Body.OfText("المداخل والواجهات والممرات والسلالم والأرضيات الخارجية")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("مخشن")} />

				<EmoTableCell pText={Text.Body.OfText("سطح واضح الملمس يبرز الطبيعة الصخرية للخامة")} />

				<EmoTableCell pText={Text.Body.OfText("اللاندسكيب والأرصفة والواجهات والعناصر الخارجية ذات الحركة")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("المقاسات والسماكات وأشكال التوريد")}
			pText={Text.Body.White.OfText("يتداول الجرانيت المصري في صورة ألواح وترابيع ودرج وقوائم وقطع مصنعة حسب المقاس. السماكات الشائعة في أعمال التشطيب تشمل 2 و3 سم، ويحدد السمك النهائي وفق أبعاد القطعة ونوع الاستخدام وطريقة التثبيت والتفاصيل الإنشائية والمعمارية المرتبطة بها.")}
		/>

		<EmoList
			pNumbered={false}
			pItemFnt={Text.Body.White}
			pItems={[
			"الألواح تخدم المطابخ والكونترات والحوائط والقطع الكبيرة وتسمح بتخطيط اتجاه النقشة قبل التصنيع.",
			"الترابيع تخدم الأرضيات والممرات وتستفيد من شبكة مقاسات ثابتة تضبط الفواصل والهالك.",
			"الدرج والقوائم تحتاج توحيد السمك والحافة وتقارب اللون بين القطع المتتابعة.",
			"القطع حسب المقاس تخدم الواجهات والعتبات والحليات والتفاصيل الخاصة بالمشروع.",
		]}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(62, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="فرز الجرانيت المصري ومعاينة الدفعة" />

		<Emograph
			pText={Text.Body.OfText("الفرز المهني يبدأ بمشاهدة مساحة كافية من الخامة، ثم مقارنة درجة اللون وحجم الحبيبات وتوزيع البلورات بين الألواح المخصصة للمشروع. المساحات الكبيرة والسلالم والواجهات تستفيد من حجز كمية متقاربة تغطي الأعمال الأساسية والهالك المتوقع، مع ترتيب القطع قبل التقطيع والتركيب عند تأثير اتجاه النقشة في التصميم.")}
		/>

		<HzStack pGap={new Pixel(42, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("معايير الخامة")}
				pNumbered={false}
				pItems={["تقارب اللون داخل كمية المشروع", "انتظام الحبيبات أو توافق الحركة الطبيعية مع التصميم", "سلامة السطح والحواف وجودة الصقل أو التشطيب", "تخطيط اتجاه الألواح في القطع المتجاورة"]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("معايير التصنيع")}
				pNumbered={false}
				pItems={["تثبيت المقاسات الفعلية قبل أمر التقطيع", "حصر الفتحات والحواف والتقفيلات في المطابخ والكونترات", "تنسيق السمك مع نظام التثبيت وطول القطعة", "تجميع القطع المتكررة بما يحقق أعلى استفادة من اللوح"]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="سعر الجرانيت المصري وتكلفة التنفيذ" />

		<Emograph
			pText={Text.Body.OfText("قيمة الجرانيت داخل المشروع ترتبط باسم الخامة ودرجة الفرز والسمك والمقاس والتشطيب وشكل التوريد وكمية الهالك وأعمال التقطيع والحواف والفتحات والنقل والتركيب والجلي. تسعير المتر يصبح أدق بعد تحديد بند الاستخدام ومقاسات القطع وكمية المشروع وطبيعة التشطيب، لأن الخامة الواحدة تنتج تكلفة مختلفة بين الأرضيات والسلالم والواجهات والكونترات المصنعة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("الجاليري يتيح تكوين قائمة خامات قصيرة ومقارنتها قبل طلب السعر، وتساعد بيانات المشروع على توجيه التسعير نحو الخامة والتشطيب والمقاسات المرتبطة بالتنفيذ الفعلي.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="دليل خامات الجرانيت المصري" />

		<Emograph
			pText={Text.Body.Centered.OfText("لكل خامة صفحة مستقلة تجمع اللون والحبيبات والاستخدامات والتشطيبات وأشكال التوريد ومعايير الفرز والتصنيع والصيانة.")}
		/>

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="جرانيت أسود أسوان" pHref="/emostone/granit/eg/black-aswan" />

			<EmoDet Light pText="جرانيت جندولا" pHref="/emostone/granit/eg/gandola" />

			<EmoDet Light pText="جرانيت فيردي أخضر" pHref="/emostone/granit/eg/green-verdi" />

			<EmoDet Light pText="جرانيت رمادي الشركة" pHref="/emostone/granit/eg/grey-sherka" />

		</HzStack>

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="جرانيت حلايب" pHref="/emostone/granit/eg/halayeb" />

			<EmoDet Light pText="جرانيت أحمر أسوان" pHref="/emostone/granit/eg/red-aswan" />

			<EmoDet Light pText="جرانيت أحمر فرسان" pHref="/emostone/granit/eg/red-fersan" />

			<EmoDet Light pText="جرانيت أحمر نفرتاري" pHref="/emostone/granit/eg/red-nefertary" />

		</HzStack>

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="جرانيت رويال أحمر" pHref="/emostone/granit/eg/red-royal" />

			<EmoDet Light pText="جرانيت أحمر سفاجا" pHref="/emostone/granit/eg/red-safaga" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

			<EmoDet Light pText="جرانيت سفاجا أبيض" pHref="/emostone/granit/eg/white-safaga" />

			<EmoDet Light pText="جرانيت فيردي غزال أصفر" pHref="/emostone/granit/eg/yellow-verdi-gazal" />

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("التوريد والتصنيع والتركيب في القاهرة والجيزة")}
			pText={Text.Body.White.OfText("تنفيذ أعمال الجرانيت يبدأ بتثبيت الخامة والفرز والمقاسات والتشطيب، ثم إعداد القطع وفق الرسومات أو الرفع الفعلي للموقع، وتجهيز الحواف والفتحات والتقفيلات، ونقل الخامة وتركيبها وفق طبيعة البند. السلالم والمطابخ والواجهات تحتاج تنسيقًا مبكرًا بين القياسات والتقطيع وترتيب الألواح لتحقيق نتيجة متجانسة وتقليل الهالك.")}
		/>

		<HzStack pGap={new Pixel(30, 12)} pHzAlign="Center">

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</AngleBand>







</BLayout>
