---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت فيردي أخضر | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت فيردي أخضر من الجرانيت المصري الطبيعي بدرجة أخضر زيتوني. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Green_Verdy.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت فيردي أخضر")}
			pText={Text.Body.OfText("جرانيت مصري بدرجات خضراء زيتونية وتكوين بلوري غني، ويخدم التصميمات التي تعتمد على لون حجري طبيعي واضح. اللون العام أخضر زيتوني، ويظهر السطح بتكوين بلورات خضراء وفاتحة مع نقاط معدنية داكنة وتفاوت طبيعي.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Green_Verdy.webp",
			NameAr: "جرانيت فيردي أخضر",
			Alt: "جرانيت فيردي أخضر مصري بدرجات خضراء وبلورات معدنية طبيعية",
			Use: "الأرضيات، الواجهات، السلالم، الكونترات، الحوائط، العناصر الديكورية",
		}]}
		pName="جرانيت فيردي أخضر"
		pKind="جرانيت مصري طبيعي"
		pColor="أخضر زيتوني"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"الواجهات",
			"السلالم",
			"الكونترات",
			"الحوائط",
			"العناصر الديكورية",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري بدرجات خضراء زيتونية وتكوين بلوري غني، ويخدم التصميمات التي تعتمد على لون حجري طبيعي واضح.", "يظهر فيردي الأخضر بمزيج من البلورات الخضراء والفاتحة مع نقاط داكنة، وتمنح هذه البنية السطح عمقًا بصريًا يتغير مع الإضاءة وحجم القطعة. الصقل يزيد وضوح البلورات، والتشطيب المطفي يهدئ التباين بين مكونات الخامة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت فيردي أخضر"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت فيردي أخضر" />

		<Emograph
			pText={Text.Body.OfText("يظهر فيردي الأخضر بمزيج من البلورات الخضراء والفاتحة مع نقاط داكنة، وتمنح هذه البنية السطح عمقًا بصريًا يتغير مع الإضاءة وحجم القطعة. الصقل يزيد وضوح البلورات، والتشطيب المطفي يهدئ التباين بين مكونات الخامة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يندمج اللون الأخضر مع الأخشاب الطبيعية والنحاس والبرونز والدرجات الرملية. استخدامه كأرضية كاملة ينتج هوية قوية للمكان، كما يعمل بفاعلية في الكونترات والكسوات كنقطة لونية مركزية داخل تكوين محايد.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت فيردي أخضر" />

		<Emograph
			pText={Text.Body.OfText("تتوزع تطبيقاته بين الأرضيات والسلالم والواجهات والحوائط والكونترات والعناصر الديكورية. اختيار التشطيب يرتبط بموقع الاستخدام؛ الأسطح الداخلية تستفيد من المصقول والمطفي، والأعمال الخارجية تستفيد من الملمس الخشن.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"الواجهات",
				"السلالم",
				"الكونترات",
				"الحوائط",
				"العناصر الديكورية",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت فيردي أخضر داخل التصميم")}
			pText={Text.Body.White.OfText("يندمج اللون الأخضر مع الأخشاب الطبيعية والنحاس والبرونز والدرجات الرملية. استخدامه كأرضية كاملة ينتج هوية قوية للمكان، كما يعمل بفاعلية في الكونترات والكسوات كنقطة لونية مركزية داخل تكوين محايد.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة بلورات خضراء وفاتحة مع نقاط معدنية داكنة وتفاوت طبيعي. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت فيردي أخضر للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أخضر زيتوني")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("بلورات خضراء وفاتحة مع نقاط معدنية داكنة وتفاوت طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت فيردي أخضر" />

		<Emograph
			pText={Text.Body.OfText("المعاينة المهنية تركز على درجة الأخضر ونسبة البلورات الفاتحة والداكنة، ثم تجمع القطع المتجاورة ضمن نطاق لوني متقارب. هذا الإجراء يرفع جودة القراءة النهائية للحوائط والأرضيات الكبيرة.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أخضر زيتوني على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة بلورات خضراء وفاتحة مع نقاط معدنية داكنة وتفاوت طبيعي وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت فيردي أخضر")}
			pText={Text.Body.White.OfText("يتداول فيردي الأخضر في صورة ألواح وترابيع وقطع مصنعة للمطابخ والسلالم والكسوات. السماكة والمقاس يتحددان وفق أبعاد العنصر ونظام التثبيت وطبيعة الحواف والتفاصيل المطلوبة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت فيردي أخضر" />

		<Emograph
			pText={Text.Body.OfText("التنظيف بمواد متعادلة يدعم ثبات اللمعة والمظهر، وتفيد طبقات الحماية المخصصة للحجر الطبيعي في أسطح العمل والمناطق المعرضة للبقع.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت فيردي أخضر داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت فيردي أخضر يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، الواجهات، السلالم، الكونترات، الحوائط، العناصر الديكورية يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت فيردي غزال أصفر" pHref="/emostone/granit/eg/yellow-verdi-gazal" />

			<EmoDet Light pText="جرانيت أسود أسوان" pHref="/emostone/granit/eg/black-aswan" />

			<EmoDet Light pText="جرانيت جندولا" pHref="/emostone/granit/eg/gandola" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

		</HzStack>

	</EmoSec>







</BLayout>
