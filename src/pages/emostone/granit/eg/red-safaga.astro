---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت أحمر سفاجا | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت أحمر سفاجا من الجرانيت المصري الطبيعي بدرجة أحمر مائل للبني. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Safaga.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت أحمر سفاجا")}
			pText={Text.Body.OfText("جرانيت مصري أحمر بني بدرجة دافئة، ويخدم الأرضيات والواجهات والسلالم والممرات ذات الاستخدام الداخلي والخارجي. اللون العام أحمر مائل للبني، ويظهر السطح بتكوين حبيبات متوسطة حمراء وبنية مع نقاط رمادية وسوداء.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Safaga.webp",
			NameAr: "جرانيت أحمر سفاجا",
			Alt: "جرانيت أحمر سفاجا المصري بدرجة حمراء بنية وحبيبات معدنية طبيعية",
			Use: "الأرضيات، الواجهات، السلالم، الممرات، اللاندسكيب، الأعمال الخارجية",
		}]}
		pName="جرانيت أحمر سفاجا"
		pKind="جرانيت مصري طبيعي"
		pColor="أحمر مائل للبني"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"الواجهات",
			"السلالم",
			"الممرات",
			"اللاندسكيب",
			"الأعمال الخارجية",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري أحمر بني بدرجة دافئة، ويخدم الأرضيات والواجهات والسلالم والممرات ذات الاستخدام الداخلي والخارجي.", "يجمع أحمر سفاجا الأحمر والبني في سطح حبيبي متقارب، فيعطي لونًا دافئًا أقل حدة من الأحمر الصريح. التشطيبات الخشنة تضيف طابعًا حجريًا يناسب المساحات الخارجية واللاندسكيب."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت أحمر سفاجا"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت أحمر سفاجا" />

		<Emograph
			pText={Text.Body.OfText("يجمع أحمر سفاجا الأحمر والبني في سطح حبيبي متقارب، فيعطي لونًا دافئًا أقل حدة من الأحمر الصريح. التشطيبات الخشنة تضيف طابعًا حجريًا يناسب المساحات الخارجية واللاندسكيب.")}
		/>

		<Emograph
			pText={Text.Body.OfText("تنسجم الدرجة البنية الحمراء مع الحجر الرملي والبيج والأخشاب والواجهات الترابية. الممرات الخارجية والبسطات والسلالم تستفيد من اللون الذي يحتفظ بحضوره وسط مواد الموقع الطبيعية.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت أحمر سفاجا" />

		<Emograph
			pText={Text.Body.OfText("يناسب الأرضيات والواجهات والسلالم والممرات واللاندسكيب والمشروعات الخارجية. يمكن استخدامه في الداخل بالتشطيب المصقول عندما يحتاج التصميم إلى أرضية أو عنصر بلون دافئ.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"الواجهات",
				"السلالم",
				"الممرات",
				"اللاندسكيب",
				"الأعمال الخارجية",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت أحمر سفاجا داخل التصميم")}
			pText={Text.Body.White.OfText("تنسجم الدرجة البنية الحمراء مع الحجر الرملي والبيج والأخشاب والواجهات الترابية. الممرات الخارجية والبسطات والسلالم تستفيد من اللون الذي يحتفظ بحضوره وسط مواد الموقع الطبيعية.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة حبيبات متوسطة حمراء وبنية مع نقاط رمادية وسوداء. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت أحمر سفاجا للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أحمر مائل للبني")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("حبيبات متوسطة حمراء وبنية مع نقاط رمادية وسوداء")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت أحمر سفاجا" />

		<Emograph
			pText={Text.Body.OfText("تتم المعاينة على أساس درجة البني داخل الأحمر وكثافة المكونات الرمادية والسوداء. الكميات المخصصة للممرات والواجهات تحتاج تجميعًا متقاربًا لتجنب قفزات لونية بين القطع المتتابعة.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أحمر مائل للبني على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة حبيبات متوسطة حمراء وبنية مع نقاط رمادية وسوداء وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت أحمر سفاجا")}
			pText={Text.Body.White.OfText("يتوفر في ترابيع ودرج وقوائم وألواح وقطع خارجية مصنعة. تصميم المقاسات المتكررة قبل أمر التوريد يحسن الاستفادة من الخامة ويضبط الفواصل.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت أحمر سفاجا" />

		<Emograph
			pText={Text.Body.OfText("الأسطح الخارجية تستفيد من تنظيف منتظم للرواسب والأتربة، والأسطح المصقولة تعتمد على منظفات متعادلة وعناية دورية بالحواف والفواصل.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت أحمر سفاجا داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت أحمر سفاجا يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، الواجهات، السلالم، الممرات، اللاندسكيب، الأعمال الخارجية يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت أحمر فرسان" pHref="/emostone/granit/eg/red-fersan" />

			<EmoDet Light pText="جرانيت أحمر أسوان" pHref="/emostone/granit/eg/red-aswan" />

			<EmoDet Light pText="جرانيت رويال أحمر" pHref="/emostone/granit/eg/red-royal" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

		</HzStack>

	</EmoSec>







</BLayout>
