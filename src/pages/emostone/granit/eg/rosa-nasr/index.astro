---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت روزا النصر | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت روزا النصر من الجرانيت المصري الطبيعي بدرجة وردي روزا. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Rosa_Nasr.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت روزا النصر")}
			pText={Text.Body.OfText("جرانيت مصري وردي دافئ ذو حبيبات متوازنة، ويمنح الأرضيات والمداخل والسلالم مظهرًا مرحبًا مع متانة الجرانيت. اللون العام وردي روزا، ويظهر السطح بتكوين خلفية وردية دافئة مع حبيبات رمادية وبيضاء ونبيتي.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Rosa_Nasr.webp",
			NameAr: "جرانيت روزا النصر",
			Alt: "جرانيت روزا النصر المصري بخلفية وردية وحبيبات رمادية وبيضاء",
			Use: "الأرضيات، السلالم، المداخل، الممرات، الحوائط، المشروعات التجارية",
		}]}
		pName="جرانيت روزا النصر"
		pKind="جرانيت مصري طبيعي"
		pColor="وردي روزا"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"السلالم",
			"المداخل",
			"الممرات",
			"الحوائط",
			"المشروعات التجارية",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري وردي دافئ ذو حبيبات متوازنة، ويمنح الأرضيات والمداخل والسلالم مظهرًا مرحبًا مع متانة الجرانيت.", "تظهر روزا النصر بخلفية وردية تتخللها حبيبات فاتحة ورمادية ونبيتي، ويعطي هذا المزيج سطحًا دافئًا متوازنًا. التشطيب المصقول يزيد وضوح البلورات، بينما يقدم المطفي قراءة أكثر هدوءًا للمساحات الواسعة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت روزا النصر"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت روزا النصر" />

		<Emograph
			pText={Text.Body.OfText("تظهر روزا النصر بخلفية وردية تتخللها حبيبات فاتحة ورمادية ونبيتي، ويعطي هذا المزيج سطحًا دافئًا متوازنًا. التشطيب المصقول يزيد وضوح البلورات، بينما يقدم المطفي قراءة أكثر هدوءًا للمساحات الواسعة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يناسب المداخل والأرضيات والسلالم التي تستهدف درجات دافئة، ويتكامل مع البيج والخشب والبرونز والأبيض المكسور. المساحات التجارية تستفيد من اللون في تكوين أرضيات واضحة الهوية وسهلة الدمج مع أثاث متعدد الدرجات.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت روزا النصر" />

		<Emograph
			pText={Text.Body.OfText("يستخدم في الأرضيات والحوائط والسلالم والمداخل والممرات والمشروعات التجارية. بعض التطبيقات الخارجية تستفيد من التشطيبات الخشنة عندما يتوافق اللون مع لغة الموقع والواجهة.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"السلالم",
				"المداخل",
				"الممرات",
				"الحوائط",
				"المشروعات التجارية",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت روزا النصر داخل التصميم")}
			pText={Text.Body.White.OfText("يناسب المداخل والأرضيات والسلالم التي تستهدف درجات دافئة، ويتكامل مع البيج والخشب والبرونز والأبيض المكسور. المساحات التجارية تستفيد من اللون في تكوين أرضيات واضحة الهوية وسهلة الدمج مع أثاث متعدد الدرجات.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة خلفية وردية دافئة مع حبيبات رمادية وبيضاء ونبيتي. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت روزا النصر للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("وردي روزا")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("خلفية وردية دافئة مع حبيبات رمادية وبيضاء ونبيتي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت روزا النصر" />

		<Emograph
			pText={Text.Body.OfText("يركز الفرز على درجة الوردي ونسبة الحبيبات البيضاء والرمادية وتوزيعها. تجميع البلاطات قبل التركيب يساعد على توزيع الفروق الطبيعية بالتساوي عبر المسطح.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة وردي روزا على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة خلفية وردية دافئة مع حبيبات رمادية وبيضاء ونبيتي وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت روزا النصر")}
			pText={Text.Body.White.OfText("يتوفر في ألواح وترابيع ودرج وقوائم وقطع حسب المقاس. التخطيط المسبق لشبكة الأرضيات وأبعاد الدرج يدعم كفاءة التقطيع وتناسق اتجاه القطع.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت روزا النصر" />

		<Emograph
			pText={Text.Body.OfText("تدعم المنظفات المتعادلة ثبات لون السطح، وتفيد أعمال الجلي الدورية في الأرضيات التجارية والسلالم مع ارتفاع معدلات الحركة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت روزا النصر داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت روزا النصر يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، السلالم، المداخل، الممرات، الحوائط، المشروعات التجارية يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت جندولا" pHref="/emostone/granit/eg/gandola" />

			<EmoDet Light pText="جرانيت أحمر أسوان" pHref="/emostone/granit/eg/red-aswan" />

			<EmoDet Light pText="جرانيت رويال أحمر" pHref="/emostone/granit/eg/red-royal" />

			<EmoDet Light pText="جرانيت سفاجا أبيض" pHref="/emostone/granit/eg/white-safaga" />

		</HzStack>

	</EmoSec>







</BLayout>
