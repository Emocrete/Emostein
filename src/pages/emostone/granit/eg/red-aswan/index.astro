---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت أحمر أسوان | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت أحمر أسوان من الجرانيت المصري الطبيعي بدرجة أحمر دافئ مائل للوردي. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Aswan.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت أحمر أسوان")}
			pText={Text.Body.OfText("جرانيت أسواني أحمر ذو تركيب بلوري واضح وهوية مصرية قوية، ويجمع القيمة البصرية مع التحمل في التطبيقات المعمارية. اللون العام أحمر دافئ مائل للوردي، ويظهر السطح بتكوين بلورات فلسبار حمراء ووردية كبيرة مع كوارتز ومعادن داكنة.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Aswan.webp",
			NameAr: "جرانيت أحمر أسوان",
			Alt: "جرانيت أحمر أسوان المصري بحبيبات بلورية حمراء ووردية واضحة",
			Use: "الأرضيات، السلالم، الواجهات، المداخل، اللاندسكيب، الأعمال التذكارية",
		}]}
		pName="جرانيت أحمر أسوان"
		pKind="جرانيت مصري طبيعي"
		pColor="أحمر دافئ مائل للوردي"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"السلالم",
			"الواجهات",
			"المداخل",
			"اللاندسكيب",
			"الأعمال التذكارية",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت أسواني أحمر ذو تركيب بلوري واضح وهوية مصرية قوية، ويجمع القيمة البصرية مع التحمل في التطبيقات المعمارية.", "تظهر بلورات الفلسبار الحمراء والوردية بحجم واضح داخل كتلة معدنية تجمع الكوارتز والمكونات الداكنة. النتيجة سطح غني بالتفاصيل وقابل للقراءة على الألواح الكبيرة والقطع المعمارية الثقيلة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت أحمر أسوان"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت أحمر أسوان" />

		<Emograph
			pText={Text.Body.OfText("تظهر بلورات الفلسبار الحمراء والوردية بحجم واضح داخل كتلة معدنية تجمع الكوارتز والمكونات الداكنة. النتيجة سطح غني بالتفاصيل وقابل للقراءة على الألواح الكبيرة والقطع المعمارية الثقيلة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يتناسب أحمر أسوان مع المباني ذات الطابع المؤسسي والتذكاري والمداخل والسلالم التي تحتاج مادة ذات حضور قوي. الدرجات الرملية والبيج والبرونزية تصنع معه تركيبات دافئة، بينما يعطي الأسود تباينًا أكثر حدة.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت أحمر أسوان" />

		<Emograph
			pText={Text.Body.OfText("يستخدم في الأرضيات والسلالم والواجهات والمداخل واللاندسكيب والأعمال التذكارية. التشطيبات الخشنة تبرز الطبيعة الحجرية في الخارج، والمصقول يرفع تشبع اللون في المساحات الداخلية.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"السلالم",
				"الواجهات",
				"المداخل",
				"اللاندسكيب",
				"الأعمال التذكارية",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت أحمر أسوان داخل التصميم")}
			pText={Text.Body.White.OfText("يتناسب أحمر أسوان مع المباني ذات الطابع المؤسسي والتذكاري والمداخل والسلالم التي تحتاج مادة ذات حضور قوي. الدرجات الرملية والبيج والبرونزية تصنع معه تركيبات دافئة، بينما يعطي الأسود تباينًا أكثر حدة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة بلورات فلسبار حمراء ووردية كبيرة مع كوارتز ومعادن داكنة. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت أحمر أسوان للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أحمر دافئ مائل للوردي")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("بلورات فلسبار حمراء ووردية كبيرة مع كوارتز ومعادن داكنة")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت أحمر أسوان" />

		<Emograph
			pText={Text.Body.OfText("المعاينة تركز على درجة الأحمر وحجم البلورات وتوزيعها، ثم على تقارب الألواح داخل العنصر الواحد. اختيار اتجاه القطع يؤثر في توزيع الكتل اللونية على الدرج والكسوات الطويلة.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أحمر دافئ مائل للوردي على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة بلورات فلسبار حمراء ووردية كبيرة مع كوارتز ومعادن داكنة وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت أحمر أسوان")}
			pText={Text.Body.White.OfText("يتوفر في ألواح وترابيع ودرج وقوائم وقطع خاصة للعناصر المعمارية. القطع الكبيرة تستدعي تنسيق السمك وأسلوب التثبيت مع الأحمال والمقاسات التنفيذية.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت أحمر أسوان" />

		<Emograph
			pText={Text.Body.OfText("التنظيف المعتدل يحافظ على لمعان السطح، وتفيد أعمال الجلي والصيانة الدورية في الأرضيات ذات الحركة الكثيفة. معالجة الحواف والفواصل الجيدة ترفع جودة المشهد النهائي.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت أحمر أسوان داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت أحمر أسوان يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، السلالم، الواجهات، المداخل، اللاندسكيب، الأعمال التذكارية يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت أحمر فرسان" pHref="/emostone/granit/eg/red-fersan" />

			<EmoDet Light pText="جرانيت رويال أحمر" pHref="/emostone/granit/eg/red-royal" />

			<EmoDet Light pText="جرانيت أحمر سفاجا" pHref="/emostone/granit/eg/red-safaga" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

		</HzStack>

	</EmoSec>







</BLayout>
