---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت فيردي غزال أصفر | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت فيردي غزال أصفر من الجرانيت المصري الطبيعي بدرجة أصفر مخضر وزيتوني. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Yellow_Verdy_Gazal.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت فيردي غزال أصفر")}
			pText={Text.Body.OfText("جرانيت مصري بدرجات صفراء زيتونية وخضراء وتكوين بلوري غني، ويقدم حلًا لونيًا مميزًا للكونترات والأرضيات والواجهات. اللون العام أصفر مخضر وزيتوني، ويظهر السطح بتكوين بلورات صفراء زيتونية داخل أرضية خضراء مع مكونات داكنة.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Yellow_Verdy_Gazal.webp",
			NameAr: "جرانيت فيردي غزال أصفر",
			Alt: "جرانيت فيردي غزال أصفر المصري بدرجات صفراء زيتونية وخضراء",
			Use: "المطابخ والكونترات، الأرضيات، السلالم، الواجهات، الحوائط، اللاندسكيب",
		}]}
		pName="جرانيت فيردي غزال أصفر"
		pKind="جرانيت مصري طبيعي"
		pColor="أصفر مخضر وزيتوني"
		pCountry="مصر"
		pUses={[
			"المطابخ والكونترات",
			"الأرضيات",
			"السلالم",
			"الواجهات",
			"الحوائط",
			"اللاندسكيب",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري بدرجات صفراء زيتونية وخضراء وتكوين بلوري غني، ويقدم حلًا لونيًا مميزًا للكونترات والأرضيات والواجهات.", "يحتوي فيردي غزال الأصفر على بلورات كبيرة نسبيًا بدرجات صفراء وزيتونية داخل أرضية خضراء مع مكونات داكنة، ولذلك يظهر كخامة ذات حركة معدنية واضحة. الألواح الكبيرة تمنح هذا التكوين مساحة كافية للظهور بصورة متوازنة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت فيردي غزال أصفر"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت فيردي غزال أصفر" />

		<Emograph
			pText={Text.Body.OfText("يحتوي فيردي غزال الأصفر على بلورات كبيرة نسبيًا بدرجات صفراء وزيتونية داخل أرضية خضراء مع مكونات داكنة، ولذلك يظهر كخامة ذات حركة معدنية واضحة. الألواح الكبيرة تمنح هذا التكوين مساحة كافية للظهور بصورة متوازنة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يتوافق مع الأخشاب الداكنة والبرونز والبيج والأخضر الهادئ. يعمل كعنصر لوني رئيسي في الكونترات والحوائط، كما يضيف للأرضيات والواجهات طابعًا طبيعيًا غنيًا قريبًا من ألوان الصخور والمعادن.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت فيردي غزال أصفر" />

		<Emograph
			pText={Text.Body.OfText("تغطي تطبيقاته المطابخ والكونترات والأرضيات والحوائط والسلالم والواجهات واللاندسكيب. التشطيب المصقول يعزز الثراء المعدني، والتشطيبات الخشنة تربط الخامة بصورة أقوى بالمشاهد الخارجية.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"المطابخ والكونترات",
				"الأرضيات",
				"السلالم",
				"الواجهات",
				"الحوائط",
				"اللاندسكيب",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت فيردي غزال أصفر داخل التصميم")}
			pText={Text.Body.White.OfText("يتوافق مع الأخشاب الداكنة والبرونز والبيج والأخضر الهادئ. يعمل كعنصر لوني رئيسي في الكونترات والحوائط، كما يضيف للأرضيات والواجهات طابعًا طبيعيًا غنيًا قريبًا من ألوان الصخور والمعادن.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة بلورات صفراء زيتونية داخل أرضية خضراء مع مكونات داكنة. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت فيردي غزال أصفر للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أصفر مخضر وزيتوني")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("بلورات صفراء زيتونية داخل أرضية خضراء مع مكونات داكنة")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت فيردي غزال أصفر" />

		<Emograph
			pText={Text.Body.OfText("المعاينة تعتمد على توزيع البلورات الكبيرة وتقارب درجات الأصفر والأخضر بين الألواح. تخطيط أماكن القطع قبل التصنيع يفيد الكونترات والحوائط التي تحتاج استمرارية للحركة المعدنية.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أصفر مخضر وزيتوني على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة بلورات صفراء زيتونية داخل أرضية خضراء مع مكونات داكنة وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت فيردي غزال أصفر")}
			pText={Text.Body.White.OfText("يتوفر في ألواح وقطع مصنعة وترابيع ودرج وقوائم. الأعمال ذات التفاصيل الخاصة تحتاج حصرًا دقيقًا للحواف والفتحات واتجاه القطع قبل التصنيع.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت فيردي غزال أصفر" />

		<Emograph
			pText={Text.Body.OfText("التنظيف المتعادل يحافظ على عمق اللون واللمعة، وتفيد الحماية المناسبة للحجر الطبيعي في أسطح العمل والمناطق المعرضة للبقع.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت فيردي غزال أصفر داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت فيردي غزال أصفر يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين المطابخ والكونترات، الأرضيات، السلالم، الواجهات، الحوائط، اللاندسكيب يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت فيردي أخضر" pHref="/emostone/granit/eg/green-verdi" />

			<EmoDet Light pText="جرانيت جندولا" pHref="/emostone/granit/eg/gandola" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

			<EmoDet Light pText="جرانيت أسود أسوان" pHref="/emostone/granit/eg/black-aswan" />

		</HzStack>

	</EmoSec>







</BLayout>
