---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت سفاجا أبيض | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت سفاجا أبيض من الجرانيت المصري الطبيعي بدرجة أبيض رمادي فاتح. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_White_Safaga.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت سفاجا أبيض")}
			pText={Text.Body.OfText("جرانيت مصري فاتح بحبيبات دقيقة، ويخدم التصميمات الحديثة التي تحتاج سطحًا هادئًا ومتزنًا للمطابخ والأرضيات والكسوات. اللون العام أبيض رمادي فاتح، ويظهر السطح بتكوين حبيبات دقيقة ومتجانسة بالرمادي والأبيض والفضي.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_White_Safaga.webp",
			NameAr: "جرانيت سفاجا أبيض",
			Alt: "جرانيت سفاجا أبيض المصري بدرجة رمادية بيضاء وحبيبات دقيقة متجانسة",
			Use: "المطابخ والكونترات، الأرضيات، السلالم، الحوائط، الواجهات، المداخل",
		}]}
		pName="جرانيت سفاجا أبيض"
		pKind="جرانيت مصري طبيعي"
		pColor="أبيض رمادي فاتح"
		pCountry="مصر"
		pUses={[
			"المطابخ والكونترات",
			"الأرضيات",
			"السلالم",
			"الحوائط",
			"الواجهات",
			"المداخل",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري فاتح بحبيبات دقيقة، ويخدم التصميمات الحديثة التي تحتاج سطحًا هادئًا ومتزنًا للمطابخ والأرضيات والكسوات.", "تتقارب الحبيبات الرمادية والبيضاء والفضية داخل خلفية فاتحة، فيظهر السطح منتظمًا ومناسبًا للمساحات التي تعتمد على البساطة البصرية. الصقل يبرز البلورات الدقيقة ويمنح الكونترات والأرضيات مظهرًا أكثر صفاءً."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت سفاجا أبيض"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت سفاجا أبيض" />

		<Emograph
			pText={Text.Body.OfText("تتقارب الحبيبات الرمادية والبيضاء والفضية داخل خلفية فاتحة، فيظهر السطح منتظمًا ومناسبًا للمساحات التي تعتمد على البساطة البصرية. الصقل يبرز البلورات الدقيقة ويمنح الكونترات والأرضيات مظهرًا أكثر صفاءً.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يتكامل سفاجا الأبيض مع المطابخ الحديثة والخشب الطبيعي والألوان الداكنة التي تحتاج خلفية فاتحة. استخدامه في السلالم والأرضيات يرفع الإضاءة البصرية للمكان، كما يعمل في الواجهات ذات التكوينات الرمادية والبيضاء.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت سفاجا أبيض" />

		<Emograph
			pText={Text.Body.OfText("يناسب المطابخ والكونترات والأرضيات والسلالم والحوائط والواجهات والمداخل. التشطيب المصقول يخدم التطبيقات الداخلية، بينما تعمل الأسطح الخشنة في مناطق الحركة الخارجية.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"المطابخ والكونترات",
				"الأرضيات",
				"السلالم",
				"الحوائط",
				"الواجهات",
				"المداخل",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت سفاجا أبيض داخل التصميم")}
			pText={Text.Body.White.OfText("يتكامل سفاجا الأبيض مع المطابخ الحديثة والخشب الطبيعي والألوان الداكنة التي تحتاج خلفية فاتحة. استخدامه في السلالم والأرضيات يرفع الإضاءة البصرية للمكان، كما يعمل في الواجهات ذات التكوينات الرمادية والبيضاء.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة حبيبات دقيقة ومتجانسة بالرمادي والأبيض والفضي. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت سفاجا أبيض للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أبيض رمادي فاتح")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("حبيبات دقيقة ومتجانسة بالرمادي والأبيض والفضي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت سفاجا أبيض" />

		<Emograph
			pText={Text.Body.OfText("يستند الفرز إلى درجة الخلفية وتجانس الحبيبات وتقارب الألواح، وتظهر أهمية المعاينة بصورة أكبر في المساحات الفاتحة بسبب وضوح الفروق اللونية بين القطع المتجاورة.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أبيض رمادي فاتح على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة حبيبات دقيقة ومتجانسة بالرمادي والأبيض والفضي وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت سفاجا أبيض")}
			pText={Text.Body.White.OfText("يتداول في ألواح وترابيع ودرج وقوائم وقطع مطابخ. تحديد مقاسات الكونتر والفتحات والحواف قبل التصنيع يرفع الاستفادة من اللوح ويضمن ترتيب القطع بصورة متناسقة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت سفاجا أبيض" />

		<Emograph
			pText={Text.Body.OfText("تستفيد الخامة الفاتحة من تنظيف منتظم بمنظف متعادل، وتفيد المعالجة الواقية في المطابخ والكونترات عند ارتفاع التعرض للسوائل والزيوت.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت سفاجا أبيض داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت سفاجا أبيض يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين المطابخ والكونترات، الأرضيات، السلالم، الحوائط، الواجهات، المداخل يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت حلايب" pHref="/emostone/granit/eg/halayeb" />

			<EmoDet Light pText="جرانيت رمادي الشركة" pHref="/emostone/granit/eg/grey-sherka" />

			<EmoDet Light pText="جرانيت جندولا" pHref="/emostone/granit/eg/gandola" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

		</HzStack>

	</EmoSec>







</BLayout>
