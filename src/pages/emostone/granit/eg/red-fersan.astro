---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت أحمر فرسان | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت أحمر فرسان من الجرانيت المصري الطبيعي بدرجة أحمر غامق. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Fersan.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت أحمر فرسان")}
			pText={Text.Body.OfText("جرانيت مصري أحمر قوي مناسب للأرضيات والسلالم والواجهات والتطبيقات الخارجية التي تحتاج لونًا واضحًا وسطحًا متينًا. اللون العام أحمر غامق، ويظهر السطح بتكوين حبيبات حمراء متوسطة مع نقاط سوداء ورمادية داكنة.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Fersan.webp",
			NameAr: "جرانيت أحمر فرسان",
			Alt: "جرانيت أحمر فرسان المصري بحبيبات حمراء قوية وتباين داكن",
			Use: "الأرضيات الخارجية، السلالم، الواجهات، الممرات، اللاندسكيب، المناطق العامة",
		}]}
		pName="جرانيت أحمر فرسان"
		pKind="جرانيت مصري طبيعي"
		pColor="أحمر غامق"
		pCountry="مصر"
		pUses={[
			"الأرضيات الخارجية",
			"السلالم",
			"الواجهات",
			"الممرات",
			"اللاندسكيب",
			"المناطق العامة",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري أحمر قوي مناسب للأرضيات والسلالم والواجهات والتطبيقات الخارجية التي تحتاج لونًا واضحًا وسطحًا متينًا.", "يميل أحمر فرسان إلى الأحمر الغامق مع نقاط وحبيبات داكنة، ويعطي سطحًا كثيفًا بصريًا أكثر هدوءًا من الخامات ذات البلورات الكبيرة. التشطيب الملتهب يبرز تكوينه الحجري ويزيد حضور اللون في المساحات المفتوحة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت أحمر فرسان"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت أحمر فرسان" />

		<Emograph
			pText={Text.Body.OfText("يميل أحمر فرسان إلى الأحمر الغامق مع نقاط وحبيبات داكنة، ويعطي سطحًا كثيفًا بصريًا أكثر هدوءًا من الخامات ذات البلورات الكبيرة. التشطيب الملتهب يبرز تكوينه الحجري ويزيد حضور اللون في المساحات المفتوحة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يخدم المداخل الخارجية والسلالم والممرات والواجهات ذات الدرجات الدافئة. الدمج مع الحجر البيج والخرسانة والحديد الداكن يقدم تكوينًا متوازنًا، كما يعمل اللون الأحمر كعنصر توجيه بصري في المساحات العامة.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت أحمر فرسان" />

		<Emograph
			pText={Text.Body.OfText("يناسب الأرضيات الخارجية والسلالم والواجهات واللاندسكيب والممرات. أعمال الحركة الكثيفة تستفيد من ملمس سطحي مناسب للاحتكاك، بينما تظهر النسخة المصقولة بصورة أكثر عمقًا في المساحات الداخلية.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات الخارجية",
				"السلالم",
				"الواجهات",
				"الممرات",
				"اللاندسكيب",
				"المناطق العامة",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت أحمر فرسان داخل التصميم")}
			pText={Text.Body.White.OfText("يخدم المداخل الخارجية والسلالم والممرات والواجهات ذات الدرجات الدافئة. الدمج مع الحجر البيج والخرسانة والحديد الداكن يقدم تكوينًا متوازنًا، كما يعمل اللون الأحمر كعنصر توجيه بصري في المساحات العامة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة حبيبات حمراء متوسطة مع نقاط سوداء ورمادية داكنة. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت أحمر فرسان للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أحمر غامق")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("حبيبات حمراء متوسطة مع نقاط سوداء ورمادية داكنة")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت أحمر فرسان" />

		<Emograph
			pText={Text.Body.OfText("تعتمد جودة التجميع على تقارب درجة الأحمر وكثافة النقاط الداكنة بين القطع. ترتيب القطع في السلالم والممرات قبل التثبيت يمنح المشروع انتقالًا لونيًا منظمًا.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أحمر غامق على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة حبيبات حمراء متوسطة مع نقاط سوداء ورمادية داكنة وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت أحمر فرسان")}
			pText={Text.Body.White.OfText("يتداول في ألواح وترابيع ودرج وقوائم وقطع خارجية حسب المقاس. تحديد نوع التشطيب مع أمر التوريد يساعد على ضبط المقاسات النهائية والحواف ومراحل التصنيع.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت أحمر فرسان" />

		<Emograph
			pText={Text.Body.OfText("تستفيد الأسطح الخارجية من تنظيف دوري وإزالة الرواسب، بينما تعتمد الأسطح المصقولة على منظفات متعادلة ومعالجة حماية مناسبة حسب بيئة الاستخدام.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت أحمر فرسان داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت أحمر فرسان يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات الخارجية، السلالم، الواجهات، الممرات، اللاندسكيب، المناطق العامة يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت أحمر أسوان" pHref="/emostone/granit/eg/red-aswan" />

			<EmoDet Light pText="جرانيت رويال أحمر" pHref="/emostone/granit/eg/red-royal" />

			<EmoDet Light pText="جرانيت أحمر سفاجا" pHref="/emostone/granit/eg/red-safaga" />

			<EmoDet Light pText="جرانيت أحمر نفرتاري" pHref="/emostone/granit/eg/red-nefertary" />

		</HzStack>

	</EmoSec>







</BLayout>
