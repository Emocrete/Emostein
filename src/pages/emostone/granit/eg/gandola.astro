---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت جندولا | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت جندولا من الجرانيت المصري الطبيعي بدرجة رمادي ووردي متعدد الدرجات. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Gandola.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت جندولا")}
			pText={Text.Body.OfText("جرانيت مصري متعدد الدرجات يتميز بحركة حبيبية واضحة، ويقدم سطحًا غنيًا بصريًا يناسب المشروعات السكنية والتجارية. اللون العام رمادي ووردي متعدد الدرجات، ويظهر السطح بتكوين مزيج حبيبي متحرك من الرمادي والأسود والبيج والوردي.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Gandola.webp",
			NameAr: "جرانيت جندولا",
			Alt: "جرانيت جندولا المصري بمزيج وردي ورمادي وأسود متعدد الحبيبات",
			Use: "الأرضيات، السلالم، المداخل، الواجهات، المطابخ والكونترات، اللاندسكيب",
		}]}
		pName="جرانيت جندولا"
		pKind="جرانيت مصري طبيعي"
		pColor="رمادي ووردي متعدد الدرجات"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"السلالم",
			"المداخل",
			"الواجهات",
			"المطابخ والكونترات",
			"اللاندسكيب",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري متعدد الدرجات يتميز بحركة حبيبية واضحة، ويقدم سطحًا غنيًا بصريًا يناسب المشروعات السكنية والتجارية.", "تكوين جندولا يعتمد على مزيج من الحبيبات الرمادية والسوداء مع درجات دافئة، ويعطي السطح شخصية أكثر حركة من الجرانيت الرمادي المتجانس. المسافة بين الحبيبات واختلاف أحجامها يصنعان تأثيرًا بصريًا واضحًا على الألواح الكبيرة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت جندولا"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت جندولا" />

		<Emograph
			pText={Text.Body.OfText("تكوين جندولا يعتمد على مزيج من الحبيبات الرمادية والسوداء مع درجات دافئة، ويعطي السطح شخصية أكثر حركة من الجرانيت الرمادي المتجانس. المسافة بين الحبيبات واختلاف أحجامها يصنعان تأثيرًا بصريًا واضحًا على الألواح الكبيرة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يتوافق جندولا مع الأرضيات الواسعة والسلالم والمداخل التي تستفيد من النقشة الطبيعية. الدرجات الدافئة داخل الخامة تساعد على دمجها مع الأخشاب والبيج، بينما تدعم المكونات الرمادية علاقتها بالمعادن والواجهات المعاصرة.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت جندولا" />

		<Emograph
			pText={Text.Body.OfText("يمتد استخدام جندولا إلى الأرضيات والسلالم والكسوات والمطابخ والواجهات واللاندسكيب. التشطيب المصقول يبرز تعدد الألوان في الداخل، والتشطيبات الخشنة تمنح التطبيقات الخارجية حضورًا حجريًا أكثر وضوحًا.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"السلالم",
				"المداخل",
				"الواجهات",
				"المطابخ والكونترات",
				"اللاندسكيب",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت جندولا داخل التصميم")}
			pText={Text.Body.White.OfText("يتوافق جندولا مع الأرضيات الواسعة والسلالم والمداخل التي تستفيد من النقشة الطبيعية. الدرجات الدافئة داخل الخامة تساعد على دمجها مع الأخشاب والبيج، بينما تدعم المكونات الرمادية علاقتها بالمعادن والواجهات المعاصرة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة مزيج حبيبي متحرك من الرمادي والأسود والبيج والوردي. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت جندولا للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("رمادي ووردي متعدد الدرجات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("مزيج حبيبي متحرك من الرمادي والأسود والبيج والوردي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت جندولا" />

		<Emograph
			pText={Text.Body.OfText("يركز الفرز الجيد على تقارب الإيقاع الحبيبي بين القطع التي ستظهر متجاورة، وعلى توزيع الدرجات الدافئة والداكنة عبر المسطح. ترتيب الألواح قبل التقطيع يفيد المشروعات التي تحتوي مساحات متصلة أو سلالم متكررة.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة رمادي ووردي متعدد الدرجات على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة مزيج حبيبي متحرك من الرمادي والأسود والبيج والوردي وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت جندولا")}
			pText={Text.Body.White.OfText("يتاح جندولا في ألواح وترابيع ودرج وقوائم وقطع حسب المقاس. اختيار شكل التوريد يرتبط بمقاس القطعة النهائية واتجاه الحبيبات المطلوب ونسبة الهالك الناتجة عن التقطيع.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت جندولا" />

		<Emograph
			pText={Text.Body.OfText("التنظيف المتعادل يحافظ على لون السطح، وتفيد المعالجة الواقية في الكونترات والمناطق المعرضة للسوائل. إعادة الجلي في الأرضيات تعيد انتظام اللمعة عند الحاجة ضمن برامج الصيانة الدورية.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت جندولا داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت جندولا يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، السلالم، المداخل، الواجهات، المطابخ والكونترات، اللاندسكيب يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت رمادي الشركة" pHref="/emostone/granit/eg/grey-sherka" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

			<EmoDet Light pText="جرانيت سفاجا أبيض" pHref="/emostone/granit/eg/white-safaga" />

			<EmoDet Light pText="جرانيت فيردي غزال أصفر" pHref="/emostone/granit/eg/yellow-verdi-gazal" />

		</HzStack>

	</EmoSec>







</BLayout>
