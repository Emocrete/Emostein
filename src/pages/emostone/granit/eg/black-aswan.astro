---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت أسود أسوان | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت أسود أسوان من الجرانيت المصري الطبيعي بدرجة أسود داكن. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Black_Aswan.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت أسود أسوان")}
			pText={Text.Body.OfText("جرانيت أسواني داكن يجمع بين الكثافة البصرية والصلابة، ويمنح الأسطح حضورًا واضحًا في الاستخدامات الداخلية والخارجية. اللون العام أسود داكن، ويظهر السطح بتكوين حبيبات دقيقة كثيفة ومتقاربة بدرجات الأسود والرمادي مع بلورات فاتحة محدودة.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Black_Aswan.webp",
			NameAr: "جرانيت جندولا",
			Alt: "جرانيت جندولا المصري بمزيج وردي ورمادي وأسود متعدد الحبيبات",
			Use: "الأرضيات، السلالم، المداخل، الواجهات، المطابخ والكونترات، اللاندسكيب",
		}]}
		pName="جرانيت أسود أسوان"
		pKind="جرانيت مصري طبيعي"
		pColor="أسود داكن"
		pCountry="مصر"
		pUses={[
			"المطابخ والكونترات",
			"السلالم",
			"الأرضيات",
			"الواجهات والكسوات",
			"المداخل",
			"الأعمال التذكارية",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت أسواني داكن يجمع بين الكثافة البصرية والصلابة، ويمنح الأسطح حضورًا واضحًا في الاستخدامات الداخلية والخارجية.", "يعتمد الطابع البصري لأسود أسوان على خلفية شديدة الداكنية وحبيبات دقيقة متقاربة، لذلك يظهر السطح كتكوين متماسك أكثر من كونه نقشًا متحركًا. التشطيب المصقول يزيد عمق اللون ويبرز التباين المعدني، بينما يمنح التشطيب المطفي أو الملتهب قراءة أكثر هدوءًا للمساحات الخارجية."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت أسود أسوان"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت أسود أسوان" />

		<Emograph
			pText={Text.Body.OfText("يعتمد الطابع البصري لأسود أسوان على خلفية شديدة الداكنية وحبيبات دقيقة متقاربة، لذلك يظهر السطح كتكوين متماسك أكثر من كونه نقشًا متحركًا. التشطيب المصقول يزيد عمق اللون ويبرز التباين المعدني، بينما يمنح التشطيب المطفي أو الملتهب قراءة أكثر هدوءًا للمساحات الخارجية.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يناسب أسود أسوان التصميمات التي تعتمد على التباين مع الأخشاب الفاتحة والمعادن والدهانات البيضاء والرمادية. المساحات الكبيرة تستفيد من انتظام الخامة، كما تظهر الحواف والفتحات والتفاصيل المصنعة بوضوح بسبب اللون الموحد نسبيًا.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت أسود أسوان" />

		<Emograph
			pText={Text.Body.OfText("يعمل بكفاءة في أسطح المطابخ والكونترات والسلالم والأرضيات والمداخل والواجهات. الاستخدام الخارجي يرتبط باختيار تشطيب يحقق احتكاكًا مناسبًا، بينما تتجه التطبيقات الداخلية إلى المصقول والمطفي حسب لغة التصميم.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"المطابخ والكونترات",
				"السلالم",
				"الأرضيات",
				"الواجهات والكسوات",
				"المداخل",
				"الأعمال التذكارية",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت أسود أسوان داخل التصميم")}
			pText={Text.Body.White.OfText("يناسب أسود أسوان التصميمات التي تعتمد على التباين مع الأخشاب الفاتحة والمعادن والدهانات البيضاء والرمادية. المساحات الكبيرة تستفيد من انتظام الخامة، كما تظهر الحواف والفتحات والتفاصيل المصنعة بوضوح بسبب اللون الموحد نسبيًا.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة حبيبات دقيقة كثيفة ومتقاربة بدرجات الأسود والرمادي مع بلورات فاتحة محدودة. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت أسود أسوان للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أسود داكن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("حبيبات دقيقة كثيفة ومتقاربة بدرجات الأسود والرمادي مع بلورات فاتحة محدودة")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت أسود أسوان" />

		<Emograph
			pText={Text.Body.OfText("تعتمد معاينة أسود أسوان على درجة عمق اللون، انتظام توزيع البلورات، تقارب الألواح المخصصة للمساحة الواحدة، وجودة الصقل على السطح والحواف. تجميع ألواح المشروع من دفعة متقاربة يدعم التجانس البصري في الأرضيات والواجهات الواسعة.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أسود داكن على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة حبيبات دقيقة كثيفة ومتقاربة بدرجات الأسود والرمادي مع بلورات فاتحة محدودة وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت أسود أسوان")}
			pText={Text.Body.White.OfText("يتداول أسود أسوان في صورة ألواح وترابيع ودرج وقوائم وقطع مصنعة حسب المقاس. السماكات الشائعة في أعمال التشطيب تدور حول 2 و3 سم، ويحدد السمك النهائي وفق الاستخدام وطريقة التثبيت وأبعاد القطعة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت أسود أسوان" />

		<Emograph
			pText={Text.Body.OfText("يحافظ التنظيف اليومي بمنظف متعادل وقطعة ناعمة على سطح الجرانيت المصقول. المناطق المعرضة للزيوت والسوائل تستفيد من معالجة حماية مناسبة للحجر الطبيعي وفق حالة السطح ونوع الاستخدام.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت أسود أسوان داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت أسود أسوان يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين المطابخ والكونترات، السلالم، الأرضيات، الواجهات والكسوات، المداخل، الأعمال التذكارية يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت رمادي الشركة" pHref="/emostone/granit/eg/grey-sherka" />

			<EmoDet Light pText="جرانيت حلايب" pHref="/emostone/granit/eg/halayeb" />

			<EmoDet Light pText="جرانيت أحمر أسوان" pHref="/emostone/granit/eg/red-aswan" />

			<EmoDet Light pText="جرانيت أحمر نفرتاري" pHref="/emostone/granit/eg/red-nefertary" />

		</HzStack>

	</EmoSec>







</BLayout>
