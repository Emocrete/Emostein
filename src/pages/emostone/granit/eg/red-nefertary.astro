---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت أحمر نفرتاري | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت أحمر نفرتاري من الجرانيت المصري الطبيعي بدرجة أحمر داكن. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Nefertary.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت أحمر نفرتاري")}
			pText={Text.Body.OfText("جرانيت مصري أحمر داكن بتكوين معدني ممتد، ويمنح الكونترات والكسوات والأرضيات سطحًا غنيًا وذا طابع رسمي. اللون العام أحمر داكن، ويظهر السطح بتكوين خلفية حمراء داكنة مع تداخلات معدنية سوداء ورمادية ممتدة.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Nefertary.webp",
			NameAr: "جرانيت أحمر نفرتاري",
			Alt: "جرانيت أحمر نفرتاري المصري بلون أحمر داكن ونقشة معدنية ممتدة",
			Use: "المطابخ والكونترات، الأرضيات، السلالم، الحوائط، الأحواض، الكسوات",
		}]}
		pName="جرانيت أحمر نفرتاري"
		pKind="جرانيت مصري طبيعي"
		pColor="أحمر داكن"
		pCountry="مصر"
		pUses={[
			"المطابخ والكونترات",
			"الأرضيات",
			"السلالم",
			"الحوائط",
			"الأحواض",
			"الكسوات",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري أحمر داكن بتكوين معدني ممتد، ويمنح الكونترات والكسوات والأرضيات سطحًا غنيًا وذا طابع رسمي.", "تتحرك داخل نفرتاري تدرجات الأحمر الداكن مع خطوط وتداخلات معدنية تزيد عمق الخامة وتمنحها اتجاهًا بصريًا أوضح من الجرانيت الحبيبي المنتظم. الألواح الكبيرة تعرض هذا التكوين بصورة أفضل وتسمح بقراءة مسار اللون."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت أحمر نفرتاري"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت أحمر نفرتاري" />

		<Emograph
			pText={Text.Body.OfText("تتحرك داخل نفرتاري تدرجات الأحمر الداكن مع خطوط وتداخلات معدنية تزيد عمق الخامة وتمنحها اتجاهًا بصريًا أوضح من الجرانيت الحبيبي المنتظم. الألواح الكبيرة تعرض هذا التكوين بصورة أفضل وتسمح بقراءة مسار اللون.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يعمل اللون الداكن في المطابخ والكونترات والحوائط المميزة، ويتوافق مع الخشب الداكن والبيج والرمادي الدافئ. اختيار موضع القطع داخل اللوح يتيح توجيه الحركة اللونية لخدمة تكوين الحائط أو سطح العمل.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت أحمر نفرتاري" />

		<Emograph
			pText={Text.Body.OfText("يمتد استخدامه إلى المطابخ والكونترات والأرضيات والسلالم والحوائط والأحواض. الصقل يناسب التفاصيل الداخلية التي تستفيد من عمق اللون، والتشطيبات الأقل لمعانًا تعطي قراءة أكثر هدوءًا للمساحات الكبيرة.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"المطابخ والكونترات",
				"الأرضيات",
				"السلالم",
				"الحوائط",
				"الأحواض",
				"الكسوات",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت أحمر نفرتاري داخل التصميم")}
			pText={Text.Body.White.OfText("يعمل اللون الداكن في المطابخ والكونترات والحوائط المميزة، ويتوافق مع الخشب الداكن والبيج والرمادي الدافئ. اختيار موضع القطع داخل اللوح يتيح توجيه الحركة اللونية لخدمة تكوين الحائط أو سطح العمل.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة خلفية حمراء داكنة مع تداخلات معدنية سوداء ورمادية ممتدة. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت أحمر نفرتاري للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أحمر داكن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("خلفية حمراء داكنة مع تداخلات معدنية سوداء ورمادية ممتدة")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت أحمر نفرتاري" />

		<Emograph
			pText={Text.Body.OfText("تحتاج المعاينة إلى قراءة اللوح كاملًا بسبب امتداد التكوين المعدني، ثم اختيار مناطق التقطيع وفق ترتيب القطع داخل التصميم. تجميع أجزاء الكونتر أو الحائط من لوح متقارب يدعم استمرارية الحركة البصرية.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أحمر داكن على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة خلفية حمراء داكنة مع تداخلات معدنية سوداء ورمادية ممتدة وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت أحمر نفرتاري")}
			pText={Text.Body.White.OfText("يتداول في صورة ألواح وقطع مصنعة وترابيع ودرج. أعمال المطابخ والأحواض تحتاج حصر الفتحات والحواف والتقفيلات قبل التقطيع للاستفادة من اللوح بكفاءة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت أحمر نفرتاري" />

		<Emograph
			pText={Text.Body.OfText("يخدم التنظيف المتعادل سطح الجرانيت المصقول، وتفيد الحماية السطحية في الكونترات والأحواض حسب مستوى الاستخدام وطبيعة المواد المتداولة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت أحمر نفرتاري داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت أحمر نفرتاري يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين المطابخ والكونترات، الأرضيات، السلالم، الحوائط، الأحواض، الكسوات يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت رويال أحمر" pHref="/emostone/granit/eg/red-royal" />

			<EmoDet Light pText="جرانيت أحمر فرسان" pHref="/emostone/granit/eg/red-fersan" />

			<EmoDet Light pText="جرانيت أسود أسوان" pHref="/emostone/granit/eg/black-aswan" />

			<EmoDet Light pText="جرانيت أحمر أسوان" pHref="/emostone/granit/eg/red-aswan" />

		</HzStack>

	</EmoSec>







</BLayout>
