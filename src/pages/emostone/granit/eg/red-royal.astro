---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت رويال أحمر | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت رويال أحمر من الجرانيت المصري الطبيعي بدرجة أحمر قرمزي. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Royal.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت رويال أحمر")}
			pText={Text.Body.OfText("جرانيت مصري أحمر قرمزي بتكوين متقارب يمنح المداخل والسلالم والأرضيات والكسوات طابعًا رسميًا واضحًا. اللون العام أحمر قرمزي، ويظهر السطح بتكوين حبيبات حمراء دقيقة ومتوسطة مع مكونات معدنية داكنة.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Red_Royal.webp",
			NameAr: "جرانيت رويال أحمر",
			Alt: "جرانيت رويال أحمر المصري بدرجة قرمزية وحبيبات معدنية دقيقة",
			Use: "الأرضيات، السلالم، المداخل، الواجهات، المطابخ، العناصر المعمارية",
		}]}
		pName="جرانيت رويال أحمر"
		pKind="جرانيت مصري طبيعي"
		pColor="أحمر قرمزي"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"السلالم",
			"المداخل",
			"الواجهات",
			"المطابخ",
			"العناصر المعمارية",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري أحمر قرمزي بتكوين متقارب يمنح المداخل والسلالم والأرضيات والكسوات طابعًا رسميًا واضحًا.", "يميل رويال أحمر إلى درجة قرمزية مستقرة نسبيًا مع حبيبات معدنية متقاربة، ويظهر السطح كتكوين متماسك عند النظر من مسافة. اللمعة ترفع تشبع اللون، بينما يوازن التشطيب المطفي بين الأحمر والمكونات الداكنة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت رويال أحمر"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت رويال أحمر" />

		<Emograph
			pText={Text.Body.OfText("يميل رويال أحمر إلى درجة قرمزية مستقرة نسبيًا مع حبيبات معدنية متقاربة، ويظهر السطح كتكوين متماسك عند النظر من مسافة. اللمعة ترفع تشبع اللون، بينما يوازن التشطيب المطفي بين الأحمر والمكونات الداكنة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يناسب المداخل الرسمية والسلالم والمساحات التي تستخدم الأحمر كلون معماري رئيسي. الدمج مع البيج والرمادي والأسود يخلق علاقات لونية واضحة، وتفيد القطع الكبيرة في إبراز انتظام الخامة.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت رويال أحمر" />

		<Emograph
			pText={Text.Body.OfText("يستخدم في الأرضيات والسلالم والمداخل والواجهات والمطابخ والعناصر المعمارية. اختيار ملمس السطح يعتمد على بيئة الحركة، ويقدم المصقول قراءة فخمة في الداخل والتشطيب الخشن أداء مناسبًا في الخارج.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"السلالم",
				"المداخل",
				"الواجهات",
				"المطابخ",
				"العناصر المعمارية",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت رويال أحمر داخل التصميم")}
			pText={Text.Body.White.OfText("يناسب المداخل الرسمية والسلالم والمساحات التي تستخدم الأحمر كلون معماري رئيسي. الدمج مع البيج والرمادي والأسود يخلق علاقات لونية واضحة، وتفيد القطع الكبيرة في إبراز انتظام الخامة.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة حبيبات حمراء دقيقة ومتوسطة مع مكونات معدنية داكنة. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت رويال أحمر للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("أحمر قرمزي")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("حبيبات حمراء دقيقة ومتوسطة مع مكونات معدنية داكنة")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت رويال أحمر" />

		<Emograph
			pText={Text.Body.OfText("تعتمد المعاينة على ثبات الدرجة القرمزية وتقارب كثافة الحبيبات عبر دفعة المشروع. السلالم الطويلة تحتاج ترتيبًا مسبقًا للقطع بما يحافظ على انتظام اللون بين القلبات والبسطات.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة أحمر قرمزي على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة حبيبات حمراء دقيقة ومتوسطة مع مكونات معدنية داكنة وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت رويال أحمر")}
			pText={Text.Body.White.OfText("يتاح في ألواح وترابيع ودرج وقوائم وقطع مخصصة. تنسيق السمك والحواف مع تفاصيل التصميم يحدد استهلاك اللوح ومراحل التصنيع بصورة أدق.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت رويال أحمر" />

		<Emograph pText={Text.Body.OfText("التنظيف المعتدل يحافظ على اللون واللمعة، وتفيد الصيانة الدورية للأرضيات في استعادة تجانس السطح بعد الاستخدام الكثيف.")} />

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت رويال أحمر داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت رويال أحمر يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، السلالم، المداخل، الواجهات، المطابخ، العناصر المعمارية يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت أحمر أسوان" pHref="/emostone/granit/eg/red-aswan" />

			<EmoDet Light pText="جرانيت أحمر فرسان" pHref="/emostone/granit/eg/red-fersan" />

			<EmoDet Light pText="جرانيت أحمر نفرتاري" pHref="/emostone/granit/eg/red-nefertary" />

			<EmoDet Light pText="جرانيت روزا النصر" pHref="/emostone/granit/eg/rosa-nasr" />

		</HzStack>

	</EmoSec>







</BLayout>
