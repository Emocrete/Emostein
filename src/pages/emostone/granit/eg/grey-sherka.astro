---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت رمادي الشركة | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت رمادي الشركة من الجرانيت المصري الطبيعي بدرجة رمادي متوسط. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Grey_Sherka.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت رمادي الشركة")}
			pText={Text.Body.OfText("جرانيت رمادي متزن بصريًا يناسب المساحات واسعة الحركة والتطبيقات التي تحتاج لونًا محايدًا وسطحًا عمليًا. اللون العام رمادي متوسط، ويظهر السطح بتكوين حبيبات رمادية وسوداء منتظمة ومتقاربة.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Grey_Sherka.webp",
			NameAr: "جرانيت رمادي الشركة",
			Alt: "جرانيت رمادي الشركة المصري بحبيبات رمادية وسوداء منتظمة",
			Use: "الأرضيات، السلالم، الممرات، الواجهات، الأرصفة، المشروعات كثيفة الاستخدام",
		}]}
		pName="جرانيت رمادي الشركة"
		pKind="جرانيت مصري طبيعي"
		pColor="رمادي متوسط"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"السلالم",
			"الممرات",
			"الواجهات",
			"الأرصفة",
			"المشروعات كثيفة الاستخدام",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت رمادي متزن بصريًا يناسب المساحات واسعة الحركة والتطبيقات التي تحتاج لونًا محايدًا وسطحًا عمليًا.", "يتميز رمادي الشركة بتوزيع حبيبي متقارب يجعل قراءة السطح منتظمة على المساحات الكبيرة. اللون المتوسط يقلل سيطرة الخامة على التصميم ويمنحها قدرة مرتفعة على الاندماج مع طيف واسع من ألوان الواجهات والأرضيات."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت رمادي الشركة"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت رمادي الشركة" />

		<Emograph
			pText={Text.Body.OfText("يتميز رمادي الشركة بتوزيع حبيبي متقارب يجعل قراءة السطح منتظمة على المساحات الكبيرة. اللون المتوسط يقلل سيطرة الخامة على التصميم ويمنحها قدرة مرتفعة على الاندماج مع طيف واسع من ألوان الواجهات والأرضيات.")}
		/>

		<Emograph
			pText={Text.Body.OfText("تخدم الدرجة الرمادية التصميمات التجارية والإدارية والسكنية المعاصرة، وتعمل جيدًا مع الأسود والأبيض والأخشاب والألوان الترابية. التكرار المنتظم في السلالم والممرات يعطي المشروع إيقاعًا هادئًا ومتماسكًا.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت رمادي الشركة" />

		<Emograph
			pText={Text.Body.OfText("يستخدم في الأرضيات والسلالم والممرات والواجهات والأرصفة والمناطق العامة. التشطيب الملتهب أو المخشن مناسب للأسطح الخارجية ومسارات الحركة، بينما يقدم المصقول سطحًا أكثر رسمية في الداخل.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"السلالم",
				"الممرات",
				"الواجهات",
				"الأرصفة",
				"المشروعات كثيفة الاستخدام",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت رمادي الشركة داخل التصميم")}
			pText={Text.Body.White.OfText("تخدم الدرجة الرمادية التصميمات التجارية والإدارية والسكنية المعاصرة، وتعمل جيدًا مع الأسود والأبيض والأخشاب والألوان الترابية. التكرار المنتظم في السلالم والممرات يعطي المشروع إيقاعًا هادئًا ومتماسكًا.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة حبيبات رمادية وسوداء منتظمة ومتقاربة. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت رمادي الشركة للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("رمادي متوسط")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("حبيبات رمادية وسوداء منتظمة ومتقاربة")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت رمادي الشركة" />

		<Emograph
			pText={Text.Body.OfText("تقارب الدرجة الرمادية بين الدفعات يمثل محور المعاينة، إلى جانب انتظام الحبيبات وجودة القطع والحواف. المشروعات الكبيرة تستفيد من حجز كمية متجانسة تغطي المسطح والهالك المتوقع.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة رمادي متوسط على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة حبيبات رمادية وسوداء منتظمة ومتقاربة وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت رمادي الشركة")}
			pText={Text.Body.White.OfText("يتاح في ألواح وترابيع ودرج وقوائم وقطع رصف وقطع حسب المقاس. تحديد المقاسات قبل الشراء يرفع كفاءة التقطيع ويقلل الهالك في المشروعات ذات التكرار الكبير.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت رمادي الشركة" />

		<Emograph
			pText={Text.Body.OfText("يستجيب السطح للتنظيف المعتدل وبرامج الجلي المعتادة للأرضيات. جودة الفواصل والحشو والتنفيذ تشارك في الحفاظ على المظهر المنتظم للممرات والمساحات التجارية.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت رمادي الشركة داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت رمادي الشركة يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، السلالم، الممرات، الواجهات، الأرصفة، المشروعات كثيفة الاستخدام يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت حلايب" pHref="/emostone/granit/eg/halayeb" />

			<EmoDet Light pText="جرانيت سفاجا أبيض" pHref="/emostone/granit/eg/white-safaga" />

			<EmoDet Light pText="جرانيت أسود أسوان" pHref="/emostone/granit/eg/black-aswan" />

			<EmoDet Light pText="جرانيت جندولا" pHref="/emostone/granit/eg/gandola" />

		</HzStack>

	</EmoSec>







</BLayout>
