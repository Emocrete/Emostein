---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoList, EmoTable, EmoTableCell, EmoTableRow, EmoWhatsIcon, HzStack, SecTitle } from "@/Widgets/Comp";
import { AngleBand } from "@/Widgets/Layouts";
import { EmoSec } from "@/Widgets/Sections";
import { StoneProductStrip } from "@/Widgets/Stone";
import { Colors, ElemBg, Pixel, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="جرانيت حلايب | اللون والاستخدامات والتشطيبات"
	pDescr="جرانيت حلايب من الجرانيت المصري الطبيعي بدرجة رمادي فاتح وأبيض. تعرض الصفحة اللون والحبيبات والاستخدامات والتشطيبات والفرز والمقاسات والتوريد والتصنيع للمشروعات."
	pSchemaImages={["/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Halayeb.webp"]}
>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(16, 12)} pBg={new ElemBg("#f6f3ed")}>

		<Emograph
			pTitle={Text.H1.OfText("جرانيت حلايب")}
			pText={Text.Body.OfText("جرانيت مصري فاتح متعدد الاستخدامات، يجمع خلفية رمادية بيضاء مع حبيبات داكنة ويخدم الأعمال الداخلية والخارجية. اللون العام رمادي فاتح وأبيض، ويظهر السطح بتكوين تنقيط أسود ورمادي فوق أرضية فاتحة بتفاوت طبيعي.")}
		/>

	</EmoSec>







	<StoneProductStrip
		pStoneType="Granite"
		pImages={[{
			File: "/Media/Emostone/Granit/Eg/Samples/Raw/Egyptian_Granite_Halayeb.webp",
			NameAr: "جرانيت حلايب",
			Alt: "جرانيت حلايب المصري بدرجة رمادية فاتحة وتنقيط أسود ورمادي",
			Use: "الأرضيات، السلالم، المطابخ، الواجهات، الحوائط، الممرات والأرصفة",
		}]}
		pName="جرانيت حلايب"
		pKind="جرانيت مصري طبيعي"
		pColor="رمادي فاتح وأبيض"
		pCountry="مصر"
		pUses={[
			"الأرضيات",
			"السلالم",
			"المطابخ",
			"الواجهات",
			"الحوائط",
			"الممرات والأرصفة",
		]}
		pSizes={["ألواح", "ترابيع", "درج وقوائم", "قطع حسب المقاس", "سماكات شائعة 2 و3 سم"]}
		pBody={["جرانيت مصري فاتح متعدد الاستخدامات، يجمع خلفية رمادية بيضاء مع حبيبات داكنة ويخدم الأعمال الداخلية والخارجية.", "يعتمد مظهر حلايب على تباين واضح بين الأرضية الفاتحة والنقاط السوداء والرمادية. هذا التكوين يمنح السطح قراءة عملية ويظهر التفاصيل الطبيعية من مسافة قريبة مع بقاء اللون العام فاتحًا على مستوى المساحة."]}
		pCtaText="اطلب سعر الخامة لمشروعك"
		pCtaHref="tel:+201014490054"
		pCtaAria="اطلب سعر جرانيت حلايب"
		pAutoSlide={false}
	/>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="اللون والحبيبات في جرانيت حلايب" />

		<Emograph
			pText={Text.Body.OfText("يعتمد مظهر حلايب على تباين واضح بين الأرضية الفاتحة والنقاط السوداء والرمادية. هذا التكوين يمنح السطح قراءة عملية ويظهر التفاصيل الطبيعية من مسافة قريبة مع بقاء اللون العام فاتحًا على مستوى المساحة.")}
		/>

		<Emograph
			pText={Text.Body.OfText("يفيد اللون الفاتح في المطابخ والسلالم والمداخل والمساحات التي تستهدف إحساسًا أكثر اتساعًا. يتكامل مع الخشب والرمادي والأسود، كما ينسجم مع واجهات تعتمد الخرسانة والألوان الحجرية.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(28, 20)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="استخدامات جرانيت حلايب" />

		<Emograph
			pText={Text.Body.OfText("تغطي تطبيقاته الأرضيات والسلالم والحوائط والواجهات والمطابخ والممرات. تتجه الأسطح الداخلية إلى المصقول والمطفي، وتستخدم التشطيبات الملتهبة والمخشنة في المداخل والأرصفة والأعمال الخارجية.")}
		/>

		<HzStack pGap={new Pixel(44, 24)}>

			<EmoList
				pTitle={Text.H3.OfText("الاستخدامات المعمارية")}
				pNumbered={false}
				pItems={[
				"الأرضيات",
				"السلالم",
				"المطابخ",
				"الواجهات",
				"الحوائط",
				"الممرات والأرصفة",
			]}
			/>

			<EmoList
				pTitle={Text.H3.OfText("التشطيبات المتاحة")}
				pNumbered={false}
				pItems={[
				"مصقول — يرفع عمق اللون ووضوح البلورات ويمنح السطح انعكاسًا واضحًا.",
				"مطفي — يقدم انعكاسًا هادئًا وقراءة أكثر اتزانًا للون والحبيبات.",
				"ملتهب — ينتج ملمسًا خشنًا مناسبًا لتطبيقات خارجية ومسارات حركة متعددة.",
				"مخشن — يبرز الطبيعة الصخرية للخامة ويعطي السطح ملمسًا معماريًا واضحًا.",
			]}
			/>

		</HzStack>

	</EmoSec>







	<AngleBand>

		<Emograph
			pTitle={Text.H2.White.OfText("توظيف جرانيت حلايب داخل التصميم")}
			pText={Text.Body.White.OfText("يفيد اللون الفاتح في المطابخ والسلالم والمداخل والمساحات التي تستهدف إحساسًا أكثر اتساعًا. يتكامل مع الخشب والرمادي والأسود، كما ينسجم مع واجهات تعتمد الخرسانة والألوان الحجرية.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("طبيعة الخامة تنقيط أسود ورمادي فوق أرضية فاتحة بتفاوت طبيعي. يؤثر هذا التكوين في توزيع القطع واتجاه الألواح ودرجة حضور السطح داخل المساحة، ويظهر بصورة مختلفة بين التشطيب المصقول والتشطيبات ذات الملمس الخشن.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="بيانات جرانيت حلايب للتوريد والتصنيع" />

		<EmoTable>

			<EmoTableRow pBg={Colors.Sky}>

				<EmoTableCell pText={Text.Body.Bold.OfText("البند")} />

				<EmoTableCell pText={Text.Body.Bold.OfText("البيانات")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الخامة")} />

				<EmoTableCell pText={Text.Body.OfText("جرانيت مصري طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("اللون")} />

				<EmoTableCell pText={Text.Body.OfText("رمادي فاتح وأبيض")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("الحبيبات والنقشة")} />

				<EmoTableCell pText={Text.Body.OfText("تنقيط أسود ورمادي فوق أرضية فاتحة بتفاوت طبيعي")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("التشطيبات")} />

				<EmoTableCell pText={Text.Body.OfText("مصقول، مطفي، ملتهب، مخشن")} />

			</EmoTableRow>

			<EmoTableRow>

				<EmoTableCell pText={Text.Body.Bold.OfText("أشكال التوريد")} />

				<EmoTableCell pText={Text.Body.OfText("ألواح، ترابيع، درج وقوائم، قطع مصنعة حسب المقاس")} />

			</EmoTableRow>

			<EmoTableRow pBg="#faf8f3">

				<EmoTableCell pText={Text.Body.Bold.OfText("السماكات الشائعة")} />

				<EmoTableCell pText={Text.Body.OfText("2 و3 سم في أعمال تشطيب متعددة، مع تحديد السمك النهائي وفق أبعاد القطعة والاستخدام ونظام التثبيت")} />

			</EmoTableRow>

		</EmoTable>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(24, 18)} pBg={new ElemBg("#f4f8f9")}>

		<SecTitle pTitle="فرز ومعاينة جرانيت حلايب" />

		<Emograph
			pText={Text.Body.OfText("تقييم الدفعة يرتبط بدرجة الخلفية ونسبة الحبيبات الداكنة وتقارب النمط بين الألواح. توزيع القطع قبل التركيب يحقق انتقالًا متزنًا بين مناطق السطح ويعالج التفاوت الطبيعي بصورة تصميمية.")}
		/>

		<EmoList
			pNumbered={false}
			pItems={[
			"مراجعة درجة رمادي فاتح وأبيض على أكثر من لوح داخل الكمية المخصصة للمشروع.",
			"مراجعة تنقيط أسود ورمادي فوق أرضية فاتحة بتفاوت طبيعي وتوزيع الحركة الطبيعية قبل تحديد اتجاه القطع.",
			"تجميع القطع التي ستظهر متجاورة ضمن دفعة متقاربة في اللون والحبيبات.",
			"مراجعة جودة السطح والحواف والتشطيب النهائي قبل اعتماد القطع المصنعة.",
		]}
		/>

	</EmoSec>







	<AngleBand pDirection="Fall">

		<Emograph
			pTitle={Text.H2.White.OfText("توريد وتصنيع جرانيت حلايب")}
			pText={Text.Body.White.OfText("يتداول حلايب في ألواح وترابيع ودرج وقوائم وأسطح عمل وقطع حسب المقاس. السماكات الشائعة تتنوع وفق طبيعة العنصر، ويحدد المصنع السمك المناسب بعد تثبيت المقاسات ونظام التثبيت.")}
		/>

		<Emograph
			pText={Text.Body.White.OfText("تثبيت المقاسات قبل التصنيع يربط كمية الخامة بأبعاد القطع والحواف والفتحات واتجاه النقشة ونسبة الهالك. السلالم والكونترات والواجهات تستفيد من ترتيب مسبق للقطع يحدد موضع كل جزء داخل المشروع قبل مرحلة التركيب.")}
		/>

	</AngleBand>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(24, 18)}>

		<SecTitle pTitle="صيانة جرانيت حلايب" />

		<Emograph
			pText={Text.Body.OfText("التنظيف المتعادل والعناية بالفواصل يحافظان على الدرجة الفاتحة. أسطح العمل تستفيد من حماية مناسبة للحجر الطبيعي ومتابعة مناطق الاستخدام الكثيف بصورة دورية.")}
		/>

		<Emograph
			pText={Text.Body.OfText("العناية بالحجر الطبيعي تعتمد على منظفات متعادلة وأدوات تنظيف ناعمة، مع متابعة الفواصل والحواف والأسطح كثيفة الاستخدام. جودة التشطيب والتنفيذ والمعالجة السطحية المناسبة تشارك في الحفاظ على قراءة اللون والملمس عبر فترة الاستخدام.")}
		/>

	</EmoSec>







	<EmoSec pPad={new Pixel(58, 28)} pGap={new Pixel(22, 16)} pBg={new ElemBg("#f7f4ee")}>

		<SecTitle pTitle="سعر جرانيت حلايب داخل المشروع" />

		<Emograph
			pText={Text.Body.OfText("تسعير جرانيت حلايب يرتبط بدرجة الفرز والسمك والمقاس والتشطيب وكمية المشروع وشكل التوريد وأعمال التقطيع والحواف والفتحات والنقل والتركيب. تحديد الاستخدام الفعلي بين الأرضيات، السلالم، المطابخ، الواجهات، الحوائط، الممرات والأرصفة يساعد على تكوين بند تسعير مرتبط بالتنفيذ الفعلي.")}
		/>

		<HzStack pGap={new Pixel(30, 12)}>

			<EmoCallIcon BlackSky />

			<EmoWhatsIcon BlackSky />

		</HzStack>

	</EmoSec>







	<EmoSec pPad={new Pixel(60, 30)} pGap={new Pixel(20, 14)}>

		<SecTitle pTitle="أنواع أخرى من الجرانيت المصري" />

		<HzStack pGap={new Pixel(14, 10)} pHzAlign="Center">

			<EmoDet Light pText="دليل الجرانيت المصري" pHref="/emostone/granit/eg" />

			<EmoDet Light pText="جرانيت سفاجا أبيض" pHref="/emostone/granit/eg/white-safaga" />

			<EmoDet Light pText="جرانيت رمادي الشركة" pHref="/emostone/granit/eg/grey-sherka" />

			<EmoDet Light pText="جرانيت أسود أسوان" pHref="/emostone/granit/eg/black-aswan" />

			<EmoDet Light pText="جرانيت جندولا" pHref="/emostone/granit/eg/gandola" />

		</HzStack>

	</EmoSec>







</BLayout>
