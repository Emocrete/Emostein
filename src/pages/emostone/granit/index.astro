---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
import { Badge, DivCol, DivStr } from "../../../site/Widgets";
import { EmoGallery } from "../../../site/Widgets/Media";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت"
	pDescr="خدمة توريد وتركيب جرانيت مصري ومستورد في القاهرة والجيزة، تشمل اختيار النوع، فرز الألواح، رفع المقاسات، التقطيع، التركيب، التشطيب، وتنفيذ المطابخ والسلالم والأرضيات والواجهات والمداخل والمشايات والعتبات."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب جرانيت")}
				pText={Text.Body.Centered.OfText("جرانيت مصري ومستورد للمطابخ والسلالم والأرضيات والواجهات والمداخل والكونترات")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pYearsText="سنوات الخبرة"
				pQualityText="فرز أول"
				pWorks={7}
				pWorksText="سابقة الأعمال"
				pMobMaxCols={2}
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<EmoSec
		id="secMarbleEgImp"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle GreenLite pTitle="الجرانيت المصري والمستورد" />

		<DivStr>

			<DivCol>

				<Emograph
					id="txtEgMarple"
					pTitle={Text.H3.Centered.OfText("جرانيت مصري")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="/Media/Emostone/Marble/Eg/Samples" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph
					pTitle={Text.H3.Centered.OfText("جرانيت مستورد")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="/Media/Emostone/Marble/Imp/Samples" />

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="نماذج جرانيت مصري ومستورد"
			pDesc="مجموعة مختصرة من الأنواع الأساسية، مع صفحات فرعية تفصيلية لكل فرع"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d08a28f9a39647a380851767047153fe~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_d08a28f9a39647a380851767047153fe~mv2.png",
								false,
								"نيو حلايب جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("نيو حلايب")}
							pText={Text.Body.Centered.OfText("جرانيت مصري رمادي فاتح للمطابخ والأرضيات والسلالم والواجهات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_8f83511404254389b6f944e4d967d224~mv2.webp/v1/fill/w_580%2Ch_400%2Cal_c%2Cq_80%2Cenc_avif%2Cquality_auto/",
								"498793_8f83511404254389b6f944e4d967d224~mv2.webp",
								false,
								"بلاك أسوان جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("بلاك أسوان")}
							pText={Text.Body.Centered.OfText("جرانيت مصري داكن للكونترات والعتبات والسلالم والتطعيمات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.GreenLite)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_1e54f23307b5474fba3ddf47468660fc~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_1e54f23307b5474fba3ddf47468660fc~mv2.png",
								false,
								"جندولا جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جندولا")}
							pText={Text.Body.Centered.OfText("جرانيت مصري فاتح للمطابخ والكونترات والسلالم الداخلية.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.OrangeLite)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp/v1/fill/w_901%2Ch_676%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/",
								"498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp",
								false,
								"روزا هودي جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("روزا هودي")}
							pText={Text.Body.Centered.OfText("جرانيت مصري وردي دافئ للسلالم والمداخل والأرضيات الكلاسيكية.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"Star-Galaxy-Marble-Stone-Egypt-05-300x300.jpg",
								false,
								"Star Galaxy جرانيت مستورد",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Star Galaxy")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد أسود بنقاط لامعة للمطابخ والكونترات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"blue-pearl-Marble-Stone-Egypt-01-600x600.jpg",
								false,
								"Blue Pearl جرانيت مستورد",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Blue Pearl")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد أزرق معدني للمطابخ الحديثة والحوائط.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"Tan-Brown-Marble-Stone-Egypt-06-600x600.jpg",
								false,
								"Tan Brown جرانيت مستورد",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Tan Brown")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد بني داكن للمطابخ والسلالم والكونترات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"kashmir-white-Marble-Stone-Egypt-07-300x300.jpg",
								false,
								"Kashmir White جرانيت مستورد",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Kashmir White")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد فاتح للمطابخ البيضاء والحمامات والأرضيات الهادئة.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="أختار جرانيت مصري أم مستورد؟"
			pAnswer="الجرانيت المصري مناسب للتنفيذ العملي والميزانية المتزنة والتوفر السريع. الجرانيت المستورد مناسب عند طلب لون خاص أو حركة مميزة مثل الأزرق المعدني أو الأسود اللامع أو البني الدافئ."
		/>

		<FaqItem
			pQuestion="ما أشهر أنواع الجرانيت المصري؟"
			pAnswer="من الأنواع المتداولة: نيو حلايب، حلايب، بلاك أسوان، رمادي الشركة، جندولا، روزا هودي، روزا النصر، أحمر أسوان، أحمر فرسان، وفانتستك وايت."
		/>

		<FaqItem
			pQuestion="ما أشهر أنواع الجرانيت المستورد؟"
			pAnswer="من الأنواع المتداولة: Star Galaxy و Blue Pearl و Baltic Brown و Tan Brown و Double Black و Emerald Pearl و Kashmir White و Moon White و Paradiso و Silver Pearl."
		/>

		<FaqItem
			pQuestion="ما الأفضل للمطبخ؟"
			pAnswer="نيو حلايب وجندولا وبلاك أسوان من المصري، و Star Galaxy و Blue Pearl و Tan Brown و Double Black من المستورد، وكل اختيار يتوقف على لون المطبخ والميزانية وطريقة الاستخدام."
		/>

		<FaqItem
			pQuestion="هل الجرانيت مناسب للواجهات؟"
			pAnswer="نعم، مع اختيار سمك وتشطيب وتثبيت مناسبين. الواجهات تحتاج مراجعة الفواصل والتمدد والارتفاع وطبيعة التعرض للشمس والمطر."
		/>

		<FaqItem
			pQuestion="ما البيانات المطلوبة لعرض السعر؟"
			pAnswer="نحتاج نوع البند، صور المكان، المقاسات التقريبية، نوع الجرانيت المفضل، التشطيب المطلوب، وهل الخدمة توريد فقط أم توريد وتركيب وتشطيب."
		/>

	</EmoFaq>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("خدمات أخرى")}
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.Gray1)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
		pWidth={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}
		pGap={new Pixel(20, 15)}
	>

		<RelServiceItem
			pTitle="تشطيب شقق وفلل"
			pDesc="تنسيق الجرانيت مع المطابخ والسلالم والمداخل والأرضيات ضمن خطة التشطيب."
			pHref="/emocrete/finishing"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="اختيار جرانيت مناسب للمداخل والأرضيات والواجهات التجارية."
			pHref="/emocrete/finishing/retail"
		/>

	</RelServices>







</BLayout>
