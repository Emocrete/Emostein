---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت"
	pDescr="خدمة توريد وتركيب جرانيت مصري ومستورد في القاهرة والجيزة، تشمل اختيار النوع، فرز الألواح، رفع المقاسات، التقطيع، التركيب، التشطيب، وتنفيذ المطابخ والسلالم والأرضيات والواجهات والمداخل والمشايات والعتبات."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب جرانيت")}
				pText={Text.Body.Centered.OfText("جرانيت مصري ومستورد للمطابخ والسلالم والأرضيات والواجهات والمداخل والكونترات")}
			/>

			<Badge
				pLandOnly
				pQualityText="فرز أول"
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="فرز أول"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100,100))}
		/>

	</EmoSec>







	<EmoSec
		id="secMarbleEgImp"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle GreenLite pTitle="أنواع الجرانيت المصري والمستورد" />

		<VrStack>

			<Emograph id="txtEgMarple" pTitle={Text.H3.Centered.AtRight.OfText("جرانيت مصري")} />

			<EmoDet pHref="/emostone/granit/eg" />

			<EmoGallery pFolder="./eg/_M/Samples/Raw" pSize={new Size(new NumPer("100%","100%"),new NumPer(550,600))} data-own-size />

			<Emograph id="txtImpMarple" pTitle={Text.H3.Centered.AtRight.OfText("جرانيت مستورد")} />

			<EmoDet pHref="/emostone/granit/imp" />

			<EmoGallery pFolder="./imp/_M/Samples/Raw" pSize={new Size(new NumPer("100%","100%"),new NumPer(550,600))} data-own-size />

		</VrStack>

	</EmoSec>







</BLayout>
