---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Pixel, EmoMediaData } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, EmoList, RespImg, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت"
	pDescr="خدمة توريد وتركيب جرانيت مصري ومستورد في القاهرة والجيزة، تشمل اختيار النوع، فرز الألواح، رفع المقاسات، التقطيع، التركيب، التشطيب، وتنفيذ المطابخ والسلالم والأرضيات والواجهات والمداخل والمشايات والعتبات."
>







	<Hero
		pImgL="https://static.wixstatic.com/media/498793_d08a28f9a39647a380851767047153fe~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/498793_d08a28f9a39647a380851767047153fe~mv2.png"
		pImgP="https://marblestoneegypt.com/wp-content/uploads/2024/09/Star-Galaxy-Marble-Stone-Egypt-05-300x300.jpg"
		pTitle="توريد وتركيب جرانيت"
		pDesc="جرانيت مصري ومستورد للمطابخ والسلالم والأرضيات والواجهات والمداخل والكونترات"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="42% 42% 10% 8%"
		pPosP="15% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="اطلب ترشيح خامة" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="صفحة الجرانيت الرئيسية"
			pDesc="الجرانيت خامة عملية وقوية، واختيارها يتغير حسب اللون والحبيبات والاستخدام وطريقة التشطيب"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(600, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/498793_d08a28f9a39647a380851767047153fe~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/",
							"498793_d08a28f9a39647a380851767047153fe~mv2.png",
							false,
							"نيو حلايب جرانيت مصري",
							new Size(520, "auto", "100%", "auto")
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("جرانيت مصري")}
						pText={Text.Body.Centered.OfText("اختيارات قوية ومتوفرة للمطابخ والسلالم والمداخل والمشايات والواجهات. من أشهر عائلاته نيو حلايب وحلايب وبلاك أسوان ورمادي الشركة وجندولا وروزا هودي وروزا النصر وأحمر أسوان.")}
						pSize={new Size(520, "auto", "100%", "auto")}
					/>

					<EmoCall BlackSky pText="افتح الجرانيت المصري" />

				</VrStack>

				<VrStack
					pWidth={new Pixel(600, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
							"Star-Galaxy-Marble-Stone-Egypt-05-300x300.jpg",
							false,
							"Star Galaxy جرانيت مستورد",
							new Size(520, "auto", "100%", "auto")
						)}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("جرانيت مستورد")}
						pText={Text.Body.Centered.OfText("اختيارات عالمية للمطابخ والكونترات والحوائط والأرضيات الراقية. من أنواعه Star Galaxy و Blue Pearl و Baltic Brown و Tan Brown و Double Black و Kashmir White و Emerald Pearl.")}
						pSize={new Size(520, "auto", "100%", "auto")}
					/>

					<EmoCall BlackSky pText="افتح الجرانيت المستورد" />

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="اختيار الجرانيت حسب مكان الاستخدام"
			pDesc="المطبخ يحتاج خامة مختلفة عن السلم والواجهة والمشاية والعتبة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("المطابخ والكونترات")}
						pText={Text.Body.Centered.OfText("نيو حلايب وجندولا وبلاك أسوان من المصري، و Star Galaxy و Blue Pearl و Tan Brown و Double Black من المستورد، اختيارات عملية لأسطح المطابخ والجزر.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("السلالم")}
						pText={Text.Body.Centered.OfText("روزا هودي وروزا النصر وحلايب للسلالم العملية، و Baltic Brown و Paradiso و Kashmir Gold للسلالم الداخلية ذات الطابع الدافئ.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.Creamy}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("الأرضيات")}
						pText={Text.Body.Centered.OfText("الأرضيات تحتاج تجانسًا في الدفعة ولونًا مناسبًا للمساحة. الرمادي والفاتح مناسبان للمساحات الواسعة، والداكن مناسب للتطعيمات والحدود.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.GreenLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("الواجهات")}
						pText={Text.Body.Centered.OfText("الواجهات تحتاج سمكًا مناسبًا وتثبيتًا واضحًا وفواصل تمدد. رمادي الشركة وحلايب وسيلفر بيرل وباراديسو اختيارات قابلة للدراسة حسب التصميم.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.OrangeLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("المشايات الخارجية")}
						pText={Text.Body.Centered.OfText("المشايات تحتاج سطحًا فليم أو رملي أو خشن حسب درجة الانزلاق وحركة الاستخدام، مع ميول صرف واضحة وتنظيف مناسب.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("عتبات الأبواب")}
						pText={Text.Body.Centered.OfText("العتبات تحتاج سمكًا مناسبًا وحافة قوية. الأسود والدرجات الداكنة تظهر بوضوح مع الأبواب الخشبية والمداخل الخارجية.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("المداخل")}
						pText={Text.Body.Centered.OfText("المداخل تستفيد من درجات رمادية أو وردية أو داكنة حسب لون الواجهة والإضاءة وحجم الحركة اليومية.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.Creamy}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("الحمامات والبار")}
						pText={Text.Body.Centered.OfText("الجرانيت يصلح للكونترات وأحواض الحمامات والبار، مع اختيار لون يتحمل البقع ويظهر نظيفًا تحت الإضاءة.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="نماذج جرانيت مصري ومستورد"
			pDesc="مجموعة مختصرة من الأنواع الأساسية، مع صفحات فرعية تفصيلية لكل فرع"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.SkyLite)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d08a28f9a39647a380851767047153fe~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_d08a28f9a39647a380851767047153fe~mv2.png",
								false,
								"نيو حلايب جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("نيو حلايب")}
							pText={Text.Body.Centered.OfText("جرانيت مصري رمادي فاتح للمطابخ والأرضيات والسلالم والواجهات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.Creamy)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_8f83511404254389b6f944e4d967d224~mv2.webp/v1/fill/w_580%2Ch_400%2Cal_c%2Cq_80%2Cenc_avif%2Cquality_auto/",
								"498793_8f83511404254389b6f944e4d967d224~mv2.webp",
								false,
								"بلاك أسوان جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("بلاك أسوان")}
							pText={Text.Body.Centered.OfText("جرانيت مصري داكن للكونترات والعتبات والسلالم والتطعيمات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.GreenLite)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_1e54f23307b5474fba3ddf47468660fc~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_1e54f23307b5474fba3ddf47468660fc~mv2.png",
								false,
								"جندولا جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جندولا")}
							pText={Text.Body.Centered.OfText("جرانيت مصري فاتح للمطابخ والكونترات والسلالم الداخلية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.OrangeLite)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp/v1/fill/w_901%2Ch_676%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/",
								"498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp",
								false,
								"روزا هودي جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("روزا هودي")}
							pText={Text.Body.Centered.OfText("جرانيت مصري وردي دافئ للسلالم والمداخل والأرضيات الكلاسيكية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"Star-Galaxy-Marble-Stone-Egypt-05-300x300.jpg",
								false,
								"Star Galaxy جرانيت مستورد",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Star Galaxy")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد أسود بنقاط لامعة للمطابخ والكونترات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"blue-pearl-Marble-Stone-Egypt-01-600x600.jpg",
								false,
								"Blue Pearl جرانيت مستورد",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Blue Pearl")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد أزرق معدني للمطابخ الحديثة والحوائط.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"Tan-Brown-Marble-Stone-Egypt-06-600x600.jpg",
								false,
								"Tan Brown جرانيت مستورد",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Tan Brown")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد بني داكن للمطابخ والسلالم والكونترات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://marblestoneegypt.com/wp-content/uploads/2024/09/",
								"kashmir-white-Marble-Stone-Egypt-07-300x300.jpg",
								false,
								"Kashmir White جرانيت مستورد",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("Kashmir White")}
							pText={Text.Body.Centered.OfText("جرانيت مستورد فاتح للمطابخ البيضاء والحمامات والأرضيات الهادئة.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="تشطيبات الجرانيت"
			pDesc="التشطيب يغير اللمعان والملمس ومقاومة الانزلاق وسهولة التنظيف"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("مصقول")}
					pDesc={Text.Body.Centered.OfText("للمطابخ والداخل اللامع")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"يعطي لمعانًا واضحًا للحبيبات.",
						"مناسب للكونترات والجزر والمداخل المغطاة.",
						"يبرز اللمعات في Star Galaxy و Blue Pearl و Emerald Pearl.",
						"يحتاج حماية أثناء باقي أعمال التشطيب."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("فليم أو رملي")}
					pDesc={Text.Body.Centered.OfText("للمشايات والخارج")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"سطح أقل انزلاقًا من المصقول.",
						"مناسب للمداخل الخارجية والمشايات.",
						"يتحمل الغبار والمطر بدرجة جيدة.",
						"يحتاج تنظيفًا بفرشاة ومنظف مناسب."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("مطفي أو مبروم الحواف")}
					pDesc={Text.Body.Centered.OfText("للتفاصيل والعتبات والدرج")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.OrangeLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"مظهر أهدأ من المصقول.",
						"يناسب السلالم والعتبات والحواف.",
						"الشطف أو التدوير يحافظ على الحافة.",
						"يفضل تحديد الحافة قبل قص القطع."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.BlackOff)} pAlign={Align.Center}>

		<SecTitle
