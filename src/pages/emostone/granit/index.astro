---
import BLayout from "@/Layout.astro";
import { Badge, EmoCall, Emograph, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت"
	pDescr="خدمة توريد وتركيب جرانيت مصري ومستورد في القاهرة والجيزة، تشمل اختيار النوع، فرز الألواح، رفع المقاسات، التقطيع، التركيب، التشطيب، وتنفيذ المطابخ والسلالم والأرضيات والواجهات والمداخل والمشايات والعتبات."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب جرانيت")}
				pText={Text.Body.Centered.OfText("جرانيت مصري ومستورد للمطابخ والسلالم والأرضيات والواجهات والمداخل والكونترات")}
			/>

			<Badge
				pLandOnly
				pQualityText="فرز أول"
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="فرز أول"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100,100))}
		/>

	</EmoSec>







	<EmoSec
		id="secMarbleEgImp"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle GreenLite pTitle="أنواع الجرانيت المصري والمستورد" />

		<DivStr>

			<DivCol>

				<Emograph
					id="txtEgMarple"
					pTitle={Text.H3.Centered.OfText("جرانيت مصري")}
					pSize={new Size(new NumPer(200),new NumPer(30))}
					data-own-size
				/>

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="/Media/Emostone/Granit/Eg/Samples/Raw" />

			</DivCol>

		</DivStr>

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("جرانيت مستورد")} pSize={new Size(new NumPer(200),new NumPer(30))} data-own-size />

			</DivCol>

			<DivCol>

				<EmoGallery pFolder="/Media/Emostone/Granit/Imp/Samples/Raw" />

			</DivCol>

		</DivStr>

	</EmoSec>







</BLayout>
