---
import BLayout from "@/Layout.astro";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
import { EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack } from "@/Widgets";
import { Badge, StoneProductStrip } from "../../../site/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت مستورد"
	pDescr="معرض وخدمة توريد وتركيب جرانيت مستورد في القاهرة والجيزة، يشمل Baltic Brown و Blue Pearl و Star Galaxy و Tan Brown و Double Black و Kashmir White و Emerald Pearl و Paradiso و Multi Red وغيرها، مع استخدامات للمطابخ والسلالم والأرضيات والواجهات والمداخل والكونترات."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب جرانيت مستورد")}
				pText={Text.Body.Centered.OfText("خامات جرانيت عالمية للمطابخ والكونترات والسلالم والأرضيات والواجهات والحوائط المميزة")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pYearsText="سنوات الخبرة"
				pQualityText="فرز أول"
				pWorks={7}
				pWorksText="سابقة الأعمال"
				pMobMaxCols={2}
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







