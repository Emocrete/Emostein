				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("مطابخ وكونترات")}
						pText={Text.Body.Centered.OfText("Blue Pearl و Star Galaxy و Tan Brown و Double Black من الاختيارات المناسبة للكونترات والجزر والمطابخ عالية الاستخدام.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 10)}
					pPad={new Pixel(25, 15)}
