						pTitle={Text.H3.Centered.OfText("ألوان عالمية")}
						pText={Text.Body.Centered.OfText("أسود لامع، أزرق معدني، بني دافئ، أبيض كشمير، ذهبي، أحمر، ورمادي فضي حسب التصميم.")}
