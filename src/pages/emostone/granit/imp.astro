>







	<Hero
		pImgL="https://marblestoneegypt.com/wp-content/uploads/2024/09/Star-Galaxy-Marble-Stone-Egypt-05-300x300.jpg"
		pImgP="https://marblestoneegypt.com/wp-content/uploads/2024/09/blue-pearl-Marble-Stone-Egypt-01-600x600.jpg"
