---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { StoneGallery } from "@/Widgets/Stone";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت مستورد"
	pDescr="معرض وخدمة توريد وتركيب جرانيت مستورد في القاهرة والجيزة، يشمل Baltic Brown و Blue Pearl و Star Galaxy و Tan Brown و Double Black و Kashmir White و Emerald Pearl و Paradiso و Multi Red وغيرها، مع استخدامات للمطابخ والسلالم والأرضيات والواجهات والمداخل والكونترات."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب جرانيت مستورد")}
				pText={Text.Body.Centered.OfText("خامات جرانيت عالمية للمطابخ والكونترات والسلالم والأرضيات والواجهات والحوائط المميزة")}
			/>

			<Badge
				pLandOnly
				pQualityText="فرز أول"
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="فرز أول"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100,100))}
		/>

	</EmoSec>







	<EmoSec>

		<SecTitle pTitle="أنواع الجرانيت المستورد" />

	</EmoSec>







	<StoneGallery pFolder="/Media/Emostone/Granit/Imp/Samples/Raw" pExcel="stones.xlsx" pRequestBuilderId="StoneOrder" />







</BLayout>
