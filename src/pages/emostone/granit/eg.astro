	<EmoSec
		id="ProjectGraniteScope"
		Service
		pBg={new ElemBg("#F2EEE8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cBrownWhite
			pTitle="توريد وتركيب جرانيت مصري للمشروعات والمقايسات"
			pDesc="حزمة تنفيذ موجهة لشركات المقاولات والمطورين والمكاتب الاستشارية، من مراجعة مستندات الطرح حتى التوريد والتركيب والتسليم."
		/>

		<DivStr pBox={new Size(new NumPer("1180px", "100%"))} pGap={new Pixel(22, 14)} pPad={new Pixel(34, 14)}>

			<DivCol pBg={new ElemBg("#FCFAF6")} pPad={new Pixel(30, 20)}>

				<Emograph
					pTitle={Text.H3.WithColor("#26383A").OfText("حزمة قابلة للتسعير والتعاقد")}
					pText={Text.Body.WithColor("#4C5B5D").OfText("نستقبل جدول الكميات والمواصفات والرسومات، ونحدد الخامات والتشطيبات والسماكات والمقاسات ومتطلبات التصنيع والنقل والتركيب، ثم نصدر عرضًا فنيًا وماليًا واضح النطاق يصلح للمراجعة والتعاقد والتنفيذ.")}
				/>

			</DivCol>

			<DivCol pBg={new ElemBg("#E5ECE7")} pPad={new Pixel(30, 20)}>

				<Emograph
					pTitle={Text.H3.WithColor("#26383A").OfText("نطاق بنود المشروعات")}
					pText={Text.Body.WithColor("#435356").OfText("أرضيات ودرج وبسطات ووزرات وجلسات وعتبات، مداخل مبانٍ ومصاعد، كسوات حوائط وواجهات، لاندسكيب ومشايات وبلدورات وأغطية أسوار، وقطع خاصة مصنعة طبقًا للرسومات.")}
				/>

			</DivCol>

			<DivCol pBg={new ElemBg("#E5EAF0")} pPad={new Pixel(30, 20)}>

				<Emograph
					pTitle={Text.H3.WithColor("#26383A").OfText("توريد فقط أو تنفيذ كامل")}
					pText={Text.Body.WithColor("#435356").OfText("تتاح الحزمة كتوريد فقط أو توريد وتركيب كامل وفق نظام التعاقد والبرنامج التنفيذي. الخدمة مخصصة لمقايسات المشروعات والكميات التجارية، وتدار بمنطق المكتب الفني والعقود والمشتريات.")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		id="GranitePricing"
		Service
		pBg={new ElemBg("#EAF1F2")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cSkyLiteBlack
			pTitle="تسعير بنود الجرانيت من مستندات المشروع"
			pDesc="تسعير مرتبط بالـBOQ والرسومات والمواصفات، مع تثبيت الافتراضات وحدود النطاق قبل المقارنة التجارية والتعاقد."
		/>

		<CardsGr
			pWidth={new RespString("1180px", "100%")}
			pCardBg={new ElemBg("#FBFCFC")}
			pGrTitle={Text.H3.Centered.WithColor("#26383A").OfText("منهج دراسة المقايسة")}
			pCardTitleFnt={Text.H4.WithColor("#26383A")}
			pCardBodyFnt={Text.Body.WithColor("#4C5B5D")}
			pStackDir="Row"
			pSpacing={22}
			pTopic1={new Topic(
			"مدخلات التسعير",
			"تدخل المقايسة إلى الدراسة مع ملف الـBOQ والرسومات المعمارية والمواصفات الفنية وجداول التشطيبات والبرنامج المطلوب. يربط التسعير كل بند بالخامة والسمك وتشطيب السطح وأبعاد القطع والحواف وطريقة التصنيع والتركيب وموقع التنفيذ."
		)}
			pTopic2={new Topic(
			"تكوين سعر البند",
			"تشمل الدراسة الخام ونسب الهالك والقص والتجهيز والحليات والمجارير والفتحات والترقيم والتعبئة والنقل والرفع ومستلزمات التركيب والجلي والتشطيب والحماية حتى الاستلام. تصدر الأسعار بنفس وحدات المقايسة مع فصل البنود والبدائل والإضافات."
		)}
			pTopic3={new Topic(
			"ضبط العرض والتعاقد",
			"تراجع العلاقة بين الـBOQ والرسومات والمواصفات، وتسجل البيانات الناقصة والتعارضات في استفسارات فنية، وتثبت افتراضات التسعير وحدود المسؤولية. ويمكن تقسيم العرض حسب المبنى أو المنطقة أو الدور أو مرحلة التسليم لربطه بالبرنامج والتدفقات النقدية والمستخلصات."
		)}
		/>

	</EmoSec>







	<EmoSec
		id="EgyptianGraniteMaterials"
		Service
		pBg={new ElemBg("#EEF2E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cBistageLiteBlack
			pTitle="خامات الجرانيت المصري ضمن جدول تشطيبات المشروع"
			pDesc="ترشيح الخامة يتحول إلى Material Schedule يربط الاسم التجاري بالبند والاستخدام والتشطيب والسمك والمقاس والكمية."
		/>

		<Emograph
			pSize={new Size(new NumPer("1120px", "calc(100% - 28px)"))}
			pText={Text.Body.Centered.WithColor("#435356").OfText("يشمل نطاق الجرانيت المصري المتداول نيو حلايب، حلايب، رمادي الشركة، جندولا، روزا هودي، روزا النصر، أحمر أسوان، أحمر فرسان، فيردي، فيردي غزال، وبلاك أسوان؛ مع مراجعة التوفر والتشغيلة والتشطيب المطلوب لكل مشروع.")}
		/>

		<CardsGr
			pWidth={new RespString("1180px", "100%")}
			pCardBg={new ElemBg("#FBFCF8")}
			pGrTitle={Text.H3.Centered.WithColor("#26383A").OfText("تصنيف الخامات داخل الاعتماد")}
			pCardTitleFnt={Text.H4.WithColor("#26383A")}
			pCardBodyFnt={Text.Body.WithColor("#4C5B5D")}
			pStackDir="Row"
			pSpacing={22}
			pTopic1={new Topic(
			"الخامات الفاتحة والرمادية",
			"تدخل نيو حلايب وحلايب ضمن ترشيحات الجرانيت الأبيض المصري والفاتح، ويغطي رمادي الشركة مسار الجرانيت الرمادي المصري في الأرضيات والدرج والكسوات بحسب التشطيب المعتمد."
		)}
			pTopic2={new Topic(
			"الخامات الدافئة والملونة",
			"تخدم جندولا وروزا هودي وروزا النصر الدرجات الوردية والدافئة، وتوفر فيردي وفيردي غزال بدائل الجرانيت الأخضر المصري، ويغطي بلاك أسوان الدرجات الداكنة، بينما تخدم خامات أسوان وفرسان البنود المحددة بالأحمر."
		)}
			pTopic3={new Topic(
			"البدائل الهندسية والتجارية",
			"يمكن تقديم بدائل تحقق الاتجاه التصميمي ومستهدف التكلفة والمدة، مع بيان أثر كل بديل على سعر البند والتوفر والتوريد. يثبت الاختيار النهائي داخل جدول مواد واضح قبل حجز الكميات وبدء الإنتاج."
		)}
		/>

	</EmoSec>







	<EmoSec
		id="GraniteApproval"
		Service
		pBg={new ElemBg("#F5ECE9")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cCreamyBlack
			pTitle="اعتماد الخامة والتشغيلة قبل الإنتاج"
			pDesc="دورة اعتماد تضبط الخامة المرجعية ومدى تفاوت اللون والحبيبات والتشطيب قبل حجز الكمية وتشغيلها."
		/>

		<CardsGr
			pWidth={new RespString("1180px", "100%")}
			pCardBg={new ElemBg("#FFFDFC")}
			pGrTitle={Text.H3.Centered.WithColor("#3A3030").OfText("مستندات وضوابط الاعتماد")}
			pCardTitleFnt={Text.H4.WithColor("#3A3030")}
			pCardBodyFnt={Text.Body.WithColor("#5B4E4E")}
			pStackDir="Row"
			pSpacing={22}
			pTopic1={new Topic(
			"Material Submittal",
			"يتضمن ملف الاعتماد اسم الخامة والمنشأ والتشطيب والسمك ونطاق المقاسات والعينة المادية وصورًا مأخوذة من التشغيلة أو الكمية المرشحة للتوريد، مع البيانات الفنية وتقارير الاختبارات المطلوبة في مواصفة المشروع."
		)}
			pTopic2={new Topic(
			"الاختبارات والـMockup",
			"عند اشتراط ASTM C615/C615M أو اختبارات أداء محددة تدخل العينات والاختبارات في خطة الاعتماد. تثبت لوحة عينات أو Mockup مرجعًا لمدى اللون والحبيبات والتشطيب خلال التوريد والتركيب."
		)}
			pTopic3={new Topic(
			"حجز الكميات وضبط التشغيلات",
			"بعد الاعتماد تحجز الكمية المتاحة، وتخطط التشغيلات لتقارب القطع الظاهرة داخل المساحة أو الواجهة نفسها. يحد ذلك من إعادة الفرز ويحافظ على ثبات المرجع المعتمد عبر دفعات المشروع."
		)}
		/>

	</EmoSec>







	<EmoSec
		id="GraniteShopDrawings"
		Service
		pBg={new ElemBg("#E9EEF2")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cGray5WhiteOff
			pTitle="مراجعة الرسومات وتجهيز قوائم التقطيع"
			pDesc="تحويل الرسومات المعتمدة إلى Shop Drawings وCutting Lists وأكواد قطع قابلة للتصنيع والتحميل والتركيب."
		/>

		<CardsGr
			pWidth={new RespString("1180px", "100%")}
			pCardBg={new ElemBg("#FCFDFE")}
			pGrTitle={Text.H3.Centered.WithColor("#26383A").OfText("من الرسم إلى أمر الإنتاج")}
			pCardTitleFnt={Text.H4.WithColor("#26383A")}
			pCardBodyFnt={Text.Body.WithColor("#4C5B5D")}
			pStackDir="Row"
			pSpacing={22}
			pTopic1={new Topic(
			"مراجعة تفاصيل القطع",
			"تراجع أبعاد كل قطعة والسمك والحواف الظاهرة والمجارير والفتحات وميول تصريف المياه وفواصل التركيب وتفاصيل التثبيت الميكانيكي. ويحمل كل عنصر كودًا يربطه بالمبنى والمنطقة والدور والبند وموقع التركيب."
		)}
			pTopic2={new Topic(
			"نطاق التصنيع",
			"يشمل ألواح وشرائح وترابيع الجرانيت، نوايم وقوائم السلالم والبسطات والوزرات والجلسات والعتبات وقطع الواجهات والحوائط والمشايات والبلدورات وأعمال Cut-to-Size والمقاسات الخاصة، بالتشطيب المصقول أو المطفي أو المحروق أو المجلخ أو الرملي."
		)}
			pTopic3={new Topic(
			"الترقيم والـDry Lay",
			"توزع أوامر الإنتاج على دفعات حسب أولويات الموقع، وتجمع قطع كل منطقة في بالات أو حوامل مرقمة مع قائمة تحميل. ويمكن تنفيذ Dry Lay للمناطق الحساسة بصريًا وتوثيقها قبل التعبئة لاعتماد التوزيع وتسلسل التركيب."
		)}
		/>

	</EmoSec>







	<EmoSec
		id="GraniteSupplyPlan"
		Service
		pBg={new ElemBg("#EFF1E8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cBistageBlack
			pTitle="توريد مرحلي متوافق مع البرنامج التنفيذي"
			pDesc="دفعات إنتاج وتوريد مرتبطة بالاعتمادات وجاهزية الموقع وأولويات مناطق العمل، مع تتبع واضح للكميات والأكواد."
		/>

		<CardsGr
			pWidth={new RespString("1180px", "100%")}
			pCardBg={new ElemBg("#FCFDF9")}
			pGrTitle={Text.H3.Centered.WithColor("#2F382C").OfText("ضبط حركة التوريد")}
			pCardTitleFnt={Text.H4.WithColor("#2F382C")}
			pCardBodyFnt={Text.Body.WithColor("#50594D")}
			pStackDir="Row"
			pSpacing={22}
			pTopic1={new Topic(
			"خطة مرتبطة بالموقع",
			"تبنى الخطة على تواريخ الاعتماد وإصدار الرسومات وجاهزية الموقع وطاقة التخزين والرفع وأولوية مناطق العمل. تصل كل دفعة ببيان كميات وأكواد ومواقع استخدام قابل للمراجعة والحصر."
		)}
			pTopic2={new Topic(
			"هالك وقطع احتياطية محسوبة",
			"تحدد نسبة القطع الاحتياطية حسب طبيعة البند وتكراره وإمكانية إنتاج بديل مطابق من التشغيلة نفسها، وتراجع الكميات بعد اعتماد قوائم التقطيع لإظهار أثر الهالك والمقاسات الخاصة قبل الإنتاج الكمي."
		)}
			pTopic3={new Topic(
			"تشغيل مستمر للحزم الكبيرة",
			"يمكن إدارة أكثر من خامة وتشطيب داخل برنامج واحد وربط كل دفعة باعتمادها ومنطقة تنفيذها. يدعم ذلك استمرارية فرق التركيب وتقليل مخزون الموقع وتسريع إقفال المناطق وتسليمها تباعًا."
		)}
		/>

	</EmoSec>







	<EmoSec
		id="GraniteQuality"
		Service
		pBg={new ElemBg("#F4EFEA")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			cBrownWhite
			pTitle="تركيب الجرانيت وضبط الجودة بالموقع"
			pDesc="تنفيذ منظم حسب مناطق العمل، مع Method Statement وITP ونقاط فحص تربط الخامة المعتمدة بجودة القطعة المركبة."
		/>

		<DivStr pBox={new Size(new NumPer("1180px", "100%"))} pGap={new Pixel(22, 14)} pPad={new Pixel(34, 14)}>

			<DivCol pBg={new ElemBg("#FCFAF7")} pPad={new Pixel(28, 18)}>

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pTitle={Text.H3.Centered.WithColor("#3C3430").OfText("قبل بدء التنفيذ")}
					pDesc={Text.Body.Centered.WithColor("#655B55").OfText("اعتماد الجاهزية وطريقة العمل والنموذج المرجعي")}
					pHeadBg={new ElemBg("#E8DDD3")}
					pItemsBg={new ElemBg("#FCFAF7")}
					pItemFnt={Text.Body.WithColor("#4F4742")}
					pNumbered={true}
				>

					<ListItem pText="مراجعة جاهزية الأسطح والمناسيب والمحاور والميول والفتحات ونقاط الالتقاء مع البنود الأخرى." />

					<ListItem pText="اعتماد Method Statement وخطة الفحص ITP وفق نظام المشروع." />

					<ListItem pText="تنفيذ واعتماد نموذج العمل الأول قبل تعميمه على باقي المناطق." />

					<ListItem pText="مطابقة الخامة والأكواد والأبعاد والسماكات وحالة الحواف والأسطح قبل التركيب." />

				</EmoList>

			</DivCol>

			<DivCol pBg={new ElemBg("#E6ECEA")} pPad={new Pixel(28, 18)}>

