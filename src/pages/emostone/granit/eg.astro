---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { StoneGallery } from "@/Widgets/Stone";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";

const cInk = "#213235";
const cSlate = "#4B6262";
const cCopper = "#A9705B";
const cClay = "#E4D2C9";
const cSage = "#D5DED4";
const cMist = "#DDE8E5";
const cParchment = "#F3EDE4";
const cBone = "#FAF7F1";

const cCoal = "#17191B";
const cPaper = "#F2EFE8";
const cSignal = "#E3542E";
const cConcrete = "#C9C8C2";
const cWhite = "#FFFDF8";
const cMuted = "#676963";
---





<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت مصري"
	pDescr="معرض وخدمة توريد وتركيب جرانيت مصري، يشمل نيو حلايب، حلايب، بلاك أسوان، رمادي الشركة، جندولا، روزا هودي، روزا النصر، أحمر أسوان، أحمر فرسان، وفانتستك وايت، مع استخدامات للمطابخ والسلالم والأرضيات والواجهات والمشايات والعتبات."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب جرانيت مصري")}
				pText={Text.Body.Centered.OfText("خامات مصرية قوية للمطابخ والسلالم والأرضيات والواجهات والمداخل والمشايات وعتبات الأبواب")}
			/>

			<Badge
				pLandOnly
				pQualityText="فرز أول"
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pPortOnly
			pQualityText="فرز أول"
			pMobMaxCols={2}
			pScopeText="القاهرة والجيزة"
			pTextPos="Top"
			pImgSize={new Size(new NumPer(100,100))}
		/>

	</EmoSec>







	<EmoSec>

		<SecTitle pTitle="أنواع الجرانيت المصري" />

		<EmoGallery pFolder="/Media/Emostone/Granit/Eg/Samples/Raw" />

	</EmoSec>







	<StoneGallery pFolder="/Media/Emostone/Granit/Eg/Samples/Raw" pExcel="stones.xlsx" pRequestBuilderId="StoneOrder" />







</BLayout>
