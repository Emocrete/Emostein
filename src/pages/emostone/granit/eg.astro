---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Topic, Pixel, EmoMediaData } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, EmoList, RespImg, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت مصري"
	pDescr="معرض وخدمة توريد وتركيب جرانيت مصري، يشمل نيو حلايب، حلايب، بلاك أسوان، رمادي الشركة، جندولا، روزا هودي، روزا النصر، أحمر أسوان، أحمر فرسان، وفانتستك وايت، مع استخدامات للمطابخ والسلالم والأرضيات والواجهات والمشايات والعتبات."
>







	<Hero
		pImgL="https://static.wixstatic.com/media/498793_d08a28f9a39647a380851767047153fe~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/498793_d08a28f9a39647a380851767047153fe~mv2.png"
		pImgP="https://static.wixstatic.com/media/498793_8f83511404254389b6f944e4d967d224~mv2.webp/v1/fill/w_580%2Ch_400%2Cal_c%2Cq_80%2Cenc_avif%2Cquality_auto/498793_8f83511404254389b6f944e4d967d224~mv2.webp"
		pTitle="توريد وتركيب جرانيت مصري"
		pDesc="خامات مصرية قوية للمطابخ والسلالم والأرضيات والواجهات والمداخل والمشايات وعتبات الأبواب"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="44% 42% 10% 8%"
		pPosP="15% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="اطلب ترشيح خامة" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="معرض الجرانيت المصري"
			pDesc="الصفحة مخصصة للجرانيت المصري فقط، مع صور لأنواع مؤكدة وروابط استخدام واضحة حسب طبيعة كل مساحة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("محاجر مصرية")}
						pText={Text.Body.Centered.OfText("أنواع مصرية معروفة من عائلات حلايب وأسوان وجندولا وروزا ورمادي الشركة وفانتستك وايت.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("تحمل يومي")}
						pText={Text.Body.Centered.OfText("الجرانيت المصري مناسب للحركة العالية والمطابخ والسلالم والمداخل بسبب صلابته ومقاومته الجيدة للاستخدام.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(15, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.OrangeLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("استخدامات واسعة")}
						pText={Text.Body.Centered.OfText("مطابخ، سلالم، أرضيات، واجهات، مداخل، مشايات، عتبات، كونترات، وأعمال خارجية حسب التشطيب المناسب.")}
						pSize={new Size(350, "auto", "100%", "auto")}
					/>

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أنواع جرانيت مصري بالصور"
			pDesc="الصور التالية مرتبطة بأسماء أنواع مصرية محددة، وتم تجنب الأنواع التي لم تتوفر لها صورة مؤكدة باسمها"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d08a28f9a39647a380851767047153fe~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_d08a28f9a39647a380851767047153fe~mv2.png",
								false,
								"نيو حلايب جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("نيو حلايب")}
							pText={Text.Body.Centered.OfText("حبيبات رمادية وبيضاء وسوداء، مناسب للمطابخ والسلالم والأرضيات والواجهات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_12db851a083c48d1bbcf0bd192f8694b~mv2.webp/v1/fill/w_863%2Ch_690%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/",
								"498793_12db851a083c48d1bbcf0bd192f8694b~mv2.webp",
								false,
								"حلايب جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("حلايب")}
							pText={Text.Body.Centered.OfText("جرانيت مصري فاتح الحبيبات، مناسب للأرضيات والمداخل والدرج والكونترات.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_8f83511404254389b6f944e4d967d224~mv2.webp/v1/fill/w_580%2Ch_400%2Cal_c%2Cq_80%2Cenc_avif%2Cquality_auto/",
								"498793_8f83511404254389b6f944e4d967d224~mv2.webp",
								false,
								"بلاك أسوان جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("بلاك أسوان")}
							pText={Text.Body.Centered.OfText("أسود مصري من أسوان، مناسب للمطابخ والعتبات والسلالم والتطعيمات والواجهات الراقية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_3108bc83e20443189c1e8dc3e6d8173b~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_3108bc83e20443189c1e8dc3e6d8173b~mv2.png",
								false,
								"رمادي الشركة جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("رمادي الشركة")}
							pText={Text.Body.Centered.OfText("درجة رمادية عملية، مناسبة للأرضيات الخارجية والمداخل والمشايات والسلالم.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_1e54f23307b5474fba3ddf47468660fc~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_1e54f23307b5474fba3ddf47468660fc~mv2.png",
								false,
								"جندولا جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جندولا")}
							pText={Text.Body.Centered.OfText("جرانيت مصري فاتح، مناسب للمطابخ والكونترات والأرضيات والسلالم الداخلية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp/v1/fill/w_901%2Ch_676%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/",
								"498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp",
								false,
								"روزا هودي جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("روزا هودي")}
							pText={Text.Body.Centered.OfText("درجة وردية دافئة، مناسبة للسلالم والمداخل والأرضيات ذات الطابع الكلاسيكي.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_71766e43e6274ee8a913ac1d5795fdda~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_71766e43e6274ee8a913ac1d5795fdda~mv2.png",
								false,
								"جندولا جرانيت مصري في مطبخ",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جندولا للمطابخ")}
							pText={Text.Body.Centered.OfText("صورة استخدام لجرانيت جندولا في سطح مطبخ، مع حبيبات هادئة وسطح عملي.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_3d3208c93da84f9891b6305ab0338475~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_3d3208c93da84f9891b6305ab0338475~mv2.png",
								false,
								"سطح مطبخ من جندولا جرانيت مصري",
								new Size(280, "auto", "100%", "auto")
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("سطح مطبخ مصري")}
							pText={Text.Body.Centered.OfText("تطبيق عملي لجرانيت مصري في كونتر مطبخ مع فتحات وتجهيزات يومية.")}
							pSize={new Size(260, "auto", "100%", "auto")}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="أنواع مصرية متداولة حسب اللون"
			pDesc="القائمة التالية تجمع أسماء مصرية متداولة في السوق، مع فصلها حسب العائلة اللونية والاستخدام"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("درجات رمادي وفاتح")}
					pDesc={Text.Body.Centered.OfText("للمطابخ والأرضيات والمداخل العملية")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"نيو حلايب.",
						"حلايب.",
						"رمادي الشركة.",
						"جندولا.",
						"فانتستك وايت.",
						"كريستال وايت عند توفره."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("درجات أسود وداكن")}
					pDesc={Text.Body.Centered.OfText("للتطعيمات والمطابخ والعتبات والواجهات الراقية")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"بلاك أسوان.",
						"ماجيك نوار عند التوفر.",
						"درجات داكنة من بعض عائلات حلايب.",
						"يستخدم الأسود في الكونترات والعتبات والتطعيمات."
					]}
				/>

				<EmoList
					pWidth={new RespString("400px", "100%")}
					pTitle={Text.H3.Centered.OfText("درجات حمراء ووردية وخضراء")}
					pDesc={Text.Body.Centered.OfText("للسلالم والمداخل والأرضيات ذات الطابع الكلاسيكي")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.OrangeLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						"أحمر أسوان.",
						"أحمر فرسان.",
						"روزا النصر.",
						"روزا هودي.",
						"رويال رد.",
						"فيردي غزال أو فيردي جرين حسب التسمية المتداولة."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="استخدامات الجرانيت المصري"
			pDesc="الجرانيت المصري مناسب للمساحات التي تحتاج سطحًا قويًا وتحملًا للحركة والتنظيف المتكرر"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(20, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("المطابخ")}
						pText={Text.Body.Centered.OfText("نيو حلايب وجندولا وبلاك أسوان اختيارات عملية لأسطح المطابخ والجزيرات والفتحات اليومية.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("السلالم")}
						pText={Text.Body.Centered.OfText("روزا هودي وروزا النصر وحلايب ونيو حلايب تناسب السلالم عند اختيار سمك وتشطيب وحافة مناسبة.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.Creamy}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("الأرضيات")}
						pText={Text.Body.Centered.OfText("الأرضيات التجارية والمداخل العامة تحتاج جرانيتًا متماسكًا في اللون والحبيبات مع تركيب مضبوط وفواصل منتظمة.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.GreenLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("الواجهات")}
						pText={Text.Body.Centered.OfText("الواجهات تحتاج نوعًا يتحمل الشمس والمطر والغبار، مع تثبيت مناسب وفواصل تمدد واضحة.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.OrangeLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("المشايات الخارجية")}
						pText={Text.Body.Centered.OfText("المشايات تحتاج سطحًا مقاومًا للانزلاق، لذلك يناسبها التشطيب الفليم أو الرملي أو الخشن حسب الموقع.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("عتبات الأبواب")}
						pText={Text.Body.Centered.OfText("العتبات تحتاج سمكًا مناسبًا وقطعًا نظيفًا وحافة قوية تتحمل الاحتكاك والتنظيف المستمر.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px;`}
						pTitle={Text.H4.Centered.OfText("المداخل")}
						pText={Text.Body.Centered.OfText("المداخل تستفيد من درجات رمادية أو وردية أو سوداء حسب لون الواجهة وحركة الدخول اليومية.")}
						pSize={new Size(300, "auto", "100%", "auto")}
					/>

					<Emograph
