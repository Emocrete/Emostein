---
import BLayout from "@/Layout.astro";
import { Badge, EmoCall, Emograph, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { StoneInfoCard } from "@/Widgets/Stone";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="توريد وتركيب جرانيت مصري"
	pDescr="معرض وخدمة توريد وتركيب جرانيت مصري، يشمل نيو حلايب، حلايب، بلاك أسوان، رمادي الشركة، جندولا، روزا هودي، روزا النصر، أحمر أسوان، أحمر فرسان، وفانتستك وايت، مع استخدامات للمطابخ والسلالم والأرضيات والواجهات والمشايات والعتبات."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("توريد وتركيب جرانيت مصري")}
				pText={Text.Body.Centered.OfText("خامات مصرية قوية للمطابخ والسلالم والأرضيات والواجهات والمداخل والمشايات وعتبات الأبواب")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pYearsText="سنوات الخبرة"
				pQualityText="فرز أول"
				pWorks={7}
				pWorksText="سابقة الأعمال"
				pMobMaxCols={2}
			/>

			<EmoCall BlackSky pText="اطلب عرض سعر" />

		</VrStack>

	</Hero>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="معرض الجرانيت المصري"
			pDesc="الصفحة مخصصة للجرانيت المصري فقط، مع صور لأنواع مؤكدة وروابط استخدام واضحة حسب طبيعة كل مساحة"
		/>

		<StoneInfoCard
			pKind="جرانيت مصري"
			pName="أسود أسوان"
			pDesc="جرانيت مصري فاخر مناسب للمداخل والسلالم والكونترات والمشروعات الراقية، يجمع بين اللون العميق والصلابة العالية."
			pImg="/Media/Emostone/Granit/Eg/HeroL.webp"
			pImgAlt="عينة جرانيت أسود أسوان"
			pBadge="الأكثر طلبًا"
			pColor="أسود"
			pTexture="حبيبات متوسطة"
			pSizes={["120 × 240", "100 × 300", "60 × 120"]}
			pPrimaryHref="/contact"
			pSecondaryHref="#details"
		/>

	</EmoSec>







	<EmoSec
		hidden
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أنواع جرانيت مصري بالصور"
			pDesc="الصور التالية مرتبطة بأسماء أنواع مصرية محددة، وتم تجنب الأنواع التي لم تتوفر لها صورة مؤكدة باسمها"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d08a28f9a39647a380851767047153fe~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_d08a28f9a39647a380851767047153fe~mv2.png",
								false,
								"نيو حلايب جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("نيو حلايب")}
							pText={Text.Body.Centered.OfText("حبيبات رمادية وبيضاء وسوداء، مناسب للمطابخ والسلالم والأرضيات والواجهات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_12db851a083c48d1bbcf0bd192f8694b~mv2.webp/v1/fill/w_863%2Ch_690%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/",
								"498793_12db851a083c48d1bbcf0bd192f8694b~mv2.webp",
								false,
								"حلايب جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("حلايب")}
							pText={Text.Body.Centered.OfText("جرانيت مصري فاتح الحبيبات، مناسب للأرضيات والمداخل والدرج والكونترات.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_8f83511404254389b6f944e4d967d224~mv2.webp/v1/fill/w_580%2Ch_400%2Cal_c%2Cq_80%2Cenc_avif%2Cquality_auto/",
								"498793_8f83511404254389b6f944e4d967d224~mv2.webp",
								false,
								"بلاك أسوان جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("بلاك أسوان")}
							pText={Text.Body.Centered.OfText("أسود مصري من أسوان، مناسب للمطابخ والعتبات والسلالم والتطعيمات والواجهات الراقية.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_3108bc83e20443189c1e8dc3e6d8173b~mv2.png/v1/fill/w_1000%2Ch_800%2Cal_c%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_3108bc83e20443189c1e8dc3e6d8173b~mv2.png",
								false,
								"رمادي الشركة جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("رمادي الشركة")}
							pText={Text.Body.Centered.OfText("درجة رمادية عملية، مناسبة للأرضيات الخارجية والمداخل والمشايات والسلالم.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

				<HzStack pGap={new Pixel(20, 15)} pPad={new Pixel(0, 0)}>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_1e54f23307b5474fba3ddf47468660fc~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_1e54f23307b5474fba3ddf47468660fc~mv2.png",
								false,
								"جندولا جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جندولا")}
							pText={Text.Body.Centered.OfText("جرانيت مصري فاتح، مناسب للمطابخ والكونترات والأرضيات والسلالم الداخلية.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp/v1/fill/w_901%2Ch_676%2Cal_c%2Cq_85%2Cenc_avif%2Cquality_auto/",
								"498793_d570c1360fc6420f9152825f44cc39d5~mv2.webp",
								false,
								"روزا هودي جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("روزا هودي")}
							pText={Text.Body.Centered.OfText("درجة وردية دافئة، مناسبة للسلالم والمداخل والأرضيات ذات الطابع الكلاسيكي.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_71766e43e6274ee8a913ac1d5795fdda~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_71766e43e6274ee8a913ac1d5795fdda~mv2.png",
								false,
								"جندولا جرانيت مصري في مطبخ",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("جندولا للمطابخ")}
							pText={Text.Body.Centered.OfText("صورة استخدام لجرانيت جندولا في سطح مطبخ، مع حبيبات هادئة وسطح عملي.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

					<VrStack
						pWidth={new Pixel(300, 340)}
						pGap={new Pixel(15, 10)}
						pPad={new Pixel(15, 10)}
						pBgColor={new ElemBg(Colors.WhiteOff)}
					>

						<RespImg
							pImg={new EmoMediaData(
								"Img",
								"https://static.wixstatic.com/media/498793_3d3208c93da84f9891b6305ab0338475~mv2.png/v1/fill/w_558%2Ch_398%2Cq_90%2Cenc_avif%2Cquality_auto/",
								"498793_3d3208c93da84f9891b6305ab0338475~mv2.png",
								false,
								"سطح مطبخ من جندولا جرانيت مصري",
								new Size(new NumPer(280, "100%"), new NumPer("auto", "auto"))
							)}
						/>

						<Emograph
							pTitle={Text.H4.Centered.OfText("سطح مطبخ مصري")}
							pText={Text.Body.Centered.OfText("تطبيق عملي لجرانيت مصري في كونتر مطبخ مع فتحات وتجهيزات يومية.")}
							pSize={new Size(new NumPer(260, "100%"), new NumPer("auto", "auto"))}
						/>

					</VrStack>

				</HzStack>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="ما أشهر أنواع الجرانيت المصري؟"
			pAnswer="من الأنواع المتداولة: نيو حلايب، حلايب، بلاك أسوان، أحمر أسوان، رمادي الشركة، جندولا، روزا النصر، روزا هودي، أحمر فرسان، رويال رد، وفانتستك وايت."
		/>

		<FaqItem
			pQuestion="ما أفضل جرانيت مصري للمطابخ؟"
			pAnswer="نيو حلايب وجندولا وبلاك أسوان من الاختيارات العملية للمطابخ، مع مراعاة لون التصميم والميزانية والسمك وطريقة قص فتحات الحوض والبوتاجاز."
		/>

		<FaqItem
			pQuestion="هل بلاك أسوان جرانيت مصري؟"
			pAnswer="نعم، بلاك أسوان من الجرانيت المصري المعروف، ويستخدم في المطابخ والسلالم والعتبات والواجهات والتطعيمات."
		/>

		<FaqItem
			pQuestion="هل الجرانيت المصري مناسب للواجهات؟"
			pAnswer="نعم، بعض أنواع الجرانيت المصري مناسبة للواجهات عند اختيار سمك وتشطيب وطريقة تثبيت مناسبة، مع مراعاة الفواصل والتمدد والعوامل الجوية."
		/>

		<FaqItem
			pQuestion="ما التشطيب الأنسب للمشايات الخارجية؟"
			pAnswer="التشطيب الفليم أو الرملي أو الخشن يناسب المشايات والمداخل الخارجية لأنه يقلل الانزلاق مقارنة بالسطح المصقول."
		/>

	</EmoFaq>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("خدمات مرتبطة بالجرانيت المصري")}
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.Gray1)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
		pWidth={new Size(new NumPer(1300, "calc(100% - 30px)"), new NumPer("auto", "auto"))}
		pGap={new Pixel(20, 15)}
	>

		<RelServiceItem
			pTitle="توريد وتركيب رخام وجرانيت"
			pDesc="الخدمة العامة لتوريد وتركيب الرخام والجرانيت والكوارتز والحجر الطبيعي."
			pHref="/emostone"
		/>

		<RelServiceItem
			pTitle="تشطيب شقق وفلل"
			pDesc="تنسيق الجرانيت المصري مع المطابخ والسلالم والمداخل والأرضيات ضمن خطة التشطيب."
			pHref="/emocrete/finishing"
		/>

	</RelServices>







</BLayout>
