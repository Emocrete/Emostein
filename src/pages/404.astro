---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, SiteSearch404, VrStack } from "@/Widgets/Comp";
import { EmoSec, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Pixel, Text } from "@/TypesLib";

Astro.response.status = 404;
---




















<BLayout
	pTitle="الرابط المطلوب غير موجود"
	pDescr="الرابط المطلوب غير موجود، ويمكنك استخدام البحث أو الروابط التالية للوصول إلى خدمات المجموعة الهندسية."
	pSchema=""
	pIntro={false}
>







	<EmoSec>

		<VrStack
			pWidth={new Pixel(1200, 340)}
			pGap={new Pixel(25, 15)}
			pPad={new Pixel(45, 20)}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("الرابط المطلوب غير موجود")}
				pText={Text.Body.Centered.OfText("ربما تم تغيير عنوان الصفحة، أو توجد كتابة غير دقيقة في الرابط. استخدم البحث التالي للوصول إلى أقرب خدمة أو صفحة داخل الموقع.")}
			/>

			<SiteSearch404 pMaxResults={12} />

			<EmoCall BlackSky pText="اتصال مباشر" />

		</VrStack>

	</EmoSec>







	<ReadAlso
		pTitle={Text.H2.Centered.OfText("ابدأ من الصفحات الرئيسية")}
		pDesc={Text.Body.Centered.OfText("يمكنك الوصول إلى أقسام الموقع الأساسية من الروابط التالية.")}
	>

		<ReadAlsoItem
			pTitle="الصفحة الرئيسية"
			pDesc="المدخل العام إلى أقسام وخدمات المجموعة الهندسية."
			pHref="/"
		/>

		<ReadAlsoItem
			pTitle="خدمات التراخيص"
			pDesc="تراخيص المحلات والمباني والأنشطة التجارية والطبية."
			pHref="/emoperm"
		/>

		<ReadAlsoItem
			pTitle="الخدمات الطبية"
			pDesc="ترخيص وتجهيز ورسم الصيدليات والعيادات والمنشآت الطبية."
			pHref="/emomed"
		/>

		<ReadAlsoItem
			pTitle="الخدمات الاستشارية"
			pDesc="التقارير والشهادات والأختام الهندسية والاستشارية."
			pHref="/emonsult"
		/>

	</ReadAlso>







	<RelServices
		pTitle={Text.H2.White.Centered.OfText("خدمات يبحث عنها الزوار غالبًا")}
		pDesc={Text.Body.White.Centered.OfText("لو كنت تبحث عن خدمة محددة، فقد تكون إحدى هذه الصفحات هي المقصودة.")}
	>

		<RelServiceItem
			pTitle="ترخيص محل تجاري"
			pDesc="خدمة متابعة واستخراج ترخيص المحلات التجارية."
			pHref="/emoperm/retail/general"
			pBtnText="افتح الخدمة"
		/>

		<RelServiceItem
			pTitle="رسم هندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لملف ترخيص المحل."
			pHref="/emoperm/retail/general/dwg"
			pBtnText="افتح الخدمة"
		/>

		<RelServiceItem
			pTitle="ترخيص صيدلية"
			pDesc="خدمات متعلقة بترخيص الصيدليات وقياس المسافات والرسم الهندسي."
			pHref="/emomed/pharmacy"
			pBtnText="افتح الخدمة"
		/>

		<RelServiceItem
			pTitle="ختم مهندس نقابي"
			pDesc="خدمات الختم الهندسي من مهندس نقابي للرسومات والتقارير."
			pHref="/emonsult/stamp/eng"
			pBtnText="افتح الخدمة"
		/>

	</RelServices>







</BLayout>
