---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, RadialItem, RadialLayout } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="ترخيص محطة شحن سيارات كهربائية"
	pDescr="ترخيص محطة شحن سيارات كهربائية — خدمة هندسية أولية لتجهيز ملف محطة الوقود أو التعديل المطلوب بها، تشمل مراجعة الموقع والحركة والمباني والخدمات ومتطلبات السلامة والجهات ذات العلاقة. وفي هذه الصفحة يكون التركيز الخاص على الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="ترخيص محطة شحن سيارات كهربائية">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("ترخيص محطة شحن سيارات كهربائية")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("خدمة هندسية أولية لتجهيز ملف محطة الوقود أو التعديل المطلوب بها، تشمل مراجعة الموقع والحركة والمباني والخدمات ومتطلبات السلامة والجهات ذات العلاقة. وفي هذه الصفحة يكون التركيز الخاص على الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<RadialLayout pCount={4} pDiameter={new RespString("820px","96%")} pOrbit={new RespString("38%","36%")} pCenterSize={new RespString("30%","36%")} pBg={Colors.Gray1} pCenterBg={Colors.BrownDark} pCenterColor={Colors.WhiteOff} pRingColor={Colors.Gray3} pAccent={Colors.Bistage} pCenterTitle="ترخيص محطة شحن سيارات كهربائية" pCenterText="مسار الخدمة" pStackPortrait={true}>
		<RadialItem pTitle="المدخلات" pText="مراجعة الموقع والمداخل والحركة والمسافات مع مراعاة الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة" pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<RadialItem pTitle="المعالجة" pText="تنسيق المتطلبات المعمارية والميكانيكية والحريق" pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<RadialItem pTitle="المخرج" pText="إعداد قائمة الموافقات والرسومات المطلوبة" pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
		<RadialItem pTitle="الفائدة" pText="تساعد على اكتشاف التعارضات التخطيطية والفنية قبل الدخول في تكلفة التصميم والتنفيذ والموافقات المتتابعة. ويُراجع القرار هنا تحديدًا في ضوء الأحمال والطلب والتزامن والحماية والهبوط في الجهد واستمرارية الخدمة." pBg={Colors.BistageLite} pColor={Colors.Black} pAccent={Colors.BistageDark} />
	</RadialLayout>

	<AngleBand id="secSrvCost" pBg={Colors.Black} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 20,000 ج.م للدراسة والملف الهندسي المبدئي؛ الرسوم والتصميمات التفصيلية منفصلة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
