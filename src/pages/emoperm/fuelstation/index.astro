---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="ترخيص محطة وقود"
	pDescr="خدمة مراجعة ومتابعة ملف ترخيص محطة وقود، تشمل فحص الموقع والواجهة والمساحة والمسافات البينية ومخططات المحطة وموافقات الجهات المختصة والحماية المدنية قبل السير في الترخيص."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("30%","100%"))}
			pLoc={new Loc(new NumPer("5%","0%"),new NumPer("5%","12%"))}
			pGap={new Pixel(20, 10)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.Bold.OfText("ترخيص محطة وقود")}
				pText={Text.Body.Centered.OfSize(24,18).OfText("إعداد ملف الترخيص والمتابعة مع الجهات المختلفة حتى صدور الرخصة")}
			/>

			<EmoCall data-own-size BlackOrange pText="التفاصيل" />

		</VrStack>

	</Hero>







	<EmoSec
		id="station-site"
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle Gray2 pTitle="اشتراطات موقع محطة الوقود" />

		<EmoStr pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<CardsGr
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("المساحة والواجهة", "تراجع مساحة الأرض وطول الواجهة وقدرة الموقع على استيعاب الطرمبات والخزانات والمظلة والمداخل والمخارج والمباني الملحقة دون تزاحم.")}
				pTopic2={new Topic("المسافة البينية", "يفحص موقع المحطة بالنسبة للمنافذ القائمة على نفس اتجاه الطريق، لأن المسافة البينية من أسباب رفض الموقع حتى لو كانت الأرض مناسبة تجاريًا.")}
				pTopic3={new Topic("الدخول والخروج", "توزيع المداخل والمخارج ودوران السيارات داخل الأرض يجب أن يخدم التشغيل ولا يسبب تعارضًا مروريًا أو خطورة على الطريق.")}
				pTopic4={new Topic("الجهات ذات الولاية", "طريق عام، زراعة، ري، آثار، بيئة، مرور، حي أو مجلس مدينة، أو جهاز مدينة؛ كل جهة قد تغير مسار الملف حسب موقع الأرض.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="station-approvals"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			SkyLite
			pTitle="مسار موافقات محطة الوقود"
			pDesc="الملف يتحرك بين شركة التسويق والهيئة المختصة والجهات المحلية والفنية، ولا يصح اختزال الترخيص في رخصة مباني أو رسم هندسي فقط."
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1050px", "100%")}
				pHeadBg={new ElemBg(Colors.Creamy)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pNumbered={true}
				pItems={[
					"تجميع بيانات الأرض: الملكية أو التخصيص أو الحيازة، المساحة، الواجهة، الطريق، والجهة الإدارية التابعة لها.",
					"مراجعة مبدئية لصلاحية الموقع هندسيًا وتسويقيًا وتنظيميًا قبل الدخول في الرسومات النهائية.",
					"التعامل مع شركة تسويق معتمدة أو المسار المناسب للحصول على موافقة مبدئية على منفذ التسويق بالموقع المقترح.",
					"معاينة الموقع على الطبيعة للتأكد من الاشتراطات الأساسية والمسافات والواجهة وإمكانية التشغيل.",
					"تجهيز المخطط العام للمحطة وتوزيع الخزانات والطرمبات والمظلات ومباني الخدمة والمداخل والمخارج.",
					"استكمال موافقات الجهات المختصة مثل الجهة المحلية، الطرق، المرور، البيئة، الدفاع المدني، والزراعة أو غيرها حسب موقع الأرض.",
					"إدخال ملاحظات الجهات على التصميم والتشغيل ثم تجهيز ملف الترخيص النهائي.",
					"متابعة إصدار رخصة التشغيل أو تحديد الاستيفاءات المطلوبة قبل التشغيل الفعلي."
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="station-fire"
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="الحماية المدنية والسلامة داخل محطة الوقود"
			pDesc="موافقة الحماية المدنية في محطة الوقود مرتبطة بتصميم الموقع نفسه: الخزانات، نقاط التموين، مصادر الكهرباء، معدات الإطفاء، مسارات الحركة، وعدم وجود مصادر خطورة غير مسموح بها."
		/>

		<EmoStr pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(24, 16)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("580px", "100%")}
					pTitle={Text.H3.Centered.White.OfText("نقاط يجب إظهارها في المخطط")}
					pHeadBg={new ElemBg(Colors.Gray5)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"أماكن خزانات الوقود وفتحات الملء والتهوية.",
						"أماكن الطرمبات ونقاط التموين ومسارات السيارات.",
						"مسافات الأمان بين مصادر الخطورة والعناصر الأخرى داخل المحطة.",
						"شبكة أو وسائل مكافحة الحريق ومواقع طفايات الحريق ولوحات الكهرباء.",
						"مخارج ومداخل المحطة ومسارات الإخلاء والحركة."
					]}
				/>

				<EmoList
					pWidth={new RespString("580px", "100%")}
					pTitle={Text.H3.Centered.White.OfText("مخاطر شائعة توقف الملف")}
					pHeadBg={new ElemBg(Colors.Gray5)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={false}
					pItems={[
						"توزيع خزانات أو طرمبات دون مراعاة المسافات المطلوبة.",
						"تعارض الدخول والخروج مع الطريق أو الحركة المرورية.",
						"إضافة أنشطة ملحقة لا تراعي حدود السلامة داخل المحطة.",
						"عدم وضوح مصادر الكهرباء ومنع الشرر والصواعق والتأريض.",
						"تقديم مخطط تجاري جميل لكنه غير قابل للدفاع أمام فحص الحماية المدنية."
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="مستندات ومخططات ملف محطة الوقود"
			pDesc="الملف النهائي يتغير حسب موقع الأرض وشركة التسويق والجهات المطلوبة، لكن هذه العناصر تمثل العمود الأساسي للتحضير قبل التقديم."
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<CardsGr
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("مستندات الأرض", "عقد الملكية أو التخصيص أو سند الحيازة، كروكي الموقع، بيانات الطريق، الواجهة، المساحة، والجهة الإدارية المختصة.")}
				pTopic2={new Topic("مخطط عام", "توزيع الطرمبات والخزانات والمظلة ومبنى الخدمة والميني ماركت إن وجد والمداخل والمخارج ومسارات السيارات.")}
				pTopic3={new Topic("ملف السلامة", "تحديد الخزانات ومصادر الخطورة ومسافات الأمان ومعدات الإطفاء والتأريض والصواعق ولوحات الكهرباء طبقًا لملاحظات الجهة المختصة.")}
				pTopic4={new Topic("موافقات الجهات", "الدفاع المدني، المرور، البيئة، الطرق، الزراعة، الآثار، الجهة المحلية أو جهاز المدينة، وأي جهة تظهر بسبب موقع الأرض أو طبيعة الطريق.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="station-service"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			Gray2
			pTitle="خدمة ترخيص محطة وقود"
			pDesc="الخدمة موجهة لمالك أرض أو مستثمر يريد تقييم موقعه وتجهيز ملفه الهندسي والإداري قبل التقديم أو أثناء الاستيفاءات."
		/>

		<EmoStr pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(24, 16)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("بنود الخدمة")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"فحص مبدئي لموقع الأرض والمساحة والواجهة والجهة التابعة لها.",
						"مراجعة صلاحية الموقع بالنسبة للمسافات والمداخل والمخارج واشتراطات التشغيل.",
						"إعداد أو مراجعة المخطط العام للمحطة قبل عرضه على الجهات.",
						"تحديد قائمة الموافقات المطلوبة حسب موقع الأرض.",
						"متابعة الاستيفاءات الفنية والإدارية وربطها بالمخطط والمستندات.",
						"تنسيق التعديلات الهندسية اللازمة للوصول إلى ملف قابل للفحص."
					]}
				/>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("الخدمة لا تشمل")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={false}
					pItems={[
						"رسوم الجهات الحكومية أو رسوم المعاينات الرسمية.",
						"تكلفة تنفيذ المحطة أو المظلات أو الخزانات أو معدات الإطفاء.",
						"أتعاب شركة التسويق أو أي جهة فنية خارج نطاق الاتفاق.",
						"ضمان قبول موقع يخالف اشتراطات جوهرية لا يمكن تعديلها هندسيًا."
					]}
				/>

			</HzStack>

			<EmoCall BlackSky pText="ابدأ مراجعة موقع المحطة" />

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يكفي أن تكون الأرض على طريق رئيسي؟"
			pAnswer="لا. الطريق ميزة تجارية، لكن الترخيص يحتاج فحص المساحة والواجهة والمسافة البينية والمداخل والمخارج والجهات ذات الولاية وملاحظات الحماية المدنية."
		/>

		<FaqItem
			pQuestion="ما أول خطوة قبل عمل رسومات محطة الوقود؟"
			pAnswer="الأفضل مراجعة صلاحية الموقع مبدئيًا، لأن إنتاج رسومات نهائية لموقع غير صالح قد يهدر وقتًا وتكلفة دون نتيجة."
		/>

		<FaqItem
			pQuestion="هل محطة الوقود تحتاج موافقات كثيرة؟"
			pAnswer="نعم غالبًا؛ لأن الملف قد يمر على جهات مرتبطة بالطريق والمرور والبيئة والدفاع المدني والجهة المحلية وجهات أخرى حسب موقع الأرض."
		/>

		<FaqItem
			pQuestion="هل يمكن تعديل المخطط بعد ملاحظات الجهات؟"
			pAnswer="نعم إذا كانت الملاحظات قابلة للحل داخل حدود الأرض. أما إذا كان سبب الرفض متعلقًا بمسافة أو ولاية أو قيد جوهري فقد لا يكفي تعديل المخطط وحده."
		/>

	</EmoFaq>







	<ReadAlso>

		<ReadAlsoItem pTitle="تراخيص إدارية" pDesc="مدخل عام لخدمات التراخيص الإدارية داخل الموقع." pHref="/emoperm" />

		<ReadAlsoItem pTitle="ترخيص مصنع" pDesc="خدمة تجهيز ومتابعة ملف رخصة تشغيل مصنع أو منشأة صناعية." pHref="/emoperm/factory" />

		<ReadAlsoItem pTitle="ترخيص بناء" pDesc="خدمات تراخيص البناء والرسومات والمراجعات الهندسية للأراضي والمباني." pHref="/emoperm/building" />

	</ReadAlso>







	<RelServices>

		<RelServiceItem
			pTitle="تصميم هندسي"
			pDesc="إعداد الرسومات المعمارية والإنشائية والكهرباء والميكانيكا اللازمة للمباني والمظلات والمرافق."
			pHref="/emodsign/des/eng"
		/>

		<RelServiceItem
			pTitle="إشراف هندسي"
			pDesc="متابعة تنفيذ الأعمال أو التعديلات المطلوبة بالموقع بعد اعتماد المخطط أو أثناء الاستيفاءات."
			pHref="/emonsult/consulting/supervision"
		/>

		<RelServiceItem
			pTitle="تقرير سلامة"
			pDesc="تقرير أو مراجعة هندسية عند الحاجة إلى توضيح عناصر السلامة أو حالة منشآت قائمة بالموقع."
			pHref="/emonsult/report/safety"
		/>

	</RelServices>







</BLayout>
