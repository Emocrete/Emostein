---
import BLayout from "@/Layout.astro";
import { Badge, EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="LocalBusiness"
	pTitle="تراخيص إدارية"
	pDescr="تراخيص إدارية"
>







	<Hero pImgAlt="طائرة ورقية تذهب في الفضاء تعبر عن الرسم الهندسي لترخيص محل تجاري بأنه يذهب ولا يعود ويقبل من المرة الأولى">

		<VrStack
			pHzAlign="Center"
			pVrAlign="Center"
			pSize={new Size(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("55%","2.5%"),new NumPer("20%","15%"))}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("تراخيص إدارية")}
				pText={Text.Body.Centered.White.OfText("تراخيص بناء - محلات - مصانع - محطات وقود - إعلانات")}
			/>

			<EmoCall BlackSky />

		</VrStack>

		<VrStack
			pLandOnly
			pSize={new Size(new NumPer("60%","95%"))}
			pLoc={new Loc(new NumPer("40%","2.5%"),new NumPer("65%","60%"))}
			data-own-size
		>

			<Badge
				pYears={6}
				pWorks={120}
				pDuration={24}
				pDurationText="خلال يوم واحد"
			/>

		</VrStack>

	</Hero>







</BLayout>
