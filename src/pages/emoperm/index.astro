---
import BLayout from "@/Layout.astro";
import { DirectSize, NumPer,  Loc,HoverColors,Text, ElemBg, EmoMediaData, Colors, Pixel, Topic, Size, Align, RespString } from "@/TypesLib";
import { Hero, IndexSec, ESec,VrStack,Emograph,EmoCall, EmoStrip,Badge, IncLineSep, BottTriSep, EmoBtn, YTPlayer, DataCard, CardsGr, EmoList, Tree } from "@/Widgets";
---




















<BLayout
	pSchemaType="LocalBusiness"
	pTitle="تراخيص إدارية"
	pDescr="تراخيص إدارية"
>







	<Hero pImgAlt="طائرة ورقية تذهب في الفضاء تعبر عن الرسم الهندسي لترخيص محل تجاري بأنه يذهب ولا يعود ويقبل من المرة الأولى">

		<VrStack
			pAlign="Center"
			pSize={new DirectSize(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("55%","2.5%"),new NumPer("20%","15%"))}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("تراخيص إدارية")}
				pText={Text.Body.Centered.White.OfText("تراخيص بناء - محلات - مصانع - محطات وقود - إعلانات")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="للطلب والاستفسار"
			/>

		</VrStack>

		<Emograph
			pTitle={Text.Body.Bold.OfSize(60,40).Centered.OfText("يذهب ..............")}
			pText={Text.Body.Bold.OfSize(60,40).OfText("ولا يعود ;)")}
			pSize={new DirectSize(new NumPer("20%","80%"))}
			pLoc={new Loc(new NumPer("30%","10%"),new NumPer("20%","40%"))}
		/>

		<VrStack
			pLandOnly
			pSize={new DirectSize(new NumPer("60%","95%"))}
			pLoc={new Loc(new NumPer("40%","2.5%"),new NumPer("65%","60%"))}
			data-own-size
		>

			<Badge
				pYears={6}
				pWorks={120}
				pDuration={24}
				pDurationText="خلال يوم واحد"
			/>

		</VrStack>

	</Hero>







</BLayout>
