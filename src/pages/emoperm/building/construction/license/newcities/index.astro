		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<VrStack pGap={new Pixel(28, 16)} pPad={new Pixel(34, 14)}>

				<Emograph
					pTitle={Text.H3.Centered.OfText("اللوحات يجب أن تجيب على أسئلة الجهاز")}
					pText={Text.Body.WithAlign("right").OfText(`رسومات ترخيص المدن الجديدة لا يجب أن تكون مجرد مساقط جميلة. اللوحات يجب أن توضح حدود القطعة، الردود، خط البناء، النسبة البنائية، البدروم، أماكن الانتظار، السور، غرف السطح، المناور، الواجهات، القطاعات، مناسيب الدخول، علاقة المبنى بالشارع، وغرف الخدمات عند وجودها. كما يجب أن يظهر التوافق بين المعماري والإنشائي، لأن تعارض الأعمدة أو المناور أو السلالم مع المساقط المعمارية يخلق ملاحظات فنية لا علاقة لها بالمستندات الإدارية. وعند التقديم الإلكتروني يجب تجهيز نسخة PDF مقروءة ونسخة CAD منظمة ومضغوطة بالطريقة المطلوبة، لأن الملف الرقمي غير المرتب قد يسبب رفضًا أو استيفاءً حتى لو كان التصميم في جوهره صحيحًا.`)}
					pSize={new Size(new NumPer(1080, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pCardBg={new ElemBg(Colors.SkyLite)}
					pGrTitle={Text.H3.Centered.OfText("مكونات الرسومات")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("الموقع العام", "حدود القطعة، الشوارع، الردود، المدخل، السور، أماكن الانتظار، وموقع المبنى داخل الأرض.")}
					pTopic2={new Topic("المساقط المعمارية", "كل دور مرخص: بدروم، أرضي، متكرر، غرف سطح، خدمات، مناور، سلالم، ومداخل.")}
					pTopic3={new Topic("الواجهات والقطاعات", "إثبات الارتفاع، المناسيب، الطابع المعماري، الفتحات، وخطوط البروز أو الارتداد.")}
					pTopic4={new Topic("الإنشائي والجسات", "أساسات، أعمدة، كمرات، أسقف، تقرير تربة، ونوتة حسابية عند طلبها أو عندما تفرض الحالة ذلك.")}
