---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="ترخيص تعلية بالمدن الجديدة"
	pDescr="خدمة مراجعة واستخراج ترخيص تعلية أو تعديل أو إضافة مبانٍ داخل المدن الجديدة التابعة لهيئة المجتمعات العمرانية، مع فحص رخصة المبنى السابقة، كود الأرض، بيان الصلاحية، موقف التنفيذ، قدرة المبنى على تحمل التعلية، وثيقة التأمين، وملف التقديم الإلكتروني بجهاز المدينة."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("ترخيص تعلية بالمدن الجديدة")}
				pText={Text.Body.Centered.OfText("التعلية داخل جهاز المدينة ليست قرارًا فوق السطح؛ هي مراجعة لكود الأرض والرخصة السابقة واشتراطات الجهاز وقدرة المبنى على تحمل الدور الجديد")}
			/>

			<Emograph pText={Text.Body.Bold.Centered.OfText("القاهرة الجديدة - التجمع - أكتوبر - الشيخ زايد - العبور - بدر")} />

			<EmoCall BlackSky pText="تواصل معنا" />

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="ثلاث بوابات قبل ترخيص التعلية"
			pDesc="في المدن الجديدة لا يكفي أن يكون السطح خاليًا أو أن المالك يريد دورًا إضافيًا؛ يجب أن يمر الطلب من بوابة الجهاز وبوابة الرخصة السابقة وبوابة السلامة الإنشائية"
		/>

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(420, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("١")}
						pText={Text.H4.Centered.OfText("هل جهاز المدينة يسمح؟")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pText={Text.Body.Centered.OfText("يجب قراءة بيان الصلاحية أو الاشتراطات أو كراسة المنطقة: الردود، الارتفاع، غرف السطح، نسبة البناء، الطابع المعماري، وموقف أي قرارات خاصة بالتعلية أو زيادة المسطح.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(420, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("٢")}
						pText={Text.H4.Centered.OfText("هل الرخصة السابقة صالحة للبناء عليها؟")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pText={Text.Body.Centered.OfText("التعلية لا تبدأ من سطح قائم فقط؛ تبدأ من رخصة سابقة ورسومات معتمدة وموقف تنفيذي يثبت أن المبنى القائم نفسه مفهوم ومطابق أو قابل لتصحيح موقفه.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(420, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.GreenLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("٣")}
						pText={Text.H4.Centered.OfText("هل المبنى يتحمل؟")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pText={Text.Body.Centered.OfText("حتى لو الجهاز يسمح بالارتفاع، لا يصح التقديم بدون فحص إنشائي يقرأ الأساسات والأعمدة والأسقف والأحمال الجديدة وإمكانية التدعيم عند الحاجة.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="مستندات ترخيص التعلية بالمدن الجديدة"
			pDesc="القائمة النهائية يحددها جهاز المدينة ونوع الخدمة، لكن هذا هو الملف الذي نراجعه قبل رفع الطلب"
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات جهاز المدينة")}
					pDesc={Text.Body.Centered.OfText("تثبت أن الطلب قابل للتعامل داخل ملف القطعة")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						{ Title: "بيانات المالك والقطعة", Items: ["صورة بطاقة المالك أو مستندات الشركة.", "محضر الاستلام أو العقد أو إخطار التخصيص.", "كود الأرض وبيانات المدينة والمنطقة ورقم القطعة.", "توكيل أو تفويض للمكتب الهندسي عند المتابعة."] },
						{ Title: "موقف مالي وإداري", Items: ["موقف الأقساط والمستحقات والمهلة.", "أي رخصة سابقة أو طلب تعديل أو تحديد موقف تنفيذي.", "أي غرامات أو مخالفات أو طلبات تصالح مرتبطة بالقطعة."] },
						{ Title: "بيان صلاحية واشتراطات", Items: ["بيان الصلاحية أو الاشتراطات السارية.", "كراسة الشروط أو النموذج المعماري للمنطقة.", "ما يخص غرف السطح أو الارتفاع أو الردود أو النسبة."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("650px", "100%")}
					pTitle={Text.H3.Centered.OfText("مستندات هندسية وتأمينية")}
					pDesc={Text.Body.Centered.OfText("تثبت أن التعلية آمنة وقابلة للمراجعة")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.GreenLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						{ Title: "الرخصة والواقع", Items: ["رخص البناء السابقة.", "الرسومات المعتمدة القديمة إن وجدت.", "رفع معماري وإنشائي للحالة القائمة عند غياب اللوحات.", "صور ومعاينة السطح والأدوار القائمة."] },
						{ Title: "تقرير التحمل", Items: ["تقرير يوضح قدرة المبنى والأساسات على تحمل أعمال التعلية.", "نوتة أو مراجعة إنشائية عند الحاجة.", "تقرير تربة أو اختبارات إذا تطلبت الحالة ذلك."] },
						{ Title: "ملف الترخيص", Items: ["رسومات معمارية للتعلية.", "رسومات إنشائية وتدعيم إن وجد.", "شهادة صلاحية الأعمال.", "بيان قيمة الأعمال.", "وثيقة التأمين عند اللزوم."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="وثيقة التأمين ليست تفصيلة في التعلية"
			pDesc="أعمال التعلية تدخل في نطاق مراجعة أخطار البناء، لذلك يجب تجهيز الملف كملف مسؤولية لا كملف رسومات فقط"
		/>

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.WithAlign("right").OfText("لماذا التعلية مختلفة في التأمين؟")}
					pText={Text.Body.WithAlign("right").OfText(`في البناء الجديد يكون الخطر مرتبطًا بمنشأ سيبدأ من الأرض. في التعلية، الخطر مرتبط بمنشأ قائم بالفعل: أساسات تحملت سنوات، أعمدة وكمرات منفذة، سكان أو مستخدمون، سطح عليه أحمال، وربما تعديلات لم تكن في اللوحات. لذلك وثيقة التأمين في التعلية ليست ورقة مالية فقط؛ هي نتيجة ملف هندسي قابل للمراجعة: تقرير تحمل، رسومات معمارية وإنشائية، قيمة أعمال، مهندس، ومقاول. وكلما كان الملف غير منظم أو الرخصة السابقة غامضة، زادت احتمالات الاستيفاء قبل إصدار الرخصة.`)}
					pSize={new Size(new NumPer(750, "100%"), new NumPer("auto", "auto"))}
				/>

				<VrStack
					pWidth={new Pixel(450, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H4.Centered.OfText("قبل التأمين")}
						pText={Text.Body.Centered.OfText("حدد قيمة الأعمال، عدد الأدوار، نطاق التعلية، تقرير التحمل، وهل التعلية لطابق كامل أم جزء من السطح.")}
						pSize={new Size(new NumPer(400, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H4.Centered.OfText("بعد التأمين")}
						pText={Text.Body.Centered.OfText("لا يبدأ التنفيذ إلا بعد استكمال الرخصة والتأمين والإشراف والمقاول والمسؤوليات المطلوبة طبقًا للملف.")}
						pSize={new Size(new NumPer(400, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Sky};`}
			pTitle="طريقة العمل في خدمة ترخيص التعلية"
			pDesc="نبدأ من صلاحية الحالة لا من إنتاج لوحات، لأن اللوحات الضعيفة فوق وضع غير محسوم لا تتحول إلى رخصة"
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("800px", "100%")}
					pTitle={Text.H3.Centered.OfText("مسار الخدمة")}
					pDesc={Text.Body.Centered.OfText("ست مراحل، وكل مرحلة قد تغير التي بعدها")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={true}
					pItems={[
						{ Title: "قراءة بيانات القطعة", Items: ["المدينة، المنطقة، رقم القطعة، نوع الطرح، كود الأرض، محضر الاستلام أو العقد."] },
						{ Title: "قراءة الرخصة السابقة", Items: ["الرخصة، الرسومات القديمة، الموقف التنفيذي، أي تعديلات أو مخالفات أو طلبات سابقة."] },
						{ Title: "معاينة ورفع القائم", Items: ["السطح، السلالم، المناور، الأعمدة، الاستخدامات، أحمال السطح، ومطابقة الواقع بالرخصة."] },
						{ Title: "فحص التحمل", Items: ["تقرير إنشائي، مراجعة الأساسات والأعمدة، تحديد الحاجة لتدعيم أو رفض التعلية."] },
						{ Title: "إعداد ملف التعلية", Items: ["رسومات، شهادة صلاحية، بيان قيمة أعمال، تأمين، ملفات PDF/CAD، ومستندات المكتب."] },
						{ Title: "التقديم والمتابعة", Items: ["رفع الطلب، متابعة الاستيفاءات، السداد، اعتماد الرخصة، ثم تسليم ملف التنفيذ."] }
					]}
				/>

				<VrStack
					pWidth={new Pixel(400, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.Creamy)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("مطلوب منك في البداية")}
						pText={Text.Body.Centered.OfText("صورة من الرخصة السابقة، رقم القطعة، اسم المدينة والمنطقة، صور السطح والواجهة، وبيان هل توجد غرف أو خزانات أو تنفيذ سابق فوق السطح.")}
						pSize={new Size(new NumPer(350, "100%"), new NumPer("auto", "auto"))}
					/>

					<EmoCall BlackSky pText="ابدأ مراجعة التعلية" />

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل ترخيص التعلية في المدن الجديدة هو نفسه استكمال الروف؟"
			pAnswer="لا. قد يتشابه الكلام في السوق، لكن إداريًا يجب فصل التعلية أو التعديل أو الإضافة عن طلب زيادة مسطح المباني بدور السطح. استكمال الروف له صفحة ومسار خاصان لأنه يرتبط بنسبة مسطح الدور العلوي وقرارات محددة."
		/>

		<FaqItem
			pQuestion="هل أستطيع إضافة دور إذا كان المبنى منفذًا برخصة قديمة؟"
			pAnswer="وجود رخصة قديمة لا يكفي. يجب مراجعة هل التنفيذ مطابق للرخصة، وهل بيان الصلاحية والاشتراطات الحالية يسمحان بالارتفاع، وهل المبنى يتحمل إنشائيًا."
		/>

		<FaqItem
			pQuestion="هل التقديم يتم إلكترونيًا؟"
			pAnswer="المدن الجديدة تشهد توسعًا في التقديم الإلكتروني لخدمات تراخيص المباني عبر بوابة خدمات هيئة المجتمعات العمرانية، لكن تفاصيل الإتاحة ونوع الخدمة وما يطلبه الجهاز تختلف حسب المدينة والطلب."
		/>

		<FaqItem
			pQuestion="هل تقرير التحمل الإنشائي ضروري؟"
			pAnswer="في التعلية يجب التعامل مع تقرير التحمل كقرار أساسي، لأنه يحدد قدرة الأساسات والعناصر الإنشائية القائمة على تحمل الأحمال الجديدة أو الحاجة إلى تدعيم."
		/>

		<FaqItem
			pQuestion="ماذا لو كان هناك مخالفات أو تنفيذ غير مطابق؟"
			pAnswer="قد لا يكون المسار المناسب هو طلب تعلية مباشر. يمكن أن تحتاج الحالة إلى تحديد موقف تنفيذي أو تعديل أو تصالح أو تصحيح بيانات قبل تقديم التعلية."
		/>

		<FaqItem
			pQuestion="هل وثيقة التأمين مطلوبة في التعلية؟"
			pAnswer="أعمال التعلية من الحالات التي ترتبط عادة بوثيقة تأمين أخطار أعمال البناء، لذلك يجب تجهيز الرسومات والتقرير الإنشائي وبيان قيمة الأعمال بصورة قابلة للمراجعة."
		/>

		<FaqItem
			pQuestion="هل تختلف القاهرة الجديدة عن الشروق أو أكتوبر في التعلية؟"
			pAnswer="نعم. الاختلاف لا يكون في اسم الخدمة فقط، بل في كراسة المنطقة، النموذج المعماري، الارتفاع، الردود، الموقف التنفيذي، ونوع الطرح داخل كل جهاز."
		/>

		<FaqItem
			pQuestion="ما أول مستند أرسله للمراجعة؟"
			pAnswer="أرسل رخصة البناء السابقة إن وجدت، رقم القطعة والمدينة والمنطقة، صورة محضر الاستلام أو العقد، صور السطح والواجهة، وأي رسومات قديمة أو ملاحظات عن تعديلات أو شروخ."
		/>

	</EmoFaq>







	<ReadAlso>

		<ReadAlsoItem
			pTitle="تراخيص البناء بالمدن الجديدة"
			pDesc="الصفحة الرئيسية لخدمة تراخيص البناء داخل أجهزة المدن الجديدة، من بيان الصلاحية حتى إصدار الرخصة."
			pHref="/emoperm/building/newcities/construction"
		/>

		<ReadAlsoItem
			pTitle="ترخيص استكمال روف"
			pDesc="خدمة مستقلة لحالات زيادة مسطح المباني بدور السطح أو استكمال غرف السطح وفقًا لاشتراطات الجهاز."
			pHref="/emoperm/building/newcities/construction/increase"
		/>

		<ReadAlsoItem
			pTitle="ترخيص تعلية بالأحياء"
			pDesc="تعلية مبنى داخل حي قائم في القاهرة أو الجيزة، بمسار مختلف عن جهاز المدينة."
			pHref="/emoperm/building/districts/construction/addition"
		/>

	</ReadAlso>







	<RelServices>

		<RelServiceItem pTitle="تقارير وشهادات هندسية" pDesc="تقارير تحمل إنشائي وشهادات فنية قبل التعلية أو التعديل على مبنى قائم." pHref="/emonsult/report" />

		<RelServiceItem
			pTitle="تصميم معماري وإنشائي"
			pDesc="إعداد رسومات التعلية والتدعيم وربط الدور الجديد بالمبنى القائم واشتراطات جهاز المدينة."
			pHref="/emodsign"
		/>

		<RelServiceItem
			pTitle="إشراف هندسي على البناء"
			pDesc="متابعة تنفيذ التعلية بعد صدور الترخيص طبقًا للرسومات والتأمين ومتطلبات السلامة."
			pHref="/emonsult/consulting/supervision/construction"
		/>

	</RelServices>







</BLayout>
