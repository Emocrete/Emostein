---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, EmoMediaData, Colors,DirectSize,Loc,NumPer, Pixel, Topic, Size, Align, RespString } from "@/TypesLib";
import { Hero, IndexSec, ESec, EmoStrip,Badge, EmoBtn, IndexBtn, EmoCall, CardsGr, EmoList, Emograph, RespImg, EmoFaq, ReadAlso, RelServices, EmoPipelineStrip, SecTitle, VrStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="التصالح على مخالفات البناء"
	pDescr="خدمة هندسية متخصصة لتجهيز ومراجعة ومتابعة ملفات التصالح على مخالفات البناء في مصر، مع فرز نوع المخالفة، إعداد الرسومات والتقرير الهندسي، تنظيم المستندات، ومتابعة الاستيفاءات والتظلمات."
>







	<Hero pImgAlt="عمارات سكنية مخالفة تم تسوية وضعها القانوني وعمل تقارير السلامة الإنشائية للتصالح">

		<VrStack
			pAlign="Center"
			pSize={new DirectSize(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("35%","15%"))}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("تقرير السلامة الإنشائية للتصالح في مخالفات البناء")}
				pText={Text.Body.Centered.White.OfText("خدمة احترافية لإعداد الرسم الهندسي المطلوب لترخيص محل تجاري لأي نشاط")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="للطلب والاستفسار"
			/>

		</VrStack>

		<VrStack
			pLandOnly
			pSize={new DirectSize(new NumPer("60%","95%"))}
			pLoc={new Loc(new NumPer("40%","2.5%"),new NumPer("65%","60%"))}
			data-own-size
		>

			<Badge
				pYears={6}
				pWorks={120}
				pDuration={24}
				pDurationText="خلال يوم واحد"
			/>

		</VrStack>

	</Hero>







	<IndexSec pMedia={new EmoMediaData("Vid", "/Media/", "IndexBgVid.mp4")}>

		<VrStack>

			<IndexBtn pText="خريطة الحالات" onclick="location.href='#case-map'" />

			<IndexBtn pText="البناء بدون ترخيص" onclick="location.href='#no-license'" />

			<IndexBtn pText="مخالفة الترخيص" onclick="location.href='#license-violation'" />

			<IndexBtn pText="تغيير الاستخدام" onclick="location.href='#use-change'" />

			<IndexBtn pText="خارج الحيز" onclick="location.href='#urban-boundary'" />

		</VrStack>

		<VrStack>

			<IndexBtn pText="أملاك وجهات ولاية" onclick="location.href='#state-and-authorities'" />

			<IndexBtn pText="المستندات" onclick="location.href='#documents'" />

			<IndexBtn pText="الرسومات والتقرير" onclick="location.href='#engineering-file'" />

			<IndexBtn pText="المسار الإداري" onclick="location.href='#admin-path'" />

			<IndexBtn pText="التظلم والرفض" onclick="location.href='#objections'" />

		</VrStack>

	</IndexSec>







	<ESec
		id="case-map"
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="خريطة ملف التصالح تبدأ من نوع المخالفة"
			pDesc="التعامل الصحيح مع التصالح يبدأ بتسمية الحالة بدقة، لأن كل مسار له مستندات ورسومات ومخاطر وقراءة هندسية مختلفة."
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1200, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("التشخيص الفني والإداري هو نقطة البداية")}
					pText={Text.Body.OfText("ملف التصالح الناجح يتكون من قراءة قانونية وفنية في وقت واحد. المطلوب معرفة نوع المخالفة، تاريخها التقريبي، علاقتها بالترخيص السابق إن وجد، موقف الأرض من الحيز أو المخطط أو جهة الولاية، طبيعة الاستخدام القائم، وأثر الأعمال على السلامة الإنشائية. هذه القراءة تحدد شكل الرسومات المطلوبة، نوع التقرير الهندسي، المستندات التي تثبت التاريخ والصفة، والجهات التي قد تطلب موافقات إضافية قبل عرض الملف على لجنة البت.")}
					pSize={new Size(1120, "auto", "100%", "auto")}
				/>

				<CardsGr
					pWidth={new RespString("1200px", "100%")}
					pCardBg={new ElemBg(Colors.SkyLite)}
					pGrTitle={Text.H3.Centered.OfText("الأنواع العملية التي نقابلها في ملفات التصالح")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pStackDir="Row"
					pSpacing={20}
					pTopic1={new Topic("بناء بدون ترخيص", "مبنى أو جزء من مبنى أقيم دون رخصة، ويحتاج رسومات رفع وبيان مساحات وتقرير سلامة ومستندات تثبت تاريخ الأعمال وصفة مقدم الطلب.")}
					pTopic2={new Topic("مخالفة رخصة قائمة", "الأعمال لها أصل ترخيص، لكن التنفيذ اختلف في المساحة أو الارتفاع أو التوزيع أو الردود أو الاستخدام أو عناصر أخرى بالرسومات المعتمدة.")}
					pTopic3={new Topic("زيادة أدوار أو تعلية", "تحتاج قراءة إنشائية خاصة لأن الزيادة تؤثر على الأحمال والأساسات والأعمدة، وتحتاج حصر مسطح كل دور مخالف بدقة.")}
					pTopic4={new Topic("تغيير استخدام", "يشمل تحويل سكني إلى إداري أو تجاري أو تحويل جراج أو بدروم أو دور أرضي إلى نشاط مختلف، وغالبًا يحتاج مراجعة اشتراطات المنطقة والمرافق والحماية المدنية.")}
					pTopic5={new Topic("حالة خارج الحيز أو بنطاق خاص", "قد ترتبط بالزراعة أو الأحوزة العمرانية أو القرى أو الكتل السكنية أو جهات الولاية، ويجب فحصها قبل دفع تكاليف ملف كامل.")}
					pTopic6={new Topic("ملف سابق أو مرفوض", "قد يكون للمالك طلب قديم أو إيصال جدية أو قرار رفض أو استيفاء قديم، وهنا تختلف طريقة التعامل عن الطلب الجديد كليًا.")}
				/>

			</EmoStrip>

		</ESec>

		<ESec
			id="license-violation"
			pBg={new ElemBg(Colors.WhiteOff)}
			pAlign={Align.Center}
		>

			<SecTitle
				style = {`--StripBg:${Colors.SkyLite};`}
				pTitle="حالة مخالفة الترخيص الصادر"
				pDesc="عند وجود رخصة أصلية تصبح المقارنة بين المعتمد والمنفذ هي محور الملف، ويجب قراءة كل فرق قبل تحويله إلى بند تصالح."
			/>

			<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

				<VrStack
					pWidth={new Pixel(1200, 340)}
					pGap={new Pixel(25, 15)}
					pPad={new Pixel(30, 15)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("الرخصة القديمة نقطة مرجعية")}
						pText={Text.Body.OfText("وجود رخصة بناء قديمة يساعد في فهم الأصل القانوني للمبنى، لكنه يكشف أيضًا الفروق التي نفذت على الطبيعة. قد يكون الفرق في مساحة الدور، نسبة البناء، الردود، الارتفاع، عدد الوحدات، البدروم، السطح، الواجهات، أو توزيع الاستخدام. لذلك تبدأ الخدمة بمقارنة الرخصة والرسومات المعتمدة مع الوضع الحالي، ثم حصر المخالفات القابلة للإدراج في الطلب.")}
						pSize={new Size(1120, "auto", "100%", "auto")}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("أهمية مطابقة اللوحات")}
						pText={Text.Body.OfText("اللجنة تتعامل مع الرسومات والمستندات كبيانات رسمية. وجود لوحة قديمة، لوحة رفع، وصف مخالفة، جدول مساحات، وطلب إلكتروني بأرقام مختلفة يفتح باب الاستيفاء أو الرفض. لذلك تتم مراجعة كل رقم ومساحة ووصف قبل تقديم الطلب، مع فصل ما هو مرخص عما هو مخالف بوضوح.")}
						pSize={new Size(1120, "auto", "100%", "auto")}
					/>

					<CardsGr
						pWidth={new RespString("1200px", "100%")}
						pCardBg={new ElemBg(Colors.Creamy)}
						pGrTitle={Text.H3.Centered.OfText("أنواع الفروق بين الترخيص والواقع")}
						pCardTitleFnt={Text.H4}
						pCardBodyFnt={Text.Body}
						pStackDir="Row"
						pSpacing={20}
						pTopic1={new Topic("مساحة إضافية", "زيادة في المسطح المبني عن الرسومات المعتمدة، سواء داخل حدود الدور أو ببروز أو توسعة أو إغلاق فراغ.")}
						pTopic2={new Topic("ارتفاع أو أدوار", "إضافة دور أو جزء دور أو غرف سطح أو تعلية بالمخالفة للترخيص الأصلي.")}
						pTopic3={new Topic("تغيير توزيع", "تعديل في التقسيم الداخلي قد يؤثر على المناور أو الخدمات أو عدد الوحدات أو الاستخدام.")}
						pTopic4={new Topic("ردود ومناور", "البناء داخل الردود أو تضييق منور أو إغلاق فراغ تهوية أو فتحات مخالفة.")}
						pTopic5={new Topic("بدروم وجراج", "تغيير وظيفة البدروم أو الجراج أو استخدامه كوحدات أو محال أو مخازن.")}
						pTopic6={new Topic("واجهة وفتحات", "تغيير في الواجهات أو الفتحات أو البلكونات قد يحتاج توصيفًا هندسيًا إذا ارتبط بمخالفة مسطح أو شكل معتمد.")}
					/>

				</VrStack>

			</EmoStrip>

		</ESec>

		<ESec
			id="use-change"
			pBg={new ElemBg(Colors.Gray1)}
			pAlign={Align.Center}
		>

			<SecTitle
				style = {`--StripBg:${Colors.Gray5};`}
				pTitle="تغيير الاستخدام السكني أو التجاري أو الإداري"
				pDesc="تغيير الاستخدام من أهم مسارات التصالح لأنه يرتبط بنشاط العقار والمرافق والحي والاشتراطات، مع تأثير المساحة ضمن الصورة العامة."
			/>

			<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

				<VrStack
					pWidth={new Pixel(1200, 340)}
					pGap={new Pixel(25, 15)}
					pPad={new Pixel(30, 15)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("تغيير الاستخدام يحتاج قراءة المنطقة")}
						pText={Text.Body.OfText("تحويل وحدة سكنية إلى إداري أو تجاري، أو تحويل بدروم أو جراج إلى محال أو مخازن، أو استخدام دور أرضي لنشاط خدمي، كلها حالات تحتاج فحص اشتراطات المنطقة والنشاط والمدخل والمرافق والجراجات والحماية المدنية. المسطح قد يكون ثابتًا، لكن طبيعة الاستخدام تغير تقييم الجهة للحالة وتغير المستندات المطلوبة.")}
						pSize={new Size(1120, "auto", "100%", "auto")}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("العقد والرخصة والنشاط")}
						pText={Text.Body.OfText("قد تكون الوحدة مباعة كسكني بينما تعمل كعيادة أو مكتب أو محل، وقد تكون الرخصة الأصلية تجيز نشاطًا معينًا بينما الواقع نشاط آخر. لذلك نراجع مستند الملكية والرخصة القديمة والواقع الحالي واحتياجات النشاط، ثم نحدد هل الملف تصالح تغيير استخدام مستقل أم يحتاج ترخيص نشاط لاحقًا أو رسم هندسي للنشاط أو موافقات منفصلة.")}
						pSize={new Size(1120, "auto", "100%", "auto")}
					/>

					<CardsGr
						pWidth={new RespString("1200px", "100%")}
						pCardBg={new ElemBg(Colors.WhiteOff)}
						pGrTitle={Text.H3.Centered.OfText("صور تغيير الاستخدام المتكررة")}
						pCardTitleFnt={Text.H4}
						pCardBodyFnt={Text.Body}
						pStackDir="Row"
						pSpacing={20}
						pTopic1={new Topic("سكني إلى إداري", "مكتب أو عيادة أو مركز تعليمي أو نشاط مهني داخل وحدة سكنية.")}
						pTopic2={new Topic("سكني إلى تجاري", "محل أو معرض أو نشاط بيع مباشر في دور أرضي أو وحدة مفتوحة على الشارع.")}
						pTopic3={new Topic("جراج إلى نشاط", "تحويل أماكن انتظار السيارات إلى محال أو مخازن أو ورش أو وحدات.")}
						pTopic4={new Topic("بدروم إلى نشاط", "استغلال البدروم كمخزن أو محل أو مركز خدمات، مع حساسية التهوية والحريق والمخارج.")}
						pTopic5={new Topic("سطح أو ملحق", "استخدام غرف سطح كوحدة مستقلة أو نشاط تجاري أو إداري.")}
						pTopic6={new Topic("تغيير داخلي", "تعديل فراغات وحدة بما يخدم نشاطًا جديدًا ويحتاج رسومات ونظام تشغيل لاحق.")}
					/>

					<EmoList
						pWidth={new RespString("1120px", "100%")}
						pTitle={Text.H3.Centered.OfText("ما نراجعه قبل قبول تغيير الاستخدام")}
						pDesc={Text.Body.Centered.OfText("هذه المراجعة تحمي العميل من البدء في ملف يحتاج موافقات إضافية أو نشاطًا غير ملائم للمكان.")}
						pHeadBg={new ElemBg(Colors.WhiteOff)}
						pItemsBg={new ElemBg(Colors.Creamy)}
						pNumbered={true}
						pItems={[
							{
								Title: "موقع الوحدة",
								Items: [
									"الدور ومدخل الوحدة واتصالها بالشارع أو السلم.",
									"عرض الواجهة وعدد الفتحات وأثر النشاط على الجيران.",
									"وجود جراج أو بدروم أو مناور أو مخارج طوارئ.",
								],
							},
							{
								Title: "المستند الأصلي",
								Items: [
									"رخصة البناء أو الرسم المعتمد إن وجد.",
									"عقد الملكية أو الإيجار ووصف الاستخدام داخله.",
									"أي موافقة سابقة من الحي أو اتحاد الملاك أو الجهة المالكة.",
								],
							},
							{
								Title: "طبيعة النشاط",
								Items: [
									"النشاط الحالي أو المقترح بعد التصالح.",
									"احتياجات الحماية المدنية أو الصحة أو البيئة عند وجود نشاط خاص.",
									"تأثير النشاط على المرافق والتحميل والحركة.",
								],
							},
							{
								Title: "المسار اللاحق",
								Items: [
									"تحديد هل التصالح يعالج الوضع البنائي وحده أو يحتاج مسارًا إضافيًا.",
									"تحديد هل يلزم ترخيص محل أو عيادة أو حضانة أو نشاط آخر بعد ذلك.",
									"تجهيز الرسم الهندسي المناسب للنشاط عند طلبه.",
								],
							},
					]}
					/>

				</VrStack>

			</EmoStrip>

		</ESec>

		<ESec
			id="garage-basement"
			pBg={new ElemBg(Colors.WhiteOff)}
			pAlign={Align.Center}
		>

			<SecTitle
				style = {`--StripBg:${Colors.OrangeLite};`}
				pTitle="الجراجات والبدرومات والمداخل المشتركة"
				pDesc="ملفات الجراج والبدروم تحتاج عناية خاصة لأنها ترتبط بحقوق السكان ومسارات الحركة والحريق والتهوية ووظيفة العقار."
			/>

			<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

				<VrStack
					pWidth={new Pixel(1200, 340)}
					pGap={new Pixel(25, 15)}
					pPad={new Pixel(30, 15)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("الجراج مساحة خدمية لها اشتراطات خاصة")}
						pText={Text.Body.OfText("الجراج مخصص لخدمة العقار وحركة السيارات، وتحويله إلى محال أو مخازن أو وحدات أو تقسيمه إلى أنشطة يغير علاقة المبنى بالشارع والسكان والمرافق. لذلك نراجع الرخصة الأصلية، عدد أماكن الانتظار، مداخل ومخارج السيارات، واقع الاستخدام الحالي، وتاريخ التحويل، ثم نحدد شكل ملف التصالح وما إذا كان يحتاج مسارًا إضافيًا للنشاط.")}
						pSize={new Size(1120, "auto", "100%", "auto")}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("البدروم له اشتراطات فنية مختلفة")}
						pText={Text.Body.OfText("البدروم قد يعاني من مشاكل تهوية أو صرف أو ارتفاع أو مخارج أو رشح مياه أو حمل حراري أو تخزين مواد. لذلك يجب توثيق منسوب البدروم، المداخل، ارتفاعه الصافي، التهوية، الإنارة، وسلامة الوصول، لأن لجنة الفحص قد تطلب بيانات تفصيلية أكثر من حالة دور عادي.")}
						pSize={new Size(1120, "auto", "100%", "auto")}
					/>

					<CardsGr
						pWidth={new RespString("1200px", "100%")}
						pCardBg={new ElemBg(Colors.SkyLite)}
						pGrTitle={Text.H3.Centered.OfText("النقاط الحاسمة في الجراج والبدروم")}
						pCardTitleFnt={Text.H4}
						pCardBodyFnt={Text.Body}
						pStackDir="Row"
						pSpacing={20}
						pTopic1={new Topic("المدخل", "عرض المدخل ومنسوبه وعلاقته بالشارع والسلم والمداخل المشتركة.")}
						pTopic2={new Topic("الارتفاع", "الارتفاع الصافي للبدروم أو الجراج وأثر السقف والكمرات والتشطيبات.")}
						pTopic3={new Topic("التهوية", "وجود فتحات أو مناور أو أنظمة تهوية مناسبة للاستخدام القائم.")}
						pTopic4={new Topic("الصرف", "موقف صرف البدروم والحماية من رجوع المياه أو تجمعها.")}
						pTopic5={new Topic("الحريق", "مخارج الحركة والمواد المخزنة وأثر النشاط على متطلبات الحماية المدنية.")}
						pTopic6={new Topic("حقوق الشركاء", "ملكية الجراج أو البدروم وموقف باقي الملاك واتحاد الشاغلين.")}
					/>

					<EmoList
						pWidth={new RespString("1120px", "100%")}
						pTitle={Text.H3.Centered.OfText("ملف الجراج أو البدروم خطوة بخطوة")}
