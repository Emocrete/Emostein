---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص بناء بالأحياء"
	pDescr="خدمة استخراج ومتابعة ترخيص بناء داخل أحياء القاهرة والجيزة، تشمل بيان صلاحية الموقع، مراجعة الملكية والاشتراطات التخطيطية، إعداد الرسومات الهندسية، وثيقة التأمين عند اللزوم، ومتابعة ملف الترخيص بالمركز التكنولوجي والإدارة الهندسية."
>







	<Hero
		pImgF="/Media/Emoperm/Building/Districts/Construction/"
		pTitle="ترخيص بناء بالأحياء"
		pDesc="ترخيص البناء داخل الحي لا يبدأ من عدد الأدوار الذي تريده، بل من قراءة الشارع والموقع والمخطط التفصيلي والملكية والاشتراطات قبل رسم أي لوحة"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="45% 45% 10% 8%"
		pPosP="18% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="راجع ملف ترخيص البناء" />

	</Hero>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="ترخيص البناء داخل الأحياء ملف تنظيمي قبل أن يكون ملف رسومات"
			pDesc="الحي يراجع علاقة قطعة الأرض بالشارع وخط التنظيم والمخطط التفصيلي والجيران والمرافق، وليس شكل المبنى فقط"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("الترخيص في الحي لا يشبه الترخيص في المدن الجديدة")}
					pText={Text.Body.WithAlign("right").OfText(`داخل المدن الجديدة تكون نقطة البداية غالبًا هي كود الأرض، محضر الاستلام، كراسة الشروط، وموقف القطعة مع جهاز المدينة. أما داخل الأحياء فالسؤال الأول مختلف: هل الموقع داخل حي قائم؟ ما عرض الشارع الفعلي؟ هل يوجد خط تنظيم؟ هل الأرض داخل منطقة لها مخطط تفصيلي معتمد؟ هل العقار داخل نطاق تاريخي أو منطقة ذات قيمة؟ هل هناك شارع رئيسي أو محور أو نهر أو أثر أو ارتفاق جوي يغير الارتفاع؟ هل سند الملكية يطابق الطبيعة؟ هل المبنى المطلوب إنشاء جديد على أرض فضاء، أم إعادة بناء بعد هدم، أم تعديل على مبنى قائم، أم تعلية؟ هذه الأسئلة هي التي تحدد صلاحية الملف قبل أن نناقش الواجهة والتقسيم الداخلي وعدد الوحدات.`)}
					pSize={new Size(new NumPer(1100, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1300px", "100%")}
					pCardBg={new ElemBg(Colors.SkyLite)}
					pGrTitle={Text.H3.Centered.OfText("محاور ملف ترخيص البناء داخل الحي")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pSpacing={20}
					pTopic1={new Topic("الموقع والشارع", "عرض الشارع، خط التنظيم، الواجهة، النواصي، علاقة الأرض بالجيران، والمداخل القائمة حولها.")}
					pTopic2={new Topic("المخطط والاشتراطات", "بيان الصلاحية، المخطط التفصيلي، الارتفاع المسموح، النسبة البنائية، والقيود الخاصة بالمكان.")}
					pTopic3={new Topic("الملكية والصفة", "مستند الملكية أو الحيازة، التوكيلات، الشركاء، الورثة، ومطابقة البيانات مع الطبيعة.")}
					pTopic4={new Topic("الرسومات الهندسية", "المعماري والإنشائي وشهادة الصلاحية وحساب قيمة الأعمال ووثيقة التأمين عند اللزوم.")}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أحياء القاهرة والجيزة ليست كتلة واحدة"
			pDesc="اختلاف الحي قد يغير طريقة قراءة الملف حتى لو كان قانون البناء واحدًا"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("600px", "100%")}
					pTitle={Text.H3.Centered.OfText("أحياء القاهرة التي يجب تحديدها قبل أي إجراء")}
					pDesc={Text.Body.Centered.OfText("محافظة القاهرة مقسمة إلى مناطق وأحياء، وكل حي له إدارة ومركز تكنولوجي وسياق عمراني مختلف")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pNumbered={false}
					pItems={[
						{ Title: "المنطقة الشرقية", Items: ["مصر الجديدة، النزهة، شرق مدينة نصر، غرب مدينة نصر، عين شمس، السلام أول، السلام ثان، المطرية، المرج."] },
						{ Title: "المنطقة الغربية", Items: ["الأزبكية، الموسكي، الوايلي، باب الشعرية، بولاق، عابدين، غرب، منشأة ناصر، وسط."] },
						{ Title: "المنطقة الجنوبية", Items: ["مصر القديمة، الخليفة، المقطم، البساتين، دار السلام، السيدة زينب، التبين، حلوان، المعصرة، المعادي، طرة، 15 مايو."] },
						{ Title: "المنطقة الشمالية", Items: ["شبرا، الزاوية الحمراء، حدائق القبة، روض الفرج، الشرابية، الساحل، الزيتون، الأميرية."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("600px", "100%")}
					pTitle={Text.H3.Centered.OfText("أحياء الجيزة التي تتكرر فيها ملفات البناء")}
					pDesc={Text.Body.Centered.OfText("قائمة الأحياء مهمة لأن كل حي له طبيعة شوارع ومخططات وكثافات وحدود مختلفة")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.Creamy)}
					pNumbered={false}
					pItems={[
						{ Title: "أحياء مدينة الجيزة", Items: ["شمال الجيزة، جنوب الجيزة، العجوزة، الدقي، العمرانية، الهرم، بولاق الدكرور، الوراق، الطالبية، وإمبابة بحسب صفحات الأحياء المتاحة."] },
						{ Title: "أحياء شديدة الحساسية في الترخيص", Items: ["الهرم وحدائق الأهرام ومناطق شارع الهرم، بسبب القيود الأثرية والارتفاعات والقرارات الخاصة.", "الدقي والعجوزة وجنوب الجيزة بسبب النيل والكثافة والشوارع الحيوية.", "العمرانية وبولاق الدكرور والطالبية بسبب الكثافة العالية وتفاوت عرض الشوارع والمخططات التفصيلية."] },
						{ Title: "أحياء تحتاج تدقيقًا قبل التصميم", Items: ["الوراق وإمبابة بسبب العلاقة بالنيل، الكثافة، حدود الأحياء، ووجود مناطق قديمة وشوارع ضيقة.", "الهرم والعمرانية والطالبية بسبب تداخل المناطق المنظمة مع مناطق عشوائية أو مناطق لها قرارات خاصة."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="لماذا تختلف أحياء القاهرة في ترخيص البناء؟"
			pDesc="القاهرة تجمع مناطق تاريخية، شوارع عريضة، مناطق كثيفة، مناطق قريبة من المطار، مناطق على النيل، ومناطق لها طابع عمراني خاص"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("حي مصر الجديدة ليس مثل حي منشأة ناصر، والمعادي ليست مثل باب الشعرية")}
					pText={Text.Body.WithAlign("right").OfText(`في القاهرة تظهر الاختلافات بوضوح شديد. أحياء مثل مصر الجديدة والنزهة ومدينة نصر ترتبط بمحاور واسعة وبعض نطاقات الارتفاق الجوي والقرب النسبي من المطار، لذلك قد يصبح الارتفاع أو التعلية أو الأبراج أو الاستخدامات المختلطة ملفًا يحتاج مراجعة إضافية. أحياء مثل وسط البلد وعابدين والأزبكية والموسكي وباب الشعرية والوايلي تقع داخل نسيج تاريخي أو مناطق ذات قيمة معمارية، وبالتالي قد تدخل اعتبارات التنسيق الحضاري والواجهات والطابع العمراني والمباني المسجلة. أحياء مثل المعادي والمقطم و15 مايو ومدينة نصر لها أجزاء مخططة وأخرى تحتاج قراءة حدود ومناسيب وطرق. وأحياء مثل دار السلام والبساتين والمطرية وعين شمس والمرج والسلام قد تكون المشكلة فيها ليست القانون فقط، بل اختلاف عرض الشارع وكثافة البناء ووجود مناطق غير منتظمة أو فروق بين المستند والطبيعة. لذلك لا نبدأ صفحة ترخيص حي القاهرة بجملة عامة عن الأوراق، بل نبدأ بتحديد الحي والشارع وطبيعة المنطقة داخل الحي.`)}
					pSize={new Size(new NumPer(1100, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1300px", "100%")}
					pCardBg={new ElemBg(Colors.Creamy)}
					pGrTitle={Text.H3.Centered.OfText("تصنيف عملي لأحياء القاهرة عند مراجعة الترخيص")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pSpacing={20}
					pTopic1={new Topic("أحياء تاريخية أو ذات قيمة", "وسط، عابدين، الأزبكية، الموسكي، باب الشعرية، الوايلي، مصر القديمة، الخليفة، السيدة زينب، أجزاء من الزمالك وجاردن سيتي ومناطق قريبة من القاهرة الخديوية. هنا يجب الانتباه للتنسيق الحضاري والواجهات والمباني ذات الطراز.")}
					pTopic2={new Topic("أحياء قريبة من المطار أو محاور الارتفاع", "النزهة، مصر الجديدة، شرق وغرب مدينة نصر، وبعض نطاقات شرق القاهرة. هنا لا يصح افتراض الارتفاع النهائي قبل مراجعة بيان الصلاحية وقيود الارتفاق الجوي عند وجودها.")}
					pTopic3={new Topic("أحياء كثيفة أو شوارعها ضيقة", "عين شمس، المطرية، المرج، السلام، دار السلام، البساتين، الزاوية الحمراء، الساحل، الشرابية، حدائق القبة. هنا عرض الشارع وخط التنظيم والتهوية والمناور والكثافة عناصر مؤثرة جدًا.")}
					pTopic4={new Topic("أحياء لها طبيعة مكانية خاصة", "المقطم بسبب المناسيب والطبيعة الجبلية، المعادي بسبب التخطيط والطابع في أجزاء منها، حلوان والتبين والمعصرة بسبب الصناعة والمرافق والمحاور، و15 مايو بسبب اختلاف نسيجها عن القاهرة التاريخية.")}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="لماذا تختلف أحياء الجيزة في ترخيص البناء؟"
			pDesc="الجيزة تجمع نسيجًا قديمًا، مناطق على النيل، مناطق أثرية، كثافات عالية، وحدودًا متداخلة مع مراكز ومدن وطرق رئيسية"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("الجيزة أخطر من أن تعاملها كمنطقة واحدة")}
					pText={Text.Body.WithAlign("right").OfText(`داخل الجيزة تظهر الفروق الميدانية أسرع من القاهرة أحيانًا. حي الهرم مثلًا لا يراجع فقط كحي سكني؛ قربه من شارع الهرم ومناطق أثرية وحدائق الأهرام وقرارات ارتفاعات أو تخطيط قديمة يجعل ملف الترخيص يحتاج قراءة دقيقة قبل التصميم. حي الدقي والعجوزة وجنوب الجيزة يرتبطون بشوارع حيوية وكباري ونهر النيل ومناطق شديدة الكثافة وقيمة عقارية عالية، لذلك تكون مطابقة الملكية والطبيعة وخط التنظيم أكثر حساسية. العمرانية وبولاق الدكرور والطالبية تجمع بين كثافة سكانية عالية وشوارع متفاوتة العرض ومناطق لها مخططات تفصيلية حديثة أو تحتاج مراجعة محلية دقيقة. الوراق وإمبابة لهما حدود مع النيل ومناطق كثيفة وتداخل قديم بين الشوارع والسكن والخدمات. لذلك فخدمة ترخيص البناء بالجيزة لا يصح أن تبدأ بقائمة مستندات عامة فقط؛ يجب أن تبدأ بتحديد الحي والشارع والحدود الإدارية والمخطط التفصيلي والقرارات الخاصة إن وجدت.`)}
					pSize={new Size(new NumPer(1100, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1300px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pGrTitle={Text.H3.Centered.OfText("تصنيف عملي لأحياء الجيزة عند مراجعة الترخيص")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pSpacing={20}
					pTopic1={new Topic("الهرم وحدائق الأهرام", "ملف يحتاج تدقيقًا في القرارات الخاصة، الارتفاعات، قرب المناطق الأثرية، حدود شارع الهرم، وحالة القطعة داخل التقسيم أو خارجه.")}
					pTopic2={new Topic("الدقي والعجوزة وجنوب الجيزة", "مناطق حضرية عالية القيمة والكثافة، وبها شوارع ومحاور وواجهات على النيل أو قريبة منه، لذلك يجب مراجعة خط التنظيم والملكية والواجهات والأنشطة بدقة.")}
					pTopic3={new Topic("العمرانية وبولاق الدكرور والطالبية", "ملفاتها كثيرًا ما تتأثر بالكثافة وعرض الشوارع وتفاوت التنظيم ووجود مخططات تفصيلية حديثة لبعض المناطق، فلا يصح الاعتماد على تجربة عقار مجاور.")}
					pTopic4={new Topic("الوراق وإمبابة وشمال الجيزة", "النيل والكثافة والحدود القديمة ونطاقات الطرق والمرافق تجعل الرفع المساحي ومطابقة الواقع بالمستندات خطوة لا يجوز اختصارها.")}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="المخطط التفصيلي هو قلب الترخيص داخل الحي"
			pDesc="لا يكفي أن تكون الأرض ملكك؛ يجب أن يكون البناء المقترح متوافقًا مع المخطط والاشتراطات المعتمدة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.Centered.OfText("لماذا لا نعتمد على ارتفاع العمارة المجاورة؟")}
					pText={Text.Body.WithAlign("right").OfText(`واحدة من أكثر العبارات التي تؤخر ملفات الترخيص هي: كل العمارات حولي مبنية نفس الارتفاع. هذا الكلام قد يصف الواقع، لكنه لا يثبت الحق في الترخيص. المبنى المجاور ربما صدر له ترخيص في فترة قديمة، أو تم بناؤه بالمخالفة، أو يقع على شارع أعرض، أو له ناصية، أو داخل تقسيم مختلف، أو قبل اعتماد مخطط تفصيلي جديد، أو قبل تغيير اشتراطات المنطقة. الجهة الإدارية لا ترخص بمقارنة شكلية مع الجار، بل ترجع إلى بيان صلاحية الموقع والمخطط التفصيلي وخط التنظيم وعرض الشارع والقيود الخاصة. لذلك فالملف الجيد لا يسأل: ماذا بنى الجار؟ بل يسأل: ماذا يسمح به الموقع الحالي قانونيًا وتخطيطيًا؟`)}
					pSize={new Size(new NumPer(600, "100%"), new NumPer("auto", "auto"))}
				/>

				<EmoList
					pWidth={new RespString("600px", "100%")}
					pTitle={Text.H3.Centered.OfText("ما الذي يراجعه المخطط التفصيلي؟")}
					pDesc={Text.Body.Centered.OfText("هذه النقاط هي التي تتحول إلى قيود تصميمية داخل اللوحات")}
