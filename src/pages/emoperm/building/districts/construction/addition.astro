---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Topic, Pixel, EmoMediaData } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, CardsGr, EmoList, RespImg, EmoCall, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص تعلية بالأحياء"
	pDescr="خدمة استخراج ومتابعة ترخيص تعلية داخل أحياء القاهرة والجيزة، تشمل مراجعة الرخص السابقة، بيان الصلاحية، قدرة المبنى وأساساته على تحمل التعلية، التقرير الإنشائي، الرسومات الهندسية، وثيقة التأمين، ومتابعة ملف الترخيص بالمركز التكنولوجي."
>







	<Hero
		pImgF="/Media/Emoperm/Building/Districts/Construction/Addition/"
		pTitle="ترخيص تعلية بالأحياء"
		pDesc="التعلية ليست دورًا إضافيًا فوق مبنى قائم؛ هي اختبار قانوني وإنشائي وتنظيمي يثبت هل المبنى يتحمل وهل الحي يسمح وهل الملف يصلح للترخيص"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="45% 45% 10% 8%"
		pPosP="15% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="راجع إمكانية التعلية" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="ترخيص التعلية يبدأ بسؤال واحد: هل ينفع أصلًا؟"
			pDesc="قبل حساب تكلفة الدور الجديد أو توزيع الشقق، يجب فحص ثلاثة أشياء: هل المبنى قانوني؟ هل يتحمل إنشائيًا؟ وهل الاشتراطات تسمح بارتفاع إضافي؟"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"/Media/Emoperm/Building/Districts/Construction/Addition/",
						"ExistingBuildingAudit.webp",
						false,
						"فحص مبنى قائم قبل ترخيص التعلية",
						new Size(520, "auto", "100%", "auto")
					)}
				/>

				<Emograph
					pTitle={Text.H3.OfText("المالك يرى دورًا إضافيًا، والحي يرى ملفًا كاملًا")}
					pText={Text.Body.OfText(`في ترخيص التعلية لا تبدأ الخدمة من رسم دور متكرر فوق السطح. البداية الصحيحة هي قراءة المبنى القائم نفسه: هل له رخصة أصلية؟ هل تم تنفيذه مطابقًا للرخصة؟ هل توجد مخالفات أو تصالح أو أدوار منفذة بدون ترخيص؟ هل الأساسات والأعمدة والكمرات تتحمل حمل الدور المطلوب؟ هل عرض الشارع والمخطط التفصيلي وبيان الصلاحية يسمحان بزيادة الارتفاع؟ وهل الحالة تدخل في وثيقة التأمين؟ هذه الأسئلة تجعل التعلية ملفًا أخطر من ترخيص بناء جديد؛ لأن الخطأ هنا لا يخص أرضًا فضاء فقط، بل مبنى قائم وسكان وجيران ومنشأ يحمل أحمالًا فعلية.`)}
					pSize={new Size(700, "auto", "100%", "auto")}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="فرز سريع قبل تجهيز ترخيص التعلية"
			pDesc="هذا الفرز يمنع تحويل حالة غير قابلة للتعلية إلى ملف رسومات واستيفاءات لا ينتهي"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1300px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pGrTitle={Text.H3.Centered.OfText("ستة أسئلة قبل فتح الملف")}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pSpacing={20}
				pTopic1={new Topic("هل المبنى مرخص؟", "وجود رخصة أصلية أو رخص سابقة ليس تفصيلًا إداريًا؛ هو الأساس الذي يحدد هل نتعامل مع تعلية قانونية أم مع مبنى يحتاج تصحيح موقف أولًا.")}
				pTopic2={new Topic("هل الواقع مطابق للرخصة؟", "لو المبنى منفذ بعدد أدوار أو مساحات أو مناور أو ارتدادات مختلفة عن المرخص، فقد نحتاج تحديد موقف أو تصالح قبل طلب التعلية.")}
				pTopic3={new Topic("هل الهيكل يتحمل؟", "التعلية تحتاج تقريرًا هندسيًا يثبت قدرة النظام الإنشائي والأساسات على تحمل الأعمال المطلوبة، وليس مجرد رأي شفهي من مقاول أو مالك.")}
				pTopic4={new Topic("هل الارتفاع مسموح؟", "عرض الشارع وحده لا يكفي؛ يجب مراجعة بيان الصلاحية والمخطط التفصيلي والقيود الخاصة مثل الطيران أو التنسيق الحضاري أو الآثار.")}
				pTopic5={new Topic("هل الحالة تحتاج تأمين؟", "أعمال التعلية تدخل غالبًا في مسار وثيقة التأمين، لذلك يجب تجهيز الملف الفني بطريقة تصلح للمراجعة وليس مجرد لوحات مختصرة.")}
				pTopic6={new Topic("هل السكان والجيران في الحساب؟", "التعلية على مبنى مأهول تحتاج إدارة مخاطر التنفيذ والحركة والأمان والاهتزازات والتخزين، لأن الضرر لا يقع على قطعة خالية.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="ترخيص التعلية في القاهرة والجيزة له حساسية مختلفة عن البناء الجديد"
			pDesc="في البناء الجديد تقرأ الأرض، أما في التعلية فتقرأ الأرض والمبنى القديم والرخصة والتنفيذ والحالة الإنشائية معًا"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1200, 340)}
				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("لماذا لا تكفي رخصة الدور الأرضي أو الرخصة القديمة؟")}
					pText={Text.Body.WithAlign("right").OfText(`بعض الملاك يتعاملون مع الرخصة القديمة كأنها تصريح مفتوح لاستكمال أدوار كلما احتاجوا. هذا خطأ. الرخصة القديمة تثبت تاريخًا وموقفًا سابقًا، لكنها لا تثبت وحدها أن المبنى يتحمل الآن، ولا أن الاشتراطات الحالية تسمح بنفس الارتفاع، ولا أن التنفيذ تم مطابقًا للرسومات، ولا أن الأساسات لم تتأثر بتعديلات أو أحمال أو مياه جوفية أو شروخ أو هبوط. التعلية الناجحة تحتاج قراءة مشتركة: الرخصة السابقة، الرسومات القديمة إن وجدت، الطبيعة الحالية للمبنى، تقرير تحمل إنشائي، بيان صلاحية حديث أو اشتراطات سارية، ثم رسومات تعلية لا تتعارض مع القائم.`)}
					pSize={new Size(1100, "auto", "100%", "auto")}
				/>

				<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(0, 0)}>

					<EmoList
						pWidth={new RespString("600px", "100%")}
						pTitle={Text.H3.Centered.OfText("ما الذي يهم الحي؟")}
						pDesc={Text.Body.Centered.OfText("الحي لا يراجع الدور الجديد وحده")}
						pHeadBg={new ElemBg(Colors.Creamy)}
						pItemsBg={new ElemBg(Colors.SkyLite)}
						pItemFnt={Text.Body}
						pNumbered={true}
						pItems={[
							{ Title: "موقف العقار", Items: ["رخصة سابقة، تنفيذ قائم، مخالفات، تصالح، قرارات إزالة، أو أعمال بدون ترخيص."] },
							{ Title: "موقف الموقع", Items: ["بيان صلاحية، عرض شارع، خط تنظيم، مخطط تفصيلي، قيود ارتفاع أو طابع أو أثر."] },
							{ Title: "موقف الرسومات", Items: ["هل توجد رسومات قديمة؟ هل التنفيذ مطابق لها؟ هل التعلية المقترحة تحترم المناور والسلالم والردود؟"] },
							{ Title: "موقف الأمان", Items: ["تقرير تحمل، وثيقة تأمين، إشراف، مقاول، وخطة تنفيذ تقلل ضرر السكان والجيران."] }
						]}
					/>

					<EmoList
						pWidth={new RespString("600px", "100%")}
						pTitle={Text.H3.Centered.OfText("ما الذي يهم المهندس؟")}
						pDesc={Text.Body.Centered.OfText("المهندس لا يوقع على دور إضافي قبل فهم المبنى")}
						pHeadBg={new ElemBg(Colors.Creamy)}
						pItemsBg={new ElemBg(Colors.Gray1)}
						pItemFnt={Text.Body}
						pNumbered={true}
						pItems={[
							{ Title: "النظام الإنشائي", Items: ["نوع الأساسات، الأعمدة، الكمرات، الأسقف، البحور، والأحمال الحية والميتة."] },
							{ Title: "حالة الخرسانة", Items: ["شروخ، صدأ، هبوط، تعشيش، تعديلات غير مرخصة، تكسير أعمدة أو كمرات."] },
							{ Title: "التحميل الجديد", Items: ["وزن الدور، الحوائط، التشطيبات، الخزانات، غرف الخدمات، وأحمال الاستخدام."] },
							{ Title: "إمكانية التدعيم", Items: ["هل التعلية ممكنة كما هي؟ هل تحتاج تدعيم؟ أم أن التدعيم نفسه غير اقتصادي أو غير آمن؟"] }
						]}
					/>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="الفحص الإنشائي ليس تقريرًا شكليًا"
			pDesc="أي تعلية بدون فحص إنشائي جاد هي مقامرة على المبنى القائم، حتى لو كان الدور المطلوب صغيرًا"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.Centered.OfText("تقرير التحمل يسبق التصميم المعماري")}
					pText={Text.Body.WithAlign("right").OfText(`في حالات كثيرة يبدأ المالك بطلب توزيع دور جديد: شقتان، سلم، مناور، واجهة، ثم يبحث عن مهندس يوقّع. الترتيب الصحيح عكس ذلك. يجب أولًا فحص النظام الإنشائي القائم، قراءة أي لوحات قديمة، مطابقة الأعمدة والمناور والسلالم على الطبيعة، مراجعة الشروخ والهبوط والتعديلات، ثم تحديد هل المبنى يتحمل التعلية المقترحة. إذا ظهر أن المبنى لا يتحمل، فليس الحل أن نرسم دورًا أخف فقط؛ قد تكون النتيجة رفض التعلية، أو اشتراط تدعيم، أو تغيير نظام الحوائط، أو تقليل المسطح، أو تحويل الملف إلى مسار آخر. لذلك تقرير التحمل ليس ورقة لتكملة الملف، بل هو قرار هندسي يحدد هل ندخل مسار الترخيص من الأساس.`)}
					pSize={new Size(700, "auto", "100%", "auto")}
				/>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"/Media/Emoperm/Building/Districts/Construction/Addition/",
						"StructuralCheck.webp",
						false,
						"فحص إنشائي قبل أعمال التعلية",
						new Size(520, "auto", "100%", "auto")
					)}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أحياء القاهرة: التعلية تختلف باختلاف المنطقة لا باختلاف اسم الخدمة"
			pDesc="محافظة القاهرة مقسمة إلى مناطق وأحياء، والتعلية في حي تاريخي أو قريب من المطار ليست مثل التعلية في منطقة حديثة أو شارع محلي ضيق"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
			>

				<CardsGr
					pWidth={new RespString("1300px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pGrTitle={Text.H3.Centered.OfText("قراءة القاهرة في ملف التعلية")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pSpacing={20}
					pTopic1={new Topic("شرق القاهرة", "مصر الجديدة، النزهة، مدينة نصر، عين شمس، المطرية، المرج، السلام أول وثان. هنا تظهر حساسية الارتفاع والقرب من المطار أو المحاور أو شوارع رئيسية، مع تفاوت كبير بين مناطق مخططة ومناطق كثيفة.")}
					pTopic2={new Topic("غرب ووسط القاهرة", "الأزبكية، الموسكي، الوايلي، باب الشعرية، بولاق، عابدين، غرب، منشأة ناصر، وسط. في هذه المناطق يجب الانتباه إلى الطابع العمراني والمباني ذات القيمة والواجهات والشوارع التاريخية.")}
					pTopic3={new Topic("جنوب القاهرة", "مصر القديمة، الخليفة، السيدة زينب، المعادي، المقطم، حلوان، التبين، المعصرة، البساتين، دار السلام، طرة، 15 مايو. هنا قد تظهر الآثار والطابع العمراني والمناسيب والطبيعة الجبلية أو الصناعية.")}
					pTopic4={new Topic("شمال القاهرة", "شبرا، روض الفرج، الساحل، الشرابية، حدائق القبة، الزاوية الحمراء، الزيتون، الأميرية. هنا تكثر حالات المباني القائمة القديمة والكثافة وتفاوت عرض الشوارع، فالفحص الإنشائي وخط التنظيم حاسمان.")}
				/>

				<Emograph
					pTitle={Text.H3.Centered.OfText("ما الذي يتغير من حي لحي داخل القاهرة؟")}
					pText={Text.Body.WithAlign("right").OfText(`الاختلاف لا يكون في عنوان الطلب، لأن نموذج طلب ترخيص أعمال تعلية قد يكون واحدًا. الاختلاف في القراءة الميدانية: مبنى في مصر الجديدة قد يصطدم بقيد ارتفاع أو طابع واجهات، ومبنى في وسط البلد قد يحتاج مراجعة تنسيق حضاري، ومبنى في منشأة ناصر أو المقطم قد يحتاج قراءة خاصة للمناسيب وطبيعة الأرض، ومبنى في شبرا أو الزاوية أو الساحل قد تكون مشكلته الحقيقية في ضيق الشارع وكثافة المباني والتعديلات القديمة. لذلك لا نكتب ملف تعلية القاهرة كإجراء واحد، بل نقرأ الحي والشارع والمبنى قبل الوعد بإمكانية الدور الإضافي.`)}
					pSize={new Size(1100, "auto", "100%", "auto")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="أحياء الجيزة: التعلية تحتاج حذرًا أكبر في المناطق الكثيفة والقديمة"
			pDesc="الهرم والعمرانية والطالبية وبولاق والدقي والعجوزة والوراق ليست ملفات متشابهة، حتى لو كانت كلها داخل نطاق محافظة الجيزة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("600px", "100%")}
					pTitle={Text.H3.Centered.OfText("تصنيف عملي لأحياء الجيزة في التعلية")}
					pDesc={Text.Body.Centered.OfText("نقرأ كل حي من زاوية خطر مختلفة")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						{ Title: "الهرم والطالبية", Items: ["حساسية شارع الهرم والمناطق القريبة من الأثر وحدائق الأهرام.", "احتمال وجود قرارات أو قيود ارتفاع أو مناطق لها وضع تخطيطي خاص.", "كثرة المباني القائمة التي تحتاج مطابقة بين الرخصة والواقع."] },
						{ Title: "العمرانية وبولاق الدكرور", Items: ["كثافة عالية وشوارع متفاوتة العرض.", "تداخل بين مناطق منتظمة وأخرى تحتاج مراجعة دقيقة للمخطط التفصيلي.", "التعلية قد تتأثر بالمناور والتهوية والأحمال السابقة."] },
						{ Title: "الدقي والعجوزة وجنوب الجيزة", Items: ["قيمة عقارية عالية وشوارع ومحاور رئيسية وقرب من النيل في بعض المناطق.", "الواجهات والاستخدامات والأنشطة الأرضية قد تؤثر على الملف.", "الملكية القديمة والتعديلات السابقة تحتاج مراجعة دقيقة."] },
						{ Title: "الوراق وشمال الجيزة وإمبابة", Items: ["نطاقات كثيفة وقديمة وقريبة من النيل أو محاور ومرافق.", "الرفع المساحي ومطابقة الحدود بالطبيعة لا يجوز اختصارهما.", "الأمان الإنشائي والتنفيذ وسط سكان قائمين عنصر شديد الحساسية."] }
					]}
				/>

				<Emograph
					pTitle={Text.H3.Centered.OfText("في الجيزة لا تسأل عن التعلية قبل تحديد الحي والشارع")}
