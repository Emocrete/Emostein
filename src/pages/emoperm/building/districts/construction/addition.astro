---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="ترخيص تعلية بالأحياء"
	pDescr="خدمة استخراج ومتابعة ترخيص تعلية داخل أحياء القاهرة والجيزة، تشمل مراجعة الرخص السابقة، بيان الصلاحية، قدرة المبنى وأساساته على تحمل التعلية، التقرير الإنشائي، الرسومات الهندسية، وثيقة التأمين، ومتابعة ملف الترخيص بالمركز التكنولوجي."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("ترخيص تعلية بالأحياء")}
				pText={Text.Body.Centered.OfText("خدمة استخراج ومتابعة ترخيص تعلية داخل أحياء القاهرة والجيزة، تشمل مراجعة الرخص السابقة، بيان الصلاحية، قدرة المبنى وأساساته على تحمل التعلية، التقرير الإنشائي، الرسومات الهندسية، وثيقة التأمين، ومتابعة ملف الترخيص بالمركز التكنولوجي.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
