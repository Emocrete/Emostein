			pDesc="هذه البنود لا تظهر في كل قطعة، لكنها هي التي تجعل بعض الملفات تتغير فجأة بعد أن يظن المالك أن التصميم انتهى"
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1080px", "100%")}
				pTitle={Text.H3.Centered.White.OfText("متى تصبح الموافقات الخاصة مؤثرة؟")}
				pDesc={Text.Body.Centered.White.OfText("التحقق المبكر من هذه النقاط يمنع إعادة تصميم الارتفاع أو البدروم أو النشاط أو الواجهة")}
				pHeadBg={new ElemBg(Colors.BistageDark)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={false}
				pItems={[
					{ Title: "قيود القوات المسلحة", Items: ["قد تفرض حدًا أقصى للارتفاع في مناطق معينة.", "لا تظهر دائمًا في حديث العميل عن الأرض، لذلك يجب مراجعتها من مستندات الجهاز أو بيان الصلاحية أو المخطط.", "إذا وجد قيد ارتفاع، فهو مقدم على رغبة المالك في استغلال كل الأدوار المتخيلة."] },
					{ Title: "قيود سلطة الطيران المدني", Items: ["تظهر عند قرب الموقع من مطارات أو مسارات أو نطاقات ارتفاع.", "غرب القاهرة وسفنكس وبعض النطاقات القريبة من محاور الطيران تحتاج حذرًا خاصًا عند الارتفاعات.", "لا يتم التعامل معها كتخمين؛ يتم الرجوع لما يورده الجهاز أو الجهات المختصة."] },
					{ Title: "غرف ومحولات الكهرباء", Items: ["بعض الكراسات تنبه إلى أن مواقع غرف ومحولات الكهرباء قد لا تكون محددة نهائيًا وقت الطرح.", "تصميم السور أو المدخل أو الجراج دون مراجعة مسار الكهرباء قد يؤدي لتعديل لاحق.", "يجب تركونة مرونة داخل التصميم عند وجود مرافق غير نهائية."] },
					{ Title: "موقف المرافق", Items: ["بعض الطروحات تربط التسليم بتوفير مرافق لازمة للإنشاء مثل طريق ممهد أو مصدر مياه.", "عدم اكتمال المرافق قد يؤثر على التنفيذ حتى بعد جاهزية الرسومات.", "يجب فصل صلاحية الترخيص عن قابلية التنفيذ الفوري على الأرض."] },
					{ Title: "الحماية المدنية", Items: ["المباني التجارية والخدمية والمختلطة أو ذات الإشغال الخاص لا تعامل مثل فيلا سكنية صغيرة.", "المداخل والمخارج والمسارات والتهوية ووسائل الإطفاء قد تحتاج مراجعة مبكرة.", "الموافقة ليست بديلًا عن كود الحريق، بل دليل على أن التصميم قابل للتشغيل الآمن."] }
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="الرسومات الهندسية المطلوبة للمدن الجديدة"
			pDesc="الرسم هنا لا يشرح المبنى فقط، بل يثبت أن المشروع ترجم اشتراطات الجهاز والكراسة إلى تصميم قابل للترخيص"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1180, 340)}
				pGap={new Pixel(28, 16)}
				pPad={new Pixel(34, 14)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("اللوحات يجب أن تجيب على أسئلة الجهاز")}
					pText={Text.Body.WithAlign("right").OfText(`رسومات ترخيص المدن الجديدة لا يجب أن تكون مجرد مساقط جميلة. اللوحات يجب أن توضح حدود القطعة، الردود، خط البناء، النسبة البنائية، البدروم، أماكن الانتظار، السور، غرف السطح، المناور، الواجهات، القطاعات، مناسيب الدخول، علاقة المبنى بالشارع، وغرف الخدمات عند وجودها. كما يجب أن يظهر التوافق بين المعماري والإنشائي، لأن تعارض الأعمدة أو المناور أو السلالم مع المساقط المعمارية يخلق ملاحظات فنية لا علاقة لها بالمستندات الإدارية. وعند التقديم الإلكتروني يجب تجهيز نسخة PDF مقروءة ونسخة CAD منظمة ومضغوطة بالطريقة المطلوبة، لأن الملف الرقمي غير المرتب قد يسبب رفضًا أو استيفاءً حتى لو كان التصميم في جوهره صحيحًا.`)}
					pSize={new Size(new NumPer(1080, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1180px", "100%")}
					pCardBg={new ElemBg(Colors.SkyLite)}
					pGrTitle={Text.H3.Centered.OfText("مكونات الرسومات")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("الموقع العام", "حدود القطعة، الشوارع، الردود، المدخل، السور، أماكن الانتظار، وموقع المبنى داخل الأرض.")}
					pTopic2={new Topic("المساقط المعمارية", "كل دور مرخص: بدروم، أرضي، متكرر، غرف سطح، خدمات، مناور، سلالم، ومداخل.")}
					pTopic3={new Topic("الواجهات والقطاعات", "إثبات الارتفاع، المناسيب، الطابع المعماري، الفتحات، وخطوط البروز أو الارتداد.")}
					pTopic4={new Topic("الإنشائي والجسات", "أساسات، أعمدة، كمرات، أسقف، تقرير تربة، ونوتة حسابية عند طلبها أو عندما تفرض الحالة ذلك.")}
					pTopic5={new Topic("شهادات الترخيص", "شهادة صلاحية الأعمال، شهادة إشراف، نموذج حساب تكاليف، وتوقيعات واعتمادات المكتب الهندسي.")}
					pTopic6={new Topic("ملفات البوابة", "PDF مختوم ومقروء، CAD منظم، ملفات مضغوطة، وتسميات واضحة تقلل أخطاء الرفع والفحص.")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>







