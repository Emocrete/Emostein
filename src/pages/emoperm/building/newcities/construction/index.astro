---
import { Align, Colors, ElemBg, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, SecTitle, VrStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تراخيص البناء بالمدن الجديدة"
	pDescr="خدمة استخراج ومتابعة تراخيص البناء بالمدن الجديدة التابعة لهيئة المجتمعات العمرانية، تشمل بيان الصلاحية، ترخيص إنشاء، تعديل أو تعلية، استكمال غرف السطح، تحديد الموقف التنفيذي، مراجعة المستندات والرسومات، وفحص اختلافات الاشتراطات بين أجهزة المدن."
>







	<Hero
		pImgF="/Media/Emoperm/Building/Newcities/Construction/"
		pTitle="تراخيص البناء بالمدن الجديدة"
		pDesc="ملف ترخيص البناء داخل جهاز المدينة لا يبدأ من الرسم فقط؛ يبدأ من كود الأرض، التخصيص، محضر الاستلام، الكراسة، الموقف المالي، واشتراطات كل مدينة"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="44% 46% 10% 8%"
		pPosP="18% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="راجع ترخيص قطعة الأرض" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="ترخيص البناء في المدن الجديدة ملف أرض قبل أن يكون ملف مبنى"
			pDesc="المدينة الجديدة ليست حيًا عاديًا، والقطعة لا تفحص بمعزل عن جهاز المدينة وهيئة المجتمعات العمرانية وكراسة الشروط ومحضر الاستلام والمهلة والموقف المالي"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1220, 340)}
				pGap={new Pixel(28, 16)}
				pPad={new Pixel(34, 14)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("الخطأ الشائع: التعامل مع جهاز المدينة كأنه حي")}
					pText={Text.Body.WithAlign("right").OfText(`ترخيص البناء في المدن الجديدة له منطق مختلف عن الترخيص داخل الأحياء القديمة. في الحي يكون السؤال الأكبر غالبًا عن خط التنظيم وعرض الشارع وبيان الصلاحية والملكية القديمة والمباني المجاورة. أما في المدن الجديدة فالسؤال الأول يكون: ما علاقة المالك بقطعة الأرض داخل جهاز المدينة؟ هل توجد قطعة مخصصة فعلًا؟ هل صدر محضر استلام؟ هل تم سداد المستحقات؟ هل انتهت مهلة استخراج الترخيص؟ هل توجد رخصة سابقة أو تنفيذ قائم؟ هل القطعة سكنية أم خدمية أم تجارية؟ هل التصميم ملتزم بالكراسة والنموذج المعماري والطابع المعتمد للمنطقة؟ وهل بيانات المالك والمكتب الهندسي مفعلة على منظومة الخدمات الإلكترونية؟ لذلك لا يصح أن تبدأ الخدمة برسومات معمارية مباشرة، لأن الرسم الصحيح على ورق غير صالح إداريًا لن يتحول إلى رخصة.`)}
					pSize={new Size(new NumPer(1120, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1220px", "100%")}
					pCardBg={new ElemBg(Colors.SkyLite)}
					pGrTitle={Text.H3.Centered.OfText("محاور ملف المدن الجديدة")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("القطعة والجهاز", "رقم القطعة، المنطقة، الحي، كود الأرض، محضر الاستلام، إخطار التخصيص، عقد الملكية، والمدينة التابع لها الطلب.")}
					pTopic2={new Topic("الموقف المالي والإداري", "الأقساط، المصروفات، مجلس الأمناء، المهلة، الغرامات، التنازل، الرخص السابقة، والموقف التنفيذي إن وجد.")}
					pTopic3={new Topic("الاشتراطات البنائية", "النسبة البنائية، عدد الأدوار، الردود، البدروم، غرف السطح، أماكن الانتظار، الاستخدام المسموح، والطابع المعماري.")}
					pTopic4={new Topic("التقديم الإلكتروني", "حساب المالك، حساب المكتب الهندسي، تفعيل المستندات، كود الأرض، رفع الرسومات والملفات، السداد، ومتابعة الاستيفاءات.")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="ما الذي يميز المدن الجديدة عن الأحياء؟"
			pDesc="نفس قانون البناء حاضر، لكن تطبيقه داخل المدن الجديدة يتداخل مع قانون هيئة المجتمعات العمرانية واللائحة العقارية والكراسات الخاصة بكل طرح"
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1180, 340)}
				pGap={new Pixel(28, 16)}
				pPad={new Pixel(34, 14)}
			>

				<Emograph
					pTitle={Text.H3.Centered.White.OfText("مصدر الاشتراطات ليس مستندًا واحدًا")}
					pText={Text.Body.WithAlign("right").White.OfText(`في المدن الجديدة لا يكفي أن تسأل عن قانون البناء فقط. قانون البناء رقم 119 لسنة 2008 ولائحته التنفيذية يمثلان القاعدة العامة، لكن قطعة الأرض التابعة لهيئة المجتمعات العمرانية تدخل معها مصادر أخرى: كراسة الشروط، قرارات مجلس إدارة الهيئة، اشتراطات جهاز المدينة، نموذج الطابع المعماري، مخططات المنطقة، تعليمات المرافق، وقرارات خاصة ببعض المناطق مثل بيت الوطن أو الحزام الأخضر أو مناطق المستثمرين أو قطع الخدمات أو القطع الصناعية والسياحية. معنى ذلك أن قطعتين بنفس المساحة قد تختلفان في الردود وعدد الأدوار والنسبة البنائية لمجرد اختلاف المدينة أو المنطقة أو نوع الطرح. ولهذا السبب يجب التعامل مع كل قطعة كحالة مستقلة، لا كنسخة من ملف جار أو ملف سابق في مدينة أخرى.`)}
					pSize={new Size(new NumPer(1080, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1180px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pGrTitle={Text.H3.Centered.White.OfText("أربع طبقات يجب قراءتها قبل التقديم")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("طبقة القانون", "قانون البناء واللائحة التنفيذية والكود المصري ومتطلبات التأمين والحريق والجراجات وسلامة التنفيذ.")}
					pTopic2={new Topic("طبقة الهيئة", "اللائحة العقارية لهيئة المجتمعات العمرانية، قرارات المجلس، قواعد التخصيص، المهل، السداد، ومخاطبات الجهاز.")}
					pTopic3={new Topic("طبقة المدينة", "اشتراطات جهاز المدينة المختص، كود الأرض، موقف المرافق، الطابع المعماري، نماذج الفيلات أو العمارات أو الخدمات.")}
					pTopic4={new Topic("طبقة الحالة", "هل الطلب إنشاء جديد أم تعلية أم تعديل أم استكمال غرف سطح أم تجديد رخصة أم تحديد موقف تنفيذي؟")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="أنواع طلبات تراخيص البناء في المدن الجديدة"
			pDesc="المنظومة لا تتعامل مع كل الحالات كطلب إنشاء جديد؛ اختيار نوع الطلب الخطأ قد يوقف الملف من بدايته"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1080px", "100%")}
				pTitle={Text.H3.Centered.OfText("اختيار نوع الطلب قبل تجهيز الملف")}
				pDesc={Text.Body.Centered.OfText("كل نوع من هذه الطلبات له مدخلات مختلفة، حتى لو تشابهت بعض المستندات الهندسية")}
				pHeadBg={new ElemBg(Colors.Creamy)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pNumbered={true}
				pItems={[
					{ Title: "طلب بيان صلاحية الموقع", Items: ["يستخدم لتحديد صلاحية القطعة للبناء من الناحية التخطيطية والاشتراطات البنائية.", "يوضح الردود والنسبة والارتفاع والاستخدامات والقيود الخاصة بالموقع.", "لا يجب اعتباره إجراءً منفصلًا عن التصميم؛ هو الأساس الذي يتم التصميم عليه."] },
					{ Title: "طلب ترخيص بناء إنشاء", Items: ["يخص قطعة لم يصدر لها ترخيص بناء سابق أو يراد الترخيص عليها كمبنى جديد.", "عادة يحتاج بيان صلاحية وموقف تنفيذي عند طلبه، ثم رسومات معمارية وإنشائية وملف فني كامل.", "يراجع فيه الجهاز علاقة المشروع بالكراسة والنموذج والمرافق والموقف المالي."] },
					{ Title: "طلب ترخيص بناء تعديل أو تعلية", Items: ["يخص مبنى له رخصة أو تنفيذ قائم ويراد تعديله أو تعليته.", "لا يصح التعامل معه كإنشاء جديد؛ لأن الرخص السابقة والواقع المنفذ والتحمل الإنشائي عناصر حاكمة.", "قد يحتاج شهادة تحمل أو تقرير إنشائي أو مستندات استشارية إضافية حسب الحالة."] },
					{ Title: "طلب استكمال غرف السطح أو زيادة مسطح الروف", Items: ["يرتبط بقرارات أو تيسيرات خاصة في بعض الحالات والمناطق.", "يحتاج فحص الرخصة السابقة والموقف التنفيذي ومساحة السطح المسموح بها.", "قد يكون الطلب متاحًا للمالك فقط أو وفق دورة عمل محددة على البوابة."] },
					{ Title: "طلب تجديد ترخيص البناء", Items: ["يظهر عند انتهاء مدة الترخيص أو الحاجة لإعادة تفعيل التعامل قبل التنفيذ.", "يجب مراجعة هل الاشتراطات القديمة لا تزال قابلة للتطبيق أم ظهرت شروط أو رسوم جديدة.", "الموقف المالي والتنفيذي قد يكونان أهم من إعادة رفع نفس الرسومات."] },
					{ Title: "طلب تحديد موقف تنفيذي أو معاينة", Items: ["مهم عند وجود تنفيذ سابق أو مبنى قائم أو شك في مطابقة الواقع للرخصة.", "قد يسبق طلب الإنشاء أو التعديل حتى يعرف الجهاز ما هو الوضع الفعلي على الأرض.", "نتيجته قد تغير مسار الترخيص بالكامل من إنشاء إلى تعديل أو استكمال أو تصحيح موقف."] }
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="خطوات العمل على ترخيص بناء في مدينة جديدة"
			pDesc="الترتيب الصحيح يقلل الاستيفاءات: لا تبدأ بالرسم النهائي قبل تثبيت الأرض والاشتراطات وحساب المالك والمكتب"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(24, 14)} pPad={new Pixel(32, 12)}>

				<EmoList
					pWidth={new RespString("590px", "100%")}
					pTitle={Text.H3.Centered.OfText("مرحلة ما قبل التصميم")}
					pDesc={Text.Body.Centered.OfText("هدفها منع إنتاج تصميم غير قابل للترخيص")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pNumbered={true}
					pItems={[
						{ Title: "تحديد المدينة والقطعة", Items: ["القاهرة الجديدة أو الشروق أو بدر أو العبور أو 6 أكتوبر أو الشيخ زايد أو حدائق أكتوبر أو سفنكس أو أي جهاز آخر.", "رقم القطعة والمنطقة والحي والمجاورة والمساحة والحدود.", "تحديد هل القطعة من طرح بيت الوطن أو قرعة أو تخصيص مباشر أو نقل ملكية أو تنازل."] },
						{ Title: "مراجعة مستند الأرض", Items: ["محضر الاستلام أو إخطار التخصيص أو العقد أو سند الملكية.", "مراجعة أسماء الملاك والتوكيلات والصفة القانونية.", "رصد أي اختلاف بين مستند الملكية وبيانات الجهاز أو الكود الإلكتروني."] },
						{ Title: "مراجعة الموقف المالي", Items: ["الأقساط والمستحقات ورسوم مجلس الأمناء والمصروفات الإدارية.", "هل توجد غرامات أو مهلة بناء منتهية أو طلب مد مهلة؟", "هل يوجد مانع تعامل قبل فتح طلب الترخيص؟"] },
						{ Title: "مراجعة الكراسة والاشتراطات", Items: ["نسبة البناء والردود والارتفاع وعدد الوحدات.", "شروط البدروم وغرف السطح والسور وأماكن الانتظار.", "الطابع المعماري والنموذج الموحد إن كان مطلوبًا."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("590px", "100%")}
					pTitle={Text.H3.Centered.OfText("مرحلة الملف الهندسي والتقديم")}
					pDesc={Text.Body.Centered.OfText("هدفها تحويل الاشتراطات إلى ملف قابل للفحص والاعتماد")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.Creamy)}
					pNumbered={true}
					pItems={[
						{ Title: "تفعيل حساب المالك والمكتب", Items: ["تجهيز مستندات المالك وبياناته على البوابة عند العمل إلكترونيًا.", "تجهيز بيانات المكتب الهندسي وكارنيه النقابة والسجل الهندسي والبطاقة الضريبية عند طلبها.", "الحصول على كود الأرض وربطه بالطلب الصحيح."] },
						{ Title: "إعداد بيان الصلاحية", Items: ["تقديم طلب بيان الصلاحية أو مراجعته إذا كان موجودًا.", "مطابقة الاشتراطات الواردة به مع الكراسة وبيانات الجهاز.", "عدم التصميم النهائي قبل التأكد من أن الاشتراطات واضحة."] },
						{ Title: "إعداد الرسومات", Items: ["معماري يلتزم بالردود والنسبة والارتفاع والطابع المعماري.", "إنشائي متوافق مع المعماري والجسات والنوتة الحسابية.", "ملفات PDF و CAD منظمة ومختومة ومعتمدة عند التقديم الإلكتروني."] },
						{ Title: "متابعة الفحص والسداد", Items: ["فحص أولي وتسكين الطلب على العقار أو القطعة.", "استيفاء ملاحظات التراخيص داخل الجهاز.", "سداد الرسوم وإتاحة الرخصة بصيغة إلكترونية أو استلامها حسب نظام الجهاز."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="المستندات المطلوبة لترخيص بناء بالمدن الجديدة"
			pDesc="المستندات تتغير حسب نوع الطلب، لكن الهيكل العملي يدور حول المالك والأرض والاشتراطات والرسومات والاعتمادات"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1180, 340)}
				pGap={new Pixel(28, 16)}
				pPad={new Pixel(34, 14)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("لا تعتمد على قائمة ثابتة منقولة")}
					pText={Text.Body.WithAlign("right").OfText(`ملف المدن الجديدة يتغير بتغير الطلب. إنشاء جديد يختلف عن تعديل، والتعلية تختلف عن استكمال غرف السطح، وقطعة فردية في بيت الوطن تختلف عن قطعة شركة أو خدمة أو نشاط صناعي. لذلك فالقائمة التالية ليست وعدًا بأن كل بند سيطلب في كل مدينة، لكنها قائمة مراجعة عملية تمنع النقص المتكرر. عند الفحص الفعلي يجب الرجوع إلى جهاز المدينة والبوابة والكراسة وبيان الصلاحية والرخص السابقة، لأن الجهاز قد يطلب مستندًا إضافيًا بسبب طبيعة القطعة أو الموقف التنفيذي أو النشاط أو الارتفاع أو قرب الموقع من قيود طيران أو دفاع أو مرافق.`)}
					pSize={new Size(new NumPer(1060, "100%"), new NumPer("auto", "auto"))}
				/>

				<EmoList
					pWidth={new RespString("1080px", "100%")}
					pTitle={Text.H3.Centered.OfText("قائمة مراجعة المستندات")}
					pDesc={Text.Body.Centered.OfText("تستخدم قبل فتح الطلب حتى لا يتحول الملف إلى سلسلة استيفاءات")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pNumbered={false}
					pItems={[
						{ Title: "مستندات المالك والصفة", Items: ["صورة بطاقة الرقم القومي للمالك أو الملاك.", "توكيل أو تفويض للمكتب الهندسي أو من يتابع الملف.", "في حالة الشركات: سجل تجاري وبطاقة ضريبية وما يثبت صفة الممثل القانوني.", "في حالة الورثة أو الشركاء: مستندات الصفة والتوكيلات اللازمة للتعامل مع الجهاز."] },
