				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("التصميم قبل قراءة الكراسة", "ينتج رسومات مخالفة للنسبة أو الردود أو الطابع أو البدروم أو غرف السطح، فتضيع تكلفة التصميم في التعديل.")}
				pTopic2={new Topic("تجاهل كود الأرض", "التقديم الإلكتروني يتعامل مع قطعة محددة، وأي تعارض بين الكود والمالك والمكتب يوقف الطلب أو يمنع تسكينه.")}
				pTopic3={new Topic("موقف مالي غير مغلق", "وجود أقساط أو مستحقات أو غرامات أو مهلة منتهية قد يمنع التعامل حتى لو كانت الرسومات جاهزة.")}
				pTopic4={new Topic("خلط الإنشاء بالتعديل", "قطعة عليها رخصة أو تنفيذ قائم لا تعامل مثل أرض فضاء، وقد تحتاج تحديد موقف تنفيذي وشهادة تحمل ومراجعة للرخصة السابقة.")}
				pTopic5={new Topic("إهمال قيود الارتفاع", "القوات المسلحة أو الطيران المدني قد يكون لهما أثر في بعض المناطق، ولا يصح اكتشاف ذلك بعد تثبيت التصميم.")}
				pTopic6={new Topic("ملفات إلكترونية غير صالحة", "ملفات PDF غير مختومة أو CAD غير منظم أو مستندات منتهية الصلاحية قد تسبب رفض التفعيل أو طلب استيفاء.")}
			/>

