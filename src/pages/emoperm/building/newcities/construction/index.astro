	<ESec
		id="cta"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="خدمة تراخيص البناء بالمدن الجديدة"
			pDesc="نراجع قطعة الأرض كملف جهاز كامل، ثم نحدد مسار الترخيص الصحيح ونجهز الرسومات والمستندات والمتابعة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
