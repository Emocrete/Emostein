			>

				<EmoList
					pWidth={new RespString("1080px", "100%")}
					pTitle={Text.H3.Centered.OfText("منهج العمل")}
					pDesc={Text.Body.Centered.OfText("الهدف أن يدخل الملف إلى الجهاز وهو مفهوم، لا أن ننتظر الاستيفاءات لتخبرنا بما كان يجب مراجعته من البداية")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pNumbered={true}
					pItems={[
						{ Title: "استلام بيانات القطعة", Items: ["المدينة، رقم القطعة، المنطقة، المساحة، نوع الطرح، مستند الملكية أو الاستلام، والرخص السابقة إن وجدت."] },
						{ Title: "فحص موقف الجهاز", Items: ["المهلة، الموقف المالي، كود الأرض، التنازل أو نقل الملكية، والموقف التنفيذي إن كان هناك تنفيذ سابق."] },
						{ Title: "قراءة الاشتراطات", Items: ["النسبة، الردود، الارتفاع، البدروم، الروف، الطابع المعماري، القيود الخاصة، وأماكن الانتظار."] },
						{ Title: "تجهيز الرسومات", Items: ["معماري وإنشائي وجسات ونوتة وشهادات ونماذج حساب التكلفة حسب الحاجة."] },
						{ Title: "التقديم والمتابعة", Items: ["رفع المستندات، متابعة الاستيفاءات، السداد، ومتابعة إصدار الرخصة حتى التسليم."] }
					]}
				/>

				<Emograph
					pTitle={Text.H3.Centered.OfText("أرسل مستندات الأرض قبل تنفيذ أي تصميم نهائي")}
					pText={Text.Body.Centered.OfText(`أفضل توقيت لمراجعة الترخيص هو قبل اعتماد المساقط النهائية. بمجرد معرفة المدينة ورقم القطعة ونوع الطلب ومستند الاستلام والكراسة والرخص السابقة إن وجدت، يمكن تحديد هل المطلوب بيان صلاحية فقط أم إنشاء جديد أم تعديل أو تعلية أم استكمال غرف سطح، وهل الملف يحتاج تأمينًا أو تقرير تربة أو قيود ارتفاع أو موافقة خاصة. هذه القراءة المبكرة توفر وقتًا وتمنع إعادة رسم مشروع كامل بسبب بند كان واضحًا في مستندات الجهاز.`)}
					pSize={new Size(new NumPer(980, "100%"), new NumPer("auto", "auto"))}
				/>

				<EmoCall BlackSky pText="اتصل لمراجعة ترخيص البناء" />

			</VrStack>

