---
import { Align, Colors, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص تعلية بالمدن الجديدة"
	pDescr="خدمة مراجعة واستخراج ترخيص تعلية أو تعديل أو إضافة مبانٍ داخل المدن الجديدة التابعة لهيئة المجتمعات العمرانية، مع فحص رخصة المبنى السابقة، كود الأرض، بيان الصلاحية، موقف التنفيذ، قدرة المبنى على تحمل التعلية، وثيقة التأمين، وملف التقديم الإلكتروني بجهاز المدينة."
>







	<Hero
		pImgL="https://images.alborsaanews.com/2021/01/1541584472_108_5908246____.jpg"
		pImgP="https://media.gemini.media/img/portrait/2024/11/26/2024_11_26_13_45_26_999.webp"
		pTitle="ترخيص تعلية بالمدن الجديدة"
		pDesc="التعلية داخل جهاز المدينة ليست قرارًا فوق السطح؛ هي مراجعة لكود الأرض والرخصة السابقة واشتراطات الجهاز وقدرة المبنى على تحمل الدور الجديد"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="42% 42% 10% 8%"
		pPosP="14% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="راجع إمكانية التعلية" />

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="ثلاث بوابات قبل ترخيص التعلية"
			pDesc="في المدن الجديدة لا يكفي أن يكون السطح خاليًا أو أن المالك يريد دورًا إضافيًا؛ يجب أن يمر الطلب من بوابة الجهاز وبوابة الرخصة السابقة وبوابة السلامة الإنشائية"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(420, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.WhiteOff)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("١")}
						pText={Text.H4.Centered.OfText("هل جهاز المدينة يسمح؟")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pText={Text.Body.Centered.OfText("يجب قراءة بيان الصلاحية أو الاشتراطات أو كراسة المنطقة: الردود، الارتفاع، غرف السطح، نسبة البناء، الطابع المعماري، وموقف أي قرارات خاصة بالتعلية أو زيادة المسطح.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(420, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("٢")}
						pText={Text.H4.Centered.OfText("هل الرخصة السابقة صالحة للبناء عليها؟")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pText={Text.Body.Centered.OfText("التعلية لا تبدأ من سطح قائم فقط؛ تبدأ من رخصة سابقة ورسومات معتمدة وموقف تنفيذي يثبت أن المبنى القائم نفسه مفهوم ومطابق أو قابل لتصحيح موقفه.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<VrStack
					pWidth={new Pixel(420, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.GreenLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("٣")}
						pText={Text.H4.Centered.OfText("هل المبنى يتحمل؟")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pText={Text.Body.Centered.OfText("حتى لو الجهاز يسمح بالارتفاع، لا يصح التقديم بدون فحص إنشائي يقرأ الأساسات والأعمدة والأسقف والأحمال الجديدة وإمكانية التدعيم عند الحاجة.")}
						pSize={new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="لا تخلط بين التعلية وزيادة مسطح دور السطح"
			pDesc="في منظومة المدن الجديدة تظهر طلبات متقاربة في الاسم لكنها مختلفة في المعنى: تعلية، تعديل، إضافة، استكمال، وزيادة مسطح مباني بدور السطح"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"https://media.gemini.media/img/portrait/2024/11/26/",
						"2024_11_26_13_45_26_999.webp",
						false,
						"مقر هيئة المجتمعات العمرانية الجديدة",
						new Size(new NumPer(450, "100%"), new NumPer("auto", "auto"))
					)}
				/>

				<VrStack
					pWidth={new Pixel(750, 340)}
					pGap={new Pixel(25, 15)}
					pPad={new Pixel(0, 0)}
				>

					<Emograph
						pTitle={Text.H3.WithAlign("right").OfText("التعلية ليست دائمًا روف")}
						pText={Text.Body.WithAlign("right").OfText(`بعض العملاء يقولون "عايز أعلّي" وهو يقصد استكمال غرف السطح أو زيادة مسطح الروف، وعميل آخر يقصد إضافة دور كامل، وثالث يقصد تعديل رخصة قائمة، ورابع لديه تنفيذ قائم ويريد تقنينه قبل استكماله. داخل جهاز المدينة، اختيار اسم الطلب ليس تفصيلًا لغويًا؛ لأنه يحدد المستندات والرسومات والموافقة المطلوبة والرسوم والمراجعات. لذلك يجب فصل ترخيص التعلية عن صفحة استكمال الروف: التعلية هنا تعني إضافة أو تعديل بنائي على مبنى قائم داخل مدينة جديدة، أما زيادة مسطح دور السطح لها صفحة مستقلة لأنها ترتبط بقرارات ونسب وسقف مسطح مخصوص.`)}
						pSize={new Size(new NumPer(750, "100%"), new NumPer("auto", "auto"))}
					/>

					<EmoCall BlackSky pText="حدد نوع طلبك قبل الرسم" />

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="شاشة البوابة قبل لوحة المعماري"
			pDesc="التقديم الإلكتروني في المدن الجديدة جعل بيانات القطعة والمالك والمكتب جزءًا من صحة الملف وليس مجرد خطوة إدارية بعد التصميم"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1200, 340)}
				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("ما الذي يجب أن يظهر صحيحًا قبل رفع ملف التعلية؟")}
					pText={Text.Body.Centered.OfText("في جهاز المدينة، الملف الرقمي لا يسامح اختلاف الاسم أو كود الأرض أو نوع الخدمة. لذلك نراجع بيانات الطلب كما نراجع اللوحات: المدينة، رقم القطعة، المالك، التوكيل، المكتب، الرخص السابقة، نوع الطلب، وملفات الرسومات.")}
					pSize={new Size(new NumPer(1100, "100%"), new NumPer("auto", "auto"))}
				/>

				<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(0, 0)}>

					<EmoList
						pWidth={new RespString("600px", "100%")}
						pTitle={Text.H3.Centered.OfText("بيانات لا تحتمل التخمين")}
						pDesc={Text.Body.Centered.OfText("هذه البيانات تحدد هل الطلب سيُقبل للفحص أم يتوقف قبل المراجعة الفنية")}
						pHeadBg={new ElemBg(Colors.WhiteOff)}
						pItemsBg={new ElemBg(Colors.SkyLite)}
						pItemFnt={Text.Body}
						pNumbered={true}
						pItems={[
							{ Title: "كود الأرض", Items: ["ربط الطلب بالقطعة الصحيحة داخل جهاز المدينة.", "مطابقة رقم القطعة والمنطقة والحي والمجاورة مع مستندات الملكية."] },
							{ Title: "صفة مقدم الطلب", Items: ["مالك فرد، شركة، وكيل، شريك، أو ممثل قانوني.", "التأكد من أن التوكيل يسمح بطلب التعلية أو تعديل الترخيص."] },
							{ Title: "نوع الخدمة", Items: ["تعلية، تعديل، إضافة، استكمال، زيادة مسطح دور سطح، أو تحديد موقف تنفيذي.", "اختيار النوع الخطأ يغير المستندات والرسوم والمراجعة."] },
							{ Title: "حساب المكتب", Items: ["بيانات المهندس أو المكتب الهندسي.", "الاعتمادات المطلوبة والتوقيع والختم ورفع الملفات بالصيغة المقبولة."] }
						]}
					/>

					<EmoList
						pWidth={new RespString("600px", "100%")}
						pTitle={Text.H3.Centered.OfText("ملفات لا ترفع عشوائيًا")}
						pDesc={Text.Body.Centered.OfText("الملف الإلكتروني السيئ قد يعطل الطلب حتى لو كان التصميم قابلًا للمراجعة")}
						pHeadBg={new ElemBg(Colors.WhiteOff)}
						pItemsBg={new ElemBg(Colors.Creamy)}
						pItemFnt={Text.Body}
						pNumbered={true}
						pItems={[
							{ Title: "رخصة ورسومات سابقة", Items: ["الرخصة القديمة إن وجدت.", "اللوحات المعتمدة القديمة أو ما يثبت الوضع المرخص."] },
							{ Title: "بيان الصلاحية", Items: ["بيان حديث أو اشتراطات معتمدة.", "مطابقة الارتفاع والسطح والردود مع التعلية المقترحة."] },
							{ Title: "ملفات PDF و CAD", Items: ["لوحات مقروءة ومختومة.", "تسمية واضحة لكل ملف لتقليل الاستيفاءات."] },
							{ Title: "مستندات مالية وإدارية", Items: ["موقف الأقساط أو المستحقات أو المهلة.", "محضر الاستلام أو العقد أو إخطار التخصيص حسب الحالة."] }
						]}
					/>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="اختبار الرخصة السابقة"
			pDesc="لا يوجد ترخيص تعلية قوي فوق رخصة قديمة غير مفهومة أو تنفيذ قائم غير مطابق"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<VrStack
					pWidth={new Pixel(500, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(25, 15)}
					pBgColor={new ElemBg(Colors.SkyLite)}
				>

					<Emograph
						pTitle={Text.H3.Centered.OfText("نسأل الجهاز عن الماضي قبل أن نرسم المستقبل")}
						pText={Text.Body.WithAlign("right").OfText("الرخصة السابقة تحدد المساحات المرخصة، عدد الأدوار، نظام السطح، استخدام البدروم أو الجراج، مواضع الأعمدة والمناور، وموقف أي تعديلات تمت. إذا كان المنفذ على الطبيعة مختلفًا عن الرخصة، فالتعلية قد لا تكون طلبًا مباشرًا، بل قد تحتاج تحديد موقف تنفيذي أو تعديل أو تصحيح قبل دخول مرحلة الدور الجديد.")}
						pSize={new Size(new NumPer(450, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<EmoList
					pWidth={new RespString("700px", "100%")}
					pTitle={Text.H3.Centered.OfText("علامات خطر في الرخصة القديمة")}
					pDesc={Text.Body.Centered.OfText("وجود واحدة من هذه العلامات لا يعني رفض التعلية تلقائيًا، لكنه يعني أن الملف يحتاج فحصًا قبل التصميم")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pItemFnt={Text.Body}
					pNumbered={false}
					pItems={[
						{ Title: "الرخصة غير متاحة", Items: ["المالك لا يملك نسخة واضحة من الرخصة أو الرسومات السابقة.", "هنا قد نحتاج شهادة بيانات أو مستند بديل من الجهاز."] },
						{ Title: "الواقع أعلى من المرخص", Items: ["وجود أدوار أو غرف أو تعديلات لم تكن ضمن الرخصة السابقة.", "هذا قد يحول الملف إلى تحديد موقف أو تصالح أو تعديل قبل التعلية."] },
						{ Title: "تغيير في الاستخدام", Items: ["جراج تحول إلى محلات أو مخازن.", "بدروم مستخدم بطريقة غير التي ظهرت في الرخصة."] },
						{ Title: "تعديلات في الهيكل", Items: ["تكسير حوائط أو تغيير فتحات أو تعديل أعمدة أو تحميل السطح بخزانات وغرف.", "هذه التعديلات تؤثر على تقرير التحمل الإنشائي."] }
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="التعلية قرار إنشائي قبل أن تكون قرارًا تسويقيًا"
			pDesc="فيلا أو عمارة داخل مدينة جديدة قد تبدو منتظمة من الخارج، لكن الحكم الحقيقي يكون من الأساسات والأعمدة والأحمال والرخصة السابقة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1200, 340)}
				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
			>

				<Emograph
					pTitle={Text.H3.Centered.OfText("السطح لا يقول الحقيقة كاملة")}
					pText={Text.Body.WithAlign("right").OfText(`المالك يرى أن السطح واسع وأن إضافة دور ستزيد قيمة العقار، لكن المهندس يرى شيئًا آخر: هل الأساسات صممت أصلًا لهذا الحمل؟ هل الأعمدة القائمة كافية؟ هل تم تغيير الجراج أو فتح محلات أو إضافة خزانات مياه أو غرف خدمات؟ هل ظهرت شروخ أو هبوط أو صدأ تسليح؟ هل المبنى منفذ على نفس الرسومات المعتمدة؟ وهل التعلية المقترحة ستحتاج تدعيمًا؟ في المدن الجديدة، وجود رخصة أو كراسة لا يلغي هذا الفحص، لأن الجهاز لن يتحمل مسؤولية توقيع هندسي ضعيف فوق مبنى قائم. لذلك نبدأ بالتحمل الإنشائي، ثم نحدد هل ندخل ترخيص التعلية أم نرفضها أو نقترح تدعيمًا أو نقلل المسطح.`)}
					pSize={new Size(new NumPer(1100, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1200px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pGrTitle={Text.H3.Centered.OfText("أعلام حمراء قبل توقيع التعلية")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pSpacing={20}
					pTopic1={new Topic("شروخ مائلة أو هبوط", "لا يتم التعامل معها كملاحظة شكلية؛ قد تغير قرار التعلية بالكامل.")}
					pTopic2={new Topic("تعديلات في الدور الأرضي", "فتح واجهات، إزالة حوائط، تغيير جراج، أو تعديل أعمدة يؤثر مباشرة على التحمل.")}
					pTopic3={new Topic("غرف وخزانات فوق السطح", "الأحمال الموجودة قبل التعلية يجب حسابها، لا تجاهلها كأن السطح خالٍ.")}
					pTopic4={new Topic("غياب رسومات إنشائية قديمة", "عند غياب الرسومات، يزيد احتياج المعاينة والرفع والاختبارات قبل أي قرار.")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="متى تكون التعلية داخل مدينة جديدة مسارًا مختلفًا؟"
			pDesc="اسم المدينة لا يكفي؛ نوع القطعة والمنطقة والطرح والرخصة السابقة يغيرون مسار التعامل"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack
				pWidth={new Pixel(1300, 340)}
				pGap={new Pixel(25, 15)}
				pPad={new Pixel(30, 15)}
			>

				<HzStack pGap={new Pixel(25, 15)} pPad={new Pixel(0, 0)}>

					<Emograph
						style = {`background:${Colors.WhiteOff}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("القاهرة الجديدة والتجمعات")}
						pText={Text.Body.Centered.OfText("الأكثر حساسية في مطابقة كود الأرض وبيانات البوابة ونوع الخدمة، خصوصًا مع تعدد المناطق: بيت الوطن، الأندلس، شمال الرحاب، اللوتس، البنفسج، التجمع الأول والثالث والخامس.")}
						pSize={new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						style = {`background:${Colors.SkyLite}; padding:25px; border-radius:18px;`}
						pTitle={Text.H4.Centered.OfText("الشروق وبدر والعبور")}
