---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="تراخيص البناء والهدم بالأحياء والمدن الجديدة"
	pDescr="دليل شامل لخدمات تراخيص البناء في مصر، يوضح الفرق بين ترخيص البناء داخل الأحياء وترخيص البناء في المدن الجديدة، مع شرح بيان الصلاحية، المستندات، الرسومات الهندسية، مراجعة الملف، اشتراطات الجهاز أو الحي، ومسار الانتقال للصفحات المخصصة."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تراخيص البناء والهدم بالأحياء والمدن الجديدة")}
				pText={Text.Body.Centered.OfText("دليل شامل لخدمات تراخيص البناء في مصر، يوضح الفرق بين ترخيص البناء داخل الأحياء وترخيص البناء في المدن الجديدة، مع شرح بيان الصلاحية، المستندات، الرسومات الهندسية، مراجعة الملف، اشتراطات الجهاز أو الحي، ومسار الانتقال للصفحات المخصصة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
