---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="CollectionPage"
	pTitle="تراخيص البناء بالأحياء والمدن الجديدة"
	pDescr="دليل توزيعي شامل لخدمات تراخيص البناء في مصر، يوضح الفرق بين ترخيص البناء داخل الأحياء وترخيص البناء في المدن الجديدة، مع شرح بيان الصلاحية، المستندات، الرسومات الهندسية، مراجعة الملف، اشتراطات الجهاز أو الحي، ومسار الانتقال للصفحات المخصصة."
>







	<Hero
		pTitle="تراخيص البناء بالأحياء والمدن الجديدة"
		pDesc="صفحة توزيعية لفهم المسارين المختلفين: ترخيص بناء داخل نطاق الأحياء، وترخيص بناء داخل المدن الجديدة التابعة لهيئة المجتمعات العمرانية"
	>

		<EmoCall BlackSky />

	</Hero>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			GreenLite
			pTitle="ترخيص البناء ليس إجراءً واحدًا في كل مكان"
			pDesc="نفس كلمة ترخيص بناء قد تعني ملفًا مختلفًا تمامًا حسب تبعية الأرض: حي قائم داخل محافظة، أم قطعة أرض داخل مدينة جديدة لها جهاز واشتراطات وتخصيص وموقف مالي وتنفيذي"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack pGap={new Pixel(28, 16)} pPad={new Pixel(32, 14)}>

				<Emograph
					pTitle={Text.H3.Centered.OfText("قبل تجهيز الرسومات يجب تحديد الجهة صاحبة الولاية")}
					pText={Text.Body.Centered.OfText(`أول قرار في ملف ترخيص البناء ليس اختيار شكل الواجهة ولا عدد الغرف ولا نظام الإنشاء، بل تحديد الجهة التي ستراجع الملف وتصدر الترخيص. إذا كانت الأرض داخل نطاق حي أو وحدة محلية، فالمسار يدور غالبًا حول المركز التكنولوجي، الإدارة الهندسية، بيان صلاحية الموقع، الاشتراطات التخطيطية والبنائية المعتمدة، مستند الملكية، الرسومات الهندسية، ومراجعة الملف داخل الجهة الإدارية. أما إذا كانت الأرض داخل مدينة جديدة، فالمسار يبدأ من علاقة المالك بجهاز المدينة وهيئة المجتمعات العمرانية: تخصيص أو عقد أو محضر استلام، موقف مالي وإداري، كود قطعة الأرض، اشتراطات الكراسة أو النماذج العمرانية، ثم تقديم ملف إلكتروني أو ورقي طبقًا لما يحدده الجهاز والبوابة. لذلك فهذه الصفحة لا تتعامل مع تراخيص البناء كقائمة مستندات محفوظة، بل كفرعين مختلفين في الميدان، لكل فرع مخاطر وأخطاء واختبارات قبول مختلفة.`)}
					pSize={new Size(new NumPer(1100, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pWidth={new RespString("1220px", "100%")}
					pCardBg={new ElemBg(Colors.SkyLite)}
					pGrTitle={Text.H3.Centered.OfText("الفصل العملي بين الفرعين")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("الأحياء والوحدات المحلية", "ملف يرتبط بالمركز التكنولوجي والإدارة الهندسية داخل الحي أو المدينة أو القرية، ويعتمد على بيان صلاحية الموقع، مستند الملكية، الرسومات، الاشتراطات المحلية، ومراجعة التنظيم.")}
					pTopic2={new Topic("المدن الجديدة", "ملف يرتبط بجهاز المدينة وهيئة المجتمعات العمرانية، ويضيف إلى ملف الرسومات عناصر تخص التخصيص، محضر الاستلام، الكراسة، الموقف المالي، كود الأرض، واشتراطات الجهاز.")}
					pTopic3={new Topic("القاسم المشترك", "كلا المسارين يحتاج مهندسًا أو مكتبًا هندسيًا مؤهلًا، ورسومات معمارية وإنشائية منضبطة، وبيان صلاحية أو ما يقابله، ومراجعة فنية قبل إصدار الرخصة.")}
					pTopic4={new Topic("نقطة الخطر", "أغلب التأخير يحدث عندما يتعامل المالك مع الفرعين بنفس المنطق: يقدم ملف حي وكأنه ملف جهاز مدينة، أو يتعامل مع قطعة مدينة جديدة وكأنها عقار داخل شارع قائم.")}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			Gray3
			pTitle="أولًا: تراخيص البناء داخل الأحياء"
			pDesc="مسار الأحياء هو المسار الأقرب للمباني داخل العمران القائم: شارع موجود، جيران ملاصقون، مرافق قائمة، اشتراطات تنظيم محلية، وإدارة هندسية تفحص تأثير البناء على النسيج العمراني المحيط"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack pGap={new Pixel(26, 16)} pPad={new Pixel(34, 14)}>

				<Emograph
					pTitle={Text.H3.Centered.OfText("طبيعة ترخيص البناء داخل الحي")}
					pText={Text.Body.WithAlign("right").OfText(`ترخيص البناء داخل الأحياء يتعامل مع أرض أو عقار داخل كتلة عمرانية قائمة، وقد تكون الأرض فضاء بين مبانٍ قائمة، أو عقارًا قديمًا تم هدمه، أو قطعة داخل تقسيم قديم، أو حالة تعلية على مبنى قائم، أو بناء جديد بعد إزالة. هذا النوع من التراخيص لا يراجع الرسومات كتصميم هندسي مجرد فقط، بل يراجع علاقتها بالشارع وخط التنظيم والارتفاعات المسموح بها والجيران والمرافق وعرض الطريق وحالة الملكية. لذلك فإن الملف الناجح يبدأ من قراءة الموقع قبل الرسم: هل الأرض داخل حيز عمراني؟ هل لها مخطط تفصيلي أو خط تنظيم واضح؟ هل الشارع يسمح بالارتفاع المطلوب؟ هل هناك ارتدادات أو قيود واجهة أو حد أقصى للكثافة؟ هل يوجد تعارض مع أملاك دولة أو منافع عامة أو مرافق؟ هل مستند الملكية كافٍ للتعامل أم يحتاج استكمالًا أو توضيحًا؟ هذه الأسئلة ليست أسئلة نظرية، لأنها هي التي تحدد هل سيتم إعداد مشروع قابل للترخيص أم سيتم إنتاج رسومات جميلة لكنها مرفوضة إداريًا.`)}
					pSize={new Size(new NumPer(1120, "100%"), new NumPer("auto", "auto"))}
				/>

				<Emograph
					pTitle={Text.H3.Centered.OfText("لماذا يبدأ ملف الحي ببيان صلاحية الموقع؟")}
					pText={Text.Body.WithAlign("right").OfText(`بيان صلاحية الموقع هو نقطة الفصل بين الرغبة في البناء والقدرة القانونية والتخطيطية على البناء. المالك قد يرى أن الأرض ملكه، وأنه يستطيع بناء عمارة مثل العمارات المجاورة، لكن الجهة الإدارية لا تنظر إلى الأمر بهذا التبسيط. البيان يوضح مدى صلاحية الموقع للبناء من الناحية التخطيطية والاشتراطات البنائية، ويفتح الطريق أمام المكتب الهندسي لكي يصمم داخل حدود معلومة بدل الاعتماد على التوقع. في الأحياء، قد تؤثر تفاصيل صغيرة على النتيجة: عرض الشارع الفعلي، وجود ناصية، وقوع الأرض داخل منطقة لها اشتراطات خاصة، وجود خطوط تنظيم قديمة، اختلاف المساحة بالعقد عن الطبيعة، أو وجود مبنى قائم يحتاج موقفًا واضحًا قبل إصدار رخصة جديدة. لذلك فإن استخراج بيان الصلاحية ليس ورقة شكلية؛ هو قراءة مبكرة للمخاطر التي قد تظهر لاحقًا بعد دفع تكلفة التصميم أو بدء التعاقدات.`)}
					pSize={new Size(new NumPer(1120, "100%"), new NumPer("auto", "auto"))}
				/>

				<CardsGr
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pGrTitle={Text.H3.Centered.OfText("ما الذي يهم الحي عند فحص الترخيص؟")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("صفة مقدم الطلب", "هل مقدم الطلب هو المالك أو وكيل عنه بتوكيل يسمح بالسير في الإجراءات؟ وهل بياناته متطابقة مع مستندات الملكية وملف الترخيص؟")}
					pTopic2={new Topic("سلامة سند الملكية", "هل المستند يثبت الحق في الأرض أو العقار؟ وهل المساحة والحدود والعنوان واضحة بما يسمح بمطابقتها على الطبيعة؟")}
					pTopic3={new Topic("صلاحية الموقع", "هل الموقع يسمح بالبناء أصلًا طبقًا للمخطط والاشتراطات؟ وهل عرض الشارع والارتفاع ونسبة البناء تسمح بالمشروع المقترح؟")}
					pTopic4={new Topic("الرسومات الهندسية", "هل الرسومات المعمارية والإنشائية متوافقة مع الاشتراطات، وموقعة ومعتمدة، وتشرح المشروع دون تناقض بين اللوحات؟")}
					pTopic5={new Topic("قيمة الأعمال والتأمين", "هل تكلفة الأعمال تدخل في حالات تتطلب وثيقة تأمين أو مراجعات إضافية؟ وهل بيان التكلفة واقعي ومعد طبقًا للنموذج المطلوب؟")}
					pTopic6={new Topic("الإشراف والتنفيذ", "هل يوجد مهندس إشراف ومقاول عند المرحلة المطلوبة؟ وهل الملف يسمح بالمتابعة أثناء التنفيذ وليس فقط إصدار رخصة على الورق؟")}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="مسار ترخيص البناء داخل الحي"
			pDesc="الترخيص داخل الأحياء يتحرك غالبًا في مرحلتين: صلاحية الموقع أولًا، ثم ملف الرخصة الهندسي والإداري ثانيًا"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(24, 14)} pPad={new Pixel(32, 12)}>

				<EmoList
					pWidth={new RespString("590px", "100%")}
					pTitle={Text.H3.Centered.OfText("مرحلة بيان الصلاحية")}
					pDesc={Text.Body.Centered.OfText("الغرض منها معرفة هل الموقع يسمح بالبناء وما هي حدود التصميم قبل تجهيز ملف الرخصة النهائي")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pNumbered={true}
					pItems={[
						{ Title: "تحديد العقار على الطبيعة", Items: ["مراجعة العنوان والشارع والحي التابع له العقار.", "مطابقة الحدود والمساحة مع المستندات المتاحة.", "التأكد من أن الموقع ليس داخل نزاع واضح أو تعدٍ أو تعارض تنظيمي ظاهر."] },
						{ Title: "تقديم طلب بيان الصلاحية", Items: ["تقديم الطلب من صاحب الشأن أو من يمثله.", "إرفاق صورة بطاقة الرقم القومي وما يلزم من توكيل أو تفويض.", "إرفاق كروكي أو بيانات موقع تسمح بتحديد الأرض بوضوح."] },
						{ Title: "الرفع أو المعاينة المساحية", Items: ["تحديد الأبعاد والواجهة وعرض الشارع.", "رصد الوضع القائم حول القطعة.", "تسجيل أي فروق مؤثرة بين المستند والواقع."] },
						{ Title: "إصدار الاشتراطات", Items: ["تحديد الارتفاع ونسبة البناء والردود إن وجدت.", "توضيح القيود التخطيطية والبنائية التي يجب الالتزام بها.", "استخدام البيان كأساس للتصميم لا كإجراء منفصل عن التصميم."] }
					]}
				/>

				<EmoList
					pWidth={new RespString("590px", "100%")}
					pTitle={Text.H3.Centered.OfText("مرحلة ملف الرخصة")}
					pDesc={Text.Body.Centered.OfText("بعد معرفة حدود البناء يبدأ إعداد ملف هندسي قابل للفحص والاعتماد")}
					pHeadBg={new ElemBg(Colors.Creamy)}
					pItemsBg={new ElemBg(Colors.Gray1)}
					pNumbered={true}
					pItems={[
						{ Title: "إعداد التصميم المعماري", Items: ["توزيع الأدوار والفراغات داخل حدود الاشتراطات.", "الالتزام بخط التنظيم والارتفاع ونسبة البناء.", "تجنب تصميم وحدات أو فتحات أو مناور تخالف متطلبات التنظيم أو الكود."] },
						{ Title: "إعداد التصميم الإنشائي", Items: ["اختيار النظام الإنشائي المناسب للتربة والارتفاع والاستخدام.", "إعداد اللوحات والنوتة الحسابية عند الحاجة.", "ربط الإنشائي بالمعماري دون تعارض في الأعمدة والمناور والفتحات."] },
						{ Title: "تجهيز المستندات الفنية", Items: ["شهادة صلاحية الأعمال للترخيص.", "بيان حساب قيمة الأعمال.", "تقرير تربة أو مستندات تأمين إذا دخل المشروع في حالاتها."] },
						{ Title: "المراجعة والسداد والاستلام", Items: ["مراجعة الملف داخل الجهة المختصة.", "استيفاء الملاحظات إن وجدت.", "تحديد الرسوم والسداد ثم استلام الترخيص طبقًا للإجراءات المعمول بها."] }
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="المستندات والرسومات في ترخيص بناء الأحياء"
			pDesc="الملف القوي هو الملف الذي يربط المستند الإداري بالقرار التخطيطي بالرسم الهندسي دون تناقض"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.BlackOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1180, 340)}
				pGap={new Pixel(28, 16)}
				pPad={new Pixel(34, 14)}
			>

				<Emograph
					pTitle={Text.H3.Centered.White.OfText("المستند الإداري لا يغني عن سلامة الرسم")}
					pText={Text.Body.WithAlign("right").White.OfText(`في ملفات الأحياء يظهر خطأ متكرر: المالك يجمع صور بطاقات وعقود وتوكيلات ويظن أن ملفه جاهز، بينما جوهر الترخيص لا يزال ناقصًا لأن الرسم لم يقرأ الاشتراطات. الجهة الإدارية لا تمنح الترخيص لأن العقد موجود فقط؛ هي تمنحه عندما يثبت الملف أن البناء المقترح مطابق لما يسمح به الموقع. لذلك يجب أن تتكلم المستندات واللوحات لغة واحدة. المساحة في العقد يجب ألا تتعارض مع المساحة المرفوعة دون تفسير. الواجهة في الرسم يجب أن تتفق مع الواقع. عدد الأدوار يجب أن ينبع من بيان الصلاحية لا من رغبة المالك. المناور والردود والفتحات والسلالم يجب أن تكون قابلة للفحص. الإنشائي يجب ألا يهدم فكرة المعماري. وقيمة الأعمال يجب ألا تبدو رقمًا عشوائيًا منفصلًا عن حجم المشروع. كلما كان الملف مترابطًا، قل احتمال طلب الاستيفاءات المتكررة.`)}
					pSize={new Size(new NumPer(1080, "100%"), new NumPer("auto", "auto"))}
				/>

				<EmoList
					pWidth={new RespString("1080px", "100%")}
					pTitle={Text.H3.Centered.OfText("مكونات الملف التي يجب مراجعتها")}
					pDesc={Text.Body.Centered.OfText("هذه ليست قائمة ثابتة لكل حالة، لكنها تمثل الهيكل العملي الذي يدور حوله ملف ترخيص البناء داخل الحي")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pNumbered={false}
					pItems={[
						{ Title: "مستندات صفة وملكية", Items: ["صورة بطاقة الرقم القومي لصاحب الترخيص.", "مستند الملكية أو الحيازة المقبول للجهة الإدارية.", "توكيل أو تفويض للمهندس أو المكتب الهندسي إذا كان هو من يتابع الإجراءات.", "أي مستندات توضح الورثة أو الشركاء أو الصفة القانونية عند وجود أكثر من مالك."] },
						{ Title: "مستندات الصلاحية والتخطيط", Items: ["طلب بيان صلاحية الموقع.", "كروكي أو بيانات موقع واضحة.", "بيان الصلاحية بعد صدوره أو ما يفيد الاشتراطات التي سيتم التصميم على أساسها.", "أي إفادات تخص خط التنظيم أو القيود التخطيطية إن ظهرت في الحالة."] },
						{ Title: "الرسومات الهندسية", Items: ["رسومات معمارية تبين الموقع العام، الأدوار، الواجهات، القطاعات، المناور، السلالم، ومناطق الخدمات.", "رسومات إنشائية متوافقة مع المعماري ونظام الأساسات والأعمدة والكمرات والأسقف.", "اعتمادات وتوقيعات المكتب أو المهندس طبقًا لما تطلبه الجهة المختصة.", "مراجعة التناسق بين اللوحات حتى لا يذكر الرسم المعماري شيئًا ويخالفه الإنشائي."] },
