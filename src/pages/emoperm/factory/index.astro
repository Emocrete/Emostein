---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { PriceCard } from "@/Widgets/Prices";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مصنع"
	pDescr="خدمة تجهيز ومتابعة ملف ترخيص مصنع ورخصة تشغيل منشأة صناعية، شامل مراجعة النشاط والموقع وسند الحيازة والملف الفني والبيئي وتقرير الحريق وشهادة صلاحية المبنى للإشغال."
>







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("35%","100%"))}
			pLoc={new Loc(new NumPer("7%","0%"),new NumPer("35%","72%"))}
			pGap={new Pixel(50, 5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.Bold.OfText("ترخيص مصنع")}
				pText={Text.Body.Centered.OfSize(24,18).OfText("متابعة ملف رخصة تشغيل المصنع هندسيًا وإداريًا وتجهيز المستندات الفنية للتقديم")}
			/>

			<EmoCall data-own-size BlackOrange pText="التفاصيل" />

		</VrStack>

	</Hero>







	<EmoSec
		id="factory-service"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			pTitle="خدمات ترخيص المصانع"
			pDesc="تجهيز ومتابعة ملف ترخيص المصنع هندسيًا وإداريًا، من مراجعة النشاط والموقع والمستندات حتى تجهيز الملف الفني ومتابعة الاستيفاءات المطلوبة لرخصة التشغيل."
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1200px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pGrTitle={Text.H3.Centered.OfText("ما الذي نقدمه في ملف ترخيص المصنع؟")}
				pCardTitleFnt={Text.H4.Centered}
				pCardBodyFnt={Text.Body.Centered}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("فحص النشاط والموقع", "مراجعة هل النشاط الصناعي مناسب للموقع والمنطقة، وهل بيانات السجل وسند الحيازة والمساحة متوافقة مع الواقع.")}
				pTopic2={new Topic("تجهيز الملف الفني", "تنظيم بيانات المبنى وخطوط الإنتاج والمعدات والتخزين والمرافق والأحمال المطلوبة للتقديم.")}
				pTopic3={new Topic("الحريق والبيئة", "تحديد احتياجات تقرير الحريق والملف البيئي وشهادة صلاحية المبنى للإشغال حسب طبيعة النشاط وحالة المصنع.")}
				pTopic4={new Topic("المتابعة والاستيفاءات", "متابعة الطلب والرد على ملاحظات الجهة المختصة حتى الوصول إلى موقف واضح للترخيص أو المطلوب لاستكماله.")}
			/>

			<EmoList
				pWidth={new RespString("1050px", "100%")}
				pTitle={Text.H3.Centered.OfText("الخدمة مناسبة لـ")}
				pDesc={Text.Body.Centered.OfText("مصنع جديد، مصنع قائم بدون رخصة واضحة، تعديل نشاط أو بيانات، أو منشأة تريد مراجعة ملفها قبل التقديم الرسمي.")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={false}
				pItems={[
				"مراجعة المستندات الأساسية: السجل، البطاقة الضريبية، سند الحيازة، وبيانات المنشأة.",
				"تحديد مسار الترخيص المناسب: إخطار، ترخيص مسبق، أو مكتب اعتماد حسب الحالة.",
				"تجهيز قائمة الاستيفاءات الفنية قبل التقديم لتقليل التعطيل والرفض.",
				"تنسيق الملفات الهندسية أو البيئية أو تقارير الحريق عند الحاجة."
			]}
			/>

			<EmoCall BlackSky pText="ابدأ مراجعة ملف المصنع" />

		</EmoStr>

	</EmoSec>







	<EmoSec
		hidden
		id="factory-prices"
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			pTitle="أسعار خدمات ترخيص المصانع"
			pDesc="السعر النهائي يتحدد بعد معرفة النشاط، مساحة المصنع، حالة المستندات، وجود رسومات، واحتياج الملف لتقارير حريق أو بيئة أو صلاحية مبنى."
		/>

		<EmoStr pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(24, 16)} pPad={new Pixel(30, 15)}>

				<PriceCard
					pCaption={Text.H4.White.Bold.OfText("فحص مبدئي للنشاط والمستندات")}
					pStart={Text.H3.Bold.OfText("يبدأ من")}
					pPrice={0}
					pCurrency={Text.H3.Bold.OfText("جنيه")}
					data-own-size
				/>

				<PriceCard
					pCaption={Text.H4.White.Bold.OfText("تجهيز ومتابعة ملف ترخيص المصنع")}
					pStart={Text.H3.Bold.OfText("يحدد")}
					pPrice="حسب الحالة"
					pCurrency={Text.H3.Bold.OfText("")}
					data-own-size
				/>

				<PriceCard
					pCaption={Text.H4.White.Bold.OfText("تقارير أو موافقات فنية إضافية")}
					pStart={Text.H3.Bold.OfText("تسعر")}
					pPrice="منفردة"
					pCurrency={Text.H3.Bold.OfText("")}
					data-own-size
				/>

			</HzStack>

			<CardsGr
				pWidth={new RespString("1100px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4.Centered}
				pCardBodyFnt={Text.Body.Centered}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("السعر يشمل", "فحص الحالة، تحديد مسار الترخيص، مراجعة المستندات، تجهيز المتطلبات الفنية المتفق عليها، ومتابعة الاستيفاءات.")}
				pTopic2={new Topic("السعر لا يشمل", "الرسوم الحكومية، أتعاب مكاتب الاعتماد، المعامل، القياسات الخارجية، أو أي تعديلات تنفيذية مطلوبة داخل الموقع.")}
				pTopic3={new Topic("متى يثبت السعر؟", "بعد استلام بيانات النشاط والموقع والمستندات المتاحة وتحديد هل الملف يحتاج حريق أو بيئة أو شهادة صلاحية مبنى.")}
			/>

			<EmoCall BlackSky pText="اعرف تكلفة ملف مصنعك" />

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			Gray2
			pTitle="أنظمة رخص التشغيل الصناعية"
			pDesc="تجهيز الملف يبدأ من تحديد مسار الترخيص: إخطار، مسبق، أو تقديم من خلال مكتب اعتماد، مع مراعاة أن طبيعة النشاط قد تنقل الملف من مسار سريع إلى فحص أعمق."
		/>

		<EmoStr pBg={new ElemBg(Colors.Gray3)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1200px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pGrTitle={Text.H3.Centered.White.OfText("اختيار المسار الصحيح قبل تجهيز الملف")}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("رخصة بنظام الإخطار", "تصلح للأنشطة الأقل خطورة عندما تكون المستندات مكتملة والملف الفني والبيئي واضحًا، ويكون التركيز على صحة بيانات المنشأة وسلامة الاشتراطات.")}
				pTopic2={new Topic("رخصة بنظام مسبق", "تظهر في الأنشطة الأعلى حساسية أو التي تحتاج فحصًا وموافقات قبل التشغيل، ويجب التعامل معها كملف فني متكامل لا كطلب إداري سريع.")}
				pTopic3={new Topic("مكاتب الاعتماد", "يمكن استخدام مكتب اعتماد عند ملاءمة الحالة، لكن قيمة المكتب تظهر عندما يكون الملف الهندسي والبيئي والحريق جاهزًا وغير متناقض.")}
				pTopic4={new Topic("حالات خاصة", "الصناعات الدوائية أو الثقيلة أو الخطرة أو ذات الأثر البيئي العالي تحتاج مسارًا أدق وموافقات إضافية حسب النشاط والكود الصناعي والموقع.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="factory-documents"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="مستندات ترخيص مصنع"
			pDesc="القائمة التالية تصلح كبداية عملية لمراجعة ملف رخصة تشغيل المصنع، مع تعديلها حسب النشاط والمنطقة الصناعية وحالة المنشأة القائمة أو الجديدة."
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1050px", "100%")}
				pTitle={Text.H3.Centered.OfText("ملف المستندات الأساسية والفنية")}
				pDesc={Text.Body.Centered.OfText("تجهيز هذه البنود قبل التقديم يقلل الاستيفاءات ويكشف مبكرًا إن كان الملف يحتاج تصحيح بيانات أو استكمال موافقات.")}
				pHeadBg={new ElemBg(Colors.Creamy)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pNumbered={true}
				pItems={[
					{ Title: "مستندات صاحب الطلب والمنشأة", Items: ["إثبات شخصية مقدم الطلب أو من يمثله.", "مستخرج حديث وساري من السجل التجاري.", "البطاقة الضريبية وبيانات الشركة والمدير المسؤول ووسائل التواصل.", "توكيل أو تفويض عند التعامل من خلال وكيل أو مفوض."] },
					{ Title: "سند الحيازة والموقع", Items: ["عقد ملكية أو إيجار أو تخصيص أو مستند حيازة مقبول للمنشأة.", "بيانات المنطقة الصناعية أو المجمع الصناعي أو جهاز المدينة عند وجوده.", "مراجعة تطابق العنوان والمساحة والنشاط مع المستندات والواقع."] },
					{ Title: "ملف التشغيل الصناعي", Items: ["بيان النشاط والمنتجات وخطوط الإنتاج والماكينات والطاقة الإنتاجية.", "شهادة عضوية اتحاد الصناعات عند طلبها.", "رخصة تشغيل سابقة إن وجدت أو ما يثبت الموقف السابق للمنشأة."] },
					{ Title: "الملف الفني والبيئي", Items: ["ملف فني يصف المبنى وخطوط الإنتاج والمرافق والأحمال ومسارات الحركة والتخزين.", "عرض بيئي أو تقييم أثر بيئي حسب مسار الترخيص وطبيعة النشاط.", "موافقات بيئية سابقة إن وجدت مع مراجعة مدى صلاحيتها للنشاط الحالي."] },
					{ Title: "الحريق وصلاحية المبنى", Items: ["تقرير وقاية ضد أخطار الحريق أو موافقة دفاع مدني سابقة حسب الحالة.", "شهادة صلاحية من استشاري معتمد تفيد صلاحية المبنى للإشغال.", "مراجعة المخارج والتهوية والتخزين ومصادر الخطورة قبل تقديم التقرير."] }
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="factory-procedures"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="خطوات استخراج ترخيص مصنع"
			pDesc="الترتيب العملي للخدمة يبدأ من فرز الحالة، ثم تجهيز الملف، ثم التقديم والمتابعة والاستيفاءات حتى صدور رخصة التشغيل أو تحديد المطلوب لاستكمالها."
		/>

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("1050px", "100%")}
				pTitle={Text.H3.Centered.OfText("مسار العمل المقترح")}
				pDesc={Text.Body.Centered.OfText("هذا الترتيب يحول الترخيص من محاولة جمع أوراق إلى إدارة ملف له مخاطر واضحة ونقاط مراجعة محددة.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					"تحديد النشاط الصناعي والكود أو الوصف التشغيلي ومراجعة هل النشاط مناسب للموقع والمنطقة.",
					"مراجعة سند الحيازة والسجل التجاري والبطاقة الضريبية وبيانات الشركة قبل فتح الملف الفني.",
					"معاينة المصنع أو مراجعة الرسومات المتاحة لتحديد المساحة، الفراغات، المخارج، المعدات، التخزين، والمرافق.",
					"تجهيز الملف الفني والبيئي وتقرير الحريق وشهادة صلاحية المبنى للإشغال حسب حالة المنشأة.",
					"مراجعة التوافق بين الواقع والملف: النشاط، المساحة، الماكينات، الأحمال، أماكن التخزين، ونقاط الخطورة.",
					"تقديم الطلب عبر الجهة أو المنصة أو مكتب الاعتماد حسب المسار المناسب للحالة.",
					"متابعة الملاحظات والاستيفاءات وتعديل المستندات الفنية إن ظهرت ملاحظات من الجهة المختصة.",
					"استلام الرخصة أو تحديد الإجراء اللاحق مثل المتابعة السنوية أو التعديل الفني أو الإداري عند تغير النشاط أو البيانات."
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="factory-engineering"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="الفحص الهندسي قبل تقديم ملف المصنع"
			pDesc="أغلب التأخير لا يأتي من نقص صورة بطاقة، بل من تعارض هندسي أو تشغيلي يظهر عند مراجعة المبنى أو الحريق أو البيئة أو خطوط الإنتاج."
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1200px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pGrTitle={Text.H3.Centered.OfText("محاور المراجعة الهندسية")}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pStackDir="Row"
				pSpacing={20}
				pTopic1={new Topic("صلاحية المبنى", "مراجعة أن المبنى يصلح للإشغال الصناعي من حيث الحالة العامة، الاستخدام، المساحات، المداخل، المخارج، وملاءمة الفراغات للنشاط.")}
				pTopic2={new Topic("مخاطر الحريق", "تحديد مصادر الاشتعال والتخزين والتهوية ومخارج الهروب وشبكات الإطفاء أو معدات المكافحة المطلوبة حسب حجم ونوع النشاط.")}
				pTopic3={new Topic("الأثر البيئي", "فهم المدخلات والمخرجات: خامات، مخلفات، عوادم، صرف، ضوضاء، تهوية، وطرق السيطرة قبل تجهيز العرض أو التقييم البيئي.")}
				pTopic4={new Topic("تشغيل المعدات", "مراجعة توزيع الماكينات ومسارات الحركة والأحمال الكهربائية والميكانيكية وربطها بالرسم والملف الفني حتى لا يظهر تضارب أثناء الفحص.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="factory-service"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle Gray2 pTitle="خدمة استخراج ترخيص مصنع" />

		<EmoStr pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(24, 16)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("بنود الخدمة")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"فحص مبدئي للنشاط والموقع والمستندات المتاحة.",
						"تحديد مسار الترخيص المناسب للحالة.",
						"مراجعة الرسومات أو المعاينة اللازمة لتجهيز الملف الفني.",
						"تنسيق شهادة صلاحية المبنى وتقرير الحريق عند الحاجة.",
						"تجهيز قائمة الاستيفاءات قبل التقديم لتقليل رفض الملف.",
						"متابعة الطلب والرد على الملاحظات الفنية والإدارية."
					]}
				/>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("الخدمة لا تشمل")}
					pHeadBg={new ElemBg(Colors.OrangeLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={false}
					pItems={[
						"الرسوم الحكومية أو مصروفات الجهات الرسمية.",
						"أي إنشاءات أو تعديلات مطلوبة بالموقع لاستيفاء الحريق أو البيئة.",
						"أتعاب مكاتب اعتماد أو معامل أو جهات قياس خارجية عند طلبها.",
						"موافقات خاصة لا تخص نطاق العمل إلا إذا تم الاتفاق عليها صراحة."
					]}
				/>

			</HzStack>

			<EmoCall BlackSky pText="ابدأ مراجعة ملف المصنع" />

		</EmoStr>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن ترخيص مصنع داخل أي مكان؟"
			pAnswer="لا. يجب أن يكون النشاط الصناعي مناسبًا للموقع أو المنطقة، وأن يكون سند الحيازة وبيانات النشاط والمبنى قابلة للقبول لدى الجهة المختصة."
		/>

		<FaqItem
			pQuestion="هل السجل التجاري يكفي لاستخراج رخصة تشغيل؟"
			pAnswer="السجل التجاري جزء من الملف، لكنه لا يغني عن سند الحيازة والملف الفني والبيئي وتقرير الحريق وشهادة صلاحية المبنى عند طلبها."
		/>

		<FaqItem
			pQuestion="متى أحتاج شهادة صلاحية مبنى للإشغال؟"
			pAnswer="تظهر الحاجة إليها عندما تطلب الجهة المختصة إثبات صلاحية المبنى لممارسة النشاط، ويجب أن تكون من استشاري معتمد وتصف الحالة الفعلية للمنشأة."
		/>

		<FaqItem
			pQuestion="هل يمكن متابعة مصنع قائم بدون رسومات؟"
			pAnswer="يمكن البدء بمعاينة ورفع بيانات المكان، ثم تحديد الرسومات أو الملفات الفنية المطلوبة قبل التقديم أو استكمال الاستيفاءات."
		/>

	</EmoFaq>







