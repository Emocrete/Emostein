---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { SplitPane, SplitScene, StoryRail, StoryStep } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مصنع مواد بناء"
	pDescr="ترخيص مصنع مواد بناء — إدارة وتجهيز الجزء الهندسي من ملف المنشأة الصناعية بما يربط النشاط ومساحة المصنع والمباني والقوى والخدمات بالمتطلبات التنظيمية ذات الصلة. وفي هذه الصفحة يكون التركيز الخاص على تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="ترخيص مصنع مواد بناء">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("ترخيص مصنع مواد بناء")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("إدارة وتجهيز الجزء الهندسي من ملف المنشأة الصناعية بما يربط النشاط ومساحة المصنع والمباني والقوى والخدمات بالمتطلبات التنظيمية ذات الصلة. وفي هذه الصفحة يكون التركيز الخاص على تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<StoryRail pBg={Colors.Black} pTrackColor={Colors.Gray4} pAccent={Colors.Bistage} pGap={new RespString("24px","14px")} pPad={new RespString("44px","12px")}>
		<StoryStep pNumber="01" pKicker="البداية" pTitle="تدقيق بيانات المنشأة" pText="مراجعة النشاط والمنتجات والقوى والمساحات مع مراعاة تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات." pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<StoryStep pNumber="02" pKicker="المعالجة" pTitle="حصر التعديلات المطلوبة" pText="مراجعة الرسومات والموقف التنفيذي والمستندات." pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<StoryStep pNumber="03" pKicker="المخرج" pTitle="تجهيز ومتابعة الملف" pText="تجهيز ملف الإجراء والتنسيق مع الأطراف المطلوبة." pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
	</StoryRail>

	<SplitScene id="secSrvCost" pBg={Colors.Gray1} pColumns={new RespString("5fr 7fr","1fr")} pGap={new RespString("12px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("القيمة العملية")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("يمنع فصل الترخيص عن الواقع التشغيلي للمصنع، ويكشف مبكرًا التعديلات الفنية التي قد تؤثر في الرسومات أو السجل أو رخصة التشغيل. ويُراجع القرار هنا تحديدًا في ضوء تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات.")} />
		</SplitPane>
		<SplitPane pBg={Colors.WhiteOff} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("السعر المبدئي")} pText={Text.Body.WithColor(Colors.Black).OfText("يبدأ من 15,000 ج.م للمهمة البسيطة؛ الجهات والاختبارات والرسوم الرسمية تسعر منفصلة.")} />
		</SplitPane>
	</SplitScene>

</BLayout>
