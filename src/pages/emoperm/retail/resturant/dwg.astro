---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { Badge, EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoSec, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمطعم"
	pDescr="خدمة إعداد الرسم الهندسي المطلوب لترخيص مطعم، شامل المسقط الأفقي والقطاع الرأسي والواجهة وكروكي الموقع العام، مع توضيح توزيع مناطق التحضير والغسيل والخدمة والتهوية والمدخنة ومسارات الحركة داخل المطعم."
>







	<Hero pImgAlt="أواني مطعم تيفال سوداء فاخرة موضوعة على كوانتر كوريان أسود مط في مطعم تم عمل الرسم الهندسي له للترخيص">

		<VrStack pSize={new Size(new NumPer("55%","95%"))} pLoc={new Loc(new NumPer("0%","2.5%"),new NumPer("30%","70%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.White.OfText("رسم هندسي لمطعم")} pText={Text.Body.Centered.White.OfText("إعداد الرسم الهندسي المطلوب لترخيص مطعم")} />

			<HzStack pGap={new Pixel(30,10)} pForceHz>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

			<Badge
				pLandOnly
				pScopeText="القاهرة والجيزة"
				pYears={6}
				pWorks={40}
				pDuration={24}
				pDurationText="خلال يوم واحد"
				pColor="white"
			/>

		</VrStack>

	</Hero>







	<EmoSec pPortOnly pBg={new ElemBg(Colors.Gray5)}>

		<Badge
			pPortOnly
			pScopeText="القاهرة والجيزة"
			pYears={6}
			pWorks={40}
			pDuration={24}
			pDurationText="خلال يوم واحد"
			pTextPos="Left"
		/>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle Gray2 pTitle="مميزات الخدمة" />

		<EmoStr pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1240px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("01", "عدد 3 نسخ من الرسم الهندسي للمطعم مختومة بختم مهندس نقابي")}
				pTopic2={new Topic("02", "تسليم الرسم الهندسي في اليوم التالي للمعاينة")}
				pTopic3={new Topic("03", "دقة تطابق الواقع")}
				pTopic4={new Topic("04", "التسليم في موقعك مجانا داخل القاهرة والجيزة")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle GreenLite pTitle="قيمة الخدمة" />

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<VrStack pWidth={new Pixel(820, 340)} pGap={new Pixel(20, 14)}>

				<CardsGr
					pWidth={new RespString("820px", "100%")}
					pCardBg={new ElemBg(Colors.Gray1)}
					pCardTitleFnt={Text.H3.Centered}
					pCardBodyFnt={Text.Body.Centered}
					pTopic1={new Topic("2500 جنيه", "قيمة خدمة إعداد الرسم الهندسي لترخيص مطعم")}
					pTopic2={new Topic("طريقة السداد", "مقدم أتعاب 1000 جنيه والباقي عند الاستلام")}
				/>

				<HzStack pGap={new Pixel(30,10)} pForceHz>

					<EmoCallIcon BlackSky />

					<EmoWhatsIcon BlackSky />

				</HzStack>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="مواصفات الرسم الهندسي لترخيص مطعم"
			pDesc="يجب أن يتضمن الرسم الهندسي للمطعم عدة عناصر رئيسية لتوصيف المكان وتوضيح مدى ملاءمته للمواصفات المطلوبة للنشاط الغذائي"
		/>

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("مكونات اللوحة المطلوبة")}
				pDesc={Text.Body.Centered.OfText("كل عنصر في الرسم يخدم نقطة مراجعة مختلفة عند فحص ملف الترخيص أو عند مطابقة المطعم على الطبيعة")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					{ Title: "مسقط أفقي", Items: ["موضح به المساحة الكلية والأبعاد الخارجية والداخلية وطريقة توزيع الفراغات الداخلية وأماكن الأعمدة وأبعاد المداخل والمنافذ ومناطق التشغيل الأساسية داخل المطعم."] },
					{ Title: "قطاع رأسي", Items: ["موضح به ارتفاع الأرضية بالنسبة للطريق وعدد مستويات الأرضية الداخلية وارتفاعات السقف عند كل مستوى، مع بيان ما يؤثر على التهوية ومسار المدخنة إن وجد."] },
					{ Title: "واجهة المطعم", Items: ["موضح بها مدخل المطعم واللافتة النهائية بالاسم التجاري المعتمد لصاحب الترخيص، بالإضافة لموقع المطعم بالنسبة لمدخل العقار وترتيبه بالنسبة للمحلات المجاورة بنفس العقار."] },
					{ Title: "كروكي الموقع العام", Items: ["خريطة مبسطة تبين الموقع العام للمطعم وعلاقته بالمباني المجاورة والطرق المحيطة، بما يساعد على مطابقة العنوان وموقع النشاط."] }
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="نماذج رسم هندسي لمطعم"
			pDesc="نماذج رسومات توضح طريقة عرض المسقط والواجهة والقطاع وكروكي الموقع ضمن ملف ترخيص المطعم"
		/>

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<VrStack pWidth={new Pixel(1120, 340)} pGap={new Pixel(18, 14)} pPad={new Pixel(0, 0)}>

				<HzStack pGap={new Pixel(18, 14)} pPad={new Pixel(0, 0)}>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_76ac6416a15e443f910aabecd06451b3~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_76ac6416a15e443f910aabecd06451b3~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_af2f73fa44bc4bbc992930c79a91a632~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_af2f73fa44bc4bbc992930c79a91a632~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

				</HzStack>

				<RespImg
					pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_1cac27102827417dae8d180632d80e89~mv2.jpg/v1/fill/w_250%2Ch_353%2Cal_c%2Cq_90%2Cenc_auto/308dfd_1cac27102827417dae8d180632d80e89~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<RelServices>

		<RelServiceItem
			pTitle="استخراج ترخيص مطعم"
			pDesc="متابعة إجراءات استخراج ترخيص مطعم، مع مراجعة المستندات وتجهيز الملف والتنسيق مع الجهة المختصة حسب نطاق الخدمة المتاح."
			pHref="/emoperm/retail/resturant"
		/>

		<RelServiceItem
			pTitle="تقرير هندسي لمدخنة مطعم"
			pDesc="تقرير فني عن سلامة المدخنة ومطابقتها الفنية في الحالات التي تعتمد على تصريف الأبخرة ونواتج الطهي."
			pHref="/emonsult/report/chimney"
		/>

		<RelServiceItem
			pTitle="تشطيب وتجهيز مطعم"
			pDesc="تصميم وتنفيذ تشطيبات وفرش المطاعم بما يناسب طبيعة التشغيل والميزانية والتجهيزات المطلوبة للنشاط."
			pHref="/emocrete/finishing/retail"
		/>

	</RelServices>







</BLayout>
