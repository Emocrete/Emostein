---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { Badge, EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمطعم"
	pDescr="خدمة إعداد الرسم الهندسي المطلوب لترخيص مطعم، شامل المسقط الأفقي والقطاع الرأسي والواجهة وكروكي الموقع العام، مع توضيح توزيع مناطق التحضير والغسيل والخدمة والتهوية والمدخنة ومسارات الحركة داخل المطعم."
>







	<Hero pImgAlt="أواني مطعم تيفال سوداء فاخرة موضوعة على كوانتر كوريان أسود مط في مطعم تم عمل الرسم الهندسي له للترخيص">

		<VrStack
			pHzAlign="Center"
			pVrAlign="Center"
			pSize={new Size(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","70%"))}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("رسم هندسي لمطعم")}
				pText={Text.Body.Centered.White.OfText("إعداد الرسم الهندسي المطلوب لترخيص مطعم بصورة واضحة ومطابقة لحالة المكان ومتطلبات النشاط الغذائي")}
			/>

			<EmoCall
				data-own-size
				BlackOrange
				pText="للطلب والاستفسار"
			/>

		</VrStack>

		<VrStack
			pLandOnly
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("65%","60%"))}
			pSize={new Size(new NumPer("60%","95%"))}
			data-own-size
		>

			<Badge
				pYears={6}
				pWorks={120}
				pDuration={24}
				pDurationText="خلال يوم واحد"
				pColor="white"
			/>

		</VrStack>

	</Hero>







	<EmoSec
		id="ServiceIntro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="خدمات الرسم الهندسي لترخيص المطاعم"
			pDesc="خدمة احترافية لإعداد الرسم الهندسي المطلوب لترخيص مطعم، مع قراءة هندسية لطبيعة النشاط وليس مجرد رفع أبعاد لمحل فارغ"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(28, 16)} pPad={new Pixel(0, 0)}>

				<RespImg
					pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_e957e3279fa64915a6062abbb52ab324~mv2.webp/v1/fill/w_980%2Ch_408%2Cal_c%2Cq_85%2Cusm_0.66_1.00_0.01%2Cenc_auto/308dfd_e957e3279fa64915a6062abbb52ab324~mv2.webp", false, "رسم هندسي لمطعم", new Size(new NumPer(430, 300), new NumPer("auto", "auto")))}
				/>

				<VrStack
					pWidth={new Pixel(720, 340)}
					pPad={new Pixel(0, 0)}
					pGap={new Pixel(20, 14)}
				>

					<CardsGr
						pWidth={new RespString("720px", "100%")}
						pCardBg={new ElemBg(Colors.Gray1)}
						pCardTitleFnt={Text.H3.Centered}
						pCardBodyFnt={Text.Body.Centered}
						pTopic1={new Topic("80+", "عملاؤنا السابقون في تراخيص المحلات والأنشطة التجارية")}
						pTopic2={new Topic("خبرة", "5 سنوات في ملفات التراخيص والرسومات الهندسية")}
					/>

					<Emograph
						pTitle={Text.H3.OfText("الرسم الهندسي للمطعم يختلف عن رسم المحل العادي")}
						pText={Text.Body.OfText("المطعم ليس مساحة بيع فقط، بل نشاط غذائي له مناطق تشغيل وتحضير وغسيل وخدمة وتهوية وصرف وحركة عاملين وعملاء. لذلك يجب أن يوضح الرسم الهندسي عناصر المطعم التي ستراجعها الجهة المختصة عند فحص الملف أو أثناء المعاينة.")}
						pSize={new Size(new NumPer(720, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="مميزات الخدمة"
			pDesc="الرسم المطلوب لترخيص مطعم يجب أن يكون واضحًا ومقروءًا ومطابقًا لحالة المكان الفعلية ومتطلبات النشاط الغذائي"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<CardsGr
				pWidth={new RespString("1240px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("01", "عدد 3 نسخ من الرسم الهندسي للمطعم مختومة بختم مهندس نقابي")}
				pTopic2={new Topic("02", "تسليم الرسم الهندسي في اليوم التالي للمعاينة")}
				pTopic3={new Topic("03", "دقة تطابق الرسم مع واقع المطعم ومناطق التشغيل")}
				pTopic4={new Topic("04", "التسليم في موقعك مجانا داخل نطاق الخدمة المتاح")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="قيمة الخدمة"
			pDesc="قيمة واضحة قبل بدء المعاينة حتى يعرف العميل تكلفة إعداد الرسم الهندسي المطلوبة ضمن ملف ترخيص المطعم"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack pWidth={new Pixel(820, 340)} pGap={new Pixel(20, 14)}>

				<CardsGr
					pWidth={new RespString("820px", "100%")}
					pCardBg={new ElemBg(Colors.Gray1)}
					pCardTitleFnt={Text.H3.Centered}
					pCardBodyFnt={Text.Body.Centered}
					pTopic1={new Topic("2000 جنيه", "قيمة خدمة إعداد الرسم الهندسي لترخيص مطعم")}
					pTopic2={new Topic("طريقة السداد", "مقدم أتعاب 1000 جنيه والباقي عند الاستلام")}
				/>

				<EmoCall BlackSky pText="اطلب الخدمة" />

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="مواصفات الرسم الهندسي لترخيص مطعم"
			pDesc="يجب أن يتضمن الرسم الهندسي للمطعم عدة عناصر رئيسية لتوصيف المكان وتوضيح مدى ملاءمته للمواصفات المطلوبة للنشاط الغذائي"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("مكونات اللوحة المطلوبة")}
				pDesc={Text.Body.Centered.OfText("كل عنصر في الرسم يخدم نقطة مراجعة مختلفة عند فحص ملف الترخيص أو عند مطابقة المطعم على الطبيعة")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					{ Title: "مسقط أفقي", Items: ["موضح به المساحة الكلية والأبعاد الخارجية والداخلية وطريقة توزيع الفراغات الداخلية وأماكن الأعمدة وأبعاد المداخل والمنافذ ومناطق التشغيل الأساسية داخل المطعم."] },
					{ Title: "قطاع رأسي", Items: ["موضح به ارتفاع الأرضية بالنسبة للطريق وعدد مستويات الأرضية الداخلية وارتفاعات السقف عند كل مستوى، مع بيان ما يؤثر على التهوية ومسار المدخنة إن وجد."] },
					{ Title: "واجهة المطعم", Items: ["موضح بها مدخل المطعم واللافتة النهائية بالاسم التجاري المعتمد لصاحب الترخيص، بالإضافة لموقع المطعم بالنسبة لمدخل العقار وترتيبه بالنسبة للمحلات المجاورة بنفس العقار."] },
					{ Title: "كروكي الموقع العام", Items: ["خريطة مبسطة تبين الموقع العام للمطعم وعلاقته بالمباني المجاورة والطرق المحيطة، بما يساعد على مطابقة العنوان وموقع النشاط."] }
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="نماذج رسم هندسي لمطعم"
			pDesc="نماذج رسومات توضح طريقة عرض المسقط والواجهة والقطاع وكروكي الموقع ضمن ملف ترخيص المطعم"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1120, 340)}
				pGap={new Pixel(18, 14)}
				pPad={new Pixel(0, 0)}
			>

				<HzStack pGap={new Pixel(18, 14)} pPad={new Pixel(0, 0)}>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_76ac6416a15e443f910aabecd06451b3~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_76ac6416a15e443f910aabecd06451b3~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_af2f73fa44bc4bbc992930c79a91a632~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_af2f73fa44bc4bbc992930c79a91a632~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

				</HzStack>

				<RespImg
					pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_1cac27102827417dae8d180632d80e89~mv2.jpg/v1/fill/w_250%2Ch_353%2Cal_c%2Cq_90%2Cenc_auto/308dfd_1cac27102827417dae8d180632d80e89~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="تفاصيل إضافية مهمة في رسم المطعم"
			pDesc="كلما كان النشاط الغذائي أكثر تعقيدًا، زادت أهمية توضيح مناطق التشغيل والتجهيزات داخل المسقط وليس الاكتفاء بحدود المكان"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<CardsGr
				pWidth={new RespString("1240px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("منطقة التحضير", "تحديد منطقة التحضير داخل المسقط يساعد على فهم حركة العاملين ومكان تجهيز الطعام قبل الطبخ أو التقديم.")}
				pTopic2={new Topic("منطقة الطهي", "إذا كان المطعم يحتوي على قلايات أو شوايات أو أفران، يجب أن يظهر موضع منطقة الطهي بما يساعد على قراءة التهوية ومسار المدخنة.")}
				pTopic3={new Topic("الغسيل والصرف", "توضيح مناطق الغسيل ومواقع الصرف يربط الرسم بمتطلبات النظافة والتشغيل ويقلل الغموض عند فحص الملف.")}
				pTopic4={new Topic("منطقة العملاء", "منطقة الجلوس أو الاستلام أو الكاشير تؤثر على مسارات الحركة والمداخل وعلاقة النشاط بالواجهة والشارع.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="الرسم الهندسي حسب نوع المطعم"
			pDesc="لا تتعامل كل المطاعم مع الرسم بنفس الطريقة؛ اختلاف نموذج التشغيل يغير العناصر التي يجب إبرازها داخل اللوحة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<CardsGr
				pWidth={new RespString("1240px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("مطعم خدمة كاملة", "يحتاج المسقط إلى إظهار صالة العملاء، المطبخ، منطقة التحضير، الغسيل، الكاشير، دورات المياه إن وجدت، ومسارات الحركة بين الخدمة والمطبخ.")}
				pTopic2={new Topic("مطعم تيك أواي", "يركز الرسم على منطقة التحضير والطهي والاستلام والكاشير وحركة العمال، لأن مساحة العملاء قد تكون محدودة أو غير موجودة.")}
				pTopic3={new Topic("مطعم شاورما أو مشويات", "تظهر أهمية مكان الشواية والهود ومسار المدخنة ومناطق التحضير والتخزين، لأن الأبخرة والحرارة والروائح تكون عناصر مؤثرة في المعاينة.")}
				pTopic4={new Topic("مطعم مخبوزات أو بيتزا", "يجب الانتباه إلى مكان الأفران ومسارات الحرارة والتهوية ومناطق العجن والتحضير والتخزين، لأن المعدات الثابتة تؤثر على توزيع المسقط.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="التهوية والمدخنة داخل الرسم"
			pDesc="في المطاعم التي تعتمد على طهي فعلي، قد يكون مسار التهوية والمدخنة أهم من شكل المسقط نفسه عند مراجعة الملف"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(28, 16)} pPad={new Pixel(0, 0)}>

				<RespImg
					pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg", false, "مسار التهوية في رسم مطعم", new Size(new NumPer(430, 300), new NumPer("auto", "auto")))}
				/>

				<VrStack
					pWidth={new Pixel(700, 340)}
					pPad={new Pixel(0, 0)}
					pGap={new Pixel(18, 12)}
				>

					<Emograph
						pTitle={Text.H3.OfText("اللوحة يجب أن تساعد على فهم مصدر الأبخرة")}
						pText={Text.Body.OfText("عندما يحتوي المطعم على منطقة طهي أو قلي أو شواية، لا يكفي أن يذكر الرسم كلمة مطبخ فقط. الأفضل أن يكون موضع منطقة الطهي واضحًا، وأن تظهر علاقة هذه المنطقة بالتهوية أو المدخنة أو فتحة العادم المطلوبة، خصوصًا إذا كان مسار العادم يمر داخل منور أو واجهة أو سطح.")}
						pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H3.OfText("الرسم لا يغني عن تقرير المدخنة عند طلبه")}
						pText={Text.Body.OfText("الرسم الهندسي يوضح الموضع والعلاقة العامة، لكنه لا يكون بديلًا عن تقرير فني متخصص إذا طلبت الجهة المختصة تقرير مدخنة أو تقرير سلامة لمسار العادم أو ملاحظات متعلقة بالروائح أو الأبخرة أو تأثيرها على العقار والمجاورين.")}
						pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Sky};`}
			pTitle="ما الذي يتم رفعه أثناء معاينة المطعم؟"
			pDesc="المعاينة الهندسية قبل الرسم هي التي تحدد دقة اللوحة، لأن الرسم النهائي يجب أن يعبر عن المطعم كما هو لا كما يفترض أن يكون"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("بيانات الرفع الأساسية")}
				pDesc={Text.Body.Centered.OfText("كل بند من هذه البنود يظهر أثره داخل المسقط أو القطاع أو الواجهة أو كروكي الموقع")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pNumbered={true}
				pItems={[
