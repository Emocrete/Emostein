---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مطعم"
	pDescr="خدمة استخراج ترخيص مطعم ومتابعة إجراءات الترخيص، مع توضيح المستندات المطلوبة وخطوات التقديم والمعاينة والرسومات الهندسية وبنود الخدمة وتكلفتها."
>







	<Hero
		pTitle="ترخيص مطعم"
		pDesc="استخراج ترخيص مطعم ومتابعة الملف أمام الجهة المختصة بداية من تجهيز المستندات وحتى استلام الرخصة"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="42% 8% 12% 8%"
		pPosP="45% 4% 10% 4%"
	>

		<EmoCall BlackSky pText="اطلب ترخيص مطعم" />

	</Hero>







	<EmoSec
		id="Intro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="استخراج ترخيص مطعم"
			pDesc="خدمة احترافية للسير في إجراءات استخراج ترخيص مطعم"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(28, 16)} pPad={new Pixel(0, 0)}>

				<RespImg
					pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_e957e3279fa64915a6062abbb52ab324~mv2.webp/v1/fill/w_980%2Ch_408%2Cal_c%2Cq_85%2Cusm_0.66_1.00_0.01%2Cenc_auto/308dfd_e957e3279fa64915a6062abbb52ab324~mv2.webp", false, "ترخيص مطعم", new Size(new NumPer(480, 320), new NumPer("auto", "auto")))}
				/>

				<VrStack
					pWidth={new Pixel(700, 340)}
					pGap={new Pixel(20, 14)}
					pPad={new Pixel(0, 0)}
				>

					<Emograph
						pTitle={Text.H3.OfText("المطعم ليس محلًا تجاريًا عاديًا")}
						pText={Text.Body.OfText("ترخيص المطعم يجمع بين ملف المحل العام واشتراطات النشاط الغذائي؛ لذلك لا يكفي تجهيز عقد الإيجار وبطاقة صاحب الطلب فقط، بل يجب النظر إلى العاملين، الشهادات الصحية، الحالة الجنائية، الرسم الهندسي، التهوية، السلامة، وتجهيزات التشغيل التي ستظهر عند المعاينة.")}
						pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
					/>

					<CardsGr
						pWidth={new RespString("700px", "100%")}
						pCardBg={new ElemBg(Colors.Gray1)}
						pCardTitleFnt={Text.H4.Centered}
						pCardBodyFnt={Text.Body.Centered}
						pTopic1={new Topic("ملف إداري", "طلب الترخيص والمستندات وبيانات صاحب النشاط وسند شغل العين")}
						pTopic2={new Topic("ملف فني", "الرسم الهندسي والمعاينة والاشتراطات التي تثبت صلاحية المكان للنشاط")}
						pTopic3={new Topic("ملف تشغيل", "الشهادات الصحية والتأمينات والعمالة والتجهيزات المؤثرة على تشغيل المطعم")}
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="Documents"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="الاوراق المطلوبة لاستخراج رخصة مطعم"
			pDesc="الأوراق الأساسية التي يبدأ بها ملف الترخيص قبل مراجعة الاشتراطات الخاصة بالنشاط الغذائي والمعاينة"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("مستندات فتح مطعم")}
				pDesc={Text.Body.Centered.OfText("يتم تجهيز الصور مع الأصول للاطلاع، ثم تراجع الجهة المختصة مدى كفاية الملف حسب حالة المطعم والنشاط")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					"صورة عقد الملكية أو عقد إيجار المحل مع توفير أصل العقد للإطلاع",
					"صورة بطاقة الرقم القومي لصاحب الترخيص",
					"عدد 3 نسخ من الرسومات الهندسية للمحل حسب المواصفات المعتمدة",
					"خطاب التأمين الصادر عن التأمينات الاجتماعية",
					"شهادة بالقيمة الإيجارية للمحل من الضرائب العقارية",
					"شهادة صحية للعاملين في المحل مستخرج من مستشفى حكومي",
					"صحيفة الحالة الجنائية"
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="مستندات يجب مراجعتها قبل التقديم"
			pDesc="قد تختلف تفاصيل الملف حسب الحي أو الجهاز أو طبيعة النشاط، لذلك يجب مراجعة هذه النقاط قبل بدء إجراءات الترخيص"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<CardsGr
				pWidth={new RespString("1220px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("السجل التجاري والبطاقة الضريبية", "وجود نشاط غذائي أو مطعم في بيانات النشاط التجاري والضريبي يقلل تعارض البيانات عند مراجعة الملف.")}
				pTopic2={new Topic("الشهادات الصحية للعاملين", "المطاعم من الأنشطة التي تتعامل مع الأغذية والمشروبات، لذلك يجب مراجعة شهادات العاملين قبل المعاينة وليس بعدها.")}
				pTopic3={new Topic("الحالة الجنائية", "صحيفة الحالة الجنائية تظهر في ملفات المحال العامة، ويجب تجهيزها بالصيغة والحداثة التي تقبلها الجهة المختصة.")}
				pTopic4={new Topic("موافقات النشاط", "قد يطلب الملف موافقات أو مراجعات مرتبطة بالحماية المدنية أو البيئة أو الصرف أو التنظيم حسب حالة المطعم وموقعه وتجهيزاته.")}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="Procedures"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="اجراءات ترخيص مطعم"
			pDesc="يمر طلب الترخيص من تقديم الملف إلى القبول المبدئي ثم الاشتراطات والمعاينة وسداد الرسوم واستلام الترخيص"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("خطوات الترخيص")}
				pDesc={Text.Body.Centered.OfText("ترتيب الخطوات يساعد صاحب المطعم على معرفة المرحلة التي يتوقف عندها الملف وسبب طلب الاستيفاء إن ظهر")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					"تقديم طلب ترخيص محل تجاري مرفق به المستندات المطلوبة",
					"يتم الرد خلال 60 يوم بالقبول المبدئي أو بالرفض المسبب ، وفي حال عدم الرد خلال المدة المحددة يعتبر الطلب مقبولاً",
					"استلام إخطار قبول طلب ترخيص المحل التجاري الموضح به الاشتراطات العامة والخاصة للنشاط المراد الترخيص به",
					"إرسال إخطار استيفاء الاشتراطات المطلوبة للترخيص بخطاب مسجل بعلم الوصول إلى إدارة تراخيص المحلات التجارية التابع لها المحل",
					"تقديم طلب معاينة المحل التجاري في حال تحقق الاشتراطات ودفع الرسوم المقررة للمعاينة",
					"استلام إخطار الرد من إدارة التراخيص بعد إجراء المعاينة للمحل التجاري بالموافقة على الترخيص أو بتوضيح الاشتراطات التي لم يتم استيفاؤها",
					"استلام اخطار الموافقة على اصدار ترخيص المحل التجاري بعد إتمام استيفاء الاشتراطات كاملة",
					"سداد الرسوم المحددة لاستخراج ترخيص المحل التجاري واستلام الترخيص"
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="مرحلة المعاينة في ترخيص المطعم"
			pDesc="المعاينة هي المرحلة التي تربط بين الورق والواقع، وفي المطاعم تكون أكثر حساسية بسبب المطبخ والتهوية والحريق والصرف والتشغيل"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(28, 16)} pPad={new Pixel(0, 0)}>

				<VrStack
					pWidth={new Pixel(680, 340)}
					pGap={new Pixel(18, 12)}
					pPad={new Pixel(0, 0)}
				>

					<Emograph
						pTitle={Text.H3.OfText("ما الذي تنظر إليه الجهة عند المعاينة؟")}
						pText={Text.Body.OfText("لا تنظر المعاينة إلى اسم النشاط فقط، بل إلى قابلية المكان لتشغيل مطعم فعليًا: مساحة التحضير، منطقة الخدمة، المداخل، التهوية، المدخنة عند الحاجة، وسائل الحماية من الحريق، الصرف، الكهرباء، نظافة مناطق تداول الغذاء، ومطابقة الرسم الهندسي للحالة القائمة.")}
						pSize={new Size(new NumPer(680, "100%"), new NumPer("auto", "auto"))}
					/>

					<Emograph
						pTitle={Text.H3.OfText("لماذا يتعطل ملف مطعم رغم اكتمال الورق؟")}
						pText={Text.Body.OfText("قد يكون الملف الورقي مكتملًا، لكن المطعم نفسه غير مستوفٍ فنيًا. أكثر ما يسبب التعطيل هو اختلاف الرسم عن الواقع، ضعف التهوية، غموض مسار المدخنة، عدم وضوح الصرف، أو تنفيذ تشطيب لا يراعي اشتراطات النشاط قبل طلب المعاينة.")}
						pSize={new Size(new NumPer(680, "100%"), new NumPer("auto", "auto"))}
					/>

				</VrStack>

				<RespImg
					pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_e957e3279fa64915a6062abbb52ab324~mv2.webp/v1/fill/w_980%2Ch_408%2Cal_c%2Cq_85%2Cusm_0.66_1.00_0.01%2Cenc_auto/308dfd_e957e3279fa64915a6062abbb52ab324~mv2.webp", false, "مطعم وتجهيزات تشغيل", new Size(new NumPer(460, 320), new NumPer("auto", "auto")))}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="Drawing"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="الرسم الهندسي لـترخيص مطعم"
			pDesc="يجب أن يتضمن الرسم الهندسي للمحل التجاري عدة عناصر رئيسية لتوصيف المحل وتوضيح مدى ملاءمته للمواصفات المطلوبة للنشاط الذي سيتم له ترخيص المحل التجاري."
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("شروط الرسم الهندسي لـترخيص مطعم")}
				pDesc={Text.Body.Centered.OfText("الرسم الهندسي يجب أن يصف المطعم كما سيتم تشغيله، لا كمساحة فارغة فقط")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={false}
				pItems={[
					"مسقط أفقي موضح به المساحة الكلية والأبعاد الخارجية والداخلية وطريقة توزيع الفراغات الداخلية وأماكن الأعمدة وأبعاد المداخل والمنافذ.",
					"قطاع رأسي موضح به ارتفاع الأرضية بالنسبة للطريق وعدد مستويات الأرضية الداخلية وارتفاعات السقف عند كل مستوى.",
					"واجهة موضح بها مدخل المطعم واللافتة النهائية بالاسم التجاري المعتمد لصاحب الترخيص بالإضافة لموقع المحل بالنسبة لمدخل العقار وترتيبه بالنسبة للمحلات المجاورة بنفس العقار.",
					"كروكي للموقع العام للمطعم ."
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="نماذج رسم هندسي لمطعم"
			pDesc="نماذج رسومات توضح طريقة عرض المسقط والواجهة والقطاع وكروكي الموقع ضمن ملف ترخيص المطعم"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1120, 340)}
				pGap={new Pixel(18, 14)}
				pPad={new Pixel(0, 0)}
			>

				<HzStack pGap={new Pixel(18, 14)} pPad={new Pixel(0, 0)}>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_d8e96ad2e5cf407f8774a05ffb1ed8a7~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_76ac6416a15e443f910aabecd06451b3~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_76ac6416a15e443f910aabecd06451b3~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

					<RespImg
						pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_af2f73fa44bc4bbc992930c79a91a632~mv2.jpg/v1/fill/w_250%2Ch_176%2Cal_c%2Cq_90%2Cenc_auto/308dfd_af2f73fa44bc4bbc992930c79a91a632~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
					/>

				</HzStack>

				<RespImg
					pImg={new EmoMediaData("Img", "https://static.wixstatic.com/media/", "308dfd_1cac27102827417dae8d180632d80e89~mv2.jpg/v1/fill/w_250%2Ch_353%2Cal_c%2Cq_90%2Cenc_auto/308dfd_1cac27102827417dae8d180632d80e89~mv2.jpg", false, "رسم هندسي لترخيص مطعم", new Size(new NumPer(350, 300), new NumPer("auto", "auto")))}
				/>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="ServiceScope"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.BistageDark};`}
			pTitle="خدمة متابعة إجراءات استخراج ترخيص مطعم"
			pDesc="نطاق الخدمة محدد من البداية حتى يعرف صاحب المطعم ما يدخل ضمن المتابعة وما يخرج عنها"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Creamy)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<VrStack
				pWidth={new Pixel(1100, 340)}
				pGap={new Pixel(22, 14)}
				pPad={new Pixel(0, 0)}
			>

				<CardsGr
					pWidth={new RespString("900px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pCardTitleFnt={Text.H3.Centered}
					pCardBodyFnt={Text.Body.Centered}
					pTopic1={new Topic("7000 جنيه", "قيمة خدمة متابعة إجراءات استخراج ترخيص مطعم")}
					pTopic2={new Topic("القاهرة والجيزة", "نطاق الخدمة الميدانية والمتابعة العملية")}
				/>

				<CardsGr
					pWidth={new RespString("1100px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("تقديم الملف", "تقديم ملف ترخيص المطعم إلى الحي أو الجهاز التابع له المحل إداريا .")}
					pTopic2={new Topic("متابعة الموافقات", "متابعة استخراج الموافقات التي تطلب للحصول على ترخيص مزاولة النشاط التجاري .")}
					pTopic3={new Topic("تنسيق المعاينة", "التنسيق مع مهندس الحي بخصوص معاينة المحل للتحقق من توافر شروط النشاط به .")}
					pTopic4={new Topic("استلام الترخيص", "مراجعة الحي أو الجهاز التابع له المحل إداريا لاستلام ترخيص المحل .")}
				/>

				<EmoCall BlackSky pText="اطلب الخدمة" />

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
