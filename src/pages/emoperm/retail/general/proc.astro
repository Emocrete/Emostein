---
import { Align, Angle, Colors, ElemBg, EmoMediaData, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, VrStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Article"
	pTitle="إجراءات ترخيص محل تجاري"
	pDescr="خطوات وإجراءات استخراج ترخيص محل تجاري في مصر، بداية من تقديم الطلب والمستندات وحتى القبول المبدئي والمعاينة واستيفاء الاشتراطات وسداد الرسوم واستلام الترخيص."
>







	<Hero>

		<VrStack
			pBlur={new Pixel(10)}
			pBgOpacity={new Percent(50)}
			pBgColor={new ElemBg(Colors.BlackOff)}
			pLoc={new Loc(new NumPer("10%","5%"),new NumPer("40%","20%"))}
			pSize={new Size(new NumPer("40%","90%"))}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph pTitle={Text.H1.White.Centered.OfText("إجراءات ترخيص محل تجاري")} />

			<EmoCall
				data-own-size
				BlackSky
				pText="تواصل معنا"
			/>

		</VrStack>

	</Hero>







	<ESec id="secProc">

		<EmoStrip pBg={new ElemBg(Colors.GreenLite)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<Emograph
				pTitle={Text.H2.Centered.OfText("اجراءات ترخيص محل تجاري أو صناعي أو محل عام")}
				pText={Text.Body.Centered.OfText("الترتيب العملي يبدأ بتقديم الطلب وينتهي بسداد الرسوم المحددة واستلام الترخيص")}
			/>

		</EmoStrip>

		<EmoStrip>

			<EmoList
				pWidth={new RespString("1200px", "100%")}
				pTitle={Text.H3.Centered.OfText("خطوات استخراج ترخيص محل تجاري")}
				pDesc={Text.Body.Centered.OfText("الترتيب العملي يبدأ بتقديم الطلب وينتهي بسداد الرسوم المحددة واستلام الترخيص")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pNumbered={true}
				pItems={[
					"تقديم طلب ترخيص محل تجاري مرفق به المستندات المطلوبة",
					"يتم الرد خلال 60 يوم بالقبول المبدئي أو بالرفض المسبب ، وفي حال عدم الرد خلال المدة المحددة يعتبر الطلب مقبولاً",
					"استلام إخطار قبول طلب ترخيص المحل التجاري الموضح به الاشتراطات العامة والخاصة للنشاط المراد الترخيص به",
					"إرسال إخطار استيفاء الاشتراطات المطلوبة للترخيص بخطاب مسجل بعلم الوصول إلى إدارة تراخيص المحلات التجارية التابع لها المحل",
					"تقديم طلب معاينة المحل التجاري في حال تحقق الاشتراطات ودفع الرسوم المقررة للمعاينة",
					"استلام إخطار الرد من إدارة التراخيص بعد إجراء المعاينة للمحل التجاري بالموافقة على الترخيص أو بتوضيح الاشتراطات التي لم يتم استيفاؤها",
					"استلام اخطار الموافقة على اصدار ترخيص المحل التجاري بعد إتمام استيفاء الاشتراطات كاملة",
					"سداد الرسوم المحددة لاستخراج ترخيص المحل التجاري واستلام الترخيص"
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec>

		<EmoStrip pBg={new ElemBg(Colors.SkyLite)}>

			<Emograph
				pTitle={Text.H2.Centered.OfText("مرحلة تقديم الطلب وفحص المستندات")}
				pText={Text.Body.Centered.OfText("هذه المرحلة تحدد هل الملف قابل للدخول في مسار الترخيص أم سيعود لاستيفاء أوراق أساسية قبل أن يبدأ فعليًا")}
			/>

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1220px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("تحديد الجهة المختصة", "يتم التعامل عادة مع المركز المختص أو المركز التكنولوجي التابع للوحدة المحلية أو الحي الواقع في نطاقه المحل، وقد تختلف طريقة التقديم بين الحضور المباشر أو المسار الرقمي المتاح حسب الخدمة والمحافظة.")}
				pTopic2={new Topic("تجهيز نموذج الطلب", "لا يكفي وجود الأوراق منفصلة؛ يجب أن تكون بيانات الطلب متسقة مع عقد الإيجار أو الملكية، البطاقة الضريبية، السجل التجاري، الرسم الهندسي، وبيانات النشاط المطلوب ترخيصه.")}
				pTopic3={new Topic("فحص الملف", "تراجع الجهة المختصة المستندات والرسومات والبيانات، ثم تحدد هل الطلب قابل للقبول المبدئي أم يحتاج استيفاء أو رفض مسبب بسبب تعارض واضح في النشاط أو الموقع أو المستندات.")}
				pTopic4={new Topic("الرد خلال المدة القانونية", "مرحلة الرد ليست مرحلة إصدار الترخيص، لكنها تحدد موقف الطلب: قبول مبدئي مع اشتراطات، أو رفض مسبب، أو اعتبار الطلب مقبولًا عند عدم الرد خلال المدة المحددة وفق القواعد المنظمة.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec>

		<EmoStrip pBg={new ElemBg(Colors.Black)}>

			<Emograph
				pTitle={Text.H2.Centered.White.OfText("مرحلة الاشتراطات والمعاينة")}
				pText={Text.Body.Centered.White.OfText("بعد القبول المبدئي تبدأ المرحلة الفنية: هل المحل في حالته الفعلية يصلح للنشاط المطلوب أم يحتاج تعديلات قبل إصدار الرخصة؟")}
			/>

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("ماذا يحدث بعد القبول المبدئي؟")}
				pDesc={Text.Body.Centered.OfText("هذه الخطوات هي التي تحول الملف من طلب إداري إلى رخصة قابلة للإصدار")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={true}
				pItems={[
					{ Title: "استلام الاشتراطات", Items: ["تتضمن الاشتراطات العامة والخاصة المطلوبة للنشاط.", "قد تتعلق الاشتراطات بالحريق أو التهوية أو الكهرباء أو السلامة أو تداول الأغذية أو مواعيد التشغيل أو واجهة المحل."] },
					{ Title: "تنفيذ المطلوب داخل المحل", Items: ["أي تعديل مطلوب يجب أن ينفذ قبل طلب المعاينة أو إعادة المعاينة.", "المحل الذي يبدو جاهزًا تجاريًا قد لا يكون جاهزًا ترخيصيًا إذا كانت اشتراطات النشاط غير متحققة."] },
					{ Title: "طلب المعاينة وسداد رسمها", Items: ["المعاينة تراجع مطابقة المحل للاشتراطات والمستندات والرسومات.", "في حالة عدم الاستيفاء قد تطلب الجهة تعديلات جديدة قبل الموافقة النهائية."] },
					{ Title: "اعتماد الرخصة واستلامها", Items: ["بعد تحقق الاشتراطات يتم استكمال الرسوم المطلوبة.", "لا تعتبر الرخصة مكتملة من الناحية العملية إلا بعد سداد الرسوم واستلام الترخيص أو إثبات صدوره من الجهة المختصة."] }
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec>

		<EmoStrip pBg={new ElemBg(Colors.OrangeLite)}>

			<Emograph pTitle={Text.H2.Centered.OfText("الفرق بين الترخيص والإخطار")} />

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1200px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("طلب الترخيص", "هو بداية المسار، وفيه يقدم صاحب الشأن أو وكيله البيانات والمستندات والرسومات المطلوبة حتى تراجع الجهة المختصة الملف وتحدد موقفه.")}
				pTopic2={new Topic("القبول المبدئي", "هو موافقة أولية على السير في الإجراءات، وليس سماحًا نهائيًا بتشغيل النشاط دون إتمام الاشتراطات وسداد الرسوم واستلام الترخيص.")}
				pTopic3={new Topic("استيفاء الاشتراطات", "هو تنفيذ ما طلبته الجهة المختصة بعد مراجعة الملف أو المعاينة، وقد يشمل تعديلات فنية أو مستندات ناقصة أو مراجعة بيانات النشاط.")}
				pTopic4={new Topic("إصدار الترخيص", "هو المرحلة النهائية التي تثبت أن المحل استوفى المطلوب وأن الجهة المختصة وافقت على تشغيل النشاط وفق البيانات والمساحة والنشاط المحدد في الرخصة.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec>

		<EmoStrip pBg={new ElemBg(Colors.Gray5)}>

			<Emograph pTitle={Text.H2.Centered.White.OfText("أين تتعطل إجراءات الترخيص غالبًا؟")} />

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(28, 16)} pPad={new Pixel(0, 0)}>

				<VrStack
					pWidth={new Pixel(680, 340)}
					pPad={new Pixel(0, 0)}
					pGap={new Pixel(18, 12)}
				>

					<CardsGr
						pWidth={new RespString("680px", "100%")}
						pCardBg={new ElemBg(Colors.WhiteOff)}
						pStackDir="Col"
						pCardTitleFnt={Text.H4}
						pCardBodyFnt={Text.Body}
						pTopic1={new Topic("اختلاف بيانات النشاط", "كتابة النشاط بصيغة في السجل التجاري وبصيغة مختلفة في الطلب أو العقد أو الرسم الهندسي قد يفتح باب طلب استيفاء جديد.")}
						pTopic2={new Topic("عدم مطابقة الرسم للواقع", "الرسم الهندسي يجب أن يصف الحالة الفعلية للمحل ومساحته ومدخله وفراغاته وعلاقته بالشارع.")}
						pTopic3={new Topic("تنفيذ التشطيب قبل فهم الاشتراطات", "أحيانًا يتم تشطيب المحل بالكامل ثم تظهر اشتراطات تهوية أو كهرباء أو حريق تحتاج تعديلًا مكلفًا، لذلك مراجعة الاشتراطات مبكرًا تحمي الميزانية.")}
						pTopic4={new Topic("التأخير في طلب إعادة المعاينة", "بعد تنفيذ المطلوب يجب إخطار الجهة المختصة وطلب المعاينة في الوقت المناسب، لأن عدم المتابعة يجعل الملف متوقفًا رغم تنفيذ الاشتراطات داخل المحل.")}
					/>

				</VrStack>

				<RespImg
					pImg={new EmoMediaData("Img", "https://images.akhbarelyom.com/UP/", "20221211102524498.jpg", false, "نموذج طلب استصدار رخصة محل", new Size(new NumPer(420, 300), new NumPer("auto", "auto")))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec>

		<EmoStrip pBg={new ElemBg(Colors.BistageDark)}>

			<Emograph
				pTitle={Text.H2.Centered.White.OfText("ما الذي نقدمه في متابعة إجراءات الترخيص؟")}
				pText={Text.Body.Centered.White.OfText("دورنا ليس نقل أوراق فقط، بل قراءة فنية وإدارية للملف حتى يتحرك في الطريق الصحيح بأقل تعطيل ممكن")}
			/>

		</EmoStrip>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack pWidth={new Pixel(1050, 340)} pGap={new Pixel(22, 14)}>

				<CardsGr
					pWidth={new RespString("1050px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("مراجعة بداية الملف", "نراجع المستندات والرسومات وبيانات النشاط قبل التقديم حتى لا يبدأ الطلب ناقصًا أو متعارض البيانات.")}
					pTopic2={new Topic("متابعة مسار الطلب", "نحدد المرحلة التي وصل إليها الملف: تقديم، فحص، قبول مبدئي، اشتراطات، معاينة، استيفاء، أو إصدار.")}
					pTopic3={new Topic("التعامل مع ملاحظات الاستيفاء", "نقرأ المطلوب من الجهة المختصة ونترجمه إلى خطوات عملية: ورقة ناقصة، تعديل فني، رسم يحتاج تصحيح، أو طلب معاينة جديد.")}
					pTopic4={new Topic("ربط الترخيص بالتشغيل", "نساعد في التفكير في أثر الاشتراطات على تشغيل المحل فعليًا، حتى لا يصدر قرار إداري ثم يتعطل النشاط بسبب تجهيز غير محسوب.")}
				/>

				<EmoCall BlackSky pText="اطلب متابعة الترخيص" />

			</VrStack>

		</EmoStrip>

	</ESec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل القبول المبدئي يعني أن المحل أصبح مرخصًا؟"
			pAnswer="لا. القبول المبدئي يعني أن الطلب دخل في مسار الترخيص وأن الجهة المختصة حددت الاشتراطات المطلوبة، أما الترخيص النهائي فيصدر بعد استيفاء الاشتراطات وسداد الرسوم واجتياز المعاينة أو إعادة المعاينة عند الحاجة."
		/>

		<FaqItem
			pQuestion="متى تطلب الجهة المختصة معاينة المحل؟"
			pAnswer="تطلب المعاينة بعد مراجعة الملف وسداد رسم المعاينة أو بعد إخطار استيفاء الاشتراطات. هدف المعاينة هو التأكد من أن حالة المحل الفعلية مطابقة للبيانات والرسومات والاشتراطات المطلوبة للنشاط."
		/>

		<FaqItem
			pQuestion="لماذا قد يعود الملف للاستيفاء؟"
			pAnswer="قد يعود الملف للاستيفاء بسبب نقص مستند، اختلاف بيانات، عدم وضوح الرسم، عدم مطابقة المحل للاشتراطات، أو وجود تعديل مطلوب في الحريق أو الكهرباء أو التهوية أو المساحة أو النشاط."
		/>

		<FaqItem
			pQuestion="هل يمكن تشغيل المحل أثناء سير الإجراءات؟"
			pAnswer="تشغيل المحل قبل اكتمال الترخيص قد يعرّض صاحبه لمخاطر قانونية وإدارية. يجب التعامل مع كل حالة حسب موقفها الفعلي، وهل هي طلب جديد أو توفيق أوضاع أو تجديد أو تعديل نشاط."
		/>

	</EmoFaq>







	<ReadAlso
		pTitle={Text.H2.Centered.OfText("اقرأ أيضا ...")}
		pHeadBg={new ElemBg(Colors.SkyLite)}
		pBodyBg={new ElemBg(Colors.WhiteOff)}
		pCardBg={new ElemBg(Colors.Gray1)}
	>

		<ReadAlsoItem
			pTitle="ترخيص محل تجاري"
			pDesc="الصفحة الأساسية لخدمة استخراج ترخيص المحل التجاري، وفيها الصورة العامة للخدمة ومسار التعامل مع الملف من البداية حتى إصدار الترخيص."
			pHref="/emoperm/retail/general"
		/>

		<ReadAlsoItem
			pTitle="مستندات ترخيص محل تجاري"
			pDesc="الأوراق المطلوبة قبل الدخول في الإجراءات، مع تقسيم المستندات الأساسية والمستندات التي تختلف حسب النشاط أو صفة طالب الترخيص."
			pHref="/emoperm/retail/general/doc"
		/>

		<ReadAlsoItem
			pTitle="الرسم الهندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لملف ترخيص المحل التجاري بعد معاينة المحل ورفع الأبعاد وتجهيز بيانات المساحة والتوزيع الداخلي."
			pHref="/emoperm/retail/general/dwg"
		/>

		<ReadAlsoItem
			pTitle="تكلفة ترخيص محل تجاري"
			pDesc="شرح العوامل التي تؤثر على تكلفة الرخصة، مثل رسوم المعاينة، رسوم إصدار الترخيص، مساحة المحل، ونوع النشاط."
			pHref="/emoperm/retail/general/cost"
		/>

	</ReadAlso>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("خدماتنا")}
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.Gray1)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
	>

		<RelServiceItem
			pTitle="استخراج ترخيص محل تجاري"
			pDesc="مباشرة إجراءات استخراج رخصة المحل التجاري كوكيل عن العميل، مع مراجعة المستندات وتجهيز الملف ومتابعة الطلب حسب نطاق الخدمة المتاح."
			pHref="/emoperm/retail/general"
			pBtnText="معرفة المزيد"
		/>

		<RelServiceItem
			pTitle="رسم هندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لترخيص المحل التجاري، ويتم عمل معاينة للمحل لرفع الأبعاد وجمع المعلومات المطلوبة لإعداد الرسم الهندسي."
			pHref="/emoperm/retail/general/dwg"
			pBtnText="معرفة المزيد"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تصميم وتنفيذ تشطيبات المحلات التجارية بما يناسب طبيعة النشاط والميزانية المقترحة ونطاق التنفيذ المتاح."
			pHref="/emocrete/finishing/retail"
			pBtnText="معرفة المزيد"
		/>

	</RelServices>







</BLayout>
