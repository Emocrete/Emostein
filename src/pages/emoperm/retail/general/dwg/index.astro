---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { Badge, EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { RetailDwgMonthlyOffer } from "@/Widgets/Offers";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="رسم هندسي لمحل تجاري"
	pDescr="خدمة إعداد الرسم الهندسي المطلوب لترخيص محل تجاري، شامل المسقط الأفقي والقطاع الرأسي والواجهة وكروكي الموقع العام، مع معاينة المحل ورفع الأبعاد وتجهيز النسخ المطلوبة للترخيص."
>







	<Hero pImgAlt="طائرة ورقية تذهب في الفضاء تعبر عن الرسم الهندسي لترخيص محل تجاري بأنه يذهب ولا يعود ويقبل من المرة الأولى">

		<VrStack
			pHzAlign="Center"
			pVrAlign="Center"
			pSize={new Size(new NumPer("35%","95%"))}
			pLoc={new Loc(new NumPer("55%","2.5%"),new NumPer("20%","15%"))}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("رسم هندسي لمحل تجاري")}
				pText={Text.Body.Centered.White.OfText("خدمة احترافية لإعداد الرسم الهندسي المطلوب لترخيص محل تجاري لأي نشاط")}
			/>

			<EmoCall data-own-size BlackSky pText="للطلب والاستفسار" />

		</VrStack>

		<Emograph
			pTitle={Text.Body.Bold.OfSize(60,40).Centered.OfText("يذهب ..............")}
			pText={Text.Body.Bold.OfSize(60,40).OfText("ولا يعود ;)")}
			pSize={new Size(new NumPer("20%","80%"))}
			pLoc={new Loc(new NumPer("30%","10%"),new NumPer("20%","40%"))}
		/>

		<VrStack
			pLandOnly
			pSize={new Size(new NumPer("60%","95%"))}
			pLoc={new Loc(new NumPer("40%","2.5%"),new NumPer("65%","60%"))}
			data-own-size
		>

			<Badge
				pYears={6}
				pWorks={120}
				pDuration={24}
				pDurationText="خلال يوم واحد"
			/>

		</VrStack>

	</Hero>







	<EmoSec pPortOnly>

		<Badge
			pYears={6}
			pWorks={120}
			pDuration={24}
			pDurationText="خلال يوم واحد"
		/>

	</EmoSec>







	<RetailDwgMonthlyOffer />







	<EmoSec>

		<SecTitle GreenLite pTitle="خدمات الرسم الهندسي لترخيص محل تجاري" />

		<EmoStr pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<HzStack>

				<CardsGr
					pWidth={new RespString("1240px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pCardTitleFnt={Text.H2}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("01", "عدد 3 نسخ من الرسم الهندسي للمحل مختومة بختم مهندس نقابي")}
					pTopic2={new Topic("02", "تسليم الرسم الهندسي في اليوم التالي للمعاينة")}
					pTopic3={new Topic("03", "دقة تطابق الواقع")}
					pTopic4={new Topic("04", "التسليم في موقعك مجانا")}
				/>

				<VrStack
					pWidth={new Pixel(1200, 340)}
					pGap={new Pixel(20, 14)}
					pHzAlign="Center"
					pVrAlign="Center"
				>

					<Emograph
						pTitle={Text.Body.Bold.OfSize(100,50).Centered.OfText("2500 جنيه") }
						pText={Text.Body.Centered.OfText("قيمة خدمة إعداد الرسم الهندسي لترخيص محل تجاري")}
					/>

					<Emograph pTitle={Text.Body.Centered.OfText("طريقة السداد") } pText={Text.Body.Centered.OfText("مقدم أتعاب 1500 جنيه والباقي عند الاستلام")} />

					<EmoCall
						data-ops-event="Offer"
						data-ops-on="click"
						data-ops-label="طلب الخدمة"
						data-own-size
						BlackSky
						pText="اطلب الخدمة"
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec data-ops-event="DwgSpecs" data-ops-on="view" data-ops-label="مواصفات الرسم الهندسي">

		<SecTitle Bistage pTitle="مواصفات الرسم الهندسي لـترخيص محل تجاري" />

		<EmoStr pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

			<EmoList
				pDesc={Text.Body.Centered.OfText("يجب أن يتضمن الرسم الهندسي للمحل التجاري عدة عناصر رئيسية لتوصيف المحل وتوضيح مدى ملاءمته للمواصفات المطلوبة للنشاط الذي سيتم له ترخيص المحل التجاري.")}
				pItems={[
					{ Title: "مسقط أفقي", Items: ["موضح به المساحة الكلية والأبعاد الخارجية والداخلية وطريقة توزيع الفراغات الداخلية وأماكن الأعمدة وأبعاد المداخل والمنافذ."] },
					{ Title: "قطاع رأسي", Items: ["موضح به ارتفاع الأرضية بالنسبة للطريق وعدد مستويات الأرضية الداخلية وارتفاعات السقف عند كل مستوى."] },
					{ Title: "واجهة المحل", Items: ["موضح بها مدخل المحل التجاري واللافتة النهائية بالاسم التجاري المعتمد لصاحب الترخيص بالإضافة لموقع المحل بالنسبة لمدخل العقار وترتيبه بالنسبة للمحلات المجاورة بنفس العقار."] },
					{ Title: "كروكي الموقع العام", Items: ["وهو خريطة مبسطة تبين الموقع العام للمحل التجاري وعلاقته بالمباني المجاورة والطرق المحيطة."] }
				]}
			/>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="DrawingSamples"
		data-ops-event="DwgSamples"
		data-ops-on="view"
		data-ops-label="نماذج الرسم الهندسي"
	>

		<SecTitle OrangeDark pTitle="نماذج رسم هندسي لمحل تجاري" />

		<EmoGallery pFolder="./_M/Samples" />

	</EmoSec>







	<RetailDwgMonthlyOffer />







	<EmoFaq data-ops-event="Faq" data-ops-on="view" data-ops-label="Faq">

		<FaqItem
			pQuestion="هل الرسم الهندسي مطلوب لكل محل تجاري؟"
			pAnswer="تختلف المتطلبات حسب الجهة والنشاط وحالة المحل ومساحته، لكن الرسم الهندسي يظهر كثيرًا ضمن ملفات الترخيص، خصوصًا عندما تحتاج الجهة إلى توصيف المساحة والواجهة والقطاع والموقع العام أو مطابقة المحل على الطبيعة."
		/>

		<FaqItem
			pQuestion="ما الفرق بين الكروكي والرسم الهندسي؟"
			pAnswer="الكروكي عادة يوضح الموقع العام وعلاقة المحل بالشوارع والمباني المجاورة، أما الرسم الهندسي فيشمل المسقط الأفقي والقطاع والواجهة وتفاصيل الأبعاد والمناسيب والتوزيع الداخلي."
		/>

		<FaqItem
			pQuestion="هل يمكن إعداد الرسم من صور المحل فقط؟"
			pAnswer="الصور تساعد في الفهم، لكنها لا تكفي لإعداد رسم دقيق للترخيص. يجب رفع الأبعاد والمداخل والمناسيب والواجهة والموقع حتى يكون الرسم مطابقًا للحالة الفعلية."
		/>

		<FaqItem
			pQuestion="متى أحتاج تعديل الرسم بعد استلامه؟"
			pAnswer="يحتاج الرسم إلى تعديل إذا تغير تقسيم المحل أو الواجهة أو اللافتة أو الفتحات أو أي عنصر مؤثر قبل المعاينة، أو إذا طلبت الجهة المختصة استيفاءً محددًا في اللوحة."
		/>

	</EmoFaq>







	<RelServices>

		<RelServiceItem
			pTitle="استخراج ترخيص محل تجاري"
			pDesc="مباشرة إجراءات استخراج رخصة المحل التجاري كوكيل عن العميل، مع مراجعة المستندات وتجهيز الملف ومتابعة الطلب حسب نطاق الخدمة المتاح."
			pHref="/emoperm/retail/general"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تصميم وتنفيذ تشطيبات المحلات التجارية بما يناسب طبيعة النشاط والميزانية المقترحة ونطاق التنفيذ المتاح."
			pHref="/emocrete/finishing/retail"
		/>

	</RelServices>







</BLayout>
