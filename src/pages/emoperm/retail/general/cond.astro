---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Article"
	pTitle="شروط ترخيص محل تجاري"
	pDescr="شروط ترخيص محل تجاري"
>







	<Hero>

		<VrStack
			pBlur={new Pixel(10)}
			pBgOpacity={new Percent(50)}
			pBgColor={new ElemBg(Colors.BlackOff)}
			pLoc={new Loc(new NumPer("10%","5%"),new NumPer("40%","20%"))}
			pSize={new Size(new NumPer("40%","90%"))}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.White.Centered.OfText("شروط ترخيص محل تجاري")}
				pText={Text.Body.White.Centered.OfSize(16).OfText("شروط ترخيص محل تجاري")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="تواصل معنا"
			/>

		</VrStack>

	</Hero>







	<ReadAlso
		pTitle={Text.H2.Centered.OfText("اقرأ أيضا ...")}
		pHeadBg={new ElemBg(Colors.SkyLite)}
		pBodyBg={new ElemBg(Colors.WhiteOff)}
		pCardBg={new ElemBg(Colors.Gray1)}
	>

		<ReadAlsoItem
			pTitle="ترخيص محل تجاري"
			pDesc="الصفحة الأساسية لخدمة استخراج ترخيص المحل التجاري، وتشمل الصورة العامة للخدمة ومسار التعامل مع ملف الترخيص من البداية حتى الإصدار."
			pHref="/emoperm/retail/general"
		/>

		<ReadAlsoItem
			pTitle="إجراءات ترخيص محل تجاري"
			pDesc="بعد تجهيز مستندات الترخيص، تبدأ مرحلة تقديم الطلب والمراجعة والمعاينة واستيفاء الاشتراطات المطلوبة."
			pHref="/emoperm/retail/general/proc"
		/>

		<ReadAlsoItem
			pTitle="الرسم الهندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لملف ترخيص المحل التجاري بعد معاينة المحل ورفع الأبعاد وتجهيز بيانات المساحة والتوزيع الداخلي."
			pHref="/emoperm/retail/general/dwg"
		/>

	</ReadAlso>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("خدماتنا")}
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.Gray1)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
	>

		<RelServiceItem
			pTitle="استخراج ترخيص محل تجاري"
			pDesc="مباشرة إجراءات استخراج رخصة المحل التجاري كوكيل عن العميل، مع مراجعة المستندات وتجهيز الملف ومتابعة الطلب حسب نطاق الخدمة المتاح."
			pHref="/emoperm/retail/general"
			pBtnText="معرفة المزيد"
		/>

		<RelServiceItem
			pTitle="رسم هندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لترخيص المحل التجاري، ويتم عمل معاينة للمحل لرفع الأبعاد وجمع المعلومات المطلوبة لإعداد الرسم الهندسي."
			pHref="/emoperm/retail/general/dwg"
			pBtnText="معرفة المزيد"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تصميم وتنفيذ تشطيبات المحلات التجارية بما يناسب طبيعة النشاط والميزانية المقترحة ونطاق التنفيذ المتاح."
			pHref="/emocrete/finishing/retail"
			pBtnText="معرفة المزيد"
		/>

	</RelServices>







</BLayout>
