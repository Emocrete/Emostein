---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Article"
	pTitle="تكلفة ترخيص محل تجاري"
	pDescr="دليل تفصيلي لتكلفة ترخيص المحلات التجارية في مصر، يشمل رسوم المعاينة والترخيص والعوامل التي تغير التكلفة والمستندات والبنود الفنية التي تؤثر على إجمالي المصروفات."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تكلفة ترخيص محل تجاري")}
				pText={Text.Body.Centered.OfText("دليل تفصيلي لتكلفة ترخيص المحلات التجارية في مصر، يشمل رسوم المعاينة والترخيص والعوامل التي تغير التكلفة والمستندات والبنود الفنية التي تؤثر على إجمالي المصروفات.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<ReadAlso>

		<ReadAlsoItem pTitle="مستندات ترخيص محل تجاري" pDesc="مستندات ترخيص محل تجاري" pHref="/emoperm/retail/general/doc" />

		<ReadAlsoItem pTitle="إجراءات ترخيص محل تجاري" pDesc="إجراءات ترخيص محل تجاري" pHref="/emoperm/retail/general/proc" />

		<ReadAlsoItem pTitle="شروط ترخيص محل تجاري" pDesc="شروط ترخيص محل تجاري" pHref="/emoperm/retail/general/cond" />

	</ReadAlso>







	<RelServices>

		<RelServiceItem pTitle="استخراج ترخيص محل تجاري" pDesc="متابعة ملف الترخيص من مراجعة المستندات حتى صدور الرخصة." pHref="/emoperm/retail/general" />

		<RelServiceItem pTitle="رسم هندسي لترخيص محل تجاري" pDesc="رسم هندسي لترخيص محل تجاري" pHref="/emoperm/retail/general/dwg" />

		<RelServiceItem pTitle="تشطيب محل تجاري" pDesc="تشطيب محل تجاري" pHref="/emocrete/finishing/retail" />

	</RelServices>







</BLayout>
