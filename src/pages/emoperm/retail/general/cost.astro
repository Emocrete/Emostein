---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Topic } from "@/TypesLib";
import { Hero, IndexSec, EmoCall, ESec, EmoStrip, IncLineSep, Emograph, BottTriSep, EmoBtn, YTPlayer, DataCard, CardsGr, EmoList, Tree, EmoFaq, ReadAlso, RelServices, SecTitle, VrStack, HzStack, ReadAlsoItem, RelServiceItem } from "@/Widgets";

---




















<BLayout
	pSchemaType="Article"
	pTitle="تكلفة ترخيص محل تجاري"
	pDescr="دليل تفصيلي لتكلفة ترخيص المحلات التجارية في مصر، يشمل رسوم المعاينة والترخيص والعوامل التي تغير التكلفة والمستندات والبنود الفنية التي تؤثر على إجمالي المصروفات."
>

	<Hero
		pTitle="تكلفة ترخيص محل تجاري"
		pDesc="دليل عملي لفهم الرسوم الرسمية والمصروفات الفنية والبنود التي تجعل تكلفة ترخيص محل تختلف من نشاط إلى آخر ومن موقع إلى آخر"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="55% 60% 10% 5%"
		pPosP="45% 2% 5% 2%"
	>

		<EmoCall BlackSky pText="اسأل عن تكلفة رخصة محلك" />

	</Hero>

	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="تكلفة ترخيص المحل ليست رقمًا واحدًا"
			pDesc="الرقم النهائي يتكون من رسوم حكومية، ومعاينات، ومستندات، وتجهيزات فنية، وأتعاب إعداد الملف، لذلك لا يصح تقدير التكلفة من مساحة المحل وحدها"
			style={`--StripBg:${Colors.GreenLite};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<VrStack>

				<Emograph
					pTitle={Text.H3.White.OfText("الفكرة الأساسية")}
					pText={Text.Body.White.OfText("عند السؤال عن تكلفة ترخيص محل تجاري، فالرسوم الرسمية ليست إلا جزءًا من الصورة. هناك فرق بين رسم المعاينة ورسم إصدار الترخيص، وفرق آخر بين تكلفة استخراج الرخصة على الورق وبين تكلفة جعل المحل مستوفيًا للاشتراطات. أحيانًا تكون الرسوم الحكومية محدودة، لكن تكلفة تعديل الكهرباء أو التهوية أو الحماية من الحريق أو تجهيز رسم هندسي صحيح هي الجزء الأكبر من المصروف الحقيقي.")}
					pSize={new Size(980, "auto", "100%", "auto")}
				/>

				<CardsGr
					pWidth={new RespString("1300px", "100%")}
					pCardBg={new ElemBg(Colors.SkyLite)}
					pGrTitle={Text.H3.Centered.White.OfText("العناصر التي تصنع الرقم النهائي")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("رسوم حكومية", "رسم المعاينة ورسم إصدار الترخيص وما يرتبط بهما من مدفوعات داخل مركز إصدار التراخيص أو بوابة خدمات المحليات.")}
					pTopic2={new Topic("مستندات وتجهيز ملف", "صور مستندات الملكية أو الإيجار، بطاقة ضريبية، سجل تجاري، توكيلات، موافقات نشاط، وأي مستندات داعمة مطلوبة حسب الحالة.")}
					pTopic3={new Topic("رسومات وتقارير فنية", "الرسم الهندسي، تقرير السلامة الإنشائية أو تقرير الاستيفاء الفني، ومراجعة الاشتراطات المساحية والإنشائية إن طُلبت.")}
					pTopic4={new Topic("تعديلات داخل المحل", "تجهيزات الحريق والتهوية والكهرباء والصرف والواجهات والمداخل ومخارج الطوارئ حسب نشاط ومساحة وموقع المحل.")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.Gray1)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="ما الذي تقوله القواعد الرسمية عن الرسوم؟"
			pDesc="القاعدة العامة أن الرسوم تتغير حسب الموقع والمساحة والنشاط، لذلك الصفحة لا تقدم رقمًا نهائيًا لكل محل، بل طريقة قراءة التكلفة"
			style={`--StripBg:${Colors.Gray5};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1180px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pGrTitle={Text.H3.Centered.White.OfText("خريطة الرسوم الرسمية")}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("رسم المعاينة", "هو المبلغ الذي يرتبط بانتقال الجهة المختصة أو مراجعتها الفنية للمحل قبل إصدار الترخيص أو عند إعادة المعاينة بعد استيفاء النواقص.")}
				pTopic2={new Topic("رسم إصدار الترخيص", "هو الرسم الأكبر عادة، ويتغير طبقًا لمساحة المحل وموقعه ونوع النشاط ودرجة تميزه التجاري.")}
				pTopic3={new Topic("الإخطار أو الترخيص", "بعض الأنشطة الأقل خطورة قد تسير بنظام أبسط، بينما الأنشطة ذات الاشتراطات الخاصة تحتاج فحصًا وموافقات أكبر.")}
				pTopic4={new Topic("رسوم مرتبطة بالحالة", "المحل القائم، أو غير المستوفي، أو طالب تعديل نشاط، أو طالب تجديد أو نقل ترخيص قد لا يتحرك بنفس تكلفة محل جديد كامل الاستيفاء.")}
			/>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="العوامل التي تغيّر تكلفة الرخصة"
			pDesc="نفس النشاط قد يدفع رقمًا مختلفًا تمامًا إذا تغيرت المساحة أو الموقع أو درجة الخطورة أو حالة المستندات"
			style={`--StripBg:${Colors.Sky};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("العوامل الأساسية")}
				pDesc={Text.Body.Centered.OfText("ابدأ دائمًا بتحديد هذه البيانات قبل سؤال أي جهة عن رقم التكلفة")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pNumbered={true}
				pItems={[
					{ Title: "مساحة المحل", Items: ["كلما زادت المساحة انتقل المحل غالبًا إلى شريحة أعلى في الرسوم.", "المساحة تؤثر أيضًا على الحريق والتهوية وعدد دورات المياه ومسارات الحركة."] },
					{ Title: "موقع المحل", Items: ["محل في قرية أو شارع جانبي لا يشبه محلًا في مدينة جديدة أو منطقة تجارية متميزة.", "القيمة التجارية للموقع تدخل في تقدير الرسوم الرسمية وتدخل كذلك في تكلفة التجهيزات المطلوبة."] },
					{ Title: "نوع النشاط", Items: ["النشاط التجاري البسيط لا يشبه مطعمًا أو كافيه أو نشاطًا غذائيًا أو نشاطًا به مخاطر كهرباء أو تخزين.", "كلما زادت الاشتراطات الخاصة زادت احتمالات طلب مستندات أو تجهيزات إضافية."] },
					{ Title: "حالة المحل", Items: ["محل جديد لم يعمل بعد يختلف عن محل قائم يحتاج توفيق أوضاع.", "المحل الذي سبق ترخيصه ثم تغير نشاطه أو مساحته أو مالكه يحتاج قراءة مختلفة عن محل بلا تاريخ ترخيص."] },
					{ Title: "جاهزية المستندات", Items: ["عدم وضوح عقد الإيجار أو الملكية أو نقص السجل التجاري والبطاقة الضريبية يضيف وقتًا ومصروفات.", "الملف الجاهز يقلل إعادة المعاينة ويقلل احتمالات سداد رسوم إضافية بسبب الاستيفاء المتكرر."] }
				]}
			/>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.Creamy)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="طريقة عملية لتقدير التكلفة قبل التقديم"
			pDesc="لا تبدأ بالسؤال عن رقم الرخصة فقط، بل ابنِ تقديرًا من خمس طبقات"
			style={`--StripBg:${Colors.BistageDark};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<VrStack>

				<CardsGr
					pWidth={new RespString("1180px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pGrTitle={Text.H3.Centered.White.OfText("طبقات التكلفة")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("١ — الرسوم الرسمية", "ابدأ برسم المعاينة ورسم الترخيص طبقًا للمساحة والموقع والنشاط.")}
					pTopic2={new Topic("٢ — تجهيز الملف", "احسب استخراج أو استكمال السجل التجاري والبطاقة الضريبية والتوكيلات وصور المستندات المطلوبة.")}
					pTopic3={new Topic("٣ — الرسومات الهندسية", "احسب رفع المقاسات وإعداد اللوحات والمراجعة الفنية وختم أو اعتماد المستندات عند الحاجة.")}
					pTopic4={new Topic("٤ — تعديلات الاستيفاء", "ضع بندًا احتياطيًا للكهرباء والحريق والتهوية والصرف والواجهات والمداخل، لأنه أكثر بند يتغير بعد المعاينة.")}
					pTopic5={new Topic("٥ — أتعاب المتابعة", "لو هتسند الملف لمهندس أو مكتب خدمات، افصل أتعابه عن الرسوم الرسمية حتى تعرف أين يذهب كل مبلغ.")}
				/>

				<Emograph
					pTitle={Text.H3.Centered.White.OfText("قاعدة تقدير سريعة")}
					pText={Text.Body.Centered.White.OfText("التكلفة الآمنة قبل التقديم تساوي الرسوم الرسمية المتوقعة، زائد تكلفة المستندات، زائد تكلفة الرسومات، زائد احتياطي للاستيفاء الفني. الرقم الذي لا يضع بند الاستيفاء في الحساب يكون غالبًا أقل من الحقيقة، خصوصًا في المطاعم والكافيهات والأنشطة الغذائية أو المحلات الكبيرة.")}
					pSize={new Size(980, "auto", "100%", "auto")}
				/>

			</VrStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="أمثلة تقريبية لقراءة التكلفة"
			pDesc="الأرقام التالية ليست تسعيرة رسمية، لكنها طريقة تفكير تساعدك على تقدير اتجاه التكلفة قبل المعاينة"
			style={`--StripBg:${Colors.SkyLite};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<HzStack>

				<Emograph
					pTitle={Text.H3.White.OfText("محل صغير منخفض الخطورة")}
					pText={Text.Body.White.OfText("لو النشاط بسيط والمساحة محدودة والموقع عادي والمستندات مكتملة، يكون التركيز على الرسوم الرسمية الأساسية وإثبات شغل العين، وغالبًا لا تظهر تعديلات فنية كبيرة إلا إذا كان المحل غير مطابق في الكهرباء أو الواجهة أو الاستخدام.")}
					pSize={new Size(350, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.White.OfText("مطعم أو كافيه")}
					pText={Text.Body.White.OfText("هنا لا تنظر للرسم الرسمي فقط، لأن التهوية والصرف والحريق ودورات المياه والاشتراطات الصحية وتخزين المواد وتشغيل المعدات قد تصنع فارقًا كبيرًا بين محل جاهز ومحل يحتاج تجهيزات.")}
					pSize={new Size(350, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.White.OfText("محل في موقع متميز")}
					pText={Text.Body.White.OfText("الموقع التجاري المتميز يرفع شريحة الرسوم، وقد يرفع كذلك توقعات الجهات المختصة بخصوص الواجهة، الإشغال، الأمن، المداخل، وتأثير النشاط على الجيران أو المرور أو المشاة.")}
					pSize={new Size(350, "auto", "100%", "auto")}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.Gray1)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="المستندات التي تؤثر على التكلفة"
			pDesc="كل مستند ناقص قد يتحول إلى تكلفة وقت أو توكيل أو استخراج أو تعديل أو إعادة تقديم"
			style={`--StripBg:${Colors.Gray4};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("راجع هذه البنود قبل دفع أي رسوم")}
				pHeadBg={new ElemBg(Colors.WhiteOff)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pNumbered={false}
				pItems={[
					{ Title: "إثبات شخصية وصفة مقدم الطلب", Items: ["بطاقة الرقم القومي أو ما يثبت الصفة القانونية للوكيل أو الممثل.", "أي توكيلات أو تفويضات لازمة إذا لم يكن صاحب الشأن هو مقدم الطلب."] },
					{ Title: "مستند شغل العين", Items: ["عقد ملكية أو عقد إيجار أو سند حيازة واضح البيانات ومقبول للجهة المختصة.", "مطابقة عنوان العقد مع عنوان المحل الفعلي تقلل مشاكل المعاينة."] },
					{ Title: "مستندات النشاط", Items: ["السجل التجاري والبطاقة الضريبية وبيانات النشاط كما سيظهر في الرخصة.", "تغيير النشاط بعد إصدار الرخصة قد يحتاج إجراء جديد أو تعديل ترخيص."] },
					{ Title: "الرسومات والبيانات الفنية", Items: ["رسم هندسي أو كروكي يوضح المساحة والتوزيع والمداخل والمرافق حسب طلب الجهة.", "بعض الأنشطة تحتاج تقريرًا فنيًا أو مراجعة اشتراطات سلامة قبل اكتمال الملف."] }
				]}
			/>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="الأخطاء التي ترفع التكلفة"
			pDesc="أغلب الزيادات لا تأتي من الرسم الرسمي فقط، بل من إعادة الشغل بسبب ملف غير محسوب"
			style={`--StripBg:${Colors.OrangeLite};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1180px", "100%")}
				pCardBg={new ElemBg(Colors.Creamy)}
				pGrTitle={Text.H3.Centered.White.OfText("تجنب هذه الأخطاء")}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("بدء التشطيب قبل فهم الاشتراطات", "قد تنفذ واجهة أو تمديدات أو توزيعًا داخليًا ثم تكتشف أن المطلوب مختلف، فتدفع تكلفة تعديل بدل تكلفة تنفيذ واحدة.")}
				pTopic2={new Topic("اختيار نشاط غير مطابق للحقيقة", "الوصف الخاطئ للنشاط قد يخفض التكلفة ظاهريًا في البداية، لكنه يسبب رفضًا أو تعديلًا أو مشكلة عند التفتيش.")}
				pTopic3={new Topic("إهمال الجيران والإزعاج", "المحل الذي يسبب ضوضاء أو إشغالًا أو روائح أو دخانًا قد يدخل في متطلبات أصعب أو اعتراضات تؤخر الترخيص.")}
				pTopic4={new Topic("عدم فصل الرسوم عن الأتعاب", "اطلب دائمًا تفصيلًا واضحًا بين رسوم حكومية، مستندات، رسومات، تجهيزات، وأتعاب متابعة حتى لا تختلط البنود.")}
			/>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.SkyLite)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="متى تحتاج مهندسًا قبل تقديم الطلب؟"
			pDesc="وجود مهندس لا يعني زيادة غير لازمة، بل يمنع أحيانًا تكلفة إعادة التعديل بعد المعاينة"
			style={`--StripBg:${Colors.BlackOff};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.SkyLite)} pAlign={Align.Center}>

			<VrStack>

				<Emograph
					pTitle={Text.H3.White.OfText("قبل الإيجار أو الشراء")}
					pText={Text.Body.White.OfText("أفضل توقيت لمراجعة التكلفة هو قبل توقيع عقد طويل أو دفع مقدم كبير، لأن بعض المحلات تبدو مناسبة تجاريًا لكنها صعبة ترخيصيًا بسبب المساحة أو المداخل أو التهوية أو طبيعة العقار أو النشاط المطلوب.")}
					pSize={new Size(980, "auto", "100%", "auto")}
				/>

				<Emograph
					pTitle={Text.H3.White.OfText("قبل تنفيذ التجهيزات")}
					pText={Text.Body.White.OfText("مراجعة توزيع المحل ومسارات الكهرباء والصرف والتهوية والحريق قبل التنفيذ توفر جزءًا كبيرًا من المصروفات، لأن الاستيفاء بعد التشطيب يكون أعلى تكلفة وأبطأ زمنًا.")}
					pSize={new Size(980, "auto", "100%", "auto")}
				/>

				<CardsGr
					pWidth={new RespString("1180px", "100%")}
					pCardBg={new ElemBg(Colors.WhiteOff)}
					pGrTitle={Text.H3.Centered.White.OfText("ما الذي نراجعه؟")}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("قابلية الترخيص", "مطابقة النشاط للمكان، حدود المساحة، طبيعة العقار، المداخل، الجوار، والمرافق.")}
					pTopic2={new Topic("مستندات الرخصة", "مراجعة عقد الشغل والسجل والبطاقة الضريبية والصفة القانونية قبل فتح ملف رسمي.")}
