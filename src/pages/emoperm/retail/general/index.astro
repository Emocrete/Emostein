---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, IndexBtn, VrStack } from "@/Widgets/Comp";
import { EmoGallery } from "@/Widgets/Media";
import { EmoSec, Hero, IndexSec, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Colors, ElemBg, EmoMediaData, Loc, NumPer, Percent, Pixel, Size, Text } from "@/TypesLib";
import { number } from "astro:schema";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ترخيص محل تجاري"
	pDescr="خدمات استخراج ترخيص محل تجاري، الأوراق المطلوبة، إجراءات الترخيص، الرسومات الهندسية، وقيمة خدمة متابعة الترخيص."
>







	<Hero>

		<VrStack
			pBlur={new Pixel(10)}
			pBgOpacity={new Percent(50)}
			pBgColor={new ElemBg(Colors.BlackOff)}
			pLoc={new Loc(new NumPer("10%","5%"),new NumPer("40%","20%"))}
			pSize={new Size(new NumPer("40%","90%"))}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.White.OfText("ترخيص محل تجاري")}
				pText={Text.Body.White.OfSize(16).OfText("خدمة احترافية لاستخراج ترخيص محل تجاري وكيلا عن العميل")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="تواصل معنا"
			/>

		</VrStack>

	</Hero>







	<IndexSec
		pMedia={new EmoMediaData("Vid", "/Media/", "IndexBgVid.mp4")}
		pTitleClr="white"
		pBlurL="on"
		pBlurP="on"
	>

		<VrStack>

			<IndexBtn pText="المستندات المطلوبة لفتح محل تجاري" onclick="location.href='#secDoc'" />

			<IndexBtn pText="إجراءات ترخيص محل تجاري" onclick="location.href='#secProc'" />

			<IndexBtn pText="الرسم الهندسي لترخيص محل تجاري" onclick="location.href='#secDwg'" />

		</VrStack>

	</IndexSec>







	<EmoSec id="secDoc">

		<EmoStr pBg={new ElemBg(Colors.Bistage)}>

			<Emograph pTitle={Text.H2.Centered.OfText("الأوراق المطلوبة لاستخراج رخصة محل تجاري")} />

		</EmoStr>

		<HzStack pSize={new Size(new NumPer("90%","95%"),new NumPer(500,"auto"))}>

			<EmoStr pBg={new ElemBg(Colors.Gray1)} pSize={new Size(new NumPer("80%"),new NumPer(500,"auto"))}>

				<EmoList
					pTitle={Text.H3.OfText("أولا: مستندات أساسية لجميع المحلات العامة:")}
					pItems={	[
				"بطاقة ضريبية",
				"سجل تجاري",
				"صورة عقد الملكية أو عقد إيجار المحل مع توفير أصل العقد للإطلاع",
				"صورة بطاقة الرقم القومي لصاحب الترخيص",
				"عدد 3 نسخ من الرسومات الهندسية للمحل حسب المواصفات المعتمدة",
				"خطاب التأمين الصادر عن التأمينات الاجتماعية",
				"شهادة بالقيمة الإيجارية للمحل من الضرائب العقارية"
			] }
				>

				</EmoList>

			</EmoStr>

			<EmoStr pBg={new ElemBg(Colors.Gray1)} pSize={new Size(new NumPer("80%"),new NumPer(500,"auto"))}>

				<EmoList
					pTitle={Text.H3.OfText("ثانيا: مستندات خاصة بالمطاعم والأنشطة الخاصة بالمأكولات والمشروبات")}
					pItems={	[
				"شهادة صحية للعاملين في المحل مستخرج من مستشفى حكومي"
			] }
				>

				</EmoList>

			</EmoStr>

			<EmoStr pBg={new ElemBg(Colors.Gray1)} pSize={new Size(new NumPer("80%"),new NumPer(500,"auto"))}>

				<EmoList pTitle={Text.H3.OfText("ثالثا: مستندات خاصة بمحال الأنشطة العامة والترفيهية")} pItems={	[
				"صحيفة الحالة الجنائية"
				]}>

				</EmoList>

			</EmoStr>

		</HzStack>

	</EmoSec>







	<EmoSec id="secProc">

		<EmoStr pBg={new ElemBg(Colors.Bistage)}>

			<Emograph pTitle={Text.H2.Centered.OfText("إجراءات ترخيص محل تجاري")} />

		</EmoStr>

		<div class = " StepsWrap ">

			<article class = " StepCard ">

				<div class = " StepNum ">

					1

				</div>

				<p>
					تقديم طلب ترخيص محل تجاري مرفق به المستندات المطلوبة
				</p>

			</article>

			<article class = " StepCard ">

				<div class = " StepNum ">

					2

				</div>

				<p>
					يتم الرد خلال 60 يوم بالقبول المبدئي أو بالرفض المسبب ، وفي حال عدم الرد خلال المدة المحددة يعتبر الطلب مقبولاً
				</p>

			</article>

			<article class = " StepCard ">

				<div class = " StepNum ">

					3

				</div>

				<p>
					استلام إخطار قبول طلب ترخيص المحل التجاري الموضح به الاشتراطات العامة والخاصة للنشاط المراد الترخيص به
				</p>

			</article>

			<article class = " StepCard ">

				<div class = " StepNum ">

					4

				</div>

				<p>
					إرسال إخطار استيفاء الاشتراطات المطلوبة للترخيص بخطاب مسجل بعلم الوصول إلى إدارة تراخيص المحلات التجارية التابع لها المحل
				</p>

			</article>

			<article class = " StepCard ">

				<div class = " StepNum ">

					5

				</div>

				<p>
					تقديم طلب معاينة المحل التجاري في حال تحقق الاشتراطات ودفع الرسوم المقررة للمعاينة
				</p>

			</article>

			<article class = " StepCard ">

				<div class = " StepNum ">

					6

				</div>

				<p>
					استلام إخطار الرد من إدارة التراخيص بعد إجراء المعاينة للمحل التجاري بالموافقة على الترخيص أو بتوضيح الاشتراطات التي لم يتم استيفاؤها
				</p>

			</article>

			<article class = " StepCard ">

				<div class = " StepNum ">

					7

				</div>

				<p>
					استلام اخطار الموافقة على اصدار ترخيص المحل التجاري بعد إتمام استيفاء الاشتراطات كاملة
				</p>

			</article>

			<article class = " StepCard ">

				<div class = " StepNum ">

					8

				</div>

				<p>
					سداد الرسوم المحددة لاستخراج ترخيص المحل التجاري واستلام الترخيص
				</p>

			</article>

		</div>

	</EmoSec>







	<EmoSec id="secDwg">

		<EmoStr pBg={new ElemBg(Colors.Bistage)}>

			<Emograph
				pTitle={Text.H2.Centered.OfText("الرسم الهندسي لـترخيص المحلات التجارية")}
				pText={Text.Body.Centered.OfText("يجب أن يتضمن الرسم الهندسي للمحل التجاري عدة عناصر رئيسية لتوصيف المحل وتوضيح مدى ملاءمته للمواصفات المطلوبة للنشاط الذي سيتم له ترخيص المحل التجاري.")}
			/>

		</EmoStr>

		<div class = " DrawingBlock ">

			<h3>
				شروط الرسم الهندسي لـ ترخيص محل تجاري
			</h3>

			<ul>

				<li>

					مسقط أفقي موضح به المساحة الكلية والأبعاد الخارجية والداخلية وطريقة توزيع الفراغات الداخلية وأماكن الأعمدة وأبعاد المداخل والمنافذ.

				</li>

				<li>

					قطاع رأسي موضح به ارتفاع الأرضية بالنسبة للطريق وعدد مستويات الأرضية الداخلية وارتفاعات السقف عند كل مستوى.

				</li>

				<li>

					واجهة موضح بها مدخل المحل التجاري واللافتة النهائية بالاسم التجاري المعتمد لصاحب الترخيص بالإضافة لموقع المحل بالنسبة لمدخل العقار وترتيبه بالنسبة للمحلات المجاورة بنفس العقار.

				</li>

				<li>

					كروكي للموقع العام للمحل التجاري.

				</li>

			</ul>

			<a class = " MainBtn " href="/emoperm/retail/general/dwg">
				عرض التفاصيل
			</a>

		</div>

	</EmoSec>







	<EmoSec id="DrawingSamples">

		<EmoStr pBg={new ElemBg(Colors.OrangeDark)}>

			<Emograph pTitle={Text.H2.Centered.OfText("نماذج رسم هندسي لمحل تجاري")} />

		</EmoStr>

		<EmoGallery pFolder="/Media/Emoperm/Retail/General/Dwg/Samples" />

	</EmoSec>







	<EmoSec id="MainService">

		<EmoStr pBg={new ElemBg(Colors.Gray3)}>

			<Emograph
				pTitle={Text.H2.Centered.OfText("استخراج ترخيص محل تجاري")}
				pText={Text.Body.Centered.OfText("خدمة متابعة إجراءات استخراج ترخيص محل تجاري كوكيل")}
			/>

		</EmoStr>

		<div class = " OfferWrap ">

			<section class = " OfferPrice ">

				<h3>
					قيمة الخدمة
				</h3>

				<div class = " PriceValue ">

					7000

				</div>

				<div class = " PriceUnit ">

					جنيه

				</div>

			</section>

			<section class = " OfferDetails ">

				<h3>
					بنود الخدمة
				</h3>

				<ul>

					<li>

						تقديم ملف ترخيص المحل التجاري إلى الحي أو الجهاز التابع له المحل إداريا .

					</li>

					<li>

						متابعة استخراج الموافقات التي قد تطلب للحصول على ترخيص مزاولة النشاط التجاري حسب نوعه .

					</li>

					<li>

						التنسيق مع مهندس الحي بخصوص معاينة المحل للتحقق من توافر شروط النشاط به .

					</li>

					<li>

						مراجعة الحي أو الجهاز التابع له المحل إداريا لاستلام ترخيص المحل .

					</li>

				</ul>

				<h3>
					الخدمة لا تشمل ما يلي :
				</h3>

				<ul>

					<li>

						إعداد الرسم الهندسي لترخيص المحل التجاري .

					</li>

					<li>

						إعداد تقرير مهندسي استشاري لحالة المبنى في حال تطلبته الحالة .

					</li>

					<li>

						أي مصروفات مفوترة مدفوعة لأي جهة .

					</li>

					<li>

						أي مصروفات غير رسمية أو إكراميات تزيد عن 500 جنيه قد تكون مطلوبة إجباريا بأي جهة لتسيير الأعمال .

					</li>

				</ul>

			</section>

		</div>

		<div class = " PaymentsBlock ">

			<h3>
				بيان الدفعات
			</h3>

			<div class = " PaymentCards ">

				<article>

					<h4>
						عند بداية التعاقد
					</h4>

					<div>

						3000

					</div>

					<p>
						جنيه
					</p>

				</article>

				<article>

					<h4>
						بعد معاينة مهندس الحي
					</h4>

					<div>

						2000

					</div>

					<p>
						جنيه
					</p>

				</article>

				<article>

					<h4>
						بعد استلام الترخيص
					</h4>

					<div>

						2000

					</div>

					<p>
						جنيه
					</p>

				</article>

			</div>

			<a class = " RequestBtn " href="https://wa.me/201014490054">
				اطلب الخدمة
			</a>

		</div>

	</EmoSec>







	<RelServices
		pTitle={Text.H2.Centered.OfText("خدمات أخرى للمحلات التجارية")}
		pHeadBg={new ElemBg(Colors.BistageLite)}
		pBodyBg={new ElemBg(Colors.WhiteOff)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
	>

		<RelServiceItem
			pTitle="رسم هندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لترخيص المحل التجاري، ويتم عمل معاينة للمحل لرفع الأبعاد وجمع المعلومات المطلوبة لإعداد الرسم الهندسي."
			pHref="/emoperm/retail/general/dwg"
			pBtnText="معرفة المزيد"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تصميم وتنفيذ جميع أنواع التشطيبات للمحلات التجارية، مع مرونة في تجهيز تصميمات تناسب نطاقًا واسعًا من الميزانيات."
			pHref="/emocrete/finishing/retail"
			pBtnText="معرفة المزيد"
		/>

	</RelServices>







</BLayout>




















<style>



	.HeroServiceBox {
		width: min(480px, 100%);
		margin-top: 16px;
		padding: 20px 22px;
		border-radius: 18px;
		background: rgb(0 0 0 / 48%);
		color: white;
		text-align: center;
		box-sizing: border-box;
	}

	.HeroServiceBox h2 {
		margin: 0 0 8px;
		font-size: clamp(24px, 2vw, 34px);
		line-height: 1.5;
	}

	.HeroServiceBox p {
		margin: 0 0 14px;
		font-size: clamp(16px, 1.1vw, 20px);
		line-height: 1.8;
	}


	.DocsBlock {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 24px;
		align-items: stretch;
	}


	.DocsCard {
		padding: 28px;
		border: 1px solid #d8d8d8;
		border-radius: 24px;
		background: #fffde2;
		box-sizing: border-box;
		box-shadow: 0 12px 30px rgb(0 0 0 / 6%);
	}


	.StepsWrap {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 22px;
	}


	.StepCard {
		position: relative;
		min-height: 180px;
		padding: 56px 22px 24px;
		border-radius: 22px;
		background: #353535;
		color: white;
		box-sizing: border-box;
		box-shadow: 0 14px 36px rgb(0 0 0 / 16%);
	}

	.StepCard p {
		margin: 0;
		font-size: 18px;
		line-height: 2;
	}


	.StepNum {
		position: absolute;
		top: 16px;
		right: 18px;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		background: #d7f58c;
		color: #222222;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24px;
		font-weight: 900;
	}


	.DrawingGallery {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 18px;
		align-items: center;
	}

	.DrawingGallery img {
		width: 100%;
		min-height: 190px;
		max-height: 260px;
		object-fit: contain;
		padding: 14px;
		border: 1px solid #e2e2e2;
		border-radius: 18px;
		background: white;
		box-sizing: border-box;
		box-shadow: 0 12px 28px rgb(0 0 0 / 8%);
	}


	.DrawingBlock {
		width: min(1040px, 100%);
		padding: 48px;
		border-radius: 24px;
		background: #8d8a86;
		color: white;
		box-shadow: 0 18px 46px rgb(0 0 0 / 18%);
	}

	.DrawingBlock h3 {
		color: #d7f58c;
	}

	.DrawingBlock ul {
		color: white;
	}

	.DrawingBlock .MainBtn {
		margin-top: 22px;
	}


	.OfferWrap {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr);
		gap: 0;
		padding-bottom: 0;
	}


	.OfferPrice {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 30px;
		background: #6f6b7c;
		color: white;
		text-align: center;
	}

	.OfferPrice h3 {
		margin: 0 0 18px;
		font-size: 24px;
	}


	.PriceValue {
		color: #d7f58c;
		font-size: 70px;
		font-weight: 900;
		line-height: 1;
	}


	.PriceUnit {
		margin-top: 12px;
		font-size: 22px;
		font-weight: 800;
	}


	.OfferDetails {
		padding: 34px;
		background: #cfe9ff;
		color: #222222;
	}

	.OfferDetails h3 {
		margin-top: 18px;
	}

	.OfferDetails h3:first-child {
		margin-top: 0;
	}


	.PaymentsBlock {
		padding-top: 28px;
		text-align: center;
	}

	.PaymentsBlock > h3 {
		margin: 0 0 24px;
		font-size: 32px;
		line-height: 1.6;
	}


	.PaymentCards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin-bottom: 30px;
	}

	.PaymentCards article {
		padding: 24px;
		border-radius: 18px;
		background: white;
		box-shadow: 0 12px 30px rgb(0 0 0 / 8%);
	}

	.PaymentCards h4 {
		margin: 0 0 14px;
		font-size: 22px;
	}

	.PaymentCards div {
		color: #849e44;
		font-size: 48px;
		font-weight: 900;
		line-height: 1;
	}

	.PaymentCards p {
		margin: 12px 0 0;
		font-size: 18px;
		font-weight: 800;
	}


	.RequestBtn {
		min-height: 54px;
		padding-inline: 42px;
		background: #222222;
		color: white;
	}


	.ServicesBlock {
		width: min(980px, calc(100% - 40px));
		padding: 38px 46px;
		border-radius: 4px;
		background: #8d8a86;
		color: white;
		box-shadow: 0 18px 44px rgb(0 0 0 / 18%);
	}

	.ServicesBlock h3 {
		color: #d7f58c;
	}

	.ServicesBlock p {
		margin: 0 0 20px;
		font-size: 18px;
		line-height: 2;
	}


	.ServiceLine {
		padding: 0 0 26px;
		margin: 0 0 26px;
		border-bottom: 1px solid rgb(255 255 255 / 22%);
	}

	.ServiceLine:last-child {
		padding-bottom: 0;
		margin-bottom: 0;
		border-bottom: 0;
	}



	.HeroCta,
	.MainBtn,
	.RequestBtn,
	.ServicesBlock a
	{
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 0 24px;
		border-radius: 999px;
		background: white;
		color: #222222;
		font-weight: 800;
		text-decoration: none;
		box-shadow: 0 8px 22px rgb(0 0 0 / 12%);
	}


	.DocsBlock,
	.StepsWrap,
	.DrawingGallery,
	.DrawingBlock,
	.OfferWrap,
	.PaymentsBlock,
	.ServicesBlock
	{
		width: min(1220px, 100%);
		margin-inline: auto;
		padding: 42px 20px;
		box-sizing: border-box;
	}


	.DocsCard h3,
	.DrawingBlock h3,
	.OfferDetails h3,
	.ServicesBlock h3
	{
		margin: 0 0 18px;
		color: #222222;
		font-size: clamp(22px, 1.8vw, 30px);
		line-height: 1.6;
	}


	.DocsCard ol,
	.DocsCard ul,
	.DrawingBlock ul,
	.OfferDetails ul
	{
		margin: 0;
		padding: 0 28px 0 0;
		font-size: 18px;
		line-height: 2;
	}



</style>




















<style>



	@media (max-width: 1000px) {
		.DocsBlock,
		.StepsWrap,
		.DrawingGallery
		{
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.OfferWrap {
			grid-template-columns: 1fr;
		}
	}


	@media (max-width: 640px) {
		.DocsBlock,
		.StepsWrap,
		.DrawingGallery,
		.PaymentCards
		{
			grid-template-columns: 1fr;
		}

		.DrawingBlock {
			padding: 30px 22px;
		}
	}



</style>
