---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, EmoMediaData, Colors, Pixel, Topic, Loc,RespString, NumPer,Size, Percent, DirectSize, Angle, Align} from "@/TypesLib";
import { Hero, IndexSec,FaqItem,EmoFaq, ESec, EmoStrip,RespImg,ReadAlsoItem,ReadAlso, Card,SecTitle, IncLineSep, BottTriSep, EmoBtn, IndexBtn, YTPlayer, DataCard, CardsGr, EmoList, Tree, Emograph, EmoCall, RelServices, VrStack, HzStack, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Article"
	pTitle="مستندات ترخيص محل تجاري"
	pDescr="الأوراق المطلوبة لاستخراج رخصة محل تجاري في مصر، مع تقسيم المستندات الأساسية والمستندات التي قد تطلب حسب النشاط أو حالة المحل أو صفة طالب الترخيص."
>







	<Hero>

		<VrStack
			pBlur={new Pixel(10)}
			pBgOpacity={new Percent(50)}
			pBgColor={new ElemBg(Colors.BlackOff)}
			pLoc={new Loc(new NumPer("10%","5%"),new NumPer("40%","20%"))}
			pSize={new DirectSize(new NumPer("40%","90%"))}
			pAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.White.Centered.OfText("الاوراق المطلوبة لاستخراج رخصة محل تجاري")}
				pText={Text.Body.White.Centered.OfSize(16).OfText("تجهيز ملف المستندات قبل التقديم خطوة مهمة تختصر وقت المراجعة وتقلل احتمالات تأخر معاملة الجهة الإدارية بسبب طلب استيفاءات جديدة")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="تواصل معنا"
			/>

		</VrStack>

	</Hero>







	<ESec
		id="RequiredDocuments"
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>

		<SecTitle SkyLite pTitle="المستندات المطلوبة لترخيص محل تجاري" />

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1600px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H3}
				pCardBodyFnt={Text.Body}
				pSpacing={new Pixel(50)}
				pTopic1={new Topic("أولا: مستندات أساسية لجميع المحلات العامة:", " ", [
					"بطاقة ضريبية",
					"سجل تجاري",
					"صورة عقد الملكية أو عقد إيجار المحل مع توفير أصل العقد للإطلاع",
					"صورة بطاقة الرقم القومي لصاحب الترخيص",
					"عدد 3 نسخ من الرسومات الهندسية للمحل حسب المواصفات المعتمدة",
					"خطاب التأمين الصادر عن التأمينات الاجتماعية",
					"شهادة بالقيمة الإيجارية للمحل من الضرائب العقارية"
				])}
				pTopic2={new Topic("ثانيا: مستندات خاصة بالمطاعم والأنشطة الخاصة بالمأكولات والمشروبات", " ", [
					"شهادة صحية للعاملين في المحل مستخرج من مستشفى حكومي"
				])}
				pTopic3={new Topic("ثالثا: مستندات خاصة بمحال الأنشطة العامة والترفيهية ( كافيه )", " ", [
					"صحيفة الحالة الجنائية"
				])}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

		<SecTitle Bistage pTitle="مستندات قد تطلب حسب صفة طالب الترخيص" />

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1600px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("إذا كان طالب الترخيص أجنبيًا", "يفضل تجهيز صورة جواز السفر بعد الاطلاع على الأصل، مع أي موافقات أو مستندات عمل لازمة بحسب طبيعة الإقامة والنشاط، لأن الملف هنا لا يعتمد على بطاقة الرقم القومي وحدها.")}
				pTopic2={new Topic("إذا كان التقديم بتوكيل", "يضاف توكيل رسمي يبيح للوكيل تقديم الطلب والمتابعة واستلام الإخطارات، مع صورة بيانات الموكل والوكيل حتى لا يتوقف الملف بسبب عدم حضور صاحب الشأن بنفسه.")}
				pTopic3={new Topic("إذا كان طالب الترخيص شركة", "يضاف ما يثبت الشكل القانوني والصفة في التوقيع، مثل السجل التجاري والبطاقة الضريبية وبيانات الممثل القانوني أو المفوض بالتعامل مع جهة الترخيص.")}
				pTopic4={new Topic("إذا كان هناك مدير مسؤول", "في بعض الأنشطة لا يكفي اسم صاحب الترخيص، بل تحتاج الجهة لبيانات المدير المسؤول عن التشغيل، وقد تطلب صحيفة حالة جنائية أو مستندات صحية أو مهنية حسب النشاط.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			Sky
			pTitle="مستندات تثبت حالة المحل والعقار"
			pDesc="أكبر سبب لتعطل ملف الترخيص غالبًا لا يكون بطاقة صاحب الطلب، بل حالة العين نفسها: الملكية، الإيجار، القيمة الإيجارية، موقف العقار، والرسم التوضيحي"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("راجع هذه النقاط قبل تصوير الأوراق")}
				pDesc={Text.Body.Centered.OfText("التأكد من وضوح المستند قبل تقديمه يوفر وقتًا أكثر من مجرد جمع صور كثيرة غير صالحة للمراجعة")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pNumbered={true}
				pItems={[
					{ Title: "عقد الإيجار أو الملكية", Items: ["يجب أن يطابق عنوان المحل وبياناته الفعلية، وأن يكون النشاط المطلوب غير متعارض مع استعمال العين.", "في حالة الإيجار، راجع تاريخ العقد ومدته ووضوح اسم المؤجر والمستأجر وبيانات العين."] },
					{ Title: "القيمة الإيجارية من الضرائب العقارية", Items: ["هذه الشهادة تربط العين محل الطلب بسجلات الضرائب العقارية وتدخل ضمن قراءة الرسوم والملف الإداري.", "عدم تطابق العنوان أو رقم العقار مع العقد والرسم قد يفتح طلب استيفاء جديد."] },
					{ Title: "الرسم التوضيحي أو الهندسي", Items: ["الرسم ليس مجرد شكل؛ هو وسيلة لفهم المساحة، المداخل، العلاقة بالشارع، والفراغات الداخلية.", "في الحالات التي تتطلب رسومات معتمدة، يجب أن تكون النسخ واضحة ومطابقة للحالة التي ستتم معاينتها."] },
					{ Title: "موقف العقار", Items: ["إذا لم تكن رخصة البناء أو موقف العقار واضحًا، قد تظهر حاجة إلى مستندات تنظيمية أو تقرير هندسي يثبت السلامة الإنشائية.", "المحل داخل عقار قديم أو عقار تحت تقنين وضعه يحتاج مراجعة مختلفة عن محل داخل مشروع أو مول موثق المستندات."] }
				]}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="مستندات النشاط التجاري والتشغيل"
			pDesc="بعد إثبات صفة طالب الترخيص وحالة العين، تأتي مستندات النشاط نفسه: ضريبة، سجل، تأمينات، شهادات صحية، وموافقات خاصة عند الحاجة"
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

			<HzStack pGap={new Pixel(28, 16)}>

				<VrStack
					pWidth={new Pixel(650, 340)}
					pPad={new Pixel(0, 0)}
					pGap={new Pixel(18, 12)}
				>

					<CardsGr
						pWidth={new RespString("650px", "100%")}
						pCardBg={new ElemBg(Colors.WhiteOff)}
						pStackDir="Col"
						pCardTitleFnt={Text.H4}
						pCardBodyFnt={Text.Body}
						pTopic1={new Topic("البطاقة الضريبية والسجل التجاري", "هما مستندان يثبتان وجود النشاط تجاريًا وضريبيًا، ويجب أن تكون بيانات النشاط والاسم والعنوان متسقة مع باقي أوراق الملف بقدر الإمكان.")}
						pTopic2={new Topic("خطاب أو ما يثبت التأمينات", "وجود إثبات تأميني لصاحب النشاط والعاملين يقلل التعارض عند مرحلة إصدار الترخيص، خصوصًا إذا كان النشاط قائمًا أو سيعمل بعمالة ثابتة.")}
						pTopic3={new Topic("الشهادات الصحية", "تظهر أهميتها في المحلات التي تقدم أو تحضر أو تتداول الأغذية والمشروبات، ولا يصح اعتبارها مستندًا خاصًا بالمطاعم فقط إذا كان النشاط الغذائي قائمًا بأي صورة.")}
					/>

				</VrStack>

				<RespImg
					pImg={new EmoMediaData("Img", "https://images.akhbarelyom.com/UP/", "20221211102524498.jpg", false, "نموذج طلب استصدار رخصة محل", new Size(420, "auto", 300, "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.OrangeLite};`}
			pTitle="أخطاء تؤخر قبول مستندات الترخيص"
			pDesc="القائمة الصحيحة لا تكفي إذا كانت النسخ غير واضحة أو البيانات غير متطابقة أو النشاط مكتوبًا بأكثر من صيغة بين المستندات"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1180px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("اختلاف عنوان المحل", "اختلاف رقم العقار أو اسم الشارع بين العقد والبطاقة الضريبية والرسم وشهادة القيمة الإيجارية يخلق شكًا إداريًا في العين المطلوب ترخيصها.")}
				pTopic2={new Topic("نشاط غير محدد", "عبارات عامة مثل تجارة عامة قد لا تكفي لنشاط له اشتراطات خاصة، لذلك يجب أن يكون النشاط واضحًا بما يسمح بمراجعته فنيًا وصحيًا وأمنيًا إذا لزم.")}
				pTopic3={new Topic("رسم لا يمثل الحالة الفعلية", "لو الرسم الهندسي أو الكروكي لا يطابق المحل عند المعاينة، فإن المستند يتحول من عنصر دعم إلى سبب استيفاء جديد.")}
				pTopic4={new Topic("تقديم صور بلا أصول", "كثير من الجهات تطلب الاطلاع على الأصل مع تقديم الصورة، لذلك يجب تجهيز الأصول قبل الذهاب حتى لا يتوقف الملف رغم وجود الصور.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="ما الذي نراجعه لك قبل التقديم؟"
			pDesc="الخدمة ليست تجميع صور فقط، بل مراجعة منطق الملف قبل دخوله إلى الجهة الإدارية"
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pAlign={Align.Center}>

			<VrStack pWidth={new Pixel(1050, 340)} pGap={new Pixel(22, 14)}>

				<CardsGr
					pWidth={new RespString("1050px", "100%")}
					pCardBg={new ElemBg(Colors.Gray1)}
					pCardTitleFnt={Text.H4}
					pCardBodyFnt={Text.Body}
					pTopic1={new Topic("مطابقة البيانات", "مراجعة الاسم، العنوان، النشاط، صفة مقدم الطلب، وبيانات العين بين المستندات المختلفة قبل تقديم الملف.")}
					pTopic2={new Topic("تحديد النواقص", "فرز المستندات المتاحة وتحديد ما يجب استخراجه قبل التوجه إلى المركز المختص حتى لا تضيع زيارة كاملة بسبب ورقة واضحة النقص.")}
					pTopic3={new Topic("ربط المستندات بالرسم", "التأكد من أن الرسم أو الكروكي يخدم ملف الترخيص ولا يتعارض مع وصف المحل ومساحته ومدخله وطبيعة النشاط.")}
				/>

				<EmoCall BlackSky pText="اتصل لمراجعة الملف" />

			</VrStack>

		</EmoStrip>

	</ESec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل تختلف مستندات ترخيص المحل من نشاط إلى آخر؟"
			pAnswer="نعم. هناك مستندات أساسية مشتركة، لكن الأنشطة الغذائية والترفيهية والأنشطة التي تحتاج موافقات خاصة قد تضيف شهادات صحية أو صحيفة حالة جنائية أو مستندات فنية أو موافقات أخرى بحسب طبيعة النشاط والجهة المختصة."
		/>

		<FaqItem
			pQuestion="هل يكفي عقد الإيجار لاستخراج الترخيص؟"
			pAnswer="عقد الإيجار أو الملكية يثبت شغل العين، لكنه لا يكفي وحده. يجب استكمال بيانات صاحب الترخيص والنشاط والضرائب والسجل والتأمينات والرسم أو الكروكي وأي مستندات خاصة بالحالة."
		/>

		<FaqItem
			pQuestion="هل يجب تقديم أصول المستندات؟"
			pAnswer="غالبًا تقدم الصور مع الاطلاع على الأصول في المستندات الرئيسية، لذلك يجب تجهيز الأصل والصورة معًا، خصوصًا بطاقة الرقم القومي وعقد الإيجار أو الملكية والبطاقة الضريبية والسجل التجاري."
		/>

		<FaqItem
			pQuestion="متى أحتاج تقريرًا هندسيًا؟"
			pAnswer="قد تظهر الحاجة إلى تقرير هندسي إذا كان موقف العقار أو رخصة البناء غير واضح، أو إذا طلبت الجهة المختصة إثبات السلامة الإنشائية أو توافق حالة المحل مع الاشتراطات الفنية."
		/>

	</EmoFaq>







	<ReadAlso
		pTitle={Text.H2.Centered.OfText("اقرأ أيضا ...")}
		pHeadBg={new ElemBg(Colors.SkyLite)}
		pBodyBg={new ElemBg(Colors.WhiteOff)}
		pCardBg={new ElemBg(Colors.Gray1)}
	>

		<ReadAlsoItem
			pTitle="ترخيص محل تجاري"
			pDesc="الصفحة الأساسية لخدمة استخراج ترخيص المحل التجاري، وتشمل الصورة العامة للخدمة ومسار التعامل مع ملف الترخيص من البداية حتى الإصدار."
			pHref="/emoperm/retail/general"
		/>

		<ReadAlsoItem
			pTitle="إجراءات ترخيص محل تجاري"
			pDesc="بعد تجهيز مستندات الترخيص، تبدأ مرحلة تقديم الطلب والمراجعة والمعاينة واستيفاء الاشتراطات المطلوبة."
			pHref="/emoperm/retail/general/proc"
		/>

		<ReadAlsoItem
			pTitle="الرسم الهندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لملف ترخيص المحل التجاري بعد معاينة المحل ورفع الأبعاد وتجهيز بيانات المساحة والتوزيع الداخلي."
			pHref="/emoperm/retail/general/dwg"
		/>

	</ReadAlso>







	<RelServices
		pTitle={Text.H2.Centered.White.OfText("خدماتنا")}
		pHeadBg={new ElemBg(Colors.Gray5)}
		pBodyBg={new ElemBg(Colors.Gray1)}
		pCardBg={new ElemBg(Colors.WhiteOff)}
	>

		<RelServiceItem
			pTitle="استخراج ترخيص محل تجاري"
			pDesc="مباشرة إجراءات استخراج رخصة المحل التجاري كوكيل عن العميل، مع مراجعة المستندات وتجهيز الملف ومتابعة الطلب حسب نطاق الخدمة المتاح."
			pHref="/emoperm/retail/general"
			pBtnText="معرفة المزيد"
		/>

		<RelServiceItem
			pTitle="رسم هندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لترخيص المحل التجاري، ويتم عمل معاينة للمحل لرفع الأبعاد وجمع المعلومات المطلوبة لإعداد الرسم الهندسي."
			pHref="/emoperm/retail/general/dwg"
			pBtnText="معرفة المزيد"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تصميم وتنفيذ تشطيبات المحلات التجارية بما يناسب طبيعة النشاط والميزانية المقترحة ونطاق التنفيذ المتاح."
			pHref="/emocrete/finishing/retail"
			pBtnText="معرفة المزيد"
		/>

	</RelServices>







</BLayout>
