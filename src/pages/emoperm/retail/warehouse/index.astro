---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, ZigzagItem, ZigzagStory } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="ترخيص مخزن تجاري"
	pDescr="ترخيص مخزن تجاري — خدمة هندسية لتنظيم ملف الترخيص ومراجعة اشتراطات المكان والرسومات والمستندات المطلوبة قبل التقديم، مع تحديد النواقص ومسار المتابعة. وفي هذه الصفحة يكون التركيز الخاص على حركة العملاء والواجهة وقابلية التقسيم والتشغيل. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="ترخيص مخزن تجاري">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("ترخيص مخزن تجاري")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("خدمة هندسية لتنظيم ملف الترخيص ومراجعة اشتراطات المكان والرسومات والمستندات المطلوبة قبل التقديم، مع تحديد النواقص ومسار المتابعة. وفي هذه الصفحة يكون التركيز الخاص على حركة العملاء والواجهة وقابلية التقسيم والتشغيل.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<ZigzagStory pBg={Colors.Gray1} pGap={new RespString("36px","18px")} pPad={new RespString("44px","12px")} pAlternate={true}>
		<ZigzagItem pMediaShare={38} pBg={Colors.WhiteOff} pColor={Colors.Black} pMediaBg={Colors.BrownDark} pClip="Diagonal" pClipP="None">
			<Emograph slot="media" pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("فحص")} pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("فحص النشاط والمكان والمستندات المتاحة مع مراعاة حركة العملاء والواجهة وقابلية التقسيم والتشغيل")} />
			<VrStack pGap={new Pixel(12,8)} pPad={new Pixel(26,16)}>
				<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("القرار يبدأ من الواقع")} pText={Text.Body.WithColor(Colors.Black).OfText("تقلل احتمالات رفض الملف أو تكرار الزيارات بسبب نقص مستند أو تعارض بين الواقع والرسم أو النشاط المطلوب. ويُراجع القرار هنا تحديدًا في ضوء حركة العملاء والواجهة وقابلية التقسيم والتشغيل.")} />
			</VrStack>
		</ZigzagItem>
		<ZigzagItem pMediaShare={42} pBg={Colors.Creamy} pColor={Colors.Black} pMediaBg={Colors.BistageLite} pClip="Arch" pClipP="None">
			<Emograph slot="media" pTitle={Text.H2.Centered.WithColor(Colors.Black).OfText("مخرج")} pText={Text.Body.Centered.WithColor(Colors.Black).OfText("ترتيب ملف التقديم والمتابعة في حدود النطاق المتفق عليه")} />
			<VrStack pGap={new Pixel(12,8)} pPad={new Pixel(26,16)}>
				<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("التجهيز")} pText={Text.Body.WithColor(Colors.Black).OfText("تجهيز أو مراجعة الرسومات والنماذج الفنية، ثم مراجعة الناتج قبل التسليم.")} />
			</VrStack>
		</ZigzagItem>
	</ZigzagStory>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 5,000 ج.م أتعاب خدمة؛ الرسوم الحكومية والاعتمادات الخارجية منفصلة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
