---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="CollectionPage" pTitle="تقارير هندسية" pDescr="تقارير هندسية">







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","10%"))} pHzAlign={"Center"}>

			<Emograph pTitle={Text.H1.Centered.OfText("تقارير هندسية")} pText={Text.Body.Centered.OfText("تقارير هندسية")} />

			<EmoCall OrangeBlack />

		</VrStack>

	</Hero>







</BLayout>
