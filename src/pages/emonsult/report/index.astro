---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, ListItem, SecTitle, VrStack } from "@/Widgets/Comp";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { BadgeFrame } from "@/Widgets/Shapes";
import { ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="تقارير هندسية"
	pDescr="تقارير هندسية للمباني والمنشآت تشمل السلامة الإنشائية، تقارير التربة والجسات، المعاينات الفنية، وتقارير الحماية المدنية والحريق."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","10%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تقارير هندسية")}
				pText={Text.Body.Centered.OfText("تقارير هندسية للمباني والمنشآت تشمل السلامة الإنشائية، تقارير التربة والجسات، المعاينات الفنية، وتقارير الحماية المدنية والحريق.")}
			/>

			<EmoCall OrangeBlack />

		</VrStack>

	</Hero>







	<EmoSec
		id="construction-soil-reports"
		pBg={new ElemBg("#F3F0E9")}
		pPad={new Pixel(82, 58)}
		pGap={new Pixel(48, 34)}
		Readable
	>

		<SecTitle
			style = " --StripBg : transparent ; width : min(900px,94%) "
			pTitle="تقارير التراخيص الإنشائية والتربة"
			pDesc="تُطلب هذه التقارير بحسب نوع الإجراء: قبل البناء، أو عند تقييم منشأ قائم، أو عند استكمال إجراءات الترخيص وتقنين الأوضاع."
		/>

		<DivStr pBox={new Size(new NumPer("min(1180px,94%)", "94%"))} pGap={new Pixel(24, 30)} pVrAlign="Stretch">

			<DivCol pPad={new Pixel(0)} pHzAlign="Stretch" pVrAlign="Stretch">

				<BadgeFrame
					style = "
							height : 100% ;
							border : 1px solid #D9D6CE ;
							border-radius : 12px ;
							box-shadow : 0 12px 30px rgba(25,35,42,.07)
						"
					pBadge="إنشائي"
					pBg="#FFFFFF"
					pBadgeBg="#325E73"
					pColor="#18232A"
					pVrAlign="Start"
				>

					<Emograph
						pTitle={Text.H3.AtRight.WithColor("#18232A").OfSize(26, 21).OfText("تقرير فني عن السلامة الإنشائية")}
						pText={Text.Body.AtRight.WithColor("#4B575C").OfSize(17, 15).OfText("يُستخدم ضمن متطلبات قانون التصالح وقانون البناء، وكذلك في حالات تراخيص المحلات داخل المباني المنشأة قبل صدور قانون البناء الموحد أو المباني غير المرخصة. ويصدر من مهندس نقابي أو استشاري لتقييم الحالة الإنشائية للمبنى ومدى قدرته على تحمل الأحمال.")}
					/>

				</BadgeFrame>

			</DivCol>

			<DivCol pPad={new Pixel(0)} pHzAlign="Stretch" pVrAlign="Stretch">

				<BadgeFrame
					style = "
							height : 100% ;
							border : 1px solid #D9D6CE ;
							border-radius : 12px ;
							box-shadow : 0 12px 30px rgba(25,35,42,.07)
						"
					pBadge="تربة وأساسات"
					pBg="#FFFFFF"
					pBadgeBg="#9A7545"
					pColor="#18232A"
					pVrAlign="Start"
				>

					<Emograph
						pTitle={Text.H3.AtRight.WithColor("#18232A").OfSize(26, 21).OfText("تقرير التربة – فحص التربة والجسات")}
						pText={Text.Body.AtRight.WithColor("#4B575C").OfSize(17, 15).OfText("تقرير معتمد من استشاري ميكانيكا تربة وأساسات، يوضح نتائج فحص التربة والجسات والتوصيات اللازمة للأساسات. ويُطلب ضمن متطلبات التصميم والترخيص وفق الكود المصري، ومن بينها متطلبات بعض المصانع والمنشآت الصناعية.")}
					/>

				</BadgeFrame>

			</DivCol>

			<DivCol pPad={new Pixel(0)} pHzAlign="Stretch" pVrAlign="Stretch">

				<BadgeFrame
					style = "
							height : 100% ;
							border : 1px solid #D9D6CE ;
							border-radius : 12px ;
							box-shadow : 0 12px 30px rgba(25,35,42,.07)
						"
					pBadge="معاينة"
					pBg="#FFFFFF"
					pBadgeBg="#577360"
					pColor="#18232A"
					pVrAlign="Start"
				>

					<Emograph
						pTitle={Text.H3.AtRight.WithColor("#18232A").OfSize(26, 21).OfText("تقرير المعاينة الفنية")}
						pText={Text.Body.AtRight.WithColor("#4B575C").OfSize(17, 15).OfText("يصدره المهندس الاستشاري بعد معاينة منشأ قائم لإبداء الرأي الفني في حالته الهندسية، وتوصيف الأضرار أو الشروخ إن وجدت، مع بيان طرق العلاج أو التدعيم المناسبة عند الحاجة.")}
					/>

				</BadgeFrame>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec
		id="fire-safety-reports"
		pBg={new ElemBg("#12262F")}
		pPad={new Pixel(82, 58)}
		pGap={new Pixel(44, 34)}
		Readable
	>

		<SecTitle
			style = " --StripBg : transparent ; width : min(900px,94%) "
			pTitle="تقارير الأمن والسلامة – الحماية المدنية"
			pDesc="تقارير مرتبطة بمتطلبات الحماية المدنية وتراخيص التشغيل للمنشآت التي تستلزم مراجعة أنظمة الوقاية من أخطار الحريق."
			cBlackWhiteOff
		/>

		<BadgeFrame
			style = "
					width : min(920px,94%) ;
					border : 1px solid #E2D6C7 ;
					border-inline-start : 8px solid #C75B33 ;
					border-radius : 12px ;
					box-shadow : 0 20px 48px rgba(0,0,0,.20)
				"
			pBadge="حماية مدنية"
			pBg="#FBFAF6"
			pBadgeBg="#C75B33"
			pColor="#18232A"
			pHzAlign="Stretch"
			pVrAlign="Start"
		>

			<Emograph
				pTitle={Text.H3.AtRight.WithColor("#18232A").OfSize(28, 22).OfText("تقرير استشاري هندسي – تخصص حريق")}
				pText={Text.Body.AtRight.WithColor("#4B575C").OfSize(18, 15).OfText("تقرير هندسي يوضح متطلبات الوقاية من الحريق بالمشروع، ويُستخدم ضمن مستندات العرض على الحماية المدنية بحسب نوع المنشأة ومتطلبات الترخيص.")}
			/>

			<EmoList
				style = " margin-top : 18px ; padding-top : 18px ; border-top : 1px solid #DED7CC "
				pWidth={new RespString("100%", "100%")}
				pItemFnt={Text.Body.AtRight.WithColor("#36444A").OfSize(17, 15)}
				pHeadBg={new ElemBg("transparent")}
				pItemsBg={new ElemBg("transparent")}
				pNumbered={false}
			>

				<ListItem pText="تحديد مصادر الخطورة بالمشروع." />

				<ListItem pText="مراجعة أنظمة الإطفاء والإنذار المطلوبة." />

				<ListItem pText="مراجعة توافق الحلول المقترحة مع الكود المصري لوقاية المنشآت من أخطار الحريق." />

			</EmoList>

		</BadgeFrame>

	</EmoSec>







</BLayout>
