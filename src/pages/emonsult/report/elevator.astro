---
import BLayout from "@/Layout.astro";
import { EmoCall, EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, ListItem, SecTitle, VrStack } from "@/Widgets/Comp";
import { PdfPreview } from "@/Widgets/Media";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تقرير هندسي لترخيص مصعد"
	pDescr="تقرير هندسي استشاري لترخيص تركيب أو تشغيل مصعد في نطاق محافظتي القاهرة والجيزة، مع إمكانية اعتماد التقرير من مهندس استشاري فقط أو من مهندس استشاري ونقابة المهندسين."
>







	<Hero pImgAlt="ساكن يطلب مصعد تم عمل تقرير سلامة انشائية وسلامة تشغيل له">

		<VrStack pSize={new Size(new NumPer("35%","95%"))} pLoc={new Loc(new NumPer("65%","2.5%"),new NumPer("5%","10%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تقرير استشاري هندسي لترخيص مصعد")}
				pText={Text.Body.Centered.OfText("تقرير هندسي استشاري لترخيص تركيب أو تشغيل مصعد في نطاق محافظتي القاهرة والجيزة، مع إمكانية اعتماد التقرير من مهندس استشاري فقط أو من مهندس استشاري ونقابة المهندسين.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec id="secDetails">

		<SecTitle id="sectDetails" Sky pTitle="التقارير الهندسية المطلوبة لترخيص المصعد" />

		<DivStr id="strInstall" pBg={new ElemBg(Colors.Gray1)}>

			<DivCol id="colInstallInfo" pSize={new Size(new NumPer("20%","100%"))}>

				<Emograph
					pTitle={Text.H3.Centered.OfText("أولا: تقرير استشاري هندسي لترخيص تركيب مصعد")}
					pText={Text.Body.Centered.OfText("تقرير استشاري هندسي يتم إعداده من مهندس استشاري إنشائي معتمد يفيد بمعاينة وسلامة حالة المبنى وقدرته على تحمل تركيب مصعد وتحمل الأوزان الإضافية والاهتزازات الميكانيكية الناتجة عنه بدون حدوث عيوب بالمبنى تشكل خطورة على الأرواح والممتلكات.")}
				/>

				<Emograph
					pTitle={Text.H4.DarkSky.Centered.OfText("استخدامات التقرير الهندسي المطلوب لترخيص تركيب مصعد")}
					pText={Text.Body.Centered.OfText("يقدم ضمن المستندات المطلوبة من قبل الجهة الإدارية المعنية، مثل رئاسة الحي أو جهاز المدينة، لترخيص تركيب مصعد جديد لأول مرة.")}
				/>

			</DivCol>

			<DivCol pHzAlign={"Center"}>

				<DivStr id="strInstallCost" pHzAlign={"Center"}>

					<Emograph pTitle={Text.H4.Centered.OfText("تكلفة أتعاب اعتماد تقرير تركيب مصعد")} />

					<DivCol id="colInstallCostEngOnly">

						<Emograph pTitle={Text.H5.Centered.OfText("تقرير تركيب مصعد معتمد من مهندس استشاري إنشائي فقط")} />

						<Emograph pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 3000 جنيه")} />

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pWidth={new RespString("100%","100%")}
						>

							<ListItem pText="نسخة من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري." />

							<ListItem pText="نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي." />

						</EmoList>

					</DivCol>

					<DivCol id="colInstallCostEng">

						<Emograph pTitle={Text.H5.Centered.OfText("تقرير تركيب مصعد معتمد من مهندس استشاري إنشائي ونقابة المهندسين")} />

						<Emograph
							pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 4000 جنيه")}
							pText={Text.Body.Centered.Red.OfText("لا يشمل الرسوم المدفوعة لختم نقابة المهندسين، ويتم تقديرها لكل حالة طبقًا لبيانات رخصة البناء.")}
						/>

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pWidth={new RespString("100%","100%")}
						>

							<ListItem
								pText="نسخة مغلفة بالعلامة المائية من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري وختم نقابة المهندسين."
							/>

							<ListItem pText="نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي." />

						</EmoList>

					</DivCol>

					<HzStack pGap={new Pixel(30,10)} pHzAlign={"Center"}>

						<EmoCallIcon BlackSky pText="اتصل لطلب الخدمة" />

						<EmoWhatsIcon BlackSky pText="اطلب عبر واتساب" pMessage="أرغب في عمل تقرير تركيب مصعد" />

					</HzStack>

				</DivStr>

			</DivCol>

			<DivCol id="colInstallSample" pSize={new Size(new NumPer("20%","100%"))}>

				<Emograph pTitle={Text.H4.Centered.OfText("نموذج تقرير تركيب مصعد")} pText={Text.Body.Centered.OfText("( إنشائي )")} />

				<PdfPreview pFile="/Media/Emonsult/Report/Elevator/Elevator_Structural_Installing_Report.pdf" />

			</DivCol>

		</DivStr>

		<DivStr id="strRun" pBg={new ElemBg(Colors.Gray2)}>

			<DivCol id="colRunInfo">

				<Emograph
					pTitle={Text.H3.Centered.OfText("ثانيا: تقرير استشاري هندسي لترخيص تشغيل مصعد")}
					pText={Text.Body.Centered.OfText("تقرير استشاري هندسي يتم إعداده من مهندس استشاري ميكانيكا معتمد يفيد بمعاينة وسلامة حالة المصعد وسلامة وصحة التركيب وكفاءة الأجزاء الميكانيكية الفعالة ومطابقتها للمواصفات الفنية المعتمدة في تركيب وتشغيل المصاعد سواء من ناحية جودة الخامات أو سلامة التركيبات والصلاحية للتشغيل.")}
				/>

				<Emograph
					pTitle={Text.H4.Centered.DarkSky.OfText("استخدامات التقرير الهندسي المطلوب لترخيص تشغيل مصعد ؟")}
					pText={Text.Body.Centered.OfText("يقدم ضمن المستندات المطلوبة من قبل الجهة الإدارية المعنية، مثل رئاسة الحي أو جهاز المدينة، لترخيص تشغيل مصعد جديد لأول مرة.")}
				/>

				<DivStr id="strRunCost">

					<Emograph pTitle={Text.H4.Centered.OfText("تكلفة أتعاب اعتماد تقرير تشغيل مصعد")} />

					<DivCol id="colRunCostEngOnly">

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير معتمد من مهندس استشاري ميكانيكا فقط")} />

						<Emograph pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 4000 جنيه")} />

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pWidth={new RespString("100%","100%")}
						>

							<ListItem pText="نسخة من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري." />

							<ListItem pText="نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي." />

						</EmoList>

					</DivCol>

					<DivCol id="colRunCostEng">

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير معتمد من مهندس استشاري ميكانيكا ونقابة المهندسين")} />

						<Emograph
							pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 6000 جنيه")}
							pText={Text.Body.Centered.Red.OfText("لا يشمل الرسوم المدفوعة لختم نقابة المهندسين، ويتم تقديرها لكل حالة طبقًا لبياناتها.")}
						/>

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pWidth={new RespString("100%","100%")}
						>

							<ListItem
								pText="نسخة مغلفة بالعلامة المائية من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري وختم نقابة المهندسين."
							/>

							<ListItem pText="نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي." />

						</EmoList>

					</DivCol>

					<EmoCall id="btnRunCall" BlackSky pText="للطلب والاستفسار" />

				</DivStr>

			</DivCol>

			<DivCol id="colRunSample">

				<Emograph pTitle={Text.H4.Centered.OfText("نماذج تقرير تشغيل مصعد").WithColor("#302c3c")} pText={Text.Body.Centered.OfText("( ميكانيكا )")} />

				<PdfPreview pFile="/Media/Emonsult/Report/Elevator/Elevator_Mechanical_Operating_Report.pdf" />

			</DivCol>

		</DivStr>

	</EmoSec>







</BLayout>
