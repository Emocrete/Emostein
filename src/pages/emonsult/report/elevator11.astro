---
import BLayout from "@/Layout.astro";
import { EmoBtn, EmoCall, Emograph, EmoList, HzStack, VrStack } from "@/Widgets/Comp";
import { EmoSec } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Colors, ElemBg, Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تقرير هندسي لترخيص مصعد"
	pDescr="تقرير هندسي استشاري لترخيص تركيب أو تشغيل مصعد في نطاق محافظتي القاهرة والجيزة، مع إمكانية اعتماد التقرير من مهندس استشاري فقط أو من مهندس استشاري ونقابة المهندسين."
>







	<EmoSec data-hero pImgAlt="ساكن يطلب مصعد تم عمل تقرير سلامة انشائية وسلامة تشغيل له">

		<VrStack pSize={new Size(new NumPer("35%","95%"))} pLoc={new Loc(new NumPer("65%","2.5%"),new NumPer("5%","10%"))}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تقرير استشاري هندسي لترخيص مصعد")}
				pText={Text.Body.Centered.OfText("تقرير هندسي استشاري لترخيص تركيب أو تشغيل مصعد في نطاق محافظتي القاهرة والجيزة، مع إمكانية اعتماد التقرير من مهندس استشاري فقط أو من مهندس استشاري ونقابة المهندسين.")}
			/>

			<EmoCall BlackSky pText="للطلب والاستفسار" />

		</VrStack>

	</EmoSec>







	<EmoSec id="secDetails">

		<EmoStr pBg={new ElemBg(Colors.Sky)}>

			<Emograph pTitle={Text.H2.Centered.OfText("تفاصيل التقارير الهندسية المطلوبة لترخيص المصعد")} />

		</EmoStr>

		<EmoStr>

			<HzStack>

				<VrStack>

					<Emograph
						pTitle={Text.H3.Centered.OfText("ما هو التقرير الهندسي المطلوب لترخيص تركيب مصعد ؟")}
						pText={Text.Body.Centered.OfText("تقرير استشاري هندسي يتم إعداده من مهندس استشاري إنشائي معتمد يفيد بمعاينة وسلامة حالة المبنى وقدرته على تحمل تركيب مصعد وتحمل الأوزان الإضافية والاهتزازات الميكانيكية الناتجة عنه بدون حدوث عيوب بالمبنى تشكل خطورة على الأرواح والممتلكات.")}
					/>

					<Emograph
						pTitle={Text.H3.DarkSky.Centered.OfText("استخدامات التقرير الهندسي المطلوب لترخيص تركيب مصعد ؟")}
						pText={Text.Body.Centered.OfText("هو أحد المستندات المطلوبة من قبل الجهة الإدارية المعنية، مثل رئاسة الحي أو جهاز المدينة، لترخيص تركيب مصعد جديد لأول مرة.")}
					/>

					<Emograph pTitle={Text.H3.Centered.OfText("نماذج تقرير تركيب مصعد")} pText={Text.Body.Centered.OfText("( إنشائي )")} />

					<EmoBtn
						pText="تحميل"
						pWidth="150px"
						pHeight="42px"
						pRadius="0"
						pBgColor="#164363"
						pBgColorHover="#328fe8"
						pTextColor="#ffffff"
						pFontSize="17px"
					/>

				</VrStack>

				<VrStack>

					<Emograph
						pTitle={Text.H3.Centered.OfText("ما هو التقرير الهندسي المطلوب لترخيص تشغيل مصعد ؟")}
						pText={Text.Body.Centered.OfText("تقرير استشاري هندسي يتم إعداده من مهندس استشاري ميكانيكا معتمد يفيد بمعاينة وسلامة حالة المصعد وسلامة وصحة التركيب وكفاءة الأجزاء الميكانيكية الفعالة ومطابقتها للمواصفات الفنية المعتمدة في تركيب وتشغيل المصاعد سواء من ناحية جودة الخامات أو سلامة التركيبات والصلاحية للتشغيل.")}
					/>

					<Emograph
						pTitle={Text.H3.Centered.DarkSky.OfText("استخدامات التقرير الهندسي المطلوب لترخيص تشغيل مصعد ؟")}
						pText={Text.Body.Centered.OfText("هو أحد المستندات المطلوبة من قبل الجهة الإدارية المعنية، مثل رئاسة الحي أو جهاز المدينة، لترخيص تشغيل مصعد جديد لأول مرة.")}
					/>

					<Emograph
						pTitle={Text.H3.Centered.OfText("نماذج تقرير تشغيل مصعد").WithColor("#302c3c")}
						pText={Text.Body.Centered.OfText("( ميكانيكا )")}
					/>

					<EmoBtn
						pText="تحميل"
						pWidth="150px"
						pHeight="42px"
						pRadius="0"
						pBgColor="#164363"
						pBgColorHover="#328fe8"
						pTextColor="#ffffff"
						pFontSize="17px"
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec id="secInstallingCost">

		<EmoStr pBg={new ElemBg(Colors.Sky)}>

			<Emograph pTitle={Text.H2.Centered.OfText("تكلفة أتعاب اعتماد تقرير تركيب مصعد")} />

		</EmoStr>

		<EmoStr>

			<VrStack pSize={new Size(new NumPer("100%"))}>

				<HzStack>

					<VrStack>

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير تركيب مصعد معتمد من مهندس استشاري إنشائي فقط")} />

						<Emograph pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 3000 جنيه")} />

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pItems={[
									"نسخة من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري.",
									"نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي."
								]}
						/>

					</VrStack>

					<VrStack>

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير تركيب مصعد معتمد من مهندس استشاري إنشائي ونقابة المهندسين")} />

						<Emograph
							pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 4000 جنيه")}
							pText={Text.Body.Centered.Red.OfText("لا يشمل الرسوم المدفوعة لختم نقابة المهندسين، ويتم تقديرها لكل حالة طبقًا لبيانات رخصة البناء.")}
						/>

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pItems={[
							"نسخة مغلفة بالعلامة المائية من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري وختم نقابة المهندسين.",
							"نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي."
						]}
						/>

					</VrStack>

				</HzStack>

				<EmoCall BlackSky pText="للطلب والاستفسار" />

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec id="secOperationCost">

		<EmoStr pBg={new ElemBg(Colors.Sky)}>

			<Emograph pTitle={Text.H2.Centered.OfText("تكلفة أتعاب اعتماد تقرير تشغيل مصعد")} />

		</EmoStr>

		<EmoStr>

			<VrStack pSize={new Size(new NumPer("100%"))}>

				<HzStack>

					<VrStack>

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير معتمد من مهندس استشاري ميكانيكا فقط")} />

						<Emograph pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 4000 جنيه")} />

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pItems={[
								"نسخة من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري.",
								"نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي."
							]}
						/>

					</VrStack>

					<VrStack>

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير معتمد من مهندس استشاري ميكانيكا ونقابة المهندسين")} />

						<Emograph
							pTitle={Text.Body.Bold.DarkSky.OfSize(40,25).Centered.OfText("يبدأ من 6000 جنيه")}
							pText={Text.Body.Centered.Red.OfText("لا يشمل الرسوم المدفوعة لختم نقابة المهندسين، ويتم تقديرها لكل حالة طبقًا لبياناتها.")}
						/>

						<EmoList
							pTitle={Text.Body.OfText("يتم تسليم الآتي :")}
							pNumbered={false}
							pItemFnt={Text.Body}
							pItems={[
								"نسخة مغلفة بالعلامة المائية من التقرير الذي تم إعداده طبقاً للبيانات المقدمة من العميل عن المبنى والمصعد الذي سيتم ترخيصه معتمدة بختم المهندس الاستشاري وختم نقابة المهندسين.",
								"نسخة مصورة من مستندات المهندس الاستشاري الذي اعتمد التقرير بختمه وهي الشهادة الاستشارية، كارنيه النقابة، والسجل الهندسي."
							]}
						/>

					</VrStack>

				</HzStack>

				<EmoCall BlackSky pText="للطلب والاستفسار" />

			</VrStack>

		</EmoStr>

	</EmoSec>







</BLayout>
