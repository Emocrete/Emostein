---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoLine, SecTitle, TotalGraph, VrStack } from "@/Widgets/Comp";
import { ShadowImg } from "@/Widgets/Media";
import { PriceCard1 } from "@/Widgets/Prices";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="تقرير السلامة الإنشائية من مهندس نقابي"
	pDescr="استخراج تقرير هندسي استشاري عن حالة وسلامة المبنى في القاهرة والجيزة، مع إمكانية اعتماد التقرير من مهندس استشاري فقط أو من مهندس استشاري ونقابة المهندسين."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","98%"))} pLoc={new Loc(new NumPer("5%","1%"),new NumPer("15%","8%"))} pHzAlign={"Center"}>

			<TotalGraph>

				<Emograph pTitle={Text.H1.Centered.White.OfText("تقرير سلامة إنشائية")} />

				<EmoLine />

				<Emograph pTitle={Text.H1.Centered.White.OfText("من مهندس استشاري إنشائي")} />

			</TotalGraph>

			<Emograph
				pText={Text.Body.Centered.White.OfText("استخراج تقرير هندسي استشاري عن حالة وسلامة المبنى مع إمكانية اعتماد التقرير من مهندس استشاري فقط أو من مهندس استشاري ونقابة المهندسين.")}
			/>

			<EmoCall OrangeBlack />

		</VrStack>

	</Hero>







	<EmoSec>

		<SecTitle SkyLite pTitle="تكلفة تقرير سلامة مبنى" />

		<DivStr>

			<DivCol>

				<VrStack pHzAlign={"Center"}>

					<PriceCard1 pCaption={Text.H3.Centered.OfSize(18,16).OfText("تقرير معتمد من مهندس استشاري فقط")} pPrice="3000" pPriceFnt={Text.Body.Bold.OfSize(70,50)} />

					<PriceCard1
						pCaption={Text.H3.Centered.OfSize(18,16).OfText("تقرير معتمد من مهندس استشاري ونقابة المهندسين")}
						pPrice="4000"
						pPriceFnt={Text.Body.Bold.OfSize(70,50)}
					/>

					<EmoCall BlackBistage />

				</VrStack>

			</DivCol>

			<DivCol>

				<ShadowImg pImg="/Media/Emonsult/Report/Safety/Safety_Report_Sample.webp" />

				<EmoCall BlackBistage />

			</DivCol>

		</DivStr>

	</EmoSec>







</BLayout>
