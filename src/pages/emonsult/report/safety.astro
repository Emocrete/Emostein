---
import { BottTriSep, EmoBtn, EmoContactStrip, Emograph, EmoList, ESec, Hero, HzStack, IncLineSep, RespImg, VrStack } from "@/Widgets";
import { Align, ElemBg, Pixel, RespString, Size, Text } from "@/TypesLib";
import BLayout from "@/Layout.astro";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تقرير هندسي لحالة وسلامة المبنى"
	pDescr="استخراج تقرير هندسي استشاري عن حالة وسلامة المبنى في القاهرة والجيزة، مع إمكانية اعتماد التقرير من مهندس استشاري فقط أو من مهندس استشاري ونقابة المهندسين."
>







	<Hero
		pTitle="تقرير هندسي لحالة وسلامة المبنى"
		pDesc="مهندس استشاري إنشائي معتمد"
		pTitleClr="#ffffff"
		pDescClr="#bdf9e7"
		pHzAlign="center"
		pVrAlign="center"
		pPosL="25% 45% 45% 10%"
		pPosP="15% 3% 50% 3%"
		pBlurL="on"
		pBlurP="on"
	>

		<VrStack>

			<Emograph pTitle={Text.Body.Centered.Red.OfText("في نطاق محافظتي القاهرة والجيزة فقط")} />

		</VrStack>

	</Hero>







	<ESec>

		<HzStack id="stkAll">

			<VrStack id="stkMain" pWidth={new Pixel(1200)}>

				<Emograph pTitle={Text.H2.Centered.OfText("تكلفة تقرير سلامة مبنى")} />

				<HzStack id="stkOffers">

					<VrStack id="stkOffer1">

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير معتمد من مهندس استشاري فقط")} />

						<Emograph pTitle={Text.Body.Centered.OfText("يبدأ من 2000 جنيه")} />

					</VrStack>

					<VrStack id="stkOffer2">

						<Emograph pTitle={Text.H3.Centered.OfText("تقرير معتمد من مهندس استشاري ونقابة المهندسين")} />

						<Emograph pTitle={Text.Body.Centered.OfText("يبدأ من 3000 جنيه")} />

					</VrStack>

				</HzStack>

				<EmoBtn
					style = " transform : rotate(-8deg) ; box-shadow : 0 10px 18px rgba(0,0,0,.24) "
					id="requestSafetyReport"
					pText="للطلب والاستفسار ☎"
					pWidth="260px"
					pHeight="58px"
					pRadius="0"
					pBgColor="#33283f"
					pBgColorHover="#328fe8"
					pTextColor="#ffffff"
					pFontSize="24px"
					onclick="location.href='tel:01014490054'"
				/>

			</VrStack>

			<VrStack id="stkSample" pWidth={new Pixel(300)}>

				<RespImg />

				<EmoBtn
					pText="تحميل"
					pWidth="150px"
					pHeight="44px"
					pRadius="0"
					pBgColor="#164363"
					pBgColorHover="#328fe8"
					pTextColor="#ffffff"
					pFontSize="18px"
				/>

			</VrStack>

		</HzStack>

	</ESec>







</BLayout>
