---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, StickyStory, StickyStoryItem } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="تقرير هندسي عن الهبوط"
	pDescr="تقرير هندسي عن الهبوط — معاينة وتحليل هندسي للحالة المطلوبة ثم توثيق المشاهدات والاستنتاجات والتوصيات في تقرير منظم يصلح لاتخاذ قرار فني أو استكمال إجراء. وفي هذه الصفحة يكون التركيز الخاص على الهبوط التفاضلي وحركة المبنى والأرض والأساسات ومؤشرات الاستمرار. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="تقرير هندسي عن الهبوط">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("تقرير هندسي عن الهبوط")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("معاينة وتحليل هندسي للحالة المطلوبة ثم توثيق المشاهدات والاستنتاجات والتوصيات في تقرير منظم يصلح لاتخاذ قرار فني أو استكمال إجراء. وفي هذه الصفحة يكون التركيز الخاص على الهبوط التفاضلي وحركة المبنى والأرض والأساسات ومؤشرات الاستمرار.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<StickyStory pVisualShare={40} pBg={Colors.Creamy} pVisualBg={Colors.BrownDark} pGap={new RespString("34px","16px")} pPad={new RespString("44px","12px")}>
		<Emograph slot="visual" pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("لماذا هذه الخدمة؟")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("يفصل بين الملاحظة والانطباع وبين رأي هندسي موثق يمكن الرجوع إليه عند الإصلاح أو التفاوض أو متابعة الأعمال. ويُراجع القرار هنا تحديدًا في ضوء الهبوط التفاضلي وحركة المبنى والأرض والأساسات ومؤشرات الاستمرار.")} />
		<StickyStoryItem pKicker="01 / فحص" pTitle="مراجعة الخلفية والمستندات مع مراعاة الهبوط التفاضلي وحركة المبنى والأرض والأساسات ومؤشرات الاستمرار" pText="نبدأ من المعلومات والمستندات المتاحة لتحديد ما يصلح للاعتماد وما يحتاج استكمالًا قبل أي التزام إضافي." pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<StickyStoryItem pKicker="02 / تجهيز" pTitle="المعاينة والقياسات أو الاختبارات المتاحة" pText="يتم تحويل المطلوب إلى مخرجات هندسية واضحة يمكن مراجعتها وربطها بالجهة أو المقاول أو المورد حسب طبيعة المهمة." pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<StickyStoryItem pKicker="03 / إغلاق" pTitle="إعداد تقرير بالنتائج والتوصيات" pText="نسلم المخرجات المتفق عليها مع تحديد ما تم وما يتبقى وما يعتمد على طرف أو جهة أخرى." pBg={Colors.BistageLite} pColor={Colors.Black} pAccent={Colors.BistageDark} />
	</StickyStory>

	<AngleBand id="secSrvCost" pBg={Colors.Black} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 3,500 ج.م للتقرير البسيط داخل نطاق القاهرة والجيزة؛ الاختبارات والزيارات الإضافية منفصلة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
