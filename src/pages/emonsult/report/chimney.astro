---
import { Align, Angle, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, HoverColors } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { EmoBtn, EmoCall, EmoContactStrip, Emograph, EmoList, EmoStrip, ESec, Hero, HzStack, PriceCard, RespImg, VrStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="تقرير استشاري هندسي لمدخنة"
	pDescr="مهندس استشاري ميكانيكا معتمد"
>







	<ESec data-hero pImgAlt="مدخنة منشأة ينبعث منها دخان ليلًا ضمن خدمة إعداد تقرير مهندس استشاري لترخيص مداخن المطاعم والمحامص والمحلات">

		<VrStack pSize={new Size(new NumPer("50%","95%"))} pLoc={new Loc(new NumPer("55%","2.5%"),new NumPer("15%","15%"))}>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("تقرير استشاري هندسي لمدخنة")}
				pText={Text.Body.Centered.White.OfText("مهندس استشاري ميكانيكا معتمد")}
			/>

			<EmoCall BlackSky pText="للطلب والاستفسار" />

		</VrStack>

	</ESec>







	<ESec id="secDef">

		<VrStack pGap={new Pixel(50,20)} pSize={new Size(new NumPer("70%","95%"))}>

			<Emograph
				pSize={new Size(new NumPer("80%","90%"))}
				pTitle={Text.H2.OfText("ما هو التقرير الهندسي للمدخنة المطلوب لترخيص محل تجاري ؟")}
				pText={Text.Body.OfText("تقرير استشاري هندسي يتم إعداده من مهندس استشاري ميكانيكا معتمد يفيد بمعاينة و سلامة حالة المدخنة وعدم وجود عيوب بها تشكل خطورة على الأرواح والممتلكات أو قد تكون سببا لحدوث حرائق لا قدر الله ، ويفيد بمطابقته للمواصفات الفنية المعتمدة لأعمال مكافحة الحريق .")}
			/>

			<Emograph
				pSize={new Size(new NumPer("80%","90%"))}
				pTitle={Text.H2.OfText("متى يتم طلب التقرير الهندسي لسلامة المدخنة المطلوب لترخيص محل تجاري ؟")}
				pText={Text.Body.OfText("تقرير سلامة المدخنة المطلوب لترخيص بعض المحلات التجارية هو مستند إضافي غير مطلوب لكل الحالات ، وعادة لا يتم طلبه من قبل الجهة الإدارية المعنية ( رئاسة الحي ) إلا في الأنشطة التي تعتمد على مدخنة لتصريف الأبخرة الناتجة من الاشتعال مثل المطاعم والمحامص .")}
			/>

			<EmoList
				pTitle={Text.H3.OfText("ما هي العناصر المؤهلة للمهندس الاستشاري ليكون معتمدا ؟")}
				pDesc={Text.Body.OfText("يجب أن يتمتع المهندس الاستشاري المؤهل لاعتماد تقرير المدخنة المطلوب لترخيص محل تجاري بالمواصفات التالية :")}
				pNumbered={false}
				pItems={[
				"أن يكون مقيد بنقابة المهندسين في تخصص الهندسة الميكانيكية",
				"أن يكون لديه سجل هندسي استشاري",
				"أن يكون حاصل على شهادة استشارية من نقابة المهندسين في التخصص الدقيق ( تصميم أعمال مكافحة الحريق )",
				"أن يكون ختمه شاملاً جميع البيانات الشخصية كمهندس استشاري ( رقم العضوية - رقم الاستشاري - رقم السجل الهندسي )"
			]}
			>

			</EmoList>

		</VrStack>

	</ESec>







	<ESec id="secCost">

		<HzStack
			id="stkAll"
			pGap={new Pixel(50,20)}
			pPad={new Pixel(50,20)}
		>

			<VrStack id="stkMain" pGap={new Pixel(50,20)}>

				<Emograph pTitle={Text.H2.Centered.OfText("تكلفة تقرير ترخيص مدخنة")} />

				<HzStack id="stkOffers" pGap={new Pixel(50)}>

					<PriceCard pCaption={Text.H3.OfSize(20,14).White.Bold.OfText("تقرير مدخنة معتمد من مهندس استشاري فقط")} pPrice={3000} />

					<PriceCard pCaption={Text.H3.OfSize(20,14).White.Bold.OfText("تقرير مدخنة معتمد من مهندس استشاري ونقابة المهندسين")} pPrice={6000} />

				</HzStack>

				<EmoCall BlackSky pText="للطلب والاستفسار ☎" />

			</VrStack>

			<VrStack
				id="stkSample"
				data-own-size
				pSize={new Size(new NumPer(300))}
				pGap={new Pixel(50,20)}
			>

				<RespImg />

				<EmoBtn
					pText="تحميل"
					pWidth="150px"
					pHeight="50px"
					pRadius="0"
					pBgColor="#164363"
					pBgColorHover="#328fe8"
					pTextColor="#ffffff"
					pFontSize="18px"
				/>

			</VrStack>

		</HzStack>

	</ESec>







</BLayout>
