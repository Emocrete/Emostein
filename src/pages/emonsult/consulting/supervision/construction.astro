---
import { Align, Angle, Colors, ElemBg, EmoMediaData, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { Badge, CardsGr, DuoCol, DuoStr, EmoCall, EmoContactStrip, EmoFaq, Emograph, EmoList, EmoPipelineStrip, EmoStatsStrip, EmoStrip, ESec, FaqItem, FreeHero, Grid, Hero, HzStack, PriceCard, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack } from "@/Widgets";
import { BadgeFrame, BlurBlob, CircleGlow, DoubleWave, FloatingPanel, GlassCard, LinePath, Ribbon, SvgDots, TiltCard, WaveBottom } from "@/Widgets/Shapes";






	const cMedia = "/Media/Emocrete/Supervision/Construction/";
	const cDark = "#172331";
	const cInk = "#111820";
	const cSteel = "#20384C";
	const cMint = "#D7F58C";
	const cSky = "#DAEFFE";
	const cAmber = "#FDCB9E";
---




















<BLayout
	pSchemaType="Service"
	pTitle="إشراف هندسي على البناء"
	pDescr="خدمة إشراف هندسي على تنفيذ أعمال البناء والهيكل الخرساني، تشمل متابعة واستلام الحفر والمحاور والنجارة والحدادة وصب الخرسانة للأساسات والأعمدة والأسقف، مع مراجعة مطابقة الأعمال للرسومات والمواصفات وتقليل أخطاء التنفيذ والهدر."
>







	<Hero
		pTitle="إشراف هندسي على البناء"
		pDesc="خدمات الإشراف الهندسي على التنفيذ لأعمال البناء والتشييد، ومتابعة تنفيذ الهيكل الإنشائي والتحقق من مطابقة الأعمال للرسومات والمواصفات الهندسية قبل انتقال المقاول من مرحلة إلى المرحلة التالية."
		pTitleClr={Colors.SkyDark}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pPosL="42% 58% 10% 5%"
		pPosP="54% 5% 5% 5%"
		pBlurL="on"
		pBlurP="on"
	>

		<EmoCall BlackSky pText="اطلب إشراف بناء" />

	</Hero>







	<ESec
		id="Intro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="قبل أن تخرب مالطا"
			pDesc="الإشراف الهندسي على البناء ليس حضورًا شكليًا في الموقع، بل نظام استلام ومراجعة قبل وأثناء وبعد البنود الحساسة، حتى لا يتحول الخطأ الصغير في النجارة أو الحدادة أو الصب إلى تكلفة علاج كبيرة بعد التنفيذ."
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 16)} pPad={new Pixel(0, 0)}>

				<VrStack
					pWidth={new Pixel(700, 340)}
					pGap={new Pixel(20, 14)}
					pPad={new Pixel(0, 0)}
				>

					<Emograph
						pTitle={Text.H3.OfText("المهندس المشرف يمثل عين المالك الفنية")}
						pText={Text.Body.OfText("المقاول مسؤول عن تنفيذ الأعمال، لكن مصلحته التجارية قد تجعله يميل إلى السرعة أو تقليل الهدر أو تمرير بعض التفاصيل. دور الإشراف الهندسي هو مراجعة التنفيذ بعين مستقلة، ومقارنة ما يحدث في الموقع بالرسومات والمواصفات، ورفض انتقال العمل للمرحلة التالية قبل علاج الملاحظات المؤثرة.")}
						pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
					/>

					<CardsGr
						pWidth={new RespString("700px", "100%")}
						pCardBg={new ElemBg(Colors.Gray1)}
						pCardTitleFnt={Text.H4.Centered}
						pCardBodyFnt={Text.Body.Centered}
						pTopic1={new Topic("استلام قبل التنفيذ", "مراجعة المحاور والمناسيب والأبعاد والتقويات والتسليح قبل الصب أو الإغلاق.")}
						pTopic2={new Topic("متابعة أثناء التنفيذ", "متابعة خطوات الصب وجودة الخرسانة وطريقة الدمك والمعالجة ومنع القرارات العشوائية.")}
						pTopic3={new Topic("توجيه بعد الملاحظة", "تحديد الملاحظة الفنية وطريقة علاجها قبل أن تتحول إلى عيب مخفي داخل الخرسانة.")}
					/>

				</VrStack>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emocrete/Supervision/Construction/", "HeroL.webp", false, "إشراف هندسي على البناء", new Size(new NumPer(500, 320), new NumPer("auto", "auto")))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<ESec
		id="Tasks"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="مهام الإشراف الهندسي على البناء"
			pDesc="صفحة الإشراف القديمة ركزت على ثلاث مهام أساسية في الهيكل الخرساني: النجارة المسلحة، الحدادة المسلحة، وصب الخرسانة والفرمجة. هنا يتم الحفاظ على نفس المحور مع توضيح قيمته التنفيذية للمالك."
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(25, 16)} pPad={new Pixel(0, 0)}>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emocrete/Supervision/Construction/", "SV_Tasks_Step1.webp", false, "أعمال النجارة المسلحة", new Size(new NumPer(360, 320), new NumPer("auto", "auto")))}
				/>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emocrete/Supervision/Construction/", "SV_Tasks_Step2.webp", false, "أعمال الحدادة المسلحة", new Size(new NumPer(360, 320), new NumPer("auto", "auto")))}
				/>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emocrete/Supervision/Construction/", "SV_Tasks_Step3.webp", false, "صب الخرسانة والفرمجة", new Size(new NumPer(360, 320), new NumPer("auto", "auto")))}
				/>

			</HzStack>

			<CardsGr
				pWidth={new RespString("1240px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("أعمال النجارة المسلحة", "متابعة واستلام أعمال النجارة للتحقق من دقة الأبعاد وأماكن الفتحات وسلامة التقويات وجاهزية العناصر العادية والمسلحة للصب.")}
				pTopic2={new Topic("أعمال الحدادة المسلحة", "التحقق من تنفيذ أعمال الحدادة المسلحة وفقًا للكميات والأطوال وأماكن الأسياخ المحددة في الرسومات التصميمية، ومراعاة التركيب وفقًا للمواصفات الهندسية.")}
				pTopic3={new Topic("صب الخرسانة والفرمجة", "مراقبة جودة الخرسانة المصنعة بالموقع أو الموردة للصب، والتحقق من الالتزام بالأصول الهندسية المتبعة أثناء عملية صب الخرسانة لضمان عدم وجود عيوب بعد فك الشدات.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec
		id="Why"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="لماذا تحتاج إشرافًا هندسيًا مستقلًا؟"
			pDesc="القيمة الحقيقية للإشراف لا تظهر عندما يكون كل شيء يسير بصورة جيدة، بل تظهر عند أول تعارض بين الرسومات والموقع، أو عند محاولة تمرير بند غير مطابق، أو عند صب عنصر قبل استلامه هندسيًا."
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1220px", "100%")}
				pCardBg={new ElemBg(Colors.Gray1)}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("منع صب الخطأ داخل الخرسانة", "أخطاء التسليح أو القشاير أو الفتحات لا تظهر بسهولة بعد الصب. الاستلام قبل الصب هو لحظة الحماية الحقيقية للمشروع.")}
				pTopic2={new Topic("حماية المالك من تضارب المصالح", "المقاول ينفذ ويسعر ويحسب. وجود مهندس مشرف مستقل يجعل المالك يملك رأيًا فنيًا لا يرتبط بمصلحة المقاول المباشرة.")}
				pTopic3={new Topic("ضبط استهلاك المواد", "المتابعة الهندسية تقلل الهدر الناتج عن إعادة الأعمال، وتساعد على بقاء استهلاك الحديد والخرسانة والخشب ضمن نطاق منطقي.")}
				pTopic4={new Topic("سرعة علاج الملاحظات", "الملاحظة التي تكتشف في وقتها تعالج بتعديل بسيط، أما الملاحظة التي تكتشف بعد إغلاق أو صب أو تحميل فتتحول إلى أزمة فنية ومالية.")}
				pTopic5={new Topic("توضيح قرارات الموقع", "المهندس المشرف يفرق بين قرار قابل للقبول موقعيًا وبين مخالفة يجب إيقافها أو الرجوع فيها للمصمم.")}
				pTopic6={new Topic("متابعة المرحلة لا العمال فقط", "الإشراف لا يعني مراقبة عدد العمال، بل استلام كل مرحلة وفق هدفها الفني قبل دخول المرحلة التالية.")}
			/>

		</EmoStrip>

	</ESec>







	<ESec
		id="Scope"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="نطاق خدمة الإشراف على الهيكل الخرساني"
			pDesc="النطاق الأساسي هنا يركز على أعمال البناء والهيكل الخرساني، بداية من الحفر والمحاور، مرورًا بالأساسات والأعمدة والأسقف، وحتى متابعة الصب والاستلام الفني للبنود الحساسة."
		/>

		<EmoStrip pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(28, 16)} pPad={new Pixel(0, 0)}>

				<EmoList
					pWidth={new RespString("580px", "100%")}
					pTitle={Text.H3.OfText("ما يدخل غالبًا ضمن الخدمة")}
					pDesc={Text.Body.OfText("يتم تثبيت النطاق النهائي حسب حالة المشروع وعدد الأدوار وطريقة التنفيذ وعدد الزيارات المطلوبة.")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={false}
					pItems={[
						"مراجعة الرسومات المتاحة قبل النزول للموقع وتحديد نقاط الاستلام الحرجة.",
						"استلام الحفر والمناسيب وحدود القواعد أو اللبشة حسب الرسومات.",
						"مراجعة توقيع المحاور والخنزيرة ومطابقة الأبعاد الأساسية.",
						"استلام النجارة والحدادة للعناصر الخرسانية قبل الصب.",
						"متابعة صب الخرسانة وملاحظات الدمك والتشطيب والمعالجة.",
						"توجيه المقاول لعلاج الملاحظات المؤثرة قبل الانتقال للمرحلة التالية."
					]}
				/>

				<EmoList
					pWidth={new RespString("580px", "100%")}
					pTitle={Text.H3.OfText("ما يحتاج اتفاقًا مستقلًا")}
					pDesc={Text.Body.OfText("بعض البنود قد تكون خارج نطاق الإشراف بالزيارة، أو تحتاج خدمة فنية إضافية حسب حالة الموقع.")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={false}
					pItems={[
						"إعادة التصميم أو تعديل الرسومات الإنشائية أو المعمارية.",
						"إدارة تنفيذ يومية كاملة أو وجود مهندس مقيم بالموقع.",
						"حصر كميات تفصيلي أو مراجعة مستخلصات المقاول بندًا بندًا.",
						"اختبارات معملية أو جسات أو تقارير تربة أو تقارير فنية منفصلة.",
						"اعتماد رسومات رسمية أو شهادة إشراف للجهات الإدارية إن لم تكن ضمن الاتفاق.",
						"الإشراف على التشطيبات أو الأعمال الكهروميكانيكية بعد الهيكل الخرساني."
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>







	<EmoStrip
		id="Foundations"
		pBg={new ElemBg(Colors.Gray5)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg(Colors.Gray5)}
			pSize={new Size(new NumPer(1200, "calc(100% - 24px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<Emograph
					pTitle={Text.H2.Bistage.OfText("مراحل الإشراف على أعمال الأساسات")}
					pText={Text.Body.White.OfText("الأساسات هي المرحلة التي يصعب علاج أخطائها لاحقًا دون تكلفة كبيرة، لذلك تبدأ المتابعة من الحفر والمحاور والخرسانة العادية ثم النجارة والحدادة والصب للأساسات المسلحة.")}
					pSize={new Size(new NumPer("58%", "100%"), new NumPer("auto", "auto"))}
				/>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emocrete/Supervision/Construction/", "FoundationLevel.webp", false, "استلام أعمال الأساسات", new Size(new NumPer(430, 320), new NumPer("auto", "auto")))}
				/>

			</HzStack>

		</EmoStrip>

		<EmoList
			pWidth={new RespString("1120px", "100%")}
			pTitle={Text.H3.Centered.OfText("زيارات واستلامات مرحلة الأساسات")}
			pDesc={Text.Body.Centered.OfText("في أغلب أعمال البناء يمكن تنظيم مرحلة الأساسات عبر زيارات محددة، مع إمكانية زيادة أو تقليل العدد حسب مساحة المشروع وطبيعة التربة وسرعة التنفيذ.")}
			pHeadBg={new ElemBg(Colors.SkyLite)}
			pItemsBg={new ElemBg(Colors.WhiteOff)}
			pNumbered={true}
			pItems={[
				{ Title: "زيارة 1: استلام أعمال الحفر قبل البدء في النجارة العادية للأساسات", Items: [
					"استلام منسوب وحدود الحفر طبقًا لنقطة الصفر المعماري، وتكون عادة منسوب مطبق الصرف الصحي الأقرب للمبنى أو منسوب الأسفلت عند منتصف الواجهة حسب النظام المتبع في المنطقة.",
					"استلام كفاءة دك الأرضية عند منسوب الحفر طبقًا لتقرير اختبار الدمك عند توفره، أو مراجعة خطوات الغمر والدك الميكانيكي والتأكد من استواء الحفر على منسوب واحد تقريبًا عند عدم وجود تقرير دمك."
				] },
				{ Title: "زيارة 2: توقيع المحاور قبل البدء في النجارة العادية للأساسات", Items: [
					"استلام الخنزيرة إن وجدت أو مراجعة حدود الأرض في حال عدم وجودها طبقًا للرسومات الهندسية.",
					"مراجعة توقيع محاور المبنى على الطبيعة والمسافات بينها باستخدام الأجهزة المساحية أو أي وسيلة هندسية تحقق الغرض وتحافظ على سلامة المحاور أثناء المراحل التالية."
				] },
				{ Title: "زيارة 3: استلام أعمال الأساسات العادية في نفس يوم صب الخرسانة العادية", Items: [
					"استلام منسوب وحدود الأساسات العادية سواء كانت قواعد منفصلة أو لبشة طبقًا للرسومات الهندسية.",
					"استلام تقويات الأساسات العادية قبل الصب.",
					"متابعة صب الخرسانة العادية والتأكد من جودة الخرسانة المستخدمة وجودة تشطيب الأسطح."
				] },
				{ Title: "زيارة 4: متابعة دورية لأعمال النجارة والحدادة للأساسات المسلحة في اليوم الأول للبدء", Items: [
					"تنسيق أعمال النجارة للأساسات المسلحة والتأكد من فهم العمالة لتفاصيل الرسم الهندسي.",
					"تنسيق أعمال الحدادة للأساسات المسلحة والتأكد من فهم العمال لتفاصيل الرسم الهندسي."
				] },
				{ Title: "زيارة 5: استلام النجارة والحدادة للأساسات المسلحة في اليوم السابق للصب", Items: [
					"استلام النجارة من حيث الأبعاد والميزان والزوايا والتقويات.",
					"استلام الحدادة للأساسات من حيث أبعاد التقفيص وعدد وقطر التسليح طبقًا للرسومات الهندسية.",
					"استلام قشاير الأعمدة وبادئ السلم ومراجعة مواقعها وأعدادها وأقطارها طبقًا للرسومات."
				] },
				{ Title: "زيارة 6: متابعة صب الخرسانة للأساسات المسلحة", Items: [
					"التحقق من جودة الخرسانة قبل استخدامها في الصب.",
					"التحقق من تنفيذ الصب طبقًا لأصول الصناعة بما يضمن جودة العناصر الإنشائية بعد فك الشدات الخشبية وعدم وجود عيوب أو ثغرات بالسطح النهائي."
				] }
			]}
		/>

	</EmoStrip>







	<EmoStrip
		id="Columns"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStrip
			pBg={new ElemBg(Colors.SkyLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 24px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emocrete/Supervision/Construction/", "ColumnsLevel.webp", false, "استلام أعمال الأعمدة", new Size(new NumPer(430, 320), new NumPer("auto", "auto")))}
				/>

				<Emograph
					pTitle={Text.H2.OfText("مراحل الإشراف على أعمال الأعمدة")}
					pText={Text.Body.OfText("الأعمدة عناصر رأسية حساسة؛ أي انحراف في الأبعاد أو الرأسية أو التسليح أو الكانات قد ينعكس على سلامة الدور التالي وشكل الفراغات وتشطيب الحوائط. لذلك يتم الاستلام على أكثر من نقطة لا في لحظة الصب فقط.")}
					pSize={new Size(new NumPer("58%", "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

		<EmoList
