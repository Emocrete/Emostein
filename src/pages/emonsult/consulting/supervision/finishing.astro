---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="خدمات الإشراف الهندسي على التشطيبات"
	pDescr="خدمات الإشراف الهندسي على التشطيبات الداخلية والخارجية للعمارات السكنية والشقق والفيلات والمحلات والصيدليات بنسبة أتعاب تبدأ من 7 % من إجمالي التكاليف وتتضمن متابعة واستلام أعمال التشطيبات الخارجية والداخلية والتأكد من التنفيذ حسب المواصفات والرسومات الهندسية المعتمدة"
>







	<Hero
		pImgAlt="أموال مهدرة بالآلاف يتم توفيرها عند الاعتماد على مهندس يتولى مهام الإشراف الهندسي على أعمال التشطيبات للعمارات السكنية والشقق والفلل والمحلات والصيدليات"
	>

		<VrStack
			pSize={new Size(new NumPer("40%","100%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("15%","10%"))}
			pHzAlign={"Center"}
			pBg={new ElemBg(Colors.WhiteOff)}
			pBgOpacity={new Percent(20)}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("إشراف هندسي على التشطيبات")}
				pText={Text.Body.Centered.White.OfText("خدمات الإشراف الهندسي على التشطيبات الداخلية والخارجية للعمارات السكنية والشقق والفيلات والمحلات والصيدليات بنسبة أتعاب تبدأ من 7 % من إجمالي التكاليف وتتضمن متابعة واستلام أعمال التشطيبات الخارجية والداخلية والتأكد من التنفيذ حسب المواصفات والرسومات الهندسية المعتمدة")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
				pColor="white"
			/>

			<HzStack pGap={new Pixel(30,10)} pForceHz>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<RelServices>

		<RelServiceItem
			pTitle="تشطيب شقق"
			pDesc="تنفيذ وتشطيب الشقق السكنية من مرحلة الطوب أو نصف التشطيب حتى التسليم النهائي."
			pHref="/emocrete/finishing/apartment"
		/>

		<RelServiceItem
			pTitle="تشطيب فلل"
			pDesc="تشطيب الفلل والدوبلكسات والمنازل الكبيرة داخليًا وخارجيًا مع تنسيق الواجهات والمداخل."
			pHref="/emocrete/finishing/villa"
		/>

		<RelServiceItem
			pTitle="تشطيب محلات"
			pDesc="تشطيب المحلات والأنشطة التجارية بما يخدم الواجهة والعرض والحركة والتشغيل اليومي."
			pHref="/emocrete/finishing/retail"
		/>

		<RelServiceItem
			pTitle="تشطيب صيدليات"
			pDesc="تشطيب الصيدليات ومنافذ النشاط الطبي مع مراعاة العرض والتخزين وسهولة التنظيف والتشغيل."
			pHref="/emocrete/finishing/pharmacy"
		/>

		<RelServiceItem
			pTitle="حصر كميات التشطيبات"
			pDesc="تجهيز كميات وبنود واضحة قبل التسعير أو قبل مراجعة عروض المقاولين."
			pHref="/emodsign/tech/takeoff/finishing"
		/>

	</RelServices>







</BLayout>
