---
import BLayout from "@/Layout.astro";
import { CardsGr, IconInfoCard } from "@/Widgets/Cards";
import { Badge, EmoCallIcon, Emograph, EmoWhatsIcon, Grid, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { DivCol, DivStr, EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { BadgeFrame } from "@/Widgets/Shapes";
import { IconCardsStrip } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---





<BLayout pSchemaType="Service" pTitle="استشارات هندسية للمصاعد" pDescr="استشارات هندسية وفنية لاختيار وتركيب واستلام وترخيص المصاعد">







	<Hero pImgAlt="استشارات هندسية وفنية لاختيار وتركيب واستلام وترخيص المصاعد">

		<VrStack
			pSize={new Size(new NumPer("40%","100%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("15%","10%"))}
			pHzAlign={"Center"}
			pBg={new ElemBg(Colors.WhiteOff)}
			pBgOpacity={new Percent(20)}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("استشارات هندسية للمصاعد")}
				pText={Text.Body.Centered.White.OfText("استشارات هندسية وفنية لاختيار وتركيب واستلام وترخيص المصاعد")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
				pColor="white"
			/>

			<HzStack pGap={new Pixel(30,10)} pForceHz>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec
		id="elevator-types"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
		pPad={new Pixel(62, 24)}
	>

		<SecTitle SkyLite pTitle="أنواع المصاعد الرئيسية" pDesc="التصنيف العملي للمصعد يوضح أثر كل نظام على المساحة، السرعة، الأحمال، الصيانة، والكهرباء" />

		<IconCardsStrip
			pBg={new ElemBg(Colors.WhiteOff)}
			pMax={3}
			pMaxP={1}
			pGap={new Pixel(22, 14)}
			pPad={new Pixel(34, 16)}
		>

			<IconInfoCard
				pTitle="مصاعد جرارية Traction"
				pDesc="تعتمد على محرك وبكرة وحبال وثقل موازن. مناسبة للمباني المتوسطة والعالية، وتوفر سرعات وكفاءة أفضل عند اختيار النظام الصحيح."
				pColor="#328FE8"
			/>

			<IconInfoCard
				pTitle="جراري بلا تروس Gearless"
				pDesc="اختيار شائع للمباني العالية والسرعات الكبيرة. تكلفته أعلى، لكنه أفضل في الكفاءة والنعومة عند التصميم والتنفيذ الجيد."
				pColor="#17345C"
			/>

			<IconInfoCard
				pTitle="بدون غرفة ماكينة MRL"
				pDesc="يوفر مساحة غرفة الماكينة، لكنه يحتاج مراجعة دقيقة لمساحة البئر والرأس العلوي وإمكانية الصيانة بعد التشغيل."
				pColor="#1C7C54"
			/>

			<IconInfoCard
				pTitle="مصاعد هيدروليكية"
				pDesc="مناسبة غالبًا للمباني المنخفضة وحركة التشغيل الخفيفة. تحتاج متابعة للزيت، الخراطيم، الأسطوانة، ومصدر القدرة الكهربائية."
				pColor="#B46B23"
			/>

			<IconInfoCard
				pTitle="هيدروليكي بدون بئر Holeless"
				pDesc="حل يقلل احتياج الحفر العميق، لكنه يظل محدودًا في الارتفاع والسرعة مقارنة بالحلول الجرارية."
				pColor="#7A5C2E"
			/>

			<IconInfoCard
				pTitle="مصاعد هوائية أو فراغية"
				pDesc="تصلح لبعض الفيلات والمنازل، مع احتياج محدود للبئر التقليدي، وسعة وسرعة مناسبة للاستخدام المنزلي الخفيف."
				pColor="#7B61FF"
			/>

		</IconCardsStrip>

	</EmoSec>







	<EmoSec
		id="elevator-components"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
		pPad={new Pixel(62, 24)}
	>

		<SecTitle
			Creamy
			pTitle="المكونات التي يتم فحصها في نظام المصعد"
			pDesc="فحص المصعد يراجع منظومة الحركة والتحكم والسلامة كاملة، من التشغيل اليومي حتى حالات الطوارئ"
		/>

		<IconCardsStrip
			pBg={new ElemBg("#FFFFFF")}
			pMax={4}
			pMaxP={1}
			pGap={new Pixel(18, 12)}
			pPad={new Pixel(32, 16)}
		>

			<IconInfoCard
				pTitle="الكابينة والثقل"
				pDesc="مراجعة اتزان الحركة، الحمولة، التشطيبات الداخلية، نقاط التعليق، ومطابقة الثقل الموازن لطبيعة النظام."
				pColor="#328FE8"
			/>

			<IconInfoCard
				pTitle="الماكينة والبكرة والحبال"
				pDesc="فحص محرك الجر أو وحدة الهيدروليك، حالة البكرة، شد الحبال، مسارات الحركة، والاهتزاز أو الضوضاء غير الطبيعية."
				pColor="#17345C"
			/>

			<IconInfoCard
				pTitle="وحدة التحكم VFD"
				pDesc="مراجعة بدء الحركة، التسارع، التباطؤ، الوقوف على مستوى الطابق، لوحات الطلب، والشاشات والتنبيهات."
				pColor="#1C7C54"
			/>

			<IconInfoCard
				pTitle="الأبواب والحساسات"
				pDesc="مطابقة أبواب الكابينة والطوابق، أقفال الأمان، الستائر الضوئية، سرعة الفتح والإغلاق، ومنع الحركة مع باب غير مغلق."
				pColor="#B46B23"
			/>

			<IconInfoCard pTitle="محدد السرعة والفرامل" pDesc="التأكد من عمل Governor ومكابح الطوارئ وموانع الانزلاق عند فرط السرعة أو الطوارئ." pColor="#7B61FF" />

			<IconInfoCard pTitle="المصدات وقاع البئر" pDesc="فحص Buffers، نظافة قاع البئر، الخلوص، الإضاءة، وإمكانية الوصول الآمن للصيانة." pColor="#7A5C2E" />

			<IconInfoCard
				pTitle="الطوارئ والاتصالات"
				pDesc="زر الطوارئ، الإنذار، الاتصال الداخلي، الإضاءة الاحتياطية، وتفاعل المصعد عند انقطاع الكهرباء."
				pColor="#C13B3A"
			/>

			<IconInfoCard
				pTitle="التشغيل الخاص"
				pDesc="مصاعد المستشفيات والسيارات والبضائع والحريق تحتاج اشتراطات حمولة وتشغيل وأولوية مختلفة عن مصعد الركاب العادي."
				pColor="#335C67"
			/>

		</IconCardsStrip>

	</EmoSec>







	<DivStr
		id="elevator-installation"
		pBg={new ElemBg("#101722")}
		pContentSize={new Size(new NumPer("1180px", "calc(100% - 24px)"))}
		pPad={new Pixel(56, 22)}
		pGap={new Pixel(26, 16)}
	>

		<DivCol
			pBg={new ElemBg("rgba(255,255,255,.08)")}
			pBgOpacity={new Percent(100)}
			pBlur={new Pixel(8, 4)}
			pPad={new Pixel(40, 22)}
			pGap={new Pixel(22, 14)}
			pHzAlign="Right"
		>

			<Emograph
				pTitle={Text.H2.AtRight.White.OfText("تجهيز الموقع قبل وصول معدات المصعد")}
				pText={Text.Body.AtRight.White.OfSize(19, 14).OfText("المشكلة المعتادة أن شركة المصاعد تصل للموقع ثم تظهر فروق في البئر أو القاعدة أو الرأس العلوي أو فتحات الأبواب أو التغذية الكهربائية. لذلك يتم فصل مرحلة التجهيز عن مرحلة التركيب، وفحص كل بند قبل الاعتماد.")}
			/>

			<Emograph
				pText={Text.Body.AtRight.White.OfSize(18, 13).OfText("الهدف من الاستشارة هنا هو تقليل التكسير والتأخير، وتثبيت نطاق الأعمال بين المالك وشركة المصاعد والمقاول المنفذ.")}
			/>

		</DivCol>

		<DivCol
			pBg={new ElemBg("#FFFFFF")}
			pPad={new Pixel(34, 18)}
			pGap={new Pixel(18, 12)}
			pHzAlign="Right"
		>

			<CardsGr
				pWidth={new RespString("100%", "100%")}
				pStackDir="Col"
				pCardBg={new ElemBg("#F6F9FC")}
				pCardTitleFnt={Text.H4.AtRight.WithColor("#101722")}
				pCardBodyFnt={Text.Body.AtRight.WithColor("#333333")}
				pTopic1={new Topic("البئر والقاعدة", "مراجعة الأبعاد، الاستقامة، القاع، القاعدة الخرسانية، الخلوص، ومواضع تثبيت القضبان.")}
				pTopic2={new Topic("الرأس العلوي والتهوية", "مراجعة Headroom وفتحات التهوية ومسارات الكابلات ومتطلبات الصيانة الآمنة.")}
				pTopic3={new Topic("الأبواب والكهرباء", "ضبط فتحات الطوابق، أبواب الكابينة، مسار التغذية الكهربائية، لوحة التحكم، والإضاءة والطوارئ.")}
				pTopic4={new Topic("التنسيق مع المورد", "ربط الرسومات والمقاسات والأحمال بين شركة المصعد والأعمال المدنية والتشطيبات قبل التنفيذ.")}
			/>

		</DivCol>

	</DivStr>







	<EmoSec
		id="elevator-testing"
		pBg={new ElemBg("#FFFDF8")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
		pPad={new Pixel(62, 24)}
	>

		<SecTitle
			SkyDark
			pTitle="استلام المصعد يعتمد على اختبارات منظمة"
			pDesc="الاختبار المنظم يربط بين الحمولة، الحركة، الفرامل، الأبواب، الحساسات، الطوارئ، والتوثيق النهائي"
		/>

		<Grid
			pMax={3}
			pMaxP={1}
			pGap={new Pixel(20, 14)}
			pSize={new Size(new NumPer(1180, "calc(100% - 24px)"), new NumPer("auto"))}
		>

			<BadgeFrame pBadge="A" pBg="#FFFFFF" pBadgeBg="#101722">

				<Emograph
					pTitle={Text.H4.Centered.OfText("اختبار التحميل")}
					pText={Text.Body.Centered.OfText("تشغيل المصعد مع حمولة الاختبار، ومراجعة الوقوف، الحركة، التسارع، التباطؤ، وعدم الانزلاق أو الاهتزاز الزائد.")}
				/>

			</BadgeFrame>

			<BadgeFrame pBadge="B" pBg="#FFFFFF" pBadgeBg="#328FE8">

				<Emograph
					pTitle={Text.H4.Centered.OfText("اختبار الفرامل والطوارئ")}
					pText={Text.Body.Centered.OfText("مراجعة مكابح الطوارئ، محدد السرعة، إيقاف الطوارئ، الإنذار، الإضاءة الاحتياطية، وسلوك المصعد عند انقطاع الكهرباء.")}
				/>

			</BadgeFrame>

			<BadgeFrame pBadge="C" pBg="#FFFFFF" pBadgeBg="#1C7C54">

				<Emograph
					pTitle={Text.H4.Centered.OfText("اختبارات الأبواب")}
					pText={Text.Body.Centered.OfText("قياس كفاءة الفتح والإغلاق، عمل الأقفال والستائر الضوئية، منع الحركة مع باب مفتوح، وعدم وجود احتكاكات أو فروق مستوى.")}
				/>

			</BadgeFrame>

			<BadgeFrame pBadge="D" pBg="#FFFFFF" pBadgeBg="#B46B23">

				<Emograph
					pTitle={Text.H4.Centered.OfText("التسوية عند الطوابق")}
					pText={Text.Body.Centered.OfText("فحص وقوف أرضية الكابينة على مستوى الطابق بدقة، لأن فرق التسوية من أكثر أسباب التعثر والشكاوى اليومية.")}
				/>

			</BadgeFrame>

			<BadgeFrame pBadge="E" pBg="#FFFFFF" pBadgeBg="#7B61FF">

				<Emograph
					pTitle={Text.H4.Centered.OfText("توثيق النتائج")}
					pText={Text.Body.Centered.OfText("تسجيل نتائج الفحص والملاحظات والنواقص والتوصيات قبل توقيع الاستلام أو طلب اعتماد الترخيص.")}
				/>

			</BadgeFrame>

			<BadgeFrame pBadge="F" pBg="#FFFFFF" pBadgeBg="#C13B3A">

				<Emograph
					pTitle={Text.H4.Centered.OfText("قرار القبول")}
					pText={Text.Body.Centered.OfText("قبول، قبول مشروط باستكمال نواقص، أو رفض فني مؤقت لحين معالجة عيوب السلامة أو التشغيل.")}
				/>

			</BadgeFrame>

		</Grid>

	</EmoSec>







	<EmoSec
		id="elevator-safety-standards"
		pBg={new ElemBg("#17345C")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
		pPad={new Pixel(62, 24)}
	>

		<SecTitle pTitle="السلامة والمعايير الفنية" pDesc="تتحول معايير EN 81 وASME إلى بنود فحص عملية: خلوص، أبواب، فرامل، محدد سرعة، صيانة، وتشغيل آمن" />

		<IconCardsStrip
			pBg={new ElemBg("#17345C")}
			pMax={3}
			pMaxP={1}
			pGap={new Pixel(22, 14)}
			pPad={new Pixel(34, 16)}
			pCardTitleFnt={Text.H4.Centered.White}
			pCardBodyFnt={Text.Body.Centered.White}
		>

			<IconInfoCard
				pTitle="EN 81-20 / EN 81-50"
				pDesc="تستخدم كمرجعية لمتطلبات السلامة، أبعاد الخلوص، الأبواب، فراغات الصيانة، واختبارات مكونات الأمان."
				pBg="rgba(255,255,255,.10)"
				pHoverBg="rgba(255,255,255,.16)"
				pColor="#68BCFF"
				pTextColor="#FFFFFF"
				pBodyColor="#FFFFFF"
			/>

			<IconInfoCard
				pTitle="ASME A17.1"
				pDesc="مرجعية أخرى لتصميم وتشغيل وصيانة المصاعد والسلالم المتحركة، وتفيد في منطق الاختبارات الدورية والطوارئ."
				pBg="rgba(255,255,255,.10)"
				pHoverBg="rgba(255,255,255,.16)"
				pColor="#F2C14E"
				pTextColor="#FFFFFF"
				pBodyColor="#FFFFFF"
			/>

			<IconInfoCard
				pTitle="متطلبات الترخيص المحلي"
				pDesc="يتم ربط المعايير الفنية بما تطلبه الجهة الإدارية في مصر: تقرير تركيب، تقرير تشغيل، مستندات مهندس، أو اعتماد نقابة عند الحاجة."
				pBg="rgba(255,255,255,.10)"
				pHoverBg="rgba(255,255,255,.16)"
				pColor="#9BE7C4"
				pTextColor="#FFFFFF"
				pBodyColor="#FFFFFF"
			/>

		</IconCardsStrip>

	</EmoSec>







	<DivStr
		id="elevator-maintenance"
		pBg={new ElemBg("#F1F5F8")}
		pContentSize={new Size(new NumPer("1180px", "calc(100% - 24px)"))}
		pPad={new Pixel(56, 22)}
		pGap={new Pixel(26, 16)}
	>

		<DivCol
			pBg={new ElemBg("#FFFFFF")}
			pPad={new Pixel(36, 20)}
			pGap={new Pixel(18, 12)}
			pHzAlign="Right"
		>

			<Emograph
				pTitle={Text.H2.AtRight.WithColor("#101722").OfText("الصيانة سجل تشغيل وسلامة")}
				pText={Text.Body.AtRight.WithColor("#333333").OfSize(19, 14).OfText("الصيانة الجيدة تمنع تحول العطل الصغير إلى توقف كامل أو حادث. لذلك يتم التعامل مع سجل الصيانة كوثيقة تشغيل: متى ظهر العطل؟ هل تكرر؟ هل تم تغيير قطعة؟ هل هناك اهتزاز أو فرق مستوى أو مشكلة أبواب؟")}
			/>

			<Emograph
				pText={Text.Body.AtRight.WithColor("#333333").OfSize(18, 13).OfText("في المصاعد القديمة، تشمل قيمة الفحص إصلاح العطل اللحظي وتحديد احتياج النظام إلى تحديث التحكم أو الأبواب أو الفرامل أو الحبال.")}
			/>

		</DivCol>

		<DivCol
			pBg={new ElemBg("#101722")}
			pBgOpacity={new Percent(100)}
			pPad={new Pixel(36, 20)}
			pGap={new Pixel(18, 12)}
			pHzAlign="Right"
		>

			<CardsGr
				pWidth={new RespString("100%", "100%")}
				pStackDir="Col"
				pCardBg={new ElemBg("rgba(255,255,255,.10)")}
				pCardTitleFnt={Text.H4.AtRight.White}
				pCardBodyFnt={Text.Body.AtRight.White}
				pTopic1={new Topic("أعطال الأبواب", "حساسات متسخة، أقفال غير مضبوطة، احتكاك ميكانيكي، أو مشكلة في مشغل الباب.")}
				pTopic2={new Topic("فرق التسوية", "الكابينة تقف أعلى أو أسفل منسوب الطابق بسبب ضبط حساس أو فرملة أو تحكم غير دقيق.")}
				pTopic3={new Topic("اهتزاز وضوضاء", "قد يرتبط بشد الحبال، البكرة، القضبان، العربة، أو تآكل في مكونات الحركة.")}
				pTopic4={new Topic("تسرب هيدروليك", "تسرب زيت من الأسطوانة أو الخراطيم يحتاج معالجة فنية وبيئية قبل تكرار التشغيل.")}
			/>

		</DivCol>

	</DivStr>







	<EmoSec
		id="elevator-special-uses"
		pBg={new ElemBg("#FFFFFF")}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
		pPad={new Pixel(62, 24)}
	>

		<SecTitle Bistage pTitle="الاستخدامات الخاصة للمصاعد" pDesc="المصاعد الخاصة لها أحمال وطريقة تشغيل ومخاطر تعطل مختلفة عن مصاعد الركاب اليومية" />

		<IconCardsStrip
			pBg={new ElemBg("#FFFFFF")}
			pMax={5}
			pMaxP={1}
			pGap={new Pixel(18, 12)}
			pPad={new Pixel(32, 16)}
		>

			<IconInfoCard pTitle="مصاعد بضائع" pDesc="حمولات أكبر، أرضية أقوى، استخدام تجاري أو مخزني، وأولوية لمتانة التشغيل على الديكور." pColor="#17345C" />

			<IconInfoCard pTitle="مصاعد مستشفيات" pDesc="كابينة تستوعب نقالة، تشغيل أولوية، مصدر طاقة احتياطي، وسلاسة حركة مناسبة للمرضى." pColor="#328FE8" />

			<IconInfoCard pTitle="مصاعد سيارات" pDesc="أرضية وحمولة عالية، سرعة أقل، تأمين حركة السيارة، ومراجعة دقيقة للفرامل ومستويات التوقف." pColor="#1C7C54" />

			<IconInfoCard pTitle="مصاعد بانورامية" pDesc="قيمة معمارية أعلى، لكنها ما زالت تحتاج نفس منطق الحركة والسلامة والتثبيت والصيانة." pColor="#B46B23" />

			<IconInfoCard
				pTitle="إتاحة وذوي احتياجات"
				pDesc="أبعاد الكابينة والأبواب والأزرار وطريقة التشغيل تضبط لتسهيل الوصول الآمن وتكامل الاستخدام اليومي."
				pColor="#7B61FF"
			/>

		</IconCardsStrip>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="كيف أختار نوع المصعد المناسب للمبنى؟"
			pAnswer="الاختيار يعتمد على عدد الأدوار، عدد المستخدمين، الحمولة اليومية، مساحة البئر، مصدر الكهرباء، نوع النشاط، ومتطلبات الترخيص. المبنى القصير قد يناسبه نظام هيدروليكي، بينما المباني المتوسطة والعالية غالبًا تحتاج نظامًا جراريًا أو MRL حسب المساحة."
		/>

		<FaqItem
			pQuestion="هل تركيب مصعد جديد يحتاج مراجعة إنشائية؟"
			pAnswer="نعم عند وجود أحمال أو اهتزازات أو تعديلات في المبنى، خصوصًا إذا كان المصعد يضاف لمبنى قائم. يتم التحقق من قابلية المبنى والبئر ونقاط التثبيت وتحمل الأحمال قبل التنفيذ أو الترخيص."
		/>

		<FaqItem
			pQuestion="هل أحتاج استشارة قبل طلب عرض سعر من شركة مصاعد؟"
			pAnswer="نعم إذا كان المبنى قائمًا أو المساحة محدودة أو الاستخدام كثيفًا أو المطلوب ترخيصًا رسميًا. المراجعة المسبقة تساعد في ضبط السعة والسرعة ونوع النظام وملاحظات البئر والكهرباء قبل تثبيت العرض الفني والمالي."
		/>

		<FaqItem
			pQuestion="ما أهم اختبارات الاستلام قبل التشغيل؟"
			pAnswer="اختبارات التحميل، الفرامل، محدد السرعة، الأبواب، الحساسات، التسوية عند الطوابق، الطوارئ، الإضاءة، والاتصال الداخلي، مع توثيق الملاحظات قبل القبول النهائي."
		/>

		<FaqItem
			pQuestion="هل الصيانة الدورية ضرورية إذا كان المصعد يعمل؟"
			pAnswer="نعم. التشغيل اليومي مؤشر أولي، والصيانة الدورية هي التي تكشف حالة الحبال والفرامل والحساسات والأبواب، وتقلل الأعطال المفاجئة ومشاكل التسوية والضوضاء والتسرب."
		/>

	</EmoFaq>







