---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import { VrStack } from "../../../site/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شهادة إشراف هندسي على الهدم"
	pDescr="استخراج شهادة إشراف هندسي على الهدم معتمدة من نقابة المهندسين المصرية، لاستخدامها ضمن ملف رخصة الهدم أو قبل الشروع في تنفيذ أعمال الهدم، مع توضيح المستندات المطلوبة ودور المهندس المشرف والتقرير الفني وخطوات الاعتماد."
>







	<Hero pImgF="/Media/Emonsult/Certificate/DemSV">

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","10%"))} pSize={new Size(new NumPer("50%","95%"))}>

			<Emograph
				pTitle={Text.H1.White.OfText("شهادة إشراف هندسي على الهدم")}
				pText={Text.Body.White.OfSize(16).OfText("شهادة معتمدة من نقابة المهندسين تفيد تولي مهندس نقابي مسؤولية الإشراف على تنفيذ أعمال الهدم طبقًا للترخيص، مع مراعاة السلامة الإنشائية وتأمين الجوار والمارة والمرافق قبل بدء التنفيذ.")}
			/>

			<EmoCall BlackSky pText="تواصل معنا" />

		</VrStack>

	</Hero>







	<EmoSec
		id="Intro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="ما هي شهادة الإشراف الهندسي على الهدم؟"
			pDesc="شهادة الإشراف على الهدم ليست ورقة شكلية داخل ملف الترخيص. هي مستند يربط أعمال الهدم بمهندس نقابي مسؤول عن متابعة التنفيذ، وإعطاء التعليمات الفنية، وتقليل مخاطر الهدم على العقار والجيران والمارة والمرافق المحيطة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(600, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("وظيفة الشهادة")}
				pText={Text.Body.OfText("تستخدم الشهادة لإثبات وجود إشراف هندسي معتمد على أعمال الهدم المرخص بها. وجود المهندس المشرف يساعد في ضبط تسلسل الهدم، ومراجعة طريقة التنفيذ، والتنبيه على الاحتياطات الفنية المطلوبة قبل إزالة العناصر الإنشائية أو المعمارية المؤثرة، خاصة عند وجود مبانٍ ملاصقة أو شارع ضيق أو مرافق قريبة.")}
			/>

			<Emograph
				pSize={new Size(new NumPer(500, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("متى تحتاجها؟")}
				pText={Text.Body.OfText("تحتاج الشهادة عند استخراج أو استكمال ملف رخصة الهدم، أو قبل الشروع في تنفيذ أعمال الهدم بعد صدور الرخصة، أو عندما تطلب الجهة الإدارية إثبات وجود مهندس نقابي معتمد يتابع الهدم ويتحمل مسؤولية الإشراف الفني في حدود الترخيص والتقرير الهندسي.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="Scope"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="ما الذي تغطيه شهادة إشراف الهدم؟"
			pDesc="الشهادة لا تغني عن رخصة الهدم، ولا تغني عن التقرير الهندسي لطريقة التنفيذ. لكنها مستند أساسي يثبت أن التنفيذ سيتم تحت إشراف مهندس معتمد."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardRadius={new Pixel(20, 16)}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pGrTitle={Text.H3.Centered.OfText("حدود الشهادة داخل ملف الهدم")}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("إثبات الإشراف", "تثبت الشهادة أن هناك مهندسًا نقابيًا معتمدًا يتولى الإشراف على تنفيذ أعمال الهدم المرخص بها.")}
			pTopic2={new Topic("ربط التنفيذ بالترخيص", "تساعد الشهادة في ربط أعمال الهدم بنطاق الرخصة الصادرة، فلا يتحول التنفيذ إلى إزالة عشوائية خارج حدود الترخيص.")}
			pTopic3={new Topic("إدارة المخاطر", "وجود مشرف هندسي يتيح مراجعة تسلسل الهدم والتنبيه على احتياطات السلامة وتأمين الجوار والمارة.")}
			pTopic4={new Topic("استكمال الملف", "تطلب الشهادة غالبًا ضمن مستندات ما قبل الشروع في أعمال الهدم، مع التقرير الفني وعقد المقاولة أو ما يفيد التعاقد مع مقاول.")}
		/>

	</EmoSec>







	<EmoStr
		id="Difference"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("الفرق بين رخصة الهدم وشهادة الإشراف والتقرير الهندسي")}
				pText={Text.Body.Centered.OfText("ملف الهدم يحتوي على أكثر من مستند، ولكل مستند وظيفة مختلفة. الخلط بينهم يؤدي إلى نقص في الملف أو تأخير قبل بدء التنفيذ.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardRadius={new Pixel(20, 16)}
			pCardBg={new ElemBg(Colors.Gray1)}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("رخصة الهدم", "قرار إداري يصدر من الجهة المختصة ويحدد السماح بالهدم ونطاقه وشروطه. لا يجوز اعتبار شهادة الإشراف بديلًا عن الرخصة.")}
			pTopic2={new Topic("شهادة الإشراف", "مستند نقابي يربط التنفيذ بمهندس مشرف معتمد، ويثبت للجهة الإدارية أن العمل لن يتم بلا إشراف هندسي.")}
			pTopic3={new Topic("التقرير الهندسي", "يوضح الطريقة الفنية لتنفيذ الهدم، وخطوات التنفيذ، وأسلوب تأمين سلامة المباني المجاورة والمارة والمرافق.")}
		/>

	</EmoStr>







	<EmoSec
		id="WhenNeeded"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="استخدامات شهادة الإشراف على الهدم"
			pDesc="تختلف صياغة الطلب حسب الجهة الإدارية وحالة العقار، لكن الاستخدام العملي للشهادة يدور حول إثبات وجود إشراف هندسي قبل أو أثناء تنفيذ الهدم المرخص."
		/>

		<EmoList
			pWidth={new RespString("1000px", "100%")}
			pTitle={Text.H3.Centered.OfText("متى تطلب الجهة الإدارية الشهادة؟")}
			pDesc={Text.Body.Centered.OfText("هذه هي الحالات العملية الأكثر شيوعًا لاستخدام شهادة الإشراف على الهدم.")}
			pHeadBg={new ElemBg(Colors.BistageLite)}
			pItemsBg={new ElemBg(Colors.Gray1)}
			pItemFnt={Text.Body}
			pNumbered={true}
			pItems={[
				"ضمن مستندات استكمال ملف رخصة الهدم للمباني والمنشآت غير الآيلة للسقوط.",
				"قبل الشروع في أعمال الهدم بعد صدور الرخصة، خاصة عند طلب الجهة الإدارية إخطارًا قبل بدء التنفيذ.",
				"عند وجود مبانٍ ملاصقة أو شوارع ضيقة أو مرافق عامة قريبة تستدعي إشرافًا فنيًا واضحًا.",
				"عند الحاجة إلى ربط مقاول الهدم بمهندس مشرف وتقرير فني يوضح طريقة التنفيذ.",
				"عند رغبة المالك في تقليل مخاطر المسؤولية الناتجة عن تنفيذ هدم عشوائي أو غير منظم."
			]}
		/>

	</EmoSec>







	<EmoSec
		id="BeforeStart"
		pBg={new ElemBg(Colors.SkyLite)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="مستندات ما قبل الشروع في أعمال الهدم"
			pDesc="في حالات كثيرة لا يكفي صدور رخصة الهدم وحدها. قبل بدء التنفيذ قد تطلب الجهة الإدارية إخطارًا ومستندات إضافية تثبت أن التنفيذ سيكون منظمًا وتحت إشراف."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("مستندات مرتبطة مباشرة بالشهادة")}
				pDesc={Text.Body.OfText("هذه البنود يتم تجهيزها غالبًا مع شهادة الإشراف أو حولها.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"شهادة إشراف على الهدم معتمدة من نقابة المهندسين.",
					"بيانات المهندس المشرف وسجله الهندسي ورقم قيده النقابي.",
					"توصيف العقار المطلوب هدمه من حيث العنوان وعدد الأدوار والمالك.",
					"إثبات سداد الرسوم والدمغات المطلوبة لاعتماد الشهادة.",
					"صورة من رخصة الهدم أو بيانات الترخيص المطلوب تنفيذ أعماله حسب المرحلة."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("مستندات تنفيذ الهدم")}
				pDesc={Text.Body.OfText("هذه المستندات تكمل الشهادة ولا تحل محلها.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"تقرير هندسي يوضح الأسلوب الفني لتنفيذ الهدم وخطوات العمل.",
					"توضيح أسلوب تأمين سلامة المباني المجاورة والمارة والمرافق.",
					"عقد مقاولة أو ما يفيد التعاقد مع مقاول حسب حالة المشروع.",
					"إخطار الجهة الإدارية قبل بدء التنفيذ إذا كان مطلوبًا ضمن إجراءات الرخصة.",
					"أي اشتراطات إضافية تضعها الجهة الإدارية حسب موقع وحالة العقار."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoStr
		id="Documents"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("المستندات المطلوبة لاستخراج شهادة إشراف على الهدم")}
				pText={Text.Body.Centered.OfText("قد تختلف التفاصيل حسب النقابة الفرعية والجهة الإدارية وحالة العقار، لكن هذه هي البيانات والمستندات التي يجب تجهيزها قبل بدء الاعتماد.")}
				pSize={new Size(new NumPer(980, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("مستندات المالك والعقار")}
				pDesc={Text.Body.OfText("تستخدم هذه المستندات في توصيف العقار وربط الشهادة بالمالك والرخصة.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"صورة بطاقة الرقم القومي للمالك أو مقدم الطلب.",
					"صورة سند الملكية أو ما يثبت صفة طالب الخدمة.",
					"صورة رخصة الهدم أو بيانات طلب الهدم حسب مرحلة الملف.",
					"بيان عنوان العقار بدقة وعدد الأدوار والحالة العامة.",
					"صور فوتوغرافية للعقار من الجهات المؤثرة عند الحاجة.",
					"توكيل رسمي إذا كان مقدم الطلب وكيلًا عن المالك."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("مستندات المهندس والشهادة")}
				pDesc={Text.Body.OfText("هذه البيانات مطلوبة لاعتماد الشهادة في نقابة المهندسين.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"بيانات المهندس المشرف ورقم القيد بالنقابة.",
					"رقم السجل الهندسي وحالة صلاحيته.",
					"توصيف كامل للعقار محل الهدم داخل الشهادة.",
					"بيان قيمة الأعمال أو التكلفة التقديرية عند طلبها لاعتماد الشهادة.",
					"سداد رسوم ودمغات اعتماد الشهادة طبقًا لإجراءات النقابة.",
					"توقيع المهندس على السجل أو الإجراءات المطلوبة لاعتماد الشهادة."
				]}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		id="Process"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="خطوات استخراج شهادة إشراف هندسي على الهدم"
			pDesc="المسار العملي يبدأ بمراجعة حالة الترخيص والعقار، ثم تجهيز بيانات الشهادة، ثم اعتمادها من النقابة قبل تقديمها للجهة الإدارية أو بدء التنفيذ."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardRadius={new Pixel(20, 16)}
			pCardBg={new ElemBg(Colors.Gray1)}
			pGrTitle={Text.H3.Centered.OfText("مراحل تنفيذ الخدمة")}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("مراجعة الحالة", "نراجع هل المطلوب شهادة إشراف فقط، أم شهادة مع تقرير هندسي، أم استكمال ملف رخصة هدم بالكامل.")}
			pTopic2={new Topic("تجهيز البيانات", "يتم جمع بيانات المالك والعقار والرخصة وعدد الأدوار والعنوان ونطاق أعمال الهدم المطلوب تنفيذها.")}
			pTopic3={new Topic("إعداد الشهادة", "تجهز شهادة الإشراف بالبيانات الصحيحة، مع توصيف العقار وربطها بالمهندس المشرف وسجله الهندسي.")}
			pTopic4={new Topic("اعتماد النقابة", "تقدم الشهادة للاعتماد وسداد الرسوم والدمغات المطلوبة، ثم تختم بخاتم النقابة وتصبح صالحة للتقديم.")}
			pTopic5={new Topic("تقديمها للجهة", "تسلم الشهادة ضمن مستندات الجهة الإدارية، أو ضمن مستندات ما قبل الشروع في الهدم حسب حالة الترخيص.")}
		/>

	</EmoSec>







	<EmoSec
		id="EngineerRole"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="دور المهندس المشرف أثناء الهدم"
			pDesc="أعمال الهدم أخطر من مجرد إزالة مبنى. الخطأ في التسلسل أو أسلوب التنفيذ قد يضر بالعقار المجاور أو المارة أو المرافق أو العمال داخل الموقع."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("المسؤولية الفنية")}
				pDesc={Text.Body.OfText("الهدف من الإشراف أن يتم الهدم بطريقة منظمة لا تترك القرار للعامل أو المقاول وحده.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"مراجعة نطاق الأعمال المسموح به في رخصة الهدم.",
					"متابعة تسلسل الهدم من العناصر غير الحاملة إلى العناصر الإنشائية المؤثرة عند الحاجة.",
					"التنبيه على وسائل التأمين المؤقتة حول الموقع.",
					"مراجعة تأثير الهدم على المباني الملاصقة والأسوار والمرافق.",
					"توجيه المقاول عند ظهور حالة إنشائية غير متوقعة أثناء التنفيذ."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("المخاطر التي يقللها الإشراف")}
				pDesc={Text.Body.OfText("المشرف الهندسي لا يمنع كل خطر، لكنه يقلل احتمالات التنفيذ الخاطئ ويجعل القرار الفني حاضرًا في الموقع.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"انهيار مفاجئ نتيجة هدم عنصر مؤثر مبكرًا.",
