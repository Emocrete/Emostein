---
import BLayout from "@/Layout.astro";
import { OccupancyValidityCostCalc } from "@/Widgets/Calc";
import { EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, ListItem, SecTitle, VrStack } from "@/Widgets/Comp";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="شهادة صلاحية المبنى للإشغال"
	pDescr="استخراج شهادة صلاحية المبنى للإشغال للمباني السكنية والتجارية والإدارية والصناعية، مع توضيح المستندات المطلوبة والتكلفة والرسوم الهندسية."
>







	<Hero>

		<VrStack
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","10%"))}
			pSize={new Size(new NumPer("50%","95%"))}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.White.Centered.OfText("شهادة صلاحية المبنى للإشغال")}
				pText={Text.Body.White.Centered.OfText("خدمات إصدار شهادة صلاحية المبنى للإشغال لتوصيل المرافق واعتماد جاهزية المبنى للاستخدام")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon OrangeBlack />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec
		id="secInfo"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={new Align("Center", "Center", "Center", "Center")}
		pVrAlign={new Align("Center", "Center", "Center", "Center")}
	>

		<DivStr>

			<DivCol>

				<Emograph
					pTitle={Text.H2.OfText("ما هي شهادة صلاحية المبنى للإشغال ؟").WithColor("#8b1e2d").Centered}
					pText={Text.Body.OfText("شهادة صلاحية المبنى للإشغال هي مستند رسمي تصدره نقابة المهندسين المصرية باسم مهندس نقابي معتمد ويقدم إلى الجهات الإدارية المختصة، مثل رئاسة الحي أو الجهاز التابع لهيئة المجتمعات العمرانية، والغرض منه بيان أن المبنى تم إنشاؤه وفقًا للمواصفات الفنية والمعايير الإنشائية واشتراطات الترخيص الصادرة مسبقًا، وأنه آمن وصالح للاستخدام.")}
				/>

			</DivCol>

			<DivCol>

				<Emograph
					pTitle={Text.H2.OfText("استخدامات شهادة صلاحية المبنى للإشغال").WithColor("#8b1e2d").Centered}
					pText={Text.Body.OfText("تستخدم شهادة صلاحية مبنى للإشغال سواء إشغال كلي أو جزئي في الحصول على خطاب الجهة الإدارية المعنية لإرفاقه بطلب توصيل المرافق المقدم إلى الجهة ذات العلاقة، مثل الكهرباء والمياه والغاز والصرف الصحي.")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec id="secDoc">

		<SecTitle OrangeDark pTitle="المستندات المطلوبة لاستخراج شهادة صلاحية مبنى للإشغال" />

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("في حال كانت رخصة البناء صادرة باسم مالك فردي").WithColor("#2f3340")} />

				<EmoList pNumbered={false}>

					<ListItem pText="صورة رخصة البناء المعتمدة" />

					<ListItem pText="صورة بطاقة المالك" />

				</EmoList>

			</DivCol>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("في حال كانت رخصة البناء صادرة باسم شركة").WithColor("#2f3340")} />

				<EmoList
					pNumbered={false}
					pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة عقد الشراكة أو صورة السجل التجاري للشركة",
						"صورة بطاقة أحد الشركاء المقيدين بعقد الشراكة أو السجل التجاري، أو صورة بطاقة المفوض من الشركة مرفق معها خطاب تفويض بختم الشركة"
					]}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<OccupancyValidityCostCalc pServiceFee={4000} pNonResidentialServiceFee={6000} />







	<EmoSec pMinH={new NumPer(300,300)} pHzAlign={"Center"} pBg={new ElemBg(Colors.BistageLite)}>

		<HzStack pGap={new Pixel(30,10)} pHzAlign={"Center"}>

			<EmoCallIcon BlackSky pText="اتصل للطلب" />

			<EmoWhatsIcon BlackSky pText="اطلب عبر واتساب" pMessage="أرغب في عمل شهادة صلاحية المبنى للإشغال" />

		</HzStack>

	</EmoSec>







</BLayout>
