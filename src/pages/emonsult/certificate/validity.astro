---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Colors, RespString, Size, Align, EmoMediaData, Pixel } from "@/TypesLib";
import { Hero, ESec, EmoStrip, EmoBtn, EmoCall, EmoList, Emograph, RespImg, EmoContactStrip, VrStack, HzStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شهادة صلاحية المبنى للإشغال"
	pDescr="استخراج شهادة صلاحية المبنى للإشغال للمباني السكنية والتجارية والإدارية والصناعية، مع توضيح المستندات المطلوبة والتكلفة والرسوم الهندسية."
>







	<Hero
		pTitle="شهادة صلاحية المبنى للإشغال"
		pDesc="إصدار شهادة صلاحية مبنى للإشغال لتوصيل المرافق واعتماد جاهزية المبنى للاستخدام"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pPosL="30% 40% 10% 8%"
		pPosP="15% 5% 50% 5%"
		pBlurL="off"
		pBlurP="on"
	>

		<HzStack style = " justify-content : center ; margin-top : 25px " data-land-only>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","ExperienceIconGold.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين",new Size(100,100,30,30))}
				/>

				<Emograph pTitle={Text.Body.OfText("6").Bistage.Centered} pText={Text.Body.OfText("سنوات خبرة").Bistage.Centered} />

			</HzStack>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","TrustedIcon.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين في القاهرة والجيزة",new Size(100,100,50,50))}
				/>

				<Emograph pTitle={Text.Body.OfText("+ 35").Bistage.Centered} pText={Text.Body.OfText("شهادة صلاحية").Bistage.Centered} />

			</HzStack>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","Hours24Icon.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين في القاهرة والجيزة",new Size(100,100,50,50))}
				/>

				<Emograph pTitle={Text.Body.OfText("24").Bistage.Centered} pText={Text.Body.OfText("فقط خلال ساعة").Bistage.Centered} />

			</HzStack>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","LocationIcon.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين في القاهرة والجيزة",new Size(100,100,50,50))}
				/>

				<Emograph pTitle={Text.Body.OfText("القاهرة والجيزة").Bistage.Centered} />

			</HzStack>

		</HzStack>

		<HzStack style = " margin-top : 50px ">

			<EmoCall BlackSky pText="اطلب الخدمة" />

			<EmoBtn
				pHeight="40px"
				pText="التفاصيل"
				pWidth="150px"
			/>

		</HzStack>

	</Hero>







	<ESec id="PadgesMobile" pBg={new ElemBg(Colors.BlackOff)}>

		<HzStack data-port-only>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","ExperienceIconGold.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين",new Size(100,100,100,100))}
				/>

				<Emograph pTitle={Text.Body.OfText("6").Bistage.Centered} pText={Text.Body.OfText("سنوات خبرة").Bistage.Centered} />

			</HzStack>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","TrustedIcon.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين في القاهرة والجيزة",new Size(100,100,100,100))}
				/>

				<Emograph pTitle={Text.Body.OfText("+ 35").Bistage.Centered} pText={Text.Body.OfText("شهادة صلاحية").Bistage.Centered} />

			</HzStack>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","Hours24Icon.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين في القاهرة والجيزة",new Size(100,100,100,100))}
				/>

				<Emograph pTitle={Text.Body.OfText("24").Bistage.Centered} pText={Text.Body.OfText("فقط خلال ساعة").Bistage.Centered} />

			</HzStack>

			<HzStack>

				<RespImg
					pImg={new EmoMediaData("Img","/Media/","LocationIcon.webp",false,"مهندس خبير شهادات صلاحية المبنى للإشغال من نقابة المهندسين في القاهرة والجيزة",new Size(100,100,100,100))}
				/>

				<Emograph pTitle={Text.Body.OfText("القاهرة والجيزة").Bistage.Centered} />

			</HzStack>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={new Align("Center", "Center", "Center", "Center")}>

		<Emograph
			pTitle={Text.H2.OfText("ما هي شهادة صلاحية المبنى للإشغال ؟").WithColor("#8b1e2d").Centered}
			pText={Text.Body.OfText("شهادة صلاحية المبنى للإشغال هي مستند رسمي تصدره نقابة المهندسين المصرية باسم مهندس نقابي معتمد ويقدم إلى الجهات الإدارية المختصة، مثل رئاسة الحي أو الجهاز التابع لهيئة المجتمعات العمرانية، والغرض منه بيان أن المبنى تم إنشاؤه وفقًا للمواصفات الفنية والمعايير الإنشائية واشتراطات الترخيص الصادرة مسبقًا، وأنه آمن وصالح للاستخدام.")}
		/>

		<Emograph
			pTitle={Text.H2.OfText("استخدامات شهادة صلاحية المبنى للإشغال").WithColor("#8b1e2d").Centered}
			pText={Text.Body.OfText("تستخدم شهادة صلاحية مبنى للإشغال سواء إشغال كلي أو جزئي في الحصول على خطاب الجهة الإدارية المعنية لإرفاقه بطلب توصيل المرافق المقدم إلى الجهة ذات العلاقة، مثل الكهرباء والمياه والغاز والصرف الصحي.")}
		/>

	</ESec>







	<ESec>

		<EmoStrip>

			<Emograph pTitle={Text.H2.Centered.OfText("المستندات المطلوبة لاستخراج شهادة صلاحية مبنى للإشغال").WithColor("#8b1e2d")} />

		</EmoStrip>

		<HzStack>

			<VrStack>

				<Emograph pTitle={Text.H3.Centered.OfText("في حال كانت رخصة البناء صادرة باسم مالك فردي").WithColor("#2f3340")} />

				<EmoList pNumbered={false} pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة بطاقة المالك"
					]} />

			</VrStack>

			<VrStack>

				<Emograph pTitle={Text.H3.Centered.OfText("في حال كانت رخصة البناء صادرة باسم شركة").WithColor("#2f3340")} />

				<EmoList
					pNumbered={false}
					pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة عقد الشراكة أو صورة السجل التجاري للشركة",
						"صورة بطاقة أحد الشركاء المقيدين بعقد الشراكة أو السجل التجاري، أو صورة بطاقة المفوض من الشركة مرفق معها خطاب تفويض بختم الشركة"
					]}
				/>

			</VrStack>

		</HzStack>

	</ESec>







	<ESec>

		<EmoStrip>

			<Emograph pTitle={Text.H2.Centered.OfText("تكلفة استخراج شهادة صلاحية المبنى للإشغال").WithColor("#8b1e2d")} />

		</EmoStrip>

		<VrStack id="ServiceCostBox">

			<HzStack id="ServiceCostTitle" pBg={new ElemBg(Colors.Sky)}>

				<Emograph pTitle={Text.H3.OfText("قيمة الخدمة")} />

				<VrStack pWidth={new Pixel(1000,300)}>

					<HzStack pBg={new ElemBg(Colors.WhiteOff)}>

						<Emograph pTitle={Text.Body.OfText("3000 جنيه")} />

						<Emograph pTitle={Text.Body.OfText("للمباني السكنية العادية")} />

					</HzStack>

					<HzStack pBg={new ElemBg(Colors.WhiteOff)}>

						<Emograph pTitle={Text.Body.OfText("5000 جنيه")} />

						<Emograph pTitle={Text.Body.OfText("للمباني التجارية والإدارية والصناعية")} />

					</HzStack>

				</VrStack>

			</HzStack>

			<HzStack pBg={new ElemBg(Colors.SkyLite)}>

				<Emograph pTitle={Text.H3.OfText("رسوم الخدمة المدفوعة لنقابة المهندسين")} />

				<VrStack pWidth={new Pixel(1000,320)}>

					<HzStack pBg={new ElemBg(Colors.WhiteOff)}>

						<Emograph pTitle={Text.Body.OfText("900 جنيه")} />

						<Emograph pTitle={Text.Body.OfText("الرسوم الأساسية لكل مبنى في المشروع")} />

					</HzStack>

					<VrStack pBgColor={new ElemBg(Colors.WhiteOff)} pHeight={new Pixel(800,320)}>

						<Emograph pTitle={Text.H4.OfText("مثال لحالة مشروع سكني أو تجاري أو إداري :").WithColor("#8b1e2d")} />

						<EmoList
							pWidth={new RespString("100%", "100%")}
							pNumbered={false}
							pItems={[
								"منطوق الرخصة ( بدروم + أرضي + متكرر + غرف سطح + سور ) تحتسب جميعًا كمبنى واحد",
								"منطوق الرخصة ( أرضي + متكرر + غرف سطح ) تحتسب جميعًا كمبنى واحد",
								"منطوق الرخصة ( أرضي + متكرر + غرفة كهرباء ) تحتسب على أنها 2 مبنى"
							]}
						/>

						<Emograph
							pTitle={Text.H4.OfText("مثال لحالة مباني صناعية :").WithColor("#8b1e2d")}
							pText={Text.Body.OfText("يتم اعتبار كلا من المبنى الإداري والجمالون وغرفة الكهرباء وغرفة الأمن والسور على أنها مبنى مستقل حسب العناصر المثبتة منها في منطوق رخصة البناء، ويحسب منها فقط العناصر المطلوب تضمينها في شهادة صلاحية الإشغال.")}
						/>

						<Emograph pTitle={Text.H4.DarkSky.OfText("الرسوم الأساسية الإجمالية للشهادة = 900 × عدد المباني")} />

					</VrStack>

					<HzStack pBg={new ElemBg(Colors.WhiteOff)}>

						<Emograph pTitle={Text.Body.OfText("% 0.45")} pText={Text.Body.OfText("نسبة رسوم الدمغة الهندسية إلى تكلفة رخصة البناء")} />

						<Emograph
							pTitle={Text.Body.OfText("قيمة رسوم الدمغة الهندسية = 0.0045 × تكلفة الرخصة")}
							pText={Text.Body.OfText("تتراوح عمليًا بين 4000 إلى 8000 حسب تكلفة الأعمال المسجلة بالرخصة").WithColor("red")}
						/>

					</HzStack>

				</VrStack>

			</HzStack>

			<HzStack pBg={new ElemBg(Colors.SkyLite)}>

				<VrStack pWidth={new Pixel(400,320)} pBgColor={new ElemBg(Colors.SkyDark)}>

					<Emograph pTitle={Text.H3.OfText("التكلفة الإجمالية")} />

				</VrStack>

				<VrStack pWidth={new Pixel(600,320)} pBgColor={new ElemBg(Colors.WhiteOff)}>

					<Emograph pTitle={Text.Body.OfText("التكلفة = قيمة الخدمة + الرسوم الأساسية + الدمغة الهندسية")} />

				</VrStack>

			</HzStack>

			<VrStack pWidth={new Pixel(1200,320)} pBgColor={new ElemBg(Colors.WhiteOff)}>

				<Emograph pTitle={Text.H4.OfText("حالات الإعفاء من دفع الدمغة الهندسية :").WithColor("#302c3c")} pText={Text.Body.OfText("")} />

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pNumbered={false}
					pItems={[
						"إعفاء كامل إذا تم دفعها بالكامل أثناء ترخيص البناء ويكون الدفع مثبت في الرخصة، أو بإيصال دمغة مستقل",
						"إعفاء جزئي إذا تم دفع جزء منها أثناء ترخيص البناء، ويكون الدفع مثبت في الرخصة، أو بإيصال دمغة مستقل، وفي هذه الحالة يتم دفع الجزء المتبقي فقط أثناء إصدار شهادة صلاحية الإشغال"
					]}
				/>

			</VrStack>

		</VrStack>

	</ESec>







</BLayout>
