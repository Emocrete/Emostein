---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { Price } from "@/Widgets/Prices";
import { DivCol, DivStr, EmoSec, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شهادة صلاحية المبنى للإشغال"
	pDescr="استخراج شهادة صلاحية المبنى للإشغال للمباني السكنية والتجارية والإدارية والصناعية، مع توضيح المستندات المطلوبة والتكلفة والرسوم الهندسية."
>







	<Hero>

		<VrStack pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","10%"))} pSize={new Size(new NumPer("50%","95%"))}>

			<Emograph
				pTitle={Text.H1.White.OfText("شهادة صلاحية المبنى للإشغال")}
				pText={Text.Body.White.OfText("خدمات إصدار شهادة صلاحية المبنى للإشغال لتوصيل المرافق واعتماد جاهزية المبنى للاستخدام")}
			/>

			<EmoCall OrangeBlack pText="تواصل معنا" />

		</VrStack>

	</Hero>







	<EmoSec
		id="secInfo"
		pBg={new ElemBg(Colors.Creamy)}
		pHzAlign={new Align("Center", "Center", "Center", "Center")}
		pVrAlign={new Align("Center", "Center", "Center", "Center")}
	>

		<DivStr>

			<DivCol>

				<Emograph
					pTitle={Text.H2.OfText("ما هي شهادة صلاحية المبنى للإشغال ؟").WithColor("#8b1e2d").Centered}
					pText={Text.Body.OfText("شهادة صلاحية المبنى للإشغال هي مستند رسمي تصدره نقابة المهندسين المصرية باسم مهندس نقابي معتمد ويقدم إلى الجهات الإدارية المختصة، مثل رئاسة الحي أو الجهاز التابع لهيئة المجتمعات العمرانية، والغرض منه بيان أن المبنى تم إنشاؤه وفقًا للمواصفات الفنية والمعايير الإنشائية واشتراطات الترخيص الصادرة مسبقًا، وأنه آمن وصالح للاستخدام.")}
				/>

			</DivCol>

			<DivCol>

				<Emograph
					pTitle={Text.H2.OfText("استخدامات شهادة صلاحية المبنى للإشغال").WithColor("#8b1e2d").Centered}
					pText={Text.Body.OfText("تستخدم شهادة صلاحية مبنى للإشغال سواء إشغال كلي أو جزئي في الحصول على خطاب الجهة الإدارية المعنية لإرفاقه بطلب توصيل المرافق المقدم إلى الجهة ذات العلاقة، مثل الكهرباء والمياه والغاز والصرف الصحي.")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec id="secDoc">

		<SecTitle OrangeDark pTitle="المستندات المطلوبة لاستخراج شهادة صلاحية مبنى للإشغال" />

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("في حال كانت رخصة البناء صادرة باسم مالك فردي").WithColor("#2f3340")} />

				<EmoList pNumbered={false} pItems={["صورة رخصة البناء المعتمدة","صورة بطاقة المالك"]} />

			</DivCol>

			<DivCol>

				<Emograph pTitle={Text.H3.Centered.OfText("في حال كانت رخصة البناء صادرة باسم شركة").WithColor("#2f3340")} />

				<EmoList
					pNumbered={false}
					pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة عقد الشراكة أو صورة السجل التجاري للشركة",
						"صورة بطاقة أحد الشركاء المقيدين بعقد الشراكة أو السجل التجاري، أو صورة بطاقة المفوض من الشركة مرفق معها خطاب تفويض بختم الشركة"
					]}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec id="secCost" Readable>

		<SecTitle OrangeDark pTitle="تكلفة استخراج شهادة صلاحية المبنى للإشغال" />

		<HzStack
			style = "
					margin-top : 50px ;
					margin-bottom : 50px ;
					padding : 30px
				"
			id="stkCostEq"
			pBg={new ElemBg(Colors.SkyLite)}
			pSize={new Size(new NumPer(1200))}
			Readable
		>

			<Emograph
				pTitle={Text.H3.Centered.OfText("التكلفة الإجمالية =")}
				pSize={new Size(new NumPer(300))}
				data-own-size
			/>

			<Emograph pTitle={Text.Body.Centered.OfSize(30,20).OfText("قيمة الخدمة + الرسوم الأساسية + الدمغة الهندسية")} />

		</HzStack>

		<Emograph pTitle={Text.H3.OfText("أولا : أتعاب الخدمة")} />

		<DivStr id="strCost" Readable>

			<DivCol>

				<Price pTitle={Text.Body.OfText("للمباني السكنية")} pPrice={3000} />

			</DivCol>

			<DivCol>

				<Price pTitle={Text.Body.OfText("للمباني التجارية والإدارية والصناعية")} pPrice={5000} />

			</DivCol>

		</DivStr>

		<Emograph pTitle={Text.H3.OfText(" ثانيا : رسوم الخدمة المدفوعة لنقابة المهندسين")} />

		<VrStack pWidth={new Pixel(1000,320)} pBg={new ElemBg(Colors.SkyLite)}>

			<HzStack pBg={new ElemBg(Colors.WhiteOff)}>

				<Emograph pTitle={Text.Body.Centered.OfSize(30,25).OfText("الرسوم الأساسية لكل مبنى في المشروع")} />

				<Emograph pTitle={Text.Body.Centered.Bold.OfSize(80,50).OfText("900 جنيه")} />

			</HzStack>

			<VrStack pBgColor={new ElemBg(Colors.WhiteOff)} pHeight={new Pixel(800,320)}>

				<Emograph pTitle={Text.H4.DarkSky.OfText("الرسوم الأساسية الإجمالية للشهادة = 900 × عدد المباني")} />

				<Emograph pTitle={Text.H4.OfText("مثال لحالة مشروع سكني أو تجاري أو إداري :").WithColor("#8b1e2d")} />

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pNumbered={false}
					pItems={[
						"منطوق الرخصة ( بدروم + أرضي + متكرر + غرف سطح + سور ) تحتسب جميعًا كمبنى واحد",
						"منطوق الرخصة ( أرضي + متكرر + غرف سطح ) تحتسب جميعًا كمبنى واحد",
						"منطوق الرخصة ( أرضي + متكرر + غرفة كهرباء ) تحتسب على أنها 2 مبنى"
					]}
				/>

				<Emograph
					pTitle={Text.H4.OfText("مثال لحالة مباني صناعية :").WithColor("#8b1e2d")}
					pText={Text.Body.OfText("يتم اعتبار كلا من المبنى الإداري والجمالون وغرفة الكهرباء وغرفة الأمن والسور على أنها مبنى مستقل حسب العناصر المثبتة منها في منطوق رخصة البناء، ويحسب منها فقط العناصر المطلوب تضمينها في شهادة صلاحية الإشغال.")}
				/>

			</VrStack>

			<HzStack pBg={new ElemBg(Colors.WhiteOff)}>

				<Emograph
					pTitle={Text.Body.Bold.OfSize(80,30).OfText("% 0.45")}
					pText={Text.Body.OfText("نسبة رسوم الدمغة الهندسية إلى تكلفة رخصة البناء")}
				/>

				<Emograph
					pTitle={Text.Body.OfText("قيمة رسوم الدمغة الهندسية = 0.0045 × تكلفة الرخصة")}
					pText={Text.Body.OfText("تتراوح عمليًا بين 4000 إلى 8000 حسب تكلفة الأعمال المسجلة بالرخصة").WithColor("red")}
				/>

			</HzStack>

		</VrStack>

		<VrStack pWidth={new Pixel(1200,320)} pBgColor={new ElemBg(Colors.WhiteOff)}>

			<Emograph pTitle={Text.H4.OfText("حالات الإعفاء من دفع الدمغة الهندسية :").WithColor("#302c3c")} pText={Text.Body.OfText("")} />

			<EmoList
				pWidth={new RespString("100%", "100%")}
				pNumbered={false}
				pItems={[
					"إعفاء كامل إذا تم دفعها بالكامل أثناء ترخيص البناء ويكون الدفع مثبت في الرخصة، أو بإيصال دمغة مستقل",
					"إعفاء جزئي إذا تم دفع جزء منها أثناء ترخيص البناء، ويكون الدفع مثبت في الرخصة، أو بإيصال دمغة مستقل، وفي هذه الحالة يتم دفع الجزء المتبقي فقط أثناء إصدار شهادة صلاحية الإشغال"
				]}
			/>

		</VrStack>

	</EmoSec>







	<RelServices>

		<RelServiceItem
			pTitle="شهادة إشراف هندسي على البناء"
			pDesc="استخراج شهادة الإشراف الهندسي الصادرة من نقابة المهندسين المصرية للحصول على ترخيص الحفر وبدء التنفيذ، مع توضيح المستندات المطلوبة والتكلفة والرسوم الهندسية."
			pHref="/emonsult/certificate/con-supervision"
			pImg="/Media/Emonsult/Certificate/ConSV/Building-Construction-Supervision-Certificate-HeroL.webp"
		/>

		<RelServiceItem
			pTitle="شهادة إشراف هندسي على الهدم"
			pDesc="شهادة معتمدة من نقابة المهندسين تفيد تولي مهندس نقابي مسؤولية الإشراف على تنفيذ أعمال الهدم طبقًا للترخيص، مع مراعاة السلامة الإنشائية وتأمين الجوار والمارة والمرافق قبل بدء التنفيذ."
			pHref="/emonsult/certificate/con-supervision"
			pImg="/Media/Emonsult/Certificate/ConSV/Building-Construction-Supervision-Certificate-HeroL.webp"
		/>

	</RelServices>







</BLayout>
