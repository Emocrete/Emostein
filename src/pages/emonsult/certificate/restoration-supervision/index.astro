---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, SplitPane, SplitScene } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="شهادة إشراف على الترميم"
	pDescr="شهادة إشراف على الترميم — إعداد الشهادة الهندسية المطلوبة بعد مراجعة الحالة والمستندات وإجراء المعاينة أو الحسابات اللازمة وفق طبيعة الشهادة والجهة المستخدمة أمامها. ويُبنى نطاق شهادة إشراف على الترميم على حالة المشروع الفعلية لا على وصف عام للخدمة. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="شهادة إشراف على الترميم">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("شهادة إشراف على الترميم")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("إعداد الشهادة الهندسية المطلوبة بعد مراجعة الحالة والمستندات وإجراء المعاينة أو الحسابات اللازمة وفق طبيعة الشهادة والجهة المستخدمة أمامها. ويُبنى نطاق شهادة إشراف على الترميم على حالة المشروع الفعلية لا على وصف عام للخدمة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<SplitScene pBg={Colors.Gray1} pColumns={new RespString("1fr 1fr","1fr")} pGap={new RespString("12px","10px")} pPad={new RespString("42px","10px")}>
		<SplitPane pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pEdge="Chevron" pEdgeP="None" pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.WhiteOff).OfText("نطاق الخدمة")} pText={Text.Body.WithColor(Colors.WhiteOff).OfText("تحديد غرض الشهادة والجهة، مراجعة الرسومات والمستندات والمعاينة، إصدار الشهادة والمرفقات المطلوبة.")} />
		</SplitPane>
		<SplitPane pBg={Colors.SkyLite} pColor={Colors.Black} pHzAlign="Right" pVrAlign="Center">
			<Emograph pTitle={Text.H2.WithColor(Colors.Black).OfText("الفائدة قبل الخطوة التالية")} pText={Text.Body.WithColor(Colors.Black).OfText("يضمن أن الشهادة مبنية على نطاق فني واضح بدل إصدار صياغة عامة لا تعكس حالة المبنى أو الأعمال فعليًا. ويظل القرار النهائي مرتبطًا ببيانات شهادة إشراف على الترميم نفسها قبل إصدار العرض.")} />
		</SplitPane>
	</SplitScene>

	<AngleBand id="secSrvCost" pBg={Colors.BrownDark} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 4,000 ج.م، مع فصل رسوم النقابة والدمغات والاختبارات إن وجدت.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
