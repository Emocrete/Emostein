---
import BLayout from "@/Layout.astro";
import { Hero, ESec, EmoStrip, Emograph, EmoContactStrip, EmoList, EmoBtn, SecTitle, VrStack, HzStack } from "@/Widgets";
import { Text, ElemBg, Colors, Align, Size, RespString } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شهادة إشراف هندسي على البناء"
	pDescr="استخراج شهادة الإشراف الهندسي الصادرة من نقابة المهندسين المصرية للحصول على ترخيص الحفر وبدء التنفيذ، مع توضيح المستندات المطلوبة والتكلفة والرسوم الهندسية."
>







	<Hero
		pTitle="شهادة إشراف هندسي على البناء"
		pDesc="مستند رسمي لاستخراج تصريح الحفر وبدء التنفيذ تحت إشراف هندسي معتمد"
		pTitleClr="#2f2c3d"
		pDescClr="#2f2c3d"
		pAlign="center"
		pPosL="10% 8% 10% 8%"
		pPosP="18% 8% 8% 8%"
		pBlurL="off"
		pBlurP="on"
	>

		<HzStack>

			<VrStack>

				<Emograph
					pTitle={Text.H1.OfText("5").WithColor("#302c3c").Centered}
					pText={Text.H3.OfText("سنوات خبرة").WithColor("#3d93ef").Centered}
				/>

			</VrStack>

			<VrStack>

				<Emograph
					pTitle={Text.H1.OfText("+ 25").WithColor("#302c3c").Centered}
					pText={Text.H3.OfText("شهادة إشراف").WithColor("#3d93ef").Centered}
				/>

			</VrStack>

			<VrStack>

				<Emograph
					pTitle={Text.H1.OfText("24").WithColor("#302c3c").Centered}
					pText={Text.H3.OfText("فقط خلال ساعة").WithColor("#3d93ef").Centered}
				/>

			</VrStack>

		</HzStack>

	</Hero>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Creamy};`}
			pTitle="ما هي شهادة الإشراف الهندسي ؟"
			pDesc=""
		/>

		<VrStack>

			<Emograph
				pTitle={Text.Body.OfText("")}
				pText={Text.Body.OfText("شهادة الإشراف الهندسي هي مستند رسمي تصدره نقابة المهندسين المصرية باسم مهندس نقابي معتمد ويقدم إلى الجهات الإدارية المختصة، مثل رئاسة الحي أو الجهاز التابع لهيئة المجتمعات العمرانية، والغرض منه ضمان أن المبنى سيتم إنشاؤه تحت إشراف هندسي يكون فيه المهندس مسئولًا عن التنفيذ وفقًا للمواصفات الفنية والمعايير الإنشائية واشتراطات الترخيص الصادرة. وبناء عليه يتم إصدار تصريح الحفر لبدء التنفيذ على هذا الأساس.")}
			/>

		</VrStack>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = {`--StripBg:${Colors.Creamy};`}
			pTitle="استخدامات شهادة الإشراف الهندسي"
			pDesc=""
		/>

		<VrStack>

			<Emograph
				pTitle={Text.Body.OfText("")}
				pText={Text.Body.OfText("تستخدم شهادة الإشراف الهندسي في الحصول على ترخيص الحفر من الجهة الإدارية المعنية، مثل رئاسة الحي أو جهاز هيئة المجتمعات العمرانية.")}
			/>

		</VrStack>

	</ESec>







	<ESec pBg={new ElemBg(Colors.Creamy)} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #ded8c3 "
			pTitle="المستندات المطلوبة لاستخراج شهادة الإشراف الهندسي"
			pDesc=""
		/>

		<HzStack>

			<VrStack>

				<Emograph
					pTitle={Text.H4.OfText("في حال كانت رخصة البناء صادرة باسم مالك فردي").WithColor("#2f3340").Centered}
					pText={Text.Body.OfText("")}
				/>

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pTitle={Text.Body.OfText("")}
					pDesc={Text.Body.OfText("")}
					pNumbered={false}
					pItemFnt={Text.Body.WithColor("#302c3c")}
					pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة بطاقة المالك"
					]}
				/>

			</VrStack>

			<VrStack>

				<Emograph
					pTitle={Text.H4.OfText("في حال كانت رخصة البناء صادرة باسم شركة").WithColor("#2f3340").Centered}
					pText={Text.Body.OfText("")}
				/>

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pTitle={Text.Body.OfText("")}
					pDesc={Text.Body.OfText("")}
					pNumbered={false}
					pItemFnt={Text.Body.WithColor("#302c3c")}
					pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة عقد الشراكة أو صورة السجل التجاري للشركة",
						"صورة بطاقة أحد الشركاء المقيدين بعقد الشراكة أو السجل التجاري، أو صورة بطاقة المفوض من الشركة مرفق معها خطاب تفويض بختم الشركة"
					]}
				/>

			</VrStack>

		</HzStack>

	</ESec>







	<ESec pBg={new ElemBg("#c9bfb8")} pAlign={Align.Center}>

		<SecTitle
			style = " --StripBg : #c9bfb8 "
			pTitle="تكلفة استخراج شهادة الإشراف الهندسي"
			pDesc=""
		/>

		<VrStack>

			<HzStack>

				<VrStack>

					<Emograph pTitle={Text.H3.OfText("قيمة الخدمة").WithColor("#2f3340").Centered} pText={Text.Body.OfText("")} />

				</VrStack>

				<VrStack>

					<HzStack>

						<Emograph pTitle={Text.H2.OfText("4000 جنيه").WithColor("#302c3c").WithAlign("right")} pText={Text.Body.OfText("")} />

						<Emograph pTitle={Text.Body.OfText("للمباني السكنية العادية").WithColor("#302c3c").WithAlign("right")} pText={Text.Body.OfText("")} />

					</HzStack>

					<HzStack>

						<Emograph pTitle={Text.H2.OfText("6000 جنيه").WithColor("#302c3c").WithAlign("right")} pText={Text.Body.OfText("")} />

						<Emograph
							pTitle={Text.Body.OfText("للمباني التجارية والإدارية والصناعية").WithColor("#302c3c").WithAlign("right")}
							pText={Text.Body.OfText("")}
						/>

					</HzStack>

				</VrStack>

			</HzStack>

			<HzStack>

				<VrStack>

					<Emograph
						pTitle={Text.H3.OfText("رسوم الخدمة المدفوعة لنقابة المهندسين").WithColor("#2f3340").Centered}
						pText={Text.Body.OfText("")}
					/>

				</VrStack>

				<VrStack>

					<HzStack>

						<Emograph pTitle={Text.H2.OfText("900 جنيه").WithColor("#302c3c").WithAlign("right")} pText={Text.Body.OfText("")} />

						<Emograph
							pTitle={Text.Body.OfText("الرسوم الأساسية لكل مبنى في المشروع").WithColor("#302c3c").WithAlign("right")}
							pText={Text.Body.OfText("")}
						/>

					</HzStack>

					<VrStack>

						<Emograph pTitle={Text.H4.OfText("مثال لحالة مشروع سكني أو تجاري أو إداري :").WithColor("#8b1e2d")} pText={Text.Body.OfText("")} />

						<EmoList
							pWidth={new RespString("100%", "100%")}
							pTitle={Text.Body.OfText("")}
							pDesc={Text.Body.OfText("")}
							pNumbered={false}
							pItemFnt={Text.Body.WithColor("#302c3c")}
							pItems={[
								"منطوق الرخصة ( بدروم + أرضي + متكرر + غرف سطح + سور ) تحتسب جميعًا كمبنى واحد",
								"منطوق الرخصة ( أرضي + متكرر + غرف سطح ) تحتسب جميعًا كمبنى واحد",
								"منطوق الرخصة ( أرضي + متكرر + غرفة كهرباء ) تحتسب على أنها 2 مبنى"
							]}
						/>

						<Emograph
							pTitle={Text.H4.OfText("مثال لحالة مباني صناعية :").WithColor("#8b1e2d")}
							pText={Text.Body.OfText("يتم اعتبار كلا من المبنى الإداري والجمالون وغرفة الكهرباء وغرفة الأمن والسور على أنها مبنى مستقل حسب العناصر المثبتة منها في منطوق رخصة البناء، ويحسب منها فقط العناصر المطلوب تضمينها في شهادة الإشراف الهندسي.")}
						/>

						<Emograph
							pTitle={Text.H4.OfText("الرسوم الأساسية الإجمالية للشهادة = 900 × عدد المباني").WithColor("#008cff").Centered}
							pText={Text.Body.OfText("")}
						/>

					</VrStack>

					<HzStack>

						<Emograph
							pTitle={Text.H2.OfText("% 0.45").WithColor("#302c3c").Centered}
							pText={Text.Body.OfText("نسبة رسوم الدمغة الهندسية إلى تكلفة رخصة البناء").WithColor("#302c3c").Centered}
						/>

						<Emograph
							pTitle={Text.Body.OfText("قيمة رسوم الدمغة الهندسية = 0.0045 × تكلفة الرخصة").WithColor("#302c3c")}
							pText={Text.Body.OfText("تتراوح عمليًا بين 4000 إلى 8000 حسب تكلفة الأعمال المسجلة بالرخصة").WithColor("#ff3333")}
						/>

					</HzStack>

				</VrStack>

			</HzStack>

			<HzStack>

				<VrStack>

					<Emograph pTitle={Text.H3.OfText("التكلفة الإجمالية").WithColor("#2f3340").Centered} pText={Text.Body.OfText("")} />

				</VrStack>

				<VrStack>

					<Emograph
						pTitle={Text.H4.OfText("التكلفة = قيمة الخدمة + الرسوم الأساسية + الدمغة الهندسية").WithColor("#302c3c").Centered}
						pText={Text.Body.OfText("")}
					/>

				</VrStack>

			</HzStack>

			<VrStack>

				<Emograph pTitle={Text.H4.OfText("حالات الإعفاء من دفع الدمغة الهندسية :").WithColor("#302c3c")} pText={Text.Body.OfText("")} />

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pTitle={Text.Body.OfText("")}
					pDesc={Text.Body.OfText("")}
					pNumbered={false}
					pItemFnt={Text.Body.WithColor("#302c3c")}
					pItems={[
						"إعفاء كامل إذا تم دفعها بالكامل أثناء ترخيص البناء ويكون الدفع مثبت في الرخصة، أو بإيصال دمغة مستقل",
						"إعفاء جزئي إذا تم دفع جزء منها أثناء ترخيص البناء، ويكون الدفع مثبت في الرخصة، أو بإيصال دمغة مستقل، وفي هذه الحالة يتم دفع الجزء المتبقي فقط أثناء إصدار شهادة الإشراف الهندسي"
					]}
				/>

			</VrStack>

		</VrStack>

	</ESec>







</BLayout>
