---
import BLayout from "@/Layout.astro";
import { SupervisionCertificateCostCalc } from "@/Widgets/Calc";
import { EmoCallIcon, Emograph, EmoList, EmoWhatsIcon, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { DivCol, DivStr, EmoSec, Hero } from "@/Widgets/Sections";
import { Align, Colors, ElemBg, Loc, NumPer, Pixel, RespString, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="شهادة إشراف هندسي على البناء"
	pDescr="استخراج شهادة الإشراف الهندسي الصادرة من نقابة المهندسين المصرية للحصول على ترخيص الحفر وبدء التنفيذ، مع توضيح المستندات المطلوبة والتكلفة والرسوم الهندسية."
>







	<Hero pImgF="/Media/Emonsult/Certificate/ConSV">

		<VrStack
			pLoc={new Loc(new NumPer("5%","0%"),new NumPer("40%","10%"))}
			pSize={new Size(new NumPer("45%","100%"))}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("شهادة إشراف هندسي على البناء")}
				pText={Text.Body.Centered.OfText("استخراج شهادة الإشراف الهندسي الصادرة من نقابة المهندسين المصرية للحصول على ترخيص الحفر وبدء التنفيذ، مع توضيح المستندات المطلوبة والتكلفة والرسوم الهندسية.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<DivStr>

			<DivCol>

				<Emograph
					pTitle={Text.H2.OfText("ما هي شهادة الإشراف الهندسي ؟")}
					pText={Text.Body.OfText("شهادة الإشراف الهندسي هي مستند رسمي تصدره نقابة المهندسين المصرية باسم مهندس نقابي معتمد ويقدم إلى الجهات الإدارية المختصة، مثل رئاسة الحي أو الجهاز التابع لهيئة المجتمعات العمرانية، والغرض منه ضمان أن المبنى سيتم إنشاؤه تحت إشراف هندسي يكون فيه المهندس مسئولًا عن التنفيذ وفقًا للمواصفات الفنية والمعايير الإنشائية واشتراطات الترخيص الصادرة. وبناء عليه يتم إصدار تصريح الحفر لبدء التنفيذ على هذا الأساس.")}
				/>

			</DivCol>

			<DivCol>

				<Emograph
					pTitle={Text.H2.OfText("استخدامات شهادة الإشراف الهندسي")}
					pText={Text.Body.OfText("تستخدم شهادة الإشراف الهندسي في الحصول على ترخيص الحفر من الجهة الإدارية المعنية، مثل رئاسة الحي أو جهاز هيئة المجتمعات العمرانية.")}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<EmoSec pBg={new ElemBg(Colors.Creamy)} pHzAlign={Align.Center} pVrAlign={Align.Center}>

		<SecTitle style = " --StripBg : #ded8c3 " pTitle="المستندات المطلوبة لاستخراج شهادة الإشراف الهندسي" />

		<DivStr>

			<DivCol>

				<Emograph pTitle={Text.H3.OfText("في حال كانت رخصة البناء صادرة باسم مالك فردي").WithColor("#2f3340").Centered} />

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pTitle={Text.Body.OfText("")}
					pDesc={Text.Body.OfText("")}
					pNumbered={false}
					pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة بطاقة المالك"
					]}
				/>

			</DivCol>

			<DivCol>

				<Emograph pTitle={Text.H3.OfText("في حال كانت رخصة البناء صادرة باسم شركة").WithColor("#2f3340").Centered} pText={Text.Body.OfText("")} />

				<EmoList
					pWidth={new RespString("100%", "100%")}
					pTitle={Text.Body.OfText("")}
					pDesc={Text.Body.OfText("")}
					pNumbered={false}
					pItems={[
						"صورة رخصة البناء المعتمدة",
						"صورة عقد الشراكة أو صورة السجل التجاري للشركة",
						"صورة بطاقة أحد الشركاء المقيدين بعقد الشراكة أو السجل التجاري، أو صورة بطاقة المفوض من الشركة مرفق معها خطاب تفويض بختم الشركة"
					]}
				/>

			</DivCol>

		</DivStr>

	</EmoSec>







	<SupervisionCertificateCostCalc
		pCairoFee={4000}
		pGizaFee={5000}
		pCairoNonResidentialFee={6000}
		pGizaNonResidentialFee={7000}
		pContractFee={3000}
	/>







	<EmoSec pMinH={new NumPer(300,300)} pHzAlign={"Center"} pBg={new ElemBg(Colors.BistageLite)}>

		<HzStack pGap={new Pixel(30,10)} pHzAlign={"Center"}>

			<EmoCallIcon BlackSky pText="اتصل للطلب" />

			<EmoWhatsIcon BlackSky pText="اطلب عبر واتساب" pMessage="أرغب في عمل شهادة إشراف هندسي على البناء" />

		</HzStack>

	</EmoSec>







</BLayout>
