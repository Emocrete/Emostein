---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { EmoFaq, EmoSec, FaqItem, Hero, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="CollectionPage"
	pTitle="شهادات هندسية"
	pDescr="خدمات استخراج واعتماد الشهادات الهندسية من نقابة المهندسين المصرية، وتشمل شهادة صلاحية المبنى للإشغال، شهادة إشراف هندسي على البناء، شهادة إشراف هندسي على الهدم، وشهادات وتقارير المعاينة والصلاحية المطلوبة للجهات الإدارية والمرافق."
>







	<Hero>

		<VrStack
			pBlur={new Pixel(10)}
			pBgOpacity={new Percent(50)}
			pBgColor={new ElemBg(Colors.BlackOff)}
			pLoc={new Loc(new NumPer("10%","5%"),new NumPer("40%","20%"))}
			pSize={new Size(new NumPer("50%","90%"))}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.White.OfText("شهادات هندسية")}
				pText={Text.Body.White.OfSize(16).OfText("اعتماد شهادات هندسية من نقابة المهندسين لاستخدامها أمام الأحياء وأجهزة المدن والجهات الإدارية وشركات المرافق، مع تجهيز بيانات العقار والمالك والمهندس والسجل الهندسي حسب نوع الشهادة المطلوبة.")}
			/>

			<EmoCall
				data-own-size
				BlackSky
				pText="تواصل معنا"
			/>

		</VrStack>

	</Hero>







	<EmoSec
		id="Intro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="ما المقصود بالشهادات الهندسية؟"
			pDesc="الشهادة الهندسية مستند مهني يصدر أو يعتمد باسم مهندس نقابي صاحب سجل هندسي، ويستخدم لإثبات واقعة فنية أو مسؤولية إشراف أو صلاحية مبنى أو مطابقة تنفيذ أمام جهة إدارية أو شركة مرافق أو مالك أو جهة تعامل رسمية."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("الشهادة ليست ختمًا فقط")}
				pText={Text.Body.OfText("قيمة الشهادة الهندسية في أنها تربط العقار أو الأعمال الهندسية بمهندس محدد وسجل هندسي محدد ومسؤولية مهنية محددة. لذلك لا يصح التعامل معها كختم منفصل عن البيانات، أو كنموذج عام يصلح لأي عقار دون معاينة أو مراجعة أو توصيف واضح.")}
			/>

			<Emograph
				pSize={new Size(new NumPer(560, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("متى تحتاج شهادة هندسية؟")}
				pText={Text.Body.OfText("تحتاج شهادة هندسية عند استخراج تصريح حفر، أو بدء تنفيذ بناء، أو استكمال رخصة هدم، أو توصيل مرافق بعد انتهاء التنفيذ، أو إثبات صلاحية مبنى، أو تقديم رأي فني معتمد لجهة إدارية أو مالك أو شركة مرافق أو اتحاد ملاك.")}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="CertificateTypes"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="أنواع الشهادات الهندسية التي نخدمها"
			pDesc="ليست كل الشهادات الهندسية لها نفس الغرض. بعض الشهادات ترتبط ببدء التنفيذ، وبعضها بإنهاء التنفيذ، وبعضها بالهدم، وبعضها بتقرير أو معاينة أو صلاحية إنشائية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardRadius={new Pixel(20, 16)}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pGrTitle={Text.H3.Centered.OfText("اختار الشهادة حسب مرحلة العقار")}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("شهادة صلاحية المبنى للإشغال", "تستخدم بعد انتهاء تنفيذ الأعمال المرخصة لإثبات مطابقة التنفيذ للترخيص والكودات والرسومات المنفذة فعليًا، وتستخدم غالبًا في إجراءات توصيل المرافق.")}
			pTopic2={new Topic("شهادة إشراف على البناء", "تستخدم لإثبات وجود مهندس مشرف على تنفيذ أعمال البناء، وتطلب عادة ضمن إجراءات تصريح الحفر وبدء التنفيذ بعد صدور رخصة البناء.")}
			pTopic3={new Topic("شهادة إشراف على الهدم", "تستخدم قبل أو أثناء تنفيذ أعمال الهدم المرخصة لإثبات أن الهدم سيتم تحت إشراف مهندس معتمد مع مراعاة السلامة وتأمين الجوار.")}
			pTopic4={new Topic("شهادات وتقارير معاينة", "تستخدم لإبداء رأي فني في حالة مبنى أو عنصر إنشائي أو أعمال قائمة، وقد ترتبط بالصلاحية الإنشائية أو التعلية أو التعديل أو التشغيل.")}
		/>

	</EmoSec>







	<EmoStr
		id="Difference"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("الفرق بين الشهادة والتقرير والختم والرخصة")}
				pText={Text.Body.Centered.OfText("الخلط بين هذه المصطلحات يسبب نقصًا في الملفات وتعطيلًا أمام الجهات الإدارية. كل مستند له وظيفة مختلفة ولا يغني تلقائيًا عن غيره.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardRadius={new Pixel(20, 16)}
			pCardBg={new ElemBg(Colors.Gray1)}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
			pTopic1={new Topic("الشهادة الهندسية", "مستند يثبت صلاحية أو إشرافًا أو مطابقة أو واقعة فنية محددة، ويعتمد ببيانات مهندس وسجل هندسي وعقار محدد.")}
			pTopic2={new Topic("التقرير الهندسي", "شرح فني أوسع لحالة عقار أو منشأ أو طريقة تنفيذ أو سبب مشكلة أو توصية هندسية، وقد يرفق بشهادة أو يستخدم مستقلًا.")}
			pTopic3={new Topic("الختم الهندسي", "وسيلة اعتماد مهني لمستند أو رسم أو شهادة، لكنه لا يحول مستندًا غير صحيح أو غير مكتمل إلى مستند صالح.")}
			pTopic4={new Topic("الرخصة الإدارية", "تصدر من الحي أو الجهاز أو الجهة المختصة وتسمح بتنفيذ أو تشغيل أو هدم أو بناء. الشهادة قد تكون مستندًا داخل ملف الرخصة لكنها ليست بديلًا عنها.")}
		/>

	</EmoStr>







	<EmoSec
		id="UseCases"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="استخدامات الشهادات الهندسية"
			pDesc="تختلف صيغة الشهادة حسب الجهة والغرض. لذلك يجب تحديد الاستخدام قبل صياغة الشهادة أو اعتمادها من النقابة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("أمام الجهات الإدارية")}
				pDesc={Text.Body.OfText("الاستخدام الإداري هو الأكثر شيوعًا في الأحياء وأجهزة المدن والهيئات.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"استكمال ملف تصريح الحفر أو بدء تنفيذ البناء.",
					"استكمال ملف رخصة الهدم أو إخطار ما قبل الشروع في الهدم.",
					"إيداع شهادة صلاحية المبنى للإشغال بعد انتهاء التنفيذ.",
					"إثبات حالة أو صلاحية إنشائية لعقار قائم.",
					"تقديم رأي فني مطلوب من لجنة أو إدارة هندسية."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("أمام المرافق والمالكين")}
				pDesc={Text.Body.OfText("بعض الشهادات ترتبط بالتشغيل والتعاملات العملية بعد انتهاء الأعمال.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"توصيل الكهرباء أو المياه أو الغاز أو الصرف بعد انتهاء الأعمال.",
					"إثبات صلاحية مبنى أو جزء منه للإشغال أو الاستخدام.",
					"تقديم مستند فني لاتحاد ملاك أو شركة إدارة أو مالك جديد.",
					"توضيح مسؤولية الإشراف على تنفيذ أو هدم أو تعديل.",
					"دعم ملف بيع أو تأجير أو تشغيل عقار يحتاج مستندًا فنيًا واضحًا."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="Validity"
		pBg={new ElemBg(Colors.SkyLite)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="شهادة صلاحية المبنى للإشغال"
			pDesc="هذه الشهادة تأتي بعد التنفيذ، وتستخدم لإثبات أن الأعمال المنفذة مطابقة للترخيص والكودات والرسومات المنفذة فعليًا، وهي من أهم مستندات توصيل المرافق والتشغيل."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<Emograph
				pSize={new Size(new NumPer(520, 320), new NumPer("auto", "auto"))}
				pTitle={Text.H3.OfText("متى تطلب؟")}
				pText={Text.Body.OfText("تطلب بعد إتمام تنفيذ الأعمال الصادر بها الترخيص، عند الحاجة إلى إيداع الشهادة لدى الجهة الإدارية المختصة أو استخراج خطابات توصيل المرافق أو إثبات جاهزية المبنى أو جزء منه للإشغال.")}
			/>

			<EmoList
				pWidth={new RespString("580px", "100%")}
				pTitle={Text.H3.OfText("ما الذي تراجعه الشهادة؟")}
				pDesc={Text.Body.OfText("قبل إصدار الشهادة يجب أن تكون بيانات التنفيذ واضحة وقابلة للمراجعة.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"مطابقة التنفيذ لرخصة البناء الصادرة.",
					"مطابقة التنفيذ للكودات والاشتراطات المنظمة.",
					"وجود رسومات تنفيذية نهائية تعبر عما تم تنفيذه فعليًا.",
					"عدم وجود اختلاف جوهري بين الترخيص والحالة المنفذة.",
					"تحديد ما إذا كانت الشهادة كلية للمبنى أو جزئية لجزء صالح للإشغال."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoStr
		id="Supervision"
		pBg={new ElemBg(Colors.WhiteOff)}
		pSize={new Size(new NumPer("100%", "100%"), new NumPer("auto", "auto"))}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<EmoStr
			pBg={new ElemBg(Colors.BistageLite)}
			pSize={new Size(new NumPer(1200, "calc(100% - 20px)"), new NumPer("auto", "auto"))}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<Emograph
				pTitle={Text.H2.Centered.OfText("شهادات الإشراف الهندسي")}
				pText={Text.Body.Centered.OfText("شهادة الإشراف تثبت أن هناك مهندسًا مسؤولًا عن متابعة التنفيذ أو الهدم ضمن حدود الترخيص والرسومات والتعليمات الفنية، وليست مجرد توقيع منفصل عن المشروع.")}
				pSize={new Size(new NumPer(1000, 320), new NumPer("auto", "auto"))}
			/>

		</EmoStr>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("شهادة إشراف على البناء")}
				pDesc={Text.Body.OfText("تستخدم في مرحلة بدء التنفيذ بعد صدور الترخيص.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"إثبات وجود مهندس مشرف على أعمال البناء.",
					"استخدامها في إجراءات تصريح الحفر وبدء التنفيذ.",
					"ربط التنفيذ بالرسومات والترخيص الصادر.",
					"توضيح مسؤولية المهندس في متابعة التنفيذ وإعطاء التعليمات الفنية.",
					"تقديمها للحي أو الجهاز أو الجهة الإدارية حسب حالة الترخيص."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("شهادة إشراف على الهدم")}
				pDesc={Text.Body.OfText("تستخدم في مرحلة تنفيذ الهدم المرخص أو قبل الشروع فيه.")}
				pHeadBg={new ElemBg(Colors.SkyLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"إثبات أن أعمال الهدم ستتم تحت إشراف مهندس معتمد.",
					"مراعاة تسلسل الهدم وتأمين الجوار والمارة والمرافق.",
					"استكمال مستندات ما قبل الشروع في الهدم.",
					"ربط شهادة الإشراف بالتقرير الفني لطريقة الهدم عند طلبه.",
					"تجنب تنفيذ هدم عشوائي خارج حدود الترخيص."
				]}
			/>

		</HzStack>

	</EmoStr>







	<EmoSec
		id="Requirements"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="بيانات ومستندات اعتماد الشهادات الهندسية"
			pDesc="حتى يتم اعتماد الشهادة بصورة صحيحة، يجب تجهيز بيانات العقار والمالك والمهندس والسجل الهندسي والغرض من الشهادة قبل الذهاب إلى النقابة أو الجهة المختصة."
		/>

		<HzStack pGap={new Pixel(30, 20)} pPad={new Pixel(35, 20)}>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("بيانات العقار والمالك")}
				pDesc={Text.Body.OfText("هذه البيانات تربط الشهادة بالعقار محل التعامل، وتمنع صدور شهادة عامة غير قابلة للاستخدام.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"اسم المالك أو طالب الخدمة وصفته القانونية.",
					"عنوان العقار بدقة والمحافظة والحي أو الجهاز التابع له.",
					"عدد الأدوار وطبيعة الاستخدام: سكني، إداري، تجاري، صناعي، أو مختلط.",
					"بيانات الترخيص أو الرخصة أو طلب التعامل إن وجدت.",
					"توصيف الأعمال محل الشهادة: بناء، إشغال، هدم، معاينة، صلاحية، أو تقرير."
				]}
			/>

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pTitle={Text.H3.OfText("بيانات المهندس والسجل")}
				pDesc={Text.Body.OfText("اعتماد الشهادة يتطلب وضوح بيانات المهندس وموقف سجله الهندسي.")}
				pHeadBg={new ElemBg(Colors.BistageLite)}
				pItemsBg={new ElemBg(Colors.Gray1)}
				pItemFnt={Text.Body}
				pNumbered={true}
				pItems={[
					"رقم قيد المهندس بنقابة المهندسين.",
					"رقم السجل الهندسي وحالة سريانه أو تجديده.",
					"تخصص المهندس ومدى ملاءمته لنوع الشهادة.",
					"قيمة الأعمال أو التكاليف التقديرية إذا كانت مطلوبة في نموذج الشهادة.",
					"إيصال سداد الرسوم والدمغات المطلوبة لاعتماد الشهادة."
				]}
			/>

		</HzStack>

	</EmoSec>







	<EmoSec
		id="Process"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="خطوات تنفيذ خدمة الشهادات الهندسية"
			pDesc="نرتب الخدمة حسب نوع الشهادة والجهة التي ستستلمها، لأن شهادة الإشغال تختلف عن شهادة الإشراف، وشهادة الهدم تختلف عن تقرير المعاينة أو الصلاحية."
		/>

		<CardsGr
			pWidth={new RespString("1200px", "100%")}
			pCardRadius={new Pixel(20, 16)}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pGrTitle={Text.H3.Centered.OfText("مسار العمل")}
			pCardTitleFnt={Text.H4}
			pCardBodyFnt={Text.Body}
			pStackDir="Row"
			pSpacing={20}
