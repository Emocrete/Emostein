---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="CollectionPage" pTitle="ختم هندسي" pDescr="خدمات الختم الهندسي للرسومات والتقارير من مهندس نقابي ومهندس استشاري جميع التخصصات">







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("55%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("ختم هندسي")}
				pText={Text.Body.Centered.OfText("خدمات الختم الهندسي للرسومات والتقارير من مهندس نقابي ومهندس استشاري جميع التخصصات")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
