---
import BLayout from "@/Layout.astro";
import { Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { Price } from "@/Widgets/Prices";
import { EmoSec, Hero } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Colors, ElemBg, Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
import { EmoCall, EmoDet, EmoStr, EmoWhats } from "../../../site/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ختم مهندس استشاري ( إنشائي - ميكانيكا - كهرباء )"
	pDescr="خدمات الختم الهندسي للرسومات والتقارير الهندسية من مهندسين استشاريين لجميع التخصصات"
>







	<Hero pImgAlt="ختم مهندس استشاري">

		<VrStack
			pSize={new Size(new NumPer("40%","100%"))}
			pLoc={new Loc(new NumPer("50%","0%"),new NumPer("20%","9%"))}
			pHzAlign="Center"
			pVrAlign="Center"
			pGap={new Pixel(30,5)}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("ختم مهندس استشاري")}
				pText={Text.Body.Centered.OfSize(22,18).OfText("خدمات الختم الهندسي للرسومات والتقارير الهندسية من مهندسين استشاريين لجميع التخصصات")}
			/>

			<Emograph pText={Text.Body.Centered.OfSize(22).OfText("( إنشائي - ميكانيكا - كهرباء )")} />

			<EmoCall data-own-size BlackOrange />

		</VrStack>

	</Hero>







	<EmoSec id="secConsDef" pBg={new ElemBg(Colors.WhiteOff)}>

		<SecTitle WhiteOff pTitle="ما المقصود بـ مهندس استشاري ؟" />

		<VrStack>

			<Emograph
				pText={Text.Body.OfText("​المهندس الاستشاري هو مهندس نقابي مقيد بنقابة المهندسين ذو خبرة 15 سنة فأعلى وحاصل على سجل هندسي وشهادة استشارية من نقابة المهندسين")}
			/>

			<EmoList
				pDesc={Text.Body.OfText("تختلف تخصصات المهندسين الاستشاريين المطلوب الحصول على الختم الهندسي الخاص بهم حسب الغرض من الختم ونوع المستند المطلوب ختمه ومنها التخصصات التالية :")}
				pItems={[
				"مهندس استشاري إنشائي",
				"مهندس استشاري ميكانيكا ( استشاري أعمال صحية - استشاري أعمال حريق وحماية مدنية )",
				"مهندس استشاري كهرباء وإنذار الحريق"
			]}
			/>

		</VrStack>

	</EmoSec>







	<EmoSec id="secStrucCost">

		<SecTitle OrangeDark pTitle="تكلفة ختم مهندسي استشاري معماري أو إنشائي" />

		<EmoStr id="strDwg">

			<SecTitle OrangeLite pTitle="أولا : الرسومات الهندسية ( بدون ختم نقابة المهندسين )" />

			<VrStack pSize={new Size(new NumPer("70%","95%"))}>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري لرسومات ترخيص محل تجاري")}
					pPrice={"1500"}
					pTitlePlace="top"
				>

					<VrStack>

						<Emograph
							pText={Text.Body.Red.OfText("لا يطلب ختم مهندس استشاري لرسومات ترخيص المحلات التجارية إلا لبعض الحالات حسب طلب الجهة التي سيسلم إليها الرسومات صراحة ، عادة يكفي فقط ختم مهندس نقابي غير استشاري لاعتماد رسومات تراخيص المحلات التجارية")}
						/>

						<HzStack pGap={new Pixel(50,30)}>

							<EmoDet
								BlackOrange
								pHref="/emonsult/stamp/eng"
								pText="نعم أقصد ختم مهندس نقابي فقط"
							/>

							<EmoWhats GreenDark pText="غير متأكد وأريد المساعدة" />

						</HzStack>

					</VrStack>

				</Price>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري لرسومات لأغراض عامة")}
					pPrice={"1500"}
					pPriceLabel="تبدأ من"
					pTitlePlace="top"
				>

					<Emograph pText={Text.Body.OfText("يتم تقديرها لكل حالة تبعًا لمحتوى الرسومات وعدد اللوحات")} />

				</Price>

			</VrStack>

		</EmoStr>

		<EmoStr id="strReport">

			<SecTitle OrangeLite pTitle="ثانيا : التقارير الهندسية ( بدون ختم نقابة المهندسين )" />

			<VrStack pSize={new Size(new NumPer("70%","95%"))}>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري لتقرير سلامة مبنى لترخيص محل تجاري أو ترخيص صيدلية")}
					pPrice={"2000"}
					pTitlePlace="top"
					pPriceLabel="يبدأ من"
				>

					<EmoDet BlackOrange pHref="/emonsult/report/safety" />

				</Price>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري لتقرير سلامة مبنى لترخيص تركيب مصعد")}
					pPrice={"3000"}
					pPriceLabel="يبدأ من"
					pTitlePlace="top"
				>

					<EmoDet BlackOrange pHref="/emonsult/report/elevator" />

				</Price>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec id="secMechCost">

		<SecTitle OrangeDark pTitle="تكلفة ختم مهندسي استشاري ميكانيكا" />

		<EmoStr id="strDwg">

			<SecTitle OrangeLite pTitle="أولا : الرسومات الهندسية ( بدون ختم نقابة المهندسين )" />

			<VrStack pSize={new Size(new NumPer("70%","95%"))}>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري ميكانيكا لرسومات ترخيص تشغيل مصعد")}
					pPrice={"1500"}
					pTitlePlace="top"
				>

				</Price>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري ميكانيكا لرسومات لأغراض عامة")}
					pPrice={"1500"}
					pPriceLabel="تبدأ من"
					pTitlePlace="top"
				>

					<Emograph pText={Text.Body.OfText("يتم تقديرها لكل حالة تبعًا لمحتوى الرسومات وعدد اللوحات")} />

				</Price>

			</VrStack>

		</EmoStr>

		<EmoStr id="strReport">

			<SecTitle OrangeLite pTitle="ثانيا : التقارير الهندسية ( بدون ختم نقابة المهندسين )" />

			<VrStack pSize={new Size(new NumPer("70%","95%"))}>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري ميكانيكا لترخيص تركيب وتشغيل مصعد")}
					pPrice={"3000"}
					pPriceLabel="يبدأ من"
					pTitlePlace="top"
				>

					<EmoDet BlackOrange pHref="/emonsult/report/elevator" />

				</Price>

			</VrStack>

		</EmoStr>

	</EmoSec>







	<EmoSec id="secElecCost">

		<SecTitle OrangeDark pTitle="تكلفة ختم مهندسي استشاري كهرباء" />

		<EmoStr id="strDwg">

			<SecTitle OrangeLite pTitle="أولا : الرسومات الهندسية ( بدون ختم نقابة المهندسين )" />

			<VrStack pSize={new Size(new NumPer("70%","95%"))}>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري كهرباء لرسومات إنذار حريق")}
					pPrice={"1500"}
					pTitlePlace="top"
				>

				</Price>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري كهرباء لرسومات لأغراض عامة")}
					pPrice={"1500"}
					pPriceLabel="تبدأ من"
					pTitlePlace="top"
				>

					<Emograph pText={Text.Body.OfText("يتم تقديرها لكل حالة تبعًا لمحتوى الرسومات وعدد اللوحات")} />

				</Price>

			</VrStack>

		</EmoStr>

		<EmoStr id="strReport">

			<SecTitle OrangeLite pTitle="ثانيا : التقارير الهندسية ( بدون ختم نقابة المهندسين )" />

			<VrStack pSize={new Size(new NumPer("70%","95%"))}>

				<Price
					pTitle={Text.H3.Centered.OfText("ختم مهندس استشاري كهرباء لترخيص حضانة أطفال")}
					pPrice={"3000"}
					pPriceLabel="يبدأ من"
					pTitlePlace="top"
				>

					<EmoDet BlackOrange pHref="/emonsult/report/nursery" />

				</Price>

			</VrStack>

		</EmoStr>

	</EmoSec>







</BLayout>
