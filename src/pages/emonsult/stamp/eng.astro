---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Colors, Pixel, RespString ,Align, Size} from "@/TypesLib";
import { Hero, ESec, EmoStrip, EmoCall, EmoBtn, EmoContactStrip, EmoList, Emograph, SecTitle, VrStack, HzStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="ختم مهندس نقابي"
	pDescr="خدمة ختم واعتماد الرسومات والتقارير الهندسية من مهندس نقابي معتمد لأصحاب المحلات التجارية والصيادلة وأصحاب المعامل الطبية وكل من يحتاج ختمًا نقابيًا مقبولًا لدى جهات الترخيص والجهات الإدارية."
>

	<Hero
		pTitle="ختم مهندس نقابي"
		pDesc="خدمة ختم واعتماد الرسومات والتقارير الهندسية من مهندس نقابي معتمد"
		pTitleClr={Colors.Gray5}
		pDescClr={Colors.Gray5}
		pPosL="40% 5% 20% 50%"
		pPosP="20% 5% 50% 5%"
		pBlurL="off"
		pBlurP="off"
	>

		<EmoList
			data-land-only
			pTitle={Text.Body.OfText("الخدمة موجهة لـ :")}
			pWidth={new RespString("700px", "100%")}
			pNumbered={false}
			pItems={[
				"أصحاب المحلات التجارية لغرض ختم الرسم الهندسي للترخيص .",
				"الصيادلة لغرض ختم الرسم الهندسي للترخيص .",
				"أصحاب المعامل الطبية لغرض ختم الرسم الهندسي للترخيص .",
				"كل من يحتاج ختمًا نقابيًا مقبولًا لدى جهات الترخيص والجهات الإدارية ."
			]}
		/>

	</Hero>

	<ESec data-port-only>

		<EmoList
			pTitle={Text.Body.OfText("الخدمة موجهة لـ :")}
			pWidth={new RespString("700px", "90%")}
			pNumbered={false}
			pItems={[
			"أصحاب المحلات التجارية لغرض ختم الرسم الهندسي للترخيص .",
			"الصيادلة لغرض ختم الرسم الهندسي للترخيص .",
			"أصحاب المعامل الطبية لغرض ختم الرسم الهندسي للترخيص .",
			"كل من يحتاج ختمًا نقابيًا مقبولًا لدى جهات الترخيص والجهات الإدارية ."
		]}
		/>

	</ESec>

	<ESec
		id="WhyUs"
		pBg={new ElemBg(Colors.WhiteOff)}
	>
		<SecTitle
			pTitle="لماذا نحن ؟"
			style={`--StripBg:${Colors.WhiteOff};`}
		/>

		<HzStack>

			<VrStack pBgColor={new ElemBg(Colors.SkyLite)}>

				<Emograph pText={Text.Body.Centered.OfText("ختم مهندس نقابي مقبول لدى جهات الترخيص المحلية والجهات الإدارية المختلفة .")} />

			</VrStack>

			<VrStack pBgColor={new ElemBg(Colors.SkyLite)}>

				<Emograph pText={Text.Body.Centered.OfText("نرشدك ونوفر لك الختم الصحيح المطلوب لحالتك إذا كان بدرجة أعلى من ختم مهندس نقابي .")} />

			</VrStack>

			<VrStack pBgColor={new ElemBg(Colors.SkyLite)}>

				<Emograph pText={Text.Body.Centered.OfText("تجربة عملية مع عشرات ملفات الترخيص المتنوعة ( محال تجارية - صيدليات - معامل تحاليل طبية ) .")} />

			</VrStack>

			<VrStack pBgColor={new ElemBg(Colors.SkyLite)}>

				<Emograph pText={Text.Body.Centered.OfText("التزام تام بالسرية في التعامل مع الرسومات والبيانات المقدمة لا يتعدى حدود عملية تنفيذ الختم .")} />

			</VrStack>

		</HzStack>

	</ESec>

	<ESec
		id="UnionEngineer"
		pBg={new ElemBg(Colors.Gray1)}
	>
		<SecTitle
			pTitle="ما المقصود بـ مهندس نقابي ؟"
			style={`--StripBg:${Colors.Gray1};`}
		/>

		<Emograph pText={Text.Body.Centered.OfText("​المهندس النقابي هو مهندس مقيد بنقابة المهندسين ذو خبرة من 3 إلى 15 سنة وحاصل على سجل هندسي")} />

	</ESec>

	<ESec
		id="StampSpecs"
		pBg={new ElemBg(Colors.WhiteOff)}
	>
		<SecTitle
			pTitle="ما هي مواصفات الختم المعتمد ؟"
			style={`--StripBg:${Colors.WhiteOff};`}
		/>

		<VrStack>

			<Emograph pText={Text.Body.Centered.OfText("ليكون ختم المهندس النقابي مقبولا يجب أن يتكون من :")} />

			<EmoList
				pWidth={new RespString("560px", "100%")}
				pDesc={Text.Body.OfText("")}
				pNumbered={false}
				pItems={[
					"اسم المهندس",
					"رقم العضوية بنقابة المهندسين",
					"رقم السجل الهندسي"
				]}
			/>

		</VrStack>

	</ESec>

	<ESec
		id="Cost"
		pBg={new ElemBg(Colors.Gray5)}
	>
		<SecTitle
			pTitle="تكلفة ختم مهندس نقابي"
			style={`--StripBg:${Colors.Gray5};`}
		/>

		<HzStack>

			<VrStack pBgColor={new ElemBg(Colors.Bistage)}>

				<Emograph
					pTitle={Text.H3.Centered.Gray5.OfText("1000 جنيه")}
					pText={Text.Body.Centered.Gray5.OfText("ختم مهندس نقابي لرسومات ترخيص محل تجاري أو صيدلية لعدد 3 نسخ أو أكثر")}
				/>

			</VrStack>

			<VrStack pBgColor={new ElemBg(Colors.Bistage)}>

				<Emograph
					pTitle={Text.H3.Centered.Gray5.OfText("تبدأ من 1000 جنيه")}
					pText={Text.Body.Centered.Gray5.OfText("ختم مهندس نقابي لرسومات أو تقارير هندسية لأغراض عامة حسب المطلوب وعدد اللوحات")}
				/>

			</VrStack>

		</HzStack>

	</ESec>

</BLayout>
