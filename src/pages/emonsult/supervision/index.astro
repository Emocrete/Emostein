---
import BLayout from "@/Layout.astro";
import { Badge, EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout pSchemaType="CollectionPage" pTitle="خدمات الإشراف الهندسي" pDescr="​خدمة احترافية للإشراف الهندسي على أعمال البناء والتشطيبات">







	<Hero>

		<VrStack
			pSize={new Size(new NumPer("40%","100%"))}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("15%","10%"))}
			pHzAlign={"Center"}
			pBg={new ElemBg(Colors.WhiteOff)}
			pBgOpacity={new Percent(20)}
		>

			<Emograph
				pTitle={Text.H1.Centered.White.OfText("خدمات الإشراف الهندسي")}
				pText={Text.Body.Centered.White.OfText("​خدمة احترافية للإشراف الهندسي على أعمال البناء والتشطيبات")}
			/>

			<Badge
				pLandOnly
				pYears={15}
				pMobMaxCols={2}
				pScopeText="القاهرة والجيزة"
				pColor="white"
			/>

			<HzStack pGap={new Pixel(30,10)} pForceHz>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
