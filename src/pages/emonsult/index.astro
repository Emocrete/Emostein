---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="خدمات استشارية هندسية"
	pDescr="خدمات استشارية هندسية تشمل الشهادات الهندسية، التقارير الفنية، والأختام والاعتمادات الهندسية للرسومات والمستندات أمام الجهات الإدارية وشركات المرافق والجهات الخاصة."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("0%","2.5%"),new NumPer("30%","15%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("خدمات استشارية هندسية")}
				pText={Text.Body.Centered.OfText("خدمات استشارية هندسية تشمل الشهادات الهندسية، التقارير الفنية، والأختام والاعتمادات الهندسية للرسومات والمستندات أمام الجهات الإدارية وشركات المرافق والجهات الخاصة.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
