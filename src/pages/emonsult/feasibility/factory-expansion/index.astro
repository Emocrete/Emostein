---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, EmoDet, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { AngleBand, RadialItem, RadialLayout } from "@/Widgets/Layouts";
import { Hero } from "@/Widgets/Sections";
import { Colors, ElemBg, Loc, NumPer, Percent, Pixel, RespString, Size, Text } from "@/TypesLib";
---

<BLayout
	pSchemaType="Service"
	pTitle="دراسة جدوى توسعة مصنع"
	pDescr="دراسة جدوى توسعة مصنع — دراسة هندسية مبكرة تربط المساحة والاشتراطات والبدائل الفنية والتكلفة التقريبية بقرار الاستثمار قبل الدخول في تصميم وتنفيذ كامل. وفي هذه الصفحة يكون التركيز الخاص على تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات. سعر مبدئي استرشادي ومراحل واضحة لبدء الخدمة."
>

	<Hero Readable pImgAlt="دراسة جدوى توسعة مصنع">

		<VrStack
			pBg={new ElemBg(Colors.SkyLite)}
			pBgOpacity={new Percent(85)}
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("10%","10%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pGap={new Pixel(20,10)}
			pPad={new Pixel(10,5)}
			pHzAlign="Center"
			pVrAlign="Center"
		>

			<Emograph
				pTitle={Text.H1.Centered.WithColor(Colors.Black).OfText("دراسة جدوى توسعة مصنع")}
				pText={Text.Body.Centered.WithColor(Colors.Black).OfText("دراسة هندسية مبكرة تربط المساحة والاشتراطات والبدائل الفنية والتكلفة التقريبية بقرار الاستثمار قبل الدخول في تصميم وتنفيذ كامل. وفي هذه الصفحة يكون التركيز الخاص على تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>
				<EmoCallIcon BlackSky />
				<EmoWhatsIcon BlackSky />
				<EmoDet BistageBlack pHref="#secSrvCost" pHeight="58px" />
			</HzStack>

		</VrStack>

	</Hero>


	<RadialLayout pCount={4} pDiameter={new RespString("820px","96%")} pOrbit={new RespString("38%","36%")} pCenterSize={new RespString("30%","36%")} pBg={Colors.Gray1} pCenterBg={Colors.BrownDark} pCenterColor={Colors.WhiteOff} pRingColor={Colors.Gray3} pAccent={Colors.Bistage} pCenterTitle="دراسة جدوى توسعة مصنع" pCenterText="مسار الخدمة" pStackPortrait={true}>
		<RadialItem pTitle="المدخلات" pText="تحديد السيناريوهات والقيود مع مراعاة تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات" pBg={Colors.WhiteOff} pColor={Colors.Black} pAccent={Colors.Bistage} />
		<RadialItem pTitle="المعالجة" pText="تقدير المساحات والتكلفة والاحتياجات" pBg={Colors.SkyLite} pColor={Colors.Black} pAccent={Colors.SkyDark} />
		<RadialItem pTitle="المخرج" pText="مقارنة البدائل وتوصية بالمسار الأنسب" pBg={Colors.Creamy} pColor={Colors.Black} pAccent={Colors.OrangeDark} />
		<RadialItem pTitle="الفائدة" pText="تساعد على استبعاد البدائل الضعيفة مبكرًا وتوضح أين تتركز التكلفة والمخاطر والعائد الهندسي الممكن من المشروع. ويُراجع القرار هنا تحديدًا في ضوء تدفق الإنتاج والخامات والمنتج والحركة الصناعية والسلامة والخدمات." pBg={Colors.BistageLite} pColor={Colors.Black} pAccent={Colors.BistageDark} />
	</RadialLayout>

	<AngleBand id="secSrvCost" pBg={Colors.Black} pColor={Colors.WhiteOff} pDirection="Rise">
		<VrStack pGap={new Pixel(14,10)} pHzAlign="Center">
			<Emograph
				pTitle={Text.H2.Centered.WithColor(Colors.WhiteOff).OfText("سعر مبدئي للدرافـت")}
				pText={Text.Body.Centered.WithColor(Colors.WhiteOff).OfText("يبدأ من 7,500 ج.م للدراسة المبدئية؛ الدراسات الاستثمارية الموسعة تسعر حسب البيانات المطلوبة.")}
			/>
			<Emograph pText={Text.Body.Centered.WithColor(Colors.Gray2).OfText("السعر استرشادي لتحديد موضع الخدمة داخل الموقع؛ العرض النهائي يتحدد بعد معرفة الموقع والمساحة والمستندات والنطاق الفعلي.")} />
		</VrStack>
	</AngleBand>

</BLayout>
