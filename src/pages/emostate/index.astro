---
import { Align, Colors, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
import BLayout from "@/Layout.astro";
import { CardsGr, EmoCall, EmoFaq, Emograph, EmoList, EmoStrip, ESec, FaqItem, Hero, HzStack, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices, RespImg, SecTitle, VrStack } from "@/Widgets";
---




















<BLayout
	pSchemaType="CollectionPage"
	pTitle="تسويق عقاري"
	pDescr="تسويق عقاري للعقارات المعروضة للبيع والإيجار في مساكن شيراتون والنزهة ومصر الجديدة، يشمل شقق للبيع وشقق للإيجار وشقق مفروش ومحلات للبيع ومحلات للإيجار."
>

	<Hero
		pTitle="تسويق عقاري"
		pDesc="للعرض والطلب في مساكن شيراتون والنزهة ومصر الجديدة"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="44% 46% 10% 8%"
		pPosP="18% 6% 18% 6%"
	>

		<EmoCall BlackSky pText="اعرض عقارك أو اسأل عن المتاح" />

	</Hero>

	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>
		<SecTitle
			pTitle="تسويق عقاري بمنطقة مساكن شيراتون و النزهة و مصر الجديدة"
			pDesc="صفحة مخصصة للعرض والطلب، تجمع المعروضات العقارية النشطة وتفصلها حسب نوع العقار وطريقة التعامل"
			style={`--StripBg:${Colors.GreenLite};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(30, 16)} pPad={new Pixel(30, 10)}>

				<RespImg
					pImg={new EmoMediaData(
						"Img",
						"https://static.wixstatic.com/media/",
						"308dfd_4a53e2c65a9a424ab927fc05bc454765~mv2.jpg/v1/fill/w_980%2Ch_551%2Cal_c%2Cq_85%2Cusm_0.66_1.00_0.01%2Cenc_avif%2Cquality_auto/308dfd_4a53e2c65a9a424ab927fc05bc454765~mv2.jpg",
						false,
						"تسويق عقاري مساكن شيراتون",
						new Size(new NumPer(560, "100%"), new NumPer("auto", "auto"))
					)}
				/>

				<Emograph
					pTitle={Text.H3.OfText("الصفحة ليست منصة إعلانات عامة")}
					pText={Text.Body.OfText("الغرض من الصفحة هو عرض العقارات المتاحة فعليًا أو استقبال طلبات البيع والإيجار في نطاقات محددة، مع تقديم بيانات واضحة عن السعر والموقع والمساحة والحالة والتشطيب حتى يعرف العميل هل المعروض مناسب له قبل الاتصال.")}
					pSize={new Size(new NumPer(560, "100%"), new NumPer("auto", "auto"))}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>
		<SecTitle
			pTitle="المعروض الحالي"
			pDesc="شقة للبيع في مصر الجديدة بالقرب من شارع عبد العزيز فهمي والكلية الحربية"
			style={`--StripBg:${Colors.Gray5};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.Gray1)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<HzStack pGap={new Pixel(26, 14)} pPad={new Pixel(30, 10)}>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("شقة للبيع مصر الجديدة")}
					pDesc={Text.Body.Centered.OfText("بيانات المعروض كما هي في صفحة التسويق العقاري")}
					pHeadBg={new ElemBg(Colors.WhiteOff)}
					pItemsBg={new ElemBg(Colors.SkyLite)}
					pNumbered={false}
					pItems={[
						{ Title: "السعر", Items: ["المطلوب 1,200,000"] },
						{ Title: "الموقع", Items: ["شارع عبد العزيز فهمي - أمام البوابة الرئيسية للكلية الحربية ومسرح يوسف السباعي"] },
						{ Title: "الدور والواجهة", Items: ["الدور: الأرضي", "الواجهة: خلفية"] },
						{ Title: "المساحة", Items: ["المساحة التعاقدية: 125 م2", "المساحة الفعلية: 110 م2"] },
						{ Title: "التوزيع الداخلي", Items: ["صالة 3 قطع", "مطبخ مفتوح", "حمام", "2 غرفة"] },
						{ Title: "التشطيب", Items: ["سوبر لوكس بحالة جيدة جدا"] }
					]}
				/>

				<VrStack pGap={new Pixel(20, 14)} pPad={new Pixel(0, 0)}>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_0fc1f2d6bc094444a22298da53ee4082~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_0fc1f2d6bc094444a22298da53ee4082~mv2.jpg",
							false,
							"مخطط الشقة المعروضة للبيع",
							new Size(new NumPer(360, "100%"), new NumPer("auto", "auto"))
						)}
					/>

					<EmoCall BlackSky pText="استفسر عن الشقة" />

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>
		<SecTitle
			pTitle="صور الشقة المعروضة"
			pDesc="صور داخلية للفراغات والتشطيب وبعض عناصر الحمام والمعيشة"
			style={`--StripBg:${Colors.SkyLite};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack pGap={new Pixel(20, 14)} pPad={new Pixel(30, 10)}>

				<HzStack pGap={new Pixel(18, 12)} pPad={new Pixel(0, 0)}>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_0538be99bd9e4cfdaf198d9956943269~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_0538be99bd9e4cfdaf198d9956943269~mv2.jpg",
							false,
							"صورة داخلية من الشقة",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_bf06c8dac9df44b7984f4e24580ea198~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_bf06c8dac9df44b7984f4e24580ea198~mv2.jpg",
							false,
							"منطقة معيشة داخل الشقة",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_d43f2318386a4429b3447b1fde9b1e62~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_d43f2318386a4429b3447b1fde9b1e62~mv2.jpg",
							false,
							"سفرة داخل الشقة",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

				</HzStack>

				<HzStack pGap={new Pixel(18, 12)} pPad={new Pixel(0, 0)}>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_cc65769b9c4a4ac39ae78de2294a5d61~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_cc65769b9c4a4ac39ae78de2294a5d61~mv2.jpg",
							false,
							"غرفة داخل الشقة",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_051a7a95edbe470dbf4952bcacdb828c~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_051a7a95edbe470dbf4952bcacdb828c~mv2.jpg",
							false,
							"كابينة حمام",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_f14e6967afe44adcbf21a6eb214973e9~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_f14e6967afe44adcbf21a6eb214973e9~mv2.jpg",
							false,
							"حوض حمام",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

				</HzStack>

				<HzStack pGap={new Pixel(18, 12)} pPad={new Pixel(0, 0)}>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_d97048e9d16c4f21836acd58ed84dab9~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_d97048e9d16c4f21836acd58ed84dab9~mv2.jpg",
							false,
							"غرفة نوم داخل الشقة",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

					<RespImg
						pImg={new EmoMediaData(
							"Img",
							"https://static.wixstatic.com/media/",
							"308dfd_2a6481359bc84ac28db17d392e1e82e1~mv2.jpg/v1/fill/w_354%2Ch_472%2Cq_90%2Cenc_avif%2Cquality_auto/308dfd_2a6481359bc84ac28db17d392e1e82e1~mv2.jpg",
							false,
							"تفاصيل داخلية من الشقة",
							new Size(new NumPer(300, "100%"), new NumPer("auto", "auto"))
						)}
					/>

				</HzStack>

			</VrStack>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>
		<SecTitle
			pTitle="فروع العرض والطلب"
			pDesc="تقسيم المعروضات حسب نوع العقار، مع توضيح حالة كل فرع بدل خلط كل الطلبات في صفحة واحدة"
			style={`--StripBg:${Colors.BistageDark};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<CardsGr
				pWidth={new RespString("1220px", "100%")}
				pCardBg={new ElemBg(Colors.WhiteOff)}
				pGrTitle={Text.H3.Centered.White.OfText("المتاح حاليًا")}
				pCardTitleFnt={Text.H4}
				pCardBodyFnt={Text.Body}
				pTopic1={new Topic("شقق للبيع", "يوجد معروض حاليًا: شقة للبيع في مصر الجديدة بسعر مطلوب 1,200,000، أرضي، مساحة تعاقدية 125 م2، ومساحة فعلية 110 م2.")}
				pTopic2={new Topic("شقق للإيجار", "لا يوجد معروضات حاليًا. يمكن تسجيل طلبك وسيتم التواصل عند توفر وحدة مناسبة.")}
				pTopic3={new Topic("شقق مفروش", "لا يوجد معروضات حاليًا. يتم استقبال طلبات الإيجار المفروش حسب المنطقة والمدة والميزانية.")}
				pTopic4={new Topic("محلات للبيع", "لا يوجد معروضات حاليًا. يمكن استقبال بيانات المحلات المطلوب تسويقها أو طلبات الشراء الجادة.")}
				pTopic5={new Topic("محلات للإيجار", "لا يوجد معروضات حاليًا. عند توفر محلات مناسبة سيتم عرض بياناتها الأساسية بوضوح.")}
				pTopic6={new Topic("صيدليات للبيع", "لا يوجد معروضات حاليًا. تعرض الصيدليات عند توفر بيانات قانونية وموقعية كافية للفحص.")}
				pTopic7={new Topic("صيدليات للإيجار", "لا يوجد معروضات حاليًا. يتم التعامل مع هذا النوع بحذر بسبب حساسية الموقع والتراخيص والمسافات.")}
			/>

		</EmoStrip>

	</ESec>

	<ESec
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>
		<SecTitle
			pTitle="طريقة عرض العقار"
			pDesc="العقار الجيد لا يكفي أن يقال عنه للبيع أو للإيجار؛ يجب أن تعرض بياناته بترتيب يختصر وقت البائع والمشتري"
			style={`--StripBg:${Colors.OrangeLite};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.WhiteOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<EmoList
				pWidth={new RespString("980px", "100%")}
				pTitle={Text.H3.Centered.OfText("البيانات المطلوبة لإضافة عقار")}
				pDesc={Text.Body.Centered.OfText("كلما كانت بيانات العقار واضحة من البداية، زادت جدية التواصل وقلت المكالمات غير المناسبة")}
				pHeadBg={new ElemBg(Colors.Creamy)}
				pItemsBg={new ElemBg(Colors.SkyLite)}
				pNumbered={true}
				pItems={[
					{ Title: "بيانات الموقع", Items: ["المنطقة والشارع وأقرب علامة واضحة.", "الدور والواجهة وحالة المدخل أو العمارة إن كانت مؤثرة."] },
					{ Title: "بيانات المساحة", Items: ["المساحة التعاقدية إن وجدت.", "المساحة الفعلية أو التقريبية.", "التوزيع الداخلي بعدد الغرف والحمامات والمطبخ والاستقبال."] },
					{ Title: "بيانات الحالة", Items: ["نوع التشطيب وحالته.", "وجود أثاث أو أجهزة في حالة المفروش.", "أي عيوب أو ملاحظات جوهرية يجب توضيحها قبل المعاينة."] },
					{ Title: "بيانات السعر", Items: ["السعر المطلوب أو قيمة الإيجار.", "مدى قابلية التفاوض.", "شروط الدفع أو التأمين أو المدة في حالة الإيجار."] },
					{ Title: "الصور والمخطط", Items: ["صور واضحة للفراغات الرئيسية.", "يفضل وجود كروكي أو مخطط بسيط عند توفره.", "الصور غير الواضحة تقلل جودة الاستفسارات حتى لو كان العقار جيدًا."] }
				]}
			/>

		</EmoStrip>

	</ESec>

	<ESec
		id="cta"
		pBg={new ElemBg(Colors.BlackOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>
		<SecTitle
			pTitle="اعرض عقارك أو اطلب عقارًا مناسبًا"
			pDesc="اتصل لإرسال بيانات العقار المعروض أو تسجيل طلب شراء أو إيجار داخل مساكن شيراتون والنزهة ومصر الجديدة"
			style={`--StripBg:${Colors.BlackOff};`}
		/>

		<EmoStrip pBg={new ElemBg(Colors.BlackOff)} pHzAlign={Align.Center}
 pVrAlign={Align.Center}>

			<VrStack pGap={new Pixel(22, 14)} pPad={new Pixel(30, 10)}>

				<Emograph
					pTitle={Text.H3.Centered.White.OfText("المكالمة الأولى هدفها الفرز لا الضغط")}
					pText={Text.Body.Centered.White.OfText("في حالة البيع أو الإيجار نراجع نوع العقار، المنطقة، المساحة، السعر، جاهزية الصور، ومدى جدية العرض أو الطلب. بعدها يمكن تحديد طريقة العرض أو ترتيب المعاينة عند وجود توافق حقيقي.")}
					pSize={new Size(new NumPer(980, "100%"), new NumPer("auto", "auto"))}
				/>

				<EmoCall BlackSky pText="اتصل الآن" />

			</VrStack>

		</EmoStrip>

	</ESec>

	<EmoFaq>

		<FaqItem
			pQuestion="هل الصفحة مخصصة للبيع فقط؟"
			pAnswer="لا. الصفحة تشمل العرض والطلب، ويمكن استخدامها لعرض شقق للبيع أو للإيجار أو مفروش، وكذلك المحلات والصيدليات عند توفر معروضات فعلية."
		/>

		<FaqItem
			pQuestion="هل توجد شقق للإيجار حاليًا؟"
			pAnswer="حسب حالة الصفحة الحالية لا يوجد معروضات في فرع شقق للإيجار، ويمكن تسجيل طلبك للتواصل عند توفر وحدة مناسبة."
		/>

		<FaqItem
			pQuestion="هل توجد محلات للبيع أو الإيجار؟"
			pAnswer="لا يوجد معروضات حاليًا في فروع المحلات للبيع أو الإيجار، لكن يمكن استقبال بيانات محل مطلوب تسويقه أو طلب محل بمواصفات محددة."
		/>

		<FaqItem
			pQuestion="ما البيانات المطلوبة لعرض شقة؟"
			pAnswer="نحتاج الموقع، الدور، الواجهة، المساحة، التوزيع الداخلي، حالة التشطيب، السعر المطلوب، وصور واضحة للفراغات الأساسية."
		/>

		<FaqItem
			pQuestion="هل يتم عرض الصيدليات مثل الشقق والمحلات؟"
			pAnswer="الصيدليات تحتاج مراجعة أكثر حساسية بسبب الموقع والتراخيص والمسافات، لذلك لا تعرض إلا عند توفر بيانات كافية تسمح بتقييمها بوضوح."
		/>

	</EmoFaq>

	<ReadAlso

>

	<ReadAlsoItem
		pTitle="شقق للبيع"
		pDesc="فرع مخصص للشقق المعروضة للبيع وبيانات السعر والمساحة والموقع."
		pHref="/emostate/apartment"
	/>

	<ReadAlsoItem
		pTitle="شقق للإيجار"
		pDesc="طلبات ومعروضات الشقق الإيجار عند توفر وحدات مناسبة."
		pHref="/emostate/apartment/rent"
	/>

	<ReadAlsoItem
		pTitle="شقق مفروش"
		pDesc="فرع خاص بالشقق المفروشة للإيجار حسب المنطقة والمدة والميزانية."
		pHref="/emostate/apartment/furn"
	/>

	<ReadAlsoItem
		pTitle="محلات للبيع"
		pDesc="عرض المحلات المتاحة للبيع مع بيانات الموقع والمساحة والسعر."
		pHref="/emostate/retail"
	/>

	<ReadAlsoItem
		pTitle="محلات للإيجار"
		pDesc="طلبات ومعروضات المحلات الإيجار عند توفر بيانات مناسبة."
		pHref="/emostate/retail/rent"
	/>

</ReadAlso>

	<RelServices>

		<RelServiceItem
			pTitle="تشطيب شقق"
			pDesc="خدمة تشطيب الشقق وتجهيزها للسكن أو العرض أو التأجير."
			pHref="/emocrete/finishing"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تجهيز المحلات التجارية من التصميم والتنفيذ حتى ملاءمة التشغيل."
			pHref="/emocrete/finishing/retail"
		/>

