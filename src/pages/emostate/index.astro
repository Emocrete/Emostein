---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="CollectionPage"
	pTitle="تسويق عقاري"
	pDescr="تسويق عقاري للعقارات المعروضة للبيع والإيجار في مساكن شيراتون والنزهة ومصر الجديدة، يشمل شقق للبيع وشقق للإيجار وشقق مفروش ومحلات للبيع ومحلات للإيجار."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("تسويق عقاري")}
				pText={Text.Body.Centered.OfText("تسويق عقاري للعقارات المعروضة للبيع والإيجار في مساكن شيراتون والنزهة ومصر الجديدة، يشمل شقق للبيع وشقق للإيجار وشقق مفروش ومحلات للبيع ومحلات للإيجار.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
