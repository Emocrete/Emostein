---
import BLayout from "@/Layout.astro";
import { EmoCall, Emograph, VrStack } from "@/Widgets/Comp";
import { ApartmentSaleForm } from "@/Widgets/Forms";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { Loc, NumPer, Size, Text } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="شقق مفروش"
	pDescr="خدمة تسويق شقق مفروشة للإيجار، تشمل تجهيز وصف الشقة والمنقولات، تحديد مدة الإقامة والتأمين، فرز العملاء، وتنظيم التسليم والاستلام."
>







	<Hero>

		<VrStack
			pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("30%","15%"))}
			pSize={new Size(new NumPer("40%","95%"))}
			pHzAlign={"Center"}
		>

			<Emograph
				pTitle={Text.H1.Centered.OfText("شقق مفروش")}
				pText={Text.Body.Centered.OfText("خدمة تسويق شقق مفروشة للإيجار، تشمل تجهيز وصف الشقة والمنقولات، تحديد مدة الإقامة والتأمين، فرز العملاء، وتنظيم التسليم والاستلام.")}
			/>

			<EmoCall BlackSky />

		</VrStack>

	</Hero>







	<EmoSec>

		<ApartmentSaleForm pSourcePage="شقق للإيجار" pWhatsapp="201014490054" />

	</EmoSec>







	<ReadAlso>

		<ReadAlsoItem
			pTitle="تسويق عقاري"
			pDesc="الصفحة الرئيسية لمجموعة التسويق العقاري."
			pHref="/emostate"
		/>

		<ReadAlsoItem
			pTitle="شقق للإيجار"
			pDesc="تسويق شقة خالية أو نصف مفروشة للإيجار."
			pHref="/emostate/apartment/rent"
		/>

		<ReadAlsoItem
			pTitle="شقق للبيع"
			pDesc="تسويق شقة للبيع وفرز المشترين."
			pHref="/emostate/apartment"
		/>

	</ReadAlso>







	<RelServices>

		<RelServiceItem
			pTitle="تشطيب شقق"
			pDesc="تجهيز الشقة المفروشة أو إصلاحها قبل العرض."
			pHref="/emocrete/finishing/apartment"
		/>

		<RelServiceItem
			pTitle="تكلفة تشطيب شقة"
			pDesc="حساب تكلفة الإصلاحات قبل التأجير المفروش."
			pHref="/emocrete/finishing/apartment/cost"
		/>

		<RelServiceItem
			pTitle="تصميم داخلي"
			pDesc="تحسين توزيع وأثاث الوحدة قبل تسويقها كمفروش."
			pHref="/emodsign/des/cr/int"
		/>

	</RelServices>







	<EmoFaq>

		<FaqItem pQuestion="هل قائمة المنقولات ضرورية؟" pAnswer="نعم، لأنها تحدد ما تم تسليمه وحالته وتقلل الخلاف عند الاستلام النهائي." />

		<FaqItem
			pQuestion="هل التأمين أعلى من الإيجار العادي؟"
			pAnswer="غالبًا يحتاج الإيجار المفروش تأمينًا مناسبًا لقيمة المنقولات والأجهزة، ويتم تحديده حسب حالة الشقة وطبيعة الإقامة."
		/>

		<FaqItem
			pQuestion="هل يمكن التأجير اليومي؟"
			pAnswer="يمكن دراسة ذلك حسب رغبة المالك وطبيعة الوحدة والمنطقة، مع ضرورة مراجعة أي اشتراطات تنظيمية عند تحويل الوحدة لتشغيل سياحي متكرر."
		/>

		<FaqItem
			pQuestion="هل يتم قبول أسر أو أفراد؟"
			pAnswer="يتم الالتزام بما يحدده المالك من نوع العميل وعدد الأفراد وقواعد الاستخدام قبل ترتيب المعاينة."
		/>

	</EmoFaq>







</BLayout>
