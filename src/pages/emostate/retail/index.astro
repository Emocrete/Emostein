---
import BLayout from "@/Layout.astro";
import { CardsGr } from "@/Widgets/Cards";
import { EmoCall, Emograph, EmoList, HzStack, SecTitle, VrStack } from "@/Widgets/Comp";
import { RespImg } from "@/Widgets/Media";
import { EmoFaq, EmoSec, FaqItem, Hero, ReadAlso, ReadAlsoItem, RelServiceItem, RelServices } from "@/Widgets/Sections";
import { EmoStr } from "@/Widgets/Strips";
import { Align, Colors, ElemBg, EmoMediaData, NumPer, Pixel, RespString, Size, Text, Topic } from "@/TypesLib";
---




















<BLayout
	pSchemaType="Service"
	pTitle="محلات للبيع"
	pDescr="خدمة تسويق محلات للبيع، تشمل تجهيز بيانات المحل، إبراز الموقع والواجهة والمرافق، توضيح قابلية النشاط والترخيص، فرز المشترين، ومتابعة التفاوض."
>







	<Hero
		pImgL="/Media/Emostate/Retail/Sell/HeroD.webp"
		pImgP="/Media/Emostate/Retail/Sell/HeroM.webp"
		pTitle="محلات للبيع"
		pDesc="تسويق محل تجاري للبيع بإبراز الموقع والواجهة وقابلية التشغيل والاستثمار"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pHzAlign="center"
		pVrAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="44% 8% 12% 8%"
		pPosP="42% 5% 10% 5%"
	>

		<EmoCall BlackSky pText="اعرض محلك للبيع" />

	</Hero>







	<EmoSec
		id="Intro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.GreenLite};`}
			pTitle="بيع المحل يعتمد على قوة الموقع وقابلية النشاط"
			pDesc="المشتري التجاري لا ينظر للمساحة فقط؛ يهتم بالواجهة، الحركة، الرؤية من الشارع، المرافق، الاشتراطات، وإمكانية الترخيص للنشاط المستهدف"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<RespImg
					pImg={new EmoMediaData("Img", "/Media/Emostate/Retail/Sell/", "HeroD.webp", false, "محلات للبيع", new Size(new NumPer(520, "100%"), new NumPer("auto", "auto")))}
				/>

				<VrStack
					pWidth={new Pixel(700, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(0, 0)}
				>

					<Emograph
						pTitle={Text.H3.OfText("المحل يُباع كفرصة تشغيل")}
						pText={Text.Body.OfText("عرض المحل التجاري يجب أن يشرح للمشتري كيف يمكن أن يعمل المكان: واجهة المحل، عمق المساحة، عرض الشارع، قربه من كثافة سكانية أو حركة مشاة، حالة التشطيب، الكهرباء، المياه، الصرف، وإمكانية التعديل لنشاط جديد.")}
						pSize={new Size(new NumPer(700, "100%"), new NumPer("auto", "auto"))}
					/>

					<CardsGr
						pWidth={new RespString("700px", "100%")}
						pCardBg={new ElemBg(Colors.Gray1)}
						pCardTitleFnt={Text.H4.Centered}
						pCardBodyFnt={Text.Body.Centered}
						pTopic1={new Topic("واجهة وموقع", "العناصر الأولى في تقييم المحل التجاري")}
						pTopic2={new Topic("قابلية ترخيص", "مراجعة أولية لنوع النشاط المتوقع ومتطلباته")}
						pTopic3={new Topic("عائد استثماري", "شرح إمكانية البيع لمستخدم نهائي أو مستثمر")}
					/>

				</VrStack>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="Data"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="بيانات المحل قبل الإعلان"
			pDesc="المحل التجاري يحتاج معلومات مختلفة عن الشقة السكنية"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.Gray1)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("بيانات الموقع")}
					pDesc={Text.Body.Centered.OfText("تعطي صورة عن قوة المحل")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"المنطقة والشارع والعلامات القريبة",
						"عرض الواجهة وارتفاع الفتحات",
						"مساحة الدور الأرضي وأي دور إضافي أو مخزن",
						"عرض الشارع وإمكانية الوقوف أو التحميل",
						"وجود حركة مشاة أو قرب خدمات أو تجمعات سكنية"
					]}
				/>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("بيانات تشغيل")}
					pDesc={Text.Body.Centered.OfText("تؤثر على نوع المشتري")}
					pHeadBg={new ElemBg(Colors.SkyLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"حالة الكهرباء والمياه والصرف",
						"وجود عداد تجاري أو إمكانية التوصيل",
						"حالة التشطيب واللافتة والواجهة",
						"النشاط السابق إن وجد",
						"الأنشطة غير المناسبة للمكان إن كانت معروفة"
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="License"
		pBg={new ElemBg(Colors.WhiteOff)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.SkyLite};`}
			pTitle="قابلية الترخيص ترفع جودة العرض"
			pDesc="المشتري التجاري يسأل سريعًا: هل يصلح المحل للنشاط الذي أريده؟"
		/>

		<EmoStr
			pBg={new ElemBg(Colors.WhiteOff)}
			pHzAlign={Align.Center}
			pVrAlign={Align.Center}
		>

			<HzStack pGap={new Pixel(30, 15)} pPad={new Pixel(30, 15)}>

				<Emograph
					pTitle={Text.H3.OfText("ليس كل محل مناسبًا لكل نشاط")}
					pText={Text.Body.OfText("نشاط المطعم يختلف عن الصيدلية أو المكتب أو المعرض أو المخزن. قد تؤثر المساحة والواجهة والتهوية والموقع والدفاع المدني والجيران وطبيعة العقار على قبول النشاط. لذلك يفضل ذكر الأنشطة الأقرب للمحل بدل ترك الإعلان عامًا.")}
					pSize={new Size(new NumPer(560, "100%"), new NumPer("auto", "auto"))}
				/>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("مؤشرات مهمة")}
					pDesc={Text.Body.Centered.OfText("تضاف للعرض إن توفرت")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={false}
					pItems={[
						"هل يوجد رسم هندسي أو رخصة سابقة؟",
						"هل النشاط السابق قريب من النشاط المطلوب؟",
						"هل توجد مدخنة أو تهوية أو صرف مناسب؟",
						"هل الواجهة تسمح بلافتة واضحة؟",
						"هل العقار يسمح بنشاط تجاري فعلي؟"
					]}
				/>

			</HzStack>

		</EmoStr>

	</EmoSec>







	<EmoSec
		id="Process"
		pBg={new ElemBg(Colors.Gray1)}
		pHzAlign={Align.Center}
		pVrAlign={Align.Center}
	>

		<SecTitle
			style = {`--StripBg:${Colors.Gray5};`}
			pTitle="خطوات تسويق المحل للبيع"
			pDesc="من تجهيز العرض إلى فرز المشتري والتفاوض"
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.OfText("مراحل الخدمة")}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pCardTitleFnt={Text.H4.Centered}
			pCardBodyFnt={Text.Body.Centered}
			pStackDir="Row"
			pTopic1={new Topic("تقييم قابلية العرض", "مراجعة بيانات المحل وسعره وصلاحيته للعرض الجاد.")}
			pTopic2={new Topic("إبراز نقطة القوة", "واجهة، موقع، نشاط سابق، عائد إيجاري، أو قابلية تطوير.")}
			pTopic3={new Topic("فرز المشتري", "هل يبحث للتشغيل أم الاستثمار؟ وما النشاط المستهدف؟")}
			pTopic4={new Topic("تنظيم المعاينة", "شرح بيانات المحل قبل الزيارة وتحديد نقاط القياس المهمة.")}
			pTopic5={new Topic("التفاوض", "متابعة العروض والاعتراضات وربط السعر بعناصر القوة الحقيقية.")}
		/>

	</EmoSec>







	<EmoFaq>

		<FaqItem
			pQuestion="هل المحل يجب أن يكون مرخصًا قبل البيع؟"
			pAnswer="وجود رخصة أو نشاط سابق يساعد في العرض، لكنه ليس الشرط الوحيد؛ المهم توضيح الحالة الحالية وقابلية النشاط المقترح للمشتري."
		/>

		<FaqItem
			pQuestion="ما أهم بيانات المحل في الإعلان؟"
			pAnswer="الموقع، الواجهة، المساحة، المرافق، النشاط السابق، حالة التشطيب، وسعر البيع المطلوب."
		/>

		<FaqItem
			pQuestion="هل يتم تسويق المحل لمستثمر أم صاحب نشاط؟"
			pAnswer="يمكن تسويقه للنوعين، لكن صياغة الإعلان تختلف؛ المستثمر يهتم بالعائد، وصاحب النشاط يهتم بقابلية التشغيل والترخيص."
		/>

		<FaqItem
			pQuestion="هل يمكن ربط البيع بخدمة الترخيص؟"
			pAnswer="نعم، يمكن توجيه المشتري إلى خدمة الترخيص أو الرسم الهندسي إذا كان يحتاج تشغيل النشاط بعد الشراء."
		/>

	</EmoFaq>







	<ReadAlso pTitle={Text.H2.Centered.OfText("اقرأ أيضًا")}>

		<ReadAlsoItem
			pTitle="تسويق عقاري"
			pDesc="الصفحة الرئيسية لمجموعة التسويق العقاري."
			pHref="/emostate"
		/>

		<ReadAlsoItem
			pTitle="محلات للإيجار"
			pDesc="تسويق محل للإيجار وفرز المستأجرين حسب النشاط."
			pHref="/emostate/retail/rent"
		/>

		<ReadAlsoItem
			pTitle="شقق للبيع"
			pDesc="تسويق شقق للبيع داخل نفس مجموعة الخدمات."
			pHref="/emostate/apartment"
		/>

	</ReadAlso>







	<RelServices pTitle={Text.H2.Centered.White.OfText("خدمات مرتبطة بالمحل")}>

		<RelServiceItem
			pTitle="ترخيص محل تجاري"
			pDesc="متابعة ملف ترخيص المحل عند الشراء أو تغيير النشاط."
			pHref="/emoperm/retail/general"
		/>

		<RelServiceItem
			pTitle="رسم هندسي لمحل تجاري"
			pDesc="إعداد الرسم المطلوب للترخيص أو تعديل النشاط."
			pHref="/emoperm/retail/general/dwg"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تجهيز المحل للتشغيل بعد الشراء."
			pHref="/emocrete/finishing/retail"
		/>

	</RelServices>







</BLayout>
