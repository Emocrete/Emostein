---
import BLayout from "@/Layout.astro";
import { EmoCallIcon, Emograph, EmoWhatsIcon, HzStack, VrStack } from "@/Widgets/Comp";
import { Hero } from "@/Widgets/Sections";
import { Loc, NumPer, Pixel, Size, Text } from "@/TypesLib";
---





<BLayout
	pSchemaType="Service"
	pTitle="محلات للبيع"
	pDescr="خدمة تسويق محلات للبيع، تشمل تجهيز بيانات المحل، إبراز الموقع والواجهة والمرافق، توضيح قابلية النشاط والترخيص، فرز المشترين، ومتابعة التفاوض."
>







	<Hero>

		<VrStack pSize={new Size(new NumPer("40%","95%"))} pLoc={new Loc(new NumPer("5%","2.5%"),new NumPer("20%","20%"))} pHzAlign={"Center"}>

			<Emograph
				pTitle={Text.H1.Centered.OfText("محلات للبيع")}
				pText={Text.Body.Centered.OfText("خدمة تسويق محلات للإيجار، تشمل تجهيز بيانات المحل، تحديد الأنشطة المناسبة، فرز المستأجرين، تنظيم المعاينات، ومراجعة شروط الإيجار التجاري.")}
			/>

			<HzStack pGap={new Pixel(30,10)}>

				<EmoCallIcon BlackSky />

				<EmoWhatsIcon BlackSky />

			</HzStack>

		</VrStack>

	</Hero>







</BLayout>
