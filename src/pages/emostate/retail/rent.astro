---
import BLayout from "@/Layout.astro";
import { Text, ElemBg, Size, Align, Colors, RespString, Topic, Pixel, EmoMediaData } from "@/TypesLib";
import { Hero, ESec, EmoStrip, Emograph, CardsGr, EmoList, RespImg, EmoCall, EmoFaq, ReadAlso, RelServices, EmoPipelineStrip, SecTitle, VrStack, HzStack, ReadAlsoItem, FaqItem, RelServiceItem } from "@/Widgets";
---




















<BLayout
	pSchemaType="Service"
	pTitle="محلات للإيجار"
	pDescr="خدمة تسويق محلات للإيجار، تشمل تجهيز بيانات المحل، تحديد الأنشطة المناسبة، فرز المستأجرين، تنظيم المعاينات، ومراجعة شروط الإيجار التجاري."
>

	<Hero
		pImgL="/Media/Emostate/Retail/Rent/HeroD.webp"
		pImgP="/Media/Emostate/Retail/Rent/HeroM.webp"
		pTitle="محلات للإيجار"
		pDesc="تأجير محل تجاري لمستأجر مناسب للنشاط والموقع وشروط المالك"
		pTitleClr={Colors.WhiteOff}
		pDescClr={Colors.WhiteOff}
		pAlign="center"
		pBlurL="on"
		pBlurP="on"
		pPosL="44% 8% 12% 8%"
		pPosP="42% 5% 10% 5%"
	>

		<EmoCall BlackSky pText="اعرض محلك للإيجار" />

	</Hero>

	<ESec
		id="Intro"
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="إيجار المحل التجاري يحتاج مستأجرًا مناسبًا للنشاط"
			pDesc="كل نشاط له احتياجات مختلفة في الواجهة، الكهرباء، التهوية، الصرف، التخزين، حركة العملاء، ومواعيد التشغيل"
			style={`--StripBg:${Colors.GreenLite};`}
		/>

		<EmoStrip
			pBg={new ElemBg(Colors.WhiteOff)}

			pAlign={Align.Center}
>

			<HzStack


				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
>

				<RespImg pImg={new EmoMediaData("Img", "/Media/Emostate/Retail/Rent/", "HeroD.webp", false, "محلات للإيجار", new Size(520, "auto", "100%", "auto"))} />

				<VrStack

					pWidth={new Pixel(700, 340)}
					pGap={new Pixel(20, 15)}
					pPad={new Pixel(0, 0)}
>

					<Emograph
						pTitle={Text.H3.OfText("المحل لا يصلح لكل مستأجر")}
						pText={Text.Body.OfText("المستأجر المناسب هو الذي يتوافق نشاطه مع موقع المحل ومساحته وتجهيزاته وشروط المالك. لذلك يتم توضيح الأنشطة المقبولة وغير المقبولة، ومدة الإيجار، والتأمين، والزيادة، ومسؤولية التشطيب والتعديلات قبل ترتيب المعاينة.")}
						pSize={new Size(700, "auto", "100%", "auto")}
					/>

					<CardsGr
						pWidth={new RespString("700px", "100%")}
						pCardBg={new ElemBg(Colors.Gray1)}
						pCardTitleFnt={Text.H4.Centered}
						pCardBodyFnt={Text.Body.Centered}
						pTopic1={new Topic("نشاط مناسب", "فرز الأنشطة المقبولة قبل المعاينة")}
						pTopic2={new Topic("شروط واضحة", "مدة وقيمة وتأمين وزيادة ومسؤولية تعديلات")}
						pTopic3={new Topic("تشغيل مستقر", "تقليل احتمالات التعثر أو النزاع بعد بداية النشاط")}
					/>

				</VrStack>

			</HzStack>

		</EmoStrip>

	</ESec>

	<ESec
		id="Tenant"
		pBg={new ElemBg(Colors.Gray1)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="فرز المستأجر التجاري"
			pDesc="الأسئلة الأولى تحدد هل النشاط مناسب للمحل قبل ترتيب زيارة"
			style={`--StripBg:${Colors.Gray5};`}
		/>

		<EmoStrip
			pBg={new ElemBg(Colors.Gray1)}

			pAlign={Align.Center}
>

			<HzStack


				pGap={new Pixel(30, 15)}
				pPad={new Pixel(30, 15)}
>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("أسئلة النشاط")}
					pDesc={Text.Body.Centered.OfText("قبل تحديد المعاينة")}
					pHeadBg={new ElemBg(Colors.GreenLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"ما النشاط المطلوب تشغيله؟",
						"هل يحتاج تهوية أو مدخنة أو صرف خاص؟",
						"هل يحتاج قدرة كهربائية عالية؟",
						"هل توجد بضائع أو تحميل وتفريغ يومي؟",
						"هل النشاط يقبل موقع المحل وحركة الشارع؟"
					]}
				/>

				<EmoList
					pWidth={new RespString("560px", "100%")}
					pTitle={Text.H3.Centered.OfText("أسئلة التعاقد")}
					pDesc={Text.Body.Centered.OfText("لتقليل الخلاف لاحقًا")}
					pHeadBg={new ElemBg(Colors.SkyLite)}
					pItemsBg={new ElemBg(Colors.WhiteOff)}
					pNumbered={true}
					pItems={[
						"مدة الإيجار المطلوبة",
						"قيمة التأمين والمقدم المقبول",
						"طريقة السداد والزيادة السنوية",
						"مسؤولية التشطيب والتعديلات",
						"موعد بداية التشغيل والتسليم"
					]}
				/>

			</HzStack>

		</EmoStrip>

	</ESec>

	<ESec
		id="Terms"
		pBg={new ElemBg(Colors.WhiteOff)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="بنود يجب توضيحها قبل الإيجار"
			pDesc="الإيجار التجاري يحتاج اتفاقًا أكثر تفصيلًا من السكني بسبب طبيعة النشاط والتعديلات"
			style={`--StripBg:${Colors.SkyLite};`}
		/>

		<CardsGr
			pWidth={new RespString("1200px", "340px")}
			pGrTitle={Text.H3.Centered.OfText("محاور الاتفاق")}
			pCardBg={new ElemBg(Colors.WhiteOff)}
			pCardTitleFnt={Text.H4.Centered}
			pCardBodyFnt={Text.Body.Centered}
			pStackDir="Row"
			pTopic1={new Topic("القيمة والزيادة", "القيمة الشهرية، المقدم، التأمين، والزيادة السنوية أو الدورية.")}
			pTopic2={new Topic("التشطيب والتعديلات", "من يتحمل التجهيزات؟ وهل يسمح بتكسير أو فتحات أو لافتات؟")}
			pTopic3={new Topic("النشاط", "تحديد النشاط المسموح ومنع الأنشطة التي لا تناسب العقار أو الجيران.")}
			pTopic4={new Topic("الصيانة والمرافق", "الكهرباء والمياه والصرف والصيانة الدورية والأعطال السابقة.")}
			pTopic5={new Topic("التسليم والإخلاء", "حالة المحل عند الاستلام وكيفية رده عند انتهاء العلاقة.")}
		/>

	</ESec>

	<ESec
		id="Fit"
		pBg={new ElemBg(Colors.Gray1)}
		pAlign={Align.Center}
	>
		<SecTitle
			pTitle="مطابقة المحل للنشاط"
			pDesc="كل نشاط له متطلبات تشغيل وترخيص مختلفة"
			style={`--StripBg:${Colors.Gray5};`}
		/>

		<EmoStrip
			pBg={new ElemBg(Colors.Gray1)}

			pAlign={Align.Center}
>

			<EmoList
				pWidth={new RespString("1000px", "100%")}
				pTitle={Text.H3.Centered.OfText("أمثلة توجيهية")}
				pDesc={Text.Body.Centered.OfText("تساعد في اختيار المستأجر المناسب من البداية")}
				pHeadBg={new ElemBg(Colors.GreenLite)}
				pItemsBg={new ElemBg(Colors.WhiteOff)}
				pNumbered={false}
				pItems={[
					{ Title: "مطعم أو كافيه", Items: ["قد يحتاج تهوية ومدخنة وصرف وتجهيزات سلامة ومساحة تشغيل واضحة."] },
					{ Title: "صيدلية أو نشاط طبي", Items: ["يحتاج فحص اشتراطات النشاط والمسافات والتراخيص الخاصة قبل الاعتماد."] },
					{ Title: "معرض أو مكتب مبيعات", Items: ["يهتم بالواجهة والرؤية وسهولة الوصول ومظهر المدخل."] },
					{ Title: "مخزن أو توزيع", Items: ["يهتم بالتحميل والتفريغ والأمان وإمكانية الوصول للسيارات."] }
				]}
			/>

		</EmoStrip>

	</ESec>

	<EmoPipelineStrip
		pTitle="طلبات إيجار المحلات المفتوحة"
		pDesc="يتم ترتيب الطلبات حسب وضوح النشاط المقبول وبيانات المحل وقيمة الإيجار وجاهزية المعاينة."
		pServiceName="محلات للإيجار"
	/>

	<ReadAlso
		pTitle={Text.H2.Centered.OfText("اقرأ أيضًا")}

>

	<ReadAlsoItem
		pTitle="تسويق عقاري"
		pDesc="الصفحة الرئيسية لمجموعة التسويق العقاري."
		pHref="/emostate"
		pImg="/Media/Emostate/HeroD.webp"
	/>

	<ReadAlsoItem
		pTitle="محلات للبيع"
		pDesc="تسويق محل تجاري للبيع للمستخدم أو المستثمر."
		pHref="/emostate/retail"
		pImg="/Media/Emostate/Retail/Sell/HeroD.webp"
	/>

	<ReadAlsoItem
		pTitle="شقق للإيجار"
		pDesc="خدمة تأجير الشقق داخل المجموعة نفسها."
		pHref="/emostate/apartment/rent"
		pImg="/Media/Emostate/Apartment/Rent/HeroD.webp"
	/>

</ReadAlso>

	<RelServices
		pTitle={Text.H2.Centered.White.OfText("خدمات مرتبطة بالمحل")}
	>

		<RelServiceItem
			pTitle="ترخيص محل تجاري"
			pDesc="متابعة إجراءات الترخيص بعد اختيار النشاط."
			pHref="/emoperm/retail/general"
			pImg="/Media/Emoperm/Retail/General/HeroL.webp"
		/>

		<RelServiceItem
			pTitle="رسم هندسي لمحل تجاري"
			pDesc="إعداد الرسم الهندسي المطلوب لملف الترخيص."
			pHref="/emoperm/retail/general/dwg"
			pImg="/Media/Emoperm/Retail/General/Dwg/HeroL.webp"
		/>

		<RelServiceItem
			pTitle="تشطيب محل تجاري"
			pDesc="تجهيز المحل للتشغيل بعد الإيجار."
			pHref="/emocrete/finishing/retail"
			pImg="/Media/Emocrete/Finishing/Retail/HeroL.webp"
		/>

	</RelServices>

	<EmoFaq>

		<FaqItem
			pQuestion="هل يمكن تأجير المحل لأي نشاط؟"
			pAnswer="الأفضل تحديد الأنشطة المقبولة من البداية، لأن بعض الأنشطة تحتاج اشتراطات خاصة أو قد لا تناسب العقار أو الجيران."
		/>

		<FaqItem
			pQuestion="هل التشطيب على المالك أم المستأجر؟"
			pAnswer="هذا بند تفاوضي مهم ويجب توضيحه قبل الاتفاق، خصوصًا إذا كان النشاط يحتاج تعديلات أو تجهيزات ثابتة."
		/>

		<FaqItem
			pQuestion="هل قابلية الترخيص مهمة قبل الإيجار؟"
			pAnswer="نعم، لأن المستأجر التجاري غالبًا يريد تشغيل النشاط رسميًا؛ لذلك وجود رسم أو بيانات واضحة يساعد في اتخاذ القرار."
		/>

		<FaqItem
			pQuestion="هل يتم ذكر الأنشطة المرفوضة؟"
			pAnswer="نعم، ذكر الأنشطة غير المقبولة يوفر وقت المالك ويقلل الاتصالات غير المناسبة."
		/>

	</EmoFaq>

</BLayout>
