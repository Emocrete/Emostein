---
export const prerender = false;
const cSessionId = Astro.params.sessionId ?? "";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>EmoReplay Player</title>
	<style>
		:root {
			font-family: Cairo, Tahoma, system-ui, sans-serif;
			color: #edf4ff;
			background: #080b12;
		}
		body {
			margin: 0;
			min-height: 100vh;
			background:
				radial-gradient(circle at top left, rgba(0, 213, 255, .18), transparent 34vw),
				linear-gradient(135deg, #080b12, #121827 55%, #090d15);
		}
		.EmoReplayShell {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 330px;
			gap: 18px;
			padding: 16px;
			box-sizing: border-box;
		}
		.EmoReplayTop {
			grid-column: 1 / -1;
			display: flex;
			gap: 10px;
			align-items: center;
			justify-content: space-between;
			padding: 12px 14px;
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 16px;
			background: rgba(255,255,255,.06);
			backdrop-filter: blur(18px);
		}
		.EmoReplayTitle {
			font-weight: 800;
			font-size: 16px;
			line-height: 1.5;
		}
		.EmoReplayMeta {
			font-size: 12px;
			color: #aebbd1;
			direction: ltr;
			text-align: left;
		}
		.EmoReplayControls {
			display: flex;
			align-items: center;
			gap: 8px;
			flex-wrap: wrap;
		}
		.EmoReplayControls button,
		.EmoReplayControls select,
		.EmoReplayControls input {
			border: 1px solid rgba(255,255,255,.16);
			border-radius: 10px;
			background: rgba(255,255,255,.08);
			color: #fff;
			padding: 8px 10px;
			font-family: inherit;
		}
		.EmoReplayControls input[type="range"] {
			width: 260px;
			padding: 0;
		}
		.EmoReplayStageWrap {
			min-width: 0;
			height: calc(100vh - 112px);
			overflow: auto;
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 18px;
			background: rgba(0,0,0,.25);
			position: relative;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 24px;
			box-sizing: border-box;
		}
		.EmoReplayStageScaler {
			position: relative;
			transform-origin: top center;
		}
		.EmoReplayStage {
			position: relative;
			background: #fff;
			box-shadow: 0 24px 90px rgba(0,0,0,.55);
			overflow: hidden;
		}
		#ReplayFrame {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			border: 0;
			background: #fff;
		}
		#ReplayOverlay {
			position: absolute;
			inset: 0;
			pointer-events: none;
			z-index: 10;
			overflow: hidden;
		}
		.EmoReplayTrailCanvas {
			position: absolute;
			inset: 0;
			z-index: 10;
			width: 100%;
			height: 100%;
		}
		.EmoReplayCursor {
			position: absolute;
			z-index: 12;
			width: 18px;
			height: 18px;
			transform: translate(-2px, -2px);
			filter: drop-shadow(0 4px 12px rgba(0,0,0,.45));
		}
		.EmoReplayCursor:before {
			content: "";
			position: absolute;
			left: 0;
			top: 0;
			width: 0;
			height: 0;
			border-top: 18px solid #ffffff;
			border-left: 11px solid transparent;
		}
		#ReplayOverlay.IsTouchMode .EmoReplayCursor:before,
		.EmoReplayCursor.IsTouch:before {
			width: 24px;
			height: 24px;
			border: 3px solid rgba(255, 48, 48, .95);
			background: rgba(255, 48, 48, 0);
			border-radius: 50%;
			box-sizing: border-box;
		}
		#ReplayOverlay.IsTouchMode .EmoReplayCursor.IsTouchDown:before,
		.EmoReplayCursor.IsTouch.IsTouchDown:before {
			background: rgba(255, 48, 48, .88);
		}
		.EmoReplayPulse {
			position: absolute;
			z-index: 11;
			width: 12px;
			height: 12px;
			margin: -6px 0 0 -6px;
			border: 3px solid #ff8a00;
			border-radius: 50%;
			animation: Pulse .65s ease-out forwards;
			box-shadow: 0 0 25px rgba(255,138,0,.55);
		}
		.EmoReplayFocus {
			position: absolute;
			z-index: 9;
			border: 3px solid rgba(255, 215, 64, .9);
			border-radius: 12px;
			box-shadow: 0 0 0 9999px rgba(0,0,0,.08), 0 0 24px rgba(255,215,64,.45);
			transition: all .16s ease;
		}
		@keyframes Pulse {
			0% { opacity: 1; transform: scale(.5); }
			100% { opacity: 0; transform: scale(4.4); }
		}
		.EmoReplaySide {
			height: calc(100vh - 112px);
			overflow: auto;
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 18px;
			background: rgba(255,255,255,.06);
			padding: 14px;
			box-sizing: border-box;
		}
		.EmoReplaySide h2 {
			font-size: 14px;
			margin: 0 0 10px;
		}
		.EmoReplayEvent {
			padding: 9px 10px;
			margin: 0 0 8px;
			border-radius: 12px;
			background: rgba(255,255,255,.07);
			border: 1px solid rgba(255,255,255,.08);
			font-size: 12px;
			line-height: 1.5;
			cursor: pointer;
		}
		.EmoReplayEvent strong {
			color: #73e6ff;
		}
		.EmoReplayEvent span {
			display: block;
			color: #b7c5d9;
			direction: ltr;
			text-align: left;
			font-size: 11px;
		}
		.EmoReplayTrack {
			position: relative;
			width: 260px;
			height: 16px;
			border-radius: 999px;
			overflow: hidden;
			background: rgba(255,255,255,.08);
			border: 1px solid rgba(255,255,255,.14);
		}
		.EmoReplayTrackFill {
			position: absolute;
			inset-block: 0;
			left: 0;
			background: linear-gradient(90deg, #2ea8ff, #00c6a7, #ffc74a, #ff8a00);
		}
		.EmoReplayTrackIdle {
			position: absolute;
			inset-block: 0;
			background: #e7eaf0;
			opacity: .95;
		}
		.EmoReplayTrackMarker {
			position: absolute;
			top: 50%;
			transform: translate(-50%, -50%);
			font-size: 12px;
			line-height: 1;
			text-shadow: 0 1px 5px rgba(0,0,0,.9);
		}
		.EmoReplayStatus {
			padding: 30px;
			text-align: center;
			color: #d7e3f5;
		}
		@media (max-width: 980px) {
			.EmoReplayShell { grid-template-columns: 1fr; }
			.EmoReplaySide { height: 320px; }
			.EmoReplayStageWrap { height: 70vh; }
		}
	</style>
</head>
<body>
	<div class="EmoReplayShell">
		<div class="EmoReplayTop">
			<div>
				<div class="EmoReplayTitle" id="ReplayTitle">EmoReplay</div>
				<div class="EmoReplayMeta" id="ReplayMeta">loading...</div>
			</div>
			<div class="EmoReplayControls">
				<button id="PlayBtn">تشغيل</button>
				<button id="PauseBtn">إيقاف</button>
				<button id="RestartBtn">إعادة</button>
				<select id="SpeedSel">
					<option value="0.5">0.5x</option>
					<option value="1" selected>1x</option>
					<option value="2">2x</option>
					<option value="4">4x</option>
					<option value="8">8x</option>
				</select>
				<input id="Timeline" type="range" min="0" max="1000" value="0" />
				<span id="Clock">0.0s</span>
				<div class="EmoReplayTrack" id="ReplayTrack" aria-label="Replay timeline"></div>
			</div>
		</div>

		<div class="EmoReplayStageWrap" id="StageWrap">
			<div class="EmoReplayStatus" id="ReplayStatus">جاري تحميل الجلسة...</div>
			<div class="EmoReplayStageScaler" id="StageScaler" hidden>
				<div class="EmoReplayStage" id="Stage">
					<iframe id="ReplayFrame" sandbox="allow-same-origin"></iframe>
					<div id="ReplayOverlay">
						<canvas class="EmoReplayTrailCanvas" id="ReplayTrail"></canvas>
						<div class="EmoReplayFocus" id="FocusBox" hidden></div>
						<div class="EmoReplayCursor" id="Cursor" hidden></div>
					</div>
				</div>
			</div>
		</div>

		<aside class="EmoReplaySide">
			<h2>أحداث مهمة</h2>
			<div id="EventsList"></div>
		</aside>
	</div>

	<script is:inline define:vars={{ cSessionId }}>
	(() => {
		const cSessionIdValue = cSessionId;
		const cParams = new URLSearchParams(location.search);
		let fOpsKey = cParams.get("key") || localStorage.getItem("emo_ops_key") || "";
		if (!fOpsKey) {
			fOpsKey = prompt("اكتب مفتاح لوحة العمليات") || "";
			if (fOpsKey) localStorage.setItem("emo_ops_key", fOpsKey);
		}

		const cFrame = document.getElementById("ReplayFrame");
		const cStage = document.getElementById("Stage");
		const cStageWrap = document.getElementById("StageWrap");
		const cStageScaler = document.getElementById("StageScaler");
		const cOverlay = document.getElementById("ReplayOverlay");
		const cCursor = document.getElementById("Cursor");
		const cTrail = document.getElementById("ReplayTrail");
		const cTrailCtx = cTrail.getContext("2d");
		const cFocusBox = document.getElementById("FocusBox");
		const cStatus = document.getElementById("ReplayStatus");
		const cTitle = document.getElementById("ReplayTitle");
		const cMeta = document.getElementById("ReplayMeta");
		const cEventsList = document.getElementById("EventsList");
		const cTimeline = document.getElementById("Timeline");
		const cReplayTrack = document.getElementById("ReplayTrack");
		const cClock = document.getElementById("Clock");
		const cSpeedSel = document.getElementById("SpeedSel");
		const cPlayBtn = document.getElementById("PlayBtn");
		const cPauseBtn = document.getElementById("PauseBtn");
		const cRestartBtn = document.getElementById("RestartBtn");

		let fSession = null;
		let fEvents = [];
		let fIndex = 0;
		let fPlaying = false;
		let fPlayStartedAt = 0;
		let fBaseMs = 0;
		let fDurationMs = 1;
		let fRaf = 0;
		let fSpeed = 1;
		let fLastScrollEvent = null;
		let fNextScrollEvent = null;
		let fTrailPoints = [];
		let fLastCursorPoint = null;
		let fTouchDown = false;
		let fTouchStartPoint = null;
		let fDragTrail = null;
		let fTrailRaf = 0;
		let fLastScrollX = 0;
		let fLastScrollY = 0;

		function FormatMs(pMs) {
			return `${(pMs / 1000).toFixed(1)}s`;
		}

		function SetTrailCanvasSize() {
			const Ratio = window.devicePixelRatio || 1;
			const W = Math.max(1, cOverlay.clientWidth);
			const H = Math.max(1, cOverlay.clientHeight);
			if (cTrail.width !== Math.round(W * Ratio) || cTrail.height !== Math.round(H * Ratio)) {
				cTrail.width = Math.round(W * Ratio);
				cTrail.height = Math.round(H * Ratio);
				cTrail.style.width = `${W}px`;
				cTrail.style.height = `${H}px`;
			}
			cTrailCtx.setTransform(Ratio, 0, 0, Ratio, 0, 0);
		}

		function AddTrailPoint(pX, pY, pTime = performance.now()) {
			fTrailPoints.push({ x: pX, y: pY, time: pTime });
			if (fTrailPoints.length > 90) fTrailPoints.splice(0, fTrailPoints.length - 90);
		}

		function DrawTrails() {
			SetTrailCanvasSize();
			const Now = performance.now();
			const W = cOverlay.clientWidth;
			const H = cOverlay.clientHeight;
			cTrailCtx.clearRect(0, 0, W, H);
			fTrailPoints = fTrailPoints.filter((Point) => Now - Point.time <= 950);
			for (let I = 1; I < fTrailPoints.length; I++) {
				const A = fTrailPoints[I - 1];
				const B = fTrailPoints[I];
				const Age = Now - B.time;
				const Alpha = Math.max(0, 1 - Age / 950);
				cTrailCtx.strokeStyle = `rgba(255,138,0,${Alpha * .78})`;
				cTrailCtx.lineWidth = 2 + Alpha * 9;
				cTrailCtx.lineCap = "round";
				cTrailCtx.beginPath();
				cTrailCtx.moveTo(A.x, A.y);
				cTrailCtx.lineTo(B.x, B.y);
				cTrailCtx.stroke();
			}
			if (fDragTrail) {
				const Alpha = Math.max(0, 1 - (Now - fDragTrail.time) / 2000);
				if (Alpha > 0) {
					cTrailCtx.strokeStyle = `rgba(255,48,48,${Alpha * .82})`;
					cTrailCtx.lineWidth = 5;
					cTrailCtx.lineCap = "round";
					cTrailCtx.beginPath();
					cTrailCtx.moveTo(fDragTrail.start.x, fDragTrail.start.y);
					cTrailCtx.lineTo(fDragTrail.end.x, fDragTrail.end.y);
					cTrailCtx.stroke();
				} else {
					fDragTrail = null;
				}
			}
			fTrailRaf = requestAnimationFrame(DrawTrails);
		}

		function CssEscape(pValue) {
			if (window.CSS && typeof window.CSS.escape === "function") return CSS.escape(String(pValue));
			return String(pValue).replace(/["\\]/g, "\\$&");
		}

		function ApiUrl(pPath, pParams = {}) {
			const Url = new URL(pPath, location.origin);
			Object.entries(pParams).forEach(([Key, Value]) => Url.searchParams.set(Key, Value));
			return Url;
		}

		async function ApiGet(pPath, pParams = {}) {
			const Res = await fetch(ApiUrl(pPath, { ...pParams, key: fOpsKey }), {
				headers: { "x-ops-key": fOpsKey, "accept": "application/json" }
			});
			const Data = await Res.json().catch(() => ({}));
			if (!Res.ok || !Data.ok) throw new Error(Data.error || `HTTP ${Res.status}`);
			return Data;
		}

		function GetFrameDoc() {
			return cFrame.contentDocument || cFrame.contentWindow?.document || null;
		}

		function GetFrameWin() {
			return cFrame.contentWindow;
		}

		function FindTarget(pEvent) {
			const Doc = GetFrameDoc();
			if (!Doc) return null;
			if (pEvent.selector) {
				try {
					const BySelector = Doc.querySelector(pEvent.selector);
					if (BySelector) return BySelector;
				} catch {}
			}
			if (pEvent.target) {
				const Id = CssEscape(pEvent.target);
				try {
					return Doc.querySelector(`[data-replay-id=\"${Id}\"], [data-ops-widget=\"${Id}\"], [data-ops-scope=\"${Id}\"], #${Id}`);
				} catch {
					return null;
				}
			}
			return null;
		}

		function FitStage() {
			if (!fSession) return;
			const W = Number(fSession.viewport_width || fSession.meta?.viewport?.width || 390) || 390;
			const H = Number(fSession.viewport_height || fSession.meta?.viewport?.height || 800) || 800;
			cStage.style.width = `${W}px`;
			cStage.style.height = `${H}px`;
			cStageScaler.style.width = `${W}px`;
			cStageScaler.style.height = `${H}px`;

			const AvailableW = Math.max(260, cStageWrap.clientWidth - 48);
			const AvailableH = Math.max(260, cStageWrap.clientHeight - 48);
			const Scale = Math.min(1, AvailableW / W, AvailableH / H);
			cStageScaler.style.transform = `scale(${Scale})`;
			cStageScaler.style.marginBottom = `${Math.max(0, H * Scale - H)}px`;
		}

		function SetTime(pMs, pResetIndex = false) {
			fBaseMs = Math.max(0, Math.min(fDurationMs, pMs));
			cTimeline.value = String(Math.round((fBaseMs / fDurationMs) * 1000));
			cClock.textContent = FormatMs(fBaseMs);
			if (pResetIndex) {
				fIndex = 0;
				ResetVisualState();
				while (fIndex < fEvents.length && fEvents[fIndex].t <= fBaseMs) {
					ApplyEvent(fEvents[fIndex], true);
					fIndex++;
				}
			}
		}

		function ResetVisualState() {
			const Win = GetFrameWin();
			Win?.scrollTo?.(0, 0);
			cCursor.hidden = true;
			cFocusBox.hidden = true;
			cOverlay.querySelectorAll(".EmoReplayPulse").forEach((x) => x.remove());
			fTrailPoints = [];
			fLastCursorPoint = null;
			fTouchDown = false;
			fTouchStartPoint = null;
			fDragTrail = null;
			fLastScrollX = 0;
			fLastScrollY = 0;
			cCursor.classList.remove("IsTouchDown");
			fLastScrollEvent = null;
			fNextScrollEvent = null;
		}

		function MoveCursor(pEvent) {
			const X = Number.isFinite(pEvent.x) ? pEvent.x : (Number(pEvent.nx || 0) * cStage.clientWidth);
			const Y = Number.isFinite(pEvent.y) ? pEvent.y : (Number(pEvent.ny || 0) * cStage.clientHeight);
			const IsTouch = pEvent.pointerType === "touch" || pEvent.type === "touch" || cOverlay.classList.contains("IsTouchMode");
			fLastCursorPoint = { x: X, y: Y, isTouch: IsTouch };
			cCursor.hidden = false;
			cCursor.style.left = `${X}px`;
			cCursor.style.top = `${Y}px`;
			cCursor.classList.toggle("IsTouch", IsTouch);
			if (pEvent.type === "pointer-down") {
				fTouchDown = true;
				fTouchStartPoint = { x: X, y: Y };
			}
			if (pEvent.type === "pointer-up") fTouchDown = false;
			cCursor.classList.toggle("IsTouchDown", fTouchDown && IsTouch);
			AddTrailPoint(X, Y);
		}

		function ShowPulse(pEvent) {
			const Pulse = document.createElement("div");
			Pulse.className = "EmoReplayPulse";
			Pulse.style.left = `${Number(pEvent.x || 0)}px`;
			Pulse.style.top = `${Number(pEvent.y || 0)}px`;
			cOverlay.appendChild(Pulse);
			window.setTimeout(() => Pulse.remove(), 800);
		}

		function ShowFocus(pEvent) {
			const El = FindTarget(pEvent);
			const Doc = GetFrameDoc();
			if (!El || !Doc) {
				cFocusBox.hidden = true;
				return;
			}
			const Rect = El.getBoundingClientRect();
			if (Rect.width <= 0 || Rect.height <= 0) return;
			cFocusBox.hidden = false;
			cFocusBox.style.left = `${Rect.left - 4}px`;
			cFocusBox.style.top = `${Rect.top - 4}px`;
			cFocusBox.style.width = `${Rect.width + 8}px`;
			cFocusBox.style.height = `${Rect.height + 8}px`;
		}

		function ApplyInput(pEvent) {
			const El = FindTarget(pEvent);
			if (!El) return;
			if (pEvent.value !== undefined) {
				El.value = pEvent.value;
				if (El.tagName === "TEXTAREA") El.textContent = pEvent.value;
			} else if (pEvent.checked !== undefined && (El.type === "checkbox" || El.type === "radio")) {
				El.checked = !!pEvent.checked;
			}
			ShowFocus(pEvent);
		}

		function ApplyWidgetState(pEvent) {
			const El = FindTarget(pEvent);
			if (!El) return;
			const State = String(pEvent.state || "").toLowerCase();
			El.setAttribute("data-replay-state", State);
			if (State === "open" || State === "opened" || State === "true") {
				El.classList.add("open", "IsOpen", "Active");
				if (El.tagName === "DETAILS") El.setAttribute("open", "");
			} else if (State === "closed" || State === "close" || State === "false") {
				El.classList.remove("open", "IsOpen", "Active");
				if (El.tagName === "DETAILS") El.removeAttribute("open");
			}
		}

		function ApplyPatch(pEvent) {
			const El = FindTarget(pEvent);
			if (!El || !pEvent.html) return;
			El.outerHTML = pEvent.html;
		}

		function ApplyScroll(pEvent) {
			const NewX = Number(pEvent.x || 0);
			const NewY = Number(pEvent.y || 0);
			const DeltaX = NewX - fLastScrollX;
			const DeltaY = NewY - fLastScrollY;
			GetFrameWin()?.scrollTo?.(NewX, NewY);
			fLastScrollX = NewX;
			fLastScrollY = NewY;
			if (fTouchDown && fLastCursorPoint?.isTouch) {
				fLastCursorPoint.x -= DeltaX;
				fLastCursorPoint.y -= DeltaY;
				cCursor.style.left = `${fLastCursorPoint.x}px`;
				cCursor.style.top = `${fLastCursorPoint.y}px`;
				AddTrailPoint(fLastCursorPoint.x, fLastCursorPoint.y);
				if (fTouchStartPoint) fDragTrail = { start: fTouchStartPoint, end: { x: fLastCursorPoint.x, y: fLastCursorPoint.y }, time: performance.now() };
			}
		}

		function ApplyEvent(pEvent, pSilent = false) {
			switch (pEvent.type) {
				case "scroll":
					ApplyScroll(pEvent);
					break;
				case "pointer":
				case "pointer-down":
				case "pointer-up":
					MoveCursor(pEvent);
					break;
				case "click":
					MoveCursor(pEvent);
					if (!pSilent) ShowPulse(pEvent);
					break;
				case "focus":
					ShowFocus(pEvent);
					break;
				case "blur":
					cFocusBox.hidden = true;
					break;
				case "input":
				case "change":
					ApplyInput(pEvent);
					break;
				case "widget-state":
					ApplyWidgetState(pEvent);
					break;
				case "patch":
					ApplyPatch(pEvent);
					break;
			}
		}

		function Tick() {
			if (!fPlaying) return;
			const Current = Math.min(fDurationMs, fBaseMs + (performance.now() - fPlayStartedAt) * fSpeed);
			while (fIndex < fEvents.length && fEvents[fIndex].t <= Current) {
				ApplyEvent(fEvents[fIndex], false);
				fIndex++;
			}
			cTimeline.value = String(Math.round((Current / fDurationMs) * 1000));
			cClock.textContent = FormatMs(Current);
			if (Current >= fDurationMs) {
				fPlaying = false;
				fBaseMs = fDurationMs;
				return;
			}
			fRaf = requestAnimationFrame(Tick);
		}

		function Play() {
			if (fPlaying) return;
			fPlaying = true;
			fSpeed = Number(cSpeedSel.value || 1);
			fPlayStartedAt = performance.now();
			fRaf = requestAnimationFrame(Tick);
		}

		function Pause() {
			if (!fPlaying) return;
			fBaseMs = Math.min(fDurationMs, fBaseMs + (performance.now() - fPlayStartedAt) * fSpeed);
			fPlaying = false;
			cancelAnimationFrame(fRaf);
			SetTime(fBaseMs, false);
		}

		function Restart() {
			Pause();
			SetTime(0, true);
		}

		function EventIcon(pEvent) {
			const Type = String(pEvent?.type || "").toLowerCase();
			if (Type.includes("read_full") || Type === "read" || Type.endsWith("_stay")) return "📖";
			if (Type.includes("read_quick") || Type.includes("skim")) return "👁";
			if (Type.includes("video") || Type.includes("clarity")) return "▶";
			if (Type.includes("call")) return "☎";
			if (Type.includes("whatsapp")) return "☘";
			if (Type.includes("input") || Type.includes("form")) return "✎";
			if (Type.includes("rating")) return "★";
			if (Type.includes("click")) return "⌁";
			if (Type.includes("visibility") || Type === "blur") return "◌";
			return "";
		}

		function RenderReplayTrack() {
			cReplayTrack.innerHTML = `<div class="EmoReplayTrackFill" style="width:100%"></div>`;
			let IdleStart = null;
			for (const Event of fEvents) {
				const Type = String(Event.type || "").toLowerCase();
				const State = String(Event.state || Event.visibilityState || "").toLowerCase();
				if ((Type === "visibility" && State === "hidden") || Type === "window-blur") IdleStart = Number(Event.t || 0);
				if (((Type === "visibility" && State === "visible") || Type === "window-focus") && IdleStart !== null) {
					const End = Number(Event.t || 0);
					const Left = Math.max(0, Math.min(100, (IdleStart / fDurationMs) * 100));
					const Width = Math.max(.4, Math.min(100 - Left, ((End - IdleStart) / fDurationMs) * 100));
					const Idle = document.createElement("div");
					Idle.className = "EmoReplayTrackIdle";
					Idle.style.left = `${Left}%`;
					Idle.style.width = `${Width}%`;
					cReplayTrack.appendChild(Idle);
					IdleStart = null;
				}
			}
			fEvents.forEach((Event, Index) => {
				const Icon = EventIcon(Event);
				if (!Icon) return;
				if (Index > 0 && Math.abs(Number(Event.t || 0) - Number(fEvents[Index - 1].t || 0)) < 150) return;
				const Marker = document.createElement("span");
				Marker.className = "EmoReplayTrackMarker";
				Marker.textContent = Icon;
				Marker.style.left = `${Math.max(0, Math.min(100, (Number(Event.t || 0) / fDurationMs) * 100))}%`;
				cReplayTrack.appendChild(Marker);
			});
		}

		function RenderEventsList() {
			const Important = fEvents.filter((Event) => ["click", "focus", "input", "change", "submit", "widget-state"].includes(Event.type));
			cEventsList.innerHTML = "";
			Important.slice(0, 300).forEach((Event) => {
				const Item = document.createElement("div");
				Item.className = "EmoReplayEvent";
				Item.innerHTML = `<strong>${Event.type}</strong> — ${Event.label || Event.target || ""}<span>${FormatMs(Event.t)} ${Event.masked ? "masked" : ""}</span>`;
				Item.onclick = () => {
					Pause();
					SetTime(Math.max(0, Event.t - 350), true);
				};
				cEventsList.appendChild(Item);
			});
		}

		async function Load() {
			const SessionData = await ApiGet("/api/replay/session", { id: cSessionIdValue });
			fSession = SessionData.session;
			if (!fSession) throw new Error("لم يتم العثور على الجلسة");
			if (!fSession.snapshot_html) throw new Error("الجلسة موجودة لكن snapshot_html غير محفوظة بعد");

			const ChunksData = await ApiGet("/api/replay/chunk", { session_id: cSessionIdValue });
			const Chunks = ChunksData.chunks || [];
			fEvents = Chunks.flatMap((Chunk) => Array.isArray(Chunk.events_json) ? Chunk.events_json : []).sort((A, B) => (A.t || 0) - (B.t || 0));
			fDurationMs = Math.max(1000, ...fEvents.map((Event) => Number(Event.t || 0)));
			const ViewportWidth = Number(fSession.viewport_width || fSession.meta?.viewport?.width || 0);
			cOverlay.classList.toggle("IsTouchMode", ViewportWidth > 0 && ViewportWidth <= 740);
			cOverlay.classList.toggle("IsDesktop", !(ViewportWidth > 0 && ViewportWidth <= 740));
			RenderReplayTrack();

			cTitle.textContent = fSession.page_title || "EmoReplay";
			cMeta.textContent = `${fSession.page_url || ""} | ${fSession.viewport_width}x${fSession.viewport_height} | ${fEvents.length} events`;
			cFrame.srcdoc = fSession.snapshot_html;

			cFrame.addEventListener("load", () => {
				FitStage();
				cStatus.hidden = true;
				cStageScaler.hidden = false;
				SetTime(0, true);
				RenderEventsList();
				cancelAnimationFrame(fTrailRaf);
				fTrailRaf = requestAnimationFrame(DrawTrails);
			}, { once: true });
		}

		cPlayBtn.onclick = Play;
		cPauseBtn.onclick = Pause;
		cRestartBtn.onclick = Restart;
		cSpeedSel.onchange = () => {
			if (fPlaying) {
				Pause();
				Play();
			}
		};
		cTimeline.oninput = () => {
			Pause();
			SetTime((Number(cTimeline.value) / 1000) * fDurationMs, true);
		};
		window.addEventListener("resize", () => { FitStage(); SetTrailCanvasSize(); }, { passive: true });

		Load().catch((Ex) => {
			cStatus.textContent = `Replay failed: ${Ex.message || Ex}`;
		});
	})();
	</script>
</body>
</html>
