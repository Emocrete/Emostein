---
export const prerender = false;
const cSessionId = Astro.params.sessionId ?? "";
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>EmoReplay Player</title>
	<style>
		:root {
			font-family: Cairo, Tahoma, system-ui, sans-serif;
			color: #edf4ff;
			background: #080b12;
		}
		body {
			margin: 0;
			min-height: 100vh;
			background:
				radial-gradient(circle at top left, rgba(0, 213, 255, .18), transparent 34vw),
				linear-gradient(135deg, #080b12, #121827 55%, #090d15);
		}
		.EmoReplayShell {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 330px;
			gap: 18px;
			padding: 16px;
			box-sizing: border-box;
		}
		.EmoReplayTop {
			grid-column: 1 / -1;
			display: flex;
			gap: 10px;
			align-items: center;
			justify-content: space-between;
			padding: 12px 14px;
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 16px;
			background: rgba(255,255,255,.06);
			backdrop-filter: blur(18px);
		}
		.EmoReplayTitle {
			font-weight: 800;
			font-size: 16px;
			line-height: 1.5;
		}
		.EmoReplayMeta {
			font-size: 12px;
			color: #aebbd1;
			direction: ltr;
			text-align: left;
		}
		.EmoReplayControls {
			display: flex;
			align-items: center;
			gap: 8px;
			flex-wrap: wrap;
		}
		.EmoReplayControls button,
		.EmoReplayControls select,
		.EmoReplayControls input {
			border: 1px solid rgba(255,255,255,.16);
			border-radius: 10px;
			background: rgba(255,255,255,.08);
			color: #fff;
			padding: 8px 10px;
			font-family: inherit;
		}
		.EmoReplayControls input[type="range"] {
			width: 260px;
			padding: 0;
		}
		.EmoReplayStageWrap {
			min-width: 0;
			height: calc(100vh - 112px);
			overflow: auto;
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 18px;
			background: rgba(0,0,0,.25);
			position: relative;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 24px;
			box-sizing: border-box;
		}
		.EmoReplayStageScaler {
			position: relative;
			transform-origin: top center;
		}
		.EmoReplayStage {
			position: relative;
			background: #fff;
			box-shadow: 0 24px 90px rgba(0,0,0,.55);
			overflow: hidden;
		}
		#ReplayFrame {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			border: 0;
			background: #fff;
		}
		#ReplayOverlay {
			position: absolute;
			inset: 0;
			pointer-events: none;
			z-index: 10;
			overflow: hidden;
		}
		.EmoReplayCursor {
			position: absolute;
			z-index: 12;
			width: 18px;
			height: 18px;
			transform: translate(-2px, -2px);
			filter: drop-shadow(0 4px 12px rgba(0,0,0,.45));
		}
		.EmoReplayCursor:before {
			content: "";
			position: absolute;
			left: 0;
			top: 0;
			width: 0;
			height: 0;
			border-top: 18px solid #ffffff;
			border-left: 11px solid transparent;
		}
		.EmoReplayCursor.IsTouch:before {
			width: 22px;
			height: 22px;
			border: 3px solid rgba(0,213,255,.95);
			background: rgba(0,213,255,.18);
			border-radius: 50%;
			box-sizing: border-box;
		}
		.EmoReplayPulse {
			position: absolute;
			z-index: 11;
			width: 12px;
			height: 12px;
			margin: -6px 0 0 -6px;
			border: 3px solid #00d5ff;
			border-radius: 50%;
			animation: Pulse .65s ease-out forwards;
			box-shadow: 0 0 25px rgba(0,213,255,.55);
		}
		.EmoReplayFocus {
			position: absolute;
			z-index: 9;
			border: 3px solid rgba(255, 215, 64, .9);
			border-radius: 12px;
			box-shadow: 0 0 0 9999px rgba(0,0,0,.08), 0 0 24px rgba(255,215,64,.45);
			transition: all .16s ease;
		}
		@keyframes Pulse {
			0% { opacity: 1; transform: scale(.5); }
			100% { opacity: 0; transform: scale(4.4); }
		}
		.EmoReplaySide {
			height: calc(100vh - 112px);
			overflow: auto;
			border: 1px solid rgba(255,255,255,.12);
			border-radius: 18px;
			background: rgba(255,255,255,.06);
			padding: 14px;
			box-sizing: border-box;
		}
		.EmoReplaySide h2 {
			font-size: 14px;
			margin: 0 0 10px;
		}
		.EmoReplayEvent {
			padding: 9px 10px;
			margin: 0 0 8px;
			border-radius: 12px;
			background: rgba(255,255,255,.07);
			border: 1px solid rgba(255,255,255,.08);
			font-size: 12px;
			line-height: 1.5;
			cursor: pointer;
		}
		.EmoReplayEvent strong {
			color: #73e6ff;
		}
		.EmoReplayEvent span {
			display: block;
			color: #b7c5d9;
			direction: ltr;
			text-align: left;
			font-size: 11px;
		}
		.EmoReplayStatus {
			padding: 30px;
			text-align: center;
			color: #d7e3f5;
		}
		@media (max-width: 980px) {
			.EmoReplayShell { grid-template-columns: 1fr; }
			.EmoReplaySide { height: 320px; }
			.EmoReplayStageWrap { height: 70vh; }
		}
	</style>
</head>
<body>
	<div class="EmoReplayShell">
		<div class="EmoReplayTop">
			<div>
				<div class="EmoReplayTitle" id="ReplayTitle">EmoReplay</div>
				<div class="EmoReplayMeta" id="ReplayMeta">loading...</div>
			</div>
			<div class="EmoReplayControls">
				<button id="PlayBtn">تشغيل</button>
				<button id="PauseBtn">إيقاف</button>
				<button id="RestartBtn">إعادة</button>
				<select id="SpeedSel">
					<option value="0.5">0.5x</option>
					<option value="1" selected>1x</option>
					<option value="2">2x</option>
					<option value="4">4x</option>
					<option value="8">8x</option>
				</select>
				<input id="Timeline" type="range" min="0" max="1000" value="0" />
				<span id="Clock">0.0s</span>
			</div>
		</div>

		<div class="EmoReplayStageWrap" id="StageWrap">
			<div class="EmoReplayStatus" id="ReplayStatus">جاري تحميل الجلسة...</div>
			<div class="EmoReplayStageScaler" id="StageScaler" hidden>
				<div class="EmoReplayStage" id="Stage">
					<iframe id="ReplayFrame" sandbox="allow-same-origin"></iframe>
					<div id="ReplayOverlay">
						<div class="EmoReplayFocus" id="FocusBox" hidden></div>
						<div class="EmoReplayCursor" id="Cursor" hidden></div>
					</div>
				</div>
			</div>
		</div>

		<aside class="EmoReplaySide">
			<h2>أحداث مهمة</h2>
			<div id="EventsList"></div>
		</aside>
	</div>

	<script is:inline define:vars={{ cSessionId }}>
	(() => {
		const cSessionIdValue = cSessionId;
		const cParams = new URLSearchParams(location.search);
		let fOpsKey = cParams.get("key") || localStorage.getItem("emo_ops_key") || "";
		if (!fOpsKey) {
			fOpsKey = prompt("اكتب مفتاح لوحة العمليات") || "";
			if (fOpsKey) localStorage.setItem("emo_ops_key", fOpsKey);
		}

		const cFrame = document.getElementById("ReplayFrame");
		const cStage = document.getElementById("Stage");
		const cStageWrap = document.getElementById("StageWrap");
		const cStageScaler = document.getElementById("StageScaler");
		const cOverlay = document.getElementById("ReplayOverlay");
		const cCursor = document.getElementById("Cursor");
		const cFocusBox = document.getElementById("FocusBox");
		const cStatus = document.getElementById("ReplayStatus");
		const cTitle = document.getElementById("ReplayTitle");
		const cMeta = document.getElementById("ReplayMeta");
		const cEventsList = document.getElementById("EventsList");
		const cTimeline = document.getElementById("Timeline");
		const cClock = document.getElementById("Clock");
		const cSpeedSel = document.getElementById("SpeedSel");
		const cPlayBtn = document.getElementById("PlayBtn");
		const cPauseBtn = document.getElementById("PauseBtn");
		const cRestartBtn = document.getElementById("RestartBtn");

		let fSession = null;
		let fEvents = [];
		let fIndex = 0;
		let fPlaying = false;
		let fPlayStartedAt = 0;
		let fBaseMs = 0;
		let fDurationMs = 1;
		let fRaf = 0;
		let fSpeed = 1;
		let fLastScrollEvent = null;
		let fNextScrollEvent = null;

		function FormatMs(pMs) {
			return `${(pMs / 1000).toFixed(1)}s`;
		}

		function CssEscape(pValue) {
			if (window.CSS && typeof window.CSS.escape === "function") return CSS.escape(String(pValue));
			return String(pValue).replace(/["\\]/g, "\\$&");
		}

		function ApiUrl(pPath, pParams = {}) {
			const Url = new URL(pPath, location.origin);
			Object.entries(pParams).forEach(([Key, Value]) => Url.searchParams.set(Key, Value));
			return Url;
		}

		async function ApiGet(pPath, pParams = {}) {
			const Res = await fetch(ApiUrl(pPath, { ...pParams, key: fOpsKey }), {
				headers: { "x-ops-key": fOpsKey, "accept": "application/json" }
			});
			const Data = await Res.json().catch(() => ({}));
			if (!Res.ok || !Data.ok) throw new Error(Data.error || `HTTP ${Res.status}`);
			return Data;
		}

		function GetFrameDoc() {
			return cFrame.contentDocument || cFrame.contentWindow?.document || null;
		}

		function GetFrameWin() {
			return cFrame.contentWindow;
		}

		function FindTarget(pEvent) {
			const Doc = GetFrameDoc();
			if (!Doc) return null;
			if (pEvent.selector) {
				try {
					const BySelector = Doc.querySelector(pEvent.selector);
					if (BySelector) return BySelector;
				} catch {}
			}
			if (pEvent.target) {
				const Id = CssEscape(pEvent.target);
				try {
					return Doc.querySelector(`[data-replay-id=\"${Id}\"], [data-ops-widget=\"${Id}\"], [data-ops-scope=\"${Id}\"], #${Id}`);
				} catch {
					return null;
				}
			}
			return null;
		}

		function FitStage() {
			if (!fSession) return;
			const W = Number(fSession.viewport_width || fSession.meta?.viewport?.width || 390) || 390;
			const H = Number(fSession.viewport_height || fSession.meta?.viewport?.height || 800) || 800;
			cStage.style.width = `${W}px`;
			cStage.style.height = `${H}px`;
			cStageScaler.style.width = `${W}px`;
			cStageScaler.style.height = `${H}px`;

			const AvailableW = Math.max(260, cStageWrap.clientWidth - 48);
			const AvailableH = Math.max(260, cStageWrap.clientHeight - 48);
			const Scale = Math.min(1, AvailableW / W, AvailableH / H);
			cStageScaler.style.transform = `scale(${Scale})`;
			cStageScaler.style.marginBottom = `${Math.max(0, H * Scale - H)}px`;
		}

		function SetTime(pMs, pResetIndex = false) {
			fBaseMs = Math.max(0, Math.min(fDurationMs, pMs));
			cTimeline.value = String(Math.round((fBaseMs / fDurationMs) * 1000));
			cClock.textContent = FormatMs(fBaseMs);
			if (pResetIndex) {
				fIndex = 0;
				ResetVisualState();
				while (fIndex < fEvents.length && fEvents[fIndex].t <= fBaseMs) {
					ApplyEvent(fEvents[fIndex], true);
					fIndex++;
				}
			}
		}

		function ResetVisualState() {
			const Win = GetFrameWin();
			Win?.scrollTo?.(0, 0);
			cCursor.hidden = true;
			cFocusBox.hidden = true;
			cOverlay.querySelectorAll(".EmoReplayPulse").forEach((x) => x.remove());
			fLastScrollEvent = null;
			fNextScrollEvent = null;
		}

		function MoveCursor(pEvent) {
			const X = Number.isFinite(pEvent.x) ? pEvent.x : (Number(pEvent.nx || 0) * cStage.clientWidth);
			const Y = Number.isFinite(pEvent.y) ? pEvent.y : (Number(pEvent.ny || 0) * cStage.clientHeight);
			cCursor.hidden = false;
			cCursor.style.left = `${X}px`;
			cCursor.style.top = `${Y}px`;
			cCursor.classList.toggle("IsTouch", pEvent.pointerType === "touch" || pEvent.type === "touch");
		}

		function ShowPulse(pEvent) {
			const Pulse = document.createElement("div");
			Pulse.className = "EmoReplayPulse";
			Pulse.style.left = `${Number(pEvent.x || 0)}px`;
			Pulse.style.top = `${Number(pEvent.y || 0)}px`;
			cOverlay.appendChild(Pulse);
			window.setTimeout(() => Pulse.remove(), 800);
		}

		function ShowFocus(pEvent) {
			const El = FindTarget(pEvent);
			const Doc = GetFrameDoc();
			if (!El || !Doc) {
				cFocusBox.hidden = true;
				return;
			}
			const Rect = El.getBoundingClientRect();
			if (Rect.width <= 0 || Rect.height <= 0) return;
			cFocusBox.hidden = false;
			cFocusBox.style.left = `${Rect.left - 4}px`;
			cFocusBox.style.top = `${Rect.top - 4}px`;
			cFocusBox.style.width = `${Rect.width + 8}px`;
			cFocusBox.style.height = `${Rect.height + 8}px`;
		}

		function ApplyInput(pEvent) {
			const El = FindTarget(pEvent);
			if (!El) return;
			if (pEvent.value !== undefined) {
				El.value = pEvent.value;
				if (El.tagName === "TEXTAREA") El.textContent = pEvent.value;
			} else if (pEvent.checked !== undefined && (El.type === "checkbox" || El.type === "radio")) {
				El.checked = !!pEvent.checked;
			}
			ShowFocus(pEvent);
		}

		function ApplyWidgetState(pEvent) {
			const El = FindTarget(pEvent);
			if (!El) return;
			const State = String(pEvent.state || "").toLowerCase();
			El.setAttribute("data-replay-state", State);
			if (State === "open" || State === "opened" || State === "true") {
				El.classList.add("open", "IsOpen", "Active");
				if (El.tagName === "DETAILS") El.setAttribute("open", "");
			} else if (State === "closed" || State === "close" || State === "false") {
				El.classList.remove("open", "IsOpen", "Active");
				if (El.tagName === "DETAILS") El.removeAttribute("open");
			}
		}

		function ApplyPatch(pEvent) {
			const El = FindTarget(pEvent);
			if (!El || !pEvent.html) return;
			El.outerHTML = pEvent.html;
		}

		function ApplyScroll(pEvent) {
			GetFrameWin()?.scrollTo?.(Number(pEvent.x || 0), Number(pEvent.y || 0));
		}

		function ApplyEvent(pEvent, pSilent = false) {
			switch (pEvent.type) {
				case "scroll":
					ApplyScroll(pEvent);
					break;
				case "pointer":
				case "pointer-down":
				case "pointer-up":
					MoveCursor(pEvent);
					break;
				case "click":
					MoveCursor(pEvent);
					if (!pSilent) ShowPulse(pEvent);
					break;
				case "focus":
					ShowFocus(pEvent);
					break;
				case "blur":
					cFocusBox.hidden = true;
					break;
				case "input":
				case "change":
					ApplyInput(pEvent);
					break;
				case "widget-state":
					ApplyWidgetState(pEvent);
					break;
				case "patch":
					ApplyPatch(pEvent);
					break;
			}
		}

		function Tick() {
			if (!fPlaying) return;
			const Current = Math.min(fDurationMs, fBaseMs + (performance.now() - fPlayStartedAt) * fSpeed);
			while (fIndex < fEvents.length && fEvents[fIndex].t <= Current) {
				ApplyEvent(fEvents[fIndex], false);
				fIndex++;
			}
			cTimeline.value = String(Math.round((Current / fDurationMs) * 1000));
			cClock.textContent = FormatMs(Current);
			if (Current >= fDurationMs) {
				fPlaying = false;
				fBaseMs = fDurationMs;
				return;
			}
			fRaf = requestAnimationFrame(Tick);
		}

		function Play() {
			if (fPlaying) return;
			fPlaying = true;
			fSpeed = Number(cSpeedSel.value || 1);
			fPlayStartedAt = performance.now();
			fRaf = requestAnimationFrame(Tick);
		}

		function Pause() {
			if (!fPlaying) return;
			fBaseMs = Math.min(fDurationMs, fBaseMs + (performance.now() - fPlayStartedAt) * fSpeed);
			fPlaying = false;
			cancelAnimationFrame(fRaf);
			SetTime(fBaseMs, false);
		}

		function Restart() {
			Pause();
			SetTime(0, true);
		}

		function RenderEventsList() {
			const Important = fEvents.filter((Event) => ["click", "focus", "input", "change", "submit", "widget-state"].includes(Event.type));
			cEventsList.innerHTML = "";
			Important.slice(0, 300).forEach((Event) => {
				const Item = document.createElement("div");
				Item.className = "EmoReplayEvent";
				Item.innerHTML = `<strong>${Event.type}</strong> — ${Event.label || Event.target || ""}<span>${FormatMs(Event.t)} ${Event.masked ? "masked" : ""}</span>`;
				Item.onclick = () => {
					Pause();
					SetTime(Math.max(0, Event.t - 350), true);
				};
				cEventsList.appendChild(Item);
			});
		}

		async function Load() {
			const SessionData = await ApiGet("/api/replay/session", { id: cSessionIdValue });
			fSession = SessionData.session;
			if (!fSession) throw new Error("لم يتم العثور على الجلسة");
			if (!fSession.snapshot_html) throw new Error("الجلسة موجودة لكن snapshot_html غير محفوظة بعد");

			const ChunksData = await ApiGet("/api/replay/chunk", { session_id: cSessionIdValue });
			const Chunks = ChunksData.chunks || [];
			fEvents = Chunks.flatMap((Chunk) => Array.isArray(Chunk.events_json) ? Chunk.events_json : []).sort((A, B) => (A.t || 0) - (B.t || 0));
			fDurationMs = Math.max(1000, ...fEvents.map((Event) => Number(Event.t || 0)));

			cTitle.textContent = fSession.page_title || "EmoReplay";
			cMeta.textContent = `${fSession.page_url || ""} | ${fSession.viewport_width}x${fSession.viewport_height} | ${fEvents.length} events`;
			cFrame.srcdoc = fSession.snapshot_html;

			cFrame.addEventListener("load", () => {
				FitStage();
				cStatus.hidden = true;
				cStageScaler.hidden = false;
				SetTime(0, true);
				RenderEventsList();
			}, { once: true });
		}

		cPlayBtn.onclick = Play;
		cPauseBtn.onclick = Pause;
		cRestartBtn.onclick = Restart;
		cSpeedSel.onchange = () => {
			if (fPlaying) {
				Pause();
				Play();
			}
		};
		cTimeline.oninput = () => {
			Pause();
			SetTime((Number(cTimeline.value) / 1000) * fDurationMs, true);
		};
		window.addEventListener("resize", FitStage, { passive: true });

		Load().catch((Ex) => {
			cStatus.textContent = `Replay failed: ${Ex.message || Ex}`;
		});
	})();
	</script>
</body>
</html>
