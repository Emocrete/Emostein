{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"src/**/*.astro",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.mjs"
	],
	"exclude": [
		"dist",
		".vercel",
		"node_modules",
		"public",
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/site/*"]
		},
		"ignoreDeprecations": "6.0",
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			}
		]
	}
}